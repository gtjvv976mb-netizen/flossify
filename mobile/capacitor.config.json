{
  "appId": "ph.flossify.app",
  "appName": "Flossify",
  "webDir": "www",
  "server": {
    "url": "https://flossify.ph/app/",
    "allowNavigation": [
      "flossify.ph",
      "www.flossify.ph"
    ],
    "errorPath": "offline.html"
  },
  "ios": {
    "contentInset": "never",
    "appendUserAgent": "FlossifyApp/1",
    "limitsNavigationsToAppBoundDomains": true,
    "backgroundColor": "#f3f5f8",
    "webContentsDebuggingEnabled": false,
    "zoomEnabled": true,
    "allowsLinkPreview": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 4000,
      "launchAutoHide": true,
      "launchFadeOutDuration": 300,
      "backgroundColor": "#f3f5f8",
      "showSpinner": false
    }
  }
}
