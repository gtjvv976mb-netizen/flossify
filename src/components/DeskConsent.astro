---
// Privacy consent on the patient record, and taking it at the desk.
//
// With a consent row for the notice in force, this is one line: "Consent on
// record: <version>, <date>, at the desk / online". Without one, it is the
// desk's form: a short, plain reading of the notice the patient can read on
// the desk screen or a tablet, their name typed by them, and a box the staff
// member ticks once they have agreed. The post goes to the record page
// (intent=consent), which checks the CSRF token and writes the row through
// recordDeskConsent() in src/lib/health.ts: channel 'desk', the version in
// force, who agreed (agreed_as) and who recorded it.
//
// Who agrees:
// - Under 18 by the birth date on file: a parent or guardian, who types
//   their name. A minor whose consent for this notice is not a parent's or
//   guardian's (taken as the patient's own before the birth date showed a
//   child, or given online) gets the form again, saying why.
// - No birth date on file: the desk says which it is, "the patient, 18 or
//   over" or "a parent or guardian", before anything is recorded.
//
// "Show the patient" fills the screen with the notice. Everything else on
// the page is made inert (no Tab, no click, no Enter reaches it) and focus
// stays in the panel. "Done reading" does not reveal the record: it shows
// "Please hand the screen back", and the desk presses "Back to the record".
// The full notice is named by its address there, not linked, so the patient
// never gets a second tab beside the workspace.
//
// Signed on paper (026): under the desk's form, "Signed on paper? Record it"
// takes the day on the paper, what was signed — a printed copy of the notice
// in force (a consent to it, only if it was in force that day) or the
// clinic's own form (kept as that form, never counted as consent to the
// notice) — and who signed. It posts to the record page as intent=paper
// (recordPaperConsent in src/lib/health.ts). The clinic's own forms on file
// are listed with the consents.
//
// embed: the same choices inside Add patient's one form (no form of its own,
// no CSRF field, no intent): not now, at the desk now (the notice, "Show the
// patient", the name, the tick), or signed on paper. The page posts it all
// with the new patient and records it in the same transaction.
//
// Drawn in the soft template with the patient pages' pieces
// (src/pages/c/[clinic]/patients/_ui/patients.css): a green callout when
// consent is on record; otherwise the desk's form, its choices as rounded pick
// chips, the notice in short behind a disclosure, one teal Record consent.
//
// The page reads everything inside its own withClinic() and passes it in.
import Csrf from './Csrf.astro';
import Icon from './ws/Icon.astro';
// The pick chips, disclosures and callouts are the patient pages' (desk consent only appears on them).
import '../pages/c/[clinic]/patients/_ui/patients.css';
import {
  when, day, dateText, manilaToday, CONSENT_HOW, NAME_MAX, consentInForce, guardianStillNeeded,
  type AgreedAs, type ConsentRow, type NoticeInForce, type PaperForm, type PaperIn,
} from '../lib/health';

interface Props {
  notice: NoticeInForce | null;
  consents: ConsentRow[];
  /** May this person record it (staff_access.can_edit_records)? */
  canRecord: boolean;
  /** Under 18 by the birth date on file: a parent or guardian agrees, and names themselves. */
  minor: boolean;
  /** Is a birth date on file? Without one, the desk says who is agreeing. */
  birthKnown: boolean;
  /** The group's Data Protection Officer, when Settings → Privacy names one. */
  dpo: string | null;
  /** Where the form posts: the record page. */
  action: string;
  /** Set when a post came back: what to fix, and what was typed. */
  problem?: string | null;
  givenBy?: string;
  agreedAs?: AgreedAs | null;
  /** A post just recorded it (?saved=consent), or found it already recorded (?saved=consent-already). */
  recorded?: 'saved' | 'already' | null;
  /** The clinic's own paper forms on file. */
  paperForms?: PaperForm[];
  /** The paper part: open (a refused post came back), its sentence, what was typed, and a paper just recorded. */
  paper?: { open?: boolean; problem?: string | null; values?: Partial<PaperIn>; recorded?: 'saved' | 'already' | null };
  /** Inside Add patient's form: the three choices, no form of its own. */
  embed?: boolean;
  /** embed: the choice shown first. */
  how?: 'later' | 'desk' | 'paper';
  /** embed: the tick as posted. */
  ticked?: boolean;
}
const { notice, consents, canRecord, minor, birthKnown, dpo, action, problem = null, givenBy = '', agreedAs = null, recorded = null,
  paperForms = [], paper = {}, embed = false, how = 'later', ticked = false } = Astro.props;
const today = manilaToday();
const pv = paper.values ?? {};
// The day the notice came into force, for the paper's hint: "a paper signed before it cannot be consent to it".
const effective = notice?.effective ?? null;

// A short reading of each notice, for the person at the desk. Each entry is a
// summary of that version's own words on /privacy/ and says nothing they do
// not; a new version gets its own entry, written from its own words, when
// /privacy/ is published for it (CLAUDE.md, "Open"). A notice with no entry
// here shows its one-line summary and points to the full notice.
// privacy-2026-09 also says texts let a patient "confirm or cancel by text";
// the texts are one-way (Semaphore), so the summary leaves that out rather
// than repeat it — a new version is needed for the notice itself.
const SHORT: Record<string, { head: string; body: string }[]> = {
  'privacy-2026-09': [
    { head: 'What is kept', body: 'Your name and mobile number, your visits and the texts sent about them, and what the clinic records about your teeth.' },
    { head: 'Why', body: 'To run your visit, to remind you of it by text, to bill you and file with your HMO or PhilHealth, and for the clinic’s legal duties. Nothing else, and no marketing.' },
    { head: 'Who sees it', body: 'The staff of this branch, and each time someone opens your record it is written down. Flossify’s operations people, only to keep the service running. The text provider sees your number and the message, nothing more. It is never sold.' },
    { head: 'How long', body: 'Clinical records, as long as the law requires the clinic to keep them. Text logs, two years. You may ask for the rest to be deleted.' },
    { head: 'Your rights', body: 'To be told what is kept and why, to see it, have it corrected, object to a use you did not agree to, have it erased or blocked, take a copy, be paid for harm its misuse causes, and complain to the National Privacy Commission.' },
  ],
};

const inForce = consentInForce(notice?.id, consents);
const needsGuardian = guardianStillNeeded(minor, inForce);
const earlier = consents.filter((c) => c !== inForce);
const latest = consents[0] ?? null;
const short = notice ? SHORT[notice.id] ?? null : null;
// The whole notice is public; the patient is told where, not handed a link.
const noticeAddress = `${Astro.url.host}/privacy/`;

// Who is agreeing: fixed by the birth date on file, or chosen by the desk.
const fixed: AgreedAs | null = minor ? 'guardian' : birthKnown ? 'patient' : null;
const who: AgreedAs | 'unknown' = fixed ?? agreedAs ?? 'unknown';
const WORDS = {
  patient: {
    show: 'Show the patient',
    name: 'Patient’s name, if they like', nameFacing: 'Your name, if you like',
    tick: 'The patient agreed',
    hint: 'The name is typed by the patient and kept with the consent.', hintFacing: 'It is kept with your agreement.',
  },
  guardian: {
    show: 'Show the parent or guardian',
    name: 'Parent or guardian’s name', nameFacing: 'Your name, as parent or guardian',
    tick: 'The parent or guardian agreed',
    hint: 'A parent or guardian agrees for a patient under 18, and types their own name.', hintFacing: 'The patient is under 18, so you agree for them. Type your name.',
  },
  unknown: {
    show: 'Show the patient',
    name: 'Name of the person agreeing', nameFacing: 'Your name',
    tick: 'They agreed',
    hint: 'A parent or guardian must type their name; the patient may.', hintFacing: 'It is kept with your agreement.',
  },
} as const;
const WHO = ['patient', 'guardian', 'unknown'] as const;

/** "at the desk, recorded by Liwayway Domingo, agreed by Lorna Reyes (parent or guardian)" — the parts that are known. */
const agreedBy = (c: ConsentRow) => c.given_by_name && `agreed by ${c.given_by_name}${c.agreed_as === 'guardian' ? ' (parent or guardian)' : ''}`;
const channelText = (c: ConsentRow) => (c.channel === 'paper' && c.signed_on ? `signed on paper ${dateText(c.signed_on)}` : CONSENT_HOW[c.channel] ?? c.channel);
const howText = (c: ConsentRow) =>
  [channelText(c), c.recorded_by_name && `recorded by ${c.recorded_by_name}`, agreedBy(c)].filter(Boolean).join(', ');
/** A paper consent's time of day is not known: it shows its day only. */
const whenText = (c: ConsentRow) => (c.channel === 'paper' && c.signed_on ? dateText(c.signed_on) : when(new Date(c.given_at)));
const formLine = (f: PaperForm) => [
  `${f.form_name}, signed on paper ${dateText(f.signed_on)}`,
  f.signed_by_name && `by ${f.signed_by_name}${f.agreed_as === 'guardian' ? ' (parent or guardian)' : ''}`,
  f.imported ? 'brought in from an import' : f.recorded_by_name && `recorded by ${f.recorded_by_name}`,
].filter(Boolean).join(' · ');
// embed: the desk part is a <div> inside Add patient's form; on the record it is its own form.
const FormTag = embed ? 'div' : 'form';
const formAttrs = embed ? {} : { method: 'post', action, 'data-desk-consent-form': '' };
// The paper part: a <details> with its own form on the record; a block of the form in Add patient.
const PaperOuter = embed ? 'div' : 'details';
const PaperInner = embed ? 'div' : 'form';
const paperOuterAttrs = embed ? { 'data-consent-part': 'paper', hidden: how !== 'paper' || undefined } : { open: paper.open || !!paper.problem || !!paper.recorded || undefined };
const paperInnerAttrs = embed ? {} : { method: 'post', action: action.replace(/#.*$/, '') + '#consent-paper', 'data-paper-form': '' };
const HOW_CHOICES = [
  { id: 'later', label: 'Not now', hint: 'The record asks at the next visit.' },
  { id: 'desk', label: 'At the desk, now', hint: 'Show them the notice on this screen.' },
  { id: 'paper', label: 'Signed on paper', hint: 'Record the date on the paper.' },
] as const;
/** A sentence's first letter up ("recorded by Dr. …" → "Recorded by Dr. …"). */
const upFirst = (t: string) => t.charAt(0).toUpperCase() + t.slice(1);
/** "25 Sep 2026, at the desk" or "signed on paper 3 Mar 2024": when and how the consent in force was given. */
const givenText = (c: ConsentRow) => (c.channel === 'paper' && c.signed_on ? `Signed on paper ${dateText(c.signed_on)}` : `Agreed ${day(new Date(c.given_at))}, ${CONSENT_HOW[c.channel] ?? c.channel}`);
---

{embed && (
  <fieldset class="min-w-0" data-consent-how>
    <legend class="sr-only">Privacy consent: when is it recorded?</legend>
    <div class="grid gap-2.5 sm:grid-cols-3">
      {HOW_CHOICES.map((c) => (
        <label class="pk pk-radio pk-card">
          <input type="radio" name="consent_how" value={c.id} checked={how === c.id} />
          <span><span>{c.label}<span class="pk-hint">{c.hint}</span></span></span>
        </label>
      ))}
    </div>
  </fieldset>
)}

{!embed && notice && inForce && !needsGuardian ? (
  <section id="consent" class="scroll-mt-24" aria-labelledby="consent-title">
    <div class="ws-callout" data-tone="success">
      <Icon name="check" />
      <div class="min-w-0 flex-1">
        <h3 id="consent-title" class="font-semibold">Consent on record</h3>
        <p>{givenText(inForce)}.{(inForce.recorded_by_name || inForce.given_by_name) && ` ${upFirst([inForce.recorded_by_name && `recorded by ${inForce.recorded_by_name}`, agreedBy(inForce)].filter(Boolean).join(', '))}.`}</p>
        <p class="mt-0.5 text-[13.5px] text-ink-2">Privacy notice <span class="font-mono text-[13px]">{inForce.version_id}</span></p>
        {recorded === 'saved' && <p role="status" class="mt-1 font-semibold">Recorded just now.</p>}
      </div>
    </div>
    {recorded === 'already' && (
      <p role="status" class="ws-callout mt-3">
        <Icon name="info" />
        <span>Already on record: {inForce.recorded_by_name ? `${inForce.recorded_by_name} recorded it` : `given ${CONSENT_HOW[inForce.channel] ?? inForce.channel}`} {whenText(inForce)}, so yours was not added.</span>
      </p>
    )}
    {earlier.length > 0 && (
      <details class="pt-more mt-3">
        <summary>Earlier consents ({earlier.length}) <Icon name="chevron" size={16} class="pt-chev" /></summary>
        <ul class="pt-list mt-1">
          {earlier.map((c) => (
            <li class="!block text-[14.5px]">{whenText(c)} · {howText(c)} <span class="font-mono text-[13px] text-muted">{c.version_id}</span></li>
          ))}
        </ul>
      </details>
    )}
  </section>
) : (
  <section id="consent" class:list={['group scroll-mt-24 data-[facing]:fixed data-[facing]:inset-0 data-[facing]:z-[60] data-[facing]:m-0 data-[facing]:overflow-y-auto data-[facing]:rounded-none data-[facing]:border-0 data-[facing]:bg-bg', embed && 'pt-inset mt-4']} aria-labelledby="consent-title" data-desk-consent data-who={who} data-consent-part={embed ? 'desk' : undefined} hidden={embed && how !== 'desk'}>
    <FormTag {...formAttrs} class:list={['mx-auto group-data-[facing]:max-w-[760px] group-data-[facing]:px-5 group-data-[facing]:py-10 group-data-[facing=hold]:hidden', embed && 'p-5 sm:p-6']}>
      {!embed && <Csrf />}
      {!embed && <input type="hidden" name="intent" value="consent" />}
      {notice && <input type="hidden" name="version" value={notice.id} />}
      {fixed && <input type="hidden" name="agreed_as" value={fixed} />}

      <div class="flex flex-wrap items-start justify-between gap-4 group-data-[facing]:hidden">
        <div class="max-w-[62ch]">
          <h3 id="consent-title" class="flex items-center gap-2 text-[17px] font-semibold">
            {!embed && notice && <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-[var(--ws-amber-tint)] text-[var(--ws-amber-ink)]"><Icon name="alert" size={16} /></span>}
            {!notice ? 'No privacy notice in force' : embed ? 'Agreed at the desk' : needsGuardian ? 'A parent or guardian needs to agree' : 'Not on record yet'}
          </h3>
          {embed && notice ? (
            <p class="mt-1.5 text-[15px] leading-relaxed text-ink-2">Show the patient the privacy notice. When they have read it and agree, tick the box. It is recorded with the new patient when you save.</p>
          ) : !notice ? (
            <p class="mt-1.5 text-[15px] text-ink-2">There is nothing to ask the patient to agree to yet.</p>
          ) : needsGuardian && inForce ? (
            <p class="mt-1.5 text-[15px] leading-relaxed text-ink-2">
              {inForce.channel === 'desk'
                ? `On ${day(new Date(inForce.given_at))} it was recorded as the patient’s own agreement, but the birth date on file makes them under 18.`
                : `It was given ${CONSENT_HOW[inForce.channel] ?? inForce.channel} on ${day(new Date(inForce.given_at))}${inForce.given_by_name ? ` by ${inForce.given_by_name}` : ''}, and the patient is under 18.`}
              {' '}Show a parent or guardian the notice, and record their agreement here.
            </p>
          ) : (
            <p class="mt-1.5 text-[15px] leading-relaxed text-ink-2">
              Show the patient the privacy notice. When they have read it and agree, tick the box and record it.
              {latest && <> They agreed to an earlier notice on {day(new Date(latest.given_at))}; it has changed since.</>}
            </p>
          )}
        </div>
        {notice && canRecord && (
          <button type="button" class="ws-btn ws-btn-quiet" data-desk-consent-face aria-controls="consent">
            <Icon name="user" />
            {WHO.map((k) => <span data-who-text={k} hidden={k !== who}>{WORDS[k].show}</span>)}
          </button>
        )}
      </div>

      {problem && <p role="alert" class="ws-callout mt-4 group-data-[facing]:hidden" data-tone="alert"><Icon name="alert" /><span>{problem}</span></p>}

      {notice && canRecord && !fixed && (
        <fieldset class="mt-5 min-w-0 group-data-[facing]:hidden" data-desk-consent-who>
          <legend class="float-left w-full text-[15px] font-semibold text-ink">Who is agreeing</legend>
          <p class="clear-both pt-1 text-[14px] text-ink-2">{embed ? 'Chosen from the birth date above when there is one. Under 18, a parent or guardian agrees.' : 'No birth date is on file yet, so choose one.'}</p>
          <div class="pk-row pt-3">
            <label class="pk pk-radio">
              <input type="radio" name="agreed_as" value="patient" required={!embed} checked={agreedAs === 'patient'} />
              <span>The patient, 18 or over</span>
            </label>
            <label class="pk pk-radio">
              <input type="radio" name="agreed_as" value="guardian" required={!embed} checked={agreedAs === 'guardian'} />
              <span>A parent or guardian, for a patient under 18</span>
            </label>
          </div>
        </fieldset>
      )}

      {notice && (
        <details class="pt-more mt-3 group-data-[facing]:mt-0" data-desk-consent-read>
          <summary class="group-data-[facing]:hidden">Read the notice, in short <Icon name="chevron" size={16} class="pt-chev" /></summary>
          <div class="pt-inset mt-1 p-5 group-data-[facing]:mt-0 group-data-[facing]:border-0 group-data-[facing]:bg-transparent group-data-[facing]:p-0">
            <p class="meta">Privacy notice {notice.id} · in force from {notice.effective}</p>
            <h4 class="mt-2 text-[18px] font-semibold tracking-tight group-data-[facing]:text-[clamp(1.75rem,4vw,2.5rem)] group-data-[facing]:leading-tight" tabindex="-1" data-desk-consent-title>
              What the clinic keeps about you, and why
            </h4>
            {short ? (
              <dl class="mt-4 grid gap-x-8 gap-y-3 sm:grid-cols-[10rem_1fr] group-data-[facing]:mt-8 group-data-[facing]:gap-y-5">
                {short.map((s) => (
                  <>
                    <dt class="text-[15px] font-semibold group-data-[facing]:text-[19px]">{s.head}</dt>
                    <dd class="text-[15px] leading-relaxed text-ink-2 group-data-[facing]:text-[19px]">{s.body}</dd>
                  </>
                ))}
              </dl>
            ) : (
              <p class="mt-3 max-w-[62ch] text-[15px] leading-relaxed text-ink-2 group-data-[facing]:text-[19px]">{notice.summary}</p>
            )}
            <p class="mt-4 max-w-[62ch] text-[15px] leading-relaxed text-ink-2 group-data-[facing]:mt-6 group-data-[facing]:text-[19px]">
              To use a right, write to the clinic’s Data Protection Officer{dpo ? <>, {dpo}</> : ''}. When this notice changes, you will be asked again.{' '}
              <a href="/privacy/" target="_blank" rel="noopener" class="font-semibold whitespace-nowrap text-[var(--ws-teal-ink)] underline underline-offset-4 group-data-[facing]:hidden">Read the whole notice</a>
              <span class="hidden group-data-[facing]:inline">The whole notice is public at <span class="font-mono text-[0.9em] break-all text-ink">{noticeAddress}</span>, to read on your own phone.</span>
            </p>
          </div>
        </details>
      )}

      {notice && canRecord && (
        <>
          <div class="mt-4 flex flex-wrap items-end gap-3 border-t border-[var(--ws-hair)] pt-5 group-data-[facing]:mt-10">
            <label class="field w-full max-w-[22rem] group-data-[facing]:max-w-[28rem]">
              {/* The desk reads one label; the patient, facing the screen, reads the other. */}
              <span class="meta group-data-[facing]:hidden">{WHO.map((k) => <span data-who-text={k} hidden={k !== who}>{WORDS[k].name}</span>)}</span>
              <span class="meta hidden group-data-[facing]:inline">{WHO.map((k) => <span data-who-text={k} hidden={k !== who}>{WORDS[k].nameFacing}</span>)}</span>
              <input name="given_by_name" value={givenBy} maxlength={NAME_MAX} autocomplete="off" required={!embed && who === 'guardian'} data-desk-consent-name />
            </label>
            <label class="pk group-data-[facing]:hidden">
              <input type="checkbox" name="agreed" value="1" required={!embed} checked={ticked} data-desk-consent-tick />
              <span class="min-h-[46px]!">{WHO.map((k) => <span data-who-text={k} hidden={k !== who}>{WORDS[k].tick}</span>)}</span>
            </label>
            {!embed && <button type="submit" class="ws-btn ws-btn-primary min-h-[46px] group-data-[facing]:hidden"><Icon name="check" />Record consent</button>}
          </div>
          {!embed && (
            <div data-desk-consent-held hidden role="alert" class="ws-callout mt-4 group-data-[facing]:hidden" data-tone="warn">
              <Icon name="alert" />
              <div class="flex flex-1 flex-wrap items-center gap-x-4 gap-y-3">
                <span class="max-w-[52ch]">The health answers are not saved yet. Save them first, then record consent.</span>
                <button type="button" class="ws-btn ws-btn-quiet">Save the health answers</button>
              </div>
            </div>
          )}
          <p class="mt-2 text-[13.5px] leading-snug text-muted group-data-[facing]:text-[15px]">
            <span class="group-data-[facing]:hidden">{WHO.map((k) => <span data-who-text={k} hidden={k !== who}>{WORDS[k].hint}</span>)} Recorded as agreed at the desk, today, under your name{embed ? ', when the patient is saved' : ''}.</span>
            <span class="hidden group-data-[facing]:inline">{WHO.map((k) => <span data-who-text={k} hidden={k !== who}>{WORDS[k].hintFacing}</span>)}</span>
          </p>
          <div class="mt-8 hidden border-t border-[var(--ws-hair)] pt-6 group-data-[facing]:flex group-data-[facing]:flex-wrap group-data-[facing]:items-center group-data-[facing]:gap-4">
            <button type="button" class="ws-btn ws-btn-primary min-h-[56px] px-6 text-[17px]" data-desk-consent-done><Icon name="check" />Done reading</button>
          </div>
        </>
      )}
      {notice && !canRecord && (
        <p class="mt-5 flex items-start gap-2 text-[14.5px] text-muted"><Icon name="info" size={16} class="mt-1 shrink-0" />Your account cannot record consent at this branch. Ask the owner, or someone at the desk.</p>
      )}

      {consents.length > 0 && (
        <details class="pt-more mt-4 group-data-[facing]:hidden">
          <summary>Consents on record ({consents.length}) <Icon name="chevron" size={16} class="pt-chev" /></summary>
          <ul class="pt-list mt-1">
            {consents.map((c) => (
              <li class="!block text-[14.5px]">{whenText(c)} · {howText(c)} <span class="font-mono text-[13px] text-muted">{c.version_id}</span></li>
            ))}
          </ul>
        </details>
      )}
    </FormTag>

    {notice && canRecord && (
      <div class="mx-auto hidden min-h-full max-w-[760px] flex-col justify-center gap-6 p-5 group-data-[facing=hold]:flex sm:p-6">
        <p class="text-[clamp(1.75rem,4vw,2.5rem)] leading-tight font-semibold tracking-tight" tabindex="-1" data-desk-consent-hold-title>Thank you. Please hand the screen back to the desk.</p>
        <div class="flex flex-wrap items-center gap-4 border-t border-[var(--ws-hair)] pt-6">
          <button type="button" class="ws-btn ws-btn-quiet min-h-[52px]" data-desk-consent-back><Icon name="chevron-left" />{embed ? 'Back to the form' : 'Back to the record'}</button>
          <span class="text-[15px] text-ink-2">For the desk.</span>
        </div>
      </div>
    )}
  </section>
)}

{canRecord && (
    <PaperOuter id="consent-paper" {...paperOuterAttrs} class:list={['scroll-mt-24', embed ? 'pt-inset mt-4 p-5 sm:p-6' : 'pt-more mt-4 border-t border-[var(--ws-hair)] pt-2']}>
      {!embed && <summary>Signed on paper? Record it <Icon name="chevron" size={16} class="pt-chev" /></summary>}
      <PaperInner {...paperInnerAttrs} class={embed ? 'grid gap-5' : 'grid gap-5 pt-3 pb-1'}>
        {!embed && <Csrf />}
        {!embed && <input type="hidden" name="intent" value="paper" />}
        {notice && <input type="hidden" name="paper_version" value={notice.id} />}
        {embed && <p class="text-[17px] font-semibold">Signed on paper</p>}
        {paper.problem && <p role="alert" class="ws-callout" data-tone="alert"><Icon name="alert" /><span>{paper.problem}</span></p>}
        {paper.recorded === 'saved' && <p role="status" class="ws-callout" data-tone="success"><Icon name="check" /><span>Recorded.</span></p>}
        <fieldset class="min-w-0">
          <legend class="float-left w-full text-[15px] font-semibold text-ink">What was signed</legend>
          <div class="clear-both grid gap-2.5 pt-3">
            {notice && (
              <label class="pk pk-radio pk-card">
                <input type="radio" name="paper_what" value="notice" checked={pv.what === 'notice'} />
                <span><span>A printed copy of this privacy notice<span class="pk-hint">In force from {effective}. It counts as their consent to it.</span></span></span>
              </label>
            )}
            <label class="pk pk-radio pk-card">
              <input type="radio" name="paper_what" value="clinic" checked={pv.what === 'clinic' || (!notice && !pv.what)} />
              <span><span>The clinic’s own consent form<span class="pk-hint">Kept on the record as that form. It is not consent to Flossify’s privacy notice{notice ? ', so the record still asks for that' : ''}.</span></span></span>
            </label>
          </div>
        </fieldset>
        <div class="flex flex-wrap items-end gap-x-5 gap-y-4">
          <label class="field w-[13.5rem]">
            <span class="meta">Date on the paper</span>
            <input type="date" name="paper_signed_on" value={pv.signedOn ?? ''} min="1900-01-01" max={today} />
          </label>
          <fieldset class="min-w-0">
            <legend class="float-left w-full text-[14px] font-medium text-ink-2">Who signed</legend>
            <div class="pk-row clear-both pt-2">
              <label class="pk pk-radio">
                <input type="radio" name="paper_agreed_as" value="patient" checked={pv.agreedAs === 'patient'} />
                <span>The patient</span>
              </label>
              <label class="pk pk-radio">
                <input type="radio" name="paper_agreed_as" value="guardian" checked={pv.agreedAs === 'guardian'} />
                <span>A parent or guardian</span>
              </label>
            </div>
          </fieldset>
        </div>
        <label class="field max-w-[22rem]">
          <span class="meta">Name on the paper</span>
          <input name="paper_name" value={pv.givenBy ?? ''} maxlength={NAME_MAX} autocomplete="off" />
          <span class="text-[13px] text-muted">Needed when a parent or guardian signed.</span>
        </label>
        {!embed && <div><button type="submit" class="ws-btn ws-btn-quiet"><Icon name="file" />Record the paper</button></div>}
        <p class="text-[13.5px] leading-snug text-muted">The paper stays at the clinic; this records that it was signed, on that day, under your name.{notice ? ` A paper signed before ${effective} cannot be consent to this notice.` : ''}</p>
      </PaperInner>
    </PaperOuter>
)}

{!embed && paperForms.length > 0 && (
  <div class="mt-4">
    <p class="text-[15px] font-semibold">Paper forms on file</p>
    <ul class="pt-list mt-1">
      {paperForms.map((f) => <li class="!flex-nowrap !justify-start text-[14.5px]"><Icon name="file" size={16} class="shrink-0 text-muted" /><span>{formLine(f)}</span></li>)}
    </ul>
  </div>
)}

<script>
  // "Show the patient": the consent panel fills the screen with the notice
  // unfolded; the staff-only parts (the tick, the button, the record behind)
  // are out of sight AND out of reach: every element outside the panel is
  // made inert while it faces the patient, and Tab cycles inside the panel.
  // "Done reading" (or Escape) hides the notice too and asks the patient to
  // hand the screen back; only "Back to the record" puts the page back, with
  // the cursor on the tick box. The CSS lives in the markup's data-[facing]
  // and group-data-[facing] classes; this sets the attribute.
  document.querySelectorAll<HTMLElement>('[data-desk-consent]').forEach((root) => {
    const open = root.querySelector<HTMLButtonElement>('[data-desk-consent-face]');
    const done = root.querySelector<HTMLButtonElement>('[data-desk-consent-done]');
    const back = root.querySelector<HTMLButtonElement>('[data-desk-consent-back]');
    const title = root.querySelector<HTMLElement>('[data-desk-consent-title]');
    const holdTitle = root.querySelector<HTMLElement>('[data-desk-consent-hold-title]');
    const tick = root.querySelector<HTMLInputElement>('[data-desk-consent-tick]');
    const read = root.querySelector<HTMLDetailsElement>('[data-desk-consent-read]');
    const name = root.querySelector<HTMLInputElement>('[data-desk-consent-name]');

    // Who is agreeing, when the desk chooses it: the labels and the rule for the name follow.
    root.querySelectorAll<HTMLInputElement>('input[name="agreed_as"][type="radio"]').forEach((r) => {
      r.addEventListener('change', () => {
        if (!r.checked) return;
        root.dataset.who = r.value;
        root.querySelectorAll<HTMLElement>('[data-who-text]').forEach((t) => { t.hidden = t.dataset.whoText !== r.value; });
        if (name) name.required = r.value === 'guardian';
      });
    });

    if (!open) return;
    // Everything on the page but the panel: the siblings of the panel and of each of its ancestors.
    let fenced: HTMLElement[] = [];
    const fence = (on: boolean) => {
      if (!on) { fenced.forEach((el) => { el.inert = false; }); fenced = []; return; }
      for (let el: HTMLElement | null = root; el && el !== document.body; el = el.parentElement) {
        for (const sib of Array.from(el.parentElement?.children ?? [])) {
          if (sib !== el && sib instanceof HTMLElement && !sib.inert) { sib.inert = true; fenced.push(sib); }
        }
      }
    };
    let wasOpen = false;
    const face = (state: 'read' | 'hold' | null) => {
      const was = root.getAttribute('data-facing');
      if (state) root.setAttribute('data-facing', state); else root.removeAttribute('data-facing');
      document.documentElement.style.overflow = state ? 'hidden' : '';
      if (state && !was) fence(true);
      if (!state) fence(false);
      if (read && state === 'read' && !was) { wasOpen = read.open; read.open = true; }
      if (read && !state) read.open = wasOpen;
      root.scrollTop = 0;
      if (state === 'read') title?.focus();
      else if (state === 'hold') holdTitle?.focus();
      else { root.scrollIntoView({ block: 'start' }); tick?.focus(); }
    };
    open.addEventListener('click', () => face('read'));
    done?.addEventListener('click', () => face('hold'));
    back?.addEventListener('click', () => face(null));
    document.addEventListener('keydown', (e) => {
      const state = root.getAttribute('data-facing');
      if (!state) return;
      if (e.key === 'Escape' && state === 'read') { e.preventDefault(); face('hold'); return; }
      // Enter in the name field would submit the form behind the patient's back; only the desk records it.
      if (e.key === 'Enter' && (e.target as HTMLElement).tagName === 'INPUT') { e.preventDefault(); return; }
      if (e.key !== 'Tab') return;
      // Tab and Shift+Tab go round the panel's own controls, never out of it.
      const stops = Array.from(root.querySelectorAll<HTMLElement>('a[href], button, input:not([type="hidden"]), textarea, select, summary'))
        .filter((el) => !(el as HTMLButtonElement).disabled && el.getClientRects().length > 0);
      if (!stops.length) { e.preventDefault(); return; }
      const i = stops.indexOf(document.activeElement as HTMLElement);
      const next = e.shiftKey ? (i <= 0 ? stops.length - 1 : i - 1) : (i === -1 || i === stops.length - 1 ? 0 : i + 1);
      e.preventDefault();
      stops[next].focus();
    });
  });
</script>
