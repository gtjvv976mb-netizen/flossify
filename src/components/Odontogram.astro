---
import {
  CONDITION_LABEL, CONDITION_CODE, CODE_LEGEND, SURFACE_SCOPED, SURFACE_LABEL, occlusalWord, surfaceSummary,
  type ToothCondition, type ToothMark, type Notation, type Surface,
} from '../data/demo';
import { toothName } from '../lib/tooth-name';
import { PICTURES, PIC_W, PIC_H, pictureKey, flipFor, tiltFor, MOUTH } from '../lib/tooth-drawing';

interface Props {
  /** Existing findings keyed by FDI number. Empty means a fresh chart. */
  marks?: Partial<Record<number, ToothMark>>;
  /** Which numbering to show first. Staff switch it in the control. */
  notation?: Notation;
  /** Where each change is posted as JSON the moment it is made. Absent, the
   *  chart is local only, which is what a demo wants. */
  saveUrl?: string;
  /** The patient whose chart this is; sent with every save. */
  patientId?: string;
  /** The clinic slug; sent with every save so the server can check access. */
  clinic?: string;
  /** This browser's CSRF token, sent in the X-CSRF header. */
  csrf?: string;
  /** The palette's record actions (Add to plan, Treatment done, Clinical note) for someone who may edit records.
   *  They open the record's panels (data-pick-open); the finding buttons are untouched. */
  actions?: boolean;
  /** Planned and done work per tooth (permanent teeth, and baby teeth when `primary` draws them): a ring under the
   *  number for open plan items, a dot for work done in the past year, and a sentence in the tooth's label. */
  work?: Partial<Record<number, { plan: string[]; done: string[] }>>;
  /** The paper chart's codes: each finding's code (C, Ex, RF, M …) beside its tooth, above an upper tooth and below
   *  a lower one, drawn by global.css from the attributes paint() sets; and the paper's legend under the arches
   *  ("C – Caries · Ex – Extraction · …") in place of the colour swatches. Off, the chart is as it was. */
  codes?: boolean;
  /** The baby teeth (A–T: FDI 55–51 | 61–65 over 85–81 | 71–75) as a small arch of their own, beside the permanent
   *  arches where the chart is wide and under them where it is not, charted exactly like the permanent teeth. Off,
   *  the chart is as it was. */
  primary?: boolean;
  /** With `primary`: the baby teeth shown open (a child). They also open on their own when a baby tooth has a finding
   *  or work; otherwise they wait behind one quiet "Baby teeth" button. */
  primaryOpen?: boolean;
}

const { marks = {}, notation = 'fdi', saveUrl, patientId, clinic, csrf, actions = false, work = {}, codes = false, primary = false, primaryOpen = false } = Astro.props;

// --- charting through a brownout -------------------------------------------
// A saving chart keeps each change on the device until the server has it
// (src/lib/offline-queue.ts). It needs to know whose changes they are and
// under which sign-in — the signed-in staff member and the tag of this
// sign-in (chartSession), both from the session here on the server: the
// server saves a change only under the sign-in it was made under — how long
// this sign-in has left (the chart locks after that), when this chart was
// drawn (so the server can tell a colleague's finding saved later from one
// this chart showed, and the page which kept changes it already shows), and
// how long the service worker may keep a copy of this page for a reload
// mid-brownout: until this sign-in would end, at most 4 hours (public/sw.js
// reads data-shell-until, and caps it at the same 4 hours itself). Read only
// when saving: a demo chart needs no session.
//
// "When this chart was drawn" must be exact: a colleague's change saved
// between the page reading the chart and this line would otherwise be dated
// before the drawing, and the next change to that tooth would replace it
// unseen. So a saving chart reads its own marks, with the database's time,
// under a shared hold on the lock every chart change takes (chartNow in
// src/pages/api/chart.ts); `marks` from the page is used only if that read
// fails.
const now = Date.now();
let drawn = marks;
let renderedAt: number | undefined;
let staffKey: string | undefined;
let sid: string | undefined;
let sessionLeft: number | undefined;
let shellUntil: number | undefined;
if (saveUrl) {
  const { readSession } = await import('../lib/auth');
  const { chartSession, chartNow } = await import('../pages/api/chart');
  const session = readSession(Astro.cookies);
  if (session) {
    staffKey = session.staffId;
    sid = chartSession(session);
    sessionLeft = Math.max(0, session.exp - now);
    shellUntil = Math.min(session.exp, now + 4 * 3_600_000);
    if (patientId && clinic) {
      const read = await chartNow(session, clinic, patientId).catch(() => null);
      if (read) {
        drawn = read.marks as Partial<Record<number, ToothMark>>;
        renderedAt = read.at;
      }
    }
  }
  renderedAt ??= now;
}

// --- notation -------------------------------------------------------------
// FDI is what we store. Universal (US) and Palmer (UK) are display only, so a
// record stays readable wherever it is opened.
const QUADRANTS: Record<number, { palmer: string; universalStart: number; ascending: boolean }> = {
  1: { palmer: 'UR', universalStart: 1, ascending: false },
  2: { palmer: 'UL', universalStart: 9, ascending: true },
  3: { palmer: 'LL', universalStart: 17, ascending: false },
  4: { palmer: 'LR', universalStart: 25, ascending: true },
  // The baby teeth (`primary`): Universal letters A–J across the upper arch from the patient's right (55 = A, 51 = E,
  // 61 = F, 65 = J) and K–T back across the lower (75 = K, 71 = O, 81 = P, 85 = T); Palmer A–E in each quadrant.
  5: { palmer: 'UR', universalStart: 1, ascending: false },
  6: { palmer: 'UL', universalStart: 6, ascending: true },
  7: { palmer: 'LL', universalStart: 11, ascending: false },
  8: { palmer: 'LR', universalStart: 16, ascending: true },
};
/** Quadrants 5–8 are the baby teeth, five to a quadrant. */
const isBabyQuadrant = (q: number) => q >= 5;
const LETTERS = 'ABCDEFGHIJKLMNOPQRST';

// --- surface geometry -----------------------------------------------------
// Mesial means "toward the midline", so which SIDE of the drawn tooth that is
// depends on the quadrant. Buccal faces the cheek: up for the upper arch,
// down for the lower. Getting this wrong puts the mark on the wrong surface,
// which is a clinical error, not a cosmetic one.
function pips(fdi: number) {
  // A baby quadrant sits where its permanent one does: 5 → 1, 6 → 2, 7 → 3, 8 → 4.
  const q = ((Math.floor(fdi / 10) - 1) % 4) + 1;
  const upper = q === 1 || q === 2;
  const mesialRight = q === 1 || q === 4;
  return {
    mesial: { x: mesialRight ? 80 : 20, y: 50 },
    distal: { x: mesialRight ? 20 : 80, y: 50 },
    buccal: { x: 50, y: upper ? 17 : 83 },
    lingual: { x: 50, y: upper ? 83 : 17 },
    occlusal: { x: 50, y: 50 },
  } as Record<Surface, { x: number; y: number }>;
}

const SURFACES: Surface[] = ['mesial', 'occlusal', 'distal', 'buccal', 'lingual'];

function tooth(fdi: number) {
  const q = Math.floor(fdi / 10);
  const pos = fdi % 10;
  const meta = QUADRANTS[q];
  const baby = isBabyQuadrant(q);
  const size = baby ? 5 : 8;
  const index = meta.universalStart + (meta.ascending ? pos - 1 : size - pos);
  const mark = drawn[fdi];
  const scoped = mark && SURFACE_SCOPED.includes(mark.condition);
  const plan = work[fdi]?.plan ?? [];
  const done = work[fdi]?.done ?? [];
  return {
    fdi,
    plan: plan.length > 0,
    done: done.length > 0,
    workWords: [plan.length ? `On the plan: ${plan.join('; ')}.` : '', done.length ? `Treated in the past year: ${done.join('; ')}.` : ''].filter(Boolean).join(' '),
    universal: baby ? LETTERS[index - 1] : index,
    palmer: `${meta.palmer}${baby ? LETTERS[pos - 1] : pos}`,
    // Whole-tooth conditions paint the tooth; surface conditions leave it
    // sound and show pips instead.
    state: (mark && !scoped ? mark.condition : 'sound') as ToothCondition,
    surfaceCondition: scoped ? mark!.condition : '',
    surfaces: scoped ? (mark!.surfaces ?? []) : [],
    pips: pips(fdi),
    lower: q === 3 || q === 4 || q === 7 || q === 8,
    // "lower left first molar": in its label, the palette's title and the mouth map's line.
    name: toothName(fdi),
    // Its side-view picture (src/lib/tooth-drawing.ts): which drawing, turned how for its quadrant, and which way an
    // impacted one leans (its crown toward the midline).
    pic: pictureKey(fdi),
    flip: flipFor(fdi),
    tilt: tiltFor(fdi),
  };
}

const rows = {
  upperRight: [18, 17, 16, 15, 14, 13, 12, 11].map(tooth),
  upperLeft: [21, 22, 23, 24, 25, 26, 27, 28].map(tooth),
  lowerRight: [48, 47, 46, 45, 44, 43, 42, 41].map(tooth),
  lowerLeft: [31, 32, 33, 34, 35, 36, 37, 38].map(tooth),
};
// The baby teeth's arch (`primary`), in the same order: the upper over the lower, the patient's right on the left.
const babyRows = {
  upperRight: [55, 54, 53, 52, 51].map(tooth),
  upperLeft: [61, 62, 63, 64, 65].map(tooth),
  lowerRight: [85, 84, 83, 82, 81].map(tooth),
  lowerLeft: [71, 72, 73, 74, 75].map(tooth),
};
// The two sets of arches the chart draws: each an upper row over a lower row, each row its two quadrants.
const sets = [
  { key: 'permanent', arches: [[rows.upperRight, rows.upperLeft], [rows.lowerRight, rows.lowerLeft]] },
  ...(primary ? [{ key: 'primary', arches: [[babyRows.upperRight, babyRows.upperLeft], [babyRows.lowerRight, babyRows.lowerLeft]] }] : []),
];
// The baby teeth show open for a child (primaryOpen), or when one of them has a finding or work on it.
const isBaby = (fdi: number) => fdi >= 51 && fdi <= 85 && fdi % 10 >= 1 && fdi % 10 <= 5;
const babyShown = primary && (primaryOpen || Object.keys(drawn).some((k) => isBaby(Number(k))) || Object.keys(work).some((k) => isBaby(Number(k))));
const babyId = `odo-baby-${patientId ?? 'chart'}`;

// Visual order for arrow-key movement.
const flat = [...rows.upperRight, ...rows.upperLeft, ...rows.lowerRight, ...rows.lowerLeft];
const firstFdi = flat[0].fdi;

function describe(t: ReturnType<typeof tooth>, name: string | number) {
  const workWords = t.workWords ? ` ${t.workWords}` : '';
  if (t.surfaceCondition) {
    const codes = surfaceSummary(t.fdi, t.surfaces);
    return `Tooth ${name}, ${t.name}, ${CONDITION_LABEL[t.surfaceCondition as ToothCondition]} on ${codes}.${workWords} Activate to edit.`;
  }
  return `Tooth ${name}, ${t.name}, ${CONDITION_LABEL[t.state]}.${workWords} Activate to edit.`;
}

// --- the pictures -----------------------------------------------------------------------------------------------
// Each tooth's side view beside its box, on the outside of the arch, and the whole mouth from above: in the chart note
// ("Where it is", with the findings) and small in the palette (the open tooth lit). Drawn once per kind in a hidden
// <defs> and reused; ids carry this chart's own prefix.
const picId = `odo-pic-${(patientId ?? 'chart').slice(0, 8)}`;
const picKinds = Object.entries(PICTURES).filter(([k]) => primary || !k.startsWith('B'));
const mouth = MOUTH;
// Each map tooth with its finding, as the tooth's own box has it (the script keeps them in step after a change).
const mapSets = [{ key: 'permanent', teeth: mouth.permanent }, ...(primary ? [{ key: 'primary', teeth: mouth.primary }] : [])]
  .map((g) => ({ key: g.key, teeth: g.teeth.map((m) => { const t = tooth(m.fdi); return { ...m, state: t.state, surfaceCondition: t.surfaceCondition }; }) }));

const notations = [
  { id: 'fdi', label: 'FDI' },
  { id: 'universal', label: 'Universal' },
  { id: 'palmer', label: 'Palmer' },
];

const legend = [
  { label: 'Caries', cls: 'bg-caries' },
  { label: 'Filled', cls: 'bg-accent' },
  { label: 'Crown', cls: 'bg-crown' },
  { label: 'Missing', cls: 'bg-[var(--c-tooth-missing)]' },
];

// In the order of the paper chart's legend (C, Ex, RF, M, Un, Im, J, Am, Ab, P, I, Fx, S, Rm), then ours.
const surfaceConditions: ToothCondition[] = ['caries', 'amalgam', 'inlay', 'sealant', 'filled'];
const wholeConditions: ToothCondition[] = [
  'extraction', 'root_fragment', 'missing', 'unerupted', 'impacted', 'crown', 'abutment', 'pontic', 'bridge',
  'denture', 'root_canal', 'implant', 'veneer',
];
---

<div data-odontogram style={`--odo-hatch: url(#${picId}-hatch)`} data-codes={codes ? '' : undefined} data-primary-open={babyShown ? '' : undefined} data-notation={notation} data-save-url={saveUrl} data-patient={patientId} data-clinic={clinic} data-csrf={csrf} data-staff={staffKey} data-sid={sid} data-session-left={sessionLeft} data-rendered-at={renderedAt} data-shell-until={shellUntil} class="flex flex-col gap-7 border border-line bg-surface p-6 sm:p-8 lg:flex-row">
  <div class="flex min-w-0 flex-1 flex-col">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <fieldset class="flex items-center gap-2">
        <legend class="sr-only">Tooth notation system</legend>
        {notations.map((n) => (
          <label class="-my-[7px] cursor-pointer py-[7px]">
            <input type="radio" name="notation" value={n.id} checked={n.id === notation} class="peer sr-only" data-notation-input />
            <span class="block border border-line px-3 py-1.5 text-xs font-medium text-ink-2 peer-checked:border-accent peer-checked:bg-accent peer-checked:text-surface peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-accent">
              {n.label}
            </span>
          </label>
        ))}
      </fieldset>
      {primary && (
        <button type="button" class="mr-auto inline-flex min-h-11 cursor-pointer items-center border border-line bg-surface px-3.5 text-[13px] font-medium text-ink-2 hover:border-accent hover:text-accent" data-odo-baby-toggle aria-expanded={babyShown ? 'true' : 'false'} aria-controls={babyId}>
          Baby teeth
        </button>
      )}
      <div class="flex flex-wrap gap-4" data-odo-keys>
        {!codes && legend.map((g) => (
          <span class="flex items-center gap-1.5 text-xs text-ink-2"><span class={`swatch ${g.cls}`}></span>{g.label}</span>
        ))}
        {saveUrl && <span class="flex items-center gap-1.5 text-xs text-ink-2" data-waiting-legend hidden><span class="swatch waiting-swatch"></span>Saved on this device</span>}
        {Object.keys(work).length > 0 && (
          <>
            <span class="flex items-center gap-1.5 text-xs text-ink-2"><span class="tooth-mark-plan" aria-hidden="true"></span>On the plan</span>
            <span class="flex items-center gap-1.5 text-xs text-ink-2"><span class="tooth-mark-done" aria-hidden="true"></span>Treated in the past year</span>
          </>
        )}
      </div>
    </div>

    <div class="flex flex-col" data-odo-arches>
    {sets.map((set) => (
    <div class="min-w-0" data-odo-set={set.key} id={set.key === 'primary' ? babyId : undefined} hidden={set.key === 'primary' && !babyShown}
      role={set.key === 'primary' ? 'group' : undefined} aria-labelledby={set.key === 'primary' ? `${babyId}-name` : undefined}>
    {set.key === 'primary' && <p id={`${babyId}-name`} class="h-6 text-[13px] leading-6 font-medium text-ink-2" data-odo-baby-name>Baby teeth</p>}
    {set.arches.map(([a, b], archIndex) => (
      <>
        {archIndex === 1 && (
          <div class="my-3.5 flex items-center gap-3.5">
            <div class="h-px flex-1 bg-line-2"></div>
            <span class="meta text-faint">Midline</span>
            <div class="h-px flex-1 bg-line-2"></div>
          </div>
        )}
        <div class={`flex gap-4 overflow-x-auto ${archIndex === 0 && set.key !== 'primary' ? 'mt-6 ' : ''}py-1`}><div class="mx-auto flex gap-4">
          {[a, b].map((quadrant) => (
            <div class="flex gap-[5px]">
              {quadrant.map((t) => (
                <div class={`odo-col flex items-center gap-1.5 ${t.lower ? 'flex-col-reverse' : 'flex-col'}`} data-odo-col>
                  {/* The tooth's picture: first, so it sits on the outside of the arch (above an upper tooth, below a
                      lower one). Not a control of its own: a click on it opens the tooth as the box does. */}
                  <span class="odo-pic" data-odo-pic aria-hidden="true">
                    <svg viewBox={`0 0 ${PIC_W} ${PIC_H}`} focusable="false">
                      <g class="odo-tilt" data-tilt={t.tilt}><g transform={t.flip}>
                        {PICTURES[t.pic].back && <use class="odo-back" href={`#${picId}-${t.pic}-b`} />}
                        <use class="odo-root" href={`#${picId}-${t.pic}-r`} />
                        <use class="odo-post" href={`#${picId}-${t.pic}-p`} />
                        <use class="odo-canal" href={`#${picId}-${t.pic}-k`} />
                        <use class="odo-crown" href={`#${picId}-${t.pic}-c`} />
                      </g></g>
                      <path class="odo-x" d="M4.5 6 19.5 30M19.5 6 4.5 30" />
                    </svg>
                  </span>
                  <button
                    type="button"
                    class:list={['tooth', t.lower && 'tooth--lower']}
                    data-tooth
                    data-state={t.state}
                    data-surface-condition={t.surfaceCondition}
                    data-fdi={t.fdi}
                    data-universal={t.universal}
                    data-palmer={t.palmer}
                    tabindex={t.fdi === firstFdi ? 0 : -1}
                    aria-haspopup="dialog"
                    aria-label={describe(t, t[notation])}
                    data-tooth-work={[t.plan && 'plan', t.done && 'done'].filter(Boolean).join(' ') || undefined}
                    data-tooth-work-words={t.workWords || undefined}
                  >
                    {SURFACES.map((s) => (
                      <span
                        class="pip"
                        data-surface={s}
                        data-on={t.surfaces.includes(s) ? '' : undefined}
                        style={`left:${t.pips[s].x}%;top:${t.pips[s].y}%`}
                      ></span>
                    ))}
                  </button>
                  <span class="text-[11px] tabular-nums text-muted" data-label>{t[notation]}</span>
                  <span class="tooth-marks" data-tooth-marks aria-hidden="true">
                    {t.plan && <span class="tooth-mark-plan"></span>}
                    {t.done && <span class="tooth-mark-done"></span>}
                  </span>
                </div>
              ))}
            </div>
          ))}
        </div></div>
      </>
    ))}
    </div>
    ))}
    </div>

    {codes && (
      <p class="mt-5 text-[13px] leading-relaxed text-ink-2" data-code-legend>
        {CODE_LEGEND.map(([c, words], i) => (
          <><span class="whitespace-nowrap"><b class="font-semibold text-ink">{CONDITION_CODE[c]}</b> – {words}</span>{i < CODE_LEGEND.length - 1 ? '\u00a0· ' : ''}</>
        ))}
      </p>
    )}
    <p class="odo-help mt-6 text-[13px] text-muted">
      Click a tooth to pick a finding and its surfaces. Arrow keys move between teeth.
    </p>
    {saveUrl && <p class="meta mt-2 min-h-[1.05rem]" data-save-status role="status"></p>}
    {saveUrl && (
      <div data-hold-note hidden class="mt-3 flex flex-wrap items-center justify-between gap-3 border border-line-2 bg-bg-soft px-4 py-3">
        <p class="text-[14.5px] leading-snug text-ink" data-hold-text></p>
        <a data-hold-signin hidden href="/auth/login/" class="inline-flex min-h-11 items-center border border-line bg-surface px-3.5 py-2.5 text-[13px] font-medium text-ink-2 hover:border-accent hover:text-accent">Sign in again</a>
        <button type="button" data-hold-reload hidden class="min-h-11 cursor-pointer border border-line bg-surface px-3.5 py-2.5 text-[13px] font-medium text-ink-2 hover:border-accent hover:text-accent">Reload</button>
        <span data-hold-choice hidden class="flex flex-wrap gap-2">
          <button type="button" data-hold-save class="min-h-11 cursor-pointer border border-accent bg-accent px-3.5 py-2.5 text-[13px] font-medium text-surface hover:opacity-90">Save them</button>
          <button type="button" data-hold-delete class="min-h-11 cursor-pointer border border-line bg-surface px-3.5 py-2.5 text-[13px] font-medium text-ink-2 hover:border-caries hover:text-caries">Delete them</button>
        </span>
      </div>
      <div data-copy-note hidden class="mt-3 flex flex-wrap items-center justify-between gap-3 border border-line-2 bg-bg-soft px-4 py-3">
        <p class="text-[14.5px] leading-snug text-ink" data-copy-text></p>
        <button type="button" data-copy-reload hidden class="min-h-11 cursor-pointer border border-line bg-surface px-3.5 py-2.5 text-[13px] font-medium text-ink-2 hover:border-accent hover:text-accent">Reload</button>
      </div>
      <div data-sync-notice hidden class="mt-3 border border-crown/40 bg-crown/10 px-4 py-3">
        <ul data-sync-notice-list role="alert" class="flex flex-col gap-2 text-[14.5px] leading-snug text-ink"></ul>
        <button type="button" data-sync-notice-ok hidden class="mt-3 min-h-11 cursor-pointer border border-line bg-surface px-3.5 py-2.5 text-[13px] font-medium text-ink-2 hover:border-accent hover:text-accent">Got it</button>
      </div>
    )}
  </div>

  <div class="flex w-full shrink-0 flex-col border border-line-2 bg-bg-soft p-5 lg:w-[290px]" data-odo-note>
    {/* Where it is: the whole mouth from above, as a dentist reads a chart (the patient's right on the left), the tooth
        pointed at or focused (whichever came last) and the open one lit in teal, and named in words under it; the
        findings mirrored faintly. A picture only, for the eye: nothing in it is a control, and a screen reader skips it
        (each tooth's own button says its number and name). */}
    <div class="odo-where" aria-hidden="true">
      <span class="meta">Where it is</span>
      <div class="odo-map">
        <svg viewBox={`${mouth.box.x} ${mouth.box.y} ${mouth.box.w} ${mouth.box.h}`} focusable="false">
          {mapSets.map((g) => (
            <g data-map-set={g.key}>
              {g.teeth.map((m) => (
                <rect x={m.x0} y={m.y0} width={m.w} height={m.h} rx={m.rx} transform={`rotate(${m.angle} ${m.x} ${m.y})`}
                  data-map-fdi={m.fdi} data-state={m.state} data-surface-condition={m.surfaceCondition} />
              ))}
            </g>
          ))}
        </svg>
        <span class="odo-map-side" style={`top:${mouth.band}%`} data-side="right">Right</span>
        <span class="odo-map-side" style={`top:${mouth.band}%`} data-side="left">Left</span>
      </div>
      <p class="odo-where-line" data-odo-where-line>Point at a tooth to see where it is</p>
    </div>
    <div class="flex items-baseline justify-between">
      <span class="meta">Chart note</span>
      <span data-count class="text-xs tabular-nums text-muted"></span>
    </div>
    <p data-note-empty class="mt-3.5 text-sm leading-relaxed text-muted">
      Nothing charted yet. Mark a tooth and it lands here, the way it would in a real patient record.
    </p>
    <ul data-note-list class="mt-3.5 flex flex-col gap-2.5" hidden></ul>
    <div class="min-h-4 flex-1"></div>
    <button type="button" data-clear class="mt-4 min-h-11 w-full cursor-pointer border border-line bg-surface px-3.5 py-2.5 text-[13px] font-medium text-ink-2 hover:border-accent hover:text-accent">
      Clear chart
    </button>
  </div>

  <svg class="odo-defs" width="0" height="0" aria-hidden="true" focusable="false">
    <defs>
      {picKinds.map(([k, p]) => (
        <>
          <path id={`${picId}-${k}-c`} d={p.crown} vector-effect="non-scaling-stroke" />
          <path id={`${picId}-${k}-r`} d={p.root} vector-effect="non-scaling-stroke" />
          {p.back && <path id={`${picId}-${k}-b`} d={p.back} vector-effect="non-scaling-stroke" />}
          <path id={`${picId}-${k}-k`} d={p.canal} vector-effect="non-scaling-stroke" />
          <path id={`${picId}-${k}-p`} d={p.post} vector-effect="non-scaling-stroke" />
        </>
      ))}
      {/* A root fragment: the roots hatched in the caries red. */}
      <pattern id={`${picId}-hatch`} width="3.2" height="3.2" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <rect width="3.2" height="3.2" class="odo-hatch-ground" />
        <rect width="1.3" height="3.2" class="odo-hatch-line" />
      </pattern>
    </defs>
  </svg>

  <!-- One shared palette, moved to the clicked tooth. Native popover gives
       Escape, light-dismiss and focus handling without writing any of it. -->
  <div popover data-palette role="dialog" aria-label="Tooth finding" class="w-[320px] border border-line bg-surface p-4">
    {/* The open tooth's number and name, and where it is in the mouth: the same map, small, the tooth lit (a picture for
        the eye; the title says it in words). */}
    <div class="odo-pal-head">
      <p class="font-display text-[17px] font-semibold" data-palette-title>Tooth</p>
      <div class="odo-map odo-map-mini" aria-hidden="true">
        <svg viewBox={`${mouth.box.x} ${mouth.box.y} ${mouth.box.w} ${mouth.box.h}`} focusable="false">
          {mapSets.map((g) => (
            <g data-map-set={g.key}>
              {g.teeth.map((m) => (
                <rect x={m.x0} y={m.y0} width={m.w} height={m.h} rx={m.rx} transform={`rotate(${m.angle} ${m.x} ${m.y})`} data-mini-fdi={m.fdi} />
              ))}
            </g>
          ))}
        </svg>
      </div>
    </div>

    <div data-surface-block>
      <p class="meta mt-3">Surfaces</p>
      <div class="mt-2 grid grid-cols-5 gap-1.5">
        {SURFACES.map((s) => (
          <button
            type="button"
            data-surface-toggle={s}
            aria-pressed="false"
            class="min-h-11 cursor-pointer border border-line py-2.5 text-[13px] font-semibold text-ink-2 aria-pressed:border-accent aria-pressed:bg-accent aria-pressed:text-surface"
          >
            <span data-surface-code>{s === 'occlusal' ? 'O' : SURFACE_LABEL[s][0]}</span>
          </button>
        ))}
      </div>
    </div>

    <p class="meta mt-4">Per surface</p>
    <div class="mt-2 grid grid-cols-3 gap-1.5">
      {surfaceConditions.map((c) => (
        <button type="button" data-condition={c} data-scope="surface" class="min-h-11 cursor-pointer border border-line px-2 py-2.5 text-[13px] font-medium hover:border-accent hover:text-accent">
          {CONDITION_LABEL[c]}
        </button>
      ))}
    </div>

    <p class="meta mt-4">Whole tooth</p>
    <div class="mt-2 grid grid-cols-3 gap-1.5">
      {wholeConditions.map((c) => (
        <button type="button" data-condition={c} data-scope="whole" class="min-h-11 cursor-pointer border border-line px-2 py-2.5 text-[12.5px] font-medium hover:border-accent hover:text-accent">
          {CONDITION_LABEL[c]}
        </button>
      ))}
    </div>

    <button type="button" data-condition="sound" data-scope="whole" class="mt-3 min-h-11 w-full cursor-pointer border border-line px-3 py-2.5 text-[13px] font-medium text-ink-2 hover:border-caries hover:text-caries">
      Clear this tooth
    </button>

    {actions && (
      <div data-pick-block class="mt-4 border-t border-line pt-3.5">
        <p class="meta" data-pick-title>For tooth</p>
        <div class="mt-2 grid grid-cols-3 gap-1.5" data-pick-acts>
          <button type="button" data-pick-open="rec-plan-add" data-pick-fdi="" data-pick-surfaces="" class="min-h-11 cursor-pointer border border-line px-1.5 py-1.5 text-[12.5px] leading-tight font-medium">Add to plan</button>
          <button type="button" data-pick-open="rec-done-add" data-pick-fdi="" data-pick-surfaces="" class="min-h-11 cursor-pointer border border-line px-1.5 py-1.5 text-[12.5px] leading-tight font-medium">Treatment done</button>
          <button type="button" data-pick-open="rec-note-add" data-amends="" data-pick-fdi="" data-pick-surfaces="" class="min-h-11 cursor-pointer border border-line px-1.5 py-1.5 text-[12.5px] leading-tight font-medium">Clinical note</button>
        </div>
        <p data-pick-offline hidden class="mt-2 text-[13px] leading-snug text-ink-2">Planning, recording and notes need the connection. Findings still save on this device.</p>
      </div>
    )}
  </div>
</div>

<script>
  import {
    CONDITION_LABEL, SURFACE_SCOPED, SURFACE_LABEL, occlusalWord, occlusalCode, surfaceSummary,
    type ToothCondition, type ToothMark, type Surface,
  } from '../data/demo';
  import * as queue from '../lib/offline-queue';
  import { toothName, toothTitle } from '../lib/tooth-name';

  const SURFACES: Surface[] = ['mesial', 'occlusal', 'distal', 'buccal', 'lingual'];
  const SWATCH: Record<string, string> = {
    caries: 'var(--c-caries)', filled: 'var(--c-accent)', sealant: '#0ea5e9',
    crown: 'var(--c-crown)', bridge: 'var(--c-crown)', veneer: '#d946ef',
    root_canal: '#8b5cf6', implant: '#64748b', missing: 'var(--c-tooth-missing)',
    unerupted: 'var(--c-muted)', impacted: 'var(--c-muted)',
    // The paper chart's findings (045); the same hues as their teeth in global.css.
    extraction: 'var(--c-caries)', root_fragment: 'var(--c-caries)', abutment: 'var(--c-crown)',
    pontic: 'var(--c-crown)', denture: '#c74b77', amalgam: '#7b8591', inlay: '#a87a12',
  };
  // A change still in the queue this long after it was made is shown as kept
  // on this device. Most saves come back well inside it, so a chart on a good
  // line never flickers a marker.
  const WAITING_AFTER_MS = 1500;

  document.querySelectorAll<HTMLElement>('[data-odontogram]').forEach((root) => {
    const teeth = [...root.querySelectorAll<HTMLButtonElement>('button[data-tooth]')];
    const palette = root.querySelector<HTMLElement>('[data-palette]')!;
    const title = palette.querySelector<HTMLElement>('[data-palette-title]')!;
    const surfaceBlock = palette.querySelector<HTMLElement>('[data-surface-block]')!;
    const list = root.querySelector<HTMLElement>('[data-note-list]')!;
    const empty = root.querySelector<HTMLElement>('[data-note-empty]')!;
    const counter = root.querySelector<HTMLElement>('[data-count]')!;

    const marks = new Map<HTMLButtonElement, ToothMark>();
    let active: HTMLButtonElement | null = null;
    let picked = new Set<Surface>();
    // Teeth whose latest change is kept on this device and not on the server yet,
    // and how many changes that is (a clear of an empty chart has no tooth to mark).
    let waitingTeeth = new Set<HTMLButtonElement>();
    let waitingCount = 0;

    const fdiOf = (b: HTMLButtonElement) => Number(b.dataset.fdi);
    const nameOf = (b: HTMLButtonElement) => b.dataset[root.dataset.notation ?? 'fdi'] ?? b.dataset.fdi!;
    const byFdi = new Map(teeth.map((b) => [fdiOf(b), b]));
    const nameOfFdi = (fdi: number) => { const b = byFdi.get(fdi); return b ? nameOf(b) : String(fdi); };

    // Seed from what the server rendered so an existing chart survives hydration.
    teeth.forEach((b) => {
      const whole = b.dataset.state;
      const surf = b.dataset.surfaceCondition;
      if (surf) {
        const on = [...b.querySelectorAll<HTMLElement>('.pip[data-on]')].map((p) => p.dataset.surface as Surface);
        marks.set(b, { condition: surf as ToothCondition, surfaces: on });
      } else if (whole && whole !== 'sound') {
        marks.set(b, { condition: whole as ToothCondition });
      }
    });
    // The chart as the server drew it. Kept changes are laid over this.
    const base = new Map(marks);

    function describe(b: HTMLButtonElement) {
      const m = marks.get(b);
      const name = `${nameOf(b)}, ${toothName(fdiOf(b))}`;
      const kept = waitingTeeth.has(b) ? ' Saved on this device, will sync.' : '';
      // Planned and done work on the tooth (the record's), for everyone who sees the chart: it survives every repaint.
      const work = b.dataset.toothWorkWords ? ` ${b.dataset.toothWorkWords}` : '';
      if (!m) return `Tooth ${name}, Sound.${kept}${work} Activate to edit.`;
      if (m.surfaces?.length) {
        return `Tooth ${name}, ${CONDITION_LABEL[m.condition]} on ${surfaceSummary(fdiOf(b), m.surfaces)}.${kept}${work} Activate to edit.`;
      }
      return `Tooth ${name}, ${CONDITION_LABEL[m.condition]}.${kept}${work} Activate to edit.`;
    }

    function paint(b: HTMLButtonElement) {
      const m = marks.get(b);
      const scoped = m && SURFACE_SCOPED.includes(m.condition);
      b.dataset.state = m && !scoped ? m.condition : 'sound';
      b.dataset.surfaceCondition = scoped ? m!.condition : '';
      b.querySelectorAll<HTMLElement>('.pip').forEach((p) => {
        const on = scoped && m!.surfaces?.includes(p.dataset.surface as Surface);
        if (on) p.setAttribute('data-on', '');
        else p.removeAttribute('data-on');
      });
      b.toggleAttribute('data-waiting', waitingTeeth.has(b));
      b.setAttribute('aria-label', describe(b));
    }

    function render() {
      const entries = teeth.filter((b) => marks.has(b));
      counter.textContent = entries.length ? `${entries.length} marked` : '';
      empty.hidden = entries.length > 0;
      list.hidden = entries.length === 0;
      list.replaceChildren(
        ...entries.map((b) => {
          const m = marks.get(b)!;
          const li = document.createElement('li');
          li.className = 'flex items-center gap-2.5';

          const dot = document.createElement('span');
          dot.className = 'swatch ';
          dot.style.background = SWATCH[m.condition] ?? 'var(--c-muted)';

          const num = document.createElement('span');
          num.className = 'min-w-12 text-sm font-semibold tabular-nums';
          const codes = surfaceSummary(fdiOf(b), m.surfaces);
          num.textContent = codes ? `${nameOf(b)} ${codes}` : nameOf(b);

          const label = document.createElement('span');
          label.className = 'text-sm text-ink-2';
          label.textContent = CONDITION_LABEL[m.condition];

          li.append(dot, num, label);
          if (waitingTeeth.has(b)) {
            // Where the row is too narrow, the tag drops to its own line rather than breaking the finding's name.
            li.className = 'flex flex-wrap items-center gap-x-2.5 gap-y-0.5';
            label.classList.add('whitespace-nowrap');
            const tag = document.createElement('span');
            tag.className = 'meta ml-auto whitespace-nowrap';
            tag.textContent = 'Will sync';
            li.append(tag);
          }
          return li;
        })
      );
    }

    // --- saving ------------------------------------------------------------
    // With data-save-url set, every commit in the palette is one change —
    // { fdi, condition, surfaces } for a tooth (condition null clears it) or
    // { clear: true } for the whole chart — written to this device first and
    // then sent (src/lib/offline-queue.ts). A change that cannot go stays on
    // the device, is shown as such on the tooth, in the chart note and in the
    // status line, and goes on its own: when the connection comes back, when
    // the page loads, every 30 seconds while anything waits. What the server
    // decided about it comes back here: saved, or kept as a colleague's newer
    // finding — then the tooth shows theirs and a notice says which tooth.
    // Each change carries when the server drew this chart (data-rendered-at),
    // so a colleague's finding saved after that — one this chart never showed
    // — is kept and named, not replaced unseen.
    //
    // A chart is its sign-in's (data-staff and data-sid, from the session on
    // the server): once that person has signed out on this device, someone
    // else has signed in, or the sign-in has run out, it takes no more
    // changes, and says so at once in one line with Reload. It hears that from
    // the device (another tab's sign-out or sign-in, the service worker) and
    // asks the server itself when it is looked at again, on reconnect, every
    // 30 seconds, and when a tooth is opened or Clear chart pressed. A change
    // is written to the device at the tap — a tab dropped a moment later, on a
    // line that hangs, still has it — but kept unconfirmed, and not sent,
    // until that answer is in (at most 4 seconds): a tap in a tab whose
    // sign-in another sign-in replaced is then deleted and refused, not kept
    // under the wrong name. Whatever it still kept waits for that person: the
    // server saves a change only under the sign-in it was made under, and at
    // their next sign-in this chart shows it marked, with Save and Delete, so
    // nothing is filed under their name unseen. While a sign-out from another
    // tab is on its way, the chart takes no changes and says "Signing out…".
    //
    // The status line counts only changes that are on the device: one still
    // on its way there is "Saving…". A kept copy of this page (the service
    // worker's) says the connection is back only once a request to the
    // server has really come back.
    const saveUrl = root.dataset.saveUrl;
    const status = root.querySelector<HTMLElement>('[data-save-status]');
    const clock = new Intl.DateTimeFormat('en-PH', { hour: 'numeric', minute: '2-digit', timeZone: 'Asia/Manila' });
    const dayFmt = new Intl.DateTimeFormat('en-PH', { weekday: 'short', day: 'numeric', month: 'short', timeZone: 'Asia/Manila' });
    const dayKey = new Intl.DateTimeFormat('en-CA', { year: 'numeric', month: '2-digit', day: '2-digit', timeZone: 'Asia/Manila' });
    const scope: queue.Scope | null = saveUrl && root.dataset.staff && root.dataset.sid && root.dataset.clinic && root.dataset.patient
      ? { staff: root.dataset.staff, sid: root.dataset.sid, clinic: root.dataset.clinic, patient: root.dataset.patient }
      : null;
    const renderedAt = Number(root.dataset.renderedAt) || null;
    // Set by the service worker when this page is the copy it kept, served because the network failed.
    const copyAt = Number(document.documentElement.dataset.offlineCopy) || null;
    // When this page's sign-in runs out, on this device's clock: how long it had left when the server
    // drew the page, counted from when the page (or the kept copy) arrived, so a wrong clock does not matter.
    const sessionLeft = root.dataset.sessionLeft ? Number(root.dataset.sessionLeft) : null;
    const deadline = sessionLeft !== null && Number.isFinite(sessionLeft) ? (copyAt ?? Date.now()) + sessionLeft : null;
    const csrf = root.dataset.csrf ?? '';
    const copyNote = root.querySelector<HTMLElement>('[data-copy-note]');
    const noticeBox = root.querySelector<HTMLElement>('[data-sync-notice]');
    const noticeList = root.querySelector<HTMLElement>('[data-sync-notice-list]');
    const noticeOk = root.querySelector<HTMLButtonElement>('[data-sync-notice-ok]');
    const waitingLegend = root.querySelector<HTMLElement>('[data-waiting-legend]');
    const holdNote = root.querySelector<HTMLElement>('[data-hold-note]');
    const holdText = root.querySelector<HTMLElement>('[data-hold-text]');
    const holdSignIn = root.querySelector<HTMLAnchorElement>('[data-hold-signin]');
    const holdReload = root.querySelector<HTMLButtonElement>('[data-hold-reload]');
    const holdChoice = root.querySelector<HTMLElement>('[data-hold-choice]');
    const holdSave = root.querySelector<HTMLButtonElement>('[data-hold-save]');
    const holdDelete = root.querySelector<HTMLButtonElement>('[data-hold-delete]');
    let stored = true;
    let records: queue.Entry[] = [];
    // Sent changes this page has shown, by record key. They are the server's findings, and this page shows them
    // only from the device: when another tab or a sign-out deletes them there, the chart must not lose them.
    const shownSynced = new Map<string, queue.Entry>();
    let elsewhere: queue.Entry[] = [];
    // Everything this person has waiting, on any chart, in the order it goes.
    let allWaiting: queue.Entry[] = [];
    // The device refused to keep the last change (storage full or blocked).
    let refused = false;
    // This page's sign-in has ended on this device, and a tap was turned away because of it.
    let locked = false;
    let lockRefused = false;
    // Locked because a sign-out sent from another tab (or this one) is on its way: it may yet fail.
    let leaving = false;
    // A kept copy of the page: whether a request to the server has come back since it was shown.
    let reached = false;
    // Changes made in this tab and not yet written to the device (a few milliseconds): laid over
    // everything, so a repaint that reads the device a moment before the write lands never undoes a click.
    const optimistic: queue.Body[] = [];

    /** "10:05 am", or "Wed, Sep 23, 10:05 am" when it was not today in Manila. */
    function when(ms: number | string) {
      const d = new Date(ms);
      const time = clock.format(d).toLowerCase();
      return dayKey.format(d) === dayKey.format(new Date()) ? time : `${dayFmt.format(d)}, ${time}`;
    }

    function setStatus(text: string, strong = false) {
      if (!status) return;
      status.textContent = text;
      status.classList.toggle('meta-ink', strong);
    }

    function applyBody(into: Map<HTMLButtonElement, ToothMark>, body: queue.ToothBody) {
      const b = byFdi.get(body.fdi);
      if (!b) return;
      const c = body.condition as ToothCondition | null;
      if (!c || c === 'sound') into.delete(b);
      else if (SURFACE_SCOPED.includes(c)) into.set(b, { condition: c, surfaces: (body.surfaces ?? []) as Surface[] });
      else into.set(b, { condition: c });
    }

    /** The chart: as the server drew it, then every change this person made
     *  here since, in the order made — synced ones newer than the drawing (a
     *  kept copy of the page predates them) and waiting ones. */
    function lay() {
      const next = new Map(base);
      const waitingNow = new Set<HTMLButtonElement>();
      const now = Date.now();
      const offline = navigator.onLine === false;
      let count = 0;
      const layOne = (body: queue.Body, waiting: boolean) => {
        if (waiting) count++;
        if ('clear' in body) {
          if (waiting) next.forEach((_, b) => waitingNow.add(b));
          next.clear();
          (body.keep ?? []).forEach((t) => applyBody(next, t));
        } else {
          applyBody(next, body);
          const b = byFdi.get(body.fdi);
          if (b && waiting) waitingNow.add(b);
        }
      };
      for (const e of records) {
        if (e.kind !== 'change' || !e.body) continue;
        if (e.state === 'synced' && renderedAt !== null && (e.at ?? 0) <= renderedAt) continue;
        const waiting = e.state === 'pending'
          && (offline || !!e.hold || (e.tries ?? 0) > 0 || now - e.madeAt > WAITING_AFTER_MS || !queue.sameSignIn(e, scope!.sid));
        layOne(e.body, waiting);
      }
      // Not on the device yet: shown, but never marked as kept there.
      optimistic.forEach((body) => layOne(body, false));
      marks.clear();
      next.forEach((m, b) => marks.set(b, m));
      waitingTeeth = waitingNow;
      waitingCount = count;
      teeth.forEach(paint);
      render();
      if (waitingLegend) waitingLegend.hidden = waitingTeeth.size === 0;
    }

    /** Pending changes on this chart made under an earlier sign-in of this person: marked, and sent only if they choose Save. */
    const earlierHere = () => records.filter((e) => e.kind === 'change' && e.state === 'pending' && !queue.sameSignIn(e, scope!.sid));
    /** How sure the device is that an earlier sign-in's change is this person's. 'unsure': the server turned it away
     *  because someone else was signed in here when it was sent. 'unchecked': it was kept at a tap whose sign-in was
     *  never confirmed (its page closed before the answer came). Either may not be theirs, so they are asked to check. */
    const doubt = (e: queue.Entry): 'unsure' | 'unchecked' | null => (e.hold === 'owner' ? 'unsure' : e.unconfirmed ? 'unchecked' : null);

    /** Why waiting changes cannot go until the person acts, in a sentence, with the one button that fixes it.
     *  'unsure' / 'unchecked': earlier changes of which at least one may not be this person's (doubt()), so they
     *  are asked to check it. 'leaving': a sign-out is on its way; nothing to press. */
    function sayHold(held: queue.Hold | 'ended' | 'leaving' | 'earlier' | 'unsure' | 'unchecked' | null, n: number) {
      if (!holdNote) return;
      const one = n === 1;
      const them = one ? 'it' : 'them';
      const stays = one ? 'It stays' : 'They stay';
      // Without IndexedDB the changes live in this page only: leaving it to sign in or reload loses them.
      const lost = `this browser cannot keep chart changes once this page is left. Note the ${one ? 'tooth' : 'teeth'} marked “Will sync”`;
      let text = '';
      if (held === 'ended') {
        text = 'This page belongs to a sign-in that has ended. Reload to chart.';
      } else if (held === 'leaving') {
        text = 'Signing out…';
      } else if (held === 'earlier') {
        text = one
          ? 'A change you made before you last signed in is still on this device, marked on the chart. It is not saved. Save it or delete it.'
          : `${n} changes you made before you last signed in are still on this device, marked on the chart. They are not saved. Save them or delete them.`;
      } else if (held === 'unsure') {
        text = one
          ? 'A change on this chart was kept on this device while someone else was signed in here. It may not be yours, and it is not saved. Check the marked tooth, then save it or delete it.'
          : `${n} changes on this chart were kept on this device while someone else was signed in here. They may not be yours, and they are not saved. Check the marked teeth, then save them or delete them.`;
      } else if (held === 'unchecked') {
        text = one
          ? 'A change on this chart was kept on this device before it could check who was signed in. It may not be yours, and it is not saved. Check the marked tooth, then save it or delete it.'
          : `${n} changes on this chart were kept on this device before it could check who was signed in. They may not be yours, and they are not saved. Check the marked teeth, then save them or delete them.`;
      } else if (held === 'auth') {
        text = stored
          ? `Your sign-in has ended. Sign in again to save ${them}. ${stays} on this device until then.`
          : `Your sign-in has ended, and ${lost}, sign in again and chart ${them} again.`;
      } else if (held === 'csrf') {
        text = stored
          ? `This page is out of date. Reload it to send ${them}. ${stays} on this device until then.`
          : `This page is out of date, and ${lost}, reload and chart ${them} again.`;
      } else if (held === 'owner' || held === 'session') {
        text = `Someone else is signed in on this device now. ${one ? 'Your change stays' : `Your ${n} changes stay`} here, kept for you, until you sign in again.`;
      }
      holdNote.hidden = !text;
      if (holdText) holdText.textContent = text;
      if (holdSignIn) {
        holdSignIn.hidden = held !== 'auth';
        holdSignIn.href = `/auth/login/?next=${encodeURIComponent(location.pathname)}`;
      }
      if (holdReload) holdReload.hidden = held !== 'csrf' && held !== 'ended';
      if (holdChoice) holdChoice.hidden = held !== 'earlier' && held !== 'unsure' && held !== 'unchecked';
      if (holdSave) holdSave.textContent = one ? 'Save it' : 'Save them';
      if (holdDelete) holdDelete.textContent = one ? 'Delete it' : 'Delete them';
    }

    /** The change the server answered last on this chart (by this device's clock when the answer came): whether
     *  it was applied (for a clear, at least in part), the notice that came with it, if any, and the server's time. */
    function lastAnswer(): { applied: boolean; notice: queue.Entry | null; at: number } | null {
      const byId = new Map<string, { applied: boolean; notice: queue.Entry | null; at: number; order: number }>();
      for (const e of records) {
        const order = e.answered ?? e.at ?? 0;
        if (e.kind === 'change' && e.state === 'synced') {
          // A change this page was drawn with is not an answer to anything done here.
          if (renderedAt !== null && (e.at ?? 0) <= renderedAt) continue;
          const a = byId.get(e.id) ?? { applied: false, notice: null, at: 0, order };
          a.applied = e.outcome !== 'kept';
          a.at = e.at ?? 0;
          a.order = Math.max(a.order, order);
          byId.set(e.id, a);
        } else if (e.kind === 'notice') {
          const a = byId.get(e.id) ?? { applied: false, notice: null, at: 0, order };
          a.notice = e;
          a.order = Math.max(a.order, order);
          byId.set(e.id, a);
        }
      }
      let best: { applied: boolean; notice: queue.Entry | null; at: number; order: number } | null = null;
      byId.forEach((a) => { if (!best || a.order > best.order) best = a; });
      return best;
    }

    function say() {
      if (!scope) return;
      const pending = records.filter((e) => e.kind === 'change' && e.state === 'pending');
      const earlierOnes = earlierHere();
      const earlier = earlierOnes.length;
      // Only what is on the device counts as saved there. A change still on its way to it (optimistic,
      // a few milliseconds) is "Saving…", never counted in "saved on this device".
      const n = pending.length;
      const mine = n - earlier;
      // This sign-in's changes go oldest first and stop at the first that cannot: that one's reason holds
      // them all, even when it is another patient's change.
      const held = mine ? (allWaiting.find((e) => queue.sameSignIn(e, scope.sid))?.hold ?? null) : null;
      const count = (one: string, many: string) => (n === 1 ? one : `${n} ${many}`);
      // A page whose sign-in has ended says only that: it is the one thing to do here (or that a sign-out is
      // on its way). Then what holds this sign-in's changes, then the earlier sign-in's changes waiting for
      // Save or Delete.
      if (locked) sayHold(leaving ? 'leaving' : 'ended', n);
      else if (held) sayHold(held, mine);
      else {
        const doubts = earlierOnes.map(doubt);
        sayHold(!earlier ? null : doubts.includes('unsure') ? 'unsure' : doubts.includes('unchecked') ? 'unchecked' : 'earlier', earlier);
      }
      status?.classList.toggle('text-caries', refused || lockRefused);
      if (lockRefused) setStatus('Not saved', true);
      else if (refused) setStatus('Not saved — this device could not keep that change. Try that tooth again.', true);
      else if (held || earlier || (locked && n)) setStatus(`${count('Saved', 'changes saved')} on this device — not sent yet`, true);
      else if (n && waitingCount > 0) {
        setStatus(stored
          ? `${count('Saved', 'changes saved')} on this device — will sync`
          : `${count('Not sent yet', 'changes not sent yet')} — keep this page open and ${n === 1 ? 'it' : 'they'} will sync`, true);
      } else if (n || optimistic.length) setStatus('Saving…');
      else {
        // The last answer from the server decides the line: "Saved" only when it applied the change. When it kept
        // a colleague's finding instead, or refused the change, the notice below says so and this line points to it.
        const last = lastAnswer();
        if (last?.notice && !last.notice.read) {
          status?.classList.add('text-caries');
          setStatus(last.applied ? 'Partly saved — see below' : 'Not saved — see below', true);
        } else if (last?.applied && !last.notice) setStatus(`Saved ${when(last.at)}`);
        else if (navigator.onLine === false) setStatus('Offline — changes will be kept on this device', true);
        else setStatus('');
      }

      // A kept copy of the page, shown because the record could not be fetched. "The connection is back" only
      // once a request to the server has really come back (reached): the Wi-Fi being up says nothing — in a
      // brownout it stays up while nothing answers, and Reload would only bring this copy back.
      if (copyNote && copyAt) {
        const back = reached && navigator.onLine !== false;
        copyNote.hidden = false;
        copyNote.querySelector<HTMLElement>('[data-copy-text]')!.textContent = back
          ? `This is the copy of this record kept on this device at ${when(copyAt)}. The connection is back: reload to see the latest.`
          : `No connection. This is the copy of this record kept on this device at ${when(copyAt)}. Charting still works; changes sync when the line is back.`;
        // Reloading is safe while changes wait on the device; only memory would lose them.
        copyNote.querySelector<HTMLElement>('[data-copy-reload]')!.hidden = !back || (!stored && n + optimistic.length > 0);
      }
    }

    function noticeLines(n: queue.Notice): string[] {
      if (n.kind === 'dropped') {
        return [n.clear || n.fdi == null ? `The chart was not cleared. ${n.error ?? ''}`.trim() : `Tooth ${nameOfFdi(n.fdi)} was not saved. ${n.error ?? ''}`.trim()];
      }
      // What the server tells us: someone saved a change to this tooth (at `it.at`, when it reached
      // the server) that the chart this change was made on was not showing — made while this device
      // was offline, or while this chart sat open. Which was made first on the clinic floor is not
      // known, so the sentence never says "after you".
      return n.items.map((it) => {
        const tooth = nameOfFdi(it.fdi);
        const at = it.at ? ` at ${when(it.at)}` : '';
        const lead = n.clear ? `Tooth ${tooth} was not cleared` : `Your change to tooth ${tooth} was not saved`;
        if (it.you) {
          return `${lead}: you saved a change to it${at} on another screen, and this chart was not showing it. The chart shows that one now.`;
        }
        return `${lead}: ${it.by ?? 'Someone'} saved a change to it${at} that your chart was not showing. The chart shows theirs now.`;
      });
    }

    function tell() {
      if (!noticeBox || !noticeList || !noticeOk || !scope) return;
      const here = records.filter((e) => e.kind === 'notice' && e.notice && !e.read);
      const items: HTMLElement[] = [];
      here.forEach((e) => noticeLines(e.notice!).forEach((line) => {
        const li = document.createElement('li');
        li.textContent = line;
        items.push(li);
      }));
      // Other patients' charts: answers sent from this page, and changes from an earlier sign-in waiting
      // there for Save or Delete. Say so, and link to where the details are (no patient's name is kept).
      const others = new Map<string, { href: string; notice: boolean; earlier: boolean; unsure: boolean; unchecked: boolean }>();
      elsewhere.forEach((e) => {
        const k = `${e.clinic}|${e.patient}`;
        const o = others.get(k) ?? { href: `/c/${e.clinic}/patients/${e.patient}/`, notice: false, earlier: false, unsure: false, unchecked: false };
        const d = e.kind === 'change' ? doubt(e) : null;
        if (e.kind === 'notice') o.notice = true;
        else if (d === 'unsure') o.unsure = true;
        else if (d === 'unchecked') o.unchecked = true;
        else o.earlier = true;
        others.set(k, o);
      });
      // The sentence, then the way there on its own line: a full-size target for a gloved hand.
      const line = (href: string, text: string) => {
        const li = document.createElement('li');
        li.className = 'flex flex-col items-start gap-2';
        const p = document.createElement('span');
        p.textContent = text;
        const a = document.createElement('a');
        a.href = href;
        a.className = 'inline-flex min-h-11 items-center border border-line bg-surface px-3.5 py-2.5 text-[13px] font-medium text-ink-2 hover:border-accent hover:text-accent';
        a.textContent = 'Open that record';
        li.append(p, a);
        items.push(li);
      };
      others.forEach((o) => {
        if (o.notice) line(o.href, 'A change you made on another patient’s chart was not applied. That record says which tooth.');
        if (o.earlier) line(o.href, 'A change you made before you last signed in is waiting on another patient’s chart. It is not saved. Save or delete it there.');
        if (o.unsure) line(o.href, 'A change kept on this device while someone else was signed in here is waiting on another patient’s chart. It is not saved. Check it there.');
        if (o.unchecked) line(o.href, 'A change kept on this device before it could check who was signed in is waiting on another patient’s chart. It is not saved. Check it there.');
      });
      noticeList.replaceChildren(...items);
      noticeBox.hidden = items.length === 0;
      noticeOk.hidden = here.length === 0;
    }

    let reading = 0;
    async function refresh() {
      if (!scope) return;
      const mine = ++reading;
      const [r, o, w, state] = await Promise.all([queue.recordsFor(scope), queue.noticesElsewhere(scope), queue.waiting(scope.staff), queue.signInState()])
        .catch(() => [records, elsewhere, allWaiting, { who: locked ? null : { staff: scope.staff, sid: scope.sid }, leavingSince: null }] as const);
      const who = state.who;
      // Only the latest read paints: two reads racing never leave the older on screen.
      if (mine !== reading) return;
      // What the device holds, plus any sent change this page has shown that the device no longer holds (another
      // tab, a sign-out). In the order made, so a later change to the same tooth still lays over it.
      for (const e of r) {
        if (e.kind !== 'change' || e.state !== 'synced') continue;
        const had = shownSynced.get(e.key);
        if (!had || had.seq <= e.seq) shownSynced.set(e.key, e);
      }
      const ids = new Set(r.map((e) => e.id));
      records = [...r, ...[...shownSynced.values()].filter((e) => !ids.has(e.id))].sort((a, b) => a.seq - b.seq);
      elsewhere = o;
      allWaiting = w;
      // Whose sign-in this device is on now, as the last freshly drawn chart, a sign-in or sign-out, or the
      // server said; and whether this page's sign-in has simply run out.
      const expired = deadline !== null && Date.now() >= deadline;
      locked = expired || !who || who.staff !== scope.staff || who.sid !== scope.sid;
      // A sign-out on its way says so for as long as it can take; past that it is over (its tab closed mid-way).
      const leftFor = !expired && !who && state.leavingSince !== null ? state.leavingSince + queue.LEAVING_MS - Date.now() : 0;
      leaving = leftFor > 0;
      if (leaving) setTimeout(refresh, leftFor + 50);
      if (!locked) lockRefused = false;
      else if (palette.matches(':popover-open')) palette.hidePopover();
      lay();
      say();
      tell();
    }

    // Sending under a sign-in that has ended would only be refused: this page leaves it to a fresh one.
    const kick = () => {
      if (scope && !locked && navigator.onLine !== false) queue.flush(scope.staff, scope.sid, csrf);
    };

    // The server's word on who is signed in here. When it differs from this page's sign-in, the device
    // records it and every open chart hears so (onChange), and this one locks. ask() always asks: a tooth
    // opened (or Clear chart pressed) asks, and that change is confirmed only once the answer is in (keep),
    // so the palette opens at once and the question runs while the person picks. check() is for an idle
    // chart — looked at again, reconnected, every 30 seconds — and asks at most once in five seconds. On a
    // kept copy of the page, every answer (or none) also says whether the connection is back (reached).
    let lastCheck = 0;
    const heard = (w: unknown) => {
      if (!copyAt || (w !== undefined) === reached) return;
      reached = w !== undefined;
      say();
    };
    const ask = (): Promise<unknown> => {
      if (!scope || navigator.onLine === false) { heard(undefined); return Promise.resolve(); }
      // A locked page has nothing to ask about, except whether the line is back, on a copy.
      if (locked && !copyAt) return Promise.resolve();
      lastCheck = Date.now();
      return queue.serverWho().then((w) => { heard(w); return w; }, () => { heard(undefined); });
    };
    const check = (): Promise<unknown> => (Date.now() - lastCheck >= 5_000 ? ask() : Promise.resolve());
    // The question asked when the open tooth was opened.
    let asked: Promise<unknown> = Promise.resolve();

    /** A tap on a chart whose sign-in has ended: nothing opens, the line under the chart says why, and Reload has the focus. */
    function refuseLocked() {
      lockRefused = true;
      say();
      holdNote?.scrollIntoView({ block: 'nearest' });
      holdReload?.focus({ preventScroll: true });
    }

    // Changes are written to the device in the order made, one after another, at once. None waits there for
    // the answer about who is signed in: each is confirmed (or refused) when its own answer is in.
    let keeping: Promise<void> = Promise.resolve();
    function commit(body: queue.Body, answer: Promise<unknown>) {
      if (!scope || !saveUrl) return;
      optimistic.push(body);
      say();
      keeping = keeping.then(() => keep(body, answer));
    }

    /** A tap the device would not take, or took and then had to refuse: the chart goes back to what is really
     *  saved, and the line says why — this page's sign-in has ended (Reload), or the device would not keep it
     *  (storage full or blocked). */
    async function notKept(err: unknown) {
      if ((err as Error)?.name === 'SignedOut') {
        locked = true;
        lockRefused = true;
      } else refused = true;
      await refresh();
      if (lockRefused) refuseLocked();
    }

    async function keep(body: queue.Body, answer: Promise<unknown>) {
      if (!scope || !saveUrl) return;
      let entry: queue.Entry;
      try {
        // After this page has said whose it is (milliseconds after load), so a quick first tap is never taken
        // for a stale page. Then straight onto the device, unconfirmed: a tab dropped from here on keeps it.
        await claimed;
        entry = await queue.enqueue(scope, saveUrl, body, renderedAt, true);
      } catch (err) {
        optimistic.splice(optimistic.indexOf(body), 1);
        await notKept(err);
        return;
      }
      optimistic.splice(optimistic.indexOf(body), 1);
      refused = false;
      await refresh();
      // It is on the device: once a save would normally be back, show it as kept there, answer or not.
      setTimeout(refresh, WAITING_AFTER_MS + 100);
      settle(entry, answer);
    }

    /** Once the server has said who is signed in here now (the question asked when the tooth was opened), or could
     *  not say within 4 seconds: if that is still this page's person and sign-in, the change is confirmed and goes;
     *  if not, the device already knows (follow), and the change is deleted and the tap refused. */
    async function settle(entry: queue.Entry, answer: Promise<unknown>) {
      if (!scope) return;
      await answer;
      try {
        await queue.confirmKept(scope, entry);
      } catch (err) {
        if ((err as Error)?.name === 'SignedOut') await notKept(err);
        // Storage failed: it stays unconfirmed, and the server's next word on this sign-in settles it.
        return;
      }
      await refresh();
      // Look again once a slow save has had its chance, so a waiting change shows as waiting.
      setTimeout(refresh, WAITING_AFTER_MS + 100);
      kick();
    }

    noticeOk?.addEventListener('click', () => {
      queue.dismiss(records.filter((e) => e.kind === 'notice').map((e) => e.key));
    });
    copyNote?.querySelector('[data-copy-reload]')?.addEventListener('click', () => location.reload());
    holdReload?.addEventListener('click', () => location.reload());

    // Changes made under an earlier sign-in, shown marked on this chart: the person chooses.
    holdSave?.addEventListener('click', async () => {
      if (!scope) return;
      if (locked) return refuseLocked();
      try {
        await queue.adopt(scope, earlierHere().map((e) => e.key));
      } catch (err) {
        if ((err as Error)?.name === 'SignedOut') { locked = true; lockRefused = true; }
      }
      await refresh();
      if (lockRefused) return refuseLocked();
      kick();
    });
    holdDelete?.addEventListener('click', async () => {
      if (!scope) return;
      const keys = earlierHere().map((e) => e.key);
      if (!keys.length) return;
      const what = keys.length === 1 ? 'this chart change' : `these ${keys.length} chart changes`;
      if (!confirm(`Delete ${what} from this device? ${keys.length === 1 ? 'It was' : 'They were'} never saved.`)) return;
      await queue.forget(scope, keys).catch(() => {});
      await refresh();
    });

    // This page, just drawn by the server for the person signed in, says so to the device.
    const claimed = scope
      ? (async () => {
        stored = await queue.persistent();
        await queue.setCurrentUser({ staff: scope.staff, sid: scope.sid }).catch(() => {});
      })()
      : Promise.resolve();

    if (scope) {
      // Signing out from this page sends what waits first, asks before deleting anything
      // unsent or unread, then clears this person's records from the device.
      queue.nameTeeth(nameOfFdi);
      queue.guardSignOut();
      (async () => {
        await claimed;
        // Sent changes and answers past their keeping time go.
        await queue.tidy().catch(() => {});
        queue.onChange(refresh);
        await refresh();
        kick();
        // A kept copy: is the line really back? (The server's answer also settles changes this sign-in kept
        // unconfirmed before the page closed, and they go.)
        if (copyAt) ask().then(kick);
      })();
      addEventListener('online', () => { refresh(); (copyAt ? ask() : check()).then(kick); kick(); });
      addEventListener('offline', () => { heard(undefined); refresh(); });
      // Between the tap and the device's write (milliseconds) a change lives only in this page: leaving asks first.
      addEventListener('beforeunload', (e) => { if (optimistic.length) { e.preventDefault(); e.returnValue = ''; } });
      addEventListener('pageshow', (e) => { if (e.persisted) { refresh(); check().then(kick); kick(); } });
      document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'visible') { check().then(kick); kick(); } });
      setInterval(() => {
        const asked = document.visibilityState === 'visible' ? check() : Promise.resolve();
        // After the answer: it may have confirmed changes kept unconfirmed, which can go now.
        asked.then(() => {
          if (records.some((e) => e.kind === 'change' && e.state === 'pending')) kick();
          else queue.waiting(scope.staff).then((w) => { if (w.length) kick(); }).catch(() => {});
        });
      }, queue.RETRY_MS);
      // The moment this page's sign-in runs out, it locks. (Capped: a longer timer would fire at once.)
      if (deadline !== null) setTimeout(refresh, Math.min(2 ** 31 - 1, Math.max(0, deadline - Date.now()) + 100));
    }

    function openPalette(b: HTMLButtonElement) {
      if (locked) return refuseLocked();
      asked = ask();
      active = b;
      const fdi = fdiOf(b);
      const m = marks.get(b);
      picked = new Set(m?.surfaces ?? []);

      title.textContent = `Tooth ${nameOf(b)} · ${toothTitle(fdi)}`;
      openFdi = fdi;
      lightMap();
      // Anteriors have an incisal edge, not an occlusal table.
      palette.querySelector<HTMLElement>('[data-surface-toggle="occlusal"] [data-surface-code]')!
        .textContent = occlusalCode(fdi);
      palette.querySelector<HTMLButtonElement>('[data-surface-toggle="occlusal"]')!
        .title = occlusalWord(fdi);
      syncSurfaces();

      palette.showPopover();
      const r = b.getBoundingClientRect();
      const w = palette.offsetWidth;
      const left = Math.min(Math.max(8, r.left + r.width / 2 - w / 2), innerWidth - w - 8);
      const below = r.bottom + 10;
      const fits = below + palette.offsetHeight < innerHeight - 8;
      palette.style.left = `${left}px`;
      palette.style.top = fits ? `${below}px` : `${Math.max(8, r.top - palette.offsetHeight - 10)}px`;
      // The record actions show while the line answers: hidden at once offline or on a kept copy, and when the
      // question this tooth just asked (at most 4 seconds) comes back with no answer.
      pickHeard = 'waiting';
      syncPick();
      const mine = asked;
      mine.then((w) => { if (asked === mine) { pickHeard = w === undefined ? 'no' : 'yes'; syncPick(); } });
    }

    function syncSurfaces() {
      palette.querySelectorAll<HTMLButtonElement>('[data-surface-toggle]').forEach((t) => {
        t.setAttribute('aria-pressed', String(picked.has(t.dataset.surfaceToggle as Surface)));
      });
      syncPick();
    }

    // --- the palette's record actions (the record page only: `actions`) ---------------------------------------
    // Add to plan, Treatment done and Clinical note open the record's panels for the open tooth, with the surfaces
    // ticked above as a suggestion ("For 26 MO"). They need the server: offline, on a kept copy of the page, or when
    // the tooth's check got no answer, one line says so instead. data-pick-open, not data-ws-open, so the shell
    // never takes a hidden palette button for the opener of a panel it draws open.
    const pickBlock = palette.querySelector<HTMLElement>('[data-pick-block]');
    const pickTitle = palette.querySelector<HTMLElement>('[data-pick-title]');
    const pickActs = palette.querySelector<HTMLElement>('[data-pick-acts]');
    const pickOffline = palette.querySelector<HTMLElement>('[data-pick-offline]');
    let pickHeard: 'waiting' | 'yes' | 'no' = 'waiting';
    const PICK_WORDS: Record<string, string> = { 'rec-plan-add': 'Add to plan', 'rec-done-add': 'Treatment done', 'rec-note-add': 'Clinical note' };
    function syncPick() {
      if (!pickBlock || !active) return;
      const fdi = fdiOf(active);
      const codes = surfaceSummary(fdi, [...picked]);
      pickBlock.querySelectorAll<HTMLElement>('[data-pick-fdi]').forEach((btn) => {
        btn.dataset.pickFdi = String(fdi);
        btn.dataset.pickSurfaces = codes;
        const words = PICK_WORDS[btn.dataset.pickOpen ?? ''] ?? '';
        btn.setAttribute('aria-label', btn.dataset.pickOpen === 'rec-note-add' ? `${words}: tooth ${fdi}` : `${words}: tooth ${fdi}${codes ? ` ${codes}` : ''}`);
      });
      if (pickTitle) pickTitle.textContent = `For ${(root.dataset.notation ?? 'fdi') === 'fdi' ? '' : 'FDI '}${fdi}${codes ? ` ${codes}` : ''}`;
      const away = !!copyAt || navigator.onLine === false || pickHeard === 'no';
      if (pickActs) pickActs.hidden = away;
      if (pickOffline) pickOffline.hidden = !away;
    }
    if (pickBlock) {
      const again = () => { if (palette.matches(':popover-open')) syncPick(); };
      addEventListener('online', again);
      addEventListener('offline', again);
      pickBlock.querySelectorAll<HTMLButtonElement>('[data-pick-open]').forEach((btn) => btn.addEventListener('click', () => {
        palette.hidePopover();                               // before showModal: a popover over a modal would sit on top
        window.ws?.openPanel(btn.dataset.pickOpen!, btn);    // the panel reads the tooth from its opener, and gives focus back to it
      }));
    }

    // Arrow keys move by what is on screen, row by row: the teeth shown (the baby teeth only while they are open), in
    // lines as they are laid out (the baby arch beside the permanent one on a wide chart, under it on a narrow one).
    // Right and Left go along a line and on to the next; Down and Up go to the next line, to the tooth nearest across.
    // With the permanent arches alone this is the old step exactly: along the 32 in order, 18 ↕ 48, 21 ↕ 31.
    function lines() {
      const shown = teeth.filter((t) => !t.closest('[hidden]'))
        .map((t) => ({ t, r: t.getBoundingClientRect() }))
        .sort((x, y) => x.r.top - y.r.top || x.r.left - y.r.left);
      const out: { t: HTMLButtonElement; r: DOMRect }[][] = [];
      for (const s of shown) {
        const line = out[out.length - 1];
        if (line && Math.abs(line[0].r.top - s.r.top) < s.r.height / 2) line.push(s);
        else out.push([s]);
      }
      out.forEach((line) => line.sort((x, y) => x.r.left - y.r.left));
      return out;
    }
    function stepFrom(b: HTMLButtonElement, key: string): HTMLButtonElement | null {
      const across = key === 'ArrowRight' ? 1 : key === 'ArrowLeft' ? -1 : 0;
      const down = key === 'ArrowDown' ? 1 : key === 'ArrowUp' ? -1 : 0;
      if (!across && !down) return null;
      const ls = lines();
      const li = ls.findIndex((line) => line.some((s) => s.t === b));
      if (li < 0) return null;
      if (across) {
        const order = ls.flat();
        const i = order.findIndex((s) => s.t === b);
        return order[(i + across + order.length) % order.length].t;
      }
      const mid = (r: DOMRect) => r.left + r.width / 2;
      const x = mid(ls[li].find((s) => s.t === b)!.r);
      const to = ls[(li + down + ls.length) % ls.length];
      return to.reduce((best, s) => (Math.abs(mid(s.r) - x) < Math.abs(mid(best.r) - x) ? s : best)).t;
    }

    teeth.forEach((b) => {
      b.addEventListener('click', () => openPalette(b));
      b.addEventListener('keydown', (e) => {
        const next = stepFrom(b, e.key);
        if (!next) return;
        e.preventDefault();
        // Roving tabindex: 32 tab stops in a row is not navigation.
        b.tabIndex = -1;
        next.tabIndex = 0;
        next.focus();
      });
    });

    palette.querySelectorAll<HTMLButtonElement>('[data-surface-toggle]').forEach((t) => {
      t.addEventListener('click', () => {
        const s = t.dataset.surfaceToggle as Surface;
        picked.has(s) ? picked.delete(s) : picked.add(s);
        syncSurfaces();
      });
    });

    palette.querySelectorAll<HTMLButtonElement>('[data-condition]').forEach((c) => {
      c.addEventListener('click', () => {
        if (!active) return;
        const condition = c.dataset.condition as ToothCondition;
        const fdi = fdiOf(active);
        let change: queue.ToothBody;
        if (condition === 'sound') {
          marks.delete(active);
          change = { fdi, condition: null, surfaces: [] };
        } else if (c.dataset.scope === 'surface') {
          // Default to the biting surface rather than refusing the click --
          // it is the common case and the dentist can add more.
          const surfaces = picked.size ? [...picked] : (['occlusal'] as Surface[]);
          marks.set(active, { condition, surfaces });
          change = { fdi, condition, surfaces };
        } else {
          marks.set(active, { condition });
          change = { fdi, condition, surfaces: [] };
        }
        paint(active);
        render();
        palette.hidePopover();
        active.focus();
        commit(change, asked);
      });
    });

    root.querySelectorAll<HTMLInputElement>('[data-notation-input]').forEach((input) => {
      input.addEventListener('change', () => {
        if (!input.checked) return;
        root.dataset.notation = input.value;
        teeth.forEach((b) => {
          const label = b.parentElement?.querySelector<HTMLElement>('[data-label]');
          if (label) label.textContent = nameOf(b);
          b.setAttribute('aria-label', describe(b));
        });
        render();
        tell();
        lightMap();
      });
    });

    // The baby teeth (`primary`): one button shows and hides their arch. Hidden, they keep their findings (the chart
    // note still lists them) and take no tab stop: the roving one moves back to the first permanent tooth.
    const babyToggle = root.querySelector<HTMLButtonElement>('[data-odo-baby-toggle]');
    const babySet = root.querySelector<HTMLElement>('[data-odo-set="primary"]');
    babyToggle?.addEventListener('click', () => {
      if (!babySet) return;
      const open = babySet.hidden;
      babySet.hidden = !open;
      root.toggleAttribute('data-primary-open', open);
      babyToggle.setAttribute('aria-expanded', String(open));
      if (!open && babySet.querySelector('[data-tooth][tabindex="0"]')) {
        teeth.forEach((t) => { t.tabIndex = -1; });
        teeth[0].tabIndex = 0;
      }
    });

    // --- the pictures and the mouth map ----------------------------------------------------------------------------
    // A tooth's picture is part of its target: a click on it opens the tooth as a click on its box does (the button
    // stays the only control, and keeps the keyboard order). The map is a picture only: it lights the tooth pointed at
    // or focused, whichever the person did last (a click leaves the pointer resting on a tooth while the arrow keys move
    // on), and the open one, and its line names that tooth in the notation in use; the palette's own small map lights
    // the open tooth. The map mirrors each tooth's finding from the button's own attributes, as paint() sets them.
    const whereLine = root.querySelector<HTMLElement>('[data-odo-where-line]');
    const whereIdle = whereLine?.textContent ?? '';
    const shapes = new Map([...root.querySelectorAll<SVGElement>('[data-map-fdi]')].map((s) => [Number(s.dataset.mapFdi), s]));
    const minis = new Map([...palette.querySelectorAll<SVGElement>('[data-mini-fdi]')].map((s) => [Number(s.dataset.miniFdi), s]));
    let hot: number | null = null;
    let focused: number | null = null;
    let last: 'pointer' | 'focus' = 'focus';
    let openFdi: number | null = null;
    // Where the page hides the map's line (the record, when the map sits under the arches, too far below the upper teeth to
    // be seen with them), the map follows the open tooth only.
    const follows = () => !!whereLine && getComputedStyle(whereLine).display !== 'none';
    function lightMap() {
      const now = !follows() ? null : last === 'pointer' ? (hot ?? focused) : (focused ?? hot);
      shapes.forEach((s, fdi) => s.toggleAttribute('data-lit', fdi === now || fdi === openFdi));
      minis.forEach((s, fdi) => s.toggleAttribute('data-lit', fdi === openFdi));
      const fdi = now ?? openFdi;
      const b = fdi === null ? undefined : byFdi.get(fdi);
      if (whereLine) whereLine.textContent = b && fdi !== null ? `${nameOf(b)} · ${toothTitle(fdi)}` : whereIdle;
    }
    const toothAt = (target: EventTarget | null): HTMLButtonElement | null =>
      (target instanceof Element ? target : null)?.closest('[data-odo-col]')?.querySelector<HTMLButtonElement>('button[data-tooth]') ?? null;
    root.addEventListener('pointerover', (e) => {
      const b = toothAt(e.target);
      const fdi = b ? fdiOf(b) : null;
      if (fdi !== hot) { hot = fdi; if (fdi !== null) last = 'pointer'; lightMap(); }
    });
    root.addEventListener('pointerleave', () => { if (hot !== null) { hot = null; lightMap(); } });
    root.addEventListener('focusin', (e) => {
      const b = e.target instanceof HTMLButtonElement && e.target.matches('[data-tooth]') ? e.target : null;
      focused = b ? fdiOf(b) : null;
      if (b) last = 'focus';
      lightMap();
    });
    root.addEventListener('focusout', () => { if (focused !== null) { focused = null; lightMap(); } });
    palette.addEventListener('toggle', () => {
      if (!palette.matches(':popover-open') && openFdi !== null) { openFdi = null; lightMap(); }
    });
    root.addEventListener('click', (e) => {
      const el = e.target instanceof Element ? e.target : null;
      if (!el?.closest('[data-odo-pic]')) return;
      const b = toothAt(el);
      if (!b) return;
      b.focus({ preventScroll: true });
      b.click();
    });
    const mirror = (b: HTMLButtonElement) => {
      const s = shapes.get(fdiOf(b));
      if (!s) return;
      s.setAttribute('data-state', b.dataset.state ?? 'sound');
      s.setAttribute('data-surface-condition', b.dataset.surfaceCondition ?? '');
    };
    const mirrored = new MutationObserver((changes) => changes.forEach((c) => mirror(c.target as HTMLButtonElement)));
    teeth.forEach((b) => { mirror(b); mirrored.observe(b, { attributes: true, attributeFilter: ['data-state', 'data-surface-condition'] }); });

    root.querySelector<HTMLButtonElement>('[data-clear]')?.addEventListener('click', () => {
      if (locked) return refuseLocked();
      const answer = ask();
      marks.clear();
      teeth.forEach(paint);
      render();
      commit({ clear: true }, answer);
    });

    render();
  });
</script>

<style>
  /* A tooth whose latest change is kept on this device and not on the server
     yet: a folded corner, top right, and the same corner in the legend. A
     triangle, so it never reads as one more surface pip; ink, not red, because
     nothing is wrong — it just has not gone yet. Edged in the surface colour
     along its long side, so it stands out on every fill in both themes: ink
     is near the crown's amber in dark mode, and the edge is not. */
  .tooth[data-waiting]::after {
    content: '';
    position: absolute;
    top: -1px;
    right: -1px;
    width: 15px;
    height: 15px;
    background: linear-gradient(to bottom left, var(--c-ink) 0 37%, var(--c-surface) 37% 52%, transparent 52%);
    pointer-events: none;
  }
  .waiting-swatch { background: linear-gradient(to bottom left, var(--c-ink) 0 37%, var(--c-surface) 37% 52%, transparent 52%); }
  /* Planned and done work under a tooth's number (the record's `work`): a ring for open plan items, a dot for
     work done in the past year. Shape carries the difference, not colour; the row keeps its height when empty,
     so the arches stay aligned. Never .tooth::after, which means "waiting on this device". */
  .tooth-marks { display: flex; gap: 3px; justify-content: center; align-items: center; height: 10px; }
  .tooth-mark-plan { width: 8px; height: 8px; border-radius: 999px; border: 2px solid var(--c-ink-2); }
  .tooth-mark-done { width: 8px; height: 8px; border-radius: 999px; background: var(--c-ink-2); }
</style>

<style is:global>
  /* The chart's pictures (src/lib/tooth-drawing.ts draws them; the record sizes them for its layouts and its paper in
     patients.css). Global, because the page's own rules reach in, and every rule is under the chart's own hooks.
     Colours are tokens and the finding hues the .tooth rules in global.css use, so the drawings follow the theme and
     whatever paper the sheet is. The outline is the muted slate: at least 3:1 on the card in both themes (measured). */
  [data-odontogram] { --odo-line: var(--c-muted); }
  .odo-defs { position: absolute; width: 0; height: 0; overflow: hidden; }

  /* A tooth's side view, on the outside of the arch: as wide as its box, as tall as the drawing's box (2:3). It adds
     nothing to the column's width (contain), and a click on it opens the tooth (the chart's script). */
  .odo-pic { display: block; align-self: stretch; contain: inline-size; cursor: pointer; }
  .odo-pic > svg { display: block; width: 100%; height: auto; overflow: visible; }
  .odo-pic use {
    fill: var(--c-tooth-sound); stroke: var(--odo-line); stroke-width: 1.25px; stroke-linejoin: round; stroke-linecap: round;
    transition: fill 120ms ease, stroke 120ms ease;
  }
  .odo-pic .odo-canal { display: none; fill: none; stroke: #7c53e0; stroke-width: 1.75px; }
  .odo-pic .odo-post { display: none; fill: #5b666f; }
  .odo-pic .odo-x { display: none; fill: none; stroke: var(--c-caries); stroke-width: 2px; stroke-linecap: round; vector-effect: non-scaling-stroke; }
  .odo-hatch-ground { fill: var(--c-tooth-sound); }
  .odo-hatch-line { fill: var(--c-caries); }
  /* The paper's code (global.css, .tooth::before, 5–17 px off the box) stands between the picture and the box. */
  [data-codes] .odo-col:has(> .tooth:not(.tooth--lower)) > .odo-pic { margin-bottom: 12px; }
  [data-codes] .odo-col:has(> .tooth--lower) > .odo-pic { margin-top: 12px; }
  /* Pointing at the picture is pointing at the tooth: both darken together. */
  .odo-col:has(> .tooth:hover) > .odo-pic, .odo-pic:hover { --odo-line: var(--c-ink); }
  .odo-col:has(> .odo-pic:hover) > .tooth[data-state="sound"] { border-color: var(--c-ink); }

  /* What the tooth shows, read from its box's own attributes (paint() sets them). A whole-tooth finding fills the crown
     in the box's colour; a surface finding leaves the picture as it is (the box's pips say where). */
  .odo-col:has(> .tooth:is([data-state="crown"], [data-state="bridge"], [data-state="abutment"])) .odo-crown { fill: var(--c-crown); }
  .odo-col:has(> .tooth[data-state="veneer"]) .odo-crown { fill: #b333c9; }
  .odo-col:has(> .tooth[data-state="denture"]) .odo-crown { fill: #c74b77; }
  /* A tooth that replaces one (a pontic, a denture's tooth) has no root; a pontic is the crown's pale tint, dashed. */
  .odo-col:has(> .tooth:is([data-state="pontic"], [data-state="denture"])) :is(.odo-root, .odo-back) { display: none; }
  .odo-col:has(> .tooth[data-state="pontic"]) .odo-crown { fill: color-mix(in srgb, var(--c-crown) 28%, var(--c-tooth-sound)); stroke: var(--c-crown); stroke-dasharray: 2.5 2; }
  /* A root canal: a line down each root. An implant: a threaded post where the roots were. */
  .odo-col:has(> .tooth[data-state="root_canal"]) .odo-canal { display: inline; }
  .odo-col:has(> .tooth[data-state="implant"]) :is(.odo-root, .odo-back) { display: none; }
  .odo-col:has(> .tooth[data-state="implant"]) .odo-post { display: inline; }
  /* To be taken out: crossed in the caries red. A root fragment: only the roots, hatched in it. */
  .odo-col:has(> .tooth[data-state="extraction"]) .odo-x { display: inline; }
  .odo-col:has(> .tooth[data-state="root_fragment"]) .odo-crown { display: none; }
  .odo-col:has(> .tooth[data-state="root_fragment"]) :is(.odo-root, .odo-back) { fill: var(--odo-hatch); stroke: var(--c-caries); }
  /* Missing: the outline only, dashed. Not through yet (unerupted), or stuck (impacted, leaning toward the midline):
     dashed too. */
  .odo-col:has(> .tooth:is([data-state="missing"], [data-state="unerupted"], [data-state="impacted"])) .odo-pic use { stroke-dasharray: 2.5 2; }
  .odo-col:has(> .tooth[data-state="missing"]) .odo-pic use { fill: none; }
  /* Turned inside its own box (a little smaller, so it stays inside it): nothing spills past the column. */
  .odo-col:has(> .tooth[data-state="impacted"]) .odo-tilt { transform-box: view-box; transform-origin: 50% 50%; scale: 0.85; }
  .odo-col:has(> .tooth[data-state="impacted"]) .odo-tilt[data-tilt="cw"] { rotate: 12deg; }
  .odo-col:has(> .tooth[data-state="impacted"]) .odo-tilt[data-tilt="ccw"] { rotate: -12deg; }

  /* Where it is: the mouth from above, at the top of the chart note (the record lays it beside the note where the note
     runs the chart's whole width: patients.css), and small in the palette's head. */
  .odo-where { display: grid; gap: 0.5rem; margin-bottom: 1.25rem; }
  .odo-map { position: relative; width: 100%; max-width: 15rem; justify-self: center; }
  .odo-map > svg { display: block; width: 100%; height: auto; }
  .odo-map rect {
    fill: var(--c-tooth-sound); stroke: var(--odo-line); stroke-width: 1px; vector-effect: non-scaling-stroke;
    transition: fill 120ms ease, stroke 120ms ease;
  }
  [data-odontogram]:not([data-primary-open]) [data-map-set="primary"] { display: none; }
  /* Findings, faintly: the whole mouth at a glance. */
  .odo-map rect:is([data-state="crown"], [data-state="bridge"], [data-state="abutment"]) { fill: color-mix(in srgb, var(--c-crown) 45%, var(--c-tooth-sound)); }
  .odo-map rect:is([data-state="extraction"], [data-state="root_fragment"], [data-surface-condition="caries"]) { fill: color-mix(in srgb, var(--c-caries) 45%, var(--c-tooth-sound)); }
  .odo-map rect[data-surface-condition="filled"] { fill: color-mix(in srgb, var(--c-accent) 45%, var(--c-tooth-sound)); }
  .odo-map rect[data-surface-condition="sealant"] { fill: color-mix(in srgb, #0b7fb5 45%, var(--c-tooth-sound)); }
  .odo-map rect[data-surface-condition="amalgam"] { fill: color-mix(in srgb, #7b8591 45%, var(--c-tooth-sound)); }
  .odo-map rect[data-surface-condition="inlay"] { fill: color-mix(in srgb, #a87a12 45%, var(--c-tooth-sound)); }
  .odo-map rect[data-state="root_canal"] { fill: color-mix(in srgb, #7c53e0 45%, var(--c-tooth-sound)); }
  .odo-map rect[data-state="implant"] { fill: color-mix(in srgb, #5b666f 45%, var(--c-tooth-sound)); }
  .odo-map rect[data-state="veneer"] { fill: color-mix(in srgb, #b333c9 45%, var(--c-tooth-sound)); }
  .odo-map rect[data-state="denture"] { fill: color-mix(in srgb, #c74b77 45%, var(--c-tooth-sound)); }
  .odo-map rect[data-state="pontic"] { fill: color-mix(in srgb, var(--c-crown) 28%, var(--c-tooth-sound)); stroke-dasharray: 3 2; }
  .odo-map rect:is([data-state="missing"], [data-state="unerupted"], [data-state="impacted"]) { stroke-dasharray: 3 2; }
  .odo-map rect[data-state="missing"] { fill: none; }
  /* The tooth pointed at, focused or open: teal, outlined darker. Its name is in the line under the map, or the
     palette's title. */
  .odo-map rect[data-lit] { fill: var(--ws-teal, var(--c-accent)); stroke: var(--ws-teal-fill, var(--c-ink)); stroke-width: 2px; }
  /* The palette's head: the title beside a small map. The palette has the theme's own colours (a pop-up opened from the
     paper takes the dark ones back in dark mode, global.css), so its outline is worked out there. */
  [data-palette] { --odo-line: var(--c-muted); }
  .odo-pal-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 0.75rem; }
  .odo-pal-head > [data-palette-title] { min-width: 0; }
  .odo-map-mini { flex: none; width: 5.5rem; max-width: none; justify-self: auto; }
  /* "Right" and "Left" (the patient's) in the hollow between the arches, clear of the molars and the baby teeth. */
  .odo-map-side { position: absolute; transform: translate(-50%, -50%); font-size: 12px; line-height: 1; color: var(--c-ink-2); pointer-events: none; }
  .odo-map-side[data-side="right"] { left: 22%; }
  .odo-map-side[data-side="left"] { left: 78%; }
  .odo-where-line { margin: 0; min-height: 1.45em; font-size: 13.5px; line-height: 1.45; color: var(--c-ink-2); text-align: center; font-variant-numeric: tabular-nums; }
  @media print { [data-odontogram] .odo-where { display: none; } }
</style>
