---
// The staff entrance: sign-in, forgot, and I-have-a-code share it.
//
// The ground is the clinic from the home page's film. On sign-in the camera
// walks from the front door to the reception desk while the person types,
// then holds at the desk — you are signing in at the front desk. The other
// two pages open already at the desk. Motion is always on, as everywhere on
// this site (CLAUDE.md, "The tour").
//
// The form sits on a compact pane of smoked glass on the right, so the clinic
// stays the background, not a picture behind paper. Nothing runs along the
// foot: the top bar names the page, and the pane says the rest.
import Base from '../layouts/Base.astro';
import { SIGNIN_WALK } from '../data/film';

interface Props {
  title: string;
  description: string;
  /** The page's name in the top bar: "Sign in", "Forgot password", … */
  page: string;
  /** Walk from the door to the desk (sign-in). Otherwise open at the desk. */
  walk?: boolean;
}

const { title, description, page, walk = false } = Astro.props;

---

<Base title={title} description={description}>
  <div class="entrance" data-entrance data-walk={walk ? '' : undefined} data-walk-from={SIGNIN_WALK.from} data-walk-to={SIGNIN_WALK.to} data-walk-rate={SIGNIN_WALK.rate}>
    <!-- The clinic. Decorative: everything it says is said in words on the pane. -->
    <div class="entrance-film" aria-hidden="true">
      <img
        class="entrance-still"
        src={walk ? '/img/signin-door-1440.webp' : '/img/signin-desk-1440.webp'}
        srcset={walk ? undefined : '/img/signin-desk-960.webp 960w, /img/signin-desk-1440.webp 1440w'}
        sizes="100vw"
        alt=""
        width="1440"
        height="810"
        fetchpriority="high"
      />
      {walk && <video class="entrance-video" data-walk-video muted playsinline preload="auto" disablepictureinpicture></video>}
    </div>

    <header class="entrance-top">
      <a href="/" class="font-display text-[17px] font-bold tracking-[-0.05em] text-[#f2f2ef]">Flossify</a>
      <span class="meta">Staff entrance <span class="meta-ink">/ {page}</span></span>
      <a href="/find/" class="meta ml-auto hover:text-ink">Patients: find a clinic &rarr;</a>
    </header>

    <main id="main" class="entrance-main">
      <div class="entrance-pane">
        <slot />
      </div>
    </main>

  </div>
</Base>

<style>
  @layer components {
    /* One screen: the clinic behind everything, a glass bar at the top and
       the glass pane. On every width. */
    .entrance {
      position: relative;
      min-height: 100vh;
      min-height: 100dvh;
      display: grid;
      grid-template-rows: auto 1fr;
      background: #e6e2da; /* the film's own mean tone, so nothing flashes before it paints */
    }
    .entrance-film { position: fixed; inset: 0; z-index: 0; overflow: hidden; background: #e6e2da; }
    .entrance-still, .entrance-video {
      position: absolute; inset: 0; width: 100%; height: 100%;
      object-fit: cover;
      /* The desk sits in the left third of the frame; keep it in view at every width. */
      object-position: 30% 50%;
    }
    .entrance-video { opacity: 0; transition: opacity 500ms ease; }
    .entrance-video[data-on] { opacity: 1; }

    /* Smoked glass: the same material as the home page's opening. */
    .entrance-top, .entrance-pane {
      background: rgb(7 16 15 / 0.62);
      -webkit-backdrop-filter: blur(14px) saturate(1.15); backdrop-filter: blur(14px) saturate(1.15);
      color: #f2f2ef;
    }
    .entrance-top {
      position: relative; z-index: 2;
      display: flex; align-items: baseline; gap: 1rem;
      padding: 1rem 1.25rem;
      border-bottom: 1px solid rgb(242 242 239 / 0.18);
      background: rgb(7 16 15 / 0.5);
    }
    .entrance-top .meta { color: rgb(242 242 239 / 0.7); }
    .entrance-top .meta-ink { color: #f2f2ef; }
    .entrance-top a:hover { color: #f2f2ef; }

    .entrance-main {
      position: relative; z-index: 1;
      display: grid; align-items: center; justify-items: end;
      padding: clamp(1rem, 4vh, 2.5rem) clamp(1rem, 5vw, 4.5rem);
    }

    /* Compact: the form and nothing else, so the clinic fills the screen. */
    .entrance-pane {
      width: min(100%, 25rem);
      padding: clamp(1.25rem, 2.2vw, 1.85rem);
      border: 1px solid rgb(242 242 239 / 0.2);
    }


    @media (max-width: 767px) {
      /* On a phone the clinic is still the background: the desk shows above the
         pane, and the pane scrolls over the clinic. */
      .entrance-top a.ml-auto { display: none; }
      .entrance-main { align-items: start; justify-items: stretch; padding: 30vh 1rem 1.5rem; }
      .entrance-pane { width: 100%; padding: 1.25rem 1rem 1.5rem; }
    }
  }
</style>

<script>
  /* --- the walk: the front door to the reception desk, then hold ----------
     Same film as the home page, so a staff member who has seen the site has
     it cached. The still underneath is the film's own frame at the door, so
     the page is never empty while the video arrives. */
  const root = document.querySelector<HTMLElement>('[data-entrance]');
  const vid = document.querySelector<HTMLVideoElement>('[data-walk-video]');
  // From src/data/film.ts, through the markup: the film's times live in one place.
  const FROM = Number(root?.dataset.walkFrom ?? 2), TO = Number(root?.dataset.walkTo ?? 9), RATE = Number(root?.dataset.walkRate ?? 0.85);
  if (root?.hasAttribute('data-walk') && vid) {
    vid.src = window.matchMedia('(max-width: 900px)').matches ? '/video/tour-960.mp4' : '/video/tour-1440.mp4';
    vid.addEventListener('loadedmetadata', () => { vid.currentTime = FROM; }, { once: true });
    vid.addEventListener('seeked', () => {
      vid.setAttribute('data-on', '');
      vid.playbackRate = RATE;
      vid.play().catch(() => { /* the still stays; nothing is lost */ });
    }, { once: true });
    const hold = () => {
      if (vid.currentTime < TO) return;
      vid.pause();
      vid.currentTime = TO;
      vid.removeEventListener('timeupdate', hold);
    };
    vid.addEventListener('timeupdate', hold);
  }

  /* --- the connection: sign-in needs a signal, and brownouts are real ---- */
  const paintNet = () => document.dispatchEvent(new CustomEvent('entrance:net', { detail: { offline: !navigator.onLine } }));
  addEventListener('online', paintNet);
  addEventListener('offline', paintNet);
</script>
