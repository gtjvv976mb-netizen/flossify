---
// The staff entrance: sign-in, forgot, and I-have-a-code share it.
//
// The ground is the clinic from the home page's film. On sign-in the camera
// walks from the front door to the reception desk while the person types,
// then holds at the desk — you are signing in at the front desk. The other
// two pages open already at the desk. Motion is always on, as everywhere on
// this site (CLAUDE.md, "The tour").
//
// The form sits on one bright white card with soft corners — the workspace's
// soft template (docs/workspace-redesign.md), so the door into the workspace
// looks like the workspace. The clinic stays the background around it. The
// only other thing on the film is a quiet pill for patients who came to the
// wrong door. Nothing runs along the foot.
//
// The styles are the staff-entrance section of src/styles/global.css
// (.entrance-* for this frame, .entry-* for what the pages put on the card).
import Base from '../layouts/Base.astro';
import Icon from './ws/Icon.astro';
import ClinicBadge from '../pages/find/_ui/ClinicBadge.astro';
import { SIGNIN_WALK } from '../data/film';
import { isUploadKey, photoUrl } from '../lib/uploads';
import ThemeSwitch from './ThemeSwitch.astro';

interface Props {
  title: string;
  description: string;
  /** Walk from the door to the desk (sign-in). Otherwise open at the desk. */
  walk?: boolean;
  /**
   * A clinic's own door (/<clinic>/sign-in/): that clinic's name at the head of the card, and behind
   * it that clinic's own cover photo (its first upload) — or, with none, a soft blur of the site's
   * colours, never the film, which behind a real clinic's door would read as its interior (the rule
   * for a clinic's page, CLAUDE.md "Frosted glass"). The card is the same near-opaque card either way.
   */
  door?: { id: string; name: string; slug: string; cover: string | null; listed: boolean };
}

const { title, description, walk = false, door } = Astro.props;
const cover = door?.cover && isUploadKey(door.cover) ? door.cover : null;
---

<Base title={title} description={description}>
  <div class="entrance" data-entrance data-walk={walk && !door ? '' : undefined} data-walk-from={SIGNIN_WALK.from} data-walk-to={SIGNIN_WALK.to} data-walk-rate={SIGNIN_WALK.rate}>
    <!-- The clinic. Decorative: everything it says is said in words on the card. -->
    {door ? (
      <div class:list={['entrance-film', !cover && 'entrance-soft']} aria-hidden="true">
        {cover && (
          <picture>
            <source media="(max-width: 639px)" srcset={photoUrl(cover, door.id, 640)} />
            <img class="entrance-still entrance-own" src={photoUrl(cover, door.id, 1600)} alt="" width="1600" height="1200" fetchpriority="high" />
          </picture>
        )}
      </div>
    ) : (
      <div class="entrance-film" aria-hidden="true">
        <img
          class="entrance-still"
          src={walk ? '/img/signin-door-1440.webp' : '/img/signin-desk-1440.webp'}
          srcset={walk ? undefined : '/img/signin-desk-960.webp 960w, /img/signin-desk-1440.webp 1440w'}
          sizes="100vw"
          alt=""
          width="1440"
          height="810"
          fetchpriority="high"
        />
        {walk && <video class="entrance-video" data-walk-video muted playsinline preload="auto" disablepictureinpicture></video>}
      </div>
    )}

    <header class="entrance-top">
      <ThemeSwitch variant="float" />
      {door?.listed ? (
        <a href={`/find/${door.slug}/`} class="entrance-out">
          <span>Patients: book a visit</span>
          <Icon name="arrow-right" size={16} />
        </a>
      ) : (
        <a href="/find/" class="entrance-out">
          <span>Patients: find a clinic</span>
          <Icon name="arrow-right" size={16} />
        </a>
      )}
    </header>

    <main id="main" class="entrance-main">
      <div class="entrance-card">
        <div class="entrance-head">
          {door ? (
            <span class="entrance-mark entrance-clinic"><ClinicBadge name={door.name} /><span>{door.name}</span></span>
          ) : (
            <a href="/" class="entrance-mark" aria-label="Flossify home">
              <svg class="entrance-mark-sq" viewBox="0 0 32 32" aria-hidden="true" focusable="false"><rect width="32" height="32" rx="9" /><path d="M9 8h14v11c0 3-1.6 5-3.2 5S17 22.4 17 20.4v-2.2h-2v2.2c0 2-1.2 3.6-2.8 3.6S9 22 9 19z" /></svg>
              <span>Flossify</span>
            </a>
          )}
          {/* The head's right: "Clinic sign-in", or a page's own way back (slot="head"). */}
          <slot name="head"><span class="entrance-where">Clinic sign-in</span></slot>
        </div>
        <slot />
      </div>
    </main>
  </div>
</Base>

<script>
  /* --- the walk: the front door to the reception desk, then hold ----------
     Same film as the home page, so a staff member who has seen the site has
     it cached. The still underneath is the film's own frame at the door, so
     the page is never empty while the video arrives. */
  const root = document.querySelector<HTMLElement>('[data-entrance]');
  const vid = document.querySelector<HTMLVideoElement>('[data-walk-video]');
  // From src/data/film.ts, through the markup: the film's times live in one place.
  const FROM = Number(root?.dataset.walkFrom ?? 2), TO = Number(root?.dataset.walkTo ?? 9), RATE = Number(root?.dataset.walkRate ?? 0.85);
  if (root?.hasAttribute('data-walk') && vid) {
    vid.src = window.matchMedia('(max-width: 900px)').matches ? '/video/tour-960.mp4' : '/video/tour-1440.mp4';
    vid.addEventListener('loadedmetadata', () => { vid.currentTime = FROM; }, { once: true });
    vid.addEventListener('seeked', () => {
      vid.setAttribute('data-on', '');
      vid.playbackRate = RATE;
      vid.play().catch(() => { /* the still stays; nothing is lost */ });
    }, { once: true });
    const hold = () => {
      if (vid.currentTime < TO) return;
      vid.pause();
      vid.currentTime = TO;
      vid.removeEventListener('timeupdate', hold);
    };
    vid.addEventListener('timeupdate', hold);
  }

  /* --- the connection: sign-in needs a signal, and brownouts are real ---- */
  const paintNet = () => document.dispatchEvent(new CustomEvent('entrance:net', { detail: { offline: !navigator.onLine } }));
  addEventListener('online', paintNet);
  addEventListener('offline', paintNet);
</script>
