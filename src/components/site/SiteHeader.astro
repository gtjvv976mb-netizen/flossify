---
// The public top bar, in the soft template (docs/workspace-redesign.md, "The whole site, soft" and
// "Site API"). Public pages keep a bar at the top, not a sidebar (the film home page needs the full
// width): the Flossify mark, a few plain links as soft pills (the page you are on tinted teal),
// "Clinic sign-in" and one teal Open your clinic. Below 960px the links move into a drawer that the
// menu button slides in from the left, like the workspace's sidebar on a phone: a modal <dialog>
// (the rest of the page is inert), Tab stays inside, Escape, the scrim and its × close it, and focus
// goes back to the menu button. Sticky at the top; nothing is fixed to the bottom of the screen.
//
//   <SiteHeader current="websites" />                         the site's links; Open your clinic teal
//   <SiteHeader links="patients" current="find" cta="quiet" /> Find a clinic · PhilHealth & HMO · My visits
//   <SiteHeader wide cta="quiet">                             1480px, the home page's width
//     <span slot="aside">Pricing · Reception</span>           beside the links (shown from 1180px)
//     <div class="absolute inset-x-0 bottom-0 h-px">…</div>  anything else inside the <header>
//   </SiteHeader>
//
// The styles are "The public top bar" in src/styles/global.css. The icons are the workspace's
// (ws/Icon.astro): one icon per idea, the same everywhere.
import Icon from '../ws/Icon.astro';
import type { IconName } from '../ws/icons';

export type SiteLink = { id: string; label: string; href: string; icon: IconName };

// For everyone: the patients' door, the price, the website service. Pricing is a section of the home page.
const SITE: SiteLink[] = [
  { id: 'find', label: 'Find a clinic', href: '/find/', icon: 'search' },
  { id: 'pricing', label: 'Pricing', href: '/#pricing', icon: 'money' },
  { id: 'websites', label: 'Clinic websites', href: '/websites/', icon: 'clinic' },
];
// For patients (PatientHeader): finding a dentist, what their cards cover, their own visits.
const PATIENTS: SiteLink[] = [
  { id: 'find', label: 'Find a clinic', href: '/find/', icon: 'search' },
  { id: 'coverage', label: 'PhilHealth & HMO', href: '/coverage/', icon: 'file' },
  { id: 'me', label: 'My visits', href: '/me/', icon: 'calendar' },
];

interface Props {
  /** The page's own link (an id from the links, or 'signin' / 'start'): marked aria-current and tinted teal. */
  current?: string;
  /** The links in the middle: 'site' (default), 'patients', or your own list. */
  links?: 'site' | 'patients' | SiteLink[];
  /**
   * Open your clinic: 'primary' (default) — the one teal button; 'quiet' — white with a hairline, for
   * pages whose own main action is the teal one (a patient booking). A quiet one waits in the drawer on a phone.
   */
  cta?: 'primary' | 'quiet';
  /** 1480px wide (the home page) instead of 1280px, to line up with the page under it. */
  wide?: boolean;
  /** Sticky at the top of the screen (default). */
  sticky?: boolean;
  class?: string;
}

const { current, links = 'site', cta = 'primary', wide = false, sticky = true, class: extra } = Astro.props;
const items = links === 'site' ? SITE : links === 'patients' ? PATIENTS : links;
const navLabel = links === 'patients' ? 'Patients' : 'Site';
const here = (id: string) => (id === current ? 'page' : undefined);
const ctaClass = cta === 'quiet' ? 'btn-quiet' : 'btn-primary';
const hasAside = Astro.slots.has('aside');
---

<header class:list={['site-top', sticky && 'site-sticky', extra]} data-wide={wide ? '' : undefined} data-site-top>
  <div class="site-bar">
    <button type="button" class="site-menu-btn" aria-label="Menu" aria-haspopup="dialog" aria-controls="site-menu" aria-expanded="false" data-site-menu-open>
      <Icon name="menu" size={22} />
    </button>
    <a href="/" class="ws-mark site-mark" aria-label="Flossify, home">
      <svg class="ws-mark-sq" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="9" /><path d="M9 8h14v11c0 3-1.6 5-3.2 5S17 22.4 17 20.4v-2.2h-2v2.2c0 2-1.2 3.6-2.8 3.6S9 22 9 19z" /></svg>
      <span class="ws-mark-word">Flossify</span>
    </a>
    <nav class="site-nav" aria-label={navLabel}>
      {items.map((l) => <a href={l.href} class="site-link" aria-current={here(l.id)}>{l.label}</a>)}
    </nav>
    {hasAside && <div class="site-aside"><slot name="aside" /></div>}
    <div class="site-actions">
      <a href="/auth/login/" class="site-link site-signin" aria-current={here('signin')}><Icon name="user" />Clinic sign-in</a>
      <a href="/start/" class:list={['btn', ctaClass, 'site-cta']} aria-current={here('start')}><span>Open your clinic</span><Icon name="arrow-right" /></a>
    </div>
  </div>
  <slot />
</header>

<dialog id="site-menu" class="site-drawer" aria-label="Menu" data-site-menu>
  <div class="site-drawer-inner">
    <div class="site-drawer-head">
      <a href="/" class="ws-mark" aria-label="Flossify, home">
        <svg class="ws-mark-sq" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="9" /><path d="M9 8h14v11c0 3-1.6 5-3.2 5S17 22.4 17 20.4v-2.2h-2v2.2c0 2-1.2 3.6-2.8 3.6S9 22 9 19z" /></svg>
        <span class="ws-mark-word">Flossify</span>
      </a>
      <button type="button" class="site-menu-btn" aria-label="Close the menu" data-site-menu-close>
        <Icon name="close" size={20} />
      </button>
    </div>
    <nav class="site-drawer-nav" aria-label={navLabel}>
      {items.map((l) => (
        <a href={l.href} class="site-drawer-link" aria-current={here(l.id)}><Icon name={l.icon} size={20} /><span>{l.label}</span></a>
      ))}
    </nav>
    <div class="site-drawer-foot">
      <a href="/auth/login/" class="site-drawer-link" aria-current={here('signin')}><Icon name="user" size={20} /><span>Clinic sign-in</span></a>
      <a href="/start/" class:list={['btn', ctaClass, 'site-drawer-cta']} aria-current={here('start')}><span>Open your clinic</span><Icon name="arrow-right" /></a>
    </div>
  </div>
</dialog>

<script>
  // The drawer: opened by the menu button below 960px (the bar carries the links from there up).
  const drawer = document.querySelector<HTMLDialogElement>('[data-site-menu]');
  const opener = document.querySelector<HTMLButtonElement>('[data-site-menu-open]');
  const wide = matchMedia('(min-width: 960px)');

  if (drawer && opener) {
    let closing = false;
    let turn = 0; // which opening a slide-out belongs to, so a late timer never closes the next one
    const stops = () =>
      Array.from(drawer.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')).filter((x) => x.getClientRects().length > 0);

    const open = () => {
      if (drawer.open || wide.matches) return;
      turn++;
      closing = false;
      delete drawer.dataset.closing;
      drawer.showModal();
      opener.setAttribute('aria-expanded', 'true');
      const first = drawer.querySelector<HTMLElement>('.site-drawer-nav [aria-current="page"]') ?? drawer.querySelector<HTMLElement>('.site-drawer-link');
      first?.focus();
    };
    // Slides out, then closes; focus goes back to the menu button. `now` skips the slide (a jump to
    // a part of this same page, or the screen growing past the phone layout).
    const close = (focusBack = true, now = false) => {
      if (!drawer.open || closing) return;
      opener.setAttribute('aria-expanded', 'false');
      const mine = turn;
      const done = () => {
        if (!drawer.open || mine !== turn) return;
        drawer.close();
        delete drawer.dataset.closing;
        closing = false;
        if (focusBack) opener.focus();
      };
      if (now) return done();
      closing = true;
      drawer.dataset.closing = '';
      drawer.addEventListener('animationend', done, { once: true });
      setTimeout(done, 260); // in case the animation never reports its end
    };

    opener.addEventListener('click', () => (drawer.open ? close() : open()));
    drawer.querySelector('[data-site-menu-close]')?.addEventListener('click', () => close());
    // Escape: the dialog's own cancel, turned into the slide out.
    drawer.addEventListener('cancel', (e) => { e.preventDefault(); close(); });
    // A browser that closes it anyway (a second Escape) still leaves the button right.
    drawer.addEventListener('close', () => { opener.setAttribute('aria-expanded', 'false'); closing = false; delete drawer.dataset.closing; });
    drawer.addEventListener('click', (e) => {
      // The scrim: a click on the dialog itself, outside its box.
      if (e.target === drawer) {
        const r = drawer.getBoundingClientRect();
        if (e.clientX > r.right || e.clientX < r.left || e.clientY < r.top || e.clientY > r.bottom) close();
        return;
      }
      // A link to a part of this same page (/#pricing on the home page): close at once, so the page
      // can scroll there.
      const a = (e.target as Element).closest<HTMLAnchorElement>('a[href]');
      if (a && a.hash && a.pathname === location.pathname) close(false, true);
    });
    // Tab stays inside while it is open.
    drawer.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab') return;
      const s = stops();
      if (!s.length) return;
      const first = s[0], last = s[s.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    });
    wide.addEventListener('change', () => { if (wide.matches) close(false, true); });
    // Coming back to this page from the history (bfcache) never finds the drawer left open.
    addEventListener('pageshow', (e) => { if (e.persisted) close(false, true); });
  }
</script>
