---
// The group's Flossify plan in one small callout, at the foot of the
// workspace's left sidebar (under the person): trial days left, an invoice
// due, an invoice overdue — and the way to the plan. Blue for information,
// soft red when an invoice is overdue (with the word saying so, never colour
// alone). It is not a banner across every page. On the tablet's icon rail it
// folds to an icon with the word "Plan" (the sentence stays for screen
// readers), with a small red dot when something is overdue.
//
// The layout reads the line once (planLine() in src/components/ws/plan.ts,
// which also starts the trial the first time a group's workspace is opened)
// and passes it in; nothing is drawn when there is none, which is most days.
import Icon from './ws/Icon.astro';
import type { Notice } from './ws/plan';

interface Props { line: Notice | null; slug: string }
const { line, slug } = Astro.props;
---

{line && (
  <div id="ws-plan-line" class="ws-plan" data-plan-alert={line.alert ? '' : undefined}>
    <Icon name={line.alert ? 'alert' : 'clock'} class="ws-plan-icon" />
    <p class="ws-plan-text">{line.text}</p>
    <a href={`/c/${slug}/settings/billing/`} class="ws-plan-go">
      <Icon name="file" class="ws-plan-go-icon" />
      <span class="ws-plan-go-long">Your Flossify plan</span><span class="ws-plan-go-short" aria-hidden="true">Plan</span>
      <Icon name="arrow-right" size={16} class="ws-plan-go-arrow" />
    </a>
  </div>
)}
