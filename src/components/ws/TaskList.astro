---
// A list of tasks (src/lib/tasks.ts): a round tick to finish one (or bring it back), the title, when it is
// due, the notes, and who gave it or who it is for. The Dashboard shows the first few of yours; the Tasks
// page all of them and the ones you gave. Every tick is a small form that posts to the Tasks page and comes
// back where it was (`back`), so it works with scripts off.
import Chip from './Chip.astro';
import Icon from './Icon.astro';
import Avatar from './Avatar.astro';
import Csrf from '../Csrf.astro';
import { dueWords, type Task } from '../../lib/tasks';

interface Props {
  tasks: Task[];
  me: string;
  /** Where the forms post: /c/<slug>/tasks/. */
  action: string;
  /** Where to come back to after a tick. */
  back: string;
  /** 'mine': who gave it; 'given': who it is for, and Take back. */
  kind: 'mine' | 'given';
  label: string;
  /** The Dashboard's: one line a task, no notes, so the calendar keeps the first screen. */
  compact?: boolean;
}
const { tasks, me, action, back, kind, label, compact = false } = Astro.props;
const dayFmt = new Intl.DateTimeFormat('en-US', { weekday: 'short', day: 'numeric', month: 'short', timeZone: 'Asia/Manila' });
---

<ul class:list={['task-list', compact && 'task-compact']} aria-label={label}>
  {tasks.map((t) => {
    const due = dueWords(t);
    const done = !!t.doneAt;
    return (
      <li class="task" data-done={done ? '' : undefined}>
        <form method="post" action={action} class="task-tick-f">
          <Csrf />
          <input type="hidden" name="do" value={done ? 'undo' : 'done'} />
          <input type="hidden" name="task" value={t.id} />
          <input type="hidden" name="back" value={back} />
          <button type="submit" class="task-tick" aria-pressed={done ? 'true' : 'false'} aria-label={done ? `Not done yet: ${t.title}` : `Done: ${t.title}`}>
            <Icon name="check" size={18} />
          </button>
        </form>
        <div class="task-body">
          <p class="task-title">{t.title}</p>
          {t.notes && !compact && <p class="task-notes">{t.notes}</p>}
          <p class="task-meta">
            {done
              ? <Chip tone="accent" icon="check" label={`Done ${dayFmt.format(t.doneAt!)}`} />
              : due && <Chip tone={due.tone} icon={due.tone === 'neutral' ? 'clock' : 'alert'} label={due.text} />}
            {kind === 'mine'
              ? <span>{t.createdBy === me || !t.creatorName ? 'Your own note' : `From ${t.creatorName}`}</span>
              : <span class="task-who"><Avatar name={t.assigneeName} size="sm" />For {t.assigneeName}</span>}
          </p>
        </div>
        {kind === 'given' && !done && (
          <form method="post" action={action} class="task-end">
            <Csrf />
            <input type="hidden" name="do" value="cancel" />
            <input type="hidden" name="task" value={t.id} />
            <input type="hidden" name="back" value={back} />
            <button type="submit" class="ws-btn ws-btn-quiet ws-btn-sm">Take back<span class="sr-only">: {t.title}</span></button>
          </form>
        )}
      </li>
    );
  })}
</ul>

<style>
  .task-list { display: grid; }
  .task {
    display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: start; gap: 0.25rem 0.875rem;
    padding: 0.75rem 1.5rem; border-bottom: 1px solid var(--ws-hair);
  }
  .task:last-child { border-bottom: 0; }
  @media (max-width: 767px) { .task { padding-inline: 1rem; grid-template-columns: auto minmax(0, 1fr); } .task-end { grid-column: 2; } }
  .task-tick-f { display: contents; }
  /* A round tick, 44px to press, a 26px ring to see: empty while open, teal and ticked when done. */
  .task-tick {
    display: grid; place-items: center; width: 44px; height: 44px; margin: -0.5rem -0.5rem 0 -0.5rem; border-radius: 999px; color: transparent; cursor: pointer;
    background: radial-gradient(circle, var(--c-surface) 0 12px, var(--ws-field-line) 12px 13.5px, transparent 13.5px);
    transition: background 160ms ease, color 160ms ease;
  }
  .task-tick:hover { color: var(--ws-teal-ink); background: radial-gradient(circle, var(--ws-teal-tint) 0 12px, var(--ws-teal) 12px 13.5px, transparent 13.5px); }
  .task-tick:focus-visible { outline: 2px solid var(--ws-teal); outline-offset: -4px; }
  .task[data-done] .task-tick { color: #fff; background: radial-gradient(circle, var(--ws-teal-fill) 0 13.5px, transparent 13.5px); }
  .task-body { min-width: 0; }
  .task-title { font-size: 15.5px; font-weight: 600; line-height: 1.4; color: var(--c-ink); overflow-wrap: anywhere; }
  .task[data-done] .task-title { color: var(--c-ink-2); text-decoration: line-through; text-decoration-thickness: 1px; }
  .task-notes { margin-top: 0.125rem; font-size: 14px; line-height: 1.5; color: var(--c-ink-2); white-space: pre-line; overflow-wrap: anywhere; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; overflow: hidden; }
  .task-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.375rem 0.75rem; margin-top: 0.375rem; font-size: 13.5px; color: var(--c-ink-2); }
  .task-who { display: inline-flex; align-items: center; gap: 0.375rem; }
  .task-end .ws-btn { min-height: 44px; }
  .task-compact .task { padding-block: 0.375rem; align-items: center; }
  .task-compact .task-tick { margin-block: 0; }
  .task-compact .task-body { display: flex; flex-wrap: wrap; align-items: center; gap: 0.25rem 0.75rem; }
  .task-compact .task-meta { margin-top: 0; }
</style>
