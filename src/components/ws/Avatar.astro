---
// A person's round avatar: their initials on a pale tint. The tint is picked
// from the name, so the same person always has the same colour and a list of
// people is easy to scan; it says nothing else (never a role, never a status).
// No photographs: initials only.
//
//   <Avatar name="Dr. Liwayway Domingo" />            32px, "LD"
//   <Avatar name={p.full_name} size="lg" />           48px
//
// Decorative next to the written name (aria-hidden); pass `label` when the
// avatar stands alone and must say who it is.
interface Props {
  name: string;
  size?: 'sm' | 'md' | 'lg';
  label?: string;
  class?: string;
}
const { name, size = 'md', label, class: extra } = Astro.props;
// "Dr. Liwayway Domingo" → LD: the first and last word, without the title.
const words = name.replace(/^(Dr|Dra|Doc)\.?\s+/i, '').trim().split(/\s+/).filter(Boolean);
const initials = ((words[0]?.[0] ?? '') + (words.length > 1 ? words[words.length - 1][0] : '')).toUpperCase() || '·';
const TINTS = ['teal', 'blue', 'green', 'amber', 'violet', 'rose'] as const;
let h = 0;
for (const ch of name) h = (h * 31 + ch.charCodeAt(0)) >>> 0;
const tint = TINTS[h % TINTS.length];
---

<span
  class:list={['ws-avatar', `ws-avatar-${size}`, extra]}
  data-tint={tint}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>{initials}</span>
