---
// The top bar for the patient side (find, a clinic's page and booking, a dentist, coverage, privacy,
// /me/): the site's soft bar (site/SiteHeader.astro) with the patients' links — Find a clinic ·
// PhilHealth & HMO · My visits — and the door to the clinic side (Staff sign-in, Open your clinic).
// Open your clinic is quiet here: the one teal button on a patient page is the page's own (Book,
// Continue). On a phone the links, sign-in and Open your clinic are in the menu.
import SiteHeader from './site/SiteHeader.astro';
import Icon from './ws/Icon.astro';

interface Props { current?: 'find' | 'coverage' | 'me' }
const { current } = Astro.props;

// The seeded directory is invented clinics, invented dentists and 555 numbers, so on the owner's own
// machine (SHOW_DEMO_LOGINS=1, read at request time; from .env under `astro dev` only, a half a build
// compiles away) every patient page says so, and nobody drives to Session Road expecting a chair. A
// live directory is real clinics taking real bookings: no line. A prerendered page never shows it,
// because a build reads .env into its environment and would bake it in.
const devData = (process.env.SHOW_DEMO_LOGINS === '1' || (import.meta.env.DEV && import.meta.env.SHOW_DEMO_LOGINS === '1')) && !Astro.isPrerendered;
---

<SiteHeader links="patients" current={current} cta="quiet" />

{devData && (
  <div class="mx-auto max-w-[1280px] px-5 pt-3 sm:px-8">
    <p role="note" class="ws-callout text-[14px]" data-tone="warn">
      <Icon name="info" />
      <span>Prototype. The clinics and dentists are invented and the phone numbers are 555 numbers; nothing here books a real visit.</span>
    </p>
  </div>
)}
