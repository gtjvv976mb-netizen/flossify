---
// The frame around every workspace page: who is signed in, which branch is
// open, and the way out. Pages behind it have already passed requireWorkspace,
// so a rendered page always has a staff member; the props say who.
import '../styles/global.css';

interface Props {
  clinic: { slug: string; name: string; area?: string | null };
  title: string;
  section: 'today' | 'patients' | 'billing' | 'claims';
  staff: { name: string; role: string };
  branches: { slug: string; name: string }[];
}

const { clinic, title, section, staff, branches } = Astro.props;

const nav = [
  { id: 'today', label: 'Today', href: `/c/${clinic.slug}/` },
  { id: 'patients', label: 'Patients', href: `/c/${clinic.slug}/patients/` },
  { id: 'billing', label: 'Billing', href: `/c/${clinic.slug}/#billing` },
  { id: 'claims', label: 'HMO claims', href: `/c/${clinic.slug}/#claims` },
];
const others = branches.filter((b) => b.slug !== clinic.slug);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title} — {clinic.name} — Flossify</title>
    <!-- A clinic workspace is private by definition; keep it out of indexes. -->
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/Archivo.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/IBMPlexMono-400.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      try {
        const saved = localStorage.getItem('theme');
        if (saved) document.documentElement.dataset.theme = saved;
      } catch (e) {
        /* storage blocked: fall back to the OS preference */
      }
    </script>
  </head>
  <body>
    <p role="note" class="border-b border-crown/40 bg-crown/10 px-5 py-2 text-center text-[13px] text-ink sm:px-8">
      Development database with invented patients. Do not enter real patient records.
    </p>

    <header class="sticky top-0 z-40 border-b border-line bg-bg/90 backdrop-blur">
      <div class="mx-auto flex max-w-[1280px] flex-wrap items-center justify-between gap-3 px-5 py-3 sm:px-8">
        <div class="flex items-center gap-3">
          <a href="/" class="font-display text-[17px] font-bold tracking-[-0.05em]" aria-label="Flossify, home">Flossify</a>
          <span class="h-5 w-px bg-line"></span>
          <div>
            <p class="font-display text-[17px] leading-tight font-bold">{clinic.name}</p>
            <p class="meta">{clinic.area}</p>
          </div>
        </div>

        <nav class="flex items-center gap-1" aria-label="Clinic sections">
          {nav.map((n) => (
            <a
              href={n.href}
              aria-current={n.id === section ? 'page' : undefined}
              class:list={[
                'px-3.5 py-2 text-[13.5px] font-medium',
                n.id === section ? 'bg-accent text-surface' : 'text-ink-2 hover:bg-bg-soft hover:text-accent',
              ]}
            >
              {n.label}
            </a>
          ))}
        </nav>

        <div class="flex items-center gap-3">
          {others.length > 0 && (
            <details class="relative">
              <summary class="meta cursor-pointer list-none hover:text-ink">Branch &darr;</summary>
              <ul class="absolute right-0 z-50 mt-2 min-w-[14rem] border border-line bg-surface p-1">
                {others.map((b) => <li><a href={`/c/${b.slug}/`} class="block px-3 py-2 text-[14px] hover:bg-bg-soft">{b.name}</a></li>)}
              </ul>
            </details>
          )}
          <span class="text-[13.5px] text-ink-2"><span class="font-medium text-ink">{staff.name}</span> · {staff.role}</span>
          <form method="post" action="/auth/logout"><button type="submit" class="meta hover:text-ink">Sign out</button></form>
        </div>
      </div>
    </header>

    <main class="mx-auto max-w-[1280px] px-5 py-8 sm:px-8">
      <slot />
    </main>
  </body>
</html>
