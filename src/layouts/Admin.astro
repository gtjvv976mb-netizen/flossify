---
// Flossify control: the frame around Flossify's own pages (/admin/). Pages
// behind it have already passed requireAdmin. It is the clinic workspace's
// soft shell (src/layouts/Clinic.astro; docs/workspace-redesign.md, "The soft
// template" and "Very simple, tabs on the left") on the other side of the
// counter: the same white sidebar, cards and components, standing outside the
// clinic — the home page film's first frame, the building from the street,
// under a light veil — because this is the view across every clinic, not
// inside one.
//
// The sidebar holds the five sections, one page each: Overview (/admin/),
// Clinics (/admin/clinics/), PRC checks (/admin/prc/), Billing
// (/admin/billing/) and System (/admin/system/, with the operations log). At
// the foot of its own column (never fixed to the screen): the operator,
// password help and Sign out. From 1024px it is a 244px column (220px to
// 1279px), 768–1023px an icon rail, and to 767px it slides in from the left
// behind the menu button, with the five sections also as a row of icons under
// the slim top bar. The shell's script (src/components/ws/shell.ts) runs the
// sidebar, menus, side panels and in-page tabs. The top of the content holds
// only the page's title: there is no patient search here, so the shell's own
// `/` and `N` stay out of the way (no [data-ws-top]); the Clinics page binds
// `/` to its own search.
import '../styles/global.css';
import Csrf from '../components/Csrf.astro';
import Menu from '../components/ws/Menu.astro';
import Icon from '../components/ws/Icon.astro';
import Avatar from '../components/ws/Avatar.astro';
import type { IconName } from '../components/ws/icons';

export type OpsSection = 'overview' | 'clinics' | 'prc' | 'billing' | 'system';

interface Props {
  /** The page's title: the <title> and the <h1> at the top of the content. */
  title: string;
  section: OpsSection;
  admin: { name: string; email?: string };
  /** 1600px instead of 1280px, for the wide tables. */
  wide?: boolean;
}

const { title, section, admin, wide = false } = Astro.props;

const SECTIONS: { id: OpsSection; label: string; short: string; href: string; icon: IconName }[] = [
  { id: 'overview', label: 'Overview', short: 'Overview', href: '/admin/', icon: 'dashboard' },
  { id: 'clinics', label: 'Clinics', short: 'Clinics', href: '/admin/clinics/', icon: 'clinic' },
  { id: 'prc', label: 'PRC checks', short: 'PRC', href: '/admin/prc/', icon: 'check' },
  { id: 'billing', label: 'Billing', short: 'Billing', href: '/admin/billing/', icon: 'wallet' },
  { id: 'system', label: 'System', short: 'System', href: '/admin/system/', icon: 'settings' },
];

// Seeded development data says so, on the owner's own machine only (the same switch as Clinic.astro).
const devData = process.env.SHOW_DEMO_LOGINS === '1' || (import.meta.env.DEV && import.meta.env.SHOW_DEMO_LOGINS === '1');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title} — Flossify control</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#f3f5f8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#15191e" media="(prefers-color-scheme: dark)" />
    <link rel="preload" as="image" href="/video/tour-poster.webp" />
    <script is:inline>
      try {
        const saved = localStorage.getItem('theme');
        if (saved) document.documentElement.dataset.theme = saved;
      } catch (e) {
        /* storage blocked: fall back to the OS preference */
      }
    </script>
    <style is:global>
      /* Moving between the sections is one place: the sidebar holds still, the page cross-fades and the
         teal pill slides to the new section (as in the clinic workspace). */
      @view-transition { navigation: auto; }
      @media (min-width: 768px) {
        .ops .ws-side { view-transition-name: ws-side; }
        .ops .ws-nav .ws-nav-item[aria-current="page"] { view-transition-name: ws-tab-on; }
      }
      @media (max-width: 767px) {
        .ops .ws-tabrow .ws-tabrow-item[aria-current="page"] { view-transition-name: ws-tab-on; }
      }
      ::view-transition-group(ws-tab-on) { animation-duration: 320ms; animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1); }
      ::view-transition-old(root), ::view-transition-new(root) { animation-duration: 220ms; }

      /* Flossify control's own few rules, in the components layer so a utility in the markup still wins.
         Everything else is the workspace's soft template (global.css, "The workspace"). */
      @layer components {
        /* A link to a card on the page (#look, #log, #signups) lands with the card clear of the sticky title bar. */
        html:has(body.ops) { scroll-padding-top: 5.5rem; }

        /* The building from the street sits a little higher in the frame than the clinic's rooms. */
        .ops .ws-backdrop img { object-position: 50% 40%; }
        /* The badge of the sidebar's card holds a line icon, not letters. */
        .ops .ws-branch-badge .ws-icon { width: 20px; height: 20px; }

        /* Password help sits at the foot of the sidebar: its note opens upward, so it is never below the screen. */
        .ops .ws-side-foot .ws-menu-pop { top: auto; bottom: calc(100% + 0.5rem); }

        /* At most four numbers: one row of four from 1280px, two by two below (never three and one, never cramped). */
        .ops .ws-tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        @media (min-width: 1280px) { .ops .ws-tiles { grid-template-columns: repeat(4, minmax(0, 1fr)); } }

        /* A phone's row of the five sections: an icon over a short word, so all five fit at 390px. */
        @media (max-width: 767px) {
          .ops .ws-tabrow { gap: 0.25rem; }
          .ops .ws-tabrow-item { flex-direction: column; gap: 0.2rem; min-height: 54px; padding: 0.375rem 0.125rem; font-size: 12.5px; line-height: 1.15; }
          .ops .ws-tabrow-item .ws-icon { display: block; }
        }

        /* Facts: a small label, the words beside it (stacked on a phone), soft hairlines between. */
        .ops-facts { display: grid; grid-template-columns: minmax(7.5rem, max-content) minmax(0, 1fr); column-gap: 1.25rem; }
        .ops-facts > dt, .ops-facts > dd { padding: 0.75rem 0; border-top: 1px solid var(--ws-hair); }
        .ops-facts > dt:first-of-type, .ops-facts > dt:first-of-type + dd { border-top: 0; }
        .ops-facts > dt { padding-top: 0.9rem; }
        .ops-facts > dd { font-size: 15px; line-height: 1.5; min-width: 0; overflow-wrap: anywhere; color: var(--c-ink); }
        @media (max-width: 479px) {
          .ops-facts { grid-template-columns: minmax(0, 1fr); }
          .ops-facts > dd { border-top: 0; padding-top: 0.15rem; }
          .ops-facts > dt:first-of-type + dd { padding-top: 0.15rem; }
        }

        /* A disclosure: a 44px row with a chevron that turns when it opens. */
        .ops-more > summary { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 48px; cursor: pointer; list-style: none; }
        .ops-more > summary::-webkit-details-marker { display: none; }
        .ops-more > summary > .ws-chev { transition: transform 180ms ease; }
        .ops-more[open] > summary > .ws-chev { transform: rotate(180deg); }
        .ops-more > summary:hover .ops-more-word { color: var(--ws-teal-ink); }

        /* A name that opens its side panel: a 44px target that reads as the row's title. The name is typed by a
           clinic and may be one long word: it wraps inside its cell rather than widen the table. */
        .ops-open { display: inline-flex; align-items: center; min-height: 44px; min-width: 0; max-width: 100%; overflow-wrap: anywhere; margin: -0.6rem 0 -0.35rem; text-align: left; font-size: 15.5px; font-weight: 600; line-height: 1.25; color: var(--c-ink); cursor: pointer; text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 4px; transition: text-decoration-color 160ms ease, color 160ms ease; }
        .ops-open:hover { color: var(--ws-teal-ink); text-decoration-color: currentColor; }
        /* The row whose panel is open: a whisper of grey and a teal edge (a teal wash would dim its muted words). */
        tr[data-open] > td { background: var(--ws-hover); }
        tr[data-open] > td:first-child { box-shadow: inset 3px 0 0 var(--ws-teal); }
        .ops .ws-panel-title { overflow-wrap: anywhere; }

        /* A mobile number to call: a 44px target. */
        .ops-call { display: inline-flex; align-items: center; gap: 0.35rem; min-height: 44px; font-size: 14px; font-variant-numeric: tabular-nums; white-space: nowrap; color: var(--c-ink-2); text-decoration: underline; text-decoration-color: var(--ws-hair-strong); text-underline-offset: 4px; }
        .ops-call:hover { color: var(--ws-teal-ink); text-decoration-color: currentColor; }

        /* A person beside their words: an avatar, then the name and a line under it. */
        .ops-who { display: flex; align-items: flex-start; gap: 0.75rem; min-width: 0; }
        .ops-who > .ws-avatar { margin-top: 1px; }
        .ops-who-text { display: grid; min-width: 0; }

        /* A list of rows inside a card: soft hairlines between, 20–24px in from the edges. */
        .ops-rows > li { border-top: 1px solid var(--ws-hair); padding: 1rem 1.5rem; }
        .ops-rows > li:first-child { border-top: 0; }
        @media (max-width: 767px) { .ops-rows > li { padding: 0.875rem 1rem; } }

        /* A field in a card's head takes the room it is given: up to 24rem beside the title, the whole row on a phone. */
        .ops .ws-pane-actions:has(> .ops-grow) { flex: 1 1 16rem; justify-content: flex-end; }
        .ops-grow { width: 100%; max-width: 24rem; }
        @media (max-width: 767px) { .ops-grow { max-width: none; } }

        /* One row of filter pills with More as the last one. Where they do not fit (a phone) they wrap on to a
           second row: every pill whole, nothing scrolls sideways, no word is cut short. */
        .ops-pills { flex-wrap: wrap; }
        .ops-pills .ws-seg-item { flex: none; max-width: 100%; }

        /* A callout's words and a link or button after them. */
        .ops .ws-callout > span { min-width: 0; flex: 1; }

        /* A small reference (an invoice or payment number): mono, as the soft template allows for references. */
        .ops-ref { font-family: var(--font-mono); font-size: 12.5px; letter-spacing: 0.02em; font-variant-numeric: tabular-nums; color: var(--c-muted); overflow-wrap: anywhere; }
      }
    </style>
  </head>
  <body class:list={['ws', 'ws-soft', 'ops', wide && 'ws-wide']} data-room="street">
    <div class="ws-backdrop" aria-hidden="true">
      <img src="/video/tour-poster.webp" alt="" decoding="async" />
    </div>
    <a href="#main" class="ws-skip">Skip to the page</a>

    <div class="ws-app">
      <aside id="ws-side" class="ws-side" aria-label="Flossify control menu" data-ws-side>
        <div class="ws-side-scroll">
          <div class="ws-side-top">
            <div class="ws-side-brand">
              <a href="/admin/" class="ws-mark" aria-label="Flossify control, the overview">
                <svg class="ws-mark-sq" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="9" /><path d="M9 8h14v11c0 3-1.6 5-3.2 5S17 22.4 17 20.4v-2.2h-2v2.2c0 2-1.2 3.6-2.8 3.6S9 22 9 19z" /></svg>
                <span class="ws-mark-word">Flossify</span>
              </a>
              <button type="button" class="ws-tool ws-side-close" data-ws-side-close aria-label="Close the menu">
                <Icon name="close" size={20} />
              </button>
            </div>

            <div class="ws-branch" title="Flossify control · every clinic">
              <span class="ws-branch-badge" aria-hidden="true"><Icon name="clinic" /></span>
              <span class="ws-branch-face">
                <span class="ws-branch-name">Flossify control</span>
                <span class="ws-branch-area">Every clinic</span>
              </span>
            </div>

            <nav class="ws-nav" aria-label="Flossify control">
              {SECTIONS.map((s) => (
                <a href={s.href} class="ws-nav-item" aria-current={s.id === section ? 'page' : undefined}>
                  <Icon name={s.icon} size={20} />
                  <span class="ws-nav-word ws-nav-long">{s.label}</span>
                  <span class="ws-nav-word ws-nav-short" aria-hidden="true">{s.short}</span>
                </a>
              ))}
            </nav>
          </div>
        </div>

        <div class="ws-side-foot">
          <div class="ws-me" title={`${admin.name} · Operations`}>
            <Avatar name={admin.name} />
            <span class="ws-me-text">
              <span class="ws-me-name">{admin.name}</span>
              <span class="ws-pill ws-me-role">Operations</span>
            </span>
          </div>
          <Menu id="ops-password" align="left" buttonClass="ws-side-link" title="Password help">
            <Fragment slot="button">
              <Icon name="info" /><span class="ws-side-word"><span class="ws-side-long">Password help</span><span class="ws-side-short" aria-hidden="true">Password</span></span>
            </Fragment>
            <div class="ws-menu-head">
              <p class="ws-menu-name text-ink">{admin.name}</p>
              {admin.email && <p class="mt-0.5 text-[14px] font-normal break-words text-ink-2">{admin.email}</p>}
            </div>
            <p class="ws-plan">
              A text can’t reset this password. Whoever runs the server sets a new one with the operations-account script (docs/deploy.md).
            </p>
          </Menu>
          <form method="post" action="/auth/logout" class="ws-signout"><Csrf /><button type="submit" class="ws-side-link">Sign out</button></form>
        </div>
      </aside>
      <div class="ws-scrim" data-ws-side-scrim hidden></div>

      <div class="ws-col" data-ws-col>
        <header class="ws-top ws-bar">
          <div class="ws-bar-row">
            <button type="button" class="ws-tool ws-side-open" aria-label="Menu" aria-controls="ws-side" aria-expanded="false" data-ws-side-open>
              <Icon name="menu" size={22} />
            </button>
            <div class="ws-bar-where">
              <p class="ws-bar-clinic">Flossify control</p>
              <h1 class="ws-bar-title ws-bar-h1">{title}</h1>
            </div>
          </div>
        </header>

        <nav class="ws-tabrow" aria-label="Flossify control sections">
          {SECTIONS.map((s) => (
            <a href={s.href} class="ws-tabrow-item" aria-current={s.id === section ? 'page' : undefined}>
              <Icon name={s.icon} />
              <span>{s.short}</span>
            </a>
          ))}
        </nav>

        {devData && (
          <p role="note" class="ws-devline"><Icon name="info" />Development database: the clinics and people here are invented.</p>
        )}

        <main id="main" tabindex="-1" class="ws-main ws-main-panes">
          <h1 class="ws-phone-title">{title}</h1>
          <slot />
        </main>
      </div>
    </div>

    <script>import '../components/ws/shell';</script>
  </body>
</html>
