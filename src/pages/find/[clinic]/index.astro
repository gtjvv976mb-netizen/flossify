---
export const prerender = false;

import Base from '../../../layouts/Base.astro';
import PatientHeader from '../../../components/PatientHeader.astro';
import Pane from '../../../components/ws/Pane.astro';
import Icon from '../../../components/ws/Icon.astro';
import Avatar from '../../../components/ws/Avatar.astro';
import ClinicBadge from '../_ui/ClinicBadge.astro';
import '../_ui/patient.css';
import { priceText, hmoById, CATEGORY_LABEL } from '../../../data/directory';
import { hoursRows } from '../../../lib/availability';
import { loadListing } from '../../../lib/directory-db';
import { publicPhoto } from '../../../lib/uploads';
import lqip from '../../../data/lqip.json';
const blur = (k: string) => lqip[k as keyof typeof lqip];

const l = await loadListing(Astro.params.clinic!);
if (!l) return new Response('No such clinic', { status: 404 });
const dentists = l.dentistProfiles;
const fees = l.fees;
const rows = hoursRows(l.hours);
const DAYS = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
const daysAt = (slug: string, d: (typeof dentists)[number]) => d.clinics.find((c) => c.slug === slug)?.days.map((n) => DAYS[n]).join(' · ') ?? '';
// The clinic's own map link when they pasted one in Settings; a search on the address otherwise.
const directions = l.mapsUrl ?? `https://www.google.com/maps/search/${encodeURIComponent(l.address)}`;
---


<Base title={`${l.name} — dentists, prices, hours — Flossify`} description={`${l.name}, ${l.area}. ${l.workspace ? 'Open slots' : 'Visit requests'}, fee guide, dentists and their PRC licence checks, and which HMO cards are taken. ${l.workspace ? 'Book' : 'Request a time'} without an account.`}>
  <PatientHeader current="find" />

  <main id="main" class="pt-main mx-auto max-w-[1280px] px-5 pt-5 pb-16 sm:px-8 sm:pt-7" data-hours={JSON.stringify(l.hours)} data-slug={l.slug} data-workspace={l.workspace ? '1' : '0'}>
    <a href="/find/" class="pt-back"><Icon name="chevron-left" />All clinics</a>

    <!-- The clinic: who it is, whether it is open now, and the one main action -->
    <section class="ws-pane ws-glass ws-pad-normal pt-card mt-2" aria-labelledby="clinic-title">
      <div class="grid gap-8 lg:grid-cols-12 lg:items-center">
        <div class="min-w-0 lg:col-span-7">
          <div class="flex items-center gap-4">
            <ClinicBadge name={l.name} size="lg" />
            <div class="min-w-0">
              <p class="meta">{l.area}{l.since ? ` · since ${l.since}` : ''} &middot; {l.chairs} {l.chairs === 1 ? 'chair' : 'chairs'}</p>
              <h1 id="clinic-title" class="pt-name mt-1">{l.name}</h1>
            </div>
          </div>
          <p class="mt-4"><span class="status pt-status" data-status><span class="status-dot"></span><span data-status-text>Hours below</span></span></p>
          <p class="mt-3 max-w-[60ch] text-[16.5px] leading-relaxed text-ink-2">{l.about}</p>

          <div class="mt-5 flex flex-wrap gap-2">
            <a href={`/find/${l.slug}/book/`} class="btn btn-primary"><Icon name="calendar" />{l.workspace ? 'Book a slot' : 'Request a time'}</a>
            <a href={`tel:${l.phone.replace(/\s/g, '')}`} class="btn btn-quiet">Call {l.phone}</a>
            <a href={directions} class="btn btn-quiet" rel="noopener"><span>Directions</span><Icon name="arrow-right" /></a>
          </div>
          <div class="mt-5 grid gap-1.5">
            <p class="pt-fact"><Icon name="clinic" size={16} /><span>{l.address}{l.walkIns ? ' · Walk-ins welcome' : ' · By appointment'}</span></p>
            <p class="pt-fact"><Icon name="user" size={16} /><span>{l.dpoName ? `Data Protection Officer: ${l.dpoName}.` : 'Data Protection Officer: not named here yet; ask the clinic.'} <a href="/privacy/" class="pt-link">Privacy notice</a></span></p>
          </div>

          {!l.workspace && (
            <p role="note" class="ws-callout mt-5 max-w-[64ch]">
              <Icon name="info" />
              <span>This clinic is not on the live schedule yet, so you send a <strong class="font-semibold">request</strong> with the day and time that suits you, and the clinic confirms the time with you. Clinics on the live schedule show real open slots instead.</span>
            </p>
          )}
        </div>

        <div class="pt-photos lg:col-span-5">
          {l.photos.map((k) => {
            // A clinic's own upload has no blur placeholder, so its figure starts as a plain soft box and the photo fades in over that.
            const p = publicPhoto(k, l.id, l.name);
            return (
              <figure class:list={['media aspect-[3/4]', p.upload && 'bg-bg-soft']} style={p.upload ? undefined : `background-image:url("${blur(k)}")`}>
                <img src={p.src} srcset={p.srcset} sizes="(min-width:1024px) 20vw, 45vw" alt={p.alt} loading="lazy" width="640" height="853" />
              </figure>
            );
          })}
        </div>
      </div>
    </section>

    <div class="mt-4 grid gap-4 lg:grid-cols-[minmax(0,1fr)_23rem] lg:items-start">
      <div class="pt-stack">
        <!-- Dentists -->
        <Pane class="pt-card" pad="none" id="dent" icon="patients" title="Dentists" meta={`${dentists.length} at this clinic`}>
          <ul class="pt-rows">
            {dentists.map((d) => (
              <li class="pt-person">
                <Avatar name={d.name} />
                <div class="min-w-0">
                  <h3 class="pt-person-name"><a href={`/dentists/${d.slug}/`}>{d.name}</a></h3>
                  <p class="mt-0.5 text-[14.5px] text-ink-2">{d.specialty ? <span>Specialist · {d.specialty}</span> : <span>General dentist · {d.practices.slice(1).join(', ') || d.practices[0]}</span>}</p>
                  <div class="pt-pills mt-2">
                    {d.prcCheckedOn
                      ? <span class="ws-pill ws-tint-teal" title="Checked by a person against verification.prc.gov.ph"><Icon name="check" size={13} />PRC licence · checked {new Date(d.prcCheckedOn).toLocaleDateString('en-PH', { day: 'numeric', month: 'short' })}</span>
                      : <span class="ws-pill ws-tint-amber" title="A person at Flossify has not yet checked this licence against verification.prc.gov.ph">PRC check pending</span>}
                    {d.pda && <span class="tag">PDA member</span>}
                    <span class="tag">Here {daysAt(l.slug, d)}</span>
                  </div>
                </div>
              </li>
            ))}
          </ul>
        </Pane>

        <!-- Fees -->
        <Pane class="pt-card pt-grow-actions" id="fee" icon="money" title="Fee guide">
          <label slot="actions" class="field w-full sm:w-64"><span class="sr-only">Filter services</span><input type="search" placeholder="Filter: pasta, bunot, braces…" data-fee-filter /></label>
          <table class="pt-table" data-fees>
            <tbody>
              {fees.map((f) => (
                <tr data-text={`${f.name} ${f.local ?? ''} ${CATEGORY_LABEL[f.cat]}`.toLowerCase()}>
                  <td><span class="font-medium">{f.name}</span>{f.local && <span class="text-muted"> · {f.local}</span>}<span class="ws-pill ws-tint-slate ml-2 hidden align-[1px] font-medium sm:inline-flex">{CATEGORY_LABEL[f.cat]}</span></td>
                  <td>{priceText(f)}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="ws-empty" data-fee-none hidden><Icon name="search" size={20} class="ws-empty-icon" /><span class="ws-empty-text">No service here matches that. Try another word, or ask the clinic.</span></p>
          <p class="mt-3 border-t border-hair pt-3 text-[14px] text-ink-2">A fee guide, not a quotation. The dentist confirms the fee at consultation, before any work begins.</p>
        </Pane>

        <!-- Reviews -->
        <Pane class="pt-card" id="rev" icon="message" title="Reviews">
          <p class="ws-empty"><Icon name="info" size={20} class="ws-empty-icon" /><span class="ws-empty-text">None yet: reviews are not open.</span></p>
          <p class="mt-1 max-w-[64ch] text-[14.5px] leading-relaxed text-ink-2">When they are, only patients whose visit was completed can leave one, each is read before it is published, and the clinic cannot remove it.</p>
        </Pane>
      </div>

      <div class="pt-stack">
        <!-- Hours -->
        <Pane class="pt-card" id="hrs" icon="clock" title="Hours">
          <table class="pt-table" data-hours-table>
            <tbody>
              {rows.map((r) => (
                <tr data-day={r.day}><th class="text-left font-medium">{r.name}</th><td class="text-ink-2">{r.text}</td></tr>
              ))}
            </tbody>
          </table>
        </Pane>

        <!-- Coverage -->
        <Pane class="pt-card" id="cov" icon="file" title="Cards and PhilHealth">
          <div class="pt-pills">
            {l.philhealth
              ? <span class="tag tag-accent">PhilHealth preventive dental · accredited</span>
              : <span class="tag">Not PhilHealth-accredited for dental</span>}
            {l.hmos.map((id) => <span class="tag">{hmoById(id)?.name}</span>)}
          </div>
          <p class="mt-4 text-[14.5px] leading-relaxed text-ink-2">
            HMO acceptance and PhilHealth accreditation are what the clinic reported. Bring your card and an ID, and confirm with your HMO — approval may be needed for anything beyond a cleaning.
            {l.philhealth && ' PhilHealth pays for two preventive visits a year here (up to ₱1,000).'}
          </p>
          <a href="/coverage/" class="pt-go mt-1">How coverage works <Icon name="arrow-right" size={16} /></a>
        </Pane>
      </div>
    </div>

    <div class="mt-6 flex flex-wrap gap-2">
      <a href={`/find/${l.slug}/book/`} class="btn btn-primary"><Icon name="calendar" />{l.workspace ? 'Book a slot' : 'Request a time'}</a>
      <a href="/find/" class="btn btn-quiet">Other clinics</a>
    </div>
  </main>

  <script>
    import { statusFor, manilaNow } from '../../../lib/availability';
    const main = document.querySelector('main')!;
    const now = manilaNow();
    const st = statusFor(JSON.parse(main.dataset.hours!), now);
    const pill = main.querySelector<HTMLElement>('[data-status]')!;
    pill.dataset.state = st.state;
    main.querySelector('[data-status-text]')!.textContent = st.text;
    main.querySelector(`[data-hours-table] tr[data-day="${now.day}"]`)?.classList.add('is-today');

    // Blur-up: the photo fades in over its own colours. `complete` covers cached images.
    main.querySelectorAll<HTMLImageElement>('.media > img').forEach((img) => {
      if (img.complete) img.classList.add('is-loaded');
      else img.addEventListener('load', () => img.classList.add('is-loaded'), { once: true });
    });

    const filter = main.querySelector<HTMLInputElement>('[data-fee-filter]');
    const none = main.querySelector<HTMLElement>('[data-fee-none]');
    filter?.addEventListener('input', () => {
      const q = filter.value.trim().toLowerCase();
      let shown = 0;
      main.querySelectorAll<HTMLTableRowElement>('[data-fees] tr').forEach((tr) => { tr.hidden = !!q && !tr.dataset.text!.includes(q); if (!tr.hidden) shown++; });
      if (none) none.hidden = shown > 0;
    });
  </script>
</Base>
