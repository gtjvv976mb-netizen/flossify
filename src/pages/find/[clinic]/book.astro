---
export const prerender = false;

import Base from '../../../layouts/Base.astro';
import PatientHeader from '../../../components/PatientHeader.astro';
import Icon from '../../../components/ws/Icon.astro';
import Avatar from '../../../components/ws/Avatar.astro';
import ClinicBadge from '../_ui/ClinicBadge.astro';
import ClinicRoom from '../_ui/ClinicRoom.astro';
import '../_ui/patient.css';
import '../_ui/clinic-glass.css';
import { priceText, symptoms, hmoById } from '../../../data/directory';
import { loadListing } from '../../../lib/directory-db';

// Five screens, no account. Reason → dentist → when → who → confirm. Every
// screen can be reached with Tab and answered with Enter; nothing is hidden
// behind a hover. The slots are the clinic's real ones (GET /api/availability)
// and the booking is a row in the clinic's schedule (POST /api/bookings),
// re-checked inside the same transaction so two people cannot take one chair.
const l = await loadListing(Astro.params.clinic!);
if (!l) return new Response('No such clinic', { status: 404 });
const dentists = l.dentistProfiles;
const fees = l.fees;
const DAYS = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
const steps = ['Reason', 'Dentist', 'When', 'Who', 'Confirm'];
---


<Base title={`Book at ${l.name} — Flossify`} description={`${l.workspace ? 'Book' : 'Request'} a dental visit at ${l.name} in five short steps. No account: your name, a mobile number, and ${l.workspace ? 'a real open slot' : 'the day that suits you'}.`}>
  <PatientHeader current="find" />

  <!-- The room behind the page: this clinic's own cover photo, or a soft blur when it has none. Decorative. -->
  <ClinicRoom keys={l.photoKeys} clinicId={l.id} narrow />

  <main id="main" class="pt-main cl-glass cl-book"
    data-slug={l.slug} data-name={l.name} data-phone={l.phone} data-workspace={l.workspace ? '1' : '0'}
    data-hours={JSON.stringify(l.hours)}
    data-dentists={JSON.stringify(dentists.map((d) => ({ slug: d.slug, name: d.name, days: d.clinics.find((c) => c.slug === l.slug)?.days ?? [] })))}
    data-services={JSON.stringify(fees.map((f) => ({ id: f.id, name: f.name, minutes: f.minutes, price: priceText(f) })))}
  >
    <!-- The heading, in its own small card: the way back, the clinic, what this page does -->
    <header class="cl-pane cl-head">
      <a href={`/find/${l.slug}/`} class="pt-back cl-back"><Icon name="chevron-left" />{l.name}</a>
      <div class="cl-id">
        <ClinicBadge name={l.name} size="lg" />
        <div class="min-w-0">
          <h1 class="pt-title">{l.workspace ? 'Book a visit' : 'Request a visit'}</h1>
          <p class="cl-sub">{l.name} &middot; {l.area}{l.workspace ? '' : ' · the clinic confirms the time with you'}</p>
        </div>
      </div>
    </header>

    <!-- One card: the steps, the step you are on, Back and Continue. The done screen takes its place. -->
    <div class="ws-pane ws-glass pt-card cl-pane cl-wizard">
      <!-- Progress -->
      <ol class="pt-steps" data-progress aria-label="Steps">
        {steps.map((s, i) => (
          <li class="wiz-step" data-step-mark={i} aria-current={i === 0 ? 'step' : undefined}>
            <span class="sec-no">{i + 1}</span>
            <span>{s}</span>
            <span class="sr-only" data-step-sr></span>
          </li>
        ))}
      </ol>

      <form class="cl-form" data-wizard novalidate>
        <!-- 1 Reason -->
        <fieldset class="wiz" data-step="0">
          <legend class="pt-legend" tabindex="-1">What is the visit for?</legend>
          <p class="pt-help">Pick what is closest. “Not sure” is a fine answer — the dentist will look.</p>
          <div class="cl-choices" role="radiogroup" aria-label="Reason">
            <label class="chip-radio"><input type="radio" name="reason" value="consultation" checked /><span>Not sure — a check-up</span></label>
            {symptoms.filter((s) => s.urgency !== 'urgent').map((s) => {
              const svc = s.services.find((id) => fees.some((f) => f.id === id)) ?? 'consultation';
              return <label class="chip-radio"><input type="radio" name="reason" value={svc} data-label={s.label} /><span>{s.label}</span></label>;
            })}
          </div>
          <details class="pt-more">
            <summary><span>Or choose the service directly</span><Icon name="chevron" size={16} /></summary>
            <div class="cl-choices">
              {fees.map((f) => <label class="chip-radio"><input type="radio" name="reason" value={f.id} data-label={f.name} /><span>{f.name}<span class="pt-price">{priceText(f)}</span></span></label>)}
            </div>
          </details>
          <p class="ws-callout cl-callout"><Icon name="money" /><span data-reason-price></span></p>
        </fieldset>

        <!-- 2 Dentist -->
        <fieldset class="wiz" data-step="1" hidden>
          <legend class="pt-legend" tabindex="-1">Any dentist, or someone in particular?</legend>
          <p class="pt-help">Choosing one limits the days you can pick.</p>
          <div class="cl-picks" role="radiogroup" aria-label="Dentist">
            <label class="row-radio pt-pick"><input type="radio" name="dentist" value="" checked /><span><span class="pt-pick-icon"><Icon name="patients" /></span><span class="pt-pick-words"><strong class="font-semibold">Any available dentist</strong><span class="cl-pick-line">Soonest slot at the clinic</span></span><span class="pt-tick" aria-hidden="true"></span></span></label>
            {dentists.map((d) => (
              <label class="row-radio pt-pick"><input type="radio" name="dentist" value={d.slug} /><span><Avatar name={d.name} /><span class="pt-pick-words"><strong class="font-semibold">{d.name}</strong><span class="cl-pick-line">{d.specialty ?? d.practices.slice(0, 2).join(', ')} · {d.clinics.find((c) => c.slug === l.slug)?.days.map((n) => DAYS[n]).join(' · ')} · {d.prcCheckedOn ? <span class="font-medium text-accent">PRC checked</span> : <span>PRC check pending</span>}</span></span><span class="pt-tick" aria-hidden="true"></span></span></label>
            ))}
          </div>
        </fieldset>

        <!-- 3 When -->
        <fieldset class="wiz" data-step="2" hidden>
          <legend class="pt-legend" tabindex="-1">{l.workspace ? 'When?' : 'When would suit you?'}</legend>
          {l.workspace
            ? <p class="pt-help">These are the clinic’s real open slots for the next two weeks, in Baguio time. Tap one.</p>
            : <p class="pt-help">This clinic is not on the live schedule. Tell us a day and a time of day; the clinic confirms the time with you.</p>}
          <div class="cl-slot-area" data-slot-area>
            {l.workspace
              ? <div class="pt-days" data-slot-days></div>
              : <div class="cl-fields">
                  <label class="field"><span class="meta">Preferred day</span><input type="date" name="reqDate" required /></label>
                  <label class="field"><span class="meta">Time of day</span><select name="reqTime"><option>Morning</option><option>Midday</option><option>Afternoon</option></select></label>
                </div>}
          </div>
          <input type="hidden" name="slot" />
          <button type="button" class="btn btn-quiet cl-slot-more" data-slot-more hidden><Icon name="chevron" />Show more days</button>
          <p class="cl-slot-note" data-slot-note></p>
        </fieldset>

        <!-- 4 Who -->
        <fieldset class="wiz" data-step="3" hidden>
          <legend class="pt-legend" tabindex="-1">Who is the visit for?</legend>
          <div class="cl-choices" role="radiogroup" aria-label="For whom">
            <label class="chip-radio"><input type="radio" name="who" value="me" checked /><span>Me</span></label>
            <label class="chip-radio"><input type="radio" name="who" value="other" /><span>Someone else</span></label>
          </div>
          <div class="cl-fields">
            <label class="field"><span class="meta" data-name-label>Your name</span><input type="text" name="name" autocomplete="name" required /></label>
            <label class="field"><span class="meta">Mobile number</span><input type="tel" name="phone" inputmode="tel" autocomplete="tel" placeholder="0917 000 0000" required pattern="^(\+?63|0)9\d{2}[ \-]?\d{3}[ \-]?\d{4}$" /></label>
            <label class="field cl-span" data-patient-name-field hidden><span class="meta">Patient’s name</span><input type="text" name="patientName" /></label>
            <label class="field"><span class="meta">HMO card (optional)</span>
              <select name="hmo"><option value="">None / I’ll pay</option>{l.hmos.map((id) => <option value={id}>{hmoById(id)?.name}</option>)}{l.philhealth && <option value="philhealth">PhilHealth preventive visit</option>}</select>
            </label>
            <label class="field"><span class="meta">Anything we should know? (optional)</span><input type="text" name="notes" placeholder="Pain, allergies, a time that works best" /></label>
          </div>
          <div class="pt-consent">
            <label class="check items-start"><input type="checkbox" name="consent" required /><span>I agree that {l.name} and Flossify keep my details for this visit and text me about it, as the <a href="/privacy/" target="_blank" rel="noopener" class="pt-link">privacy notice</a> explains.</span></label>
          </div>
        </fieldset>

        <!-- 5 Confirm -->
        <fieldset class="wiz" data-step="4" hidden>
          <legend class="pt-legend" tabindex="-1">Check and confirm</legend>
          <dl class="pt-summary" data-summary></dl>
          <p class="ws-callout cl-callout">
            <Icon name="info" />
            <span>{l.workspace
              ? 'The slot is held the moment you confirm. You get a text now, and a reminder the day before unless the visit is that soon. To cancel, use My visits up to two hours ahead, or call the clinic.'
              : 'The clinic gets your request now and confirms the time with you. Not heard by the day before? Call them.'}</span>
          </p>
        </fieldset>

        <!-- A refusal, in plain words, right above the button -->
        <p class="pt-error" data-error role="alert"></p>

        <!-- Nav -->
        <div class="pt-nav" data-nav>
          <button type="button" class="btn btn-quiet" data-back hidden><Icon name="chevron-left" />Back</button>
          <button type="button" class="btn btn-primary" data-next><span data-next-label>Continue</span><Icon name="arrow-right" class="pt-next-go" /><Icon name="check" class="pt-next-ok" /></button>
        </div>
      </form>

      <!-- Done -->
      <section data-done-panel hidden aria-live="polite">
        <span class="pt-done-mark" data-tone={l.workspace ? undefined : 'request'}><Icon name={l.workspace ? 'check' : 'message'} size={26} /></span>
        <p class="cl-done-pill"><span class:list={['ws-pill', l.workspace ? 'ws-tint-green' : 'ws-tint-blue']}>{l.workspace ? 'Booked' : 'Request sent'}</span></p>
        <h2 class="pt-done-title" data-done-title tabindex="-1"></h2>
        <p class="cl-done-text" data-done-text></p>
        <p class="pt-ref"><span class="pt-ref-label">Reference</span><span class="pt-ref-no" data-ref></span></p>
        <div class="cl-done-actions">
          <button type="button" class="btn btn-quiet" data-undo><span data-undo-words>Undo</span> <span class="pt-clock" data-undo-secs aria-live="off">3:00</span></button>
          <a class="btn btn-quiet" download="flossify-visit.ics" data-ics><Icon name="calendar" />Add to calendar</a>
          <a href="/find/" class="btn btn-quiet"><Icon name="search" />Find another clinic</a>
        </div>
        <p class="pt-error" data-undo-error role="alert" hidden></p>
        <p class="ws-callout cl-callout cl-done-note">
          <Icon name="info" />
          <span>Changed your mind within three minutes? Undo frees the slot at once, and no reminder follows. After that, cancel under <a href="/me/" class="pt-link pt-link-reach">My visits</a> or by calling {l.phone}. The clinic sees this booking on its schedule the moment you confirm.</span>
        </p>
      </section>
    </div>

    <!-- Bookings on this device -->
    <section class="ws-pane ws-glass ws-pad-none pt-card cl-pane" data-mine hidden aria-labelledby="mine-title">
      <header class="ws-pane-head">
        <div class="ws-pane-heading">
          <span class="ws-pane-icon"><Icon name="calendar" /></span>
          <div class="min-w-0"><h2 id="mine-title" class="ws-pane-title">Your bookings on this device</h2></div>
        </div>
      </header>
      <ul class="pt-rows" data-mine-list></ul>
    </section>
  </main>

  <script>
    import { manilaNow } from '../../../lib/availability';
    import { svgFor } from '../../../components/ws/icons';

    const main = document.querySelector('main')!;
    const ws = main.dataset.workspace === '1';
    const slug = main.dataset.slug!, clinicName = main.dataset.name!;
    const dentists = JSON.parse(main.dataset.dentists!) as { slug: string; name: string; days: number[] }[];
    const services = JSON.parse(main.dataset.services!) as { id: string; name: string; minutes: number; price: string }[];
    const form = main.querySelector<HTMLFormElement>('[data-wizard]')!;
    // A request can't be for a day that has passed (the API refuses it too): the picker starts at today, Manila time.
    const reqDateInput = form.querySelector<HTMLInputElement>('input[name=reqDate]');
    if (reqDateInput) reqDateInput.min = manilaNow().ymd;
    const $ = <T extends Element = HTMLElement>(s: string, r: ParentNode = main) => r.querySelector(s) as T;
    const steps = Array.from(form.querySelectorAll<HTMLFieldSetElement>('[data-step]'));
    const marks = Array.from(main.querySelectorAll<HTMLElement>('[data-step-mark]'));
    const back = $('[data-back]') as HTMLButtonElement, next = $('[data-next]') as HTMLButtonElement, err = $('[data-error]');
    // The main button's words live in their own span, so its icon stays: an arrow while there is a
    // next step, a check on the last one, none while it is working.
    const nextLabel = $('[data-next-label]', next), nextGo = $('.pt-next-go', next), nextOk = $('.pt-next-ok', next);
    const setNext = (words: string, icon: 'go' | 'ok' | 'none') => {
      nextLabel.textContent = words;
      nextGo.style.display = icon === 'go' ? 'block' : 'none';
      nextOk.style.display = icon === 'ok' ? 'block' : 'none';
    };
    // Anything a person typed, or a stored booking, goes into markup escaped.
    const esc = (v: unknown) => String(v ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
    let at = 0;

    const val = (n: string) => (form.elements.namedItem(n) as RadioNodeList | HTMLInputElement | null)?.value ?? '';
    const chosenLabel = (n: string) => { const el = form.querySelector<HTMLInputElement>(`input[name="${n}"]:checked`); return el?.dataset.label ?? el?.nextElementSibling?.textContent?.trim() ?? ''; };
    const service = () => services.find((s) => s.id === val('reason')) ?? services[0];

    // Step 1: the price follows the reason.
    const reasonPrice = $('[data-reason-price]');
    const paintReason = () => { const s = service(); reasonPrice.textContent = `${s.name}: ${s.price}. About ${s.minutes} minutes in the chair.`; };
    form.addEventListener('change', (e) => { if ((e.target as HTMLInputElement).name === 'reason') paintReason(); });
    paintReason();

    // Step 3: the clinic's real open slots, grouped by day, for the chosen dentist and the chair time the service needs.
    const slotDays = $('[data-slot-days]') as HTMLElement | null;
    const more = $('[data-slot-more]') as HTMLButtonElement, note = $('[data-slot-note]');
    let shownDays = 4;
    let lastSlots: { at: string; date: string; label: string; dayLabel: string }[] = [];
    async function fetchSlots() {
      const d = val('dentist');
      const q = new URLSearchParams({ clinic: slug, minutes: String(service().minutes), days: '14' });
      if (d) q.set('dentist', d);
      const r = await fetch(`/api/availability?${q}`, { headers: { accept: 'application/json' } });
      if (!r.ok) throw new Error('availability');
      lastSlots = (await r.json()).slots;
    }
    function paintSlots() {
      if (!ws || !slotDays) return;
      const d = dentists.find((x) => x.slug === val('dentist'));
      const byDay = new Map<string, typeof lastSlots>();
      for (const s of lastSlots) (byDay.get(s.date) ?? byDay.set(s.date, []).get(s.date)!).push(s);
      const days = Array.from(byDay.entries());
      slotDays.innerHTML = days.slice(0, shownDays).map(([, ss]) => `
        <div class="pt-day" role="group" aria-label="${esc(ss[0].dayLabel)}">
          <p class="pt-day-label">${esc(ss[0].dayLabel)}</p>
          <div class="pt-slots">${ss.map((s) => `<label class="slot-radio"><input type="radio" name="slotpick" value="${esc(s.at)}" data-label="${esc(s.dayLabel)}, ${esc(s.label)}"><span>${esc(s.label)}</span></label>`).join('')}</div>
        </div>`).join('') || `<p class="ws-empty">${svgFor('info', 20).replace('class="ws-icon"', 'class="ws-icon ws-empty-icon"')}<span class="ws-empty-text">Nothing open in the next two weeks for that choice. Try “any dentist”, or call the clinic.</span></p>`;
      more.hidden = days.length <= shownDays;
      note.textContent = d ? `${d.name} is in on ${d.days.map((n) => ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'][n]).join(', ')}.` : `${lastSlots.length} open slots in the next two weeks.`;
      // A slot passed in from the search page is preselected if it is still free.
      // (A link written before the time was encoded reads its "+08:00" as " 08:00": put the plus back.)
      const pre = new URLSearchParams(location.search).get('slot')?.replace(' ', '+');
      const hit = pre && slotDays.querySelector<HTMLInputElement>(`input[value="${CSS.escape(pre)}"]`);
      if (hit) hit.checked = true;
    }
    async function refreshSlots() {
      if (!ws || !slotDays) return;
      slotDays.innerHTML = '<p class="pt-wait">Checking the schedule…</p>';
      try { await fetchSlots(); paintSlots(); }
      catch { slotDays.innerHTML = '<p class="pt-error">Could not reach the schedule. Try again, or call the clinic.</p>'; }
    }
    more.addEventListener('click', () => { shownDays += 4; paintSlots(); });
    form.addEventListener('change', (e) => { const n = (e.target as HTMLInputElement).name; if (n === 'dentist' || n === 'reason') { shownDays = 4; refreshSlots(); } });
    refreshSlots();

    // Step 4: someone else → a second name. (Whether the mobile is on file is
    // decided on the server when the booking is made — never shown before.)
    const whoLabel = $('[data-name-label]'), patientField = $('[data-patient-name-field]');
    form.addEventListener('change', (e) => {
      const t = e.target as HTMLInputElement;
      if (t.name === 'who') { const other = t.value === 'other'; patientField.hidden = !other; whoLabel.textContent = other ? 'Your name (the one we text)' : 'Your name'; }
    });

    // Validation per step, in plain words.
    function validate(i: number): string {
      if (i === 2) {
        if (ws) { const pick = form.querySelector<HTMLInputElement>('input[name="slotpick"]:checked'); if (!pick) return 'Pick a slot.'; (form.elements.namedItem('slot') as HTMLInputElement).value = pick.value; }
        else if (!val('reqDate')) return 'Pick a day.';
      }
      if (i === 3) {
        const name = form.elements.namedItem('name') as HTMLInputElement, phone = form.elements.namedItem('phone') as HTMLInputElement, consent = form.elements.namedItem('consent') as HTMLInputElement;
        if (!name.value.trim()) { name.focus(); return 'We need a name.'; }
        if (!phone.checkValidity()) { phone.focus(); return 'A Philippine mobile number, like 0917 000 0000.'; }
        if (val('who') === 'other' && !(form.elements.namedItem('patientName') as HTMLInputElement).value.trim()) return 'Whose visit is it?';
        if (!consent.checked) return 'Tick the box so we can use your details for this booking.';
      }
      return '';
    }

    function summary() {
      const d = dentists.find((x) => x.slug === val('dentist'));
      const when = ws ? chosenLabel('slotpick') : `${val('reqDate')}, ${val('reqTime').toLowerCase()} (to be confirmed)`;
      const who = val('who') === 'other' ? `${val('patientName')} (booked by ${val('name')})` : val('name');
      const rows: [string, string][] = [
        ['Clinic', clinicName], ['Visit', `${chosenLabel('reason') || service().name} · ${service().price}`],
        ['Dentist', d?.name ?? 'Any available dentist'], ['When', when], ['Patient', who], ['Text to', val('phone')],
        ['Card', (form.elements.namedItem('hmo') as HTMLSelectElement).selectedOptions[0]?.textContent ?? 'None'],
      ];
      if (val('notes')) rows.push(['Notes', val('notes')]);
      $('[data-summary]').innerHTML = rows.map(([k, v]) => `<div class="pt-sum-row"><dt>${esc(k)}</dt><dd>${esc(v)}</dd></div>`).join('');
    }

    // The step's question takes the focus (not on the first paint), so Tab and Enter carry on from
    // there and a screen reader starts at the question; the smooth scroll below is the one that moves the page.
    function show(i: number, focus = true) {
      at = i;
      steps.forEach((s, n) => { s.hidden = n !== i; });
      marks.forEach((m, n) => {
        m.toggleAttribute('data-passed', n < i); if (n === i) m.setAttribute('aria-current', 'step'); else m.removeAttribute('aria-current');
        // A step done shows a check in place of its number; a screen reader hears it in words.
        m.querySelector('[data-step-sr]')!.textContent = n < i ? ', done' : '';
      });
      back.hidden = i === 0;
      if (i === steps.length - 1) setNext(ws ? 'Confirm booking' : 'Send request', 'ok'); else setNext('Continue', 'go');
      err.textContent = '';
      if (i === steps.length - 1) summary();
      if (focus) steps[i].querySelector<HTMLElement>('legend')?.focus({ preventScroll: true });
      main.scrollIntoView({ block: 'start', behavior: 'smooth' });
    }
    back.addEventListener('click', () => show(Math.max(0, at - 1)));
    next.addEventListener('click', () => {
      const e = validate(at); if (e) { err.textContent = e; return; }
      if (at < steps.length - 1) show(at + 1); else finish();
    });
    form.addEventListener('keydown', (e) => { if (e.key === 'Enter' && (e.target as HTMLElement).tagName !== 'TEXTAREA') { e.preventDefault(); next.click(); } });

    // Done: hold it on this device, offer undo, write a calendar file.
    const KEY = 'flossify:bookings';
    const load = (): any[] => { try { return JSON.parse(localStorage.getItem(KEY) ?? '[]'); } catch { return []; } };
    const save = (list: any[]) => { try { localStorage.setItem(KEY, JSON.stringify(list)); } catch { /* private mode */ } };
    let undoTimer = 0;

    async function finish() {
      next.disabled = true; setNext(ws ? 'Booking…' : 'Sending…', 'none'); err.textContent = '';
      const d = dentists.find((x) => x.slug === val('dentist'));
      const payload = { clinic: slug, service: val('reason'), dentist: val('dentist') || null, at: val('slot'), reqDate: val('reqDate'), reqTime: val('reqTime'), who: val('who'), name: val('name'), patientName: val('patientName'), phone: val('phone'), hmo: val('hmo'), notes: val('notes'), consent: (form.elements.namedItem('consent') as HTMLInputElement).checked };
      let res: any;
      try {
        const r = await fetch('/api/bookings', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(payload) });
        // The server's own sentence when it sent one: a slot just gone, a number that has
        // booked five times today, a busy connection. A gateway answering in HTML gets the plain one.
        res = r.ok ? await r.json() : await r.json().catch(() => ({}));
        if (!r.ok) {
          next.disabled = false; setNext(ws ? 'Confirm booking' : 'Send request', 'ok');
          if (r.status === 409) { show(2); refreshSlots(); }
          err.textContent = res.error || 'Something went wrong. Try again.'; // after show(): it clears the error area
          return;
        }
      } catch {
        err.textContent = 'Could not reach the clinic’s schedule. Check your connection and try again.';
        next.disabled = false; setNext(ws ? 'Confirm booking' : 'Send request', 'ok'); return;
      }
      const ref = res.ref as string;
      const booking = { ref, cancelToken: res.cancelToken, slug, clinic: clinicName, service: chosenLabel('reason') || service().name, dentist: d?.name ?? 'Any dentist', slot: ws ? val('slot') : `${val('reqDate')} ${val('reqTime')}`, label: ws ? chosenLabel('slotpick') : `${val('reqDate')}, ${val('reqTime')} (requested)`, name: val('who') === 'other' ? val('patientName') : val('name'), phone: val('phone'), status: ws ? 'booked' : 'requested', madeAt: Date.now(), returning: !!res.returning, chartNo: res.chartNo };
      save([booking, ...load()]);
      form.hidden = true; $('[data-progress]').hidden = true;
      const done = $('[data-done-panel]'); done.hidden = false;
      main.scrollIntoView({ block: 'start', behavior: 'smooth' });
      $('[data-done-title]').textContent = ws ? `${booking.label}, ${clinicName}.` : `Request sent to ${clinicName}.`;
      // A visit today gets no reminder (the reminder pass only looks at tomorrow), so it is not promised one.
      // The API says whether a reminder will come (a same-day or late-night booking gets none), and texts ask for no reply: the sender is one-way.
      $('[data-done-text]').textContent = (ws ? `A text is on its way to ${booking.phone}${res.reminder ? ', and a reminder will follow the day before' : ''}.` : `A text is on its way to ${booking.phone} to say the clinic has it. They confirm ${booking.label.replace(' (requested)', '')} with you; not heard by the day before? Call ${main.dataset.phone}.`) + (booking.returning ? ` Welcome back — your record ${booking.chartNo} is already on file.` : '');
      $('[data-ref]').textContent = ref;
      // The button that was pressed is gone with the form: the focus goes to what happened.
      $('[data-done-title]').focus({ preventScroll: true });
      // Calendar file: an all-day marker for requests, the exact half hour for bookings.
      const start = ws ? booking.slot.slice(0, 16).replace(/[-:]/g, '') + '00' : booking.slot.slice(0, 10).replace(/-/g, ''); // '2026-09-24T09:00:00+08:00' → 20260924T090000
      const ics = ['BEGIN:VCALENDAR', 'VERSION:2.0', 'PRODID:-//Flossify//Visit//EN', 'BEGIN:VEVENT', `UID:${ref}@flossify`, `DTSTAMP:${new Date().toISOString().replace(/[-:]/g, '').replace(/\.\d+/, '')}`,
        ws ? `DTSTART;TZID=Asia/Manila:${start}` : `DTSTART;VALUE=DATE:${start}`, `SUMMARY:Dentist — ${clinicName}`, `DESCRIPTION:${booking.service} with ${booking.dentist}. Ref ${ref}.`, `LOCATION:${clinicName}`, 'END:VEVENT', 'END:VCALENDAR'].join('\r\n');
      ($('[data-ics]') as HTMLAnchorElement).href = 'data:text/calendar;charset=utf-8,' + encodeURIComponent(ics);
      // Three-minute undo, counted down where the patient can see it.
      let left = 180; const secs = $('[data-undo-secs]'), undo = $('[data-undo]') as HTMLButtonElement, undoWords = $('[data-undo-words]'), undoErr = $('[data-undo-error]');
      clearInterval(undoTimer);
      undoTimer = window.setInterval(() => { left--; secs.textContent = `${Math.floor(left / 60)}:${String(left % 60).padStart(2, '0')}`; if (left <= 0) { clearInterval(undoTimer); undo.hidden = true; } }, 1000);
      undo.onclick = async () => {
        undo.disabled = true; undoWords.textContent = 'Undoing…'; secs.hidden = true; undoErr.hidden = true;
        // The booking stands until the server says otherwise. When it refuses (too many
        // requests, or it cannot be reached) say so in its words and leave the clock running.
        let problem = '';
        try {
          const r = await fetch(`/api/bookings/${encodeURIComponent(ref)}?token=${encodeURIComponent(booking.cancelToken)}&clinic=${encodeURIComponent(slug)}`, { method: 'DELETE' });
          if (!r.ok) problem = (await r.json().catch(() => ({}))).error || 'Could not undo just now. Try once more, or cancel under My visits.';
        } catch { problem = 'Could not reach the clinic. Check your connection and try again.'; }
        if (problem) {
          undoWords.textContent = 'Undo'; secs.hidden = false; undo.disabled = false;
          undoErr.hidden = false; undoErr.textContent = problem;
          return;
        }
        clearInterval(undoTimer); save(load().filter((b) => b.ref !== ref)); location.href = location.pathname;
      };
      paintMine();
    }

    function paintMine() {
      const mine = load(); const sec = $('[data-mine]'); sec.hidden = mine.length === 0;
      $('[data-mine-list]').innerHTML = mine.map((b) => `<li class="pt-mine-row"><span class="min-w-0"><strong class="block font-semibold">${esc(b.clinic)}</strong><span class="block text-[14.5px] text-ink-2">${esc(b.service)} · ${esc(b.label)}</span></span><span class="flex flex-wrap items-center gap-2"><span class="ws-pill ${b.status === 'booked' ? 'ws-tint-teal' : 'ws-tint-amber'}">${b.status === 'booked' ? 'Booked' : b.status === 'requested' ? 'Requested' : esc(b.status)}</span><span class="pt-mine-ref">${esc(b.ref)}</span></span></li>`).join('');
    }
    paintMine();
    show(0, false);
  </script>
</Base>
