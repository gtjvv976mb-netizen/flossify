---
// Rendered on the server for every request: the directory comes from Postgres
// (public_directory(), which exposes a clinic's public face and nothing else)
// and each card's next open slots are computed from the clinic's real
// appointments. Filtering stays on the device; so does "open now", read from
// the visitor's clock in the clinic's time zone.
export const prerender = false;

import Base from '../../layouts/Base.astro';
import PatientHeader from '../../components/PatientHeader.astro';
import Pane from '../../components/ws/Pane.astro';
import Icon from '../../components/ws/Icon.astro';
import Empty from '../../components/ws/Empty.astro';
import ClinicBadge from './_ui/ClinicBadge.astro';
import './_ui/patient.css';
import { services, symptoms, hmos, hmoById, priceText, CATEGORY_LABEL } from '../../data/directory';
import { loadDirectory, openSlots, slotIso } from '../../lib/directory-db';

const listings = await loadDirectory();
const areas = [...new Set(listings.map((l) => l.area))];
const cards = await Promise.all(listings.map(async (l) => ({
  l,
  fees: l.fees,
  offered: l.fees.map((f) => f.id),
  minPrice: Object.fromEntries(l.fees.map((f) => [f.id, f.min])),
  dentists: l.dentistProfiles,
  slots: l.workspace ? await openSlots(l, { limit: 3 }) : [],
})));
---


<Base
  title="Find a dentist in Baguio — Flossify"
  description="Search dental clinics by what is wrong, by service, by HMO or PhilHealth, and see real open slots and prices before you book. No account needed."
>
  <PatientHeader current="find" />

  <!-- The clinic behind the page: its waiting area, fixed to the screen under the glass cards (the
       clinic sign-up's technique, with the reception's photo). Decorative. -->
  <div class="pt-room" aria-hidden="true">
    <picture>
      <source media="(max-width: 639px)" srcset="/img/ws/waiting-960.webp" />
      <img src="/img/ws/waiting-1920.webp" srcset="/img/ws/waiting-960.webp 960w, /img/ws/waiting-1920.webp 1920w" sizes="100vw" alt="" width="1920" height="1080" decoding="async" fetchpriority="high" />
    </picture>
  </div>

  <main id="main" class="pt-main pt-glass">
    <header class="pt-pane pt-intro">
      <p class="pt-eyebrow">Patients &middot; Baguio &middot; La Trinidad</p>
      <h1 class="pt-title">Find a dentist who can see you.</h1>
      <p class="pt-lede">Real open slots, the price before you book, and which cards the clinic takes. No account.</p>
    </header>

    <!-- What's wrong, and the filters: one card, the way the workspace's Patients tab puts its search and pills on one. -->
    <Pane class="pt-card pt-pane pt-sym-card" id="sym" icon="search" title="What’s wrong?">
      <!-- On a phone the pills run as one row that scrolls sideways (patient.css, .pt-sym-row), so the first clinic is on the first screen;
           this line says so there (sighted people only: a screen reader reads every pill anyway), as the workspace's wide tables do. -->
      <span slot="actions" class="meta pt-sym-hint" aria-hidden="true">Scroll for all {symptoms.length}<Icon name="arrow-right" size={14} /></span>
      <div class="pt-sym-row" role="group" aria-label="Symptom" data-symptoms>
        {symptoms.map((s) => (
          <button type="button" class:list={['chip', s.urgency === 'urgent' && 'chip-urgent']} aria-pressed="false" data-symptom={s.id} data-services={s.services.join(',')} data-urgency={s.urgency} data-tip={s.tip}>
            {s.label}
          </button>
        ))}
      </div>
      <p class="ws-callout pt-callout" data-tip-box hidden><Icon name="info" /><span data-tip-text></span></p>
      <div class="ws-callout pt-callout" data-tone="alert" data-urgent hidden>
        <Icon name="alert" />
        <span><strong class="font-semibold">This can’t wait for a booking.</strong> Call a clinic that is open now — each card has a Call button — or go to the nearest emergency room if there is trouble breathing or swallowing.</span>
      </div>

      <form class="pt-filter-form" data-filters aria-label="Filters" onsubmit="return false">
        <!-- On a phone the four selects wait behind one line (open when one of them is set); from 768px they are always shown. -->
        <details class="pt-filter-more" open data-filter-more>
          <summary><span class="pt-filter-name">More filters</span><span class="pt-filter-count" data-filter-count hidden></span><span class="pt-filter-hint">Service, HMO, area, sort</span><Icon name="chevron" size={16} /></summary>
          <div class="pt-filters">
        <label class="field pt-filter-wide">
          <span class="meta">Service</span>
          <select name="service">
            <option value="">Any service</option>
            {Object.entries(CATEGORY_LABEL).map(([cat, label]) => (
              <optgroup label={label}>
                {services.filter((s) => s.cat === cat).map((s) => <option value={s.id}>{s.name}{s.local ? ` (${s.local})` : ''}</option>)}
              </optgroup>
            ))}
          </select>
        </label>
        <label class="field">
          <span class="meta">HMO</span>
          <select name="hmo">
            <option value="">Any / none</option>
            {hmos.map((h) => <option value={h.id}>{h.name}</option>)}
          </select>
        </label>
        <label class="field">
          <span class="meta">Area</span>
          <select name="area">
            <option value="">Anywhere</option>
            {areas.map((a) => <option value={a}>{a}</option>)}
          </select>
        </label>
        <label class="field">
          <span class="meta">Sort</span>
          <select name="sort">
            <option value="soonest">Soonest slot</option>
            <option value="price">Lowest price</option>
            <option value="name">Name</option>
          </select>
        </label>
          </div>
        </details>
        <div class="pt-switches" role="group" aria-label="Only clinics that are">
          <label class="pt-toggle"><input type="checkbox" name="philhealth" /><span>PhilHealth dental</span></label>
          <label class="pt-toggle"><input type="checkbox" name="open" /><span>Open now</span></label>
        </div>
      </form>
    </Pane>

    <p class="pt-pane pt-count" data-count aria-live="polite">{listings.length === 1 ? '1 clinic' : `${listings.length} clinics`}</p>

    <!-- Results -->
    <ul class="pt-results" data-results>
      {cards.map(({ l, dentists, offered, minPrice, fees, slots }) => {
        const checked = dentists.filter((d) => d.prcCheckedOn).length;
        const specialties = dentists.filter((d) => d.specialty).map((d) => d.specialty).join(', ');
        return (
        <li
          class="result pt-result pt-pane"
          data-slug={l.slug}
          data-name={l.name}
          data-area={l.area}
          data-hmos={l.hmos.join(',')}
          data-philhealth={l.philhealth ? '1' : '0'}
          data-workspace={l.workspace ? '1' : '0'}
          data-offered={offered.join(',')}
          data-minprice={JSON.stringify(minPrice)}
          data-hours={JSON.stringify(l.hours)}
          data-first-slot={slots[0] ? slotIso(slots[0]) : ''}
        >
          <div class="result-main min-w-0">
            <div class="pt-result-head">
              <ClinicBadge name={l.name} />
              <div class="pt-result-id min-w-0">
                <h2 class="pt-result-name"><a href={`/find/${l.slug}/`}>{l.name}</a></h2>
                <p class="pt-result-where">
                  <span>{l.area}</span>
                  <span class="status pt-status" data-status><span class="status-dot"></span><span data-status-text>{l.hours[1] ? 'Mon–Sat' : 'Hours vary'}</span></span>
                </p>
              </div>
            </div>
            <p class="pt-result-about">{l.about}</p>

            <dl class="pt-facts">
              <div>
                <dt class="meta"><Icon name="money" size={16} />Price</dt>
                <dd class="font-semibold tabular-nums" data-price>Consultation {priceText(fees.find((f) => f.id === 'consultation') ?? { min: null })}</dd>
              </div>
              <div>
                <dt class="meta"><Icon name="patients" size={16} />Dentists</dt>
                <dd>
                  <span class="pt-dentists">
                    <span>{dentists.length} {dentists.length === 1 ? 'dentist' : 'dentists'}</span>
                    {dentists.length > 0 && checked === dentists.length
                      ? <span class="ws-pill ws-tint-teal"><Icon name="check" size={13} />PRC checked</span>
                      : checked > 0
                        ? <span class="ws-pill ws-tint-teal"><Icon name="check" size={13} />{checked} PRC checked</span>
                        : <span class="ws-pill ws-tint-amber">PRC check pending</span>}
                  </span>
                  {specialties && <span class="pt-specialty">{specialties}</span>}
                </dd>
              </div>
              <div>
                <dt class="meta"><Icon name="file" size={16} />Cards</dt>
                <dd class="pt-pills">
                  {l.philhealth && <span class="tag tag-accent">PhilHealth</span>}
                  {l.hmos.slice(0, 3).map((id) => <span class="tag">{hmoById(id)?.name}</span>)}
                  {l.hmos.length > 3 && <span class="tag">+{l.hmos.length - 3}</span>}
                  {!l.philhealth && l.hmos.length === 0 && <span class="pt-none">None listed</span>}
                </dd>
              </div>
            </dl>
          </div>

          <div class="result-side pt-side">
            <p class="meta pt-side-label" data-slots-label>{l.workspace ? 'Next open' : 'Request a time'}</p>
            <div class="pt-side-slots" data-slots>
              {l.workspace
                ? (slots.length
                    ? slots.map((sl) => <a class="slot" href={`/find/${l.slug}/book/?slot=${encodeURIComponent(slotIso(sl))}`}><span class="meta">{sl.dayLabel}</span>{sl.label}</a>)
                    : <span class="pt-side-note">Nothing open in the next two weeks — call the clinic.</span>)
                : <span class="pt-side-note">Not on the live schedule yet. Send a request and the clinic confirms the time with you.</span>}
            </div>
            <div class="pt-actions">
              <a href={`/find/${l.slug}/book/`} class="btn btn-quiet pt-book" data-book><Icon name="calendar" />{l.workspace ? 'Book' : 'Request'}</a>
              <a href={`/find/${l.slug}/`} class="btn btn-quiet">Clinic page</a>
              <a href={`tel:${l.phone.replace(/\s/g, '')}`} class="btn btn-quiet" aria-label={`Call ${l.name}`}>Call</a>
            </div>
          </div>
        </li>
        );
      })}
    </ul>

    {listings.length === 0 ? (
      <div class="pt-pane pt-empty">
        <Empty icon="clinic" text="No clinics are listed yet. Flossify opens with its first clinics in Baguio, and this page fills as they join." action={{ label: 'Running a clinic? Set yours up', href: '/start/' }} />
      </div>
    ) : (
      <div class="pt-pane pt-empty" data-empty hidden>
        <p class="ws-empty">
          <Icon name="search" size={20} class="ws-empty-icon" />
          <span class="ws-empty-text">No clinic matches all of that. Try a wider area, or clear the HMO — every clinic here takes a booking or a request.</span>
          <a href="/find/" class="ws-empty-go">Clear the filters <Icon name="arrow-right" size={16} /></a>
        </p>
      </div>
    )}

    <p class="pt-fact pt-pane pt-note">
      <Icon name="info" size={16} />
      <span>The symptom guide is general guidance, not a diagnosis. Prices are the clinic’s fee guide; the dentist confirms the fee at consultation. HMO acceptance is what the clinic reported — confirm with your HMO.</span>
    </p>
  </main>

  <script>
    import { statusFor, manilaNow } from '../../lib/availability';

    const $ = <T extends Element = HTMLElement>(s: string, r: ParentNode = document) => r.querySelector(s) as T | null;
    const $$ = <T extends Element = HTMLElement>(s: string, r: ParentNode = document) => Array.from(r.querySelectorAll(s)) as T[];

    const form = $('[data-filters]') as HTMLFormElement;
    const results = $$('[data-results] > li');
    const symButtons = $$('[data-symptoms] .chip') as HTMLButtonElement[];
    const tip = $('[data-tip-box]')!, tipText = $('[data-tip-text]')!, urgent = $('[data-urgent]')!, count = $('[data-count]')!;
    // Absent when no clinic is listed at all: the page then says so in place of the filter message.
    const empty = $('[data-empty]');
    const peso = (n: number) => '₱' + n.toLocaleString('en-PH');

    const state = { symptom: '', service: '', hmo: '', area: '', sort: 'soonest', philhealth: false, open: false };

    // Live status, from the visitor's clock in the clinic's time zone. Slots came from the server.
    const now = manilaNow();
    const facts = new Map(results.map((li) => {
      const st = statusFor(JSON.parse(li.dataset.hours!), now);
      const pill = $('[data-status]', li)!;
      pill.dataset.state = st.state;
      $('[data-status-text]', li)!.textContent = st.text;
      return [li, { st, first: li.dataset.firstSlot || '' }];
    }));

    function readUrl() {
      const q = new URLSearchParams(location.search);
      state.symptom = q.get('symptom') ?? '';
      state.service = q.get('service') ?? '';
      state.hmo = q.get('hmo') ?? '';
      state.area = q.get('area') ?? '';
      state.sort = q.get('sort') ?? 'soonest';
      state.philhealth = q.get('philhealth') === '1';
      state.open = q.get('open') === '1';
      (form.elements.namedItem('service') as HTMLSelectElement).value = state.service;
      (form.elements.namedItem('hmo') as HTMLSelectElement).value = state.hmo;
      (form.elements.namedItem('area') as HTMLSelectElement).value = state.area;
      (form.elements.namedItem('sort') as HTMLSelectElement).value = state.sort;
      (form.elements.namedItem('philhealth') as HTMLInputElement).checked = state.philhealth;
      (form.elements.namedItem('open') as HTMLInputElement).checked = state.open;
    }
    // The selects behind "More filters" on a phone: shown whenever the screen is wider, or one of them is set;
    // the line says how many are set when it is closed.
    const moreFilters = $('[data-filter-more]') as HTMLDetailsElement, moreCount = $('[data-filter-count]')!;
    const narrow = matchMedia('(max-width: 767px)');
    const setCount = () => [state.service, state.hmo, state.area, state.sort !== 'soonest' ? state.sort : ''].filter(Boolean).length;
    narrow.addEventListener('change', () => { if (!narrow.matches) moreFilters.open = true; });
    function writeUrl() {
      const q = new URLSearchParams();
      for (const [k, v] of Object.entries(state)) if (v && v !== 'soonest') q.set(k, v === true ? '1' : String(v));
      history.replaceState(null, '', q.toString() ? `?${q}` : location.pathname);
    }

    function apply() {
      const sym = symButtons.find((b) => b.dataset.symptom === state.symptom);
      symButtons.forEach((b) => b.setAttribute('aria-pressed', String(b === sym)));
      const wanted = state.service ? [state.service] : sym ? sym.dataset.services!.split(',') : [];
      tip.hidden = !sym; if (sym) tipText.textContent = sym.dataset.tip!;
      urgent.hidden = !(sym && sym.dataset.urgency === 'urgent');

      const shown: HTMLElement[] = [];
      for (const li of results) {
        const f = facts.get(li)!;
        const offered = li.dataset.offered!.split(',');
        const minPrice = JSON.parse(li.dataset.minprice!) as Record<string, number | null>;
        let ok = true;
        if (wanted.length && !wanted.some((s) => offered.includes(s))) ok = false;
        if (state.hmo && !li.dataset.hmos!.split(',').includes(state.hmo)) ok = false;
        if (state.area && li.dataset.area !== state.area) ok = false;
        if (state.philhealth && li.dataset.philhealth !== '1') ok = false;
        if (state.open && !f.st.open) ok = false;
        li.hidden = !ok;
        if (!ok) continue;
        shown.push(li);

        // The price line follows the question: the cheapest matching service.
        const priceEl = $('[data-price]', li)!;
        const match = wanted.filter((s) => offered.includes(s));
        const pick = (match.length ? match : ['consultation']).filter((s) => minPrice[s] != null).sort((a, b) => minPrice[a]! - minPrice[b]!)[0];
        const label = $(`option[value="${pick}"]`, form)?.textContent?.replace(/\s*\(.*\)$/, '') ?? 'Consultation';
        priceEl.textContent = minPrice[pick] == null ? `${label}: quoted at consultation` : `${label} from ${peso(minPrice[pick]!)}`;
        (li as any)._sortPrice = minPrice[pick] ?? Number.MAX_SAFE_INTEGER;
      }

      const list = $('[data-results]')!;
      const key = (li: HTMLElement) => {
        const f = facts.get(li)!;
        if (state.sort === 'name') return li.dataset.name!;
        if (state.sort === 'price') return String((li as any)._sortPrice).padStart(12, '0');
        // soonest: clinics with a real slot first, by slot; request-only last
        return f.first ? `0${f.first}` : `1${li.dataset.name}`;
      };
      shown.sort((a, b) => key(a).localeCompare(key(b))).forEach((li) => list.append(li));

      count.textContent = `${shown.length} clinic${shown.length === 1 ? '' : 's'}${state.open ? ' open now' : ''}`;
      const n = setCount(); moreCount.hidden = n === 0; moreCount.textContent = `${n} set`;
      if (empty) empty.hidden = shown.length > 0;
      writeUrl();
    }

    // On a phone the pills are one row that scrolls sideways: a fade on the side where more wait, and
    // the chosen pill brought fully into view (Tab does that by the row's scroll padding). Wider, the row wraps and none of this acts.
    const symRow = $('[data-symptoms]')!;
    const symEdges = () => {
      const max = symRow.scrollWidth - symRow.clientWidth, x = symRow.scrollLeft;
      if (max <= 1) delete symRow.dataset.symEdge;
      else symRow.dataset.symEdge = x <= 1 ? 'right' : x >= max - 1 ? 'left' : 'both';
    };
    const revealChip = (b: HTMLElement, behavior: ScrollBehavior = 'smooth') => {
      const row = symRow.getBoundingClientRect(), r = b.getBoundingClientRect(), pad = 56; // clear of the 3.5rem fade
      if (r.left < row.left + pad) symRow.scrollBy({ left: r.left - row.left - pad, behavior });
      else if (r.right > row.right - pad) symRow.scrollBy({ left: r.right - row.right + pad, behavior });
    };
    symRow.addEventListener('scroll', symEdges, { passive: true });
    addEventListener('resize', symEdges);
    // Tab onto a pill that is partly off the row's edge: the browser leaves it cut, so bring it in.
    symRow.addEventListener('focusin', (e) => { if (e.target instanceof HTMLElement && e.target.matches('.chip:focus-visible')) revealChip(e.target); });

    symButtons.forEach((b) => b.addEventListener('click', () => { state.symptom = state.symptom === b.dataset.symptom ? '' : b.dataset.symptom!; if (state.symptom) state.service = ''; (form.elements.namedItem('service') as HTMLSelectElement).value = ''; apply(); revealChip(b); }));
    form.addEventListener('change', () => {
      const fd = new FormData(form);
      state.service = String(fd.get('service') ?? ''); if (state.service) state.symptom = '';
      state.hmo = String(fd.get('hmo') ?? ''); state.area = String(fd.get('area') ?? ''); state.sort = String(fd.get('sort') ?? 'soonest');
      state.philhealth = fd.get('philhealth') === 'on'; state.open = fd.get('open') === 'on';
      apply();
    });

    readUrl(); apply();
    moreFilters.open = !narrow.matches || setCount() > 0;
    symEdges();
    const chosen = symButtons.find((b) => b.dataset.symptom === state.symptom);
    if (chosen) revealChip(chosen, 'instant');
  </script>
</Base>

<style is:global>
  /* Find a dentist on frosted glass (the owner, 26 Sep: "implement the same" as the clinic sign-up):
     the clinic's waiting area fixed behind the page, compact translucent cards over it, a column
     narrow enough that the room shows on both sides. Every rule here starts with .pt-room or
     .pt-glass, classes only this page has, so the clinic page, the booking, a dentist and coverage
     (which share patient.css) stay exactly as they were.

     The photo: a fixed layer rather than background-attachment: fixed (which iOS ignores), under
     everything in the page's flow (z-index -1, as the workspace's backdrop), so the header and the
     prototype note stand above it. A phone always takes the 960 image (a 3x phone would pick the
     1920 by `sizes`); in the dark the room is dimmed, so light words on the dark glass hold up over
     its white walls. */
  .pt-room {
    position: fixed;
    top: 0;
    left: 0;
    z-index: -1;
    width: 100%;
    height: 100vh;
    height: 100lvh;
    pointer-events: none;
    overflow: hidden;
  }
  .pt-room picture { display: block; width: 100%; height: 100%; }
  .pt-room img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* The bench and the corridor on a phone; the reception desk to the doors on a wide screen. */
    object-position: 42% 50%;
  }
  @media (min-width: 640px) {
    .pt-room img { object-position: 50% 50%; }
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .pt-room img { filter: brightness(0.62) saturate(0.9); }
  }
  :root[data-theme="dark"] .pt-room img { filter: brightness(0.62) saturate(0.9); }
  /* Not on paper, and not under the system's own high-contrast colours, where it would only sit
     behind the words. */
  @media print, (forced-colors: active) {
    .pt-room { display: none; }
  }

  /* The page's glass numbers (the shared tokens stay as they are), the sign-up's: a lighter frost,
     so the room reads as a room through the cards. The site's own names are redrawn for the glass
     here, so the site's chips, buttons, slots and fields keep every state they have and only change
     face: secondary words and small labels two steps darker than --c-ink-2 (the muted grey is too
     light on glass, and on a wide screen the photo's dark doorway sits behind the results); controls on the near-solid glass field with a visible line; links, the eyebrow and the
     keyboard ring in the deep teal. */
  .pt-glass {
    --glass-blur: blur(14px) saturate(1.4);
    --pt-link: #094f4d;
    --pt-name-hover: #073f3e;
    --pt-hair: rgb(16 24 40 / 0.07);
    --pt-rule: rgb(16 24 40 / 0.1);
    --pt-inner: rgb(255 255 255 / 0.5);
    --pt-inner-edge: rgb(255 255 255 / 0.7);
    --pt-box-line: #394556;
    --pt-solid: rgb(255 255 255 / 0.86);
    --c-ink-2: #2f3a4a;
    --c-muted: #2f3a4a;
    --c-surface: var(--glass-field);
    --ws-field: var(--glass-field);
    --ws-field-line: #bcc3cd;
    --ws-field-line-hover: #98a2b3;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .pt-glass {
      --glass-pane: rgb(22 27 33 / 0.58);
      --pt-link: var(--ws-teal-ink);
      --pt-name-hover: var(--ws-teal-ink);
      --pt-hair: rgb(0 0 0 / 0.35);
      --pt-rule: rgb(255 255 255 / 0.12);
      --pt-inner: rgb(255 255 255 / 0.04);
      --pt-inner-edge: rgb(255 255 255 / 0.08);
      --pt-box-line: #aab3bf;
      --pt-solid: rgb(22 27 33 / 0.85);
      --c-ink-2: #c3cad4;
      --c-muted: #c3cad4;
      --ws-field-line: #4a5563;
      --ws-field-line-hover: #64707e;
    }
  }
  :root[data-theme="dark"] .pt-glass {
    --glass-pane: rgb(22 27 33 / 0.58);
    --pt-link: var(--ws-teal-ink);
    --pt-name-hover: var(--ws-teal-ink);
    --pt-hair: rgb(0 0 0 / 0.35);
    --pt-rule: rgb(255 255 255 / 0.12);
    --pt-inner: rgb(255 255 255 / 0.04);
    --pt-inner-edge: rgb(255 255 255 / 0.08);
    --pt-box-line: #aab3bf;
    --pt-solid: rgb(22 27 33 / 0.85);
    --c-ink-2: #c3cad4;
    --c-muted: #c3cad4;
    --ws-field-line: #4a5563;
    --ws-field-line-hover: #64707e;
  }

  /* The keyboard ring in the deep teal: the site's #14908f is under 3:1 on the light glass. The
     selects draw no outline (global.css): from the keyboard their edge turns the same deep teal, 2px
     (the 1px border and a 1px ring), in place of the faint halo, which barely shows on the glass. */
