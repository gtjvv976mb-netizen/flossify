---
// The code we texted. Six digits and the number it went to; a match signs the
// phone in for thirty days and lands on the list of visits.
//
// Guarded like the staff code page: the CSRF token, a limit per number and
// per address, and the code itself dies after five misses (codes.ts). Every
// miss gets the same one sentence, whether the code was wrong, expired, or
// never issued for that number, so the form cannot be used to find out which
// numbers have visits.
//
// The number is never in the address. /me/ leaves it in a 15-minute httpOnly
// cookie sent to this page only; it fills the field and is cleared once the
// code is used. No cookie and the person types the number. Old links that
// carried ?phone= still fill the field for now; nothing makes new ones.
export const prerender = false;

import Door from './_Door.astro';
import Csrf from '../../components/Csrf.astro';
import Icon from '../../components/ws/Icon.astro';
import { readPatientSession, setPatientSession } from '../../lib/patient-auth';
import { csrfOk, CSRF_MESSAGE } from '../../lib/csrf';
import { hit, clientIp, waitText, LIMITS } from '../../lib/throttle';
import { redeemPhoneCode, REDEEM_TEXT } from '../../lib/codes';
import { normalizePhone, PH_MOBILE, prettyPhone } from '../../lib/messages';

if (readPatientSession(Astro.cookies)) return Astro.redirect('/me/visits/', 303);

// Set by /me/ (same name, same path).
const PHONE_COOKIE = 'fl_me_phone', PHONE_COOKIE_PATH = '/me/code';

const sent = Astro.url.searchParams.get('sent') === '1';
const remembered = Astro.cookies.get(PHONE_COOKIE)?.value ?? '';
let typed = prettyPhone(PH_MOBILE.test(remembered) ? remembered : (Astro.url.searchParams.get('phone') ?? ''));
let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  typed = String(form.get('phone') ?? '').trim();
  const phone = normalizePhone(typed);
  const code = String(form.get('code') ?? '').replace(/\D/g, '');
  const ip = clientIp(Astro);
  if (!csrfOk(Astro.cookies, form)) error = CSRF_MESSAGE;
  else if (!PH_MOBILE.test(phone)) error = 'Use a Philippine mobile number, like 0917 000 0000.';
  else {
    const [byPhone, byIp] = await Promise.all([hit(`mecode:p:${phone}`, ...LIMITS.mecode.phone), hit(`mecode:ip:${ip}`, ...LIMITS.mecode.ip)]);
    if (!byPhone.allowed || !byIp.allowed) error = `Too many tries. ${waitText(Math.max(byPhone.retryAfter, byIp.retryAfter))}`;
    else if (code.length !== 6) error = 'Enter the six digits from the text.';
    else {
      const result = await redeemPhoneCode(phone, 'patient', code);
      // One sentence for every miss: the form never says whether a number is known.
      if (result !== 'ok') error = REDEEM_TEXT.wrong;
      else {
        setPatientSession(Astro.cookies, phone);
        // The code is spent: the number now lives in the signed session, not in this cookie.
        Astro.cookies.delete(PHONE_COOKIE, { path: PHONE_COOKIE_PATH });
        return Astro.redirect('/me/visits/', 303);
      }
    }
  }
}
---

<Door title="Enter your code — Flossify" description="Enter the six-digit code we texted to see your visits." step={2}>
  <Fragment slot="head">
    <a href="/me/" class="me-door-back"><Icon name="chevron-left" size={16} />My visits</a>
    <h1 class="me-door-title">Enter your code</h1>
    <p class="me-door-lede">Type the six digits from the text. It works for 15 minutes, and you stay signed in on this phone for a month.</p>
  </Fragment>

  {sent && !error && <p role="status" class="ws-callout me-door-callout" data-tone="success"><Icon name="message" /><span>If that number has visits on Flossify, a code is on its way. It works for 15 minutes.</span></p>}
  {error && <p role="alert" class="ws-callout me-door-callout" data-tone="alert"><Icon name="alert" /><span>{error}</span></p>}

  <form method="post" class="me-door-form me-door-form-code">
    <Csrf />
    <label class="field"><span class="meta">Mobile number</span><input type="tel" name="phone" inputmode="tel" autocomplete="tel" placeholder="0917 000 0000" value={typed} required autofocus={!typed} /></label>
    <label class="field"><span class="meta">Code</span><input type="text" name="code" inputmode="numeric" pattern="[0-9]*" minlength="6" maxlength="6" autocomplete="one-time-code" placeholder="6 digits" required autofocus={!!typed} class="font-mono text-[20px] tracking-[0.2em] tabular-nums placeholder:font-sans placeholder:text-[16px] placeholder:tracking-normal" /></label>
    <button type="submit" class="btn btn-primary me-door-go"><span>See my visits</span><Icon name="arrow-right" /></button>
  </form>

  <div class="me-door-more">
    <a href="/me/" class="me-door-link">Didn’t get a text? Ask again.<Icon name="chevron-right" size={16} /></a>
    <p class="me-door-note">Texts can take a minute to arrive. Asking again voids the earlier code.</p>
  </div>
</Door>

<script>
  // An old link may still carry the number as ?phone=. The field has it now; take it out of the address bar.
  const here = new URL(location.href);
  if (here.searchParams.has('phone')) {
    here.searchParams.delete('phone');
    history.replaceState(history.state, '', here.pathname + here.search + here.hash);
  }
</script>
