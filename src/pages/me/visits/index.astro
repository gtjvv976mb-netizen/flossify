---
// The list. Every visit under this mobile number, at every clinic on
// Flossify, read through patient_visits() (migration 010): the function runs
// as its owner because a patient has no tenant, and matches on the phone and
// nothing else. Coming up first, then past; a cancelled visit stays for
// thirty days with the word Cancelled on it.
//
// Two things a person can do from here, both through patient_act(): confirm
// a booked visit, and cancel one more than two hours ahead. Cancelling is two
// steps with no script — the first post asks, the page shows "Cancel this
// visit?" on that row, the second post does it — so a slip of the thumb
// keeps the chair. Every post carries the CSRF token; a miss comes back with
// ?stale=1 and the sentence to try again. Moving a visit is a phone call:
// the clinic's number is on the row.
//
// Drawn in the soft template, in the workspace's sidebar pattern (_Shell.astro): each visit a row
// on a white card — a small calendar leaf, the clinic, what for and with whom, a status pill in
// words, and its actions.
export const prerender = false;

import Shell from '../_Shell.astro';
import Csrf from '../../../components/Csrf.astro';
import Pane from '../../../components/ws/Pane.astro';
import Icon from '../../../components/ws/Icon.astro';
import Empty from '../../../components/ws/Empty.astro';
import { readPatientSession } from '../../../lib/patient-auth';
import { publicRead } from '../../../lib/db';
import { csrfOk, CSRF_MESSAGE } from '../../../lib/csrf';
import { prettyPhone } from '../../../lib/messages';

const session = readPatientSession(Astro.cookies);
if (!session) return Astro.redirect('/me/', 303);
const phone = session.phone;

interface Visit {
  appointment_id: string; clinic_id: string; clinic_name: string; clinic_slug: string; clinic_phone: string | null; clinic_area: string | null;
  dentist: string | null; starts_at: Date; ends_at: Date; reason: string | null; status: string; source: string; public_ref: string | null;
  /** False only while a request is still waiting for the clinic to set a time (migration 018). */
  placed: boolean;
  patient_name: string; booked_by_name: string | null; created_at: Date;
}

const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
let notice = '';
let error = Astro.url.searchParams.get('stale') === '1' ? CSRF_MESSAGE : '';
// The row whose "Cancel this visit?" question is open, after the first of the two posts.
let asking = '';

if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  if (!csrfOk(Astro.cookies, f)) return Astro.redirect('/me/visits/?stale=1', 303);
  const act = String(f.get('act') ?? '');
  const id = String(f.get('id') ?? '');
  if (!UUID.test(id)) error = 'That visit could not be found. The list below is current.';
  else if (act === 'ask-cancel') asking = id;
  else if (act === 'confirm' || act === 'cancel') {
    const r = (await publicRead<{ ok: boolean; message: string }>('select ok, message from patient_act($1, $2, $3)', [phone, id, act]))[0];
    if (r?.ok) notice = r.message;
    else error = r?.message ?? 'Nothing was changed. The list below is current.';
  } else error = 'Nothing was changed. The list below is current.';
}

const visits = await publicRead<Visit>('select * from patient_visits($1)', [phone]);
const now = Date.now();
// Soonest first ahead; most recent first behind.
const upcoming = visits.filter((v) => v.starts_at.getTime() >= now).sort((a, b) => a.starts_at.getTime() - b.starts_at.getTime());
const past = visits.filter((v) => v.starts_at.getTime() < now);

// "Thu 24 Sep, 9:00 am", Manila time, composed from parts: the locale strings put the comma and the case elsewhere.
const parts = (d: Date, opts: Intl.DateTimeFormatOptions) =>
  Object.fromEntries(new Intl.DateTimeFormat('en-US', { ...opts, timeZone: 'Asia/Manila' }).formatToParts(d).map((p) => [p.type, p.value]));
const time = (d: Date) => { const p = parts(d, { hour: 'numeric', minute: '2-digit' }); return `${p.hour}:${p.minute} ${p.dayPeriod.toLowerCase()}`; };
const when = (d: Date) => { const p = parts(d, { weekday: 'short', day: 'numeric', month: 'short' }); return `${p.weekday} ${p.day} ${p.month}, ${time(d)}`; };
const yearOf = (d: Date) => parts(d, { year: 'numeric' }).year;
const thisYear = yearOf(new Date());

// Status in plain words, never colour alone: a pill with the word on a pale tint of its colour
// (the tint's own ink, 5.3:1 and more), and one line under it when the word needs one.
type Tint = 'teal' | 'green' | 'amber' | 'blue' | 'red' | 'slate';
function statusOf(v: Visit): { label: string; tint: Tint; hint?: string } {
  const ahead = v.starts_at.getTime() > now;
  switch (v.status) {
    case 'booked':
      if (!v.placed) return { label: 'Requested', tint: ahead ? 'blue' : 'slate', hint: ahead ? 'The clinic will confirm a time.' : undefined };
      return ahead ? { label: 'Please confirm', tint: 'amber' } : { label: 'Booked', tint: 'slate' };
    case 'confirmed': return { label: 'Confirmed', tint: 'green' };
    case 'arrived': case 'in_lobby': case 'in_chair': return { label: 'At the clinic', tint: 'teal' };
    case 'completed': return { label: 'Done', tint: 'slate' };
    case 'no_show': return { label: 'Missed', tint: 'red' };
    case 'cancelled': return { label: 'Cancelled', tint: 'slate' };
    default: return { label: v.status, tint: 'slate' };
  }
}
const isAhead = (v: Visit) => v.starts_at.getTime() > now && (v.status === 'booked' || v.status === 'confirmed');
// A request has no agreed time yet, so there is nothing to confirm; the clinic texts one first.
const canConfirm = (v: Visit) => isAhead(v) && v.status === 'booked' && v.placed;

// The calendar file, same shape as the booking page writes: local Manila time, one event, the reference in the notes.
const stamp = (d: Date) => { const p = parts(d, { year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', second: '2-digit', hourCycle: 'h23' }); return `${p.year}${p.month}${p.day}T${p.hour}${p.minute}${p.second}`; };
const esc = (s: string) => s.replace(/([\\,;])/g, '\\$1').replace(/\r?\n/g, ' ');
function ics(v: Visit): string {
  const lines = ['BEGIN:VCALENDAR', 'VERSION:2.0', 'PRODID:-//Flossify//Visit//EN', 'BEGIN:VEVENT',
    `UID:${v.appointment_id}@flossify`, `DTSTAMP:${new Date().toISOString().replace(/[-:]/g, '').replace(/\.\d+/, '')}`,
    `DTSTART;TZID=Asia/Manila:${stamp(v.starts_at)}`, `DTEND;TZID=Asia/Manila:${stamp(v.ends_at)}`,
    `SUMMARY:${esc(`Dentist — ${v.clinic_name}`)}`,
    `DESCRIPTION:${esc([v.reason, v.dentist ? `with ${v.dentist}` : '', v.public_ref ? `Ref ${v.public_ref}.` : ''].filter(Boolean).join(' '))}`,
    `LOCATION:${esc([v.clinic_name, v.clinic_area].filter(Boolean).join(', '))}`, 'END:VEVENT', 'END:VCALENDAR'];
  return 'data:text/calendar;charset=utf-8,' + encodeURIComponent(lines.join('\r\n'));
}
const tel = (s: string) => `tel:${s.replace(/[^\d+]/g, '')}`;
// The calendar leaf on each row: "Thu" · "24" · "Sep" (and the year when it is not this one).
const leaf = (d: Date) => parts(d, { weekday: 'short', day: 'numeric', month: 'short' });
const what = (v: Visit) => [v.reason, v.dentist ? `with ${v.dentist}` : ''].filter(Boolean).join(' ') || 'Visit';
const forWhom = (v: Visit) => `For ${v.patient_name}${v.booked_by_name && v.booked_by_name !== v.patient_name ? ` · booked by ${v.booked_by_name}` : ''}`;
const count = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;
const who = prettyPhone(phone);
---

<Shell title="My visits" description="Your visits at every clinic on Flossify, under your mobile number. Confirm, cancel, or add one to your calendar." phone={phone}>
  {notice && !error && (
    <p role="status" class="ws-callout" data-tone="success"><Icon name="check" /><span>{notice}</span></p>
  )}
  {error && (
    <p role="alert" class="ws-callout" data-tone="alert"><Icon name="alert" /><span>{error}</span></p>
  )}

  {visits.length === 0 ? (
    <Pane title="No visits yet" icon="calendar" meta={`Under ${who}`}>
      <p class="ws-lede">No visits under this number yet. When you book on <a href="/find/" class="font-semibold text-teal-ink underline underline-offset-4">Find a clinic</a> with it, they show here.</p>
      <a href="/find/" class="ws-btn ws-btn-primary mt-5"><Icon name="search" />Find a clinic</a>
    </Pane>
  ) : (
    <>
      <Pane id="coming-up" title="Coming up" icon="calendar" meta={`Under ${who}, at every clinic on Flossify`} pad="none">
        <span slot="actions" class="ws-pill ws-tint-slate">{count(upcoming.length, 'visit', 'visits')}</span>
        {upcoming.length === 0 ? (
          <div class="px-6 py-3 max-md:px-4">
            <Empty icon="calendar" text="Nothing booked ahead." action={{ label: 'Find a clinic', href: '/find/' }} />
          </div>
        ) : (
          <ul class="me-visits" role="list">
            {upcoming.map((v) => {
              const s = statusOf(v);
              const d = leaf(v.starts_at);
              const quiet = v.status === 'cancelled';
              return (
                <li class="me-visit">
                  <p class="me-leaf" data-quiet={quiet ? '' : undefined}>
                    <span class="me-leaf-wd">{d.weekday}</span>
                    <span class="me-leaf-day">{d.day}</span>
                    <span class="me-leaf-mo">{d.month}{yearOf(v.starts_at) !== thisYear && <> {yearOf(v.starts_at)}</>}</span>
                  </p>
                  <div class="me-visit-body">
                    <div class="me-visit-head">
                      <div class="min-w-0">
                        <p class="me-visit-when">{time(v.starts_at)} <span class="font-normal text-ink-2">&middot;</span> <a href={`/find/${v.clinic_slug}/`} class="me-clinic">{v.clinic_name}</a></p>
                        <p class="me-visit-what">{what(v)}{v.clinic_area && <> &middot; {v.clinic_area}</>}</p>
                      </div>
                      <span class:list={['ws-pill', `ws-tint-${s.tint}`]}>{s.label}</span>
                    </div>
                    <p class="me-visit-who">{forWhom(v)}{v.public_ref && <> &middot; Ref <span class="font-mono text-[13px]">{v.public_ref}</span></>}</p>
                    {s.hint && <p class="me-visit-hint"><Icon name="clock" size={16} />{s.hint}</p>}

                    {isAhead(v) && (asking === v.appointment_id ? (
                      <div class="ws-callout me-ask" data-tone="warn" role="group" aria-label={`Cancel your visit on ${when(v.starts_at)}?`}>
                        <Icon name="alert" />
                        <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
                          <p class="font-semibold">Cancel this visit?</p>
                          <form method="post">
                            <Csrf />
                            <input type="hidden" name="act" value="cancel" />
                            <input type="hidden" name="id" value={v.appointment_id} />
                            <button type="submit" class="ws-btn ws-btn-danger ws-btn-sm" autofocus>Yes, cancel</button>
                          </form>
                          <a href="/me/visits/" class="ws-btn ws-btn-quiet ws-btn-sm">Keep it</a>
                        </div>
                      </div>
                    ) : (
                      <div class="me-actions">
                        {canConfirm(v) && (
                          <form method="post">
                            <Csrf />
                            <input type="hidden" name="act" value="confirm" />
                            <input type="hidden" name="id" value={v.appointment_id} />
                            <button type="submit" class="ws-btn ws-btn-primary ws-btn-sm"><Icon name="check" />Confirm</button>
                          </form>
                        )}
                        <form method="post">
                          <Csrf />
                          <input type="hidden" name="act" value="ask-cancel" />
                          <input type="hidden" name="id" value={v.appointment_id} />
                          <button type="submit" class="ws-btn ws-btn-quiet ws-btn-sm">Cancel</button>
                        </form>
                        <a href={ics(v)} download="flossify-visit.ics" class="ws-btn ws-btn-quiet ws-btn-sm"><Icon name="calendar" />Add to calendar</a>
                        {v.clinic_phone && <a href={tel(v.clinic_phone)} class="ws-btn ws-btn-quiet ws-btn-sm">Call to move it</a>}
                      </div>
                    ))}
                    {isAhead(v) && asking !== v.appointment_id && v.clinic_phone && (
                      <p class="me-visit-note">Cancel here up to two hours before. Closer than that, call {v.clinic_phone}.</p>
                    )}
                  </div>
                </li>
              );
            })}
          </ul>
        )}
      </Pane>

      <Pane id="past" title="Past" icon="clock" pad="none">
        <span slot="actions" class="ws-pill ws-tint-slate">{count(past.length, 'visit', 'visits')}</span>
        {past.length === 0 ? (
          <div class="px-6 py-3 max-md:px-4">
            <Empty icon="clock" text="No past visits under this number." />
          </div>
        ) : (
          <ul class="me-visits" role="list">
            {past.map((v) => {
              const s = statusOf(v);
              const d = leaf(v.starts_at);
              return (
                <li class="me-visit">
                  <p class="me-leaf" data-quiet="">
                    <span class="me-leaf-wd">{d.weekday}</span>
                    <span class="me-leaf-day">{d.day}</span>
                    <span class="me-leaf-mo">{d.month}{yearOf(v.starts_at) !== thisYear && <> {yearOf(v.starts_at)}</>}</span>
                  </p>
                  <div class="me-visit-body">
                    <div class="me-visit-head">
                      <div class="min-w-0">
                        <p class="me-visit-when">{time(v.starts_at)} <span class="font-normal text-ink-2">&middot;</span> <a href={`/find/${v.clinic_slug}/`} class="me-clinic">{v.clinic_name}</a></p>
                        <p class="me-visit-what">{what(v)}{v.clinic_area && <> &middot; {v.clinic_area}</>}</p>
                      </div>
                      <span class:list={['ws-pill', `ws-tint-${s.tint}`]}>{s.label}</span>
                    </div>
                    <p class="me-visit-who">{forWhom(v)}{v.public_ref && <> &middot; Ref <span class="font-mono text-[13px]">{v.public_ref}</span></>}</p>
                  </div>
                </li>
              );
            })}
          </ul>
        )}
      </Pane>
    </>
  )}

  <p class="ws-callout" data-tone="info"><Icon name="info" /><span>We keep this list for the mobile number only; the clinic’s records stay with the clinic.</span></p>
</Shell>

<style>
  @layer components {
    /* One visit: a calendar leaf, then who, what and when, its status in words, and its actions. */
    .me-visits > li + li { border-top: 1px solid var(--ws-hair); }
    .me-visit { display: flex; align-items: flex-start; gap: 1rem; padding: 1.25rem 1.5rem; }
    .me-leaf {
      display: grid; justify-items: center; align-content: center; flex: none; width: 3.75rem; min-height: 4.5rem; padding: 0.375rem 0.25rem;
      border-radius: var(--ws-r); background: var(--ws-teal-tint); color: var(--ws-teal-ink); text-align: center; line-height: 1.15;
    }
    .me-leaf[data-quiet] { background: var(--c-bg-soft); color: var(--c-ink-2); }
    .me-leaf-wd, .me-leaf-mo { font-size: 12.5px; font-weight: 600; }
    .me-leaf-day { font-size: 22px; font-weight: 650; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
    .me-visit-body { flex: 1 1 auto; min-width: 0; }
    .me-visit-head { display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: 0.375rem 0.75rem; }
    .me-visit-when { font-size: 16px; font-weight: 600; line-height: 1.35; color: var(--c-ink); font-variant-numeric: tabular-nums; }
    .me-clinic { color: var(--c-ink); text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 4px; transition: color 160ms ease, text-decoration-color 160ms ease; }
    .me-clinic:hover { color: var(--ws-teal-ink); text-decoration-color: currentColor; }
    .me-visit-what { margin-top: 0.125rem; font-size: 15px; line-height: 1.45; color: var(--c-ink-2); }
    .me-visit-who { margin-top: 0.25rem; font-size: 13.5px; line-height: 1.45; color: var(--c-muted); }
    .me-visit-hint { display: flex; align-items: center; gap: 0.375rem; margin-top: 0.5rem; font-size: 14px; color: var(--ws-blue-ink); }
    .me-visit-hint :global(.ws-icon) { flex: none; }
    .me-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; margin-top: 0.875rem; }
    .me-ask { margin-top: 0.875rem; }
    .me-visit-note { margin-top: 0.5rem; font-size: 13.5px; line-height: 1.45; color: var(--c-muted); }
    /* A phone: the leaf beside who and what, and the actions across the whole row under them, so
       two buttons fit side by side. */
    @media (max-width: 767px) {
      .me-visit { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 0 0.75rem; padding: 1rem; }
      .me-visit-body { display: contents; }
      .me-leaf { grid-row: span 3; align-self: start; width: 3.25rem; min-height: 4rem; }
      .me-leaf-day { font-size: 20px; }
      .me-visit-head, .me-visit-who, .me-visit-hint { grid-column: 2; }
      .me-actions, .me-ask, .me-visit-note { grid-column: 1 / -1; }
    }
  }
</style>
