---
// The way into My visits (/me/ and /me/code/), on frosted glass like Find a clinic and the clinic
// sign-up (the owner, 26 Sep: "still not changed" → the same look): the patients' top bar, the
// clinic's waiting area fixed behind the page (the room the signed-in list stands in too, so the
// patient side is one place), and over it compact translucent cards — the page's heading in its own
// small card (the "head" slot), the form under it (the default slot), and beside them from 1024px
// (under them before) a card that says how it works in three numbered steps, the step the person
// is on marked — a friendly stepper, like the booking's. No password and no account: a mobile number
// and a texted code.
//
//   <Door title="My visits — Flossify" description="…" step={1}>
//     <Fragment slot="head">…eyebrow, h1, lede…</Fragment>
//     …the form card's contents…
//   </Door>
import Base from '../../layouts/Base.astro';
import PatientHeader from '../../components/PatientHeader.astro';
import Icon from '../../components/ws/Icon.astro';

interface Props {
  title: string;
  description: string;
  /** Which step of the three this page is: 1 the number, 2 the code. */
  step: 1 | 2;
}
const { title, description, step } = Astro.props;

// Truthful to the letter: a code is texted only when a clinic on Flossify knows the number (me/index.astro).
const STEPS = [
  { title: 'Your mobile number', text: 'The one you booked with. No account and no password.' },
  { title: 'A six-digit code', text: 'If the number has visits on Flossify, we text it a code. It works for 15 minutes.' },
  { title: 'Your visits', text: 'At every clinic on Flossify: confirm, cancel, or add one to your calendar. You stay signed in on this phone for a month.' },
];
---

<Base title={title} description={description}>
  <PatientHeader current="me" />

  <!-- The clinic's waiting area, fixed to the screen under the glass cards (Find a clinic's
       technique and photo; a phone always takes the 960 image). Decorative. -->
  <div class="me-room" aria-hidden="true">
    <picture>
      <source media="(max-width: 639px)" srcset="/img/ws/waiting-960.webp" />
      <img src="/img/ws/waiting-1920.webp" srcset="/img/ws/waiting-960.webp 960w, /img/ws/waiting-1920.webp 1920w" sizes="100vw" alt="" width="1920" height="1080" decoding="async" fetchpriority="high" />
    </picture>
  </div>

  <main id="main" class="me-door">
    <div class="me-door-grid">
      <div class="me-door-col">
        <header class="me-door-glass me-door-intro">
          <slot name="head" />
        </header>
        <div class="me-door-glass me-door-card">
          <slot />
        </div>
      </div>

      <aside class="me-door-glass me-door-how" aria-labelledby="door-how">
        <div class="me-door-how-head">
          <span class="me-door-how-mark" aria-hidden="true"><Icon name="message" size={18} /></span>
          <h2 id="door-how">How it works</h2>
        </div>
        <ol class="door-steps" role="list">
          {STEPS.map((s, i) => {
            const n = i + 1;
            const state = n < step ? 'done' : n === step ? 'now' : 'ahead';
            return (
              <li class="door-step" data-state={state} aria-current={state === 'now' ? 'step' : undefined}>
                <span class="door-no" aria-hidden="true">{state === 'done' ? <Icon name="check" size={15} /> : n}</span>
                <span class="min-w-0">
                  <span class="door-step-title">{s.title}{state === 'done' && <span class="sr-only"> (done)</span>}</span>
                  <span class="door-step-text">{s.text}</span>
                </span>
              </li>
            );
          })}
        </ol>
        <p class="me-door-how-foot">
          Nothing booked yet? <a href="/find/" class="me-door-link-inline">Find a clinic</a> and book with your mobile; the visit shows here after.
        </p>
      </aside>
    </div>
  </main>
</Base>

<style is:global>
  /* My visits' door on frosted glass. Every rule here starts with .me-room or .me-door, classes only
     these two pages have, so no other page can match.

     The photo: a fixed layer rather than background-attachment: fixed (which iOS ignores), under
     everything in the page's flow (z-index -1), so the top bar and the prototype note stand above
     it. In the dark the room is dimmed, so light words on the dark glass hold up over its white
     walls. Not on paper, and not under the system's own high-contrast colours. */
  .me-room {
    position: fixed;
    top: 0;
    left: 0;
    z-index: -1;
    width: 100%;
    height: 100vh;
    height: 100lvh;
    pointer-events: none;
    overflow: hidden;
  }
  .me-room picture { display: block; width: 100%; height: 100%; }
  .me-room img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* The bench and the corridor on a phone; the reception desk to the doors on a wide screen. */
    object-position: 42% 50%;
  }
  @media (min-width: 640px) {
    .me-room img { object-position: 50% 50%; }
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .me-room img { filter: brightness(0.62) saturate(0.9); }
  }
  :root[data-theme="dark"] .me-room img { filter: brightness(0.62) saturate(0.9); }
  @media print, (forced-colors: active) {
    .me-room { display: none; }
  }

  /* The door's glass numbers (the shared tokens stay as they are), Find a clinic's and the sign-up's:
     a lighter frost, so the room reads as a room through the cards. The site's own names are redrawn
     for the glass inside the door only, so the field, the button and the callouts keep every state
     they have and only change face: secondary words and small labels in a deeper slate (the muted
     grey is too light on glass), the field on the near-solid glass face with a visible line, links,
     the eyebrow and the keyboard ring in the deep teal (a step deeper than Find a clinic's: on a
     tablet the corridor's dark doorway sits right behind How it works, measured 5:1 there). */
  .me-door {
    --glass-blur: blur(14px) saturate(1.4);
    --me-link: #073f3e;
    --me-hair: rgb(16 24 40 / 0.07);
    --me-rule: rgb(16 24 40 / 0.1);
    --me-step-line: rgb(16 24 40 / 0.16);
    --me-solid: rgb(255 255 255 / 0.86);
    --me-placeholder: #5b6677;
    --c-ink-2: #2f3a4a;
    --c-muted: #2f3a4a;
    --c-surface: var(--glass-field);
    --ws-field: var(--glass-field);
    --ws-field-line: #bcc3cd;
    --ws-field-line-hover: #98a2b3;
    --ws-hair: var(--me-rule);
    --ws-teal-ink: #094f4d;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .me-door {
      --glass-pane: rgb(22 27 33 / 0.58);
      --me-link: #7fdcd4;
      --me-hair: rgb(0 0 0 / 0.35);
      --me-rule: rgb(255 255 255 / 0.12);
      --me-step-line: rgb(255 255 255 / 0.2);
      --me-solid: rgb(22 27 33 / 0.85);
      --me-placeholder: #9ea8b6;
      --c-ink-2: #c3cad4;
      --c-muted: #c3cad4;
      --ws-field-line: #4a5563;
      --ws-field-line-hover: #64707e;
      --ws-teal-ink: #7fdcd4;
    }
  }
  :root[data-theme="dark"] .me-door {
    --glass-pane: rgb(22 27 33 / 0.58);
    --me-link: #7fdcd4;
    --me-hair: rgb(0 0 0 / 0.35);
    --me-rule: rgb(255 255 255 / 0.12);
    --me-step-line: rgb(255 255 255 / 0.2);
    --me-solid: rgb(22 27 33 / 0.85);
    --me-placeholder: #9ea8b6;
    --c-ink-2: #c3cad4;
    --c-muted: #c3cad4;
    --ws-field-line: #4a5563;
    --ws-field-line-hover: #64707e;
    --ws-teal-ink: #7fdcd4;
  }

  /* The keyboard ring in the deep teal: the site's #14908f is under 3:1 on the light glass. A field
     draws no outline (global.css): focused, its edge turns the same deep teal, 2px (the border and a
     1px ring), with the soft halo outside it. */
  .me-door :focus-visible { outline-color: var(--me-link); }
  .me-door .field :is(input, select):focus-visible { outline: none; }
  .me-door .field :is(input, select):focus {
    border-color: var(--me-link);
    box-shadow: 0 0 0 1px var(--me-link), 0 0 0 4px color-mix(in srgb, var(--ws-teal) 22%, transparent);
  }

  /* A column about 920px wide, so the room shows on both sides. On a phone the sign-up's gutters
     and its wider gap, so the room shows between the cards too. */
  .me-door {
    max-width: calc(57.5rem + 2.5rem);
    margin-inline: auto;
    padding: 1rem 1.25rem 2rem;
  }
  @media (min-width: 640px) {
    .me-door { padding-top: 1.25rem; }
  }
  .me-door-grid { display: grid; align-items: start; gap: 1rem; }
  .me-door-col { display: grid; gap: 1rem; min-width: 0; }
  @media (min-width: 640px) {
    .me-door-grid, .me-door-col { gap: 0.75rem; }
  }
  @media (min-width: 1024px) {
    .me-door-grid { grid-template-columns: minmax(0, 1fr) 19rem; gap: 0.875rem; }
  }

  /* Frosted glass: the room shows through, blurred. */
  .me-door .me-door-glass {
    background: var(--glass-pane);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    border: 1px solid var(--glass-edge);
    border-radius: var(--ws-r-lg);
    box-shadow: 0 0 0 1px var(--me-hair), var(--glass-shadow);
    padding: 0.875rem;
  }
  @media (min-width: 640px) {
    .me-door .me-door-glass { padding: 1rem 1.125rem; }
  }
  /* Where a browser draws no frost, the room would sit sharp behind the words: a near-solid pane. */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .me-door .me-door-glass { background: var(--me-solid); }
  }

  /* The heading, in its own small card: the calendar mark beside the eyebrow and the title (or, on
     the code step, the way back above the title), the one line under. */
  .me-door .me-door-head { display: flex; align-items: center; gap: 0.75rem; }
  .me-door .me-door-mark {
    display: inline-flex; align-items: center; justify-content: center; flex: none;
    width: 2.5rem; height: 2.5rem; border-radius: var(--ws-r-ctl);
    background: var(--ws-teal-tint); color: var(--ws-teal-ink);
  }
  .me-door .me-door-eyebrow { font-size: 13px; font-weight: 600; line-height: 1.4; color: var(--me-link); }
  /* The way back keeps a 44px target, pulled into the card's padding above and a little into the gap
     below, so its words sit close over the title. Its keyboard ring is drawn inside that box (the
     box has about 13px of air over and under the words), so it never runs across the title. */
  .me-door .me-door-back {
    display: inline-flex; align-items: center; gap: 0.25rem; min-height: 44px; margin: -0.625rem 0 -0.125rem -0.375rem; padding: 0 0.5rem 0 0.25rem;
    border-radius: var(--ws-r-ctl); font-size: 13.5px; font-weight: 600; line-height: 1.3; color: var(--me-link);
    text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 4px;
    transition: text-decoration-color 160ms ease;
  }
  .me-door .me-door-back:hover { text-decoration-color: currentColor; }
  .me-door .me-door-back:focus-visible { outline-offset: -2px; }
  .me-door .me-door-title {
    margin-top: 0.125rem;
    font-size: clamp(1.5rem, 3.2vw, 1.9rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--c-ink);
  }
  .me-door .me-door-lede { max-width: 60ch; margin-top: 0.375rem; font-size: 15px; line-height: 1.5; color: var(--c-ink-2); text-wrap: pretty; }

  /* The form card: the answer to the last post first (on its solid tint), then the field and the one
     teal button side by side from 640px (stacked, the button full width, on a phone), then the other
     way in under a faint rule. */
  .me-door .me-door-callout { margin-bottom: 0.75rem; padding: 0.625rem 0.875rem; font-size: 14.5px; }
  .me-door .me-door-form { display: grid; gap: 0.625rem 0.75rem; align-items: end; }
  /* The code step: the number and the code side by side from 360px, the button under them; from
     640px all three in one row. On a phone the code gets just what its six digits need (124px: the
     mono face at 20px, spaced, and the field's padding) and the number all the rest, with a
     slightly narrower gap, so a number typed the long way, "+63 917 555 0142", still shows whole on
     a 360px phone. */
  @media (min-width: 360px) and (max-width: 639px) {
    .me-door .me-door-form-code { grid-template-columns: minmax(0, 1fr) 7.625rem; column-gap: 0.5rem; }
    .me-door .me-door-form-code > .me-door-go { grid-column: 1 / -1; }
  }
  @media (min-width: 640px) {
    .me-door .me-door-form { grid-template-columns: minmax(0, 22rem) auto; justify-content: start; }
    .me-door .me-door-form-code { grid-template-columns: minmax(0, 1fr) minmax(0, 10.5rem) auto; justify-content: stretch; }
  }
  .me-door .field { gap: 0.25rem; }
  .me-door .field > .meta:first-child { font-size: 13.5px; font-weight: 500; color: var(--c-ink); }
  .me-door .field input { height: 44px; min-height: 44px; padding: 0.5rem 0.75rem; line-height: 1.5rem; }
  .me-door .field input::placeholder { color: var(--me-placeholder); }
  /* The code is typed in the mono face at 20px; while it is empty the field is in the page's own face,
     so "6 digits" sits on the same line as the number's placeholder beside it. */
  .me-door .field input[name="code"]:placeholder-shown { font-family: inherit; font-size: 16px; letter-spacing: normal; }
  .me-door .me-door-go { width: 100%; min-height: 44px; padding: 0.5rem 1.125rem; white-space: nowrap; }
  @media (min-width: 640px) {
    .me-door .me-door-go { width: auto; }
  }
  .me-door .me-door-more { margin-top: 0.75rem; padding-top: 0.25rem; border-top: 1px solid var(--me-rule); }
  /* The other way in: a 44px target, its words still in line with the card's (a little padding
     each side, taken back by the margin), and its keyboard ring drawn inside the box, so on the code
     step it stays clear of the note under it. */
  .me-door .me-door-link {
    display: inline-flex; align-items: center; gap: 0.375rem; min-height: 44px; margin-inline: -0.375rem; padding-inline: 0.375rem;
    border-radius: var(--ws-r-ctl); font-size: 14.5px; font-weight: 600; line-height: 1.3; color: var(--me-link);
    text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 4px;
    transition: text-decoration-color 160ms ease;
  }
  .me-door .me-door-link:hover { text-decoration-color: currentColor; }
  .me-door .me-door-link:focus-visible { outline-offset: -2px; }
  .me-door .me-door-note { font-size: 13.5px; line-height: 1.45; color: var(--c-ink-2); }

  /* How it works: a small card beside the form (under it before 1024px), the sign-up's "What
     happens next". Three steps down a thin line: the number in a circle — outlined ahead, teal with
     white figures on the step you are on, a teal check on a step done (the booking stepper's own
     marks). */
  .me-door .me-door-how { padding: 0.875rem 1rem; }
  .me-door .me-door-how-head { display: flex; align-items: center; gap: 0.5rem; }
  .me-door .me-door-how-mark {
    display: inline-flex; align-items: center; justify-content: center; flex: none;
    width: 1.875rem; height: 1.875rem; border-radius: var(--ws-r-ctl);
    background: var(--ws-teal-tint); color: var(--ws-teal-ink);
  }
  .me-door .me-door-how-head h2 { font-size: 15.5px; line-height: 1.3; letter-spacing: -0.01em; color: var(--c-ink); }
  .me-door .door-steps { display: grid; margin-top: 0.75rem; }
  .me-door .door-step { position: relative; display: grid; grid-template-columns: 1.75rem minmax(0, 1fr); gap: 0.625rem; padding-bottom: 0.75rem; }
  .me-door .door-step:last-child { padding-bottom: 0; }
  .me-door .door-step:not(:last-child)::before {
    content: ""; position: absolute; left: calc(0.875rem - 1px); top: 2rem; bottom: 0.25rem; width: 2px; border-radius: 2px; background: var(--me-step-line);
  }
  .me-door .door-step[data-state="done"]:not(:last-child)::before { background: color-mix(in srgb, var(--ws-teal) 55%, transparent); }
  .me-door .door-no {
    display: inline-flex; align-items: center; justify-content: center; width: 1.75rem; height: 1.75rem; border-radius: var(--ws-r-pill);
    background: var(--glass-field); color: var(--c-ink-2); box-shadow: inset 0 0 0 1px var(--ws-field-line-hover);
    font-size: 13px; font-weight: 600; font-variant-numeric: tabular-nums;
  }
  .me-door .door-step[data-state="now"] .door-no { background: var(--ws-teal-fill); color: #fff; box-shadow: none; }
  .me-door .door-step[data-state="done"] .door-no { background: var(--ws-teal-tint); color: var(--ws-teal-ink); box-shadow: none; }
  .me-door .door-step-title { display: block; padding-top: 0.25rem; font-size: 14.5px; font-weight: 600; line-height: 1.35; color: var(--c-ink); }
  .me-door .door-step[data-state="ahead"] .door-step-title { color: var(--c-ink-2); }
  .me-door .door-step-text { display: block; margin-top: 0.0625rem; font-size: 13.5px; line-height: 1.45; color: var(--c-ink-2); text-wrap: pretty; }
  .me-door .me-door-how-foot {
    margin-top: 0.75rem; padding-top: 0.625rem; border-top: 1px solid var(--me-rule);
    font-size: 13.5px; line-height: 1.45; color: var(--c-ink-2);
  }
  .me-door .me-door-link-inline { font-weight: 600; color: var(--me-link); text-decoration: underline; text-underline-offset: 3px; }
</style>
