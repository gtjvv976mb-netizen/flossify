    .home-link:hover { text-decoration-color: currentColor; }
    .home-link :global(.ws-icon) { flex: none; transition: transform 180ms ease; }
    .home-link:hover :global(.ws-icon) { transform: translateX(3px); }

    /* The keyboard ring on the glass: the link teal, not the bright teal. The site's ring (#14908f)
       was 3.9:1 on the old white card but under 3:1 on the translucent glass over the film's darker
       rooms; the deep link teal (light) and the pale one (dark) keep it well clear of 3:1. Unlayered
       like the site's own ring, so this wins by specificity. */
    .pane-glass :global(:focus-visible) { outline-color: var(--pane-link); }

    /* --- a card on the glass: lighter glass, a light edge, no blur of its own ------------------- */
    .home-feats, .home-step, .home-price-card, .home-partner, .home-way, .home-member {
      border: 1px solid var(--pane-edge); border-radius: var(--ws-r); background: var(--pane-inner);
    }

    /* --- services: compact rows, each side of the chair one lighter glass list -------------------
