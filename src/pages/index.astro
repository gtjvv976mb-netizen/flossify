---
import Base from '../layouts/Base.astro';
import { ROOM_FROM } from '../data/film';
import { TEAM } from '../data/team';
import { PRICE_PER_BRANCH } from '../lib/billing';
import { loadDirectory, type DbListing } from '../lib/directory-db';

// Server-rendered: the Partners page lists the clinics that are really on
// Flossify today, from the same directory patients search.
export const prerender = false;

let partners: DbListing[] = [];
try {
  partners = await loadDirectory();
} catch {
  /* the database is unreachable: the page still renders, without the list */
}

// The rooms. Four, one per room of the film, each pinned to the moment the
// footage arrives there (fractions of the take, read off a frame sheet), so
// the header can never name a room the camera is not in. The whole page is
// the walk: the top of the document is the pavement, the last page the chair.
const stops = [
  { at: '08:55', from: ROOM_FROM.outside, label: 'Outside', body: 'The clinic from the street.' },
  { at: '09:00', from: ROOM_FROM.reception, label: 'Reception', body: 'The front desk, with the day list open.' },
  { at: '09:12', from: ROOM_FROM.corridor, label: 'The corridor', body: 'On the way to the chair.' },
  { at: '09:15', from: ROOM_FROM.chair, label: 'The chair', body: 'The treatment room.' },
];

// 02 — what Flossify does, for each side of the chair. Only what the product
// does today: every line here is a screen a clinic or a patient can open.
// Billing, health history and desk consent join these lists (and 04's) the
// day those features are live, not before.
const forClinics = [
  { title: 'Online booking', body: 'Your clinic page on Find a clinic. Patients book a real open slot, or send a request, day or night.' },
  { title: 'The day list and schedule', body: 'Who has arrived, who is waiting, who is in the chair. Plan by chair and dentist; drag a visit and it will not double-book.' },
  { title: 'Patient records and charting', body: 'Every tooth and surface, charted at the chair, on a record the whole team can find in one search.' },
  { title: 'Text confirmations and reminders', body: 'A text when a visit is booked and a reminder before it, sent for you.' },
  { title: 'HMO and PhilHealth claims', body: 'Every claim logged and aged, so you can see who has been sitting on your money.' },
  { title: 'Your whole team', body: 'An account for every dentist and staff member, with the right access for each role.' },
  { title: 'Privacy, done properly', body: 'Consent recorded with every online booking, and each clinic’s records kept apart from every other clinic’s.' },
];
const forPatients = [
  { title: 'Find a clinic', body: 'By what hurts, by area, by your HMO or PhilHealth, or by who is open now.' },
  { title: 'Book in five steps', body: 'No account, no phone call. See the price and a real time before you choose.' },
  { title: 'A text, then a reminder', body: 'Your booking confirmed by text, and a reminder before the visit.' },
  { title: 'My visits', body: 'See, confirm or cancel your visits with a code sent to your phone.' },
  { title: 'Know what is covered', body: 'A plain guide to PhilHealth’s dental benefit and HMO cards.' },
];

// 03 — the process, both ways in.
const clinicSteps = [
  { title: 'Sign up', body: 'Name the clinic and yourself. A few minutes, no card.' },
  { title: 'Set it up', body: 'Hours, fees, dentists and photos, one page each.' },
  { title: 'Invite your team', body: 'Each person gets a code by text and sets a password.' },
  { title: 'Go live', body: 'Switch on your listing. Bookings land on the day list.' },
];
const patientSteps = [
  { title: 'Find a clinic', body: 'Search by what you need.' },
  { title: 'Pick a time', body: 'A real open slot, with the price.' },
  { title: 'Get a text', body: 'Confirmed, then reminded.' },
  { title: 'Walk in', body: 'The desk already has you.' },
];

// 04 — everything the ₱800 includes.
const included = [
  'Online booking and your clinic page',
  'The day list and the schedule',
  'Patient records and tooth charting',
  'Text confirmations and reminders',
  'HMO and PhilHealth claims tracking',
  'Accounts for your whole team',
  'Privacy consent with every booking',
  'Works on tablet, phone and computer',
];

// 06 — the two walkthroughs, recorded from the real product with sample data.
const films = [
  { id: 'clinic', tab: 'As a clinic', src: '/video/register-clinic.mp4', poster: '/video/register-clinic.webp', steps: ['Open your clinic in the web', 'Name the clinic, then yourself', 'Set your hours and fees', 'Your day list is ready'] },
  { id: 'patient', tab: 'As a patient', src: '/video/register-patient.mp4', poster: '/video/register-patient.webp', steps: ['Tap “I’m a Patient”', 'Choose a clinic', 'Pick a service and a time', 'Your name and mobile, and it is booked'] },
];

const peso = (n: number) => `₱${n.toLocaleString('en-PH')}`;
const pages = TEAM.length ? 7 : 6;
const no = (n: number) => String(n).padStart(2, '0');
---

<Base
  title="Flossify — your clinic, in the web"
  description="Practice software for Philippine dental clinics. Switch to paperless, seamless, effortless daily operations: online booking, the day list, charting, texts, billing and claims, for ₱800 a month."
>
  <!-- The film is the ground of the whole page: one fixed layer, one uncut
       take, scrubbed by the document's own scroll. Every section is a page
       standing in whichever room the camera has reached. -->
  <div class="film-bg" data-film aria-hidden="true">
    <img class="film-poster" src="/video/tour-poster.webp" alt="" width="1344" height="756" fetchpriority="high" />
    <video class="film-video" data-film-video muted playsinline preload="auto" disablepictureinpicture></video>
  </div>

  <header class="sticky top-0 z-40 border-b border-line bg-bg/75 backdrop-blur-md">
    <div class="mx-auto flex max-w-[1480px] items-center justify-between gap-6 px-5 py-4 sm:px-8">
      <a href="/" class="font-display text-[17px] font-bold tracking-[-0.05em]">Flossify</a>

      <!-- Where you are: the page, and the room the camera is in. -->
      <span class="meta hidden md:block" aria-hidden="true"><span data-readout>01 / Your clinic</span><span class="film-room" data-room data-rooms={JSON.stringify(stops.map((t) => [t.from, t.label]))}> &middot; {stops[0].label}</span></span>

      <nav class="flex items-center gap-6" aria-label="Primary">
        <a href="#services" class="meta hidden hover:text-ink sm:block">Services</a>
        <a href="#pricing" class="meta hidden hover:text-ink sm:block">Pricing</a>
        <a href="/find/" class="meta hover:text-ink">Find a clinic</a>
        <a href="/clinics/" class="meta meta-ink underline decoration-line underline-offset-4 hover:decoration-accent">
          Workspaces
        </a>
      </nav>
    </div>
    <div class="absolute inset-x-0 bottom-0 h-px"><div class="h-px w-0 bg-accent" data-progress></div></div>
  </header>

  <main id="main" class="relative z-10">
    <!-- 01 — Your clinic, in the web -->
    <section id="tour" data-sec="01 / Your clinic" class="page page-hero" aria-labelledby="hero-title">
      <div class="relative mx-auto w-full max-w-[1480px] px-5 sm:px-8">
        <div class="max-w-[40rem]">
          <p class="meta" style="color: rgb(242 242 239 / 0.72)">Practice software for Philippine dental clinics</p>
          <h1 id="hero-title" data-lines class="mt-5 font-display text-[clamp(2.6rem,6.4vw,5.4rem)] font-semibold">
            <span class="line-clip"><span>Your clinic,</span></span>
            <span class="line-clip"><span>in the Web</span></span>
          </h1>
          <p class="mt-4 max-w-[30ch] text-[clamp(1.15rem,1.8vw,1.45rem)] leading-snug sm:mt-6" style="color: rgb(242 242 239 / 0.9)">
            Switch to paperless, seamless, effortless daily operations:
          </p>
          <div class="mt-6 flex flex-wrap gap-3 sm:mt-8">
            <a href="/start/" class="btn btn-film">Open your clinic in the web</a>
            <a href="/find/" class="btn btn-film-quiet">I’m a Patient</a>
          </div>
        </div>
      </div>
      <p class="meta film-hint" data-film-hint>Scroll to walk in</p>
    </section>

    <!-- 02 — Services -->
    <section id="services" data-sec="02 / Services" class="page">
      <div class="mx-auto max-w-[1480px] px-4 sm:px-8">
        <div class="pane">
          <div class="flex items-baseline gap-6">
            <span class="sec-no">02</span>
            <h2 class="font-display text-[clamp(1.9rem,4vw,3.2rem)] font-semibold">What Flossify does.</h2>
          </div>
          <div class="rule rule-draw mt-8"></div>

          <div class="mt-10 grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-14">
            <div class="lg:col-span-7">
              <p class="meta meta-ink">For dental clinics</p>
              <ul class="mt-5 grid grid-cols-1 sm:grid-cols-2">
                {forClinics.map((s, i) => (
                  <li class:list={['reveal', `reveal-d${i % 3}`, 'border-t border-line py-5 sm:pr-8']}>
                    <h3 class="font-display text-[1.25rem] font-semibold tracking-[-0.02em]">{s.title}</h3>
                    <p class="mt-2 max-w-[38ch] text-[15px] text-ink-2">{s.body}</p>
                  </li>
                ))}
              </ul>
              <a href="/start/" class="meta meta-accent mt-6 inline-block">Open your clinic in the web &rarr;</a>
            </div>

            <div class="lg:col-span-5 lg:border-l lg:border-line lg:pl-14">
              <p class="meta meta-ink">For patients</p>
              <ul class="mt-5">
                {forPatients.map((s, i) => (
                  <li class:list={['reveal', `reveal-d${i % 3}`, 'border-t border-line py-5']}>
                    <h3 class="font-display text-[1.25rem] font-semibold tracking-[-0.02em]">{s.title}</h3>
                    <p class="mt-2 max-w-[40ch] text-[15px] text-ink-2">{s.body}</p>
                  </li>
                ))}
              </ul>
              <a href="/find/" class="meta meta-accent mt-6 inline-block">Find a clinic &rarr;</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 03 — The process -->
    <section id="process" data-sec="03 / How it works" class="page">
      <div class="mx-auto max-w-[1480px] px-4 sm:px-8">
        <div class="pane">
          <div class="flex items-baseline gap-6">
            <span class="sec-no">03</span>
            <h2 class="font-display text-[clamp(1.9rem,4vw,3.2rem)] font-semibold">How it works.</h2>
          </div>
          <div class="rule rule-draw mt-8"></div>

          {[{ who: 'For clinics', steps: clinicSteps, href: '/start/', cta: 'Start now' }, { who: 'For patients', steps: patientSteps, href: '/find/', cta: 'Find a clinic' }].map((track) => (
            <div class="mt-10">
              <div class="flex flex-wrap items-baseline justify-between gap-4">
                <p class="meta meta-ink">{track.who}</p>
                <a href={track.href} class="meta meta-accent">{track.cta} &rarr;</a>
              </div>
              <ol class="mt-5 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4">
                {track.steps.map((s, i) => (
                  <li class:list={['reveal', `reveal-d${i % 3}`, 'border-t border-line pt-6 pb-4 lg:pr-8', i > 0 && 'lg:border-l lg:pl-8']}>
                    <p class="font-display text-[clamp(2.4rem,4vw,3.4rem)] font-semibold leading-none tabular-nums" aria-hidden="true">{i + 1}</p>
                    <h3 class="mt-4 font-display text-[1.2rem] font-semibold tracking-[-0.02em]"><span class="sr-only">Step {i + 1}: </span>{s.title}</h3>
                    <p class="mt-2 max-w-[30ch] text-[15px] text-ink-2">{s.body}</p>
                  </li>
                ))}
              </ol>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 04 — Pricing -->
    <section id="pricing" data-sec="04 / Pricing" class="page">
      <div class="mx-auto max-w-[1480px] px-4 sm:px-8 lg:grid lg:grid-cols-12">
        <div class="pane lg:col-span-10 lg:col-start-2">
          <div class="flex items-baseline gap-6">
            <span class="sec-no">04</span>
            <h2 class="font-display text-[clamp(1.9rem,4vw,3.2rem)] font-semibold">One price. Everything in it.</h2>
          </div>
          <div class="rule rule-draw mt-8"></div>

          <div class="mt-10 grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-14">
            <div class="lg:col-span-5">
              <p class="font-display font-semibold leading-none tracking-[-0.04em]">
                <span class="text-[clamp(4.5rem,11vw,8rem)] tabular-nums">{peso(PRICE_PER_BRANCH)}</span>
              </p>
              <p class="meta meta-ink mt-4">a month, per clinic</p>
              <p class="mt-6 max-w-[34ch] text-[16px] text-ink-2">
                Every feature, the whole team, text reminders included. Your first 30 days are free, and you need no card to start.
              </p>
              <div class="mt-8 flex flex-wrap gap-3">
                <a href="/start/" class="btn btn-primary">Start your 30 free days</a>
              </div>
              <p class="mt-6 max-w-[40ch] text-[13.5px] text-muted">A clinic with more than one branch pays {peso(PRICE_PER_BRANCH)} for each branch. Prices in Philippine pesos.</p>
            </div>

            <div class="lg:col-span-7">
              <p class="meta meta-ink">Included</p>
              <ul class="mt-5 grid grid-cols-1 sm:grid-cols-2">
                {included.map((s) => (
                  <li class="flex items-baseline gap-3 border-t border-line py-4 pr-6 text-[15.5px]">
                    <span class="text-accent" aria-hidden="true">✓</span><span>{s}</span>
                  </li>
                ))}
              </ul>
              <p class="mt-6 max-w-[56ch] text-[14px] text-ink-2">Want a full clinic website like our sample? <a href="/websites/" class="underline underline-offset-4 hover:text-accent">See clinic websites</a>.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 05 — Partners -->
    <section id="partners" data-sec="05 / Partners" class="page">
      <div class="mx-auto max-w-[1480px] px-4 sm:px-8">
        <div class="pane">
          <div class="flex items-baseline gap-6">
            <span class="sec-no">05</span>
            <h2 class="font-display text-[clamp(1.9rem,4vw,3.2rem)] font-semibold">Our dental clinic partners.</h2>
          </div>
          <div class="rule rule-draw mt-8"></div>

          {partners.length > 0 ? (
            <>
              <ul class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3">
                {partners.map((l) => (
                  <li class="border-t border-line py-6 sm:pr-8">
                    <a href={`/find/${l.slug}/`} class="group block">
                      <h3 class="font-display text-[1.35rem] font-semibold tracking-[-0.02em] group-hover:text-accent">{l.name}</h3>
                      <p class="meta mt-2">{l.area}</p>
                      <p class="mt-3 flex flex-wrap gap-1">
                        {l.philhealth && <span class="tag tag-accent">PhilHealth</span>}
                        <span class="tag">{l.workspace ? 'Book online' : 'Request a time'}</span>
                      </p>
                    </a>
                  </li>
                ))}
              </ul>
              <a href="/find/" class="meta meta-accent mt-6 inline-block">See every clinic &rarr;</a>
            </>
          ) : (
            <div class="mt-8 max-w-[52ch]">
              <p class="text-[17px] leading-relaxed text-ink-2">
                Our first partner clinics are joining in Baguio City. Each one appears here, and on Find a clinic, as it opens.
              </p>
              <a href="/start/" class="btn btn-primary mt-7">Become a partner clinic</a>
            </div>
          )}
        </div>
      </div>
    </section>

    <!-- 06 — How to register, on film -->
    <section id="register" data-sec="06 / How to register" class="page">
      <div class="mx-auto max-w-[1480px] px-4 sm:px-8">
        <div class="pane">
          <div class="flex items-baseline gap-6">
            <span class="sec-no">06</span>
            <h2 class="font-display text-[clamp(1.9rem,4vw,3.2rem)] font-semibold">How to register.</h2>
          </div>
          <div class="rule rule-draw mt-8"></div>

          <div role="tablist" aria-label="Walkthroughs" class="mt-8 flex border-b border-line">
            {films.map((f, i) => (
              <button type="button" role="tab" id={`reg-tab-${f.id}`} aria-controls={`reg-panel-${f.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} class="reg-tab" data-reg-tab={i}>
                {f.tab}
              </button>
            ))}
          </div>

          {films.map((f, i) => (
            <div role="tabpanel" id={`reg-panel-${f.id}`} aria-labelledby={`reg-tab-${f.id}`} hidden={i !== 0} class="mt-8 grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-12" data-reg-panel={i}>
              <div class="lg:col-span-8">
                <div class="frame">
                  <div class="frame-bar"><span>flossify.ph &middot; {f.tab.toLowerCase()}</span></div>
                  <video class="block aspect-video w-full bg-ink" data-reg-video src={f.src} poster={f.poster} muted loop playsinline controls preload="none" aria-label={`Walkthrough: registering ${f.tab.toLowerCase()}`}></video>
                </div>
                <p class="mt-3 text-[13px] text-muted">Recorded on Flossify with a sample clinic and patient.</p>
              </div>
              <ol class="lg:col-span-4">
                {f.steps.map((s, n) => (
                  <li class="flex items-baseline gap-4 border-t border-line py-4">
                    <span class="sec-no">{no(n + 1)}</span><span class="text-[16px]">{s}</span>
                  </li>
                ))}
              </ol>
            </div>
          ))}
          {pages === 6 && <p class="meta mt-14">&copy; 2026 Flossify &middot; Baguio City, Philippines</p>}
        </div>
      </div>
    </section>

    {/* 07 — Know the team, once src/data/team.ts names real people */}
    {TEAM.length > 0 && (
      <section id="team" data-sec="07 / The team" class="page">
        <div class="mx-auto max-w-[1480px] px-4 sm:px-8">
          <div class="pane">
            <div class="flex items-baseline gap-6">
              <span class="sec-no">07</span>
              <h2 class="font-display text-[clamp(1.9rem,4vw,3.2rem)] font-semibold">Know the team.</h2>
            </div>
            <div class="rule rule-draw mt-8"></div>
            <ul class="mt-8 grid grid-cols-1 gap-x-10 sm:grid-cols-2 lg:grid-cols-4">
              {TEAM.map((m) => (
                <li class="border-t border-line py-6">
                  {m.photo && <img src={m.photo} alt={m.name} width="320" height="320" loading="lazy" class="aspect-square w-full object-cover" />}
                  <h3 class="mt-4 font-display text-[1.3rem] font-semibold tracking-[-0.02em]">{m.name}</h3>
                  <p class="meta mt-1">{m.role}</p>
                  {m.about && <p class="mt-3 max-w-[34ch] text-[15px] text-ink-2">{m.about}</p>}
                </li>
              ))}
            </ul>
            <p class="meta mt-14">&copy; 2026 Flossify &middot; Baguio City, Philippines</p>
          </div>
        </div>
      </section>
    )}
  </main>

  <!-- The walk in words, for anyone the film is hidden from. -->
  <ol class="sr-only" aria-label="The walk through the clinic">
    {stops.map((t) => <li>{t.at}, {t.label.toLowerCase()}: {t.body}</li>)}
  </ol>

  <style>
    .reg-tab {
      min-height: 3rem; padding: 0 1.25rem; margin-bottom: -1px;
      font-family: var(--font-display); font-size: 1.05rem; font-weight: 600; letter-spacing: -0.01em;
      color: var(--c-ink-2); border-bottom: 2px solid transparent;
      transition: color 160ms ease, border-color 160ms ease;
    }
    .reg-tab:hover { color: var(--c-ink); }
    .reg-tab[aria-selected='true'] { color: var(--c-ink); border-bottom-color: var(--c-accent); }
    .reg-tab:focus-visible { outline: 2px solid var(--c-accent); outline-offset: 2px; }
  </style>

  <script>
    /* Every motion on this page runs for everyone: the walk answers the wheel,
       the rises and rules play on entry, the walkthroughs play when they come
       into view. Nothing here reads prefers-reduced-motion, by the owner's
       decision. */

    /* --- the walk ----------------------------------------------------------
       Scroll position over the whole document maps to the film's currentTime.
       The page scrolls normally throughout — the film just reads how far down
       we are, which is why this never fights the wheel. The masthead hairline
       reads the same number. */
    const bar = document.querySelector<HTMLElement>('[data-progress]');
    const vid = document.querySelector<HTMLVideoElement>('[data-film-video]');
    const poster = document.querySelector<HTMLElement>('.film-poster');
    const hint = document.querySelector<HTMLElement>('[data-film-hint]');
    const room = document.querySelector<HTMLElement>('[data-room]');
    const rooms: [number, string][] = JSON.parse(room?.dataset.rooms ?? '[]');

    let duration = 0;

    const draw = () => {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const p = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;

      if (bar) bar.style.width = `${p * 100}%`;

      if (vid && duration) {
        /* Stop just shy of the end: seeking exactly to duration parks some
           browsers on a blank frame and fires `ended`. */
        const t = p * (duration - 0.05);
        if (Math.abs(vid.currentTime - t) > 1 / 60) vid.currentTime = t;
      }

      let at = 0;
      rooms.forEach(([f], i) => { if (p >= f) at = i; });
      if (room && rooms[at] && room.dataset.at !== String(at)) {
        room.dataset.at = String(at);
        room.textContent = ` · ${rooms[at][1]}`;
      }
      if (p > 0.015) hint?.setAttribute('data-hide', '');
    };

    if (vid) {
      /* Chosen after layout rather than in the markup: a phone should not
         pull the desktop master over mobile data to scrub it. */
      const small = window.matchMedia('(max-width: 900px)').matches;
      vid.src = small ? '/video/tour-960.mp4' : '/video/tour-1440.mp4';
      vid.load();

      vid.addEventListener('loadedmetadata', () => {
        duration = vid.duration;
        draw();
      });
      /* Only hide the poster once a real frame exists behind it, otherwise
         the page flashes black between the two. */
      const show = () => poster?.setAttribute('data-hide', '');
      vid.addEventListener('loadeddata', show, { once: true });
      vid.addEventListener('seeked', show, { once: true });
    }

    /* One rAF-throttled handler, because `scroll` fires far more often than
       the compositor can use. */
    let queued = false;
    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => { draw(); queued = false; });
    };

    draw();
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', draw);

    /* --- reveal on entry --------------------------------------------------
       One observer for the three entry motions: rises, drawn rules and the
       clipped display lines. Everything unobserves once it has played. */
    const targets = document.querySelectorAll('.reveal, .rule-draw, [data-lines]');
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        e.target.classList.add('is-in');
        io.unobserve(e.target);
      }
    }, { rootMargin: '0px 0px -12% 0px', threshold: 0.15 });
    targets.forEach((el) => io.observe(el));

    /* --- masthead section readout ----------------------------------------- */
    const readout = document.querySelector<HTMLElement>('[data-readout]');
    const marked = document.querySelectorAll<HTMLElement>('[data-sec]');
    if (readout && marked.length) {
      const seen = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (e.isIntersecting) readout.textContent = (e.target as HTMLElement).dataset.sec ?? '';
        }
      }, { rootMargin: '-15% 0px -70% 0px' });
      marked.forEach((el) => seen.observe(el));
    }

    /* --- the walkthroughs ---------------------------------------------------
       Two tabs, roving tabindex (arrows move between them). The shown video
       plays, muted, whenever it is on screen and pauses when it leaves; its
       controls are there for anyone who wants to scrub or pause. */
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-reg-tab]'));
    const regPanels = Array.from(document.querySelectorAll<HTMLElement>('[data-reg-panel]'));
    const regVideos = regPanels.map((p) => p.querySelector<HTMLVideoElement>('[data-reg-video]'));
    let current = 0, inView = false;
    const play = () => {
      regVideos.forEach((v, n) => {
        if (!v) return;
        if (n === current && inView) { v.preload = 'auto'; v.play().catch(() => { /* the poster stays; controls still work */ }); }
        else v.pause();
      });
    };
    const choose = (i: number, focus = false) => {
      current = i;
      tabs.forEach((t, n) => { t.setAttribute('aria-selected', n === i ? 'true' : 'false'); t.tabIndex = n === i ? 0 : -1; });
      regPanels.forEach((p, n) => { p.hidden = n !== i; });
      if (focus) tabs[i].focus();
      play();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => choose(i));
      t.addEventListener('keydown', (e) => {
        const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!step) return;
        e.preventDefault();
        choose((i + step + tabs.length) % tabs.length, true);
      });
    });
    const regSection = document.getElementById('register');
    if (regSection) {
      new IntersectionObserver(([e]) => { inView = e.isIntersecting; play(); }, { threshold: 0.35 }).observe(regSection);
    }
  </script>
</Base>
