      display: block; width: 100%; height: auto; aspect-ratio: 16 / 9;
      border: 1px solid var(--ws-hair); border-radius: var(--ws-r-ctl); background: #fff; box-shadow: var(--ws-shadow);
    }
    .home-way-film figcaption { margin-top: 0.375rem; font-size: 13px; line-height: 1.4; color: var(--c-ink-2); }
    .home-reg-steps { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.25rem 0.75rem; margin-top: 0.5rem; }
    @media (max-width: 359px) { .home-reg-steps { grid-template-columns: minmax(0, 1fr); } }
    .home-reg-steps li { display: flex; align-items: center; gap: 0.5rem; min-height: 32px; font-size: 14px; line-height: 1.35; color: var(--c-ink); }
    .home-reg-steps .home-step-no { width: 22px; height: 22px; font-size: 12px; }
    .home-copy { margin-top: 0.875rem; color: var(--c-ink); }

    /* --- the team -------------------------------------------------------------------------------- */
    .home-team { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0.5rem; }
    @media (min-width: 640px) { .home-team { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @media (min-width: 1024px) { .home-team { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
    .home-member { padding: 0.875rem; }
    .home-member-role { margin-top: 0.125rem; font-size: 14px; color: var(--c-ink-2); }
    .home-member .home-feat-body { margin-top: 0.375rem; }
  </style>

  <script>
    /* Every motion on this page runs for everyone: the walk answers the wheel,
       the rises and rules play on entry. Nothing here reads
       prefers-reduced-motion, by the owner's decision. */

    /* --- the walk ----------------------------------------------------------
       Scroll position over the whole document maps to the film's currentTime.
       The page scrolls normally throughout — the film just reads how far down
       we are, which is why this never fights the wheel. The progress line
       along the bar's foot reads the same number. */
    const bar = document.querySelector<HTMLElement>('[data-progress]');
    const vid = document.querySelector<HTMLVideoElement>('[data-film-video]');
    const poster = document.querySelector<HTMLElement>('.film-poster');
    const hint = document.querySelector<HTMLElement>('[data-film-hint]');
    const room = document.querySelector<HTMLElement>('[data-room]');
    const rooms: [number, string][] = JSON.parse(room?.dataset.rooms ?? '[]');

    let duration = 0;

    const draw = () => {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const p = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;

      if (bar) bar.style.width = `${p * 100}%`;

      if (vid && duration) {
        /* Stop just shy of the end: seeking exactly to duration parks some
           browsers on a blank frame and fires `ended`. */
        const t = p * (duration - 0.05);
        if (Math.abs(vid.currentTime - t) > 1 / 60) vid.currentTime = t;
      }

      let at = 0;
      rooms.forEach(([f], i) => { if (p >= f) at = i; });
      if (room && rooms[at] && room.dataset.at !== String(at)) {
        room.dataset.at = String(at);
        room.textContent = ` · ${rooms[at][1]}`;
      }
      if (p > 0.015) hint?.setAttribute('data-hide', '');
    };

    if (vid) {
      /* Chosen after layout rather than in the markup: a phone should not
         pull the desktop master over mobile data to scrub it. */
      const small = window.matchMedia('(max-width: 900px)').matches;
      vid.src = small ? '/video/tour-960.mp4' : '/video/tour-1440.mp4';
      vid.load();

      vid.addEventListener('loadedmetadata', () => {
        duration = vid.duration;
        draw();
      });
      /* Only hide the poster once a real frame exists behind it, otherwise
         the page flashes black between the two. */
      const show = () => poster?.setAttribute('data-hide', '');
      vid.addEventListener('loadeddata', show, { once: true });
      vid.addEventListener('seeked', show, { once: true });
    }

    /* One rAF-throttled handler, because `scroll` fires far more often than
       the compositor can use. */
    let queued = false;
    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => { draw(); queued = false; });
    };

    draw();
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', draw);

    /* --- reveal on entry --------------------------------------------------
       One observer for the three entry motions: rises, drawn rules and the
       clipped display lines. Everything unobserves once it has played. */
    const targets = document.querySelectorAll('.reveal, .rule-draw, [data-lines]');
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        e.target.classList.add('is-in');
        io.unobserve(e.target);
      }
    }, { rootMargin: '0px 0px -12% 0px', threshold: 0.15 });
    targets.forEach((el) => io.observe(el));

    /* --- the walkthroughs: each plays, muted, while its card is on screen ---
       preload="none" in the markup, so nothing downloads until a card is
       reached; the controls stay for pausing or scrubbing. */
    const films = document.querySelectorAll<HTMLVideoElement>('[data-reg-video]');
    const onScreen = new IntersectionObserver((entries) => {
      for (const e of entries) {
        const v = e.target as HTMLVideoElement;
        if (e.isIntersecting) { v.preload = 'auto'; v.play().catch(() => { /* the poster stays; controls still work */ }); }
        else v.pause();
      }
    }, { threshold: 0.4 });
    films.forEach((v) => onScreen.observe(v));

    /* --- where you are: the page in the bar's readout ------------------------ */
    const readout = document.querySelector<HTMLElement>('[data-readout]');
    const marked = document.querySelectorAll<HTMLElement>('[data-sec]');
    if (readout && marked.length) {
      const seen = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (e.isIntersecting) readout.textContent = (e.target as HTMLElement).dataset.sec ?? '';
        }
      }, { rootMargin: '-15% 0px -70% 0px' });
      marked.forEach((el) => seen.observe(el));
    }
  </script>
