---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import Icon from '../components/ws/Icon.astro';
import Avatar from '../components/ws/Avatar.astro';
import ClinicBadge from './find/_ui/ClinicBadge.astro';
import type { IconName } from '../components/ws/icons';
import { ROOM_FROM } from '../data/film';
import { TEAM } from '../data/team';
import { BILLING_FINAL, PRICE_PER_BRANCH } from '../lib/billing';
import { loadDirectory, type DbListing } from '../lib/directory-db';

// Server-rendered: the Partners page lists the clinics that are really on
// Flossify today, from the same directory patients search.
export const prerender = false;

let partners: DbListing[] = [];
try {
  partners = await loadDirectory();
} catch {
  /* the database is unreachable: the page still renders, without the list */
}

// The rooms. Four, one per room of the film, each pinned to the moment the
// footage arrives there (fractions of the take, read off a frame sheet), so
// the header can never name a room the camera is not in. The whole page is
// the walk: the top of the document is the pavement, the last page the chair.
const stops = [
  { at: '08:55', from: ROOM_FROM.outside, label: 'Outside', body: 'The clinic from the street.' },
  { at: '09:00', from: ROOM_FROM.reception, label: 'Reception', body: 'The front desk, with today’s calendar open.' },
  { at: '09:12', from: ROOM_FROM.corridor, label: 'The corridor', body: 'On the way to the chair.' },
  { at: '09:15', from: ROOM_FROM.chair, label: 'The chair', body: 'The treatment room.' },
];

type Item = { title: string; body: string; icon: IconName };

// Services — what Flossify does, for each side of the chair. Only what the
// product does today: every line here is a screen a clinic or a patient can
// open. A feature joins these lists (and Pricing's) the day it is live, not
// before. One icon per idea, the workspace's own (ws/icons.ts).
const forClinics: Item[] = [
  { icon: 'calendar', title: 'Online booking', body: 'Your clinic page on Find a clinic. Patients book a real open slot, or send a request, day or night.' },
  { icon: 'dashboard', title: 'The Dashboard: today at a glance', body: 'Who has arrived, who is waiting, who is in the chair. A calendar by chair or by dentist; drag a visit and it will not double-book.' },
  { icon: 'file', title: 'Patient records and charting', body: 'Every tooth and surface, with health history, allergies and medicines on the record where the dentist sees them. Charting keeps working through a brownout.' },
  { icon: 'message', title: 'Text confirmations and reminders', body: 'A text when a visit is booked and a reminder before it, sent for you.' },
  { icon: 'wallet', title: 'Billing', body: 'Charges, senior and PWD discounts, payments and balances, with a printable statement. BIR invoices still come from your own registered booklet.' },
  { icon: 'money', title: 'HMO and PhilHealth claims', body: 'Every claim logged and aged, so you can see who has been sitting on your money.' },
  { icon: 'patients', title: 'Your whole team', body: 'An account for every dentist and staff member, with the right access for each role.' },
  { icon: 'check', title: 'Privacy, done properly', body: 'Consent recorded online and at the desk, and each clinic’s records kept apart from every other clinic’s.' },
];
const forPatients: Item[] = [
  { icon: 'search', title: 'Find a clinic', body: 'By what hurts, by area, by your HMO or PhilHealth, or by who is open now.' },
  { icon: 'clock', title: 'Book in five steps', body: 'No account, no phone call. See the price and a real time before you choose.' },
  { icon: 'message', title: 'A text, then a reminder', body: 'Your booking confirmed by text, and a reminder before the visit.' },
  { icon: 'calendar', title: 'My visits', body: 'See, confirm or cancel your visits with a code sent to your phone.' },
  { icon: 'file', title: 'Know what is covered', body: 'A plain guide to PhilHealth’s dental benefit and HMO cards.' },
];

// How it works — the process, both ways in.
const clinicSteps = [
  { title: 'Sign up', body: 'Name the clinic and yourself. A few minutes, no card.' },
  { title: 'Set it up', body: 'Hours, fees, dentists and photos, one page each.' },
  { title: 'Invite your team', body: 'Each person gets a code by text and sets a password.' },
  { title: 'Go live', body: 'Switch on your listing. Bookings land on your Dashboard.' },
];
const patientSteps = [
  { title: 'Find a clinic', body: 'Search by what you need.' },
  { title: 'Pick a time', body: 'A real open slot, with the price.' },
  { title: 'Get a text', body: 'Confirmed, then reminded.' },
  { title: 'Walk in', body: 'The desk already has you.' },
];
const tracks: { id: string; who: string; icon: IconName; steps: typeof clinicSteps; href: string; cta: string }[] = [
  { id: 'clinics', who: 'For clinics', icon: 'clinic', steps: clinicSteps, href: '/start/', cta: 'Start now' },
  { id: 'patients', who: 'For patients', icon: 'user', steps: patientSteps, href: '/find/', cta: 'Find a clinic' },
];

// Pricing — everything the ₱800 includes.
const included = [
  'Online booking and your clinic page',
  'The Dashboard: today’s calendar and patients',
  'Patient records and tooth charting',
  'Health history and allergies',
  'Text confirmations and reminders',
  'Billing: charges, payments, statements',
  'HMO and PhilHealth claims tracking',
  'Accounts for your whole team',
  'Consent online and at the desk',
  'Works on tablet, phone and computer',
];

// How to register — the two ways in, each with its walkthrough, its steps and its one way to start.
// The walkthroughs (public/video/register-*.mp4) are recorded from the real product with sample data
// by scripts/record-walkthroughs.mjs; their captions are these steps, so change both together.
const ways: { id: string; who: string; icon: IconName; video: string; steps: string[]; href: string; cta: string; main: boolean }[] = [
  { id: 'clinic', who: 'As a clinic', icon: 'clinic', video: 'register-clinic', steps: ['Open your clinic in the web', 'Name the clinic, then yourself', 'Set your hours and fees', 'Your Dashboard is ready'], href: '/start/', cta: 'Open your clinic in the web', main: true },
  { id: 'patient', who: 'As a patient', icon: 'user', video: 'register-patient', steps: ['Tap “I’m a Patient”', 'Choose a clinic', 'Pick a service and a time', 'Your name and mobile, and it is booked'], href: '/find/', cta: 'I’m a Patient', main: false },
];

const peso = (n: number) => `₱${n.toLocaleString('en-PH')}`;
// The copyright goes on the last page: the team's once src/data/team.ts names real people.
const lastIsTeam = TEAM.length > 0;
---

<Base
  title="Flossify — your clinic, in the web"
  description="Practice software for Philippine dental clinics. Switch to paperless, seamless, effortless daily operations: online booking, today’s calendar, charting, texts, billing and claims, for ₱800 a month."
>
  <!-- The film is the ground of the whole page: one fixed layer, one uncut
       take, scrubbed by the document's own scroll. Every section is a page
       standing in whichever room the camera has reached. -->
  <div class="film-bg" data-film aria-hidden="true">
    <img class="film-poster" src="/video/tour-poster.webp" alt="" width="1344" height="756" fetchpriority="high" />
    <video class="film-video" data-film-video muted playsinline preload="auto" disablepictureinpicture></video>
  </div>

  <!-- The site's soft bar (1480px, the pages' width). Beside the links, from 1180px: where you are —
       the page and the room the camera is in. Along its foot: how far along the walk you are.
       Open your clinic is quiet here: the page's own buttons (the hero's, the price's) are the teal ones. -->
  <SiteHeader wide cta="quiet">
    <span slot="aside" class="home-where" aria-hidden="true">
      <span class="home-where-dot"></span>
      <span><span data-readout>Your clinic</span><span class="film-room home-where-room" data-room data-rooms={JSON.stringify(stops.map((t) => [t.from, t.label]))}> &middot; {stops[0].label}</span></span>
    </span>
    <div class="home-progress" aria-hidden="true"><div class="home-progress-bar" data-progress></div></div>
  </SiteHeader>

  <main id="main" class="relative z-10">
    <!-- Your clinic, in the web: light words on the film's scrim -->
    <section id="tour" data-sec="Your clinic" class="page page-hero" aria-labelledby="hero-title">
      <div class="relative mx-auto w-full max-w-[1480px] px-5 sm:px-8">
        <div class="max-w-[40rem]">
          <p class="hero-eyebrow"><span class="hero-dot" aria-hidden="true"></span>Practice software for Philippine dental clinics</p>
          <h1 id="hero-title" data-lines class="hero-title mt-5">
            <span class="line-clip"><span>Your clinic,</span></span>
            <span class="line-clip"><span>in the Web</span></span>
          </h1>
          <p class="hero-lede mt-4 sm:mt-6">Switch to paperless, seamless, effortless daily operations:</p>
          <div class="mt-6 flex flex-wrap gap-3 sm:mt-8">
            <a href="/start/" class="btn btn-lg btn-film"><span>Open your clinic in the web</span><Icon name="arrow-right" /></a>
            <a href="/find/" class="btn btn-lg btn-film-quiet"><Icon name="search" /><span>I’m a Patient</span></a>
          </div>
        </div>
      </div>
      <p class="film-hint hero-hint" data-film-hint><span>Scroll to walk in</span><Icon name="chevron" size={16} /></p>
    </section>

    <!-- Services: for clinics (two columns) and for patients (one), side by side on a desktop -->
    <section id="services" data-sec="Services" class="page" aria-labelledby="services-title">
      <div class="home-wrap">
        <div class="pane pane-glass">
          <div class="home-head">
            <span class="home-head-icon" aria-hidden="true"><Icon name="dashboard" size={20} /></span>
            <h2 id="services-title" class="home-title">What Flossify does.</h2>
          </div>
          <div class="rule rule-draw home-rule"></div>

          <div class="home-svc home-body">
            <div>
              <div class="home-group-row">
                <h3 class="home-group"><Icon name="clinic" size={16} />For dental clinics</h3>
                <a href="/start/" class="home-link"><span>Open your clinic in the web</span><Icon name="arrow-right" size={16} /></a>
              </div>
              <ul class="home-feats home-feats-clinics">
                {forClinics.map((s, i) => (
                  <li class:list={['home-feat reveal', `reveal-d${i % 3}`]}>
                    <span class="home-feat-icon" aria-hidden="true"><Icon name={s.icon} size={16} /></span>
                    <div class="min-w-0">
                      <h4 class="home-feat-title">{s.title}</h4>
                      <p class="home-feat-body">{s.body}</p>
                    </div>
                  </li>
                ))}
              </ul>
            </div>

            <div>
              <div class="home-group-row">
                <h3 class="home-group"><Icon name="user" size={16} />For patients</h3>
                <a href="/find/" class="home-link"><span>Find a clinic</span><Icon name="arrow-right" size={16} /></a>
              </div>
              <ul class="home-feats home-feats-patients">
                {forPatients.map((s, i) => (
                  <li class:list={['home-feat reveal', `reveal-d${i % 3}`]}>
                    <span class="home-feat-icon" aria-hidden="true"><Icon name={s.icon} size={16} /></span>
                    <div class="min-w-0">
                      <h4 class="home-feat-title">{s.title}</h4>
                      <p class="home-feat-body">{s.body}</p>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- How it works: on a desktop each way in is one row, its name on the left and its four steps beside it -->
    <section id="process" data-sec="How it works" class="page" aria-labelledby="process-title">
      <div class="home-wrap">
        <div class="pane pane-glass">
          <div class="home-head">
            <span class="home-head-icon" aria-hidden="true"><Icon name="clock" size={20} /></span>
            <h2 id="process-title" class="home-title">How it works.</h2>
          </div>
          <div class="rule rule-draw home-rule"></div>

          <div class="home-tracks home-body">
            {tracks.map((track) => (
              <div class="home-track">
                <div class="home-track-head">
                  <h3 class="home-group"><Icon name={track.icon} size={16} />{track.who}</h3>
                  <a href={track.href} class="home-link"><span>{track.cta}</span><Icon name="arrow-right" size={16} /></a>
                </div>
                <ol class="home-steps">
                  {track.steps.map((s, i) => (
                    <li class:list={['home-step reveal', `reveal-d${i % 3}`]}>
                      <div class="home-step-top">
                        <span class="home-step-no" aria-hidden="true">{i + 1}</span>
                        <h4 class="home-feat-title"><span class="sr-only">Step {i + 1}: </span>{s.title}</h4>
                      </div>
                      <p class="home-feat-body">{s.body}</p>
                    </li>
                  ))}
                </ol>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Pricing -->
    <section id="pricing" data-sec="Pricing" class="page" aria-labelledby="pricing-title">
      <div class="home-wrap">
        <div class="pane pane-glass">
          <div class="home-head">
            <span class="home-head-icon" aria-hidden="true"><Icon name="money" size={20} /></span>
            <h2 id="pricing-title" class="home-title">One price. Everything in it.</h2>
          </div>
          <div class="rule rule-draw home-rule"></div>

          <div class="home-pricing home-body">
            <div class="home-price-card">
              <p class="home-price"><span class="home-price-num">{peso(PRICE_PER_BRANCH)}</span><span class="home-price-per">a month, per clinic</span></p>
              {!BILLING_FINAL && (
                <p class="home-price-note"><Icon name="info" size={16} /><span>Prices are not final yet. Nothing is charged until they are, and we tell you first.</span></p>
              )}
              <p class="home-price-lede">
                Every feature, the whole team, text reminders included. Your first 30 days are free, and you need no card to start.
              </p>
              <a href="/start/" class="btn btn-primary home-price-go"><span>Start your 30 free days</span><Icon name="arrow-right" /></a>
              <p class="home-price-small">A clinic with more than one branch pays {peso(PRICE_PER_BRANCH)} for each branch. Prices in Philippine pesos.</p>
            </div>

            <div class="home-included">
              <h3 class="home-group">Included</h3>
              <ul class="home-checks">
                {included.map((s) => (
                  <li><span class="home-check" aria-hidden="true"><Icon name="check" size={12} /></span><span>{s}</span></li>
                ))}
              </ul>
              <p class="ws-callout home-callout">
                <Icon name="clinic" size={16} />
                <span>Want a full clinic website like our sample? <a href="/websites/" class="home-callout-link">See clinic websites</a>.</span>
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Partners -->
    <section id="partners" data-sec="Partners" class="page" aria-labelledby="partners-title">
      <div class="home-wrap">
        <div class="pane pane-glass">
          <div class="home-head">
            <span class="home-head-icon" aria-hidden="true"><Icon name="clinic" size={20} /></span>
            <h2 id="partners-title" class="home-title">Our dental clinic partners.</h2>
            {partners.length > 0 && <a href="/find/" class="home-link home-head-link"><span>See every clinic</span><Icon name="arrow-right" size={16} /></a>}
          </div>
          <div class="rule rule-draw home-rule"></div>

          {partners.length > 0 ? (
            <ul class="home-partners home-body">
              {partners.map((l) => (
                <li>
                  <a href={`/find/${l.slug}/`} class="home-partner">
                    <ClinicBadge name={l.name} />
                    <span class="min-w-0 flex-1">
                      <span class="home-partner-name">{l.name}</span>
                      <span class="home-partner-area">{l.area}</span>
                      <span class="home-partner-meta">
                        {l.philhealth && <span class="ws-pill ws-tint-teal">PhilHealth</span>}
                        <span class:list={['ws-pill', l.workspace ? 'ws-tint-green' : 'ws-tint-slate']}>{l.workspace ? 'Book online' : 'Request a time'}</span>
                      </span>
                    </span>
                    <Icon name="chevron-right" class="home-partner-go" />
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <div class="home-empty home-body">
              <span class="home-empty-icon" aria-hidden="true"><Icon name="clinic" size={20} /></span>
              <p class="home-empty-text">
                Our first partner clinics are joining in Baguio City. Each one appears here, and on Find a clinic, as it opens.
              </p>
              <a href="/start/" class="btn btn-primary"><span>Become a partner clinic</span><Icon name="arrow-right" /></a>
            </div>
          )}
        </div>
      </div>
    </section>

    <!-- How to register -->
    <section id="register" data-sec="How to register" class="page" aria-labelledby="register-title">
      <div class="home-wrap">
        <div class="pane pane-glass">
          <div class="home-head">
            <span class="home-head-icon" aria-hidden="true"><Icon name="user" size={20} /></span>
            <h2 id="register-title" class="home-title">How to register.</h2>
          </div>
          <div class="rule rule-draw home-rule"></div>

          <!-- Two soft cards side by side (stacked on a phone): the way in and its one way to start,
               the walkthrough, then the steps. The clinic's button is the teal one; the patient's is quiet. -->
          <div class="home-ways home-body">
            {ways.map((w) => (
              <div class="home-way reveal">
                <div class="home-way-head">
                  <h3 class="home-group"><Icon name={w.icon} size={16} />{w.who}</h3>
                  <a href={w.href} class:list={['btn', w.main ? 'btn-primary' : 'btn-quiet', 'home-way-go']}><span>{w.cta}</span><Icon name="arrow-right" /></a>
                </div>
                <figure class="home-way-film">
                  <video data-reg-video src={`/video/${w.video}.mp4`} poster={`/video/${w.video}.webp`} width="1280" height="720" muted loop playsinline controls preload="none" aria-label={`Walkthrough: registering ${w.who.toLowerCase()}`}></video>
                  <figcaption>Recorded on Flossify with a sample {w.id === 'clinic' ? 'clinic' : 'patient'}.</figcaption>
                </figure>
                <ol class="home-reg-steps">
                  {w.steps.map((s, n) => (
                    <li><span class="home-step-no" aria-hidden="true">{n + 1}</span><span><span class="sr-only">Step {n + 1}: </span>{s}</span></li>
                  ))}
                </ol>
              </div>
            ))}
          </div>
          {!lastIsTeam && <p class="meta home-copy">&copy; 2026 Flossify &middot; Baguio City, Philippines</p>}
        </div>
      </div>
    </section>

    {/* Know the team, once src/data/team.ts names real people (never a placeholder person) */}
    {TEAM.length > 0 && (
      <section id="team" data-sec="The team" class="page" aria-labelledby="team-title">
        <div class="home-wrap">
          <div class="pane pane-glass">
            <div class="home-head">
              <span class="home-head-icon" aria-hidden="true"><Icon name="patients" size={20} /></span>
              <h2 id="team-title" class="home-title">Know the team.</h2>
            </div>
            <div class="rule rule-draw home-rule"></div>
            <ul class="home-team home-body">
              {TEAM.map((m) => (
                <li class="home-member">
                  {m.photo
                    ? <img src={m.photo} alt={m.name} width="320" height="320" loading="lazy" class="aspect-square w-full rounded-card object-cover" />
                    : <Avatar name={m.name} size="lg" />}
                  <h3 class="home-feat-title mt-3">{m.name}</h3>
                  <p class="home-member-role">{m.role}</p>
                  {m.about && <p class="home-feat-body">{m.about}</p>}
                </li>
              ))}
            </ul>
            <p class="meta home-copy">&copy; 2026 Flossify &middot; Baguio City, Philippines</p>
          </div>
        </div>
      </section>
    )}
  </main>

  <!-- The walk in words, for anyone the film is hidden from. -->
  <ol class="sr-only" aria-label="The walk through the clinic">
    {stops.map((t) => <li>{t.at}, {t.label.toLowerCase()}: {t.body}</li>)}
  </ol>

  <style>
    /* The home page's own pieces, in the soft template (docs/workspace-redesign.md, "The whole site,
       soft"): the workspace's tokens, radii and tints, drawn on the frosted glass cards on the film
       (.pane-glass in global.css, which also sets the --pane-* colours used here, light and dark).
       Unlayered (scoped): nothing here shares a property with a utility on the same element. */

    /* --- where you are (the bar's aside) and how far along (its foot) -------------------------- */
    .home-where {
      display: inline-flex; align-items: center; gap: 0.5rem; min-height: 32px; padding: 0.25rem 0.75rem;
      border: 1px solid var(--ws-hair); border-radius: var(--ws-r-pill); background: var(--ws-subtle);
      font-size: 13px; font-weight: 500; line-height: 1.2; white-space: nowrap; color: var(--c-ink-2);
    }
    .home-where-room { color: var(--ws-teal-ink); }
    .home-where-dot, .hero-dot { position: relative; width: 8px; height: 8px; flex: none; border-radius: var(--ws-r-pill); background: var(--ws-teal); }
    .home-where-dot::after, .hero-dot::after {
      content: ""; position: absolute; inset: 0; border-radius: inherit; background: inherit;
      animation: home-ping 2.4s cubic-bezier(0, 0, 0.2, 1) infinite;
    }
    @keyframes home-ping { 0% { transform: scale(1); opacity: 0.55; } 80%, 100% { transform: scale(2.6); opacity: 0; } }
    .home-progress { position: absolute; inset: auto 0 0 0; height: 2px; pointer-events: none; }
    .home-progress-bar { width: 0; height: 2px; border-radius: 0 var(--ws-r-pill) var(--ws-r-pill) 0; background: var(--ws-teal); }

    /* --- the opening, on the film ----------------------------------------------------------- */
    .hero-eyebrow {
      display: inline-flex; align-items: center; gap: 0.625rem; min-height: 32px; padding: 0.25rem 0.875rem 0.25rem 0.75rem;
      border: 1px solid rgb(255 255 255 / 0.22); border-radius: var(--ws-r-pill); background: rgb(255 255 255 / 0.1);
      -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px);
      font-size: 13.5px; font-weight: 500; line-height: 1.3; color: rgb(255 255 255 / 0.92);
    }
    .hero-dot { background: #5fd4c9; }
    .hero-title { font-size: clamp(2.6rem, 6.2vw, 5.25rem); line-height: 1.05; letter-spacing: -0.035em; color: #fff; }
    .hero-lede { max-width: 30ch; font-size: clamp(1.15rem, 1.8vw, 1.45rem); line-height: 1.35; color: rgb(255 255 255 / 0.9); }
    .hero-hint {
      display: inline-flex; align-items: center; gap: 0.375rem; min-height: 32px; padding: 0.25rem 0.75rem 0.25rem 0.875rem;
      border: 1px solid rgb(255 255 255 / 0.18); border-radius: var(--ws-r-pill); background: rgb(7 16 15 / 0.5);
      -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px);
      font-size: 13px; font-weight: 500; line-height: 1.2; color: rgb(255 255 255 / 0.92);
    }
    .hero-hint :global(.ws-icon) { animation: home-bob 1.6s ease-in-out infinite; }
    @keyframes home-bob { 0%, 100% { transform: translateY(-1px); } 50% { transform: translateY(2px); } }

    /* --- a card's frame: centred at 1160px so the film shows on both sides, 16px gutters on a phone --- */
    .home-wrap { max-width: calc(1160px + 3rem); margin-inline: auto; padding-inline: 1rem; }
    @media (min-width: 640px) { .home-wrap { padding-inline: 1.5rem; } }

    /* --- a card's head: a line icon in a pale teal square, and the title ---------------------- */
    .home-head { display: flex; flex-wrap: wrap; align-items: center; gap: 0.25rem 0.75rem; }
    .home-head-icon {
      display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; flex: none;
      border-radius: var(--ws-r-ctl); background: var(--pane-tint); color: var(--ws-teal-ink);
    }
    .home-title { font-size: clamp(1.375rem, 1rem + 1.1vw, 1.875rem); line-height: 1.15; letter-spacing: -0.025em; color: var(--c-ink); }
    /* A link that belongs to the whole card sits at the end of its head (Partners' "See every clinic"). */
    .home-head-link { margin-left: auto; }
    .home-rule { margin-top: 0.75rem; background: var(--pane-rule); }
    .home-body { margin-top: 0.875rem; }
    /* A group inside a card ("For dental clinics"): 16px semibold, its icon in teal, its link beside it. */
    .home-group { display: flex; align-items: center; gap: 0.4375rem; font-size: 16px; font-weight: 600; line-height: 1.3; letter-spacing: -0.01em; color: var(--c-ink); }
    .home-group :global(.ws-icon) { flex: none; color: var(--ws-teal-ink); }
    .home-group-row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0 0.75rem; margin-bottom: 0.25rem; }

    /* A teal link with an arrow that steps forward on hover (44px tall). The deepest teal (--pane-link,
       #06403e): it stands on the glass itself, and swept every 25px of scroll the film's greenest patch
       behind a link (the blurred hedges) is rgb(166 176 157), where it still keeps 5:1. */
    .home-link {
      display: inline-flex; align-items: center; gap: 0.375rem; min-height: 44px; border-radius: var(--ws-r-ctl);
      font-size: 14.5px; font-weight: 600; color: var(--pane-link);
      text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 4px;
      transition: text-decoration-color 160ms ease;
