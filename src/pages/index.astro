    /* The Included side: its callout sits level with the foot of the price card beside it. */
    .home-included { display: flex; flex-direction: column; }
    .home-price-card { padding: 0.875rem 0.875rem 0.9375rem; }
    @media (min-width: 640px) { .home-price-card { padding: 1rem 1.125rem 1.0625rem; } }
    .home-price { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.125rem 0.625rem; }
    .home-price-num { font-size: clamp(2.5rem, 1.9rem + 1.6vw, 3.25rem); font-weight: 600; line-height: 1; letter-spacing: -0.04em; font-variant-numeric: tabular-nums; color: var(--c-ink); }
    .home-price-per { font-size: 15px; font-weight: 500; color: var(--c-ink-2); }
    /* While BILLING_FINAL is false: one quiet line under the price. */
    .home-price-note { display: flex; align-items: flex-start; gap: 0.4375rem; margin-top: 0.5rem; font-size: 13.5px; line-height: 1.45; color: var(--c-ink-2); }
    .home-price-note :global(.ws-icon) { flex: none; margin-top: 0.125rem; color: var(--ws-blue-ink); }
    .home-price-lede { margin-top: 0.625rem; font-size: 14.5px; line-height: 1.5; color: var(--c-ink-2); }
    .home-price-go { margin-top: 0.75rem; }
    @media (max-width: 639px) { .home-price-go { width: 100%; } }
    .home-price-small { margin-top: 0.625rem; font-size: 13.5px; line-height: 1.45; color: var(--c-ink-2); }
    .home-checks { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0 1.25rem; margin-top: 0.375rem; }
    @media (min-width: 640px) { .home-checks { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    .home-checks li { display: flex; align-items: flex-start; gap: 0.5625rem; padding-block: 0.3125rem; font-size: 14.5px; line-height: 1.4; color: var(--c-ink); }
    /* The check: white on the teal fill, like the step numbers (5.6:1 whatever the film is showing). */
    .home-check {
      display: inline-flex; align-items: center; justify-content: center; width: 20px; height: 20px; flex: none; margin-top: 0;
      border-radius: var(--ws-r-pill); background: var(--ws-teal-fill); color: #fff;
    }
    .home-check :global(.ws-icon) { stroke-width: 2.5; }
    .home-callout { margin-top: 0.75rem; padding: 0.625rem 0.875rem; border-color: var(--pane-edge); background: var(--pane-inner); font-size: 14.5px; }
    @media (min-width: 1024px) { .home-callout { margin-top: auto; } .home-checks { margin-bottom: 0.75rem; } }
    .home-callout :global(.ws-icon) { margin-top: 3px; color: var(--ws-teal-ink); }
    .home-callout-link {
      color: var(--pane-link); font-weight: 600; text-decoration: underline; text-underline-offset: 3px;
      /* A 44px target on a one-line link. */
      display: inline-block; padding-block: 0.75rem; margin-block: -0.75rem;
    }

    /* --- partners: lighter glass cards with the clinic's initials ------------------------------- */
    .home-partners { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0.375rem; }
    @media (min-width: 640px) { .home-partners { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @media (min-width: 1024px) { .home-partners { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
    .home-partner {
      display: flex; align-items: center; gap: 0.625rem; height: 100%; min-height: 44px; padding: 0.5625rem 0.625rem 0.5625rem 0.625rem;
      color: var(--c-ink); transition: background-color 160ms ease, border-color 160ms ease, box-shadow 160ms ease;
    }
    .home-partner:hover { background: var(--pane-inner-hover); box-shadow: var(--ws-shadow-pop); }
    .home-partner-name { display: block; font-size: 15px; font-weight: 600; line-height: 1.3; letter-spacing: -0.01em; transition: color 160ms ease; }
    .home-partner:hover .home-partner-name { color: var(--pane-link); }
    /* The clinic's badge, as on Find a clinic and in the workspace's sidebar (first two words, a
       rounded square), on the glass's pale teal. */
    .home-partner :global(.ws-branch-badge) { width: 40px; height: 40px; border-radius: var(--ws-r-ctl); font-size: 14px; }
    /* Every clinic reads the same three lines: its name, its area, then its pills together in one row
       (solid tints, so the film never thins their words). The pills wrap only where a card is too
       narrow for both (a 320px phone, a two-column card at 640px), rather than run past its edge. */
    .home-partner-area { display: block; margin-top: 0.0625rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 13.5px; line-height: 1.4; color: var(--c-ink-2); }
    .home-partner-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.25rem 0.375rem; margin-top: 0.25rem; }
    .home-partner :global(.home-partner-go) { flex: none; color: var(--c-ink-2); transition: transform 180ms ease, color 180ms ease; }
    .home-partner:hover :global(.home-partner-go) { transform: translateX(3px); color: var(--pane-link); }
    .home-empty { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1rem; }
    .home-empty-icon {
      display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; flex: none;
      border-radius: var(--ws-r-pill); background: var(--pane-tint); color: var(--ws-teal-ink);
    }
    .home-empty-text { max-width: 52ch; font-size: 15px; line-height: 1.5; color: var(--c-ink); }

    /* --- how to register: two lighter glass cards, the way in and its button, the film, the steps --- */
    .home-ways { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0.625rem; }
    @media (min-width: 1024px) { .home-ways { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem; } }
    .home-way { display: flex; flex-direction: column; padding: 0.625rem 0.625rem 0.75rem; }
    @media (min-width: 640px) { .home-way { padding: 0.75rem 0.875rem 0.875rem; } }
    .home-way-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.5rem 0.75rem; }
    @media (max-width: 639px) { .home-way-go { width: 100%; } }
    .home-way-film { margin-top: 0.625rem; }
