---
// /c/<slug>/claims/ — HMO and PhilHealth claims, from before the three tabs.
//
// People with Finances (canBill: the desk, the owner, the admin, anyone the
// owner lets see finance here) are sent to the claims section of Finances,
// with the filter, a post's answer and the CSV carried over:
//   ?view= → ?claims=, ?payor=, ?done=, ?missed=, ?stale= kept, ?export=csv → ?export=claims.
// It is a 307, so a form posted from a claims page left open before the move
// lands on Finances with its body and is handled there; never cached, because
// where it goes depends on who asks.
//
// Everyone else has no Finances tab, and claims were in everyone's menu
// before, so the list stays theirs here (their person menu links it): the
// claims, their status and aging, the notes, a new note and the CSV, never
// the amounts — the rule the claims page always had (canMoneyOf in
// ../finances/_claims.ts; all of this is shared with Finances through
// ../finances/_claims.ts and ../finances/_Claims.astro, which re-check it on
// every post).
//
// Very simple (the owner, 26 Sep 2026): the title is the top bar's, two
// numbers (open, overdue) on their own tiles, then the list.
export const prerender = false;

import '../finances/_fin.css';
import ClinicLayout from '../../../../layouts/Clinic.astro';
import Pane from '../../../../components/ws/Pane.astro';
import Tile from '../../../../components/ws/Tile.astro';
import Claims from '../finances/_Claims.astro';
import { requireWorkspace } from '../../../../lib/workspace';
import { withClinic } from '../../../../lib/db';
import { csrfOk, CSRF_MESSAGE } from '../../../../lib/csrf';
import {
  claimFilterFrom, loadClaims, postClaim, claimsCsv, CLAIM_DONE, CLAIM_MISSED, type ClaimPost,
} from '../finances/_claims';
import { can } from '../../../../lib/can';

const ws = await requireWorkspace(Astro);
if (ws instanceof Response) return ws;
const { clinic, session, branches } = ws;
const q = Astro.url.searchParams;
const base = `/c/${clinic.slug}/claims/`;

if (can(clinic, 'finance.bill')) {
  const to = new URLSearchParams({ show: 'claims' });
  const view = q.get('view');
  if (view && view !== 'open') to.set('claims', view);
  for (const k of ['payor', 'done', 'missed', 'stale']) { const v = q.get(k); if (v) to.set(k, v); }
  if (q.get('export')) to.set('export', 'claims');
  return new Response(null, { status: 307, headers: { location: `/c/${clinic.slug}/finances/?${to}`, 'cache-control': 'no-store' } });
}

// From here on: someone without Finances. No amounts, no money moves (canMoney is false for them).
const canMoney = can(clinic, 'finance.money');
const filter = claimFilterFrom(q, 'view');
const link = (changes: Record<string, string | null> = {}) => {
  const s = new URLSearchParams(q);
  for (const k of ['done', 'missed', 'stale', 'export']) s.delete(k);
  for (const [k, v] of Object.entries(changes)) if (v === null || v === '') s.delete(k); else s.set(k, v);
  if (s.get('view') === 'open') s.delete('view');
  const str = s.toString();
  return base + (str ? `?${str}` : '');
};

let post: ClaimPost | null = null;
if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  if (!csrfOk(Astro.cookies, f)) return Astro.redirect(link({ stale: '1' }), 303);
  const out = await postClaim(f, { clinicId: clinic.id, staffId: session.staffId, staffName: session.name, canMoney });
  if ('go' in out) return Astro.redirect(link({ done: out.go.done ?? null, missed: out.go.missed ?? null }), 303);
  post = out;
}

const data = await loadClaims(clinic.id, filter, canMoney);
if (q.get('export')) return claimsCsv(data, filter, canMoney, clinic.slug);
const area = (await withClinic(clinic.id, async (tx) => (await tx.query('select area from clinic where id = $1', [clinic.id])).rows[0]?.area)) as string | null;
---

<ClinicLayout groupId={clinic.group_id} clinic={{ slug: clinic.slug, name: clinic.name, area }} title="HMO & PhilHealth claims" section="claims" staff={{ name: session.name, role: session.role }} branches={branches} finance={clinic.can_view_finance} layout="panes" heading>
  <div class="ws-tiles" data-claims-tiles>
    <Tile label="Open claims" value={data.sums.waiting_n} icon="file" note="Filed and not paid yet" />
    <Tile label="Overdue" value={data.sums.stuck_n} icon="clock" tone={data.sums.stuck_n > 0 ? 'alert' : 'default'}
      note={data.sums.stuck_n > 0 ? 'Past the payor’s usual days: worth a call' : 'None past the payor’s usual days'} />
  </div>
  <Pane pad="none" title="Claims" icon="file" meta="From filing to payment">
    <Claims slug={clinic.slug} data={data} filter={filter} canMoney={canMoney} viewKey="view"
      link={link} action={link()} csvHref={link({ export: 'csv' })}
      post={post} error={q.get('stale') === '1' ? CSRF_MESSAGE : ''} notice={CLAIM_DONE[q.get('done') ?? ''] ?? ''} missed={q.get('missed') ? CLAIM_MISSED : ''} />
  </Pane>
</ClinicLayout>
