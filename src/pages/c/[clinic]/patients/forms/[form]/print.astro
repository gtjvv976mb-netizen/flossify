---
// A patient form on paper (A4, black on white): the clinic's name, who the
// patient is, every answer labelled from the form's own definition
// (answerSections), the consent to examination and treatment in its own words
// (TREATMENT_CONSENT for the version they agreed to), the privacy notice
// version, and the typed signature with its date. For the chart folder, or a
// dentist who wants the history on paper. The page is its own document; the
// bar at the top (the way back, one teal Print) does not print.
//
// Same gate as the form's page: a form still waiting only for people who can
// add patients here (canEditRecords); an added form for anyone who may open
// the branch's records. Printing is written to the audit log (forms.print):
// the paper carries a patient's health history.
export const prerender = false;

import '../../../../../../styles/global.css';
import { requireWorkspace } from '../../../../../../lib/workspace';
import { withClinic } from '../../../../../../lib/db';
import { canEditRecords, when, dateText, ageText } from '../../../../../../lib/health';
import { stamp } from '../../../../../../lib/invoices';
import { getForm, answerSections, answerText, FIELDS, TREATMENT_CONSENT, PRIVACY_TICK } from '../../../../../../lib/patient-forms';
import { DESK_STEP_TITLE, DESK_SECTION_TITLE } from '../../_forms/words';

const ws = await requireWorkspace(Astro);
if (ws instanceof Response) return ws;
const { clinic, session } = ws;
const formId = Astro.params.form ?? '';
const back = `/c/${clinic.slug}/patients/forms/${encodeURIComponent(formId)}/`;

const data = await withClinic(clinic.id, async (tx) => {
  const rec = await getForm(tx, formId);
  if (!rec) return null;
  if (rec.status !== 'added' && !(await canEditRecords(tx, session.staffId, clinic.id))) return null;
  const c = (await tx.query(`select name, address_line, barangay, city, province, phone from clinic where id = $1`, [clinic.id])).rows[0];
  await tx.query(`insert into audit_log (clinic_id, staff_id, action, entity, entity_id) values ($1, $2, 'forms.print', 'patient_form', $3)`, [clinic.id, session.staffId, rec.id]);
  return { rec, c };
});
if (!data) return new Response('No such form', { status: 404 });

const { rec, c } = data;
const v = rec.values;
const address = [c.address_line, c.barangay, c.city, c.province]
  .filter((part, i, all) => part && !all.slice(0, i).some((prev) => prev && String(prev).toLowerCase().includes(String(part).toLowerCase())))
  .join(', ');
// Under the desk's headings ("The patient", "Health history"): the paper is about someone else.
const steps = answerSections(v).filter((s) => s.id !== 'consent').map((st) => ({
  ...st, title: DESK_STEP_TITLE[st.id] ?? st.title,
  sections: st.sections.map((sec) => ({ ...sec, title: DESK_SECTION_TITLE[sec.id] ?? sec.title })),
}));
const treatment = TREATMENT_CONSENT[rec.treatmentVersion];
const born = dateText(v.birth_date);
const who = [born ? `Born ${born}` : null, rec.age !== null ? ageText(rec.age) : null, answerText(FIELDS.sex, v.sex), rec.mobile].filter(Boolean).join(' · ');
const signedAs = rec.signedAs === 'guardian' ? 'a parent or guardian, for the patient' : 'the patient';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Patient form {rec.ref} — {clinic.name}</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      try {
        const saved = localStorage.getItem('theme');
        if (saved) document.documentElement.dataset.theme = saved;
      } catch (e) {
        /* storage blocked: fall back to the OS preference */
      }
    </script>
    <style is:global>
      @page { size: A4 portrait; margin: 14mm 14mm 16mm; }
      .fp-body {
        --fp-bg: #f3f5f8; --fp-bar: #ffffff; --fp-hair: #e6e9ee; --fp-ink: #1f2937; --fp-teal-ink: #0d706d; --fp-teal-fill: #0e7471; --fp-teal-fill-hover: #0b5f5d; --fp-hover: rgb(16 24 40 / 0.035);
        margin: 0; background: var(--fp-bg);
        font-family: "Inter", ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      }
      @media screen and (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) .fp-body { --fp-bg: #15191e; --fp-bar: #1d232a; --fp-hair: #2a323b; --fp-ink: #e7ebf0; --fp-teal-ink: #7fdcd4; --fp-hover: rgb(255 255 255 / 0.055); }
      }
      @media screen { :root[data-theme="dark"] .fp-body { --fp-bg: #15191e; --fp-bar: #1d232a; --fp-hair: #2a323b; --fp-ink: #e7ebf0; --fp-teal-ink: #7fdcd4; --fp-hover: rgb(255 255 255 / 0.055); } }
      .fp-bar { background: var(--fp-bar); border-bottom: 1px solid var(--fp-hair); color: var(--fp-ink); }
      .fp-bar-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.625rem 0.75rem; max-width: 1280px; margin-inline: auto; padding: 0.75rem 1.25rem; }
      .fp-back { display: inline-flex; align-items: center; gap: 0.3rem; min-height: 44px; margin-right: auto; padding: 0 0.5rem; border-radius: 10px; font-size: 15px; font-weight: 600; color: var(--fp-teal-ink); }
      .fp-back:hover { background: var(--fp-hover); }
      .fp-print {
        display: inline-flex; align-items: center; gap: 0.5rem; min-height: 44px; padding: 0 1.125rem; border: 0; border-radius: 10px; background: var(--fp-teal-fill);
        color: #fff; font: inherit; font-size: 15px; font-weight: 600; cursor: pointer; transition: background-color 160ms ease;
      }
      .fp-print:hover { background: var(--fp-teal-fill-hover); }
      .fp-body :focus-visible { outline: 2px solid #14908f; outline-offset: 2px; }
      /* The paper: white with dark words in both themes, as it prints. */
      .fp-sheet {
        max-width: 190mm; margin: 2rem auto 3rem; padding: 14mm; background: #fff; color: #1f2937; border-radius: 12px;
        box-shadow: 0 1px 2px rgb(16 24 40 / 0.06), 0 12px 32px -8px rgb(16 24 40 / 0.18); font-size: 12.5px; line-height: 1.45; color-scheme: light;
      }
      .fp-sheet h1 { font-family: inherit; font-size: 19px; font-weight: 700; letter-spacing: -0.01em; }
      .fp-sheet h2 { font-family: inherit; margin: 16px 0 6px; padding-bottom: 4px; border-bottom: 1.5px solid #1f2937; font-size: 14px; font-weight: 700; break-after: avoid; }
      .fp-sheet h3 { margin: 10px 0 3px; font-size: 12px; font-weight: 700; color: #344054; break-after: avoid; }
      .fp-head { display: flex; justify-content: space-between; gap: 16px; padding-bottom: 10px; border-bottom: 1px solid #98a2b3; }
      .fp-clinic { font-size: 16px; font-weight: 700; }
      .fp-muted { color: #475467; }
      .fp-mono { font-family: var(--font-mono); font-size: 11.5px; }
      .fp-table { width: 100%; border-collapse: collapse; }
      .fp-table th, .fp-table td { padding: 3px 0; border-bottom: 1px solid #e4e7ec; text-align: left; vertical-align: top; }
      .fp-table th { width: 36%; padding-right: 10px; font-weight: 500; color: #475467; }
      .fp-table tr { break-inside: avoid; }
      .fp-flag { font-weight: 700; }
      .fp-consent { break-inside: avoid; }
      .fp-consent p + p { margin-top: 4px; }
      .fp-tick { display: flex; gap: 6px; margin-top: 6px; font-weight: 600; }
      .fp-sign { display: grid; grid-template-columns: 1fr 1fr; gap: 16px 24px; margin-top: 14px; break-inside: avoid; }
      .fp-line { margin-top: 22px; border-top: 1px solid #1f2937; padding-top: 3px; font-size: 11px; color: #475467; }
      .fp-foot { margin-top: 18px; padding-top: 8px; border-top: 1px solid #98a2b3; font-size: 10.5px; color: #475467; }
      @media print {
        .fp-bar { display: none !important; }
        .fp-body { background: #fff !important; }
        .fp-sheet { max-width: none; margin: 0; padding: 0; border-radius: 0; box-shadow: none; color: #000; }
      }
      @media (max-width: 640px) { .fp-sheet { margin: 1rem 0.5rem 2rem; padding: 18px 16px; } .fp-head { flex-direction: column; } .fp-sign { grid-template-columns: 1fr; } }
    </style>
  </head>
  <body class="fp-body">
    <div class="fp-bar">
      <div class="fp-bar-row">
        <a href={back} class="fp-back">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.5 6.5L9 12l5.5 5.5" /></svg>
          Back to the form
        </a>
        <button type="button" class="fp-print" data-print>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 9V4h10v5" /><rect x="3.5" y="9" width="17" height="7.5" rx="2" /><path d="M7 14h10v6H7z" /></svg>
          Print
        </button>
      </div>
    </div>

    <main>
      <article class="fp-sheet" aria-label={`Patient form ${rec.ref}`}>
        <header class="fp-head">
          <div>
            <p class="fp-clinic">{c.name}</p>
            {address && <p class="fp-muted">{address}</p>}
            {c.phone && <p class="fp-muted">{c.phone}</p>}
          </div>
          <div class="text-right max-sm:text-left">
            <p class="font-semibold">Patient forms</p>
            <p class="fp-mono">{rec.ref}</p>
            <p class="fp-muted">Sent {when(rec.submittedAt)}</p>
          </div>
        </header>

        <h1 class="mt-4">{rec.name}</h1>
        <p class="fp-muted">{who}</p>
        <p class="fp-muted">Patient information, health history and dental history, as the {rec.signedAs === 'guardian' ? 'parent or guardian' : 'patient'} filled them in. Answers marked ⚠ are for the dentist to see first.</p>

        {steps.map((s) => (
          <section>
            <h2>{s.title}</h2>
            {s.sections.length === 0 && <p class="fp-muted">Nothing filled in.</p>}
            {s.sections.map((sec) => (
              <>
                <h3>{sec.title}</h3>
                <table class="fp-table">
                  <tbody>
                    {sec.rows.map((r) => (
                      <tr><th scope="row">{r.label}</th><td class:list={[r.flag && 'fp-flag']}>{r.flag ? `⚠ ${r.text}` : r.text}</td></tr>
                    ))}
                  </tbody>
                </table>
              </>
            ))}
          </section>
        ))}

        <section class="fp-consent">
          <h2>Consent and signature</h2>
          {treatment ? (
            <>
              <h3>{treatment.title}</h3>
              {treatment.points.map((pt) => <p><strong>{pt.head}.</strong> {pt.body}</p>)}
              <p class="fp-tick"><span aria-hidden="true">☑</span><span>{treatment.tick}</span></p>
            </>
          ) : (
            <p>Consent to examination and treatment, version {rec.treatmentVersion}: agreed.</p>
          )}
          <h3>Privacy</h3>
          <p class="fp-tick"><span aria-hidden="true">☑</span><span>{PRIVACY_TICK}</span></p>
          <p class="fp-muted">The privacy notice in force when it was sent: version {rec.privacyVersion}, at flossify.ph/privacy/.</p>
          <div class="fp-sign">
            <div>
              <p class="fp-muted">Signed on the form (typed)</p>
              <p class="text-[14px] font-semibold">{rec.signedByName}</p>
              <p class="fp-muted">As {signedAs}, {when(rec.submittedAt)}</p>
            </div>
            <div>
              <p class="fp-line">Signature at the clinic, if the clinic asks for one · date</p>
            </div>
          </div>
        </section>

        <p class="fp-foot">
          Filled in on the patient’s own phone through {c.name}’s QR code on Flossify (form {rec.ref}, {rec.formVersion}).
          Printed {stamp(new Date())} by {session.name}. Sensitive personal information: keep it with the patient’s chart.
        </p>
      </article>
    </main>
    <script is:inline>document.querySelector('[data-print]')?.addEventListener('click', () => window.print());</script>
  </body>
</html>
