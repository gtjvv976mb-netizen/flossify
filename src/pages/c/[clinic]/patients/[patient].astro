const OPEN_PANEL: Record<string, string> = { vitals: 'health', note: 'notes', rx: 'rx', done: 'treatment', file: 'files', details: 'overview' };
const openNow = canEdit && Object.hasOwn(OPEN_PANEL, q.get('open') ?? '') ? q.get('open')! : null;
const dashVisit = UUID.test(q.get('dash') ?? '') ? q.get('dash')!.toLowerCase() : null;

