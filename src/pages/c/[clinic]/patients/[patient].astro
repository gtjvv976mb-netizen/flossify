const lower = (s: string) => s.toLocaleLowerCase('en');
const chipsFor = (key: (typeof LISTS)[number]['key'], picks: readonly string[]) => {
  const on = shown[key] ?? [];
  const extra = on.filter((v) => !picks.some((p) => lower(p) === lower(v)));
  return [...picks, ...extra].map((v) => ({ value: v, on: on.some((x) => lower(x) === lower(v)) }));
};
const healthChips = Object.fromEntries(LISTS.map((l) => [l.key, chipsFor(l.key, l.picks)]));
const healthNone = Object.fromEntries(LISTS.map((l) => [l.key, shown[l.key]?.length === 0]));

// A version from the patient forms (the QR poster, or an intake's page 1) is dated when it went on the record; the line says when it was sent.
const byLine = (v: HealthVersion) =>
  `${when(new Date(v.at))}${v.by ? ` by ${v.by}` : v.answeredBy === 'patient'
    ? v.intakeRef ? ` from the forms ${patient.first_name} filled in (${v.intakeRef}${v.formSentAt ? `, sent ${day(new Date(v.formSentAt))}` : ''})`
    : ` from the patient forms${v.formRef ? ` (${v.formRef}${v.formSentAt ? `, sent ${day(new Date(v.formSentAt))}` : ''})` : ''}` : ''}`;
const stateLine = (v: HealthAnswers) =>
  [...LISTS.map((l) => `${l.label} ${listText(v[l.key], l.key === 'allergies' ? 'none known' : 'none')}`), v.note && `Note: ${v.note}`].filter(Boolean).join(' · ');
const birthLine = (b: string | null) => `Birth date ${dateText(b) ?? 'not on file'}`;

// --- the head ---------------------------------------------------------------
const fullName = [patient.first_name, patient.middle_name, patient.last_name, patient.suffix].filter(Boolean).join(' ');
const shortName = `${patient.first_name} ${patient.last_name}`;
const titleName = patient.suffix ? `${shortName} ${patient.suffix}` : shortName;
// The paper's Gender box, in Edit details' words.
const SEX: Record<string, string> = Object.fromEntries(SEXES.map((x) => [x.id, x.label]));
const balance = fromDb(patient.balance);
const lastVisit = visits.find((v) => v.status === 'completed') ?? null;
const nextVisit = data.next;
const nextParts = (d: Date) => new Intl.DateTimeFormat('en-US', { weekday: 'short', day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit', timeZone: 'Asia/Manila' }).formatToParts(d).reduce((o, x) => ({ ...o, [x.type]: x.value }), {} as Record<string, string>);
// A visit under way (arrived, waiting, in the chair) is the one that matters now.
const HERE: Record<string, string> = { arrived: 'Arrived', in_lobby: 'Waiting', in_chair: 'In the chair' };
const hereNow = nextVisit ? HERE[nextVisit.status] ?? null : null;
// The next visit in a few words, for the Appointments sheet's line: "Today, in the chair", "Thu 8 Oct, 9:00 am".
const nextWords = nextVisit ? hereNow ? `Today, ${hereNow.toLowerCase()}` : (() => { const x = nextParts(nextVisit.starts_at); return `${x.weekday} ${x.day} ${x.month}, ${x.hour}:${x.minute} ${String(x.dayPeriod).toLowerCase()}`; })() : null;
const bookHref = `${links.newBooking}&patient=${patient.id}`;
const chargeHref = `${links.newCharge}?patient=${patient.id}`;
const importHref = `/c/${clinic.slug}/patients/import/`;

// --- sections ---------------------------------------------------------------
const clin = data.clinical;
const ext = data.extra;
// Where each clinician's PTR is fixed (the prescription and letter panels' notes, 041): your own on My page; someone
// else's on their page in Clinic settings when you may change their details there (people.manage and the rank rule
// that draws Edit details on their page); otherwise nowhere you can reach, and the note says so in words.
const ptrFix: Record<string, PtrFix | null> = Object.fromEntries(clin.clinicians.map((x) => [x.id,
  x.id === session.staffId ? { self: true, href: `/c/${clinic.slug}/account/#ptr` }
  : can(clinic, 'people.manage') && x.rank !== null && mayManage(clinic, { role_rank: x.rank, role_owner: x.isOwner }, false)
    ? { self: false, href: `/c/${clinic.slug}/settings/people/${x.id}/#prc` }
    : null]));
// The head's safety chips (034): the latest blood pressure when it was taken today or is out of range, and
// whether a physician's clearance is needed (a high reading in the last 30 days with no clearance since, a
// request still waiting, or a physician who did not clear) — always words, never colour alone.
const latestBp = ext.vitals.find((x) => x.sys && x.dia) ?? null;
const bpNow = latestBp ? bpWords(latestBp.sys!, latestBp.dia!) : null;
const bpDay = latestBp ? manilaDay(new Date(latestBp.at)) : null;
const bpRecent = !!latestBp && Date.now() - +new Date(latestBp.at) < 30 * 864e5;
const bpChip = latestBp && bpNow && (bpDay === today || (bpRecent && bpNow.tone !== 'neutral'))
  ? { text: `BP ${latestBp.sys}/${latestBp.dia}${bpDay === today ? ' today' : ` on ${dateText(bpDay)}`}${bpNow.tone !== 'neutral' ? ` · ${bpNow.label.toLowerCase()}` : ''}`, tone: bpNow.tone } : null;
const lastClearance = ext.letters.find((l) => l.kind === 'clearance') ?? null;
const clearedSince = !!lastClearance?.answer && lastClearance.answer !== 'not_cleared' && !!bpDay && (lastClearance.answeredOn ?? '') >= bpDay;
const clearance: { text: string; tone: 'alert' | 'warn' | 'accent' } | null =
  lastClearance && !lastClearance.answer ? { text: 'Waiting for medical clearance', tone: 'warn' }
  : lastClearance?.answer === 'not_cleared' ? { text: 'Physician has not cleared treatment', tone: 'alert' }
  : bpRecent && (bpNow?.level === 'high' || bpNow?.level === 'crisis') && !clearedSince ? { text: 'Needs medical clearance', tone: 'alert' }
  : lastClearance?.answer && lastClearance.answeredOn && Date.now() - Date.parse(`${lastClearance.answeredOn}T00:00:00+08:00`) < 180 * 864e5 ? { text: `Cleared by physician ${dateText(lastClearance.answeredOn)}`, tone: 'accent' }
  : null;
const behindPlans = money ? ext.plans.filter((x) => x.status === 'active' && x.missed > 0) : [];
const loaWaiting = ext.loas.filter((a) => a.status === 'requested').length;
const planOpen = clin.plan.filter((i) => i.status === 'planned' || i.status === 'accepted');
// --- work on the chart (p01) ----------------------------------------------------
// Open plan items and work done in the past year, per tooth on the chart (permanent and baby): a ring and a dot under
// the tooth's number, and a sentence in its label ("On the plan: Filling MO. Treated in the past year: Root canal, 12
// Mar 2026."). Work on a baby tooth also opens the chart's baby teeth.
const workSince = Date.now() - 365 * 864e5;
const chartWork: Partial<Record<number, { plan: string[]; done: string[] }>> = {};
for (const i of planOpen) if (i.fdi && isOnChart(i.fdi)) (chartWork[i.fdi] ??= { plan: [], done: [] }).plan.push(`${i.name}${i.surface ? ` ${i.surface}` : ''}`);
for (const d of clin.done) if (d.fdi && isOnChart(d.fdi) && +new Date(d.at) >= workSince) (chartWork[d.fdi] ??= { plan: [], done: [] }).done.push(`${d.name}, ${dateText(manilaDay(new Date(d.at)))}`);
// The baby teeth show open for a child (under 13 by the birth date on file); for anyone else when one of them has a
// finding or work (the chart decides that itself), else behind its "Baby teeth" button.
const babyOpen = age !== null && age < 13;
// A new note's teeth: those of today's treatments (the This visit strip's visit, and today's with no visit named).
const noteTeeth = [...new Set(clin.done.filter((d) => d.fdi && ((thisVisit && d.visitId === thisVisit.id) || (manilaDay(new Date(d.at)) === today && !d.visitId))).map((d) => d.fdi!))];
// The line the Chart shows after a save from a panel its palette opened.
const CHART_SAVED: Record<string, string> = {
  plan: 'Added to the plan. Teeth with planned work have a ring under their number.',
  'plan-done': 'Marked done, and added to treatments done.',
  done: 'Treatment recorded.',
  note: 'Note saved under your name.',
};
// The parts of the record, in the paper record's order: page 1 the chart and the patient information record (its
// basic information, dental and medical history), page 2 the informed consent, page 3 the treatment record; then
// what is attached to it (page 0), folded. The pages are numbered, not the parts.
const SECTIONS: { id: string; label: string; short: string; page: 0 | 1 | 2 | 3 }[] = [
  { id: 'chart', label: 'Patient’s chart', short: 'Chart', page: 1 },
  { id: 'overview', label: 'Patient information record', short: 'Patient information', page: 1 },
  { id: 'health', label: PLACE.medicalHistory, short: PLACE.medicalHistory, page: 1 },
  { id: 'consent', label: 'Informed consent', short: 'Consent', page: 2 },
  { id: 'treatment-record', label: 'Treatment record', short: 'Treatment record', page: 3 },
  { id: 'treatment', label: 'Treatment', short: 'Treatment', page: 0 },
  { id: 'notes', label: 'Clinical notes', short: 'Notes', page: 0 },
  { id: 'rx', label: 'Prescriptions and letters', short: 'Rx and letters', page: 0 },
  { id: 'files', label: PLACE.files, short: 'X-rays', page: 0 },
  { id: 'visits', label: 'Appointments', short: 'Appointments', page: 0 },
  ...(money ? [{ id: 'money', label: 'Account', short: 'Account', page: 0 as const }] : []),
  { id: 'texts', label: 'Texts', short: 'Texts', page: 0 },
];
const PAGES = 3;
const pageWho = `${fullName} · Chart # ${patient.chart_no} · `;
const contents = [1, 2, 3, 0].map((n) => ({ label: n ? `Page ${n}` : 'Attached', items: SECTIONS.filter((x) => x.page === n).map((x) => ({ id: x.id, label: x.short, full: x.label })) }));
// Where a save lands: Go ahead anyway on This visit lands on the strip, at the front of page 1.
const savedTo: Record<string, string> = { intake: 'overview', 'consent-ahead': 'this-visit', capacity: 'consent', 'consent-removed': 'consent', health: 'health', birth: 'health', nothing: 'health', consent: 'consent', 'consent-already': 'consent', paper: 'consent', details: 'overview', new: 'overview', form: 'overview' };

// --- a patient form just added ------------------------------------------------
// The consents as the record has them now, in words (never a claim the rows do not make).
const CONSENT_KIND: Record<'privacy' | 'treatment', string> = { privacy: 'the privacy notice', treatment: 'the consent to examination and treatment' };
const consentWords = (st: { privacy: FormConsentState; treatment: FormConsentState }) => {
  const from = (['treatment', 'privacy'] as const).filter((k) => st[k] === 'form').map((k) => CONSENT_KIND[k]);
  const onFile = (['treatment', 'privacy'] as const).filter((k) => st[k] === 'on-file').map((k) => CONSENT_KIND[k]);
  const none = (['treatment', 'privacy'] as const).filter((k) => st[k] === 'none');
  return { from, onFile, none };
};
const addedConsents = data.addedLine ? consentWords(data.addedLine.consentState) : null;
const andList = (xs: string[]) => (xs.length <= 1 ? xs.join('') : `${xs.slice(0, -1).join(', ')} and ${xs[xs.length - 1]}`);
// What the new health version kept from the record that the form did not say (Add to <patient>).
const lowerEq = (a: string, b: string) => a.toLocaleLowerCase('en') === b.toLocaleLowerCase('en');
const keptFromRecord = (() => {
  const src = data.added?.addedAs === 'existing' ? { ref: data.added.ref, values: data.added.values, kind: 'form' as const }
    : data.addedIntake?.addedAs === 'existing' ? { ref: data.addedIntake.ref, values: data.addedIntake.values, kind: 'intake' as const } : null;
  if (!src) return [] as string[];
  const v = health.versions.find((x) => (src.kind === 'form' ? x.formRef : x.intakeRef) === src.ref);
  if (!v) return [];
  const fromForm = healthLists(src.values);
  return (['allergies', 'conditions', 'medications'] as const).flatMap((k) => (v[k] ?? []).filter((x) => !fromForm[k].some((y) => lowerEq(x, y))));
})();
// What a form or an intake just added says that the record does not, and the post that takes one detail (form-use / intake-use).
const differs = data.added ? { kind: 'form' as const, id: data.added.id, intent: 'form-use', param: 'form', list: data.addedDiffers, says: 'The form says', from: 'the form' }
  : data.addedIntake ? { kind: 'intake' as const, id: data.addedIntake.id, intent: 'intake-use', param: 'intake', list: data.intakeDiffers, says: 'Their forms say', from: 'their forms' } : null;
const used = q.get('used');
const usedLabel = used ? ({ phone: 'mobile', email: 'email', address_line: 'address', city: 'city', province: 'province', sex: 'sex', occupation: 'occupation',
  emergency_name: 'emergency contact', emergency_relation: 'emergency contact’s relation', emergency_phone: 'emergency contact’s number',
  guardian_name: 'parent or guardian', guardian_relation: 'parent or guardian’s relation', guardian_phone: 'parent or guardian’s mobile',
  hmo_name: 'HMO', hmo_member_no: 'HMO card number', middle_name: 'middle name', suffix: 'suffix' } as Record<string, string>)[used] ?? 'detail' : null;
// A clinical-record save names its part by its first word (plan-done, rx:<id>, files:3, recall-cleared …).
const recordSaved = partOf;
// The part the page opens on: where a post came back to, the part of what was just saved, the part of a panel to
// open, the Treatment record (or Appointments) for another day's visit (?visit=), else the top of the paper ('').
// ?back=chart: a save from a panel the chart's palette opened lands on the Chart.
const fromChart = q.get('back') === 'chart';
// The chart's offer after a treatment (p01 step 2): its state, a write that was skipped (the tooth changed, or the page's
// sign-in ended), or a refused Update the chart. Drawn at the top of the section the post came back to, only.
const offerState = data.offerState;
const chartSkip = q.get('chartskip') === 'changed' || q.get('chartskip') === 'ended' ? (q.get('chartskip') as 'changed' | 'ended') : null;
const offerProblem = recordProblem?.intent === 'chart-apply' ? recordProblem : null;
const showOffer = canEdit && (!!offerProblem || !!chartSkip || !!(offerState && (offerState.applied || calloutWorthy(offerState.offer))));
const current = backTo ?? (fromChart ? 'chart' : null) ?? savedTo[saved ?? ''] ?? recordSaved(saved) ?? (openNow ? OPEN_PANEL[openNow] : openVisit && !thisVisit ? (data.ledger.openKeys.has(openVisit) ? 'treatment-record' : 'visits') : '');
// The attached sheets drawn open: the one the page opens on, and the one holding a side panel the server draws open (a
// refused post's, a rate-limited one's too, or ?open=…): a dialog in a closed sheet is not drawn, and the page behind
// it would still be inert.
const openSheets = new Set([current, partOf(recordProblem?.intent), openNow ? OPEN_PANEL[openNow] : null].filter(Boolean));
// "Leave the chart as it is": the same address without the offer (and without the saved line it came with).
const leaveOffer = (section: string) => {
  const u = new URLSearchParams(q);
  for (const k of ['treated', 'chartskip', 'saved']) u.delete(k);
  const rest = u.toString();
  return `${here}${rest ? `?${rest}` : ''}#${section}`;
};
// The privacy notice, for the strip: agreed and in force, or what is missing.
const privacyState = { ok: !data.notice || (!!consentNow && !guardianNeeded), words: guardianNeeded ? 'Privacy notice: a parent or guardian must agree for a patient under 18' : 'Privacy notice: not agreed yet' };
// A health history over a year old is asked again (the head says so; the strip offers "No change").
const staleHealth = !!latest && answered(latest) && Date.now() - +new Date(latest.at) > 365 * 864e5;
const SECTION_LABEL = Object.fromEntries(SECTIONS.map((x) => [x.id, x.label])) as Record<string, string>;

// --- money --------------------------------------------------------------------
const stmts = data.statements.map((s) => {
  const total = fromDb(s.total), paid = fromDb(s.paid);
  return { ...s, total, paid, left: s.status === 'void' ? 0n : total - paid };
});
const paidAll = stmts.filter((s) => s.status !== 'void').reduce((n, s) => n + s.paid, 0n);
const openCount = stmts.filter((s) => s.status === 'issued' || s.status === 'partly_paid').length;
// A statement's status as a soft pill: paid is green (money in), unpaid red, part-paid amber, void quiet.
const STMT_TINT: Record<string, string> = { paid: 'ws-tint-green', issued: 'ws-tint-red', partly_paid: 'ws-tint-amber' };

// --- texts ---------------------------------------------------------------------
const TEXT_KIND: Record<string, string> = { confirmation: 'Booking confirmation', reminder: 'Reminder', manual: 'Note', reply: 'Reply', recall: 'Check-up due', aftercare: 'Aftercare' };
const textStatus = (m: { direction: string; status: string }) =>
  m.direction === 'in' ? { label: 'Received', tone: 'accent' as const }
  : m.status === 'failed' ? { label: 'Failed', tone: 'alert' as const }
  : m.status === 'delivered' ? { label: 'Delivered', tone: 'accent' as const }
  : m.status === 'sent' ? { label: 'Sent', tone: 'muted' as const }
  : m.status === 'cancelled' ? { label: 'Cancelled', tone: 'muted' as const }
  : { label: 'Waiting to send', tone: 'neutral' as const };

// --- details -------------------------------------------------------------------
const d: PersonIn = detailsPosted ?? {
  chartNo: patient.chart_no, first: patient.first_name, middle: patient.middle_name, last: patient.last_name, suffix: patient.suffix, sex: patient.sex,
  phone: patient.phone, email: patient.email, address: patient.address_line, city: patient.city, province: patient.province, hmoName: patient.hmo_name,
  hmoMemberNo: patient.hmo_member_no, emergencyName: patient.emergency_name, emergencyRelation: patient.emergency_relation, emergencyPhone: patient.emergency_phone, notes: patient.notes,
  occupation: patient.occupation, guardianName: patient.guardian_name, guardianRelation: patient.guardian_relation, guardianPhone: patient.guardian_phone,
};
const address = [patient.address_line, patient.city, patient.province].filter(Boolean).join(', ');
/** One box of the paper's Basic information: its label, the value, its width (of six), and where it is changed (the
 *  plus): a field of Edit details, the caret put in `field`; or, for the birth date and the age, the medical history's
 *  form, where the birth date's history is kept (`go`). `what` names it for a screen reader. */
interface Box { label: string; value: string | null; span: 1 | 2 | 3 | 4; field: string; go?: string; what: string; empty?: string }
// The paper's rows, in its order and words: Patient name | Occupation; Date of birth | Age | Gender | Contact number |
// Email address; Address | Parent's or guardian's name.
const basic: Box[] = [
  { label: 'Patient name', value: fullName, span: 4, field: 'last_name', what: 'name' },
  { label: 'Occupation', value: patient.occupation, span: 2, field: 'occupation', what: 'occupation' },
  { label: 'Date of birth', value: dateText(patient.birth), span: 1, field: 'birth_date', go: 'health-form', what: 'date of birth' },
  { label: 'Age', value: age === null ? null : age < 1 ? 'Under 1' : String(age), span: 1, field: 'birth_date', go: 'health-form', what: 'birth date' },
  { label: 'Gender', value: patient.sex ? SEX[patient.sex] : null, span: 1, field: 'sex', what: 'gender' },
  { label: 'Contact number', value: patient.phone ? prettyPhone(patient.phone) : null, span: 1, field: 'mobile', what: 'contact number' },
  { label: 'Email address', value: patient.email, span: 2, field: 'email', what: 'email address' },
  { label: 'Address', value: address || null, span: 4, field: 'address', what: 'address' },
  // An adult's line stays blank, as on paper: no "Not on file" asking for a guardian nobody needs.
  { label: 'Parent’s or guardian’s name', value: [patient.guardian_name, patient.guardian_relation, patient.guardian_phone && prettyPhone(patient.guardian_phone)].filter(Boolean).join(' · ') || null,
    span: 2, field: 'guardian_name', what: 'parent or guardian', empty: minor || age === null ? undefined : '—' },
];
// What the paper does not ask and the clinic needs, in a second row of boxes under it.
const more: Box[] = [
  { label: 'HMO', value: patient.hmo_name ? `${patient.hmo_name}${patient.hmo_member_no ? ` · member no. ${patient.hmo_member_no}` : ''}` : null, span: 2, field: 'hmo_name', what: 'HMO' },
  { label: 'Emergency contact', value: patient.emergency_name ? [patient.emergency_name, patient.emergency_relation, patient.emergency_phone && prettyPhone(patient.emergency_phone)].filter(Boolean).join(' · ') : null, span: 2, field: 'emergency_name', what: 'emergency contact' },
];
const editOf = (b: Box) => (canEdit ? { label: `${b.value ? 'Change' : 'Add'} the ${b.what}${b.go ? ' (on the medical history)' : ''}`, open: b.go ? undefined : 'details', go: b.go, field: b.field } : undefined);
// The paper's Date: who opened the chart, for its tooltip.
const openedBy = patient.imported ? 'From an import' : patient.created_by_name ? `Added by ${patient.created_by_name}` : undefined;
const help = 'text-[13px] leading-snug text-muted';
// The newest X-ray taken here, beside the paper's "Date of last dental X-ray".
const xrayHere = clin.files.filter((f) => f.kind.startsWith('xray_') || f.kind === 'cbct').map((f) => f.takenAt ?? manilaDay(f.at)).sort().at(-1) ?? null;

// --- the attached sheets: each folded to its name and a few words of where it stands ---------------------------
const n = (k: number, one: string, many: string) => `${k} ${k === 1 ? one : many}`;
const labsOpen = clin.labs.filter((l) => l.status !== 'fitted').length;
const plansActive = ext.plans.filter((x) => x.status === 'active').length;
const STATUS: Record<string, string> = {
  treatment: [planOpen.length && `${planOpen.length} on the plan`, labsOpen && n(labsOpen, 'lab case open', 'lab cases open'),
    loaWaiting && n(loaWaiting, 'LOA waiting', 'LOAs waiting'), plansActive && n(plansActive, 'payment plan', 'payment plans')].filter(Boolean).join(' · ')
    || (clin.done.length ? n(clin.done.length, 'treatment done', 'treatments done') : 'Nothing yet'),
  notes: clin.notes.length ? `${n(clin.notes.length, 'note', 'notes')} · latest ${dateText(clin.notes[0].visitOn)}` : 'None yet',
  rx: [clin.rx.length && n(clin.rx.length, 'prescription', 'prescriptions'), ext.letters.length && n(ext.letters.length, 'letter', 'letters')].filter(Boolean).join(' · ') || 'None yet',
  files: clin.files.length ? n(clin.files.length, 'file', 'files') : 'None yet',
  visits: [nextWords && `Next ${nextWords}`, clin.recall && `check-up due ${dateText(clin.recall.dueOn)}`].filter(Boolean).join(' · ')
    || (lastVisit ? `Last ${dateText(manilaDay(lastVisit.starts_at))}` : visits.length ? n(visits.length, 'visit', 'visits') : 'None yet'),
  money: balance > 0n ? `${pesos(balance)} owed` : balance < 0n ? `${pesos(-balance)} in credit` : 'Nothing owed',
  texts: data.texts.length ? `${n(data.texts.length, 'text', 'texts')} · latest ${dateText(manilaDay(new Date(data.texts[0].created_at)))}` : 'None yet',
};
STATUS.visits = STATUS.visits.charAt(0).toUpperCase() + STATUS.visits.slice(1);
const formsBase = `/c/${clinic.slug}/patients/forms/`;
const moreItems = (money ? 1 : 0) + (canEdit ? 7 : 0);
const recHere = here;
---

<ClinicLayout groupId={clinic.group_id} clinic={{ slug: clinic.slug, name: clinic.name, area: me.area }} title={titleName} section="patient" staff={{ name: session.name, role: session.role }} branches={branches} finance={clinic.can_view_finance} layout="panes" heading>
  {/* The patient's name is the page's title, in the top bar (the layout's heading), as on a
      person's page and a statement. This card is what the paper does not say: the way back, the
      actions, the safety chips and the contents. Every fact is on the paper below, once. */}
  <Pane as="div" label={`${shortName}, patient record`} class="pp-top">
    <script>
      // Back to the list as it was left: the same search, filter and sort (./_list/back.ts).
      import { restoreBackLinks } from './_list/back';
      restoreBackLinks();
    </script>
    <div class="pp-top-row">
      <div class="rec-who">
        <a href={`/c/${clinic.slug}/patients/`} class="rec-back" data-pts-back><Icon name="chevron-left" /><span class="sr-only">Back to </span>Patients</a>
      </div>
      <div class="rec-actions">
        <a href={bookHref} class="ws-btn ws-btn-primary md:order-last"><Icon name="calendar" />New booking</a>
        {canEdit && <Plus text="Edit details" label={`Edit ${patient.first_name}’s details`} open="details" />}
        {/* The three pages as the paper is (record.css, "Printed"); the page tells the audit log as it prints. */}
        <button type="button" class="ws-btn ws-btn-quiet" data-rec-print={csrf}><Glyph name="print" size={16} />Print<span class="max-sm:sr-only"> the record</span></button>
        {moreItems > 0 && (
          <Menu id="rec-more" label={`More for ${shortName}`} buttonClass="ws-btn ws-btn-quiet" align="right">
            <Fragment slot="button">More <Icon name="chevron" size={16} /></Fragment>
            {canEdit && (
              <>
                <button type="button" class="ws-menu-item" data-ws-open="rec-note-add" data-amends="">
                  <span class="ws-menu-icon" data-tint="blue"><Glyph name="pen" /></span>
                  <span class="ws-menu-words">Clinical note<span class="ws-menu-hint">What was found and done today</span></span>
                </button>
                <button type="button" class="ws-menu-item" data-ws-open="rec-plan-add">
                  <span class="ws-menu-icon" data-tint="green"><Glyph name="plan" /></span>
                  <span class="ws-menu-words">Add to treatment plan<span class="ws-menu-hint">With the price from your fee guide</span></span>
                </button>
                <button type="button" class="ws-menu-item" data-ws-open="rec-rx-add">
                  <span class="ws-menu-icon" data-tint="blue"><Glyph name="pill" /></span>
                  <span class="ws-menu-words">Prescription<span class="ws-menu-hint">With the PRC and PTR on file</span></span>
                </button>
                <button type="button" class="ws-menu-item" data-ws-open="rec-vitals-add">
                  <span class="ws-menu-icon" data-tint="red"><Glyph name="heart" /></span>
                  <span class="ws-menu-words">Take blood pressure<span class="ws-menu-hint">Before anaesthesia</span></span>
                </button>
                <button type="button" class="ws-menu-item" data-ws-open="rec-letter-add" data-letter-kind="certificate">
                  <span class="ws-menu-icon" data-tint="blue"><Glyph name="form" /></span>
                  <span class="ws-menu-words">Dental certificate<span class="ws-menu-hint">Or a referral, or medical clearance</span></span>
                </button>
                <button type="button" class="ws-menu-item" data-ws-open="rec-file-add">
                  <span class="ws-menu-icon" data-tint="blue"><Glyph name="image" /></span>
                  <span class="ws-menu-words">Add X-ray or photo<span class="ws-menu-hint">Or a document, as a PDF</span></span>
                </button>
              </>
            )}
            {money && (
              <a class="ws-menu-item" href={chargeHref}>
                <span class="ws-menu-icon" data-tint="green"><Icon name="money" /></span>
                <span class="ws-menu-words">New charge<span class="ws-menu-hint">A statement for {patient.first_name} to pay</span></span>
              </a>
            )}
            {canEdit && (
              <a class="ws-menu-item" href={importHref}>
                <span class="ws-menu-icon" data-tint="blue"><Icon name="upload" /></span>
                <span class="ws-menu-words">Bring in past visits<span class="ws-menu-hint">From a spreadsheet of old records</span></span>
              </a>
            )}
          </Menu>
        )}
      </div>
    </div>

    {(allergies.length > 0 || conditions.length > 0 || medications.length > 0 || minor || bpChip || clearance || behindPlans.length > 0 || loaWaiting > 0 || staleHealth) && (
      <div role="alert" class="rec-alerts mt-2">
        {allergies.map((a) => <Chip tone="alert" icon="alert">Allergy: {a}</Chip>)}
        {conditions.map((c) => <Chip tone="warn">{c}</Chip>)}
        {medications.map((m) => <Chip tone="neutral">Takes {m}</Chip>)}
        {bpChip && <button type="button" class="rec-chip-go" data-rec-go="health"><Chip tone={bpChip.tone === 'neutral' ? 'neutral' : bpChip.tone} icon={bpChip.tone === 'neutral' ? undefined : 'alert'} label={bpChip.text} /></button>}
        {clearance && <button type="button" class="rec-chip-go" data-rec-go="rx"><Chip tone={clearance.tone} icon={clearance.tone === 'accent' ? 'check' : 'alert'} label={clearance.text} /></button>}
        {loaWaiting > 0 && <button type="button" class="rec-chip-go" data-rec-go="treatment"><Chip tone="warn" icon="clock" label={loaWaiting === 1 ? 'Waiting for an HMO LOA' : `Waiting for ${loaWaiting} HMO LOAs`} /></button>}
        {behindPlans.map((x) => <button type="button" class="rec-chip-go" data-rec-go="treatment"><Chip tone="alert" icon="money" label={`${x.title}: behind ${x.missed === 1 ? 'one month' : `${x.missed} months`}`} /></button>)}
        {minor && <Chip tone="warn" icon="user">{guardianNeeded ? 'Under 18: a guardian must agree' : `Under 18 · guardian ${consentNow?.given_by_name}`}</Chip>}
        {staleHealth && <button type="button" class="rec-chip-go" data-rec-go="health"><Chip tone="warn" icon="clock" label={`Health history last checked ${day(new Date(latest!.at))}: ask again`} /></button>}
      </div>
    )}
    {latest?.note && <Callout tone="alert" role="none" class="mt-3" title="Note for the dentist" text={latest.note} />}
    {stale && <Callout tone="alert" class="mt-4" text={CSRF_MESSAGE} />}
    {/* A refused post whose form is not on this page for this person (no records.edit, or a payment plan without finance.bill): its sentence here. */}
    {recordProblem && (!canEdit || (recordProblem.intent === 'payplan-add' && !money)) && <Callout tone="alert" class="mt-4" text={`${recordProblem.text} Nothing was saved.`} />}

    {/* The contents (./_record/RecordNav.astro): the three pages, then what is attached. */}
    <RecordNav groups={contents} name={shortName} />
  </Pane>

  {/* The record's body: the paper record's three pages, then what is attached to it (data-rec-start: the part a post
      comes back to). The side panels that open over any part sit first, outside the pages. */}
  <div class="rec-body" data-rec-start={current}>
  <div class="rec-main">

  {/* Every visit's panel, outside the parts so it opens from the Treatment record's dates and from Appointments alike. */}
  <VisitPanels visits={data.fullVisits} slug={clinic.slug} patientId={patient.id} canEdit={canEdit} money={money} open={thisVisit && openVisit === thisVisit.id ? null : openVisit} today={today} firstName={patient.first_name} />
  {/* Add to plan, Record a treatment and the note, outside the parts too, so the chart's palette can open them over the Chart. */}
  {canEdit && <TreatmentPanels c={clin} loas={ext.loas} canEdit={canEdit} action={recHere} meId={session.staffId} problem={recordProblem} today={today} firstName={patient.first_name} visitId={thisVisit?.id ?? null} openNow={openNow === 'done'} chartSid={chartSid} gaps={data.gaps.byPlanItem} />}
  {canEdit && <NotePanel c={clin} canEdit={canEdit} action={recHere} meId={session.staffId} problem={recordProblem} today={today} firstName={patient.first_name} visitId={thisVisit?.id ?? null} openNow={openNow === 'note'} defaultTeeth={noteTeeth} />}

  <!-- Page 1: the letterhead, the patient's chart, the patient information record -->
  <article class="pp-sheet pp-page" aria-label={`Page 1 of ${PAGES}`}>
    {/* Today's visit, a note clipped to the front of the paper: what is still to do at it and what is done (036). */}
    {thisVisit && (
      <VisitStrip visit={thisVisit} c={clin} x={ext} signed={data.signed} consented={data.consentedIds.has(thisVisit.id)} health={latest} privacy={privacyState} minor={minor} laterVisitAt={laterVisitAt}
        canEdit={canEdit} money={money} today={today} firstName={patient.first_name} action={here} chargeHref={`${chargeHref}&visit=${thisVisit.id}`} printBase={`${here}rx/`}
        saved={saved} problem={stripProblem} forms={data.fullVisits.find((v) => v.id === thisVisit.id)?.forms ?? []} consentsBase={`${here}consents/`} aheadDoc={aheadDoc} />
    )}
    <Letterhead clinic={me} chartNo={patient.chart_no} opened={patient.opened} openedBy={openedBy} canEdit={canEdit} />

    <!-- The patient's chart -->
    <div id="rec-chart" role="region" aria-labelledby="rec-chart-title" class="rec-sec min-w-0 grid content-start" data-rec-panel="chart">
      <Banner id="chart" label={SECTION_LABEL['chart']} />
      {fromChart && saved && CHART_SAVED[saved] && <Callout tone="success" text={CHART_SAVED[saved]} />}
      {showOffer && current === 'chart' && <ChartOffer state={offerState} skip={chartSkip} problem={offerProblem} action={recHere} sid={chartSid} visitId={thisVisit?.id ?? null} back="chart" leaveHref={leaveOffer('chart')} inChart />}
      <Pane as="section" label="Chart" id="chart" class="pt-chart-pane">
        <Head icon="tooth" title="Chart" />
        {/* The odontogram (src/components/Odontogram.astro, its offline logic untouched): the paper's codes over each
            tooth and its legend under the arches (`codes`), the palette's record actions for people who may edit
            records, the plan and done marks for everyone; drawn soft by patients.css ("The chart") and laid out by
            the width of this card. Where a whole arch still cannot fit (a phone) the line below says so. */}
        <p class="pt-chart-scroll" data-pt-chart-scroll hidden>Scroll sideways to see every tooth <Icon name="arrow-right" size={16} /></p>
        <div class="pt-chart" data-pt-chart>
          <Odontogram codes primary primaryOpen={babyOpen} marks={marks} notation={me.notation as Notation} saveUrl="/api/chart" patientId={patient.id} clinic={clinic.slug} csrf={csrf} actions={canEdit} work={chartWork} />
        </div>

        {/* The chart's history (tooth_state, grouped by the minute and the person), newest first. */}
        {data.chartChanges.length > 0 && (
          <details class="pt-more pp-chart-changes">
            <summary>Changes to the chart ({data.chartChanges.length}) <Icon name="chevron" size={16} class="pt-chev" /></summary>
            <ol class="pt-list mt-1">
              {data.chartChanges.map((ch) => (
                <li class="!block">
                  <p class="text-[14.5px] font-semibold">{when(new Date(ch.at))}{ch.by ? ` · ${ch.by}` : ''}</p>
                  <p class="mt-0.5 text-[14px] text-ink-2">{ch.n === 1 ? 'One change' : `${ch.n} changes`} · {ch.teeth.includes(',') ? `teeth ${ch.teeth}` : `tooth ${ch.teeth}`}</p>
                </li>
              ))}
            </ol>
          </details>
        )}
      </Pane>
    </div>

    <!-- The patient information record: basic information, dental history -->
    <div id="rec-overview" role="region" aria-labelledby="rec-overview-title" class="rec-sec min-w-0 grid content-start" data-rec-panel="overview">
      <Banner id="overview" label={SECTION_LABEL['overview']} />
      {/* What a save of the details, an added form or intake, or a detail taken from one did: here, where it lands (#overview). */}
      {saved === 'new' && <Callout tone="success" class="mb-1" text={`Added. ${shortName} is on file as ${patient.chart_no}; everything from the form is below.`} />}
      {saved === 'details' && <Callout tone="success" class="mb-1" text="Details saved." />}
      {saved === 'intake' && (() => {
        // Just added from an intake (039): what its forms came to, each part a way to the Consent section; added to a patient on file,
        // what page 1 did to the record (empty details filled, the health history, what the record kept), as the QR forms say it (4.3).
        const n = (st: string[]) => data.intakeDocs.filter((d) => st.includes(d.state)).length;
        const signedN = n(['agreed']), toSign = n(['to_sign']), toConfirm = n(['to_confirm']), refused = data.intakeDocs.filter((d) => d.state === 'refused' && d.code !== 'photos').length;
        const parts = [signedN && `${signedN === 1 ? 'one consent form' : `${signedN} consent forms`} signed`, toSign && `${toSign} to sign at the chair`, toConfirm && `${toConfirm} to confirm`, refused && `${refused} not agreed`].filter(Boolean) as string[];
        const onFile = data.addedIntake?.addedAs === 'existing';
        return (
          <Callout tone="success" class="mb-1" title={onFile ? `Added the forms (${data.addedIntake!.ref}) to ${patient.first_name}’s record.` : `${shortName} is added.`}>
            {onFile && <p>Empty details were filled in, and the record has the health history {patient.first_name} gave on page 1{data.addedIntake!.sentAt ? ` (sent ${day(data.addedIntake!.sentAt)})` : ''}.{keptFromRecord.length > 0 && ` Kept from the record as well: ${keptFromRecord.join(', ')}.`}</p>}
            {parts.length > 0 && <p>{capitalise(parts.join(' · '))}. <a href="#consent" class="font-semibold underline underline-offset-2" data-rec-go="consent">See Consent</a></p>}
          </Callout>
        );
      })()}
      {saved === 'form' && data.added && addedConsents && (
        <Callout tone="success" class="mb-1" title={data.added.addedAs === 'new' ? `Added from the patient forms (${data.added.ref}).` : `Added the patient forms (${data.added.ref}) to ${patient.first_name}’s record.`}>
          <p>
            {data.added.addedAs === 'new' ? `${shortName} is on file as ${patient.chart_no}, with the health history from the form` : 'Empty details were filled in, and the record has the health history from the form'}{addedConsents.from.length ? ` and ${andList(addedConsents.from)}` : ''}.
            {addedConsents.onFile.length > 0 && ` ${capitalise(andList(addedConsents.onFile))} ${addedConsents.onFile.length === 1 ? 'was' : 'were'} already on file.`}
            {keptFromRecord.length > 0 && ` Kept from the record as well: ${keptFromRecord.join(', ')}.`}
            {' '}<a href={`${formsBase}${data.added.id}/`} class="font-semibold underline underline-offset-2">See the form’s answers</a>
          </p>
        </Callout>
      )}
      {saved === 'form' && addedConsents && addedConsents.none.length > 0 && (
        <Callout tone="warn" role="alert" class="mb-1" title="No consent was recorded from this form.">
          <p>The birth date on the record makes {patient.first_name} under 18 on the day the form was signed, and {patient.first_name} signed it themself. A parent or guardian needs to agree: record it in <a href="#consent" class="font-semibold underline underline-offset-2" data-rec-go="consent">Consent</a>.</p>
        </Callout>
      )}
      {usedLabel && !formUseProblem && <Callout tone="success" class="mb-1" text={`The ${usedLabel} on the record is now the one from ${differs?.from ?? 'the form'}.`} />}
      {formUseProblem && <Callout tone="alert" class="mb-1" text={formUseProblem} />}
      {differs && differs.list.length > 0 && (
        <Callout tone="warn" role={saved === 'form' || saved === 'intake' ? 'alert' : undefined} class="mb-1" title={`${differs.says} something the record does not. The record kept what it had:`} data-rec-differs={differs.kind}>
          <ul class="fm-diff">
            {differs.list.map((d) => (
              <li class="fm-diff-use">
                <span class="min-w-0"><span class="fm-diff-k">{d.label}</span>On file: {d.onFile || 'nothing'}<br />On {differs.kind === 'form' ? 'the form' : 'their forms'}: {d.onForm}</span>
                {canEdit && TAKEABLE.has(d.field) && (
                  <form method="post" action={`${here}?${differs.param}=${differs.id}#overview`}>
                    <Csrf />
                    <input type="hidden" name="intent" value={differs.intent} />
                    <input type="hidden" name={differs.param} value={differs.id} />
                    <input type="hidden" name="field" value={d.field} />
                    <button type="submit" class="ws-btn ws-btn-quiet ws-btn-sm">Use {d.onForm.length > 24 ? (differs.kind === 'form' ? 'the form’s' : 'theirs') : d.onForm}</button>
                  </form>
                )}
              </li>
            ))}
          </ul>
          {canEdit && <p class="mt-2">{differs.list.some((d) => d.field === 'phone' || d.field === 'email') ? 'Check a mobile or email with the patient before you use it: visits and reminders go by mobile. ' : ''}A birth date changes in {PLACE.medicalHistory}.</p>}
        </Callout>
      )}
      {/* Basic information, boxed in the paper's rows (six to a row; two on a phone), each box a button to change it. */}
      <section class="pp-band" aria-labelledby="pp-basic-title">
        <h3 class="pp-band-title" id="pp-basic-title">Basic information</h3>
        <dl class="pf-grid pf-grid-6" id="overview">
          {basic.map((b) => <FormCell label={b.label} value={b.value} span={b.span} empty={b.empty} edit={editOf(b)} />)}
        </dl>
        <dl class="pf-grid" aria-label="More details">
          {more.map((b) => <FormCell label={b.label} value={b.value} span={b.span} edit={editOf(b)} />)}
          <FormCell label="Desk note" value={patient.notes} span={4} pre
            edit={canEdit ? { label: patient.notes ? 'Change the desk note' : 'Add a desk note', open: 'details', field: 'notes' } : undefined} />
        </dl>
      </section>
      <PaperHistory part="dental" latest={latest} own={health.own} visit={thisVisit ? { reason: thisVisit.reason } : null} sex={patient.sex} age={age} xrayHere={xrayHere} canEdit={canEdit} />
    </div>

    <!-- The medical history, and blood pressure -->
    <div id="rec-health" role="region" aria-labelledby="rec-health-title" class="rec-sec min-w-0 grid content-start" data-rec-panel="health">
      <Banner id="health" label={SECTION_LABEL['health']} level={3} />
      <Pane as="section" label={SECTION_LABEL['health']} id="health">
        {/* The paper's medical history, a box for each question (./_record/PaperHistory.astro); a box opens the folded form
            with the caret in its field. */}
        <PaperHistory part="medical" titles={false} latest={latest} own={health.own} visit={thisVisit ? { reason: thisVisit.reason } : null} sex={patient.sex} age={age} xrayHere={xrayHere} canEdit={canEdit} />
        {(saved === 'health' || saved === 'birth') && <Callout tone="success" class="mt-4" text="Saved." />}
        {saved === 'nothing' && <Callout tone="info" class="mt-4" text="Nothing was saved: nothing is ticked or typed yet." />}
        {conflict && (
          <Callout tone="warn" role="alert" class="mt-4">
            <p class="font-semibold">
              {conflict.versionMoved && conflict.latest ? `${conflict.latest.by ?? 'Someone'} saved this record ${when(new Date(conflict.latest.at))}, after you opened it.`
                : conflict.birthMoved ? `The birth date on file changed to ${dateText(conflict.birth) ?? 'none'} after you opened this page.`
                : 'This record changed after you opened it.'} Nothing of yours was saved yet.
            </p>
            <p class="mt-1.5 text-ink-2">On file now: {birthLine(conflict.birth)}{conflict.latest && <> · {stateLine(conflict.latest)}</>}{conflict.paperClash.map((w) => <> · {w}</>)}.</p>
            <p class="mt-1.5 text-ink-2">Your answers are still below. Check them against what is on file, then press Save again.</p>
          </Callout>
        )}
        {healthProblems.length > 0 && <Callout tone="alert" class="mt-4" title={`Nothing was saved. ${healthProblems.length === 1 ? 'One thing' : 'A few things'} to fix:`} items={healthProblems} />}

        {/* Who updated it, the change and the earlier versions on one line; an opened form takes the whole width. */}
        <div class="pp-hist-foot">
        <p class="pp-small">
          {!latest ? 'Nothing recorded yet. Ask the patient before treatment.'
            : answered(latest) ? `Updated ${byLine(latest)}.`
            : `Nothing answered yet. Ask the patient before treatment. Last saved ${byLine(latest)}.`}
        </p>
        {canEdit && (
          <details class="pp-edit" open={posted || !!conflict || healthProblems.length > 0 || undefined} data-pp-edit>
          <summary class="rec-plus rec-plus-text"><span class="rec-plus-mark" aria-hidden="true"><Icon name="plus" size={16} /></span>Change the medical history</summary>
          <form method="post" action={`${here}#health`} class="mt-5 rec-anchor" id="health-form" data-health-form data-health-unsaved={posted ? '' : undefined}>
            <Csrf />
            <input type="hidden" name="intent" value="health" />
            <input type="hidden" name="base" value={base} />
            <input type="hidden" name="birth_was" value={birthWas} />
            {thisVisit && <input type="hidden" name="visit" value={thisVisit.id} />}

            <div class="field border-b border-[var(--ws-hair)] pb-5">
              <label for="birth_date" class="meta">Date of birth</label>
              <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
                <input id="birth_date" type="date" name="birth_date" value={birthValue} min="1900-01-01" max={today} class="w-[13.5rem]" data-health-birth data-today={today} />
                <span class="text-[15px] text-ink-2" aria-live="polite" data-health-age>{formAge !== null && formAge >= 0 ? ageText(formAge) : birthValue ? '' : 'Not on file yet'}</span>
              </div>
            </div>
            <PaperHistoryFields paper={latest?.paper ?? null} typed={posted?.paperTyped ?? null} chips={healthChips} none={healthNone} own={health.own?.health ?? null}
              ask={showsPregnancy(asksPregnancy(patient.sex, age), latest, health.own?.health ?? null)} />

            <label class="field border-t border-[var(--ws-hair)] pt-5">
              <span class="meta">Note for the dentist</span>
              <textarea name="note" rows="2" maxlength={NOTE_MAX} placeholder="Anything to know before starting. For example: faints at injections.">{shown.note ?? ''}</textarea>
            </label>

            <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2">
              <button type="submit" class="ws-btn ws-btn-primary min-w-[9rem]" data-health-save><Icon name="check" />Save</button>
              <span class="ws-pill ws-tint-amber" data-health-dirty hidden={!posted}>Not saved yet</span>
              <span class="text-[13.5px] text-muted">Saved as a new version under your name. Earlier versions stay.</span>
            </div>
          </form>
          </details>
        )}

        {health.total > 0 && (
          <details class="pt-more pp-earlier">
            <summary>Earlier versions ({health.total}) <Icon name="chevron" size={16} class="pt-chev" /></summary>
            <ol class="pt-list mt-1">
              {health.versions.map((v, i) => {
                const prev = health.versions[i + 1] ?? health.older;
                const what = versionChanges(prev, v);
                return (
                  <li class="!block">
                    <p class="text-[14.5px] font-semibold">{byLine(v)}</p>
                    <p class="mt-0.5 text-[14.5px] text-ink-2">{!prev ? [...what, 'First record.'].join(' · ') : what.length ? what.join(' · ') : 'Checked, no change.'}</p>
                    <p class="mt-0.5 text-[13.5px] text-muted">{stateLine(v)}</p>
                  </li>
                );
              })}
            </ol>
            {health.total > health.versions.length && <p class="mt-2 text-[13.5px] text-muted">The {health.versions.length} newest are shown.</p>}
          </details>
        )}
        </div>
      </Pane>
      <Vitals vitals={ext.vitals} canEdit={canEdit} action={recHere} problem={recordProblem} saved={saved} firstName={patient.first_name} visitId={thisVisit?.id ?? null} openNow={openNow === 'vitals'} />
    </div>
    {/* Each page's foot: "Page 1 of 3" as the paper's; printed, whose record it is and the page without "of 3", since a
        page that runs onto a second sheet would make that a sheet count it is not (record.css, "Printed"). */}
    <p class="pp-page-no"><span class="pp-page-who">{pageWho}</span>Page 1<span class="pp-page-of"> of {PAGES}</span></p>
  </article>

  <!-- Page 2: informed consent -->
  <article class="pp-sheet pp-page" aria-label={`Page 2 of ${PAGES}`}>
    <div id="rec-consent" role="region" aria-labelledby="rec-consent-title" class="rec-sec min-w-0 grid gap-4 max-md:gap-3 content-start" data-rec-panel="consent">
      <Banner id="consent" label={SECTION_LABEL['consent']} adds={consentAdds} />
      {saved === 'capacity' && <Callout tone="success" class="mb-1" text="Recorded. For 30 days a representative may sign consent forms for them, on a clinic device." />}
      {saved === 'consent-removed' && <Callout tone="success" class="mb-1" text="The form was removed." />}
      {q.get('capacity') === 'refused' && <Callout tone="alert" class="mb-1" text="Nothing was recorded. Only a treating dentist here with a PRC licence records this, for an adult patient with a birth date on file, and with a reason of at most 300 characters." />}
      {/* The privacy notice first (not on the paper; the law asks for it): one ruled line once it is on record, else the
          desk's form. Then the paper's page 2 (./_record/ConsentForms). */}
      <div class="cf-privacy">
        {!privacyLine && <h3 class="pp-band-title">Privacy notice</h3>}
        <DeskConsent line notice={data.notice} consents={data.consents} canRecord={canEdit} minor={minor} birthKnown={!!patient.birth} dpo={data.dpo} action={`${here}#consent`}
          problem={consentProblem} givenBy={givenBy} agreedAs={agreedAs} recorded={saved === 'consent' ? 'saved' : saved === 'consent-already' ? 'already' : null}
          paper={{ ...paperState, recorded: saved === 'paper' ? 'saved' : null }} />
      </div>
      <ConsentForms docs={data.consentDocs} slug={clinic.slug} patientId={patient.id} firstName={patient.first_name} canEdit={canEdit} mayExplain={data.mayExplainIds}
        mayCapacity={mayCapacity} capacity={data.capacity} canPrepare={data.canPrepare} offered={data.offeredCodes}
        general={data.general} signed={data.signed} visits={data.fullVisits} paperForms={data.paperForms} forms={data.forms} formsBase={formsBase} />
    </div>
    <p class="pp-page-no"><span class="pp-page-who">{pageWho}</span>Page 2<span class="pp-page-of"> of {PAGES}</span></p>
  </article>

  <!-- Page 3: the treatment record -->
  <article class="pp-sheet pp-page" aria-label={`Page 3 of ${PAGES}`}>
    <div id="rec-treatment-record" role="region" aria-labelledby="rec-treatment-record-title" class="rec-sec min-w-0 grid content-start" data-rec-panel="treatment-record">
      <Banner id="treatment-record" label={SECTION_LABEL['treatment-record']} adds={canEdit ? [{ label: 'Record a treatment done', text: 'Record a treatment', open: 'rec-done-add' }] : []}>
        {data.ledger.count > 0 && <a href={`${here}treatment-record/`} class="ws-btn ws-btn-quiet ws-btn-sm"><Glyph name="print" size={16} />Print</a>}
      </Banner>
      <TreatmentRecord ledger={data.ledger} money={money} today={today} name={shortName} />
    </div>
    <p class="pp-page-no"><span class="pp-page-who">{pageWho}</span>Page 3<span class="pp-page-of"> of {PAGES}</span></p>
  </article>

  <!-- Attached to this record: each folded to one line until it is opened -->
  <section class="pp-attached" aria-labelledby="pp-attached-title">
    <h2 class="pp-attached-title" id="pp-attached-title">Attached to this record</h2>

    <Attached id="treatment" label={SECTION_LABEL['treatment']} status={STATUS.treatment} open={openSheets.has('treatment')}>
      <Treatment c={clin} loas={ext.loas} canEdit={canEdit} action={recHere} meId={session.staffId} problem={recordProblem} saved={recordSaved(saved) === 'treatment' ? saved : null} today={today} firstName={patient.first_name} visitId={thisVisit?.id ?? null} gaps={data.gaps.byPlanItem} consentsBase={`${here}consents/`}>
        {showOffer && current === 'treatment' && <ChartOffer slot="offer" state={offerState} skip={chartSkip} problem={offerProblem} action={recHere} sid={chartSid} visitId={thisVisit?.id ?? null} back="treatment" leaveHref={leaveOffer('treatment')} inChart={false} />}
      </Treatment>
      <div class="grid">
        <Loas loas={ext.loas} plan={clin.plan} payors={ext.hmoPayors} hmoName={patient.hmo_name} memberNo={patient.hmo_member_no} canEdit={canEdit} action={recHere} problem={recordProblem} saved={saved} today={today} firstName={patient.first_name} settingsHref={can(clinic, 'settings.edit') ? settingsAt(clinic.slug, 'hmos') : null} />
        <PayPlans plans={ext.plans} canEdit={canEdit} canBill={money} action={recHere} problem={recordProblem} saved={saved} today={today} firstName={patient.first_name} financesBase={links.finances} />
      </div>
    </Attached>

    <Attached id="notes" label={SECTION_LABEL['notes']} status={STATUS.notes} open={openSheets.has('notes')}>
      <Notes c={clin} canEdit={canEdit} saved={saved} />
    </Attached>

    <Attached id="rx" label={SECTION_LABEL['rx']} status={STATUS.rx} open={openSheets.has('rx')}>
      <Prescriptions c={clin} canEdit={canEdit} action={recHere} meId={session.staffId} problem={recordProblem} saved={saved} firstName={patient.first_name} printBase={`${here}rx/`} allergies={allergies} typedRows={rxTyped} visitId={thisVisit?.id ?? null} openNow={openNow === 'rx'} today={today} ptrFix={ptrFix} />
      <div>
        <Letters letters={ext.letters} clinicians={clin.clinicians} canEdit={canEdit} action={recHere} meId={session.staffId} problem={recordProblem} saved={saved} today={today} firstName={patient.first_name} printBase={`${here}letters/`} lastVisit={lastVisit ? manilaDay(lastVisit.starts_at) : null} conditions={conditions} ptrFix={ptrFix} />
      </div>
    </Attached>

    <Attached id="files" label={SECTION_LABEL['files']} status={STATUS.files} open={openSheets.has('files')}>
      <Files c={clin} canEdit={canEdit} action={recHere} problem={recordProblem} saved={saved} today={today} firstName={patient.first_name} fileBase={`${here}files/`} visitId={thisVisit?.id ?? null} openNow={openNow === 'file'} />
    </Attached>

    {/* The appointments, with the next check-up (the ledger's Next visit, as the paper keeps it, is on page 3). */}
    <Attached id="visits" label={SECTION_LABEL['visits']} status={STATUS.visits} open={openSheets.has('visits')} adds={[{ label: `Book a visit for ${patient.first_name}`, text: 'Book a visit', href: bookHref }]}>
      <RecallCard recall={clin.recall} canEdit={canEdit} action={recHere} problem={recordProblem} saved={saved} today={today} firstName={patient.first_name} bookHref={bookHref} texts={me.recall_texts === true} />
      <Pane level={4} title="Visits" icon="calendar" id="visits" meta={visits.length === 200 ? 'The newest 200' : undefined} pad="none">
        {visits.length === 0 ? (
          <div class="px-6 py-3 max-md:px-4"><Empty icon="calendar" text="No visits yet." action={canEdit ? { label: 'Bring in past visits from a spreadsheet', href: importHref } : { label: 'Book the first one', href: bookHref }} /></div>
        ) : (
          <table class="ws-table">
            <caption class="sr-only">Visits of {shortName}, newest first</caption>
            <thead>
              <tr>
                <th scope="col" class="meta">When</th>
                <th scope="col" class="meta">Service</th>
                <th scope="col" class="meta">Dentist</th>
                <th scope="col" class="meta">Teeth</th>
                <th scope="col" class="meta">Status</th>
                {money && <th scope="col" class="meta text-right">Charged</th>}
              </tr>
            </thead>
            <tbody>
              {visits.map((v) => (
                <tr>
                  <td class="text-[14.5px] whitespace-nowrap tabular-nums">
                    <span class="font-semibold">{visitText(v)}</span>
                    <span class="block text-[13px] text-muted">{SOURCE[v.source] ?? v.source}{v.chair ? ` · chair ${v.chair}` : ''}</span>
                    <button type="button" class="vx-link" data-ws-open={`rec-visit-${v.id}`} aria-haspopup="dialog">See the whole visit</button>
                  </td>
                  <td class="text-[15px]"><span class="meta ws-cell-label">Service</span>{v.reason ?? '—'}{v.notes && <span class="block max-w-[40ch] text-[13.5px] text-ink-2 max-lg:max-w-none">{v.notes}</span>}</td>
                  <td class="text-[15px]"><span class="meta ws-cell-label">Dentist</span>{v.dentist ? <Who name={v.dentist} /> : <span class="text-ink-2">—</span>}{v.dentist_free && <span class="block text-[13px] text-muted">As the old record has it</span>}</td>
                  <td class="text-[15px] tabular-nums"><span class="meta ws-cell-label">Teeth</span>{v.teeth?.length ? <span class="rp-row">{v.teeth.map((t: number) => <span class="rp rp-tooth">{t}</span>)}</span> : <span class="text-ink-2">—</span>}</td>
                  <td><span class="meta ws-cell-label">Status</span><Chip status={v.status} /></td>
                  {money && <td class="text-right text-[15px] tabular-nums max-lg:text-left"><span class="meta ws-cell-label">Charged</span>{v.charged ? pesos(v.charged) : <span class="text-muted">—</span>}</td>}
                </tr>
              ))}
            </tbody>
          </table>
        )}
      </Pane>
    </Attached>

    {money && (
      <Attached id="money" label={SECTION_LABEL['money']} status={STATUS.money} owed={balance > 0n} open={openSheets.has('money')} adds={[{ label: `A new statement for ${patient.first_name}`, text: 'New charge', href: chargeHref }]}>
        <a slot="actions" href={`${links.finances}?patient=${patient.id}&view=all`} class="ws-btn ws-btn-quiet ws-btn-sm">In Finances <Icon name="arrow-right" size={16} /></a>
        <Pane level={4} title="Money" icon="money" id="money" pad="none">
          <p class="pp-money">
            {balance > 0n ? <>Owes <span class="font-semibold text-caries tabular-nums">{pesos(balance)}</span>{openCount ? ` on ${openCount} ${openCount === 1 ? 'statement' : 'statements'}` : ''}.</>
              : balance < 0n ? <>In credit <span class="font-semibold tabular-nums">{pesos(-balance)}</span>.</>
              : <>Nothing owed.</>}
            {' '}Paid <span class="font-semibold tabular-nums">{pesos(paidAll)}</span> in all.
            {stmts.length === 0 ? ' No statements yet.' : ''}
            <span class="pp-small"> Statements of account, not BIR receipts.</span>
          </p>
          {stmts.length > 0 && (
            <table class="ws-table">
              <caption class="sr-only">Statements of {shortName}, newest first</caption>
              <thead>
                <tr>
                  <th scope="col" class="meta">Statement</th>
                  <th scope="col" class="meta">For</th>
                  <th scope="col" class="meta text-right">Total</th>
                  <th scope="col" class="meta text-right">Paid</th>
                  <th scope="col" class="meta text-right">Left</th>
                  <th scope="col" class="meta">Status</th>
                </tr>
              </thead>
              <tbody>
                {stmts.map((s) => {
                  const st = BILL_STATUS[s.status] ?? BILL_STATUS.issued;
                  return (
                    <tr>
                      <td class="whitespace-nowrap"><a href={`${links.finances}${s.id}/`} class="inline-flex min-h-11 items-center font-mono text-[14px] font-medium text-accent underline-offset-4 hover:underline">{statementNo(s.series_prefix, s.number)}</a><span class="block text-[13px] text-muted tabular-nums">{dateText(manilaDay(s.issued_at))}{s.imported_at ? ' · brought in' : ''}</span></td>
                      <td class="text-[14.5px]"><span class="meta ws-cell-label">For</span>{s.first_line ?? '—'}{s.n_lines > 1 && <span class="text-muted"> and {s.n_lines - 1} more</span>}{s.payor_name && <span class="block text-[13px] text-muted">{s.payor_name} part {pesos(fromDb(s.payor_share))}</span>}</td>
                      <td class="text-right text-[15px] tabular-nums max-lg:text-left"><span class="meta ws-cell-label">Total</span>{pesos(s.total)}</td>
                      <td class="text-right text-[15px] tabular-nums max-lg:text-left"><span class="meta ws-cell-label">Paid</span>{pesos(s.paid)}</td>
                      <td class="text-right text-[15px] font-semibold tabular-nums max-lg:text-left"><span class="meta ws-cell-label">Left</span>{pesos(s.left)}</td>
                      <td><span class="meta ws-cell-label">Status</span><span class:list={['ws-chip', STMT_TINT[s.status] ?? 'ws-tint-slate']}>{st.label}</span></td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          )}
        </Pane>
      </Attached>
    )}

    <Attached id="texts" label={SECTION_LABEL['texts']} status={STATUS.texts} open={openSheets.has('texts')}>
      <a slot="actions" href={links.messages} class="ws-btn ws-btn-quiet ws-btn-sm">{PLACE.allTexts} <Icon name="arrow-right" size={16} /></a>
      <Pane level={4} title="Texts" icon="message" id="texts" meta={data.texts.length === 50 ? 'The newest 50' : undefined} pad="none">
        {data.texts.length === 0 ? (
          <Empty icon="message" text="No texts yet. Confirmations and reminders show here." />
        ) : (
          <table class="ws-table">
            <caption class="sr-only">Texts to and from {shortName}, newest first</caption>
            <thead><tr><th scope="col" class="meta">When</th><th scope="col" class="meta">Status</th><th scope="col" class="meta">Text</th></tr></thead>
            <tbody>
              {data.texts.map((m) => {
                const st = textStatus(m);
                return (
                  <tr>
                    <td class="text-[14.5px] whitespace-nowrap tabular-nums">{when(new Date(m.created_at))}<span class="block text-[13px] text-muted">{m.direction === 'in' ? 'Reply' : TEXT_KIND[m.kind ?? ''] ?? 'Text'}</span></td>
                    <td><span class="meta ws-cell-label">Status</span><Chip tone={st.tone} label={st.label} dot={st.tone === 'alert'} /></td>
                    <td class="max-w-[40rem] text-[14.5px] leading-relaxed break-words whitespace-pre-wrap"><span class="meta ws-cell-label">Text</span>{m.body ?? <span class="text-muted">A sign-in code. It is not shown here.</span>}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        )}
      </Pane>
    </Attached>
  </section>

  <p class="pp-small pp-foot">Every look at this record, and every change to it, is logged under the person’s name.</p>
  </div>
  </div>

  {canEdit && (
    <SidePanel id="details" title="Edit details" meta={shortName} wide open={detailsProblems.length > 0 || openNow === 'details'}>
      {detailsProblems.length > 0 && <Callout tone="alert" class="mb-5" title="Nothing was saved." items={detailsProblems} />}
      {/* From the Dashboard (dash), no #overview on the action: a redirect keeps the post's fragment, and the Dashboard needs none. */}
      <form method="post" action={(detailsDash ?? dashVisit) ? here : `${here}#overview`} class="grid gap-4">
        <Csrf />
        <input type="hidden" name="intent" value="details" />
        {/* This form draws the paper record's Occupation and Parent or guardian, so they are read from it (import.ts readPersonForm). */}
        <input type="hidden" name="has_paper_fields" value="1" />
        {(detailsDash ?? dashVisit) && <input type="hidden" name="dash" value={detailsDash ?? dashVisit} />}
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="field"><span class="meta">Last name</span><input name="last_name" value={d.last} required maxlength="60" autocomplete="off" /></label>
          <label class="field"><span class="meta">First name</span><input name="first_name" value={d.first} required maxlength="60" autocomplete="off" /></label>
          <label class="field"><span class="meta">Middle name</span><input name="middle_name" value={d.middle ?? ''} maxlength="60" autocomplete="off" /></label>
          <label class="field"><span class="meta">Suffix</span><input name="suffix" value={d.suffix ?? ''} maxlength="10" autocomplete="off" placeholder="Jr., Sr., III" /></label>
        </div>
        <fieldset class="min-w-0">
          <legend class="float-left w-full text-[14px] font-medium text-ink-2">Sex</legend>
          <div class="pk-row clear-both pt-2">
            {SEXES.map((x) => (
              <label class="pk pk-radio"><input type="radio" name="sex" value={x.id} checked={d.sex === x.id} /><span>{x.label}</span></label>
            ))}
          </div>
        </fieldset>
        <label class="field"><span class="meta">Occupation</span><input name="occupation" value={d.occupation ?? ''} maxlength={OCCUPATION_MAX} autocomplete="off" /></label>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="field"><span class="meta">Mobile</span><input type="tel" name="mobile" value={d.phone ? prettyPhone(d.phone) : ''} inputmode="tel" autocomplete="off" /><span class={help}>Reminders go to it.</span></label>
          <label class="field"><span class="meta">Email</span><input type="email" name="email" value={d.email ?? ''} maxlength="120" autocomplete="off" /></label>
          <label class="field sm:col-span-2"><span class="meta">Address</span><input name="address" value={d.address ?? ''} maxlength="200" autocomplete="off" /></label>
          <label class="field"><span class="meta">City or town</span><input name="city" value={d.city ?? ''} maxlength="80" autocomplete="off" /></label>
          <label class="field"><span class="meta">Province</span><input name="province" value={d.province ?? ''} maxlength="80" autocomplete="off" /></label>
          <label class="field sm:col-span-2"><span class="meta">Parent’s or guardian’s name</span><input name="guardian_name" value={d.guardianName ?? ''} maxlength={GUARDIAN_NAME_MAX} autocomplete="off" /></label>
          <label class="field"><span class="meta">Their relation</span><input name="guardian_relation" value={d.guardianRelation ?? ''} maxlength={RELATION_MAX} autocomplete="off" placeholder="Mother, father, guardian" /></label>
          <label class="field"><span class="meta">Their mobile</span><input type="tel" name="guardian_phone" value={d.guardianPhone ? prettyPhone(d.guardianPhone) : ''} maxlength="20" inputmode="tel" autocomplete="off" /></label>
          <label class="field"><span class="meta">HMO</span><input name="hmo_name" value={d.hmoName ?? ''} maxlength="80" autocomplete="off" list="rec-hmo-names" /></label>
          <label class="field"><span class="meta">HMO member no.</span><input name="hmo_member_no" value={d.hmoMemberNo ?? ''} maxlength="40" autocomplete="off" /></label>
          <label class="field"><span class="meta">Emergency contact</span><input name="emergency_name" value={d.emergencyName ?? ''} maxlength="120" autocomplete="off" /></label>
          <label class="field"><span class="meta">Relation</span><input name="emergency_relation" value={d.emergencyRelation ?? ''} maxlength="40" autocomplete="off" /></label>
          <label class="field"><span class="meta">Their number</span><input type="tel" name="emergency_phone" value={d.emergencyPhone ? prettyPhone(d.emergencyPhone) : ''} maxlength="20" inputmode="tel" autocomplete="off" /></label>
          <label class="field"><span class="meta">Chart no.</span><input name="chart_no" value={d.chartNo ?? ''} maxlength="20" autocomplete="off" /><span class={help}>Change it only to match the card.</span></label>
        </div>
        <label class="field"><span class="meta">Notes</span><textarea name="notes" rows="3" maxlength={NOTES_MAX} data-rec-details-notes>{d.notes ?? ''}</textarea><span class={help}>The desk sees this beside the patient’s visits on the Dashboard. Keep health details in {PLACE.medicalHistory}.</span></label>
        <datalist id="rec-hmo-names">{data.hmoNames.map((h) => <option value={h} />)}</datalist>
        <p class="flex items-start gap-2 text-[13.5px] text-muted"><Icon name="info" size={16} class="mt-0.5 shrink-0" />The date of birth is changed on the medical history, where its history is kept.</p>
        <div><button type="submit" class="ws-btn ws-btn-primary w-full"><Icon name="check" />Save details</button></div>
      </form>
    </SidePanel>
  )}
</ClinicLayout>

<style is:global>
  /* Print the record: the paper's A4 (record.css, "Printed"). */
  @page { size: A4 portrait; margin: 10mm 12mm; }
</style>

<script>
  import { ageOn, ageText, capitalise } from '../../../../lib/health';

  // --- the parts: the paper's three pages and the sheets attached to it, on one page; the address says which one, so a
  // reload or a post lands where it was ---
  // What stays at the top of the screen is the workspace bar: measured, so a part gone to lands just below it
  // (record.css, scroll-margin-top).
  const topBar = document.querySelector<HTMLElement>('[data-ws-top]');
  const measureTop = () => {
    document.documentElement.style.setProperty('--rec-top', `${topBar && getComputedStyle(topBar).position === 'sticky' ? topBar.offsetHeight : 0}px`);
  };
  measureTop();
  if (topBar) new ResizeObserver(measureTop).observe(topBar);
  /** Open every <details> around an element: a form folded away (the medical history's), an attached sheet. */
  const unfold = (el: Element) => { for (let d = el.closest('details'); d; d = d.parentElement?.closest('details') ?? null) d.open = true; };
  /** Bring a part, or an element in one, to the top; with `field`, put the caret in that field. An attached sheet opens. */
  const show = (name: string, o: { field?: string; focus?: boolean; smooth?: boolean } = {}) => {
    const sec = document.getElementById(`rec-${name}`);
    const el = sec?.matches('[data-rec-panel]') ? sec : document.getElementById(name) ?? sec;
    if (!el) return false;
    unfold(el);
    const fold = el.querySelector<HTMLDetailsElement>(':scope > details[data-rec-fold]');
    if (fold) fold.open = true;
    // A named field goes to the middle of the screen, not its form's top: a box's field may sit screens down its form
    // (the medical history's lists under the dental history). Without one, the part's head goes to the top, under the bar.
    const box = o.field ? el.querySelector<HTMLElement>(`[name="${o.field}"]`) : null;
    (box ?? el).scrollIntoView({ block: box ? 'center' : 'start', behavior: o.smooth ? 'smooth' : 'auto' });
    if (box) box.focus({ preventScroll: true });
    else if (o.focus) {
      const head = el.matches('[data-rec-panel]') ? el.querySelector<HTMLElement>('.pp-title') : el;
      if (head) { if (!head.hasAttribute('tabindex')) head.setAttribute('tabindex', '-1'); head.focus({ preventScroll: true }); }
    }
    return true;
  };
  const say = (name: string) => { if (location.hash !== `#${name}`) history.replaceState(null, '', `${location.pathname}${location.search}#${name}`); };
  const fromHash = () => {
    let id = decodeURIComponent(location.hash.slice(1)).replace(/^rec-/, '');
    if (!id) return false;
    // The Timeline became the Treatment record: an old #timeline link lands there, and the address says so.
    if (id === 'timeline') { id = 'treatment-record'; say(id); }
    // A part's own name goes to its head; any other id (a card, a form, #chart-offer) to that element.
    requestAnimationFrame(() => show(id));
    return true;
  };
  for (const a of document.querySelectorAll<HTMLAnchorElement>('[data-rec-link]')) a.addEventListener('click', (e) => {
    e.preventDefault();
    const name = a.dataset.recLink!;
    show(name, { focus: true, smooth: true });
    say(name);
  });
  window.addEventListener('hashchange', fromHash);
  // No address to go to: a post comes back to the part it came from (the server's choice, data-rec-start; none on a
  // plain load, which opens at the top of the paper).
  if (!fromHash()) {
    const start = document.querySelector<HTMLElement>('[data-rec-start]')?.dataset.recStart;
    if (start) requestAnimationFrame(() => show(start));
  }

  // A side panel inside an attached sheet that is folded is not drawn (a dialog in a closed <details> has no box, and
  // the page behind it would still go inert): its sheet opens as the panel does, whoever opened it — the More menu,
  // This visit, a plus. The shell says so on the dialog before it shows it (ws:panel-open, not bubbling: caught here on
  // the way down). A panel the shell drew open as the page loaded, before this script, the server already put in an
  // open sheet; this is the net under that.
  document.addEventListener('ws:panel-open', (e) => { if (e.target instanceof Element) unfold(e.target); }, true);
  document.querySelectorAll('details:not([open]) dialog[open]').forEach(unfold);

  // Print the record: the three pages as the paper is (record.css, "Printed"). As it prints — this button or the
  // browser's own Print — the page tells the audit log who printed it (intent printed; nothing comes back).
  const printer = document.querySelector<HTMLButtonElement>('[data-rec-print]');
  printer?.addEventListener('click', () => window.print());
  let printedAt = 0;
  window.addEventListener('beforeprint', () => {
    if (!printer?.dataset.recPrint || Date.now() - printedAt < 60_000) return;
    printedAt = Date.now();
    const f = new FormData();
    f.set('_csrf', printer.dataset.recPrint);
    f.set('intent', 'printed');
    navigator.sendBeacon(location.pathname, f);
  });

  // ?open=details (the Dashboard's desk note, "Edit"): the caret waits at the end of Notes, once the shell has opened
  // the panel and focused its title; then the address drops open and dash, so Back does not open the panel again.
  if (new URLSearchParams(location.search).get('open') === 'details') {
    requestAnimationFrame(() => requestAnimationFrame(() => {
      const panel = document.getElementById('details') as HTMLDialogElement | null;
      if (!panel?.open) return;
      const notes = panel.querySelector<HTMLTextAreaElement>('[data-rec-details-notes]');
      if (notes) { notes.focus(); notes.setSelectionRange(notes.value.length, notes.value.length); }
      const url = new URL(location.href);
      url.searchParams.delete('open'); url.searchParams.delete('dash');
      history.replaceState(null, '', `${url.pathname}${url.search}${url.hash}`);
    }));
  }
  // A plus (or a "See …") that goes to a part of this page: there, with the caret in its field when it names one.
  document.querySelectorAll<HTMLElement>('[data-rec-go]').forEach((b) => b.addEventListener('click', () => {
    show(b.dataset.recGo!, { field: b.dataset.recField, focus: true, smooth: !b.dataset.recField });
  }));
  // A plus that opens Edit details beside one detail: the caret goes to that detail's field once the panel is open.
  document.querySelectorAll<HTMLElement>('[data-ws-open][data-rec-field]').forEach((b) => b.addEventListener('click', () => {
    const panel = document.getElementById(b.dataset.wsOpen!);
    requestAnimationFrame(() => requestAnimationFrame(() => {
      const box = panel?.querySelector<HTMLInputElement>(`[name="${b.dataset.recField}"]`);
      if (box) { box.focus(); if (box.type !== 'radio' && box.select) box.select(); }
    }));
  }));

  // The chart speaks up: a copy of this page kept for a brownout opens on the Chart, and a
  // notice the chart raises (a colleague's newer finding, changes waiting on this device)
  // brings the Chart forward, wherever the person was.
  if (document.documentElement.dataset.offlineCopy) show('chart');
  const notices = document.querySelectorAll<HTMLElement>('[data-hold-note], [data-sync-notice], [data-copy-note]');
  let told = [...notices].some((n) => !n.hidden);
  const watch = new MutationObserver(() => {
    const now = [...notices].some((n) => !n.hidden);
    if (now && !told) show('chart');
    told = now;
  });
  notices.forEach((n) => watch.observe(n, { attributes: true, attributeFilter: ['hidden'] }));
  if (told) show('chart');

  // The chart in its card (the look and the layout are patients.css, "The chart"). The
  // component's empty line was written for a demo chart; a record says what to do. Where an
  // arch is wider than the card (a phone), the line above the chart says so, the edge where
  // teeth wait fades (data-pt-more), and the two arches scroll together, so the upper teeth
  // stay over the lower ones — arrow keys moving to a hidden tooth scroll both. The baby teeth's
  // two rows (data-odo-set="primary") scroll together the same way, apart from the permanent ones.
  const chart = document.querySelector<HTMLElement>('[data-pt-chart]');
  if (chart) {
    const empty = chart.querySelector<HTMLElement>('[data-note-empty]');
    if (empty) empty.textContent = 'Nothing charted yet. Pick a tooth to add a finding.';
    const hint = document.querySelector<HTMLElement>('[data-pt-chart-scroll]');
    const arches = [...new Set([...chart.querySelectorAll<HTMLElement>('[data-tooth]')]
      .map((t) => t.closest<HTMLElement>('.overflow-x-auto'))
      .filter((a): a is HTMLElement => !!a))];
    const measure = () => {
      let any = false;
      for (const a of arches) {
        const room = a.scrollWidth - a.clientWidth;
        const over = a.clientWidth > 0 && room > 1;
        any ||= over;
        const left = over && a.scrollLeft > 1;
        const right = over && a.scrollLeft < room - 1;
        if (left || right) a.dataset.ptMore = left && right ? 'both' : left ? 'left' : 'right';
        else delete a.dataset.ptMore;
      }
      if (hint) hint.hidden = !any;
    };
    let lead: HTMLElement | null = null;
    for (const a of arches) {
      a.addEventListener('scroll', () => {
        if (lead && lead !== a) return;
        lead = a;
        const set = a.closest('[data-odo-set]');
        for (const b of arches) if (b !== a && b.closest('[data-odo-set]') === set && Math.abs(b.scrollLeft - a.scrollLeft) > 1) b.scrollLeft = a.scrollLeft;
        measure();
        requestAnimationFrame(() => { if (lead === a) lead = null; });
      }, { passive: true });
    }
    const sized = new ResizeObserver(measure);
    arches.forEach((a) => { sized.observe(a); if (a.firstElementChild) sized.observe(a.firstElementChild); });
    measure();
  }

  // The health form. Chips are checkboxes, so the form posts without this
  // script too (what is left in an "add" box is split on commas and saved).
  // With it: Enter or Add turns the typed words into ticked chips, the none
  // chip and the others untick each other, the age follows the birth date,
  // and leaving with unsaved changes asks first. "Unsaved" is the form's
  // data-health-unsaved attribute, so the consent form can see it.
  document.querySelectorAll<HTMLFormElement>('[data-health-form]').forEach((form) => {
    const note = form.querySelector<HTMLElement>('[data-health-dirty]');
    const mark = () => { form.toggleAttribute('data-health-unsaved', true); if (note) note.hidden = false; };
    form.addEventListener('input', mark);
    form.addEventListener('change', mark);
    form.addEventListener('submit', () => { form.removeAttribute('data-health-unsaved'); });
    window.addEventListener('beforeunload', (e) => { if (form.hasAttribute('data-health-unsaved')) { e.preventDefault(); e.returnValue = ''; } });

    form.querySelectorAll<HTMLElement>('[data-health-list]').forEach((group) => {
      const chips = group.querySelector<HTMLElement>('[data-health-chips]')!;
      const none = group.querySelector<HTMLInputElement>('[data-health-none]')!;
      const box = group.querySelector<HTMLInputElement>('[data-health-add-input]')!;
      const tpl = group.querySelector<HTMLTemplateElement>('[data-health-tpl]')!;
      const items = () => [...chips.querySelectorAll<HTMLInputElement>('input[type="checkbox"]:not([data-health-none])')];

      chips.addEventListener('change', (e) => {
        const t = e.target as HTMLInputElement;
        if (t === none) { if (t.checked) items().forEach((i) => { i.checked = false; }); }
        else if (t.checked) none.checked = false;
      });

      const add = () => {
        const words = box.value.split(/[,;\n]/).map((s) => capitalise(s.replace(/\s+/g, ' ').trim())).filter(Boolean);
        for (const w of words) {
          // A chip shows the paper's words over the stored one ("High blood pressure" is Hypertension): either finds it.
          const same = items().find((i) => [i.value, i.nextElementSibling?.textContent ?? ''].some((x) => x.trim().toLocaleLowerCase('en') === w.toLocaleLowerCase('en')));
          if (same) { same.checked = true; continue; }
          const node = tpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
          const input = node.querySelector('input')!;
          input.value = w;
          input.checked = true;
          node.querySelector('[data-health-chip-text]')!.textContent = w;
          chips.append(node);
        }
        if (words.length) { none.checked = false; mark(); }
        box.value = '';
        box.focus();
      };
      box.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); add(); } });
      group.querySelector<HTMLButtonElement>('[data-health-add]')!.addEventListener('click', add);
    });

    // The age beside the birth date. A date field fills its year a digit at a
    // time (0001, 0019, 0197, 1975), so nothing shows until the year is a
    // real one; a year still before 1900 when the field is left says so.
    const birth = form.querySelector<HTMLInputElement>('[data-health-birth]');
    const age = form.querySelector<HTMLElement>('[data-health-age]');
    const showAge = (leaving: boolean) => {
      if (!birth || !age) return;
      const today = birth.dataset.today ?? '';
      const v = birth.value;
      const years = v ? ageOn(v, today) : null;
      age.textContent = !v ? 'Not on file yet'
        : v < '1900-01-01' ? (leaving ? 'Check the year' : '')
        : years === null || years < 0 || v > today ? 'Check the date'
        : ageText(years);
    };
    birth?.addEventListener('input', () => showAge(false));
    birth?.addEventListener('blur', () => showAge(true));
  });

  // Recording consent reloads the page. With health answers typed and not
  // saved, that would throw them away behind a browser "Leave site?" box, so
  // the consent form stops and says so, with a button that saves them.
  const health = document.querySelector<HTMLFormElement>('[data-health-form]');
  const consent = document.querySelector<HTMLFormElement>('[data-desk-consent-form]');
  const held = document.querySelector<HTMLElement>('[data-desk-consent-held]');
  if (health && consent && held) {
    consent.addEventListener('submit', (e) => {
      if (!health.hasAttribute('data-health-unsaved')) return;
      e.preventDefault();
      held.hidden = false;
      held.querySelector<HTMLButtonElement>('button')?.focus();
    });
    held.querySelector<HTMLButtonElement>('button')?.addEventListener('click', () => health.requestSubmit());
  }
</script>
