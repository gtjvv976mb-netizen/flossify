        {clearance && <button type="button" class="rec-chip-go" data-rec-go="rx"><Chip tone={clearance.tone} icon={clearance.tone === 'accent' ? 'check' : 'alert'} label={clearance.text} /></button>}
        {loaWaiting > 0 && <button type="button" class="rec-chip-go" data-rec-go="treatment"><Chip tone="warn" icon="clock" label={loaWaiting === 1 ? 'Waiting for an HMO LOA' : `Waiting for ${loaWaiting} HMO LOAs`} /></button>}
