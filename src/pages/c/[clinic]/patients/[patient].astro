  const treatedQ = q.get('treated');
  const offerState = canEdit && treatedQ && UUID.test(treatedQ) ? await offerFor(tx, p.id, treatedQ) : null;
  return { general, consentDocs, mayExplainIds, treatsHere, capacity, canPrepare, offeredCodes, intakeDocs, gaps, offerState, clinical, extra, ledger, chartChanges, signed, consentedIds, fullVisits, me, p, teeth, visits, next, health, consents, paperForms, notice, canEdit, dpo: dpo as string | null, statements, texts, hmoNames, forms, added, addedLine, addedDiffers, addedIntake, intakeDiffers };
});
if (!data) return notFound();
const { me, p: patient, visits, health, canEdit } = data;

// Rows per (tooth, surface) become one mark per tooth for the chart. The chart
// keeps one biting-surface slot and names it incisal on anteriors itself, so an
// 'incisal' row lands in that slot.
const marks: Partial<Record<number, ToothMark>> = {};
for (const t of data.teeth) {
  const m = (marks[t.fdi] ??= { condition: t.condition as ToothCondition });
  if (!t.surface) continue;
  const surface = (t.surface === 'incisal' ? 'occlusal' : t.surface) as Surface;
  if (!(m.surfaces ??= []).includes(surface)) m.surfaces.push(surface);
}

// The chart posts each change to /api/chart with this token in the X-CSRF header.
const csrf = csrfToken(Astro.cookies);

const today = manilaToday();
const age = patient.birth ? ageOn(patient.birth, today) : null;
const minor = age !== null && age < 18;
// The consent that counts for the notice in force, and whether a minor still needs a parent's or guardian's.
const consentNow = consentInForce(data.notice?.id, data.consents);
const guardianNeeded = minor && consentNow?.agreed_as !== 'guardian';
// Page 2: the privacy notice on record reads as one ruled line (DeskConsent's line); else the desk's form, under its name.
const privacyLine = !!data.notice && !!consentNow && !guardianNeeded;
// A treating dentist here with a PRC licence, the patient an adult on file: may record that they cannot decide now.
const mayCapacity = canEdit && data.treatsHere && !minor && !!patient.birth;
// Informed consent's pluses: prepare the forms (only where they are offered) and, for that dentist, Cannot decide.
const consentAdds = canEdit ? [
  ...(data.canPrepare ? [{ label: `Prepare consent forms for ${patient.first_name}`, text: 'Prepare forms', href: `/c/${clinic.slug}/patients/new/?patient=${patient.id}` }] : []),
  ...(mayCapacity ? [{ label: `Record that ${patient.first_name} cannot decide now`, text: 'Cannot decide', open: 'rec-capacity' }] : []),
] : [];
const latest = health.versions[0] ?? null;
// The alert strip is what is saved; the form shows what was typed when a post came back.
const allergies: string[] = latest?.allergies ?? [];
const conditions: string[] = latest?.conditions ?? [];
const medications: string[] = latest?.medications ?? [];
const shown: HealthAnswers = posted?.answers ?? { allergies: latest?.allergies ?? null, conditions: latest?.conditions ?? null, medications: latest?.medications ?? null, note: latest?.note ?? null };
const birthValue = posted ? posted.birth : patient.birth ?? '';
const birthWas = posted ? posted.birthWas : patient.birth ?? '';
const formAge = birthValue ? ageOn(birthValue, today) : null;
const base = posted?.base ?? latest?.id ?? 'none';
const saved = q.get('saved');
const stale = q.get('stale') === '1';

// The same way every date on the record reads: "Fri 25 Sep 2026, 9:00 am".
const visitWhen = (d: Date) => when(d);
const manilaDay = (d: Date) => new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Manila', year: 'numeric', month: '2-digit', day: '2-digit' }).format(d);
/** A visit's day and time, or its day alone when only the day is known (brought in from old records). */
const visitText = (v: { starts_at: Date; date_only: boolean }) => (v.date_only ? dateText(manilaDay(v.starts_at))! : visitWhen(v.starts_at));
const SOURCE: Record<string, string> = { web: 'Web', request: 'Web request', staff: 'Desk', import: 'Imported' };

// --- this visit (036) ---------------------------------------------------------
// ?visit=<id>: a visit to open — today's, and the record shows its This visit strip above the sections;
// another day's, and the Treatment record opens with that visit's panel (a future visit, or a cancelled one that holds
// nothing, opens over Visits instead, which lists it).
const openVisit = q.get('visit') && UUID.test(q.get('visit')!) ? q.get('visit') : null;
const going = (s: string) => s !== 'cancelled' && s !== 'no_show';
const todays = visits.filter((v) => !v.date_only && going(v.status) && manilaDay(v.starts_at) === today);
// The visit the strip is for: the one asked for, else the one under way, else the next one today, else the one just done.
const thisRow = openVisit ? todays.find((v) => v.id === openVisit) ?? null
  : todays.find((v) => ['arrived', 'in_lobby', 'in_chair'].includes(v.status)) ?? todays.find((v) => v.status !== 'completed') ?? todays[0] ?? null;
const thisVisit: StripVisit | null = thisRow ? { id: thisRow.id, startsAt: thisRow.starts_at, status: thisRow.status, reason: thisRow.reason, dentist: thisRow.dentist, chair: thisRow.chair, charged: thisRow.charged } : null;
// A visit already on the book after this one (the strip then does not ask for a check-up).
const laterVisits = thisVisit ? visits.filter((v) => v.id !== thisVisit.id && going(v.status) && v.status !== 'completed' && +v.starts_at > +thisVisit.startsAt) : [];
const laterVisitAt: Date | null = laterVisits.length ? laterVisits[laterVisits.length - 1].starts_at : null;
// ?open=vitals|note|rx|done|file|details: the page opens that panel as it loads (the Dashboard's "Take it", "Write the
