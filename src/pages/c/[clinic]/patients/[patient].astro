  const me = (await tx.query('select name, address_line, barangay, city, province, phone, email::text as email, area, notation, recall_texts from clinic where id = $1', [clinic.id])).rows[0];
  const p = (await tx.query(
    `select p.id, p.chart_no, p.first_name, p.middle_name, p.last_name, p.suffix, p.sex, p.phone, p.email::text as email,
            p.address_line, p.city, p.province, p.hmo_name, p.hmo_member_no, p.emergency_name, p.emergency_relation, p.emergency_phone, p.notes,
            p.occupation, p.guardian_name, p.guardian_relation, p.guardian_phone,
