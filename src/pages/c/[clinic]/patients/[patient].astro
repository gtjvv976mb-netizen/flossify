  const consentDocs = await loadConsentDocuments(tx, p.id);
  const mayExplainIds = new Set<string>();
  for (const d of consentDocs) if (d.template?.attest && d.dentistId === session.staffId && (await mayAttest(tx, clinic.id, session.staffId, d.dentistId))) mayExplainIds.add(d.id);
  const treatsHere = !!(await tx.query<{ prc: string | null }>('select prc from treating_dentist($1, $2)', [session.staffId, clinic.id])).rows[0]?.prc;
  const capacity = await capacityNote(tx, p.id);
  const gatesNow = await intakeGates(tx);
  const canPrepare = gatesNow.templates.length > 0;
  const offeredCodes = new Set(gatesNow.templates.map((t) => t.code as string));
  const intakeQ = q.get('saved') === 'intake' ? q.get('intake') ?? '' : '';
  const intakeDocs = intakeQ && UUID.test(intakeQ) ? (await tx.query<{ id: string; state: string; code: string | null }>(
    `select d.id, consent_document_state(d.id) as state, v.code from consent_document d join consent_version v on v.id = d.version_id
      where d.patient_id = $1 and (d.intake_id = $2 or exists (select 1 from consent_signing s where s.document_id = d.id and s.intake_id = $2)) and d.cancelled_at is null`, [p.id, intakeQ])).rows : [];
  const fullVisits = await loadVisits(tx, p.id, clinical, extra, signed, money, consentDocs);
  // Consent forms linked to a plan line or a visit that are not agreed (phase 4.4): Mark done and the strip ask why before going ahead.
  const gaps = await consentGapsFor(tx, p.id);
