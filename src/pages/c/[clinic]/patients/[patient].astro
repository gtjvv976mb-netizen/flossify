    {recordProblem && (!canEdit || (recordProblem.intent === 'payplan-add' && !money)) && <Callout tone="alert" class="mt-4" text={`${recordProblem.text} Nothing was saved.`} />}
    {saved === 'new' && <Callout tone="success" class="mt-4" text={`Added. ${shortName} is on file as ${patient.chart_no}; everything from the form is below.`} />}
    {saved === 'details' && <Callout tone="success" class="mt-4" text="Details saved." />}
    {saved === 'form' && data.added && addedConsents && (
      <Callout tone="success" class="mt-4" title={data.added.addedAs === 'new' ? `Added from the patient forms (${data.added.ref}).` : `Added the patient forms (${data.added.ref}) to ${patient.first_name}’s record.`}>
        <p>
          {data.added.addedAs === 'new' ? `${shortName} is on file as ${patient.chart_no}, with the health history from the form` : 'Empty details were filled in, and the record has the health history from the form'}{addedConsents.from.length ? ` and ${andList(addedConsents.from)}` : ''}.
          {addedConsents.onFile.length > 0 && ` ${capitalise(andList(addedConsents.onFile))} ${addedConsents.onFile.length === 1 ? 'was' : 'were'} already on file.`}
          {keptFromRecord.length > 0 && ` Kept from the record as well: ${keptFromRecord.join(', ')}.`}
          {' '}<a href={`${formsBase}${data.added.id}/`} class="font-semibold underline underline-offset-2">See the form’s answers</a>
        </p>
      </Callout>
    )}
    {saved === 'form' && addedConsents && addedConsents.none.length > 0 && (
      <Callout tone="warn" role="alert" class="mt-3" title="No consent was recorded from this form.">
        <p>The birth date on the record makes {patient.first_name} under 18 on the day the form was signed, and {patient.first_name} signed it themself. A parent or guardian needs to agree: record it in <a href="#consent" class="font-semibold underline underline-offset-2" data-rec-go="consent">Consent</a>.</p>
      </Callout>
    )}
    {usedLabel && !formUseProblem && <Callout tone="success" class="mt-4" text={`The ${usedLabel} on the record is now the one from the form.`} />}
    {formUseProblem && <Callout tone="alert" class="mt-4" text={formUseProblem} />}
    {data.added && data.addedDiffers.length > 0 && (
      <Callout tone="warn" role={saved === 'form' ? 'alert' : undefined} class="mt-3" title="The form says something the record does not. The record kept what it had:">
        <ul class="fm-diff">
          {data.addedDiffers.map((d) => (
            <li class="fm-diff-use">
              <span class="min-w-0"><span class="fm-diff-k">{d.label}</span>On file: {d.onFile || 'nothing'}<br />On the form: {d.onForm}</span>
              {canEdit && TAKEABLE.has(d.field) && (
                <form method="post" action={`${here}?form=${data.added!.id}#overview`}>
                  <Csrf />
                  <input type="hidden" name="intent" value="form-use" />
                  <input type="hidden" name="form" value={data.added!.id} />
                  <input type="hidden" name="field" value={d.field} />
                  <button type="submit" class="ws-btn ws-btn-quiet ws-btn-sm">Use {d.onForm.length > 24 ? 'the form’s' : d.onForm}</button>
                </form>
              )}
            </li>
          ))}
        </ul>
        {canEdit && <p class="mt-2">{data.addedDiffers.some((d) => d.field === 'phone' || d.field === 'email') ? 'Check a mobile or email with the patient before you use it: visits and reminders go by mobile. ' : ''}A birth date changes in the Health section.</p>}
      </Callout>
    )}

    <div class="pt-tiles-wrap mt-5"><div class="ws-tiles pt-tiles">
      <Tile label={hereNow ? 'Today, now' : 'Next visit'} value={nextValue} tone={hereNow ? 'accent' : 'default'} note={nextNote} icon="calendar" />
      <Tile label="Last visit" value={lastVisit ? dateText(manilaDay(lastVisit.starts_at))! : 'None yet'} note={lastVisit ? [lastVisit.reason, lastVisit.dentist].filter(Boolean).join(' · ') : 'No finished visit on file'} icon="clock" />
      {money && <Tile label="Balance" value={pesos(balance > 0n ? balance : -balance)} tone={balance > 0n ? 'alert' : 'default'} note={balance > 0n ? `Owed${openCount ? ` on ${openCount} ${openCount === 1 ? 'statement' : 'statements'}` : ''}` : balance < 0n ? 'In credit' : 'Nothing owed'} icon="money" href="#money" />}
      <Tile label="Consent" value={consentValue} tone={consentValue === 'On record' ? 'accent' : consentValue === '—' ? 'default' : 'warn'} note={consentNote} icon="file" href="#consent" />
    </div></div>
  </Pane>

  {/* The record's body: its colour-coded index beside the sections (./_record/RecordNav.astro). */}
  <div class="rec-body">
  <RecordNav items={SECTIONS.map((x) => ({ id: x.id, label: x.label, count: 'count' in x ? x.count : null }))} current={current} name={shortName} />
  <div class="rec-main">

  <!-- Overview -->
  <div id="rec-overview" role="tabpanel" aria-labelledby="rec-rec-overview-tab" hidden={current !== 'overview'} class="min-w-0 grid items-start gap-4 max-md:gap-3 lg:grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)] content-start hue-teal" data-rec-panel="overview">
    <Banner id="overview" label={SECTION_LABEL.overview} class="lg:col-span-2" />
    <Pane title="Details" icon="user" id="overview">
      <dl class="pt-facts">
        {present.map(([k, v]) => <><dt>{k}</dt><dd>{v}</dd></>)}
      </dl>
      {missing.length > 0 && (
        <p class="mt-4 flex flex-wrap items-center gap-x-3 text-[14px] text-ink-2">
          <span>Not on file yet: {missing.join(', ')}.</span>
          {canEdit && <button type="button" class="ws-empty-go" data-ws-open="details">Add them <Icon name="arrow-right" size={16} /></button>}
        </p>
      )}
      {patient.notes && (
        <div class="mt-5 border-t border-[var(--ws-hair)] pt-4">
          <p class="meta">Notes</p>
          <p class="mt-1.5 max-w-[70ch] text-[15px] leading-relaxed whitespace-pre-line text-ink-2">{patient.notes}</p>
        </div>
      )}
      <p class="mt-5 flex items-start gap-2 border-t border-[var(--ws-hair)] pt-4 text-[13.5px] leading-relaxed text-muted">
        <Icon name="info" size={16} class="mt-0.5 shrink-0" />
        <span>Every look at this record, and every change to it, is logged under the person’s name.</span>
      </p>
    </Pane>
    <div class="grid content-start gap-4 max-md:gap-3">
      <RecallCard recall={clin.recall} canEdit={canEdit} action={recHere} problem={recordProblem} saved={saved} today={today} firstName={patient.first_name} bookHref={bookHref} />
      {(planOpen.length > 0 || clin.labs.some((l) => l.status !== 'fitted')) && (
        <Pane as="section" label="Treatment, in short" class="hue-blue">
          <Head icon="plan" title="Treatment plan">
            <button slot="actions" type="button" class="ws-btn ws-btn-quiet ws-btn-sm" data-rec-go="treatment">Open</button>
          </Head>
          {planOpen.length > 0 ? (
            <ul class="pt-list">
              {planOpen.slice(0, 4).map((i) => (
                <li>
                  <span class="min-w-0 text-[14.5px]"><span class="font-semibold">{i.name}</span><span class="block text-ink-2">{[i.fdi ? `Tooth ${i.fdi}${i.surface ? ` ${i.surface}` : ''}` : null, `Phase ${i.phase}`].filter(Boolean).join(' · ')}</span></span>
                  <Chip tone={i.status === 'accepted' ? 'warn' : 'neutral'} label={i.status === 'accepted' ? 'Agreed' : 'Planned'} />
                </li>
              ))}
            </ul>
          ) : <p class="text-[15px] text-ink-2">Nothing left on the plan.</p>}
          {planOpen.length > 4 && <p class="mt-2 text-[13.5px] text-ink-2">And {planOpen.length - 4} more.</p>}
          {clin.labs.filter((l) => l.status !== 'fitted').map((l) => <p class="mt-3 flex items-start gap-2 text-[14px] text-ink-2"><Glyph name="lab" size={16} class="mt-0.5 shrink-0" /><span>Lab: {l.description} · {l.lab}{l.dueOn && !l.receivedOn ? ` · due ${dateText(l.dueOn)}` : ''}</span></p>)}
        </Pane>
      )}
      {data.latestForm && (
        <Pane as="section" label="From the patient forms" class="hue-violet">
          <Head icon="form" title="From the patient forms" meta={`Sent ${day(data.latestForm.submittedAt)} · ${data.latestForm.ref}`}>
            <a slot="actions" href={`${formsBase}${data.latestForm.id}/`} class="ws-btn ws-btn-quiet ws-btn-sm">All answers</a>
          </Head>
          {visitFromForm.length ? (
            <dl class="pt-facts">{visitFromForm.map(([k, v]) => <><dt>{k}</dt><dd>{v}</dd></>)}</dl>
          ) : <p class="text-[15px] text-ink-2">Nothing about this visit on the form.</p>}
        </Pane>
      )}
      <Pane as="section" label="Health, in short" class="hue-rose">
        <Head icon="heart" title="Health">
          <button slot="actions" type="button" class="ws-btn ws-btn-quiet ws-btn-sm" data-rec-go="health">{canEdit ? 'Update' : 'Open'}</button>
        </Head>
        {latest && answered(latest) ? (
          <>
            <dl class="pt-facts">
              {LISTS.map((l) => <><dt>{l.key === 'medications' ? 'Medicines' : l.label}</dt><dd>{listLine(latest[l.key], l.none)}</dd></>)}
            </dl>
            <p class="mt-3 text-[13.5px] text-muted">Updated {byLine(latest)}.</p>
          </>
        ) : (
          <Empty icon="info" text="No health answers yet. Ask the patient before treatment." />
        )}
      </Pane>
      <Pane title="Recent visits" icon="calendar">
        {visits.length > 4 && <button slot="actions" type="button" class="ws-btn ws-btn-quiet ws-btn-sm" data-rec-go="visits">See all {visits.length}</button>}
        {visits.length === 0 ? <Empty icon="calendar" text="No visits yet." action={{ label: 'Book the first one', href: bookHref }} /> : (
          <ul class="pt-list">
            {visits.slice(0, 4).map((v) => (
              <li>
                <span class="min-w-0 text-[14.5px]"><span class="font-semibold tabular-nums">{visitText(v)}</span><span class="block text-ink-2">{[v.reason, v.dentist].filter(Boolean).join(' · ') || '—'}</span></span>
                <span class="flex gap-1.5">{v.source === 'import' && <Chip tone="neutral" label="Imported" />}<Chip status={v.status} /></span>
              </li>
            ))}
          </ul>
        )}
      </Pane>
    </div>
  </div>

  <!-- Timeline -->
  <div id="rec-timeline" role="tabpanel" aria-labelledby="rec-rec-timeline-tab" hidden={current !== 'timeline'} class="min-w-0 grid gap-4 max-md:gap-3 content-start hue-teal" data-rec-panel="timeline">
    <Banner id="timeline" label={SECTION_LABEL.timeline} />
    <Timeline events={data.timeline} sections={SECTIONS.map((x) => x.id)} />
  </div>

  <!-- Health -->
  <div id="rec-health" role="tabpanel" aria-labelledby="rec-rec-health-tab" hidden={current !== 'health'} class="min-w-0 grid gap-4 max-md:gap-3 content-start hue-rose" data-rec-panel="health">
    <Banner id="health" label={SECTION_LABEL.health} />
    <Vitals vitals={ext.vitals} canEdit={canEdit} action={recHere} problem={recordProblem} saved={saved} firstName={patient.first_name} />
    <Pane as="section" label="Health" id="health">
      <Head icon="heart" title="Health" />
      <p class="-mt-2 text-[14px] text-muted">
        {!latest ? 'Nothing recorded yet. Ask the patient before treatment.'
          : answered(latest) ? `Updated ${byLine(latest)}.`
          : `No health answers yet. Ask the patient before treatment. Last saved ${byLine(latest)}.`}
      </p>

      {(saved === 'health' || saved === 'birth') && <Callout tone="success" class="mt-4" text="Saved." />}
      {saved === 'nothing' && <Callout tone="info" class="mt-4" text="Nothing was saved: nothing is ticked or typed yet." />}
      {conflict && (
        <Callout tone="warn" role="alert" class="mt-4">
          <p class="font-semibold">
            {conflict.versionMoved && conflict.latest ? `${conflict.latest.by ?? 'Someone'} saved this record ${when(new Date(conflict.latest.at))}, after you opened it.`
              : conflict.birthMoved ? `The birth date on file changed to ${dateText(conflict.birth) ?? 'none'} after you opened this page.`
              : 'This record changed after you opened it.'} Nothing of yours was saved yet.
          </p>
          <p class="mt-1.5 text-ink-2">On file now: {birthLine(conflict.birth)}{conflict.latest && <> · {stateLine(conflict.latest)}</>}.</p>
          <p class="mt-1.5 text-ink-2">Your answers are still below. Check them against what is on file, then press Save again.</p>
        </Callout>
      )}
      {healthProblems.length > 0 && <Callout tone="alert" class="mt-4" title={`Nothing was saved. ${healthProblems.length === 1 ? 'One thing' : 'A few things'} to fix:`} items={healthProblems} />}

      {canEdit ? (
        <form method="post" action={`${here}#health`} class="mt-5" data-health-form data-health-unsaved={posted ? '' : undefined}>
          <Csrf />
          <input type="hidden" name="intent" value="health" />
          <input type="hidden" name="base" value={base} />
          <input type="hidden" name="birth_was" value={birthWas} />

          <div class="field border-b border-[var(--ws-hair)] pb-5">
            <label for="birth_date" class="meta">Birth date</label>
            <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
              <input id="birth_date" type="date" name="birth_date" value={birthValue} min="1900-01-01" max={today} class="w-[13.5rem]" data-health-birth data-today={today} />
              <span class="text-[15px] text-ink-2" aria-live="polite" data-health-age>{formAge !== null && formAge >= 0 ? ageText(formAge) : birthValue ? '' : 'Not on file yet'}</span>
            </div>
          </div>

          <HealthLists chips={healthChips} none={healthNone} />

          <label class="field border-t border-[var(--ws-hair)] pt-5">
            <span class="meta">Note for the dentist</span>
            <textarea name="note" rows="2" maxlength={NOTE_MAX} placeholder="Anything to know before starting. For example: faints at injections.">{shown.note ?? ''}</textarea>
          </label>

          <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2">
            <button type="submit" class="ws-btn ws-btn-primary min-w-[9rem]" data-health-save><Icon name="check" />Save</button>
            <span class="ws-pill ws-tint-amber" data-health-dirty hidden={!posted}>Not saved yet</span>
            <span class="text-[13.5px] text-muted">Saved as a new version under your name. Earlier versions stay.</span>
          </div>
        </form>
      ) : (
        <dl class="pt-facts mt-5">
          <dt>Birth date</dt><dd>{patient.birth ? `${dateText(patient.birth)}${age !== null ? ` · ${ageText(age)}` : ''}` : 'Not on file'}</dd>
          {LISTS.map((l) => <><dt>{l.label}</dt><dd>{listLine(latest?.[l.key] ?? null, l.none)}</dd></>)}
          <dt>Note</dt><dd>{latest?.note ?? '—'}</dd>
        </dl>
      )}

      {health.total > 0 && (
        <details class="pt-more mt-5 border-t border-[var(--ws-hair)] pt-2">
          <summary>Earlier versions ({health.total}) <Icon name="chevron" size={16} class="pt-chev" /></summary>
          <ol class="pt-list mt-1">
            {health.versions.map((v, i) => {
              const prev = health.versions[i + 1] ?? health.older;
              const what = versionChanges(prev, v);
              return (
                <li class="!block">
                  <p class="text-[14.5px] font-semibold">{byLine(v)}</p>
                  <p class="mt-0.5 text-[14.5px] text-ink-2">{!prev ? [...what, 'First record.'].join(' · ') : what.length ? what.join(' · ') : 'Checked, no change.'}</p>
                  <p class="mt-0.5 text-[13.5px] text-muted">{stateLine(v)}</p>
                </li>
              );
            })}
          </ol>
          {health.total > health.versions.length && <p class="mt-2 text-[13.5px] text-muted">The {health.versions.length} newest are shown.</p>}
        </details>
      )}
    </Pane>
  </div>

  <!-- Chart -->
  <div id="rec-chart" role="tabpanel" aria-labelledby="rec-rec-chart-tab" hidden={current !== 'chart'} class="min-w-0 grid gap-4 max-md:gap-3 content-start hue-blue" data-rec-panel="chart">
    <Banner id="chart" label={SECTION_LABEL.chart} />
    <Pane as="section" label="Chart" id="chart" class="pt-chart-pane">
      <Head icon="tooth" title="Chart" />
      <p class="-mt-2 mb-4 text-[14px] text-muted">Every change is saved as you make it, under your name.</p>
      {/* The odontogram as it is (src/components/Odontogram.astro, its offline logic untouched),
          drawn soft by patients.css ("The chart") and laid out by the width of this card: the
          teeth fit the card's width, the chart note goes under the arches when there is no room
          beside them, and where a whole arch still cannot fit (a phone) the line below says so. */}
      <p class="pt-chart-scroll" data-pt-chart-scroll hidden>Scroll sideways to see every tooth <Icon name="arrow-right" size={16} /></p>
      <div class="pt-chart" data-pt-chart>
        <Odontogram marks={marks} notation={me.notation as Notation} saveUrl="/api/chart" patientId={patient.id} clinic={clinic.slug} csrf={csrf} />
      </div>

      {/* The findings as the server had them, newest concern first. When there are none the chart
          note above already says so, once. */}
      {findings.length > 0 && (
        <>
          <h3 class="mt-8 text-[16px] font-semibold">Findings</h3>
          <p class="mt-0.5 text-[13.5px] text-muted">As they stood when this page opened.</p>
          <ul class="mt-3 grid gap-2.5 sm:grid-cols-2 lg:grid-cols-3">
            {findings.map((f) => (
              <li class="pt-inset flex items-center gap-3 px-4 py-3">
                <span class="tooth pt-find-swatch h-8! w-6! shrink-0" data-state={f.condition} aria-hidden="true"></span>
                <div>
                  <p class="text-[15px] font-semibold tabular-nums">Tooth {f.fdi}{f.codes && <span class="text-accent"> {f.codes}</span>}</p>
                  <p class="text-[13.5px] text-ink-2">{CONDITION_LABEL[f.condition]}</p>
                </div>
              </li>
            ))}
          </ul>
        </>
      )}
    </Pane>
  </div>

  <!-- Treatment -->
  <div id="rec-treatment" role="tabpanel" aria-labelledby="rec-rec-treatment-tab" hidden={current !== 'treatment'} class="min-w-0 grid gap-4 max-md:gap-3 content-start hue-blue" data-rec-panel="treatment">
    <Banner id="treatment" label={SECTION_LABEL.treatment} />
    <Treatment c={clin} loas={ext.loas} canEdit={canEdit} action={recHere} meId={session.staffId} problem={recordProblem} saved={recordSaved(saved) === 'treatment' ? saved : null} today={today} firstName={patient.first_name} />
    <div class="mt-4 grid gap-4 max-md:mt-3 max-md:gap-3">
      <Loas loas={ext.loas} plan={clin.plan} payors={ext.hmoPayors} hmoName={patient.hmo_name} memberNo={patient.hmo_member_no} canEdit={canEdit} action={recHere} problem={recordProblem} saved={saved} today={today} firstName={patient.first_name} settingsHref={`/c/${clinic.slug}/settings/`} />
      <PayPlans plans={ext.plans} canEdit={canEdit} canBill={money} action={recHere} problem={recordProblem} saved={saved} today={today} firstName={patient.first_name} financesBase={links.finances} />
    </div>
  </div>

  <!-- Notes -->
  <div id="rec-notes" role="tabpanel" aria-labelledby="rec-rec-notes-tab" hidden={current !== 'notes'} class="min-w-0 grid gap-4 max-md:gap-3 content-start hue-blue" data-rec-panel="notes">
    <Banner id="notes" label={SECTION_LABEL.notes} />
    <Notes c={clin} canEdit={canEdit} action={recHere} meId={session.staffId} problem={recordProblem} saved={saved} today={today} firstName={patient.first_name} />
  </div>

  <!-- Prescriptions -->
  <div id="rec-rx" role="tabpanel" aria-labelledby="rec-rec-rx-tab" hidden={current !== 'rx'} class="min-w-0 grid gap-4 max-md:gap-3 content-start hue-violet" data-rec-panel="rx">
    <Banner id="rx" label={SECTION_LABEL.rx} />
    <Prescriptions c={clin} canEdit={canEdit} action={recHere} meId={session.staffId} problem={recordProblem} saved={saved} firstName={patient.first_name} printBase={`${here}rx/`} allergies={allergies} typedRows={rxTyped} />
    <div class="mt-4 max-md:mt-3">
      <Letters letters={ext.letters} clinicians={clin.clinicians} canEdit={canEdit} action={recHere} meId={session.staffId} problem={recordProblem} saved={saved} today={today} firstName={patient.first_name} printBase={`${here}letters/`} lastVisit={lastVisit ? manilaDay(lastVisit.starts_at) : null} conditions={conditions} />
    </div>
  </div>

  <!-- Files -->
  <div id="rec-files" role="tabpanel" aria-labelledby="rec-rec-files-tab" hidden={current !== 'files'} class="min-w-0 grid gap-4 max-md:gap-3 content-start hue-blue" data-rec-panel="files">
    <Banner id="files" label={SECTION_LABEL.files} />
    <Files c={clin} canEdit={canEdit} action={recHere} problem={recordProblem} saved={saved} today={today} firstName={patient.first_name} fileBase={`${here}files/`} />
  </div>

  <!-- Visits -->
  <div id="rec-visits" role="tabpanel" aria-labelledby="rec-rec-visits-tab" hidden={current !== 'visits'} class="min-w-0 grid gap-4 max-md:gap-3 content-start hue-teal" data-rec-panel="visits">
    <Banner id="visits" label={SECTION_LABEL.visits} />
    <Pane title="Visits" icon="calendar" id="visits" meta={visits.length === 200 ? 'The newest 200' : `${visits.length} on record`} pad="none">
      {visits.length === 0 ? (
        <div class="px-6 py-3 max-md:px-4"><Empty icon="calendar" text="No visits yet." action={canEdit ? { label: 'Bring in past visits from a spreadsheet', href: importHref } : { label: 'Book the first one', href: bookHref }} /></div>
      ) : (
        <table class="ws-table">
          <caption class="sr-only">Visits of {shortName}, newest first</caption>
          <thead>
            <tr>
              <th scope="col" class="meta">When</th>
              <th scope="col" class="meta">Service</th>
              <th scope="col" class="meta">Dentist</th>
              <th scope="col" class="meta">Teeth</th>
              <th scope="col" class="meta">Status</th>
              {money && <th scope="col" class="meta text-right">Charged</th>}
            </tr>
          </thead>
          <tbody>
            {visits.map((v) => (
              <tr>
                <td class="text-[14.5px] whitespace-nowrap tabular-nums">
                  <span class="font-semibold">{visitText(v)}</span>
                  <span class="block text-[13px] text-muted">{SOURCE[v.source] ?? v.source}{v.chair ? ` · chair ${v.chair}` : ''}</span>
                </td>
                <td class="text-[15px]"><span class="meta ws-cell-label">Service</span>{v.reason ?? '—'}{v.notes && <span class="block max-w-[40ch] text-[13.5px] text-ink-2 max-lg:max-w-none">{v.notes}</span>}</td>
                <td class="text-[15px]"><span class="meta ws-cell-label">Dentist</span>{v.dentist ?? <span class="text-muted">—</span>}{v.dentist_free && <span class="block text-[13px] text-muted">As the old record has it</span>}</td>
                <td class="text-[15px] tabular-nums"><span class="meta ws-cell-label">Teeth</span>{v.teeth?.length ? v.teeth.join(', ') : <span class="text-muted">—</span>}</td>
                <td><span class="meta ws-cell-label">Status</span><Chip status={v.status} /></td>
                {money && <td class="text-right text-[15px] tabular-nums max-lg:text-left"><span class="meta ws-cell-label">Charged</span>{v.charged ? pesos(v.charged) : <span class="text-muted">—</span>}</td>}
              </tr>
            ))}
          </tbody>
        </table>
      )}
    </Pane>
  </div>

  <!-- Money -->
  {money && (
    <div id="rec-money" role="tabpanel" aria-labelledby="rec-rec-money-tab" hidden={current !== 'money'} class="min-w-0 grid gap-4 max-md:gap-3 content-start hue-green" data-rec-panel="money">
    <Banner id="money" label={SECTION_LABEL.money} />
      <Pane title="Money" icon="money" id="money" pad="none">
        <Fragment slot="actions">
          <a href={`${links.finances}?patient=${patient.id}&view=all`} class="ws-btn ws-btn-quiet ws-btn-sm">In Finances <Icon name="arrow-right" size={16} /></a>
          <a href={chargeHref} class="ws-btn ws-btn-quiet ws-btn-sm"><Icon name="plus" />New charge</a>
        </Fragment>
        <p class="border-b border-[var(--ws-hair)] px-6 py-4 text-[15px] text-ink-2 max-md:px-4">
          {balance > 0n ? <>Owes <span class="font-semibold text-caries tabular-nums">{pesos(balance)}</span>{openCount ? ` on ${openCount} ${openCount === 1 ? 'statement' : 'statements'}` : ''}.</>
            : balance < 0n ? <>In credit <span class="font-semibold tabular-nums">{pesos(-balance)}</span>.</>
            : <>Nothing owed.</>}
          {' '}Paid <span class="font-semibold tabular-nums">{pesos(paidAll)}</span> in all.
          <span class="mt-0.5 block text-[13px] text-muted">Statements of account, not BIR receipts.</span>
        </p>
        {stmts.length === 0 ? (
          <div class="px-6 py-3 max-md:px-4"><Empty icon="money" text="No statements for this patient yet." action={{ label: 'New charge', href: chargeHref }} /></div>
        ) : (
          <table class="ws-table">
            <caption class="sr-only">Statements of {shortName}, newest first</caption>
            <thead>
              <tr>
                <th scope="col" class="meta">Statement</th>
                <th scope="col" class="meta">For</th>
                <th scope="col" class="meta text-right">Total</th>
                <th scope="col" class="meta text-right">Paid</th>
                <th scope="col" class="meta text-right">Left</th>
                <th scope="col" class="meta">Status</th>
              </tr>
            </thead>
            <tbody>
              {stmts.map((s) => {
                const st = BILL_STATUS[s.status] ?? BILL_STATUS.issued;
                return (
                  <tr>
                    <td class="whitespace-nowrap"><a href={`${links.finances}${s.id}/`} class="inline-flex min-h-11 items-center font-mono text-[14px] font-medium text-accent underline-offset-4 hover:underline">{statementNo(s.series_prefix, s.number)}</a><span class="block text-[13px] text-muted tabular-nums">{dateText(manilaDay(s.issued_at))}{s.imported_at ? ' · brought in' : ''}</span></td>
                    <td class="text-[14.5px]"><span class="meta ws-cell-label">For</span>{s.first_line ?? '—'}{s.n_lines > 1 && <span class="text-muted"> and {s.n_lines - 1} more</span>}{s.payor_name && <span class="block text-[13px] text-muted">{s.payor_name} part {pesos(fromDb(s.payor_share))}</span>}</td>
                    <td class="text-right text-[15px] tabular-nums max-lg:text-left"><span class="meta ws-cell-label">Total</span>{pesos(s.total)}</td>
                    <td class="text-right text-[15px] tabular-nums max-lg:text-left"><span class="meta ws-cell-label">Paid</span>{pesos(s.paid)}</td>
                    <td class="text-right text-[15px] font-semibold tabular-nums max-lg:text-left"><span class="meta ws-cell-label">Left</span>{pesos(s.left)}</td>
                    <td><span class="meta ws-cell-label">Status</span><span class:list={['ws-chip', STMT_TINT[s.status] ?? 'ws-tint-slate']}>{st.label}</span></td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        )}
      </Pane>
    </div>
  )}

  <!-- Consent -->
  <div id="rec-consent" role="tabpanel" aria-labelledby="rec-rec-consent-tab" hidden={current !== 'consent'} class="min-w-0 grid gap-4 max-md:gap-3 content-start hue-violet" data-rec-panel="consent">
    <Banner id="consent" label={SECTION_LABEL.consent} />
    <Pane as="section" label="Privacy consent">
      <Head icon="shield" title="Privacy consent" />
      <DeskConsent notice={data.notice} consents={data.consents} canRecord={canEdit} minor={minor} birthKnown={!!patient.birth} dpo={data.dpo} action={`${here}#consent`}
        problem={consentProblem} givenBy={givenBy} agreedAs={agreedAs} recorded={saved === 'consent' ? 'saved' : saved === 'consent-already' ? 'already' : null}
        paperForms={data.paperForms} paper={{ ...paperState, recorded: saved === 'paper' ? 'saved' : null }} />
    </Pane>
    {data.forms.length > 0 && (
      <Pane as="section" label="Patient forms" id="patient-forms" class="mt-4 max-md:mt-3">
        <Head icon="form" title="Patient forms" meta={`${data.forms.length === 1 ? 'One form' : `${data.forms.length} forms`} from the QR code`} />
        <p class="-mt-2 mb-3 text-[14px] text-ink-2">Filled in on the patient’s own phone: their details, health and dental history, the consent to examination and treatment, and the privacy notice.</p>
        <ul class="pt-list fm-rec-list">
          {data.forms.map((f) => (
            <li>
              <div class="min-w-0 text-[14.5px]">
                <p><span class="font-semibold">Sent {when(f.submittedAt)}</span> <span class="pt-ref ml-1">{f.ref}</span></p>
                <p class="text-ink-2">Signed by {signedText(f.signedByName, f.signedAs)}. Added {f.addedAs === 'new' ? 'as a new patient' : 'to this record'}{f.addedByName ? ` by ${f.addedByName}` : ''}, {day(f.addedAt)}.</p>
                <p class="fm-rec-consents">
                  {(['treatment', 'privacy'] as const).map((k) => {
                    const what = k === 'treatment' ? 'Examination and treatment' : 'Privacy notice';
                    const st = f.consentState[k];
                    return st === 'form' ? <Chip tone="accent" icon="check">{what}</Chip>
                      : st === 'on-file' ? <Chip tone="neutral" label={`${what}: already on file`} />
                      : <Chip tone="warn" icon="alert">{`${what}: not recorded (a guardian must agree)`}</Chip>;
                  })}
                </p>
              </div>
              <span class="flex flex-wrap gap-2">
                <a href={`${formsBase}${f.id}/`} class="ws-btn ws-btn-quiet ws-btn-sm">See answers</a>
                <a href={`${formsBase}${f.id}/print/`} class="ws-btn ws-btn-quiet ws-btn-sm"><Glyph name="print" />Print</a>
              </span>
            </li>
          ))}
        </ul>
      </Pane>
    )}
  </div>

  <!-- Texts -->
  <div id="rec-texts" role="tabpanel" aria-labelledby="rec-rec-texts-tab" hidden={current !== 'texts'} class="min-w-0 grid gap-4 max-md:gap-3 content-start hue-violet" data-rec-panel="texts">
    <Banner id="texts" label={SECTION_LABEL.texts} />
    <Pane title="Texts" icon="message" id="texts" meta={data.texts.length === 50 ? 'The newest 50' : `${data.texts.length} about this patient`} pad="none">
      <a slot="actions" href={links.messages} class="ws-btn ws-btn-quiet ws-btn-sm">All messages <Icon name="arrow-right" size={16} /></a>
      {data.texts.length === 0 ? (
        <div class="px-6 py-3 max-md:px-4"><Empty icon="message" text="No texts to or from this patient yet. Booking confirmations and reminders show here." /></div>
      ) : (
        <table class="ws-table">
          <caption class="sr-only">Texts to and from {shortName}, newest first</caption>
          <thead><tr><th scope="col" class="meta">When</th><th scope="col" class="meta">Status</th><th scope="col" class="meta">Text</th></tr></thead>
          <tbody>
            {data.texts.map((m) => {
              const st = textStatus(m);
              return (
                <tr>
                  <td class="text-[14.5px] whitespace-nowrap tabular-nums">{when(new Date(m.created_at))}<span class="block text-[13px] text-muted">{m.direction === 'in' ? 'Reply' : TEXT_KIND[m.kind ?? ''] ?? 'Text'}</span></td>
                  <td><span class="meta ws-cell-label">Status</span><Chip tone={st.tone} label={st.label} dot={st.tone === 'alert'} /></td>
                  <td class="max-w-[40rem] text-[14.5px] leading-relaxed break-words whitespace-pre-wrap"><span class="meta ws-cell-label">Text</span>{m.body ?? <span class="text-muted">A sign-in code. It is not shown here.</span>}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      )}
    </Pane>
  </div>

  </div>
  </div>

  {canEdit && (
    <SidePanel id="details" title="Edit details" meta={shortName} wide open={detailsProblems.length > 0}>
      {detailsProblems.length > 0 && <Callout tone="alert" class="mb-5" title="Nothing was saved." items={detailsProblems} />}
      <form method="post" action={`${here}#overview`} class="grid gap-4">
        <Csrf />
        <input type="hidden" name="intent" value="details" />
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="field"><span class="meta">Last name</span><input name="last_name" value={d.last} required maxlength="60" autocomplete="off" /></label>
          <label class="field"><span class="meta">First name</span><input name="first_name" value={d.first} required maxlength="60" autocomplete="off" /></label>
          <label class="field"><span class="meta">Middle name</span><input name="middle_name" value={d.middle ?? ''} maxlength="60" autocomplete="off" /></label>
          <label class="field"><span class="meta">Suffix</span><input name="suffix" value={d.suffix ?? ''} maxlength="10" autocomplete="off" placeholder="Jr., Sr., III" /></label>
        </div>
        <fieldset class="min-w-0">
          <legend class="float-left w-full text-[14px] font-medium text-ink-2">Sex</legend>
          <div class="pk-row clear-both pt-2">
            {SEXES.map((x) => (
              <label class="pk pk-radio"><input type="radio" name="sex" value={x.id} checked={d.sex === x.id} /><span>{x.label}</span></label>
            ))}
          </div>
        </fieldset>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="field"><span class="meta">Mobile</span><input type="tel" name="mobile" value={d.phone ? prettyPhone(d.phone) : ''} inputmode="tel" autocomplete="off" /><span class={help}>Reminders go to it.</span></label>
          <label class="field"><span class="meta">Email</span><input type="email" name="email" value={d.email ?? ''} maxlength="120" autocomplete="off" /></label>
          <label class="field sm:col-span-2"><span class="meta">Address</span><input name="address" value={d.address ?? ''} maxlength="200" autocomplete="off" /></label>
          <label class="field"><span class="meta">City or town</span><input name="city" value={d.city ?? ''} maxlength="80" autocomplete="off" /></label>
          <label class="field"><span class="meta">Province</span><input name="province" value={d.province ?? ''} maxlength="80" autocomplete="off" /></label>
          <label class="field"><span class="meta">HMO</span><input name="hmo_name" value={d.hmoName ?? ''} maxlength="80" autocomplete="off" list="rec-hmo-names" /></label>
          <label class="field"><span class="meta">HMO member no.</span><input name="hmo_member_no" value={d.hmoMemberNo ?? ''} maxlength="40" autocomplete="off" /></label>
          <label class="field"><span class="meta">Emergency contact</span><input name="emergency_name" value={d.emergencyName ?? ''} maxlength="120" autocomplete="off" /></label>
          <label class="field"><span class="meta">Relation</span><input name="emergency_relation" value={d.emergencyRelation ?? ''} maxlength="40" autocomplete="off" /></label>
          <label class="field"><span class="meta">Their number</span><input type="tel" name="emergency_phone" value={d.emergencyPhone ? prettyPhone(d.emergencyPhone) : ''} maxlength="20" inputmode="tel" autocomplete="off" /></label>
          <label class="field"><span class="meta">Chart no.</span><input name="chart_no" value={d.chartNo ?? ''} maxlength="20" autocomplete="off" /><span class={help}>Change it only to match the card.</span></label>
        </div>
        <label class="field"><span class="meta">Notes</span><textarea name="notes" rows="3" maxlength={NOTES_MAX}>{d.notes ?? ''}</textarea></label>
        <datalist id="rec-hmo-names">{data.hmoNames.map((h) => <option value={h} />)}</datalist>
        <p class="flex items-start gap-2 text-[13.5px] text-muted"><Icon name="info" size={16} class="mt-0.5 shrink-0" />The birth date is changed on Health, where its history is kept.</p>
        <div><button type="submit" class="ws-btn ws-btn-primary w-full"><Icon name="check" />Save details</button></div>
      </form>
    </SidePanel>
  )}
</ClinicLayout>

<script>
  import { ageOn, ageText, capitalise } from '../../../../lib/health';

  // --- the sections: in the address, so a reload or a post lands where it was ---
  const list = document.querySelector<HTMLElement>('.rec-tabs');
  const tabFor = (name: string) => document.getElementById(`rec-rec-${name}-tab`) as HTMLButtonElement | null;
  const panelOf = (el: Element | null) => el?.closest<HTMLElement>('[data-rec-panel]')?.dataset.recPanel ?? null;
  const show = (name: string, focus = false) => {
    const t = tabFor(name);
    if (!t) return false;
    if (t.getAttribute('aria-selected') !== 'true') t.click();
    t.scrollIntoView({ block: 'nearest', inline: 'nearest' });
    if (focus) t.focus();
    return true;
  };
  const fromHash = () => {
    const id = decodeURIComponent(location.hash.slice(1));
    if (!id) return;
    const target = document.getElementById(id);
    const name = panelOf(target) ?? id.replace(/^rec-/, '');
    if (show(name) && target && !target.matches('[data-rec-panel]')) requestAnimationFrame(() => target.scrollIntoView({ block: 'start' }));
  };
  list?.addEventListener('ws:tab', (e) => {
    const id = String((e as CustomEvent).detail?.id ?? '').replace(/^rec-/, '');
    if (id && location.hash !== `#${id}`) history.replaceState(null, '', `${location.pathname}${location.search}#${id}`);
    tabFor(id)?.scrollIntoView({ block: 'nearest', inline: 'nearest' });
  });
  window.addEventListener('hashchange', fromHash);
  fromHash();
  document.querySelectorAll<HTMLElement>('[data-rec-go]').forEach((b) => b.addEventListener('click', () => { show(b.dataset.recGo!, true); }));
  // A quick action in More (a note, a plan item, a prescription, a file) brings its section forward behind its panel.
  document.querySelectorAll<HTMLElement>('[data-rec-show]').forEach((b) => b.addEventListener('click', () => { show(b.dataset.recShow!); }));

  // The chart speaks up: a copy of this page kept for a brownout opens on the Chart, and a
  // notice the chart raises (a colleague's newer finding, changes waiting on this device)
  // brings the Chart forward, wherever the person was.
  if (document.documentElement.dataset.offlineCopy) show('chart');
  const notices = document.querySelectorAll<HTMLElement>('[data-hold-note], [data-sync-notice], [data-copy-note]');
  const watch = new MutationObserver(() => { if ([...notices].some((n) => !n.hidden)) show('chart'); });
  notices.forEach((n) => watch.observe(n, { attributes: true, attributeFilter: ['hidden'] }));
  if ([...notices].some((n) => !n.hidden)) show('chart');

  // The chart in its card (the look and the layout are patients.css, "The chart"). The
  // component's empty line was written for a demo chart; a record says what to do. Where an
  // arch is wider than the card (a phone), the line above the chart says so, the edge where
  // teeth wait fades (data-pt-more), and the two arches scroll together, so the upper teeth
  // stay over the lower ones — arrow keys moving to a hidden tooth scroll both.
  const chart = document.querySelector<HTMLElement>('[data-pt-chart]');
  if (chart) {
    const empty = chart.querySelector<HTMLElement>('[data-note-empty]');
    if (empty) empty.textContent = 'Nothing charted yet. Pick a tooth to add a finding.';
    const hint = document.querySelector<HTMLElement>('[data-pt-chart-scroll]');
    const arches = [...new Set([...chart.querySelectorAll<HTMLElement>('[data-tooth]')]
      .map((t) => t.closest<HTMLElement>('.overflow-x-auto'))
      .filter((a): a is HTMLElement => !!a))];
    const measure = () => {
      let any = false;
      for (const a of arches) {
        const room = a.scrollWidth - a.clientWidth;
        const over = a.clientWidth > 0 && room > 1;
        any ||= over;
        const left = over && a.scrollLeft > 1;
        const right = over && a.scrollLeft < room - 1;
        if (left || right) a.dataset.ptMore = left && right ? 'both' : left ? 'left' : 'right';
        else delete a.dataset.ptMore;
      }
      if (hint) hint.hidden = !any;
    };
    let lead: HTMLElement | null = null;
    for (const a of arches) {
      a.addEventListener('scroll', () => {
        if (lead && lead !== a) return;
        lead = a;
        for (const b of arches) if (b !== a && Math.abs(b.scrollLeft - a.scrollLeft) > 1) b.scrollLeft = a.scrollLeft;
        measure();
        requestAnimationFrame(() => { if (lead === a) lead = null; });
      }, { passive: true });
    }
    const sized = new ResizeObserver(measure);
    arches.forEach((a) => { sized.observe(a); if (a.firstElementChild) sized.observe(a.firstElementChild); });
    measure();
  }

  // The health form. Chips are checkboxes, so the form posts without this
  // script too (what is left in an "add" box is split on commas and saved).
  // With it: Enter or Add turns the typed words into ticked chips, the none
  // chip and the others untick each other, the age follows the birth date,
  // and leaving with unsaved changes asks first. "Unsaved" is the form's
  // data-health-unsaved attribute, so the consent form can see it.
  document.querySelectorAll<HTMLFormElement>('[data-health-form]').forEach((form) => {
    const note = form.querySelector<HTMLElement>('[data-health-dirty]');
    const mark = () => { form.toggleAttribute('data-health-unsaved', true); if (note) note.hidden = false; };
    form.addEventListener('input', mark);
    form.addEventListener('change', mark);
    form.addEventListener('submit', () => { form.removeAttribute('data-health-unsaved'); });
    window.addEventListener('beforeunload', (e) => { if (form.hasAttribute('data-health-unsaved')) { e.preventDefault(); e.returnValue = ''; } });

    form.querySelectorAll<HTMLElement>('[data-health-list]').forEach((group) => {
      const chips = group.querySelector<HTMLElement>('[data-health-chips]')!;
      const none = group.querySelector<HTMLInputElement>('[data-health-none]')!;
      const box = group.querySelector<HTMLInputElement>('[data-health-add-input]')!;
      const tpl = group.querySelector<HTMLTemplateElement>('[data-health-tpl]')!;
      const items = () => [...chips.querySelectorAll<HTMLInputElement>('input[type="checkbox"]:not([data-health-none])')];

      chips.addEventListener('change', (e) => {
        const t = e.target as HTMLInputElement;
        if (t === none) { if (t.checked) items().forEach((i) => { i.checked = false; }); }
        else if (t.checked) none.checked = false;
      });

      const add = () => {
        const words = box.value.split(/[,;\n]/).map((s) => capitalise(s.replace(/\s+/g, ' ').trim())).filter(Boolean);
        for (const w of words) {
          const same = items().find((i) => i.value.toLocaleLowerCase('en') === w.toLocaleLowerCase('en'));
          if (same) { same.checked = true; continue; }
          const node = tpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
          const input = node.querySelector('input')!;
          input.value = w;
          input.checked = true;
          node.querySelector('[data-health-chip-text]')!.textContent = w;
          chips.append(node);
        }
        if (words.length) { none.checked = false; mark(); }
        box.value = '';
        box.focus();
      };
      box.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); add(); } });
      group.querySelector<HTMLButtonElement>('[data-health-add]')!.addEventListener('click', add);
    });

    // The age beside the birth date. A date field fills its year a digit at a
    // time (0001, 0019, 0197, 1975), so nothing shows until the year is a
    // real one; a year still before 1900 when the field is left says so.
    const birth = form.querySelector<HTMLInputElement>('[data-health-birth]');
    const age = form.querySelector<HTMLElement>('[data-health-age]');
    const showAge = (leaving: boolean) => {
      if (!birth || !age) return;
      const today = birth.dataset.today ?? '';
      const v = birth.value;
      const years = v ? ageOn(v, today) : null;
      age.textContent = !v ? 'Not on file yet'
        : v < '1900-01-01' ? (leaving ? 'Check the year' : '')
        : years === null || years < 0 || v > today ? 'Check the date'
        : ageText(years);
    };
    birth?.addEventListener('input', () => showAge(false));
    birth?.addEventListener('blur', () => showAge(true));
  });

  // Recording consent reloads the page. With health answers typed and not
  // saved, that would throw them away behind a browser "Leave site?" box, so
  // the consent form stops and says so, with a button that saves them.
  const health = document.querySelector<HTMLFormElement>('[data-health-form]');
  const consent = document.querySelector<HTMLFormElement>('[data-desk-consent-form]');
  const held = document.querySelector<HTMLElement>('[data-desk-consent-held]');
  if (health && consent && held) {
    consent.addEventListener('submit', (e) => {
      if (!health.hasAttribute('data-health-unsaved')) return;
      e.preventDefault();
      held.hidden = false;
      held.querySelector<HTMLButtonElement>('button')?.focus();
    });
    held.querySelector<HTMLButtonElement>('button')?.addEventListener('click', () => health.requestSubmit());
  }
</script>
