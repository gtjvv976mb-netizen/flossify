const used = q.get('used');
const usedLabel = used ? ({ phone: 'mobile', email: 'email', address_line: 'address', city: 'city', province: 'province', sex: 'sex', occupation: 'occupation',
  emergency_name: 'emergency contact', emergency_relation: 'emergency contact’s relation', emergency_phone: 'emergency contact’s number',
  guardian_name: 'parent or guardian', guardian_relation: 'parent or guardian’s relation', guardian_phone: 'parent or guardian’s mobile',
  hmo_name: 'HMO', hmo_member_no: 'HMO card number', middle_name: 'middle name', suffix: 'suffix' } as Record<string, string>)[used] ?? 'detail' : null;
// The tab showing first (landingSection in ./_record/sections.ts, through TAB_OF): where a post came back to, Chart & plan
// for the chart's offer (?treated=), the tab a panel was opened over (?back=), the tab of what was just saved (SAVED_TO,
// recordSaved), Today for a panel to open (?open=), the Treatment record (or Today) for another day's visit (?visit=),
// else Today.
const backQ = backOf(q.get('back'));
// The chart's offer after a treatment (p01 step 2): its state, a write that was skipped (the tooth changed, or the page's
// sign-in ended), or a refused Update the chart. Drawn at the top of the section the post came back to, only.
const offerState = data.offerState;
const chartSkip = q.get('chartskip') === 'changed' || q.get('chartskip') === 'ended' ? (q.get('chartskip') as 'changed' | 'ended') : null;
const offerProblem = recordProblem?.intent === 'chart-apply' ? recordProblem : null;
const showOffer = canEdit && (!!offerProblem || !!chartSkip || !!(offerState && (offerState.applied || calloutWorthy(offerState.offer))));
const treatedQ = UUID.test(q.get('treated') ?? '');
const current = tabOf(landingSection({ backTo, treated: treatedQ, back: backQ, saved, openNow,
  visit: !openVisit ? null : thisVisit ? 'today' : data.ledger.openKeys.has(openVisit) ? 'ledger' : 'other' })) ?? 'overview';
// Where the saved line is drawn: where the address lands (./_record/SavedLine.astro), so it is on screen after the save.
// A treatment the chart could show (?treated=, #chart-offer): at the top of the chart's offer. A card's own button, which
// posts no back (#recall, #treatment …): inside that card, under its title (savedCard). A panel's save (?back=, #<tab>),
// an offer no longer drawn (the address's #chart-offer then shows the tab from its top), or a card that is not on the
// tab showing: at the top of the tab.
const savedAim = !saved ? null : treatedQ ? (showOffer ? 'chart-offer' : null) : backQ ? null : savedCard(saved);
const savedIn = savedAim && tabOf(savedAim) === current ? savedAim : null;
// "Leave the chart as it is": the same address without the offer (and without the saved line it came with).
const leaveOffer = (section: string) => {
  const u = new URLSearchParams(q);
  for (const k of ['treated', 'chartskip', 'saved']) u.delete(k);
  const rest = u.toString();
  return `${here}${rest ? `?${rest}` : ''}#${section}`;
};
// The privacy notice, for the strip: agreed and in force, or what is missing.
const privacyState = { ok: !data.notice || (!!consentNow && !guardianNeeded), words: guardianNeeded ? 'Privacy notice: a parent or guardian must agree for a patient under 18' : 'Privacy notice: not agreed yet' };
// A health history over a year old is asked again (the head says so; the strip offers "No change").
const staleHealth = !!askedV && answered(askedV) && Date.now() - +new Date(askedV.at) > 365 * 864e5;

// --- money --------------------------------------------------------------------
const stmts = data.statements.map((s) => {
  const total = fromDb(s.total), paid = fromDb(s.paid);
  return { ...s, total, paid, left: s.status === 'void' ? 0n : total - paid };
});
const paidAll = stmts.filter((s) => s.status !== 'void').reduce((n, s) => n + s.paid, 0n);
const openCount = stmts.filter((s) => s.status === 'issued' || s.status === 'partly_paid').length;
// A statement's status as a soft pill: paid is green (money in), unpaid red, part-paid amber, void quiet.
const STMT_TINT: Record<string, string> = { paid: 'ws-tint-green', issued: 'ws-tint-red', partly_paid: 'ws-tint-amber' };

// --- texts ---------------------------------------------------------------------
const TEXT_KIND: Record<string, string> = { confirmation: 'Booking confirmation', reminder: 'Reminder', manual: 'Note', reply: 'Reply', recall: 'Check-up due', aftercare: 'Aftercare' };
const textStatus = (m: { direction: string; status: string }) =>
  m.direction === 'in' ? { label: 'Received', tone: 'accent' as const }
  : m.status === 'failed' ? { label: 'Failed', tone: 'alert' as const }
  : m.status === 'delivered' ? { label: 'Delivered', tone: 'accent' as const }
  : m.status === 'sent' ? { label: 'Sent', tone: 'muted' as const }
  : m.status === 'cancelled' ? { label: 'Cancelled', tone: 'muted' as const }
  : { label: 'Waiting to send', tone: 'neutral' as const };

// --- details -------------------------------------------------------------------
const d = detailsPosted ?? {
  chartNo: patient.chart_no, first: patient.first_name, middle: patient.middle_name, last: patient.last_name, suffix: patient.suffix, sex: patient.sex,
  phone: patient.phone, email: patient.email, address: patient.address_line, city: patient.city, province: patient.province, hmoName: patient.hmo_name,
  hmoMemberNo: patient.hmo_member_no, emergencyName: patient.emergency_name, emergencyRelation: patient.emergency_relation, emergencyPhone: patient.emergency_phone, notes: patient.notes,
};
const address = [patient.address_line, patient.city, patient.province].filter(Boolean).join(', ');
const detailRows: [string, string | null][] = [
  ['Full name', fullName],
  ['Birth date', patient.birth ? `${dateText(patient.birth)}${age !== null ? ` · ${ageText(age)}` : ''}` : null],
  ['Sex', patient.sex ? SEX[patient.sex] : null],
  ['Mobile', patient.phone ? prettyPhone(patient.phone) : null],
  ['Email', patient.email],
  ['Address', address || null],
  ['HMO', patient.hmo_name ? `${patient.hmo_name}${patient.hmo_member_no ? ` · member no. ${patient.hmo_member_no}` : ''}` : null],
  ['Emergency contact', patient.emergency_name ? [patient.emergency_name, patient.emergency_relation, patient.emergency_phone && prettyPhone(patient.emergency_phone)].filter(Boolean).join(' · ') : null],
  ['Chart no.', patient.chart_no],
  ['On file since', `${dateText(manilaDay(patient.created_at))}${patient.imported ? ', from an import' : patient.created_by_name ? `, added by ${patient.created_by_name}` : ''}`],
];
// Only what is on file is listed; what is missing is one line, with the way to add it. The desk's note is in the head;
// what the import wrote into the notes (an old phone number, a birth year) is listed here.
const present = [...detailRows.filter(([, v]) => v), ...(importNotes.length ? [['From the old records', importNotes.join(' · ')] as [string, string]] : [])];
const missing = detailRows.filter(([, v]) => !v).map(([k]) => (k === 'HMO' ? k : k.toLowerCase()));
const help = 'text-[13px] leading-snug text-muted';
// The latest patient form's words about this visit, for the Overview.
const lf = data.latestForm?.values ?? null;
const visitFromForm: [string, string][] = lf ? ([
  ['Reason for the visit', lf.reason],
  ['Bothering them', answerText(FIELDS.concerns, lf.concerns) ? [answerText(FIELDS.concerns, lf.concerns), lf.concern_other].filter(Boolean).join(', ') : null],
  ['Last dental visit', answerText(FIELDS.last_visit, lf.last_visit)],
  ['Nervous about visits', answerText(FIELDS.nervous, lf.nervous)],
] as [string, string | null][]).filter((r): r is [string, string] => !!r[1]) : [];
const formsBase = `/c/${clinic.slug}/patients/forms/`;
const recHere = here;

// --- Today (./_record/Today.astro, ./_record/today.ts) ----------------------------------------------------------
// This visit's lines (the first button of the first line is the tab's teal next step), counted on the Today tab.
const visitPlan = thisVisit ? thisVisitPlan({ visit: thisVisit, c: clin, x: ext, signed: data.signed, health: askedV, privacy: privacyState, minor, laterVisitAt,
  canEdit, money, today, action: here, printBase: `${here}rx/`, chargeHref: `${chargeHref}&visit=${thisVisit.id}` }) : null;
// What the patient wrote on their forms in the last 30 days: the reason and what is bothering them, on Today.
const wroteWords = data.latestForm && Date.now() - +new Date(data.latestForm.submittedAt) < 30 * 864e5
  ? visitFromForm.filter(([k]) => k === 'Reason for the visit' || k === 'Bothering them').map(([, v]) => v).join('; ') : '';
const wrote = wroteWords ? { words: wroteWords, href: `${formsBase}${data.latestForm!.id}/` } : null;
// Coming up: every visit booked after now (but this visit), soonest first, with its reminder text's state.
const coming = visits.filter((v) => going(v.status) && v.status !== 'completed' && +v.starts_at > Date.now() && v.id !== thisVisit?.id).reverse().map((v) => ({
  key: v.id as string, when: v.date_only ? dateText(manilaDay(v.starts_at))! : whenText(v.starts_at), what: v.reason as string | null,
  dentist: v.dentist ? drShort(v.dentist) : null, status: v.status as string,
  reminder: reminderWords({ startsAt: v.starts_at, phone: patient.phone }, data.reminders.get(v.id)).text,
}));
const planWords = [...planOpen.slice(0, 4).map((i) => ({ words: `${i.name}${i.fdi ? ` ${i.fdi}${i.surface ? ` ${i.surface}` : ''}` : ''} · ${i.status === 'accepted' ? 'agreed' : 'planned'}` })),
  ...(planOpen.length > 4 ? [{ words: `and ${planOpen.length - 4} more` }] : [])];
// Needs attention: only the lines that apply, each with its one action.
const needs = needsAttention({
  missing,
  stuck: visits.filter((v) => ['arrived', 'in_lobby', 'in_chair'].includes(v.status) && manilaDay(v.starts_at) < today).map((v) => {
    const ymd = manilaDay(v.starts_at);
    return { day: dateText(ymd)!, status: VISIT_STATUS[v.status]?.label ?? v.status, href: `/c/${clinic.slug}/?date=${ymd}&booking=${v.id}` };
  }),
  loas: ext.loas.filter((a) => a.status === 'requested').map((a) => ({ id: a.id, payor: a.payor, items: a.items.map((it) => `${it.name}${it.fdi ? ` ${it.fdi}` : ''}`) })),
  behind: behindPlans.map((x) => ({ title: x.title, missed: x.missed, href: `${links.finances}${x.invoiceId}/` })),
  staleHealth: staleHealth && !visitPlan?.lines.some((l) => l.words.startsWith('Health history')) ? day(new Date(askedV!.at)) : null,
  clearances: ext.letters.filter((l) => l.kind === 'clearance' && !l.answer).map((l) => ({ id: l.id, issuedOn: l.issuedOn, to: l.toName })),
  canEdit,
});
// Last visit: the newest visit that happened before today (done, or work recorded on a day with nothing booked).
const lastSeen = data.fullVisits.find((v) => v.day < today && (v.status === 'completed' || v.id === null)) ?? null;
const lastCard = lastSeen ? {
  key: lastSeen.key,
  day: lastSeen.dateOnly || !lastSeen.id ? dateText(lastSeen.day)! : when(lastSeen.at),
  lines: [
    [lastSeen.reason ?? (lastSeen.id ? 'Visit' : 'At the clinic'), lastSeen.dentist].filter(Boolean).join(' · '),
    lastSeen.procs.length ? `Done: ${lastSeen.procs.map((d) => `${d.name}${d.fdi ? ` ${d.fdi}${d.surface ? ` ${d.surface}` : ''}` : ''}`).join(', ')}` : '',
    (() => { const b = lastSeen.vitals.find((x) => x.sys && x.dia); return b ? `BP ${b.sys}/${b.dia}` : ''; })(),
    (() => { const n = lastSeen.notes.find((x) => x.diagnosis); return n ? `Diagnosis: ${n.diagnosis}` : ''; })(),
  ].filter(Boolean),
} : null;
// A cancelled or missed visit that holds nothing is not on the ledger: the fold under it lists it, each day a way to its panel.
const cancelledFold = data.fullVisits.filter((v) => v.id && (v.status === 'cancelled' || v.status === 'no_show') && !data.ledger.openKeys.has(v.key));
// The counts on the tabs: Today counts what is still to do at this visit; Chart & plan what is still open on the plan.
const tabCounts = {
  ...(visitPlan?.lines.length ? { overview: { n: visitPlan.lines.length, words: visitPlan.lines.length === 1 ? 'one thing still to do at this visit' : `${visitPlan.lines.length} things still to do at this visit` } } : {}),
  ...(planOpen.length ? { chart: { n: planOpen.length, words: planOpen.length === 1 ? 'one open on the plan' : `${planOpen.length} open on the plan` } } : {}),
};

// --- the cards and their panels ---------------------------------------------------
// Each card with a panel is drawn twice, with the same props: its body in its tab (part="body") and its panels outside
// the tabs (part="panels"), so a panel opens over whichever tab is in view. What a save says is the saved line, drawn
// once, where the address lands (savedIn, above): at the top of the tab showing first, or in the `saved` slot of the
// card a card's own button came back to, or at the top of the chart's offer.
const savedLineProps = { saved, tab: current, c: clin, letters: ext.letters, vitals: ext.vitals, firstName: patient.first_name, rxBase: `${here}rx/`, letterBase: `${here}letters/`, financesBase: links.finances, ptrFix };
const vitalsProps = { vitals: ext.vitals, canEdit, action: recHere, problem: recordProblem, firstName: patient.first_name, visitId: thisVisit?.id ?? null, openNow: openNow === 'vitals' };
const recallProps = { recall: clin.recall, canEdit, action: recHere, problem: recordProblem, today, firstName: patient.first_name, bookHref, texts: me.recall_texts === true };
const treatmentProps = { c: clin, loas: ext.loas, canEdit, action: recHere, meId: session.staffId, problem: recordProblem, today, firstName: patient.first_name, visitId: thisVisit?.id ?? null };
const filesProps = { c: clin, canEdit, action: recHere, problem: recordProblem, today, firstName: patient.first_name, fileBase: `${here}files/`, visitId: thisVisit?.id ?? null, openNow: openNow === 'file' };
const loasProps = { loas: ext.loas, plan: clin.plan, payors: ext.hmoPayors, hmoName: patient.hmo_name, memberNo: patient.hmo_member_no, canEdit, action: recHere, problem: recordProblem, today, firstName: patient.first_name, settingsHref: `/c/${clinic.slug}/settings/` };
const payPlansProps = { plans: ext.plans, canEdit, canBill: money, action: recHere, problem: recordProblem, today, firstName: patient.first_name, financesBase: links.finances };
const rxProps = { c: clin, canEdit, action: recHere, meId: session.staffId, problem: recordProblem, firstName: patient.first_name, printBase: `${here}rx/`, allergies, typedRows: rxTyped, visitId: thisVisit?.id ?? null, openNow: openNow === 'rx', today, ptrFix };
const lettersProps = { letters: ext.letters, clinicians: clin.clinicians, canEdit, action: recHere, meId: session.staffId, problem: recordProblem, today, firstName: patient.first_name, printBase: `${here}letters/`, lastVisit: lastVisit ? manilaDay(lastVisit.starts_at) : null, conditions, ptrFix };
// Each tab's hue (on its cards' top edge and icons, TABS), and the cards inside a tab that keep their own (CARD_HUE).
const TAB_HUE = Object.fromEntries(TABS.map((t) => [t.id, `hue-${t.hue}`])) as Record<string, string>;
const cardHue = (name: string) => `contents hue-${CARD_HUE[name]}`;
const consentFormsProps = { docs: data.consentDocs, slug: clinic.slug, patientId: patient.id, firstName: patient.first_name, canEdit, mayExplain: data.mayExplainIds,
  mayCapacity: canEdit && data.treatsHere && !minor && !!patient.birth, capacity: data.capacity, canPrepare: data.canPrepare, offered: data.offeredCodes };
---

<ClinicLayout groupId={clinic.group_id} clinic={{ slug: clinic.slug, name: clinic.name, area: me.area }} title={titleName} section="patient" staff={{ name: session.name, role: session.role }} branches={branches} finance={clinic.can_view_finance} layout="panes" heading>
  {/* The patient's name is the page's title, in the top bar (the layout's heading), as on a
      person's page and a statement: this card is who they are beside it — the avatar, the few
      facts, the two actions, the safety line and the notes — with no second name. */}
  <Pane as="div" label={`${shortName}, patient record`}>
    <a href={`/c/${clinic.slug}/patients/`} class="rec-back" data-pts-back><Icon name="chevron-left" />Back to patients</a>
    <script>
      // Back to the list as it was left: the same search, filter and sort (./_list/back.ts).
      import { restoreBackLinks } from './_list/back';
      restoreBackLinks();
    </script>
    <div class="rec-head-row">
      <div class="rec-who">
        <Avatar name={shortName} size="lg" />
        <p class="rec-facts min-w-0"><span class="rec-facts-in">
          <span><span class="pt-ref" title="Chart no."><span class="sr-only">Chart no. </span>{patient.chart_no}</span></span>
          {facts.map((f) => <span>{f}</span>)}
          {money && (balance > 0n ? <span><a href={statementsHref} class="rec-owes">Owes <b>{pesos(balance)}</b></a></span>
            : balance < 0n ? <span><a href={statementsHref} class="rec-owes">In credit <b>{pesos(-balance)}</b></a></span>
            : <span>Nothing owed</span>)}
        </span></p>
      </div>
      <div class="rec-actions">
        {/* Both quiet, and one tap from any tab: a screen's one teal button is its tab's own. */}
        {canEdit && <button type="button" class="ws-btn ws-btn-quiet" data-ws-open="details"><Icon name="user" />Edit details</button>}
        <a href={bookHref} class="ws-btn ws-btn-quiet"><Icon name="calendar" />New booking</a>
      </div>
    </div>

    <SafetyLine variant="head" items={safety} class="mt-4" />
    {latest?.note && <Callout tone="alert" role="none" class="mt-3" title="Note for the dentist" text={latest.note} />}
    {deskNote && <p class="rec-desk-note mt-3"><Icon name="note" size={16} /><span class="min-w-0"><span class="rec-desk-note-k">Desk note</span> {deskNote}</span></p>}
    {stale && <Callout data-rec-said tone="alert" class="mt-4" text={CSRF_MESSAGE} />}
    {/* A refused post whose form is not on this page for this person (no records.edit, or a payment plan without finance.bill): its sentence here. */}
    {recordProblem && (!canEdit || (recordProblem.intent === 'payplan-add' && !money)) && <Callout data-rec-said tone="alert" class="mt-4" text={`${recordProblem.text} Nothing was saved.`} />}
    {saved === 'new' && <Callout data-rec-said tone="success" class="mt-4" text={`Added. ${shortName} is on file as ${patient.chart_no}; everything from the form is below.`} />}
    {saved === 'details' && <Callout data-rec-said tone="success" class="mt-4" text="Details saved." />}
    {saved === 'birth' && <Callout data-rec-said tone="success" class="mt-4" text="Details saved. The birth date the record had is kept in the health history." />}
    {saved === 'capacity' && <Callout data-rec-said tone="success" class="mt-4" text="Recorded. For 30 days a representative may sign consent forms for them, on a clinic device." />}
    {saved === 'consent-removed' && <Callout data-rec-said tone="success" class="mt-4" text="The form was removed." />}
    {q.get('capacity') === 'refused' && <Callout data-rec-said tone="alert" class="mt-4" text="Nothing was recorded. Only a treating dentist here with a PRC licence records this, for an adult patient with a birth date on file, and with a reason of at most 300 characters." />}
    {saved === 'intake' && (() => {
      // Just added from an intake (039): what its forms came to, each part a way to the Consent section.
      const n = (st: string[]) => data.intakeDocs.filter((d) => st.includes(d.state)).length;
      const signedN = n(['agreed']), toSign = n(['to_sign']), toConfirm = n(['to_confirm']), refused = data.intakeDocs.filter((d) => d.state === 'refused' && d.code !== 'photos').length;
      const parts = [signedN && `${signedN === 1 ? 'one consent form' : `${signedN} consent forms`} signed`, toSign && `${toSign} to sign at the chair`, toConfirm && `${toConfirm} to confirm`, refused && `${refused} not agreed`].filter(Boolean) as string[];
      return <Callout data-rec-said tone="success" class="mt-4" title={`${shortName} is added.`}>{parts.length > 0 && <p>{capitalise(parts.join(' · '))}. <a href="#consent" class="font-semibold underline underline-offset-2" data-rec-go="consent">See Consent</a></p>}</Callout>;
    })()}
    {saved === 'form' && data.added && addedConsents && (
      <Callout data-rec-said tone="success" class="mt-4" title={data.added.addedAs === 'new' ? `Added from the patient forms (${data.added.ref}).` : `Added the patient forms (${data.added.ref}) to ${patient.first_name}’s record.`}>
        <p>
          {data.added.addedAs === 'new' ? `${shortName} is on file as ${patient.chart_no}, with the health history from the form` : 'Empty details were filled in, and the record has the health history from the form'}{addedConsents.from.length ? ` and ${andList(addedConsents.from)}` : ''}.
          {addedConsents.onFile.length > 0 && ` ${capitalise(andList(addedConsents.onFile))} ${addedConsents.onFile.length === 1 ? 'was' : 'were'} already on file.`}
          {keptFromRecord.length > 0 && ` Kept from the record as well: ${keptFromRecord.join(', ')}.`}
          {' '}<a href={`${formsBase}${data.added.id}/`} class="font-semibold underline underline-offset-2">See the form’s answers</a>
        </p>
      </Callout>
    )}
    {saved === 'form' && addedConsents && addedConsents.none.length > 0 && (
      <Callout data-rec-said tone="warn" role="alert" class="mt-3" title="No consent was recorded from this form.">
        <p>The birth date on the record makes {patient.first_name} under 18 on the day the form was signed, and {patient.first_name} signed it themself. A parent or guardian needs to agree: record it in <a href="#consent" class="font-semibold underline underline-offset-2" data-rec-go="consent">Consent</a>.</p>
      </Callout>
    )}
    {usedLabel && !formUseProblem && <Callout data-rec-said tone="success" class="mt-4" text={`The ${usedLabel} on the record is now the one from the form.`} />}
    {formUseProblem && <Callout data-rec-said tone="alert" class="mt-4" text={formUseProblem} />}
    {data.added && data.addedDiffers.length > 0 && (
      <Callout data-rec-said tone="warn" role={saved === 'form' ? 'alert' : undefined} class="mt-3" title="The form says something the record does not. The record kept what it had:">
        <ul class="fm-diff">
          {data.addedDiffers.map((d) => (
            <li class="fm-diff-use">
              <span class="min-w-0"><span class="fm-diff-k">{d.label}</span>On file: {d.onFile || 'nothing'}<br />On the form: {d.onForm}</span>
              {canEdit && TAKEABLE.has(d.field) && (
                <form method="post" action={`${here}?form=${data.added!.id}#overview`}>
                  <Csrf />
                  <input type="hidden" name="intent" value="form-use" />
                  <input type="hidden" name="form" value={data.added!.id} />
                  <input type="hidden" name="field" value={d.field} />
                  <button type="submit" class="ws-btn ws-btn-quiet ws-btn-sm">Use {d.onForm.length > 24 ? 'the form’s' : d.onForm}</button>
                </form>
              )}
            </li>
          ))}
        </ul>
        {canEdit && <p class="mt-2">{data.addedDiffers.some((d) => d.field === 'phone' || d.field === 'email') ? 'Check a mobile or email with the patient before you use it: visits and reminders go by mobile. ' : ''}A birth date changes in Edit details.</p>}
      </Callout>
    )}
  </Pane>

  {/* The record's body: the tab row, sticky at the top under the workspace's top bar (./_record/RecordNav.astro), the four
      tabs, and every side panel, outside the tabs so each opens over the tab in view. */}
  <div class="rec-body" data-rec-body data-rec-opened={openNow ? '' : undefined} data-rec-posted={Astro.request.method === 'POST' ? '' : undefined}>
  <RecordNav current={current} name={shortName} firstName={patient.first_name} counts={tabCounts} canEdit={canEdit} money={money} chargeHref={chargeHref}
    safety={safety} note={latest?.note ?? null} line={safetyPhone} />

  <!-- Today -->
  <div id="rec-overview" role="tabpanel" aria-labelledby="rec-rec-overview-tab" hidden={current !== 'overview'} class={`rec-tab min-w-0 grid gap-4 max-md:gap-3 content-start ${TAB_HUE['overview']}`} data-rec-panel="overview">
    <span id="overview" class="rec-anchor" aria-hidden="true"></span>
    {current === 'overview' && !savedIn && <SavedLine {...savedLineProps} />}
    <Today coming={coming} plan={planWords} needs={needs} last={lastCard}>
      {/* Today's visit: what is still to do at it and what is done (036). */}
      {thisVisit && visitPlan && (
        <VisitStrip slot="visit" visit={thisVisit} plan={visitPlan} canEdit={canEdit} firstName={patient.first_name} action={here} saved={saved} problem={stripProblem} wrote={wrote} />
      )}
      <RecallCard slot="recall" part="body" {...recallProps}>{savedIn === 'recall' && <SavedLine slot="saved" class="mb-3" {...savedLineProps} />}</RecallCard>
      {!thisVisit && wrote && <p slot="wrote" class="vs-wrote"><Icon name="note" size={16} /><span class="min-w-0"><span class="vs-wrote-k">The patient wrote:</span> {wrote.words} <a href={wrote.href} class="vs-wrote-a">All answers</a></span></p>}
    </Today>
  </div>

  <!-- Patient info -->
  <div id="rec-patient" role="tabpanel" aria-labelledby="rec-rec-patient-tab" hidden={current !== 'patient'} class={`rec-tab min-w-0 grid gap-4 max-md:gap-3 content-start ${TAB_HUE['patient']}`} data-rec-panel="patient">
    <span id="patient" class="rec-anchor" aria-hidden="true"></span>
    {current === 'patient' && !savedIn && <SavedLine {...savedLineProps} />}
    <Pane title="Details" icon="user" id="details-card">
      <dl class="rf-grid">
        {present.map(([k, v]) => <div class:list={['rf', (k === 'Address' || k === 'Emergency contact' || k === 'HMO' || k === 'From the old records') && 'rf-wide']}><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
      {missing.length > 0 && <p class="mt-3 text-[14.5px] text-ink-2"><span class="font-semibold text-ink">Not on file:</span> {missing.join(', ')}.{canEdit ? ' Edit details adds them.' : ''}</p>}
      <p class="mt-4 flex items-start gap-2 border-t border-[var(--ws-hair)] pt-3 text-[13px] leading-relaxed text-ink-2">
        <Icon name="info" size={16} class="mt-0.5 shrink-0" />
        <span>Every look at this record, and every change to it, is logged under the person’s name.</span>
      </p>
    </Pane>
    <Vitals part="body" {...vitalsProps}>{savedIn === 'vitals' && <SavedLine slot="saved" class="mb-4" {...savedLineProps} />}</Vitals>
    <Pane as="section" label="Health" id="health">
      <Head icon="heart" title="Health" />
      <p class="-mt-2 text-[14px] text-muted">
        {!latest ? 'Nothing recorded yet. Ask the patient before treatment.'
          : answered(latest) ? `Updated ${byLine(askedV ?? latest)}.`
          : `No health answers yet. Ask the patient before treatment. Last saved ${byLine(latest)}.`}
      </p>

      {saved === 'health' && <Callout tone="success" class="mt-4" text="Saved." />}
      {saved === 'nothing' && <Callout tone="info" class="mt-4" text="Nothing was saved: nothing is ticked or typed yet." />}
      {conflict && (
        <Callout tone="warn" role="alert" class="mt-4">
          <p class="font-semibold">
            {conflict.latest ? `${conflict.latest.by ?? 'Someone'} saved this record ${when(new Date(conflict.latest.at))}, after you opened it.`
              : 'This record changed after you opened it.'} Nothing of yours was saved yet.
          </p>
          {conflict.latest && <p class="mt-1.5 text-ink-2">On file now: {stateLine(conflict.latest)}.</p>}
          <p class="mt-1.5 text-ink-2">Your answers are still below. Check them against what is on file, then press Save again.</p>
        </Callout>
      )}
      {healthProblems.length > 0 && <Callout tone="alert" class="mt-4" title={`Nothing was saved. ${healthProblems.length === 1 ? 'One thing' : 'A few things'} to fix:`} items={healthProblems} />}

      {canEdit ? (
        <form method="post" action={`${here}#health`} class="mt-5" data-health-form data-health-unsaved={posted ? '' : undefined}>
          <Csrf />
          <input type="hidden" name="intent" value="health" />
          <input type="hidden" name="base" value={base} />
          {thisVisit && <input type="hidden" name="visit" value={thisVisit.id} />}

          <HealthLists chips={healthChips} none={healthNone} />

          <label class="field border-t border-[var(--ws-hair)] pt-5">
            <span class="meta">Note for the dentist</span>
            <textarea name="note" rows="2" maxlength={NOTE_MAX} placeholder="Anything to know before starting. For example: faints at injections.">{shown.note ?? ''}</textarea>
          </label>

          <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2">
            <button type="submit" class={`ws-btn ${consentAsked ? 'ws-btn-quiet' : 'ws-btn-primary'} min-w-[9rem]`} data-health-save><Icon name="check" />Save</button>
            <span class="ws-pill ws-tint-amber" data-health-dirty hidden={!posted}>Not saved yet</span>
            <span class="text-[13.5px] text-muted">Saved as a new version under your name. Earlier versions stay.</span>
          </div>
        </form>
      ) : (
        <dl class="pt-facts mt-5">
          <dt>Birth date</dt><dd>{patient.birth ? `${dateText(patient.birth)}${age !== null ? ` · ${ageText(age)}` : ''}` : 'Not on file'}</dd>
          {LISTS.map((l) => <><dt>{l.label}</dt><dd>{listLine(latest?.[l.key] ?? null, l.none)}</dd></>)}
          <dt>Note</dt><dd>{latest?.note ?? '—'}</dd>
        </dl>
      )}

      {health.total > 0 && (
        <details class="pt-more mt-5 border-t border-[var(--ws-hair)] pt-2">
          <summary>Earlier versions ({health.total}) <Icon name="chevron" size={16} class="pt-chev" /></summary>
          <ol class="pt-list mt-1">
            {health.versions.map((v, i) => {
              const prev = health.versions[i + 1] ?? health.older;
              const what = versionChanges(prev, v);
              return (
                <li class="!block">
                  <p class="text-[14.5px] font-semibold">{byLine(v)}</p>
                  <p class="mt-0.5 text-[14.5px] text-ink-2">{!prev ? [...what, 'First record.'].join(' · ') : what.length ? what.join(' · ') : 'Checked, no change.'}</p>
                  <p class="mt-0.5 text-[13.5px] text-muted">{stateLine(v)}</p>
                </li>
              );
            })}
          </ol>
          {health.total > health.versions.length && <p class="mt-2 text-[13.5px] text-muted">The {health.versions.length} newest are shown.</p>}
        </details>
      )}
    </Pane>
    {/* Consent: the privacy notice, the consent forms, signed at visits, the patient forms. #consent is DeskConsent's own
        section (the privacy notice's state and its form, where consent is recorded), as before: one element per id. */}
    <div class={`min-w-0 grid gap-4 max-md:gap-3 content-start hue-${CARD_HUE.consent}`}>
      <Pane as="section" label="Privacy consent">
        <Head icon="shield" title="Privacy consent" />
        <DeskConsent notice={data.notice} consents={data.consents} canRecord={canEdit} minor={minor} birthKnown={!!patient.birth} dpo={data.dpo} action={`${here}#consent`}
          problem={consentProblem} givenBy={givenBy} agreedAs={agreedAs} recorded={saved === 'consent' ? 'saved' : saved === 'consent-already' ? 'already' : null}
          paperForms={data.paperForms} paper={{ ...paperState, recorded: saved === 'paper' ? 'saved' : null }} />
      </Pane>
      <ConsentForms part="body" {...consentFormsProps} />
      <Pane as="section" label="Signed at visits" id="visit-consents">
        <Head icon="pen" title="Signed at visits" meta={data.signed.length === 1 ? 'One consent' : `${data.signed.length} consents`} />
        <p class="-mt-2 mb-3 text-[14px] text-ink-2">The consent to examination and treatment, signed on the clinic’s tablet for a visit: what the dentist explained, and the signature. Open a visit from its date on the Treatment record, or in Visits, to have one signed.</p>
        {data.signed.length === 0 ? <p class="text-[14.5px] text-ink-2">None signed on the tablet yet.</p> : (
          <ul class="rs-list">
            {data.signed.map((k) => {
              const v = data.fullVisits.find((x) => x.id === k.visitId);
              return (
                <li class="rs-item vx-signed-row">
                  <Signature strokes={k.strokes} name={k.signedBy} />
                  <div class="min-w-0 grid gap-1.5">
                    <p class="rs-what">{k.signedBy}{k.signedAs === 'guardian' ? `, ${(k.relation ?? 'parent or guardian').toLocaleLowerCase('en')}` : ''}</p>
                    <p class="rp-row"><span class="rp">Signed {when(k.at)}</span>{k.dentist && <Who name={k.dentist} />}</p>
                    <p class="text-[14.5px] text-ink">{k.treatment.split('\n').join(' · ')}</p>
                    {v && <button type="button" class="vx-link" data-ws-open={`rec-visit-${v.key}`} aria-haspopup="dialog">See the visit, {dateText(v.day)}</button>}
                  </div>
                </li>
              );
            })}
          </ul>
        )}
      </Pane>
      {data.forms.length > 0 && (
        <Pane as="section" label="Patient forms" id="patient-forms" class="mt-4 max-md:mt-3">
          <Head icon="form" title="Patient forms" meta={`${data.forms.length === 1 ? 'One form' : `${data.forms.length} forms`} from the QR code`} />
          <p class="-mt-2 mb-3 text-[14px] text-ink-2">Filled in on the patient’s own phone: their details, health and dental history, the consent to examination and treatment, and the privacy notice.</p>
          <ul class="pt-list fm-rec-list">
            {data.forms.map((f) => (
              <li>
                <div class="min-w-0 text-[14.5px]">
                  <p><span class="font-semibold">Sent {when(f.submittedAt)}</span> <span class="pt-ref ml-1">{f.ref}</span></p>
                  <p class="text-ink-2">Signed by {signedText(f.signedByName, f.signedAs)}. Added {f.addedAs === 'new' ? 'as a new patient' : 'to this record'}{f.addedByName ? ` by ${f.addedByName}` : ''}, {day(f.addedAt)}.</p>
                  <p class="fm-rec-consents">
                    {(['treatment', 'privacy'] as const).map((k) => {
                      const what = k === 'treatment' ? 'Examination and treatment' : 'Privacy notice';
                      const st = f.consentState[k];
                      return st === 'form' ? <Chip tone="accent" icon="check">{what}</Chip>
                        : st === 'on-file' ? <Chip tone="neutral" label={`${what}: already on file`} />
                        : <Chip tone="warn" icon="alert">{`${what}: not recorded (a guardian must agree)`}</Chip>;
                    })}
                  </p>
                </div>
                <span class="flex flex-wrap gap-2">
                  <a href={`${formsBase}${f.id}/`} class="ws-btn ws-btn-quiet ws-btn-sm">See answers</a>
                  <a href={`${formsBase}${f.id}/print/`} class="ws-btn ws-btn-quiet ws-btn-sm"><Glyph name="print" />Print</a>
                </span>
              </li>
            ))}
          </ul>
        </Pane>
      )}
    </div>
  </div>

  <!-- Chart & plan -->
  <div id="rec-chart" role="tabpanel" aria-labelledby="rec-rec-chart-tab" hidden={current !== 'chart'} class={`rec-tab min-w-0 grid gap-4 max-md:gap-3 content-start ${TAB_HUE['chart']}`} data-rec-panel="chart">
    <span id="chart" class="rec-anchor" aria-hidden="true"></span>
    {current === 'chart' && !savedIn && <SavedLine {...savedLineProps} />}
    {showOffer && <ChartOffer state={offerState} skip={chartSkip} problem={offerProblem} action={recHere} sid={chartSid} visitId={thisVisit?.id ?? null} back="chart" leaveHref={leaveOffer('chart')} inChart>{savedIn === 'chart-offer' && <SavedLine {...savedLineProps} />}</ChartOffer>}
    <Pane as="section" label="Chart" class="pt-chart-pane">
      <Head icon="tooth" title="Chart" />
      <p class="-mt-2 mb-4 text-[14px] text-muted">Every change is saved as you make it, under your name.</p>
      {/* The odontogram (src/components/Odontogram.astro, its offline logic untouched; the palette's record actions
          for people who may edit records, the plan and done marks for everyone),
          drawn soft by patients.css ("The chart") and laid out by the width of this card: the
          teeth fit the card's width, the chart note goes under the arches when there is no room
          beside them, and where a whole arch still cannot fit (a phone) the line below says so. */}
      <p class="pt-chart-scroll" data-pt-chart-scroll hidden>Scroll sideways to see every tooth <Icon name="arrow-right" size={16} /></p>
      <div class="pt-chart" data-pt-chart>
        <Odontogram marks={marks} notation={me.notation as Notation} saveUrl="/api/chart" patientId={patient.id} clinic={clinic.slug} csrf={csrf} actions={canEdit} work={chartWork} />
      </div>
      {babyWork && <p class="mt-3 text-[13.5px] text-ink-2">Work on baby teeth is in Treatment; this chart shows permanent teeth only.</p>}

      {/* The findings as the server had them, newest concern first. When there are none the chart
          note above already says so, once. */}
      {findings.length > 0 && (
        <>
          <h3 class="mt-8 text-[16px] font-semibold">Findings</h3>
          <p class="mt-0.5 text-[13.5px] text-muted">As they stood when this page opened.</p>
          <ul class="mt-3 grid gap-2.5 sm:grid-cols-2 lg:grid-cols-3">
            {findings.map((f) => (
              <li class="pt-inset flex items-center gap-3 px-4 py-3">
                <span class="tooth pt-find-swatch h-8! w-6! shrink-0" data-state={f.condition} aria-hidden="true"></span>
                <div>
                  <p class="text-[15px] font-semibold tabular-nums">Tooth {f.fdi}{f.codes && <span class="text-accent"> {f.codes}</span>}</p>
                  <p class="text-[13.5px] text-ink-2">{CONDITION_LABEL[f.condition]}</p>
                </div>
              </li>
            ))}
          </ul>
        </>
      )}
      {/* The chart's history (tooth_state, grouped by the minute and the person), newest first. */}
      {data.chartChanges.length > 0 && (
        <details class="pt-more mt-5 border-t border-[var(--ws-hair)] pt-2">
          <summary>Changes to the chart ({data.chartChanges.length}) <Icon name="chevron" size={16} class="pt-chev" /></summary>
          <ol class="pt-list mt-1">
            {data.chartChanges.map((ch) => (
              <li class="!block">
                <p class="text-[14.5px] font-semibold">{when(new Date(ch.at))}{ch.by ? ` · ${ch.by}` : ''}</p>
                <p class="mt-0.5 text-[14px] text-ink-2">{ch.n === 1 ? 'One change' : `${ch.n} changes`} · {ch.teeth.includes(',') ? `teeth ${ch.teeth}` : `tooth ${ch.teeth}`}</p>
              </li>
            ))}
          </ol>
        </details>
      )}
    </Pane>
    <Treatment part="body" {...treatmentProps} savedAt={savedIn}>{savedIn?.startsWith('treatment') && <SavedLine slot="saved" class="mb-4" {...savedLineProps} />}</Treatment>
    <Files part="body" {...filesProps}>{savedIn === 'files' && <SavedLine slot="saved" class="mb-4" {...savedLineProps} />}</Files>
    <Loas part="body" {...loasProps}>{savedIn === 'loas' && <SavedLine slot="saved" class="mb-4" {...savedLineProps} />}</Loas>
    <div class={cardHue('payplans')}><PayPlans part="body" {...payPlansProps}>{savedIn === 'payplans' && <SavedLine slot="saved" class="mb-4" {...savedLineProps} />}</PayPlans></div>
  </div>

  <!-- Treatment record -->
  <div id="rec-treatment-record" role="tabpanel" aria-labelledby="rec-rec-treatment-record-tab" hidden={current !== 'treatment-record'} class={`rec-tab min-w-0 grid gap-4 max-md:gap-3 content-start ${TAB_HUE['treatment-record']}`} data-rec-panel="treatment-record">
    <span id="treatment-record" class="rec-anchor" aria-hidden="true"></span>
    {current === 'treatment-record' && !savedIn && <SavedLine {...savedLineProps} />}
    <TreatmentRecord ledger={data.ledger} money={money} today={today} printHref={`${here}treatment-record/`} name={shortName} />
    {/* Cancelled and missed visits that hold nothing are not treatment, so the ledger skips them: they are listed here,
        folded, each day a way to the visit's panel. */}
    {cancelledFold.length > 0 && (
      <Pane as="section" label="Cancelled and missed visits" id="visits-cancelled">
        <details class="pt-more">
          <summary>Cancelled and missed ({cancelledFold.length}) <Icon name="chevron" size={16} class="pt-chev" /></summary>
          <ul class="td-list mt-2">
            {cancelledFold.map((v) => (
              <li class="td-visit-row">
                <button type="button" class="td-when" data-ws-open={`rec-visit-${v.key}`} aria-haspopup="dialog">{v.dateOnly ? dateText(v.day) : when(v.at)}</button>
                <span class="td-sub">{[v.reason ?? 'Visit', v.dentist, VISIT_STATUS[v.status ?? '']?.label].filter(Boolean).join(' · ')}</span>
              </li>
            ))}
          </ul>
        </details>
      </Pane>
    )}
    <div class={cardHue('notes')}><Notes c={clin} canEdit={canEdit}>{savedIn === 'notes' && <SavedLine slot="saved" class="mb-4" {...savedLineProps} />}</Notes></div>
    <Prescriptions part="body" {...rxProps}>{savedIn === 'rx' && <SavedLine slot="saved" class="mb-4" {...savedLineProps} />}</Prescriptions>
    <Letters part="body" {...lettersProps}>{savedIn === 'letters' && <SavedLine slot="saved" class="mb-4" {...savedLineProps} />}</Letters>
    {money && (
      <div class={cardHue('money')}>
      <Pane title="Money" icon="money" id="money" pad="none">
        <Fragment slot="actions">
          <a href={`${links.finances}?patient=${patient.id}&view=all`} class="ws-btn ws-btn-quiet ws-btn-sm">In Finances <Icon name="arrow-right" size={16} /></a>
          <a href={chargeHref} class="ws-btn ws-btn-quiet ws-btn-sm"><Icon name="plus" />New charge</a>
        </Fragment>
        <p class="border-b border-[var(--ws-hair)] px-6 py-4 text-[15px] text-ink-2 max-md:px-4">
          {balance > 0n ? <>Owes <span class="font-semibold text-caries tabular-nums">{pesos(balance)}</span>{openCount ? ` on ${openCount} ${openCount === 1 ? 'statement' : 'statements'}` : ''}.</>
            : balance < 0n ? <>In credit <span class="font-semibold tabular-nums">{pesos(-balance)}</span>.</>
            : <>Nothing owed.</>}
          {' '}Paid <span class="font-semibold tabular-nums">{pesos(paidAll)}</span> in all.
          <span class="mt-0.5 block text-[13px] text-muted">Statements of account, not BIR receipts.</span>
        </p>
        {stmts.length === 0 ? (
          <div class="px-6 py-3 max-md:px-4"><Empty icon="money" text="No statements for this patient yet." action={{ label: 'New charge', href: chargeHref }} /></div>
        ) : (
          <table class="ws-table">
            <caption class="sr-only">Statements of {shortName}, newest first</caption>
            <thead>
              <tr>
                <th scope="col" class="meta">Statement</th>
                <th scope="col" class="meta">For</th>
                <th scope="col" class="meta text-right">Total</th>
                <th scope="col" class="meta text-right">Paid</th>
                <th scope="col" class="meta text-right">Left</th>
                <th scope="col" class="meta">Status</th>
              </tr>
            </thead>
            <tbody>
              {stmts.map((s) => {
                const st = BILL_STATUS[s.status] ?? BILL_STATUS.issued;
                return (
                  <tr>
                    <td class="whitespace-nowrap"><a href={`${links.finances}${s.id}/`} class="inline-flex min-h-11 items-center font-mono text-[14px] font-medium text-accent underline-offset-4 hover:underline">{statementNo(s.series_prefix, s.number)}</a><span class="block text-[13px] text-muted tabular-nums">{dateText(manilaDay(s.issued_at))}{s.imported_at ? ' · brought in' : ''}</span></td>
                    <td class="text-[14.5px]"><span class="meta ws-cell-label">For</span>{s.first_line ?? '—'}{s.n_lines > 1 && <span class="text-muted"> and {s.n_lines - 1} more</span>}{s.payor_name && <span class="block text-[13px] text-muted">{s.payor_name} part {pesos(fromDb(s.payor_share))}</span>}</td>
                    <td class="text-right text-[15px] tabular-nums max-lg:text-left"><span class="meta ws-cell-label">Total</span>{pesos(s.total)}</td>
                    <td class="text-right text-[15px] tabular-nums max-lg:text-left"><span class="meta ws-cell-label">Paid</span>{pesos(s.paid)}</td>
                    <td class="text-right text-[15px] font-semibold tabular-nums max-lg:text-left"><span class="meta ws-cell-label">Left</span>{pesos(s.left)}</td>
                    <td><span class="meta ws-cell-label">Status</span><span class:list={['ws-chip', STMT_TINT[s.status] ?? 'ws-tint-slate']}>{st.label}</span></td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        )}
      </Pane>
      </div>
    )}
    <Pane title="Texts" icon="message" id="texts" meta={data.texts.length === 50 ? 'The newest 50' : `${data.texts.length} about this patient`} pad="none">
      <a slot="actions" href={links.messages} class="ws-btn ws-btn-quiet ws-btn-sm">All messages <Icon name="arrow-right" size={16} /></a>
      {data.texts.length === 0 ? (
        <div class="px-6 py-3 max-md:px-4"><Empty icon="message" text="No texts to or from this patient yet. Booking confirmations and reminders show here." /></div>
      ) : (
        <table class="ws-table">
          <caption class="sr-only">Texts to and from {shortName}, newest first</caption>
          <thead><tr><th scope="col" class="meta">When</th><th scope="col" class="meta">Status</th><th scope="col" class="meta">Text</th></tr></thead>
          <tbody>
            {data.texts.map((m) => {
              const st = textStatus(m);
              return (
                <tr>
                  <td class="text-[14.5px] whitespace-nowrap tabular-nums">{when(new Date(m.created_at))}<span class="block text-[13px] text-muted">{m.direction === 'in' ? 'Reply' : TEXT_KIND[m.kind ?? ''] ?? 'Text'}</span></td>
                  <td><span class="meta ws-cell-label">Status</span><Chip tone={st.tone} label={st.label} dot={st.tone === 'alert'} /></td>
                  <td class="max-w-[40rem] text-[14.5px] leading-relaxed break-words whitespace-pre-wrap"><span class="meta ws-cell-label">Text</span>{m.body ?? <span class="text-muted">A sign-in code. It is not shown here.</span>}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      )}
    </Pane>
  </div>

  {/* The side panels, outside the tabs: every visit's (the Treatment record's dates, Visits, ?visit=), Add to plan,
      Record a treatment and the note (the chart's palette opens them on a tooth), and each card's own. */}
  <VisitPanels visits={data.fullVisits} slug={clinic.slug} patientId={patient.id} canEdit={canEdit} money={money} open={thisVisit && openVisit === thisVisit.id ? null : openVisit} today={today} firstName={patient.first_name} />
  {canEdit && <TreatmentPanels c={clin} loas={ext.loas} canEdit={canEdit} action={recHere} meId={session.staffId} problem={recordProblem} today={today} firstName={patient.first_name} visitId={thisVisit?.id ?? null} openNow={openNow === 'done'} chartSid={chartSid} />}
  {canEdit && <NotePanel c={clin} canEdit={canEdit} action={recHere} meId={session.staffId} problem={recordProblem} today={today} firstName={patient.first_name} visitId={thisVisit?.id ?? null} openNow={openNow === 'note'} defaultTeeth={noteTeeth} />}
  <Vitals part="panels" {...vitalsProps} />
  <RecallCard part="panels" {...recallProps} />
  <Treatment part="panels" {...treatmentProps} />
  <Files part="panels" {...filesProps} />
  <Loas part="panels" {...loasProps} />
  <PayPlans part="panels" {...payPlansProps} />
  <Prescriptions part="panels" {...rxProps} />
  <Letters part="panels" {...lettersProps} />
  <ConsentForms part="panels" {...consentFormsProps} />
  </div>

  {canEdit && (
    <SidePanel id="details" title="Edit details" meta={shortName} wide open={detailsProblems.length > 0 || openNow === 'details'}>
      {detailsProblems.length > 0 && <Callout tone="alert" class="mb-5" title="Nothing was saved." items={detailsProblems} />}
      {/* From the Dashboard (dash), no #overview on the action: a redirect keeps the post's fragment, and the Dashboard needs none. */}
      <form method="post" action={(detailsDash ?? dashVisit) ? here : `${here}#overview`} class="grid gap-4">
        <Csrf />
        <input type="hidden" name="intent" value="details" />
        {(detailsDash ?? dashVisit) ? <input type="hidden" name="dash" value={detailsDash ?? dashVisit} /> : <input type="hidden" name="back" value="" data-rec-back />}
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="field"><span class="meta">Last name</span><input name="last_name" value={d.last} required maxlength="60" autocomplete="off" /></label>
          <label class="field"><span class="meta">First name</span><input name="first_name" value={d.first} required maxlength="60" autocomplete="off" /></label>
          <label class="field"><span class="meta">Middle name</span><input name="middle_name" value={d.middle ?? ''} maxlength="60" autocomplete="off" /></label>
          <label class="field"><span class="meta">Suffix</span><input name="suffix" value={d.suffix ?? ''} maxlength="10" autocomplete="off" placeholder="Jr., Sr., III" /></label>
        </div>
        {/* The birth date, with the age beside it as it is typed. A change is kept in the health history, from and to
            (saveBirth); birth_was is the one this panel was drawn with, so a date nobody here touched is left alone. */}
        <div class="field">
          <label for="rec-birth" class="meta">Birth date</label>
          <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
            <input id="rec-birth" type="date" name="birth_date" value={birthValue} min="1900-01-01" max={today} class="w-[13.5rem]" autocomplete="off" aria-describedby="rec-birth-help" data-rec-birth data-today={today} />
            <span class="text-[15px] text-ink-2" aria-live="polite" data-rec-birth-age>{formAge !== null && formAge >= 0 ? ageText(formAge) : birthValue ? '' : 'Not on file yet'}</span>
          </div>
          <span id="rec-birth-help" class={help}>A change is kept in the health history, with the date it replaced.</span>
          <input type="hidden" name="birth_was" value={birthWas} />
        </div>
        <fieldset class="min-w-0">
          <legend class="float-left w-full text-[14px] font-medium text-ink-2">Sex</legend>
          <div class="pk-row clear-both pt-2">
            {SEXES.map((x) => (
              <label class="pk pk-radio"><input type="radio" name="sex" value={x.id} checked={d.sex === x.id} /><span>{x.label}</span></label>
            ))}
          </div>
        </fieldset>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="field"><span class="meta">Mobile</span><input type="tel" name="mobile" value={d.phone ? prettyPhone(d.phone) : ''} inputmode="tel" autocomplete="off" /><span class={help}>Reminders go to it.</span></label>
          <label class="field"><span class="meta">Email</span><input type="email" name="email" value={d.email ?? ''} maxlength="120" autocomplete="off" /></label>
          <label class="field sm:col-span-2"><span class="meta">Address</span><input name="address" value={d.address ?? ''} maxlength="200" autocomplete="off" /></label>
          <label class="field"><span class="meta">City or town</span><input name="city" value={d.city ?? ''} maxlength="80" autocomplete="off" /></label>
          <label class="field"><span class="meta">Province</span><input name="province" value={d.province ?? ''} maxlength="80" autocomplete="off" /></label>
          <label class="field"><span class="meta">HMO</span><input name="hmo_name" value={d.hmoName ?? ''} maxlength="80" autocomplete="off" list="rec-hmo-names" /></label>
          <label class="field"><span class="meta">HMO member no.</span><input name="hmo_member_no" value={d.hmoMemberNo ?? ''} maxlength="40" autocomplete="off" /></label>
          <label class="field"><span class="meta">Emergency contact</span><input name="emergency_name" value={d.emergencyName ?? ''} maxlength="120" autocomplete="off" /></label>
          <label class="field"><span class="meta">Relation</span><input name="emergency_relation" value={d.emergencyRelation ?? ''} maxlength="40" autocomplete="off" /></label>
          <label class="field"><span class="meta">Their number</span><input type="tel" name="emergency_phone" value={d.emergencyPhone ? prettyPhone(d.emergencyPhone) : ''} maxlength="20" inputmode="tel" autocomplete="off" /></label>
          <label class="field"><span class="meta">Chart no.</span><input name="chart_no" value={d.chartNo ?? ''} maxlength="20" autocomplete="off" /><span class={help}>Change it only to match the card.</span></label>
        </div>
        <label class="field"><span class="meta">Notes</span><textarea name="notes" rows="3" maxlength={NOTES_MAX} data-rec-details-notes>{d.notes ?? ''}</textarea><span class={help}>The desk sees this beside the patient’s visits on the Dashboard. Keep health details in Health.</span></label>
        <datalist id="rec-hmo-names">{data.hmoNames.map((h) => <option value={h} />)}</datalist>
        <div><button type="submit" class="ws-btn ws-btn-primary w-full"><Icon name="check" />Save details</button></div>
      </form>
    </SidePanel>
  )}
</ClinicLayout>

<script>
  import { ageOn, ageText, capitalise } from '../../../../lib/health';
  import { tabOf } from './_record/sections';
  import { aimForm, currentTab, landFocus } from './_record/pickpanel';

  // --- the tabs: in the address, so a reload or a post lands where it was ---
  const list = document.querySelector<HTMLElement>('.rec-tabs');
  const bar = document.querySelector<HTMLElement>('[data-rec-bar]');
  const topBar = document.querySelector<HTMLElement>('[data-ws-top]');
  const root = document.documentElement;
  const tabFor = (name: string) => document.getElementById(`rec-rec-${name}-tab`) as HTMLButtonElement | null;
  const panelOf = (el: Element | null) => el?.closest<HTMLElement>('[data-rec-panel]')?.dataset.recPanel ?? null;
  /** The tab a name lives in: its element's tab, else TAB_OF (less a tab panel's rec-). */
  const tabNamed = (name: string) => panelOf(document.getElementById(name)) ?? tabOf(name) ?? tabOf(name.replace(/^rec-/, ''));

  // The tab row sticks under the workspace's top bar; what is scrolled to (a tab, a card) lands just under the row.
  // From 768px the row shows a copy of the head's safety line as its second line once the head's line has left the
  // screen (data-pinned; ./_record/RecordNav.astro): the row grows by the copy's height (--rec-pin-h) and what follows
  // it moves down, so the copy covers nothing, neither the head's note, callouts and buttons nor the tab's content.
  // Wherever the row is stuck the head's line has left, so --rec-stick counts the copy always, and a landing is worked
  // out for the row as it will be once the scroll is done (the copy shown or not): whatever is scrolled to, focused
  // or landed on lands below the row with the allergies on screen above it. (The side panels and the chart's palette
  // sit in the top layer, above the row.)
  const pin = bar?.querySelector<HTMLElement>('[data-rec-pin]') ?? null;
  const pinHeight = () => Math.round(pin?.getBoundingClientRect().height ?? 0);
  const topHeight = () => Math.round(topBar?.getBoundingClientRect().height ?? 0);
  const pinned = () => !!bar?.hasAttribute('data-pinned');
  /** The row's own height, without the room it makes for the copy while that shows. */
  const rowHeight = () => {
    if (!bar) return 0;
    const cs = getComputedStyle(bar);
    return Math.round(bar.getBoundingClientRect().height - (parseFloat(cs.paddingBottom) - parseFloat(cs.paddingTop)));
  };
  let watchedTop = -1;
  const measure = () => {
    const top = topHeight();
    root.style.setProperty('--rec-top', `${top}px`);
    root.style.setProperty('--rec-pin-h', `${pinHeight()}px`);
    root.style.setProperty('--rec-stick', `${top + rowHeight() + pinHeight()}px`);
    if (top !== watchedTop) watchPin(top);
  };
  const safetyHead = document.querySelector<HTMLElement>('[data-rec-safety]');
  const PIN_AT = 12;
  /** Scroll so that el starts just under the row (and the copy, when it will show once scrolled there). */
  const land = (el: HTMLElement) => {
    const top = topHeight(), row = rowHeight(), pinH = pinHeight(), now = pinned();
    const r = el.getBoundingClientRect().top;
    // Below the row, el moves by the copy's height as it comes or goes.
    const below = !!bar && !bar.contains(el) && !!(bar.compareDocumentPosition(el) & Node.DOCUMENT_POSITION_FOLLOWING);
    const withPin = r + (below && !now ? pinH : 0), withoutPin = r - (below && now ? pinH : 0);
    let d = withPin - (top + row + pinH + 12);
    // The copy shows only once the head's line has left the screen; if this scroll leaves it on screen, land without.
    if (!pinH || !safetyHead || safetyHead.getBoundingClientRect().bottom - d > top + PIN_AT + 0.5) d = withoutPin - (top + row + 12);
    if (Math.abs(d) >= 1) scrollBy({ top: d, behavior: 'instant' });
  };
  /** Scroll only when needed: a tab's top hidden under the row (the page was scrolled down), or too low on the screen
   *  to see (a phone); then it starts just under the row. */
  const reveal = (el: HTMLElement) => {
    const barBox = bar?.getBoundingClientRect();
    const top = el.getBoundingClientRect().top;
    if (top >= (barBox?.bottom ?? 0) + 11 && top <= innerHeight - 96) return;
    land(el);
  };
  // Pinned once the head's safety line has left the screen: no more of it below the top bar than a sliver of its last
  // row of pills, too little to read (PIN_AT). One observer under the top bar, on the line (gone up, never down); made
  // again when the top bar's height changes.
  let watching: IntersectionObserver | null = null;
  function watchPin(top: number) {
    watchedTop = top;
    watching?.disconnect();
    watching = null;
    if (!bar || !pin || !safetyHead || !('IntersectionObserver' in window)) return;
    watching = new IntersectionObserver(([e]) => {
      const was = pinned();
      bar.toggleAttribute('data-pinned', !e.isIntersecting && e.boundingClientRect.bottom <= top + PIN_AT + 0.5);
      // The copy's room pushes what follows down: a control Tab just brought up from below stays on screen.
      const f = document.activeElement;
      if (!was && pinned() && f instanceof HTMLElement && !bar.contains(f) && !f.closest('dialog') && (bar.compareDocumentPosition(f) & Node.DOCUMENT_POSITION_FOLLOWING)) {
        const r = f.getBoundingClientRect(), foot = innerHeight - 16;
        if (r.bottom > foot && r.top - (r.bottom - foot) >= top + rowHeight() + pinHeight()) scrollBy({ top: r.bottom - foot, behavior: 'instant' });
      }
    }, { rootMargin: `-${top + PIN_AT}px 0px 0px 0px`, threshold: [0] });
    watching.observe(safetyHead);
  }
  measure();
  if ('ResizeObserver' in window) { const ro = new ResizeObserver(measure); if (topBar) ro.observe(topBar); if (bar) ro.observe(bar); if (pin) ro.observe(pin); }

  /** Show the tab a name lives in (a tab, an old section, a card's anchor: TAB_OF), and bring what it names into view:
   *  a card by its id (#health, #rx …), a tab from its top. */
  const show = (name: string, focus = false) => {
    const target = document.getElementById(name);
    const tab = tabNamed(name);
    const t = tab ? tabFor(tab) : null;
    if (!t) return false;
    if (t.getAttribute('aria-selected') !== 'true') t.click();
    const panel = document.getElementById(`rec-${tab}`);
    requestAnimationFrame(() => {
      if (target && !target.matches('[data-rec-panel], .rec-anchor')) land(target);
      else if (panel) reveal(panel);
      if (focus) t.focus({ preventScroll: true });
    });
    return true;
  };
  const fromHash = () => {
    let id = decodeURIComponent(location.hash.slice(1));
    if (!id) return;
    // The Timeline became the Treatment record: an old #timeline link lands there, and the address says so.
    if (id === 'timeline') { id = 'treatment-record'; history.replaceState(null, '', `${location.pathname}${location.search}#${id}`); }
    show(id);
  };
  // Every panel's form comes back to the tab it is opened over: as it opens, its `back` and the #<tab> on its address
  // (the tooth-first panels, TreatmentPanels and NotePanel, do the same for theirs, and send back=chart from the palette).
  const aimBack = (d: HTMLDialogElement) => {
    const tab = currentTab();
    if (!tab) return;
    d.querySelectorAll<HTMLInputElement>('input[data-rec-back]').forEach((b) => {
      b.value = tab;
      if (b.form) aimForm(b.form, tab, 'overview');
    });
  };
  list?.addEventListener('ws:tab', (e) => {
    const id = String((e as CustomEvent).detail?.id ?? '').replace(/^rec-/, '');
    if (id && location.hash !== `#${id}`) history.replaceState(null, '', `${location.pathname}${location.search}#${id}`);
    const panel = document.getElementById(`rec-${id}`);
    if (panel) reveal(panel);
  });
  window.addEventListener('hashchange', fromHash);
  // A panel the page opened as it loaded (?open=…, the Dashboard's links) stands over Today: the address's #hash
  // (the Dashboard writes #vitals with ?open=vitals) does not move the tab behind it. A post that came back refused
  // stands on the tab the server chose for it (a panel's own tab, a card's own tab): a #hash naming another tab is
  // put right in the address instead.
  const body = document.querySelector<HTMLElement>('[data-rec-body]');
  const asked = decodeURIComponent(location.hash.slice(1));
  if (body?.hasAttribute('data-rec-posted') && asked && tabNamed(asked) !== currentTab()) history.replaceState(null, '', `${location.pathname}${location.search}#${currentTab()}`);
  else if (!body?.hasAttribute('data-rec-opened')) fromHash();
  // A save or a refusal that is said in the head (Details saved., the stale page …) lands with its words on screen:
  // at the top of the page when they fit there, else just enough further down, whatever tab the address names; a
  // #card the address names still wins.
  const said = [...document.querySelectorAll<HTMLElement>('[data-rec-said]')];
  const showSaid = () => {
    const first = said[0].getBoundingClientRect(), last = said[said.length - 1].getBoundingClientRect();
    const d = Math.min(first.top - (topHeight() + 16), Math.max(last.bottom - (innerHeight - 16), -scrollY));
    if (Math.abs(d) >= 1) scrollBy({ top: d, behavior: 'instant' });
  };
  const askedEl = asked ? document.getElementById(asked) : null;
  if (said.length > 0 && !body?.hasAttribute('data-rec-opened') && (!asked || asked === 'timeline' || !!askedEl?.matches('.rec-anchor, [data-rec-panel]'))) {
    requestAnimationFrame(() => requestAnimationFrame(showSaid));
    if (document.readyState !== 'complete') addEventListener('load', () => requestAnimationFrame(showSaid), { once: true });
  }
  // A text box in a tab that Tab brings up from below shows only its caret's line (the browser reveals the caret, not
  // the box): the whole box, when it fits between the row (and its pinned copy) and the foot of the screen.
  body?.addEventListener('focusin', (e) => {
    const t = e.target;
    if (!(t instanceof HTMLTextAreaElement) || t.closest('dialog')) return;
    const fit = () => {
      const r = t.getBoundingClientRect();
      const foot = innerHeight - 16, head = (parseFloat(getComputedStyle(root).getPropertyValue('--rec-stick')) || 0) + 16;
      if (r.bottom > foot && r.top > head && r.height <= foot - head) scrollBy({ top: Math.min(r.bottom - foot, r.top - head) });
    };
    fit();
    requestAnimationFrame(fit);
  });
  // A panel the server drew open (a refused post, ?open=…) may have opened before this script ran.
  document.querySelectorAll<HTMLDialogElement>('dialog[data-ws-panel]').forEach((d) => {
    d.addEventListener('ws:panel-open', () => aimBack(d));
    if (d.open) aimBack(d);
  });

  // ?open=details (the Dashboard's desk note, "Edit"): the caret waits at the end of Notes, once the shell has opened
  // the panel and focused its title; then the address drops open and dash, so Back does not open the panel again.
  if (new URLSearchParams(location.search).get('open') === 'details') {
    requestAnimationFrame(() => requestAnimationFrame(() => {
      const panel = document.getElementById('details') as HTMLDialogElement | null;
      if (!panel?.open) return;
      const notes = panel.querySelector<HTMLTextAreaElement>('[data-rec-details-notes]');
      if (notes) { notes.focus(); notes.setSelectionRange(notes.value.length, notes.value.length); }
      const url = new URL(location.href);
      url.searchParams.delete('open'); url.searchParams.delete('dash');
      history.replaceState(null, '', `${url.pathname}${url.search}${url.hash}`);
    }));
  }
  // A way to another part of the record (a chip in the head, a line of This visit): its tab, and the card it names.
  document.querySelectorAll<HTMLElement>('[data-rec-go]').forEach((b) => b.addEventListener('click', (e) => {
    if (b instanceof HTMLAnchorElement) e.preventDefault();
    show(b.dataset.recGo!, true);
  }));

  // Add ▾: hidden offline and on the copy kept for a brownout (nothing can be saved there). Its list fits the screen
  // under the row (scrolled to where the row sticks first, when it would not), and a panel it opened gives focus back
  // to it when it closes.
  const add = document.querySelector<HTMLElement>('.rec-add');
  const addButton = add?.querySelector<HTMLButtonElement>(':scope > button') ?? null;
  const addList = add?.querySelector<HTMLElement>(':scope > .ws-menu-pop') ?? null;
  const online = () => { if (add) add.hidden = !!root.dataset.offlineCopy || !navigator.onLine; };
  online();
  window.addEventListener('online', online);
  window.addEventListener('offline', online);
  if (addList) new MutationObserver(() => {
    if (addList.hidden) return;
    addList.style.maxHeight = '';
    const room = () => innerHeight - addList.getBoundingClientRect().top - 12;
    const barTop = bar?.getBoundingClientRect().top ?? 0;
    // Where the row sticks: right under the top bar.
    const stuckAt = topHeight();
    if (room() < Math.min(addList.scrollHeight, 520) && barTop > stuckAt + 1) scrollBy({ top: barTop - stuckAt, behavior: 'instant' });
    addList.style.maxHeight = `${Math.max(160, room())}px`;
  }).observe(addList, { attributes: true, attributeFilter: ['hidden'] });
  // A panel that could not give focus back (the server drew it open after a refused post, over a tab with no button
  // for it) lands on a button on screen, Add ▾, or the tab in view: landFocus() in ./_record/pickpanel.ts.
  let fromAdd: Element | null = null;
  document.querySelectorAll<HTMLElement>('[data-rec-add-item]').forEach((b) => b.addEventListener('click', () => { fromAdd = document.getElementById(b.dataset.wsOpen ?? ''); }));
  document.querySelectorAll<HTMLDialogElement>('dialog[data-ws-panel]').forEach((d) => d.addEventListener('ws:panel-close', () => {
    if (fromAdd === d) { fromAdd = null; addButton?.focus(); }
    landFocus(d.id);
  }));

  // The chart speaks up: a copy of this page kept for a brownout opens on the Chart, and a
  // notice the chart raises (a colleague's newer finding, changes waiting on this device)
  // brings the Chart forward, wherever the person was.
  if (document.documentElement.dataset.offlineCopy) show('chart');
  const notices = document.querySelectorAll<HTMLElement>('[data-hold-note], [data-sync-notice], [data-copy-note]');
  const watch = new MutationObserver(() => { if ([...notices].some((n) => !n.hidden)) show('chart'); });
  notices.forEach((n) => watch.observe(n, { attributes: true, attributeFilter: ['hidden'] }));
  if ([...notices].some((n) => !n.hidden)) show('chart');

  // The chart in its card (the look and the layout are patients.css, "The chart"). The
  // component's empty line was written for a demo chart; a record says what to do. Where an
  // arch is wider than the card (a phone), the line above the chart says so, the edge where
  // teeth wait fades (data-pt-more), and the two arches scroll together, so the upper teeth
  // stay over the lower ones — arrow keys moving to a hidden tooth scroll both.
  const chart = document.querySelector<HTMLElement>('[data-pt-chart]');
  if (chart) {
    const empty = chart.querySelector<HTMLElement>('[data-note-empty]');
    if (empty) empty.textContent = 'Nothing charted yet. Pick a tooth to add a finding.';
    const hint = document.querySelector<HTMLElement>('[data-pt-chart-scroll]');
    const arches = [...new Set([...chart.querySelectorAll<HTMLElement>('[data-tooth]')]
      .map((t) => t.closest<HTMLElement>('.overflow-x-auto'))
      .filter((a): a is HTMLElement => !!a))];
    const measure = () => {
      let any = false;
      for (const a of arches) {
        const room = a.scrollWidth - a.clientWidth;
        const over = a.clientWidth > 0 && room > 1;
        any ||= over;
        const left = over && a.scrollLeft > 1;
        const right = over && a.scrollLeft < room - 1;
        if (left || right) a.dataset.ptMore = left && right ? 'both' : left ? 'left' : 'right';
        else delete a.dataset.ptMore;
      }
      if (hint) hint.hidden = !any;
    };
    let lead: HTMLElement | null = null;
    for (const a of arches) {
      a.addEventListener('scroll', () => {
        if (lead && lead !== a) return;
        lead = a;
        for (const b of arches) if (b !== a && Math.abs(b.scrollLeft - a.scrollLeft) > 1) b.scrollLeft = a.scrollLeft;
        measure();
        requestAnimationFrame(() => { if (lead === a) lead = null; });
      }, { passive: true });
    }
    const sized = new ResizeObserver(measure);
    arches.forEach((a) => { sized.observe(a); if (a.firstElementChild) sized.observe(a.firstElementChild); });
    measure();
  }

  // The health form. Chips are checkboxes, so the form posts without this
  // script too (what is left in an "add" box is split on commas and saved).
  // With it: Enter or Add turns the typed words into ticked chips, the none
  // chip and the others untick each other, and leaving with unsaved changes
  // asks first. "Unsaved" is the form's
  // data-health-unsaved attribute, so the consent form can see it.
  document.querySelectorAll<HTMLFormElement>('[data-health-form]').forEach((form) => {
    const note = form.querySelector<HTMLElement>('[data-health-dirty]');
    const mark = () => { form.toggleAttribute('data-health-unsaved', true); if (note) note.hidden = false; };
    form.addEventListener('input', mark);
    form.addEventListener('change', mark);
    form.addEventListener('submit', () => { form.removeAttribute('data-health-unsaved'); });
    window.addEventListener('beforeunload', (e) => { if (form.hasAttribute('data-health-unsaved')) { e.preventDefault(); e.returnValue = ''; } });

    form.querySelectorAll<HTMLElement>('[data-health-list]').forEach((group) => {
      const chips = group.querySelector<HTMLElement>('[data-health-chips]')!;
      const none = group.querySelector<HTMLInputElement>('[data-health-none]')!;
      const box = group.querySelector<HTMLInputElement>('[data-health-add-input]')!;
      const tpl = group.querySelector<HTMLTemplateElement>('[data-health-tpl]')!;
      const items = () => [...chips.querySelectorAll<HTMLInputElement>('input[type="checkbox"]:not([data-health-none])')];

      chips.addEventListener('change', (e) => {
        const t = e.target as HTMLInputElement;
        if (t === none) { if (t.checked) items().forEach((i) => { i.checked = false; }); }
        else if (t.checked) none.checked = false;
      });

      const add = () => {
        const words = box.value.split(/[,;\n]/).map((s) => capitalise(s.replace(/\s+/g, ' ').trim())).filter(Boolean);
        for (const w of words) {
          const same = items().find((i) => i.value.toLocaleLowerCase('en') === w.toLocaleLowerCase('en'));
          if (same) { same.checked = true; continue; }
          const node = tpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
          const input = node.querySelector('input')!;
          input.value = w;
          input.checked = true;
          node.querySelector('[data-health-chip-text]')!.textContent = w;
          chips.append(node);
        }
        if (words.length) { none.checked = false; mark(); }
        box.value = '';
        box.focus();
      };
      box.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); add(); } });
      group.querySelector<HTMLButtonElement>('[data-health-add]')!.addEventListener('click', add);
    });
  });

  // Edit details: the age beside the birth date. A date field fills its year a
  // digit at a time (0001, 0019, 0197, 1975), so nothing shows until the year
  // is a real one; a year still before 1900 when the field is left says so.
  const birth = document.querySelector<HTMLInputElement>('[data-rec-birth]');
  const birthAge = document.querySelector<HTMLElement>('[data-rec-birth-age]');
  const showAge = (leaving: boolean) => {
    if (!birth || !birthAge) return;
    const today = birth.dataset.today ?? '';
    const v = birth.value;
    const years = v ? ageOn(v, today) : null;
    birthAge.textContent = !v ? 'Not on file yet'
      : v < '1900-01-01' ? (leaving ? 'Check the year' : '')
      : years === null || years < 0 || v > today ? 'Check the date'
      : ageText(years);
  };
  birth?.addEventListener('input', () => showAge(false));
  birth?.addEventListener('blur', () => showAge(true));

  // Recording consent reloads the page. With health answers typed and not
  // saved, that would throw them away behind a browser "Leave site?" box, so
  // the consent form stops and says so, with a button that saves them.
  const health = document.querySelector<HTMLFormElement>('[data-health-form]');
  const consent = document.querySelector<HTMLFormElement>('[data-desk-consent-form]');
  const held = document.querySelector<HTMLElement>('[data-desk-consent-held]');
  if (health && consent && held) {
    consent.addEventListener('submit', (e) => {
      if (!health.hasAttribute('data-health-unsaved')) return;
      e.preventDefault();
      held.hidden = false;
      held.querySelector<HTMLButtonElement>('button')?.focus();
    });
    held.querySelector<HTMLButtonElement>('button')?.addEventListener('click', () => health.requestSubmit());
  }
</script>
