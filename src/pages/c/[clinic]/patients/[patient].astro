  const consentedIds = new Set((await tx.query<{ id: string }>('select a.id from appointment a where a.patient_id = $1 and visit_treatment_consented(a.id)', [p.id])).rows.map((r) => r.id));
  // The consent to dental examination and treatment in force, with its words: page 2's general paragraph.
