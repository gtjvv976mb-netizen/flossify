---
// The QR poster on paper: one A4 page, nothing else (./_poster.ts drawn as SVG,
// so it prints sharp and the browser's "Save as PDF" keeps it as a vector
// PDF). The page is its own document, without the workspace around it; on
// screen a white bar with the way back and one teal Print sits above the
// sheet and does not print. It is where the QR code page's Print poster goes
// when that page's script is not there (with it, the QR code page prints its
// own paper copy: a hidden frame cannot, since every page sends
// frame-ancestors 'none'), and a page to open and print directly.
//
// Colour on paper: the poster is Flossify's design — teal mark, a pale teal
// panel — so print-color-adjust is exact; on a black-and-white printer the
// panel prints as a light grey and the code stays dark on white.
//
// Same gate as the QR code page: requireWorkspace, then canEditRecords.
export const prerender = false;

import '../../../../../styles/global.css';
import { requireWorkspace } from '../../../../../lib/workspace';
import { withClinic } from '../../../../../lib/db';
import { canEditRecords } from '../../../../../lib/health';
import { formsKey } from '../../../../../lib/patient-forms';
import { qrSvg, qrMatrix, MARK } from '../../../../../lib/qr';
import { posterLayout, posterSvg } from './_poster';

const ws = await requireWorkspace(Astro);
if (ws instanceof Response) return ws;
const { clinic, session } = ws;
const back = `/c/${clinic.slug}/patients/qr/`;

const key = await withClinic(clinic.id, async (tx) =>
  (await canEditRecords(tx, session.staffId, clinic.id)) ? formsKey(tx, { clinicId: clinic.id, staffId: session.staffId }) : null);
if (!key) return Astro.redirect(back, 303);

const poster = posterLayout({
  clinicName: clinic.name, url: key.url, short: key.short, matrix: qrMatrix(key.url),
  mark: { radius: MARK.radius, tooth: MARK.tooth, fill: MARK.fill, toothFill: MARK.toothFill },
});
const svg = posterSvg(poster, qrSvg(key.url), { size: { w: '210mm', h: '297mm' } });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>QR poster — {clinic.name} — Flossify</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/IBMPlexMono-500.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      try {
        const saved = localStorage.getItem('theme');
        if (saved) document.documentElement.dataset.theme = saved;
      } catch (e) {
        /* storage blocked: fall back to the OS preference */
      }
    </script>
    <style is:global>
      @page { size: A4 portrait; margin: 0; }
      .pq-body {
        --pq-bg: #f3f5f8; --pq-bar: #ffffff; --pq-hair: #e6e9ee; --pq-ink: #1f2937; --pq-teal-ink: #0d706d; --pq-teal-fill: #0e7471;
        --pq-teal-fill-hover: #0b5f5d; --pq-hover: rgb(16 24 40 / 0.035);
        margin: 0; background: var(--pq-bg); color: var(--pq-ink);
        font-family: "Inter", ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      }
      @media screen and (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) .pq-body { --pq-bg: #15191e; --pq-bar: #1d232a; --pq-hair: #2a323b; --pq-ink: #e7ebf0; --pq-teal-ink: #7fdcd4; --pq-hover: rgb(255 255 255 / 0.055); }
      }
      @media screen { :root[data-theme="dark"] .pq-body { --pq-bg: #15191e; --pq-bar: #1d232a; --pq-hair: #2a323b; --pq-ink: #e7ebf0; --pq-teal-ink: #7fdcd4; --pq-hover: rgb(255 255 255 / 0.055); } }
      .pq-bar { background: var(--pq-bar); border-bottom: 1px solid var(--pq-hair); }
      .pq-bar-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.625rem 0.75rem; max-width: 1280px; margin-inline: auto; padding: 0.75rem 1.25rem; }
      .pq-back { display: inline-flex; align-items: center; gap: 0.3rem; min-height: 44px; margin-right: auto; padding: 0 0.5rem; border-radius: 10px; font-size: 15px; font-weight: 600; color: var(--pq-teal-ink); }
      .pq-back:hover { background: var(--pq-hover); }
      .pq-note { font-size: 14px; color: var(--pq-ink); opacity: 0.85; }
      .pq-print {
        display: inline-flex; align-items: center; gap: 0.5rem; min-height: 44px; padding: 0 1.125rem; border: 0; border-radius: 10px;
        background: var(--pq-teal-fill); color: #fff; font: inherit; font-size: 15px; font-weight: 600; cursor: pointer; box-shadow: 0 1px 2px rgb(16 24 40 / 0.05);
        transition: background-color 160ms ease;
      }
      .pq-print:hover { background: var(--pq-teal-fill-hover); }
      .pq-body :focus-visible { outline: 2px solid #14908f; outline-offset: 2px; }
      .pq-main { padding: 2rem 1rem 3rem; }
      /* On screen: the A4 sheet at the width of the window (up to its real size), white, a soft lift. */
      .pq-sheet { width: min(210mm, 100%); margin-inline: auto; background: #fff; border-radius: 6px; box-shadow: 0 1px 2px rgb(16 24 40 / 0.06), 0 12px 32px -8px rgb(16 24 40 / 0.18); overflow: hidden; }
      .pq-sheet > svg { display: block; width: 100%; height: auto; }
      @media print {
        html, body { width: 210mm; height: 297mm; margin: 0; padding: 0; overflow: hidden; background: #fff !important; }
        .pq-bar { display: none !important; }
        .pq-main { padding: 0; }
        .pq-sheet { width: 210mm; height: 297mm; margin: 0; border-radius: 0; box-shadow: none; }
        .pq-sheet > svg { width: 210mm; height: 297mm; }
        .pq-sheet, .pq-sheet * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
      }
    </style>
  </head>
  <body class="pq-body">
    <div class="pq-bar">
      <div class="pq-bar-row">
        <a href={back} class="pq-back">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.5 6.5L9 12l5.5 5.5" /></svg>
          Back to the QR code
        </a>
        <span class="pq-note">A4. To keep a PDF, choose Save as PDF.</span>
        <button type="button" class="pq-print" data-print>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 9V4h10v5" /><rect x="3.5" y="9" width="17" height="7.5" rx="2" /><path d="M7 14h10v6H7z" /></svg>
          Print
        </button>
      </div>
    </div>
    <main class="pq-main">
      <div class="pq-sheet" set:html={svg} />
    </main>
    <script>
      import { fitSvgText } from '../_forms/fit';
      fitSvgText(document.querySelector<SVGSVGElement>('.pq-sheet svg'));
      document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
    </script>
  </body>
</html>
