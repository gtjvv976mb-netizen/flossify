---
// One X-ray, photo or document from a patient's record, opened from Files or a
// visit's panel (in its own tab). A small page around the file, not the file
// itself: a file served bare runs no script, so it could not leave the screen
// when this device is handed to a patient or becomes a clinic tablet
// (ParkedGuard). The picture is an <img>; a PDF sits in a frame the browser's
// own viewer draws (the file answers frame-ancestors 'self' for this page:
// ../[file].ts). The file itself — and its audit, record.file_view — is still
// ../ (?download=1 saves it). Behind requireWorkspace and RLS, no-store like
// every /c/ response. Nothing here is audited: opening the file is.
export const prerender = false;

import '../../../../../../../styles/global.css';
import ParkedGuard from '../../../../../../../components/ws/ParkedGuard.astro';
import { requireWorkspace } from '../../../../../../../lib/workspace';
import { withClinic } from '../../../../../../../lib/db';
import { FILE_KINDS } from '../../../../../../../lib/record';
import { dateText, manilaToday } from '../../../../../../../lib/health';

const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
const ws = await requireWorkspace(Astro);
if (ws instanceof Response) return ws;
const { clinic } = ws;
const patientId = Astro.params.patient ?? '', fileId = Astro.params.file ?? '';
if (!UUID.test(patientId) || !UUID.test(fileId)) return new Response(null, { status: 404 });
const back = `/c/${clinic.slug}/patients/${patientId}/#files`;
const raw = `/c/${clinic.slug}/patients/${patientId}/files/${fileId}/`;

const f = await withClinic(clinic.id, async (tx) => (await tx.query<{ kind: string; caption: string | null; mime: string; at: Date; first_name: string }>(
  `select a.kind, a.caption, a.mime, a.created_at as at, p.first_name
     from attachment a join patient p on p.id = a.patient_id
    where a.id = $1 and a.patient_id = $2 and a.removed_at is null`, [fileId, patientId])).rows[0] ?? null);
if (!f) return new Response(null, { status: 404 });
const label = FILE_KINDS[f.kind] ?? 'File';
const title = f.caption ? `${label}: ${f.caption}` : label;
const pdf = f.mime === 'application/pdf';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title} · {f.first_name} — {clinic.name}</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      try { const t = localStorage.getItem('theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t; } catch (e) { /* storage blocked */ }
    </script>
    <ParkedGuard />
    <style>
      .fv-body {
        --px-bg: #f3f5f8; --px-bar: #ffffff; --px-hair: #e6e9ee; --px-ink: #1f2937; --px-ink-2: #475467; --px-teal-ink: #0d706d; --px-hover: rgb(16 24 40 / 0.035);
        font-family: "Inter", ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        background: var(--px-bg); color: var(--px-ink); min-height: 100vh; display: flex; flex-direction: column;
      }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) .fv-body { --px-bg: #15191e; --px-bar: #1d232a; --px-hair: #2a323b; --px-ink: #e7ebf0; --px-ink-2: #c3cad3; --px-teal-ink: #7fdcd4; --px-hover: rgb(255 255 255 / 0.055); }
      }
      :root[data-theme="dark"] .fv-body { --px-bg: #15191e; --px-bar: #1d232a; --px-hair: #2a323b; --px-ink: #e7ebf0; --px-ink-2: #c3cad3; --px-teal-ink: #7fdcd4; --px-hover: rgb(255 255 255 / 0.055); }
      .fv-bar { background: var(--px-bar); border-bottom: 1px solid var(--px-hair); }
      .fv-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.75rem; max-width: 1280px; margin-inline: auto; padding: 0.75rem 1.25rem; }
      .fv-link { display: inline-flex; align-items: center; gap: 0.3rem; min-height: 44px; padding: 0 0.625rem; border-radius: 10px; font-size: 15px; font-weight: 600; color: var(--px-teal-ink); }
      .fv-link:hover { background: var(--px-hover); }
      .fv-what { flex: 1 1 12rem; min-width: 0; margin: 0; font-size: 15px; color: var(--px-ink-2); overflow-wrap: anywhere; }
      .fv-what b { color: var(--px-ink); font-weight: 600; }
      .fv-body :focus-visible { outline: 2px solid #14908f; outline-offset: 2px; }
      .fv-main { flex: 1; display: grid; place-items: center; padding: 1rem; }
      .fv-img { max-width: 100%; max-height: calc(100vh - 7rem); height: auto; border-radius: 12px; background: #fff; }
      .fv-pdf { width: 100%; height: calc(100vh - 6rem); border: 1px solid var(--px-hair); border-radius: 12px; background: #fff; }
    </style>
  </head>
  <body class="fv-body">
    <header class="fv-bar">
      <div class="fv-row">
        <a href={back} class="fv-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.5 6.5L9 12l5.5 5.5" /></svg>
          Back to {f.first_name}’s record
        </a>
        <p class="fv-what"><b>{title}</b> · added {dateText(manilaToday(new Date(f.at)))}</p>
        <a href={`${raw}?download=1`} class="fv-link">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11M7.5 10.5L12 15l4.5-4.5M5 19.5h14" /></svg>
          Save
        </a>
      </div>
    </header>
    <main class="fv-main">
      {pdf
        ? <iframe class="fv-pdf" src={raw} title={title}></iframe>
        : <img class="fv-img" src={raw} alt={title} />}
    </main>
  </body>
</html>
