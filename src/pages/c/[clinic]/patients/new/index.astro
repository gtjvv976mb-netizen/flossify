---
// Add patient: "How will they fill in their details and consent forms?"
// (the step-by-step forms, 039; plan 1.11: the one chooser). The ways open on
// this server as radio cards (src/lib/add-ways.ts: a way closed here is left
// out, never greyed; "Easiest" only beside an open way) and one teal
// Continue:
//   On their phone · Easiest — the code for their phone, a QR code only this
//     patient can use (open while the privacy notice in force covers a new
//     patient's patient information: formsNoticeReady).
//   At the clinic — a clinic tablet, or this device handed to them. For a new
//     patient while their patient information is closed: type their details
//     first, then their consent forms (./type/?next=consents).
//   Type it in yourself — the typing form, for a phone call or a paper form (./type/).
// Continue posts to ../intake/ (intent=start: the one place an intake is
// made) for the first two; the third goes to ./type/. When typing is the only
// way open (no consent form offered: a production server until they are
// reviewed), this page answers 303 straight to ./type/ with its query. Other
// ways, quiet: Import a spreadsheet, and Forms to add while some are waiting
// (so nobody adds a patient who already sent their forms). The QR poster for
// the desk is under Patients → More.
//
// ?patient=<id>: a patient on file — "How will <name> sign their consent
// forms?", the phone and the clinic only (the record's Prepare consent forms,
// and ./type/?next=consents lands here with &saved=new). A way that needs
// their birth date stays, off, saying so; with no consent form offered here,
// the page says to sign them on paper.
//
// Who: can(ws, 'records.edit') to draw it; the intake endpoint checks
// canEditRecords in its transaction. Others read "Not allowed".
export const prerender = false;

import ClinicLayout from '../../../../../layouts/Clinic.astro';
import Csrf from '../../../../../components/Csrf.astro';
import Pane from '../../../../../components/ws/Pane.astro';
import Icon from '../../../../../components/ws/Icon.astro';
import Head from '../_ui/Head.astro';
import Callout from '../_ui/Callout.astro';
import Glyph from '../_ui/Glyph.astro';
import '../_ui/patients.css';
import '../_forms/forms.css';
import '../intake/intake.css';
import { requireWorkspace } from '../../../../../lib/workspace';
import { withClinic } from '../../../../../lib/db';
import { CSRF_MESSAGE } from '../../../../../lib/csrf';
import { canEditRecords, dateText } from '../../../../../lib/health';
import { countFormsToAdd } from '../../../../../lib/forms-to-add';
import { addWays, type WayValue } from '../../../../../lib/add-ways';
import { PLACE } from '../../../../../lib/places';
import { can } from '../../../../../lib/can';
import { intakeGates, patientOnFile, isUuid } from '../../../../../lib/intake';

const ws = await requireWorkspace(Astro);
if (ws instanceof Response) return ws;
const { clinic, session, branches } = ws;
const slug = clinic.slug;
const url = Astro.url;
const patientParam = url.searchParams.get('patient');
const visitParam = url.searchParams.get('visit');
const stale = url.searchParams.get('stale') === '1';
const saved = url.searchParams.get('saved') === 'new';
// A refusal from ../intake/ (intent=start) comes back as ?refused=<code>: a fixed sentence, never typed text.
const REFUSED: Record<string, string> = {
  page1: 'A new patient’s details open here when the clinic’s privacy notice covers them. Type their details in first, then prepare their consent forms.',
  birth: 'Add the patient’s birth date to their record first: the forms depend on their age.',
  patient: 'That patient is not on file here any more.',
  visit: 'That visit is not this patient’s, or is not going ahead.',
  forms: 'No consent forms are open on this server yet.',
  way: 'Choose how they will fill it in.',
  busy: 'Too many at once. Wait a moment and try again.',
  allowed: 'Your account cannot add patients at this branch. Ask the owner.',
};
const refused = REFUSED[url.searchParams.get('refused') ?? ''] ?? null;

const data = await withClinic(clinic.id, async (tx) => ({
  area: (await tx.query('select area from clinic where id = $1', [clinic.id])).rows[0]?.area as string | null,
  canEdit: can(clinic, 'records.edit') && (await canEditRecords(tx, session.staffId, clinic.id)),
  gates: await intakeGates(tx),
  patient: patientParam && isUuid(patientParam) ? await patientOnFile(tx, patientParam) : null,
  // Forms to add, both ways: said once, under Other ways, before anyone adds the same person again.
  formsToAdd: await countFormsToAdd(tx),
}));
const { gates } = data;
const patient = data.patient && !data.patient.archived ? data.patient : null;
const missingPatient = !!patientParam && !patient;

// The ways open here (src/lib/add-ways.ts), with their icons.
const ICON: Record<WayValue, 'phone' | 'tablet' | 'keyboard'> = { phone: 'phone', clinic: 'tablet', type: 'keyboard' };
const { ways, onlyTyping } = addWays({ templates: gates.templates.length, phoneOpen: gates.phoneOpen, page1Open: gates.page1Open }, patient);
const chosen = ways.find((w) => !w.off)?.value ?? null;
// Typing is the only way open (no consent form offered here: a production server until they are reviewed): no
// screen to choose on — straight to the typed form, with this address's query (it says there why, in one line).
// Never for a patient on file (their consent forms have no typed way) and never for someone who may not add patients.
if (data.canEdit && !patient && !missingPatient && onlyTyping) {
  return Astro.redirect(`/c/${slug}/patients/new/type/${url.search}`, 303);
}
const recordHref = patient ? `/c/${slug}/patients/${patient.id}/` : null;
const title = patient ? `Consent forms for ${patient.firstName}` : 'Add patient';
const heading = patient ? `How will ${patient.firstName} sign their consent forms?` : 'How will they fill in their details and consent forms?';
---

<ClinicLayout groupId={clinic.group_id} clinic={{ slug, name: clinic.name, area: data.area }} title={title} section="add-patient" staff={{ name: session.name, role: session.role }} branches={branches} finance={clinic.can_view_finance} layout="panes" heading>
  {recordHref ? (
    <a href={`${recordHref}#consent`} class="rec-back ws-glass m-0! w-fit px-3!"><Icon name="chevron-left" />Back to {patient!.firstName}’s record</a>
  ) : (
    <>
      <a href={`/c/${slug}/patients/`} class="rec-back ws-glass m-0! w-fit px-3!" data-pts-back><Icon name="chevron-left" />Back to patients</a>
      <script>
        // Back to the list as it was left: the same search, filter and sort (../_list/back.ts).
        import { restoreBackLinks } from '../_list/back';
        restoreBackLinks();
      </script>
    </>
  )}
  {stale && <Callout tone="alert" text={CSRF_MESSAGE} />}
  {refused && <Callout tone="alert" focus class="focus:outline-none" data-ik-refused title="Nothing was started." text={refused} />}
  {saved && patient && <Callout tone="success" title={`${patient.name} is on file (${patient.chartNo}).`} text="Now their consent forms: choose how they will sign them." />}

  {!data.canEdit ? (
    <Pane as="div" label="Not allowed">
      <Callout tone="alert" role="note" text="Your account cannot add patients at this branch. Ask the owner." />
    </Pane>
  ) : missingPatient ? (
    <Pane as="div" label="Not found">
      <Callout tone="warn" role="note" text="That patient is not on file here any more." />
      <p class="mt-3"><a href={`/c/${slug}/patients/`} class="ws-empty-go">All patients <Icon name="arrow-right" size={16} /></a></p>
    </Pane>
  ) : (
    <>
    <Pane as="section" label={heading}>
      <Head icon="form" title={heading} meta={patient ? `${patient.chartNo}${patient.birth ? ` · born ${dateText(patient.birth)}` : ''}` : undefined} />
      {/* No way open: a patient on file, and no consent form offered here (a production server until they are reviewed). */}
      {ways.length === 0 ? (
        <Callout tone="info" role="note" text="Patients can sign their consent forms here once a dentist and a lawyer have read them. Until then, sign them on paper." />
      ) : (
        <form method="post" action={`/c/${slug}/patients/intake/`} class="grid gap-4" data-ik-choose>
          <Csrf />
          <input type="hidden" name="intent" value="start" />
          {patient && <input type="hidden" name="patient" value={patient.id} />}
          {visitParam && isUuid(visitParam) && <input type="hidden" name="visit" value={visitParam} />}
          <fieldset class="ik-ways">
            <legend class="sr-only">{heading}</legend>
            {ways.map((w) => (
              <label class="ik-way">
                <input type="radio" name="way" value={w.value} checked={w.value === chosen} disabled={!!w.off} aria-describedby={`ik-way-${w.value}`} />
                <span class="ik-way-box">
                  <span class="ik-way-icon"><Glyph name={ICON[w.value]} /></span>
                  <span class="ik-way-words">
                    <span class="ik-way-title">{w.title}{w.pill && <span class="ik-way-pill">{w.pill}</span>}</span>
                    <span class="ik-way-line" id={`ik-way-${w.value}`}>{w.off ?? w.line}</span>
                  </span>
                </span>
              </label>
            ))}
          </fieldset>
          <div class="ik-actions">
            <button type="submit" class="ws-btn ws-btn-primary" disabled={!chosen}>Continue <Icon name="arrow-right" /></button>
          </div>
        </form>
      )}
    </Pane>

    {!patient && (
      <Pane as="section" label="Other ways">
        <Head icon="link" title="Other ways" />
        <ul class="ik-links">
          <li><a href={`/c/${slug}/patients/import/`}><Icon name="upload" /><span>Import a spreadsheet <span class="ik-links-hint">· many patients or past visits</span></span></a></li>
          {data.formsToAdd > 0 && (
            <li><a href={`/c/${slug}/patients/forms/`} data-ik-forms-to-add><Glyph name="form" /><span>{PLACE.formsToAdd} ({data.formsToAdd}) <span class="ik-links-hint">· check the patient is not already there</span></span></a></li>
          )}
        </ul>
      </Pane>
    )}
    </>
  )}
</ClinicLayout>

<script>
  // A refusal from the start: bring it into view.
  document.querySelector<HTMLElement>('[data-ik-refused]')?.focus();
</script>
