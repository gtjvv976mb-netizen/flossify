---
// The record's index: every section is on the one page, one after another, and these are links to them, grouped
// under Patient · Health · Clinical · Documents · Billing, each with its colour, icon and count (./sections.ts). On a
// wide screen a column that stays in view beside the record; on a narrower one a row that stays at the top and
// scrolls sideways. The record's script marks the section in view (aria-current="location") as the page scrolls; the
// group names are drawn for the eye and said once in each link for a screen reader.
import Glyph from '../_ui/Glyph.astro';
import { GROUPS, SECTION_META } from './sections';

interface Item { id: string; label: string; count?: number | null }
interface Props { items: Item[]; current: string; name: string }
const { items, current, name } = Astro.props;
const groups = GROUPS.map((g) => ({ ...g, items: items.filter((i) => SECTION_META[i.id]?.group === g.name) })).filter((g) => g.items.length);
---

<nav class="rec-nav" aria-label={`Sections of ${name}’s record`} data-rec-nav>
  <ul class="rec-tabs rec-nav-list">
    {groups.map((g) => (
      <>
        <li class:list={['rec-nav-group', `hue-${g.hue}`]} aria-hidden="true"><span class="rec-nav-dot"></span>{g.name}</li>
        {g.items.map((i) => {
          const m = SECTION_META[i.id];
          return (
            <li class="contents">
              <a href={`#rec-${i.id}`} id={`rec-rec-${i.id}-tab`} data-rec-link={i.id} class:list={['rec-nav-item', `hue-${m.hue}`]}
                aria-current={i.id === current ? 'location' : undefined}>
                <span class="rec-nav-icon" aria-hidden="true"><Glyph name={m.icon} size={17} /></span>
                <span class="rec-nav-label"><span class="sr-only">{g.name}: </span>{i.label}</span>
                {i.count ? <span class="rec-nav-count">{i.count}<span class="sr-only"> {i.count === 1 ? 'item' : 'items'}</span></span> : null}
              </a>
            </li>
          );
        })}
      </>
    ))}
  </ul>
</nav>
