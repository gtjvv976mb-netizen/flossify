---
// The record's contents, as on the first page of a paper chart: the numbered parts in the order they follow, each a
// link to its part further down the one page. Plain words on one wrapping line; nothing stays on screen.
interface Item { id: string; label: string; n: number }
interface Props { items: Item[]; name: string }
const { items, name } = Astro.props;
---

<nav class="pp-contents" aria-label={`Parts of ${name}’s record`} data-rec-nav>
  <span class="pp-contents-k">Contents</span>
  <ol class="rec-tabs">
    {items.map((i) => (
      <li><a href={`#rec-${i.id}`} id={`rec-rec-${i.id}-tab`} data-rec-link={i.id}><span class="pp-n">{i.n}</span>{i.label}</a></li>
    ))}
  </ol>
</nav>
