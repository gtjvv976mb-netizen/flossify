---
// Clinical notes: one visit each, in the order a dentist thinks — why they came, what was found, the
// diagnosis, what was done, what comes next — dated, with the dentist and the teeth. A signed note is
// never edited (the database lets the app insert only): a correction is an addendum, shown under the
// note it adds to, dated and signed in turn. The note's panel is NotePanel.astro, outside the record's tabs,
// so the chart's palette and Add ▾ can open it too; what a save says is the page's saved line.
import Pane from '../../../../../components/ws/Pane.astro';
import Empty from '../../../../../components/ws/Empty.astro';
import Icon from '../../../../../components/ws/Icon.astro';
import Head from '../_ui/Head.astro';
import Glyph from '../_ui/Glyph.astro';
import Who from './Who.astro';
import type { Clinical, Note } from '../../../../../lib/record';
import { dateText, when } from '../../../../../lib/health';

interface Props { c: Clinical; canEdit: boolean }
const { c, canEdit } = Astro.props;

const PARTS: [keyof Note, string][] = [['complaint', 'Why they came'], ['findings', 'What was found'], ['diagnosis', 'Diagnosis'], ['treatment', 'What was done'], ['plan', 'Next steps']];
const roots = c.notes.filter((n) => !n.amends);
const addenda = (id: string) => c.notes.filter((n) => n.amends === id).sort((a, b) => +new Date(a.at) - +new Date(b.at));
// An addendum whose note is older than the newest 300 still shows, on its own.
const orphans = c.notes.filter((n) => n.amends && !c.notes.some((r) => r.id === n.amends));
---

<div class="grid gap-4 max-md:gap-3">
  <Pane as="section" label="Clinical notes" id="notes">
    <Head icon="pen" title="Clinical notes" meta={roots.length ? `${roots.length} ${roots.length === 1 ? 'note' : 'notes'}` : undefined} />
    <slot name="saved" />
    <div class="rec-lead -mt-2 mb-4">
      <p>What the dentist saw and did at each visit. A saved note cannot be changed; to correct one, add an addendum.</p>
      {canEdit && <button type="button" class="ws-btn ws-btn-primary" data-ws-open="rec-note-add" data-amends=""><Icon name="plus" />New note</button>}
    </div>
    {c.notes.length === 0 ? <Empty icon="file" text="No clinical notes yet." /> : (
      <div>
        {[...roots, ...orphans].map((n) => (
          <>
            <article class="nt-card" data-addendum={n.amends ? '' : undefined} aria-label={`Note of ${dateText(n.visitOn)}`}>
              <header class="nt-head2">
                <p class="rp-row">
                  {n.amends && <span class="rp rp-warn">Addendum</span>}
                  <span class="nt-date"><Icon name="calendar" size={16} />{dateText(n.visitOn)}</span>
                  <Who name={n.dentist} />
                  {n.teeth.map((t) => <span class="rp rp-tooth"><Glyph name="tooth" size={14} /><span class="sr-only">Tooth </span>{t}</span>)}
                </p>
              </header>
              <div class="nt-parts2">
                {PARTS.filter(([k]) => n[k]).map(([k, label]) => <div class="rs-line"><span class="rk">{label}</span><p class:list={['nt-text', k === 'diagnosis' && 'nt-dx']}>{n[k] as string}</p></div>)}
              </div>
              <footer class="nt-foot">
                <span>Written {when(new Date(n.at))}{n.by ? ` by ${n.by}` : ''}</span>
                {canEdit && !n.amends && <button type="button" class="ws-btn ws-btn-quiet ws-btn-sm" data-ws-open="rec-note-add" data-amends={n.id} data-amends-day={dateText(n.visitOn)}><Icon name="plus" />Add an addendum</button>}
              </footer>
            </article>
            {!n.amends && addenda(n.id).map((a) => (
              <article class="nt-card" data-addendum aria-label={`Addendum of ${when(new Date(a.at))}`}>
                <header class="nt-head2">
                  <p class="rp-row">
                    <span class="rp rp-warn">Addendum</span>
                    <Who name={a.dentist} />
                    {a.teeth.map((t) => <span class="rp rp-tooth"><Glyph name="tooth" size={14} /><span class="sr-only">Tooth </span>{t}</span>)}
                  </p>
                </header>
                <div class="nt-parts2">{PARTS.filter(([k]) => a[k]).map(([k, label]) => <div class="rs-line"><span class="rk">{label}</span><p class:list={['nt-text', k === 'diagnosis' && 'nt-dx']}>{a[k] as string}</p></div>)}</div>
                <footer class="nt-foot"><span>Written {when(new Date(a.at))}{a.by ? ` by ${a.by}` : ''}</span></footer>
              </article>
            ))}
          </>
        ))}
      </div>
    )}
  </Pane>
</div>
