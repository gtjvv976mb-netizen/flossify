---
// The record's Today tab: This visit (./VisitStrip.astro, while the patient is in today), Coming up, Needs attention
// and Last visit. Two columns from 1024px — This visit and Last visit on the left, Coming up and Needs attention on the
// right — and one column below it in the order the desk reads them: This visit, Needs attention, Coming up, Last visit.
//
// Coming up (#visits): each visit booked after now, its day and time a button that opens the visit's panel, with the
// dentist and its reminder text's state in Calls' words (src/lib/reminder-state.ts); the next check-up (./RecallCard,
// #recall: In 6 months and Other… while none is set); what is still on the plan, in words (Chart & plan has the rows).
// Needs attention: the lines of needsAttention() in ./today.ts, each with its one action. Last visit: the newest visit
// that happened, its day a button to its panel, then in words what it was, who, what was done, the blood pressure that
// day and the note's diagnosis.
//
// Every line is words and at most its own buttons; nothing here only switches tabs but the lines that are done where
// they live (the privacy notice on Patient info; until their panels come, the health history and an LOA's answer).
import Pane from '../../../../../components/ws/Pane.astro';
import Icon from '../../../../../components/ws/Icon.astro';
import type { Act, Need } from './today';

interface Props {
  coming: { key: string; when: string; what: string | null; dentist: string | null; reminder: string; status: string }[];
  plan: { words: string }[];
  needs: Need[];
  last: { key: string; day: string; lines: string[] } | null;
}
const { coming, plan, needs, last } = Astro.props;
const TONE_ICON = { plain: 'info', warn: 'alert', alert: 'alert' } as const;
const attrs = (a: Act) => a.data ?? {};
---

<div class:list={['td-grid', !Astro.slots.has('visit') && 'td-novisit']}>
  {Astro.slots.has('visit') && <div class="td-visit"><slot name="visit" /></div>}

  {needs.length > 0 && (
    <Pane as="section" title="Needs attention" icon="alert" class="td-needs hue-teal">
      <ul class="vs-list">
        {needs.map((n) => (
          <li class="vs-line" data-tone={n.tone}>
            <Icon name={TONE_ICON[n.tone]} size={18} />
            <span class="vs-words">{n.words}{n.link && <> <a href={n.link.href} class="vs-done-a">{n.link.label}</a></>}</span>
            {n.act && (
              <div class="vs-acts" data-n="1">
                {n.act.href ? <a href={n.act.href} class="ws-btn ws-btn-quiet ws-btn-sm">{n.act.icon && <Icon name={n.act.icon} />}{n.act.label}</a>
                  : n.act.open ? <button type="button" class="ws-btn ws-btn-quiet ws-btn-sm" data-ws-open={n.act.open} {...attrs(n.act)}>{n.act.label}</button>
                  : <button type="button" class="ws-btn ws-btn-quiet ws-btn-sm" data-rec-go={n.act.go} {...attrs(n.act)}>{n.act.label}</button>}
              </div>
            )}
          </li>
        ))}
      </ul>
    </Pane>
  )}

  <Pane as="section" title="Coming up" icon="calendar" id="visits" class="td-coming hue-teal">
    <slot name="wrote" />
    {coming.length === 0 ? <p class="td-none">Nothing booked after today.</p> : (
      <ul class="td-list" aria-label="Visits booked">
        {coming.map((v) => (
          <li class="td-visit-row">
            <button type="button" class="td-when" data-ws-open={`rec-visit-${v.key}`} aria-haspopup="dialog">{v.when}</button>
            <span class="td-sub">{[v.what, v.dentist].filter(Boolean).join(' · ')}{v.status === 'confirmed' ? ' · Confirmed' : ''}</span>
            <span class="td-sub"><Icon name="message" size={14} />{v.reminder}</span>
          </li>
        ))}
      </ul>
    )}
    <div class="mt-3"><slot name="recall" /></div>
    {plan.length > 0 && (
      <p class="td-plan"><span class="td-plan-k">Still on the plan:</span> {plan.map((p) => p.words).join('; ')}</p>
    )}
  </Pane>

  {last && (
    <Pane as="section" title="Last visit" icon="clock" class="td-last hue-teal">
      <button type="button" class="td-when" data-ws-open={`rec-visit-${last.key}`} aria-haspopup="dialog">{last.day}</button>
      {last.lines.map((l) => <p class="td-sub">{l}</p>)}
    </Pane>
  )}
</div>
