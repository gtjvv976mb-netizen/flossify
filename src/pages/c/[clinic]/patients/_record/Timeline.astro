---
// The patient's story, newest first, one day at a time — built around the visits. Each visit is a card
// (src/lib/visit-record.ts gathers what belongs to it): the time, the status, the dentist, what was done to
// which tooth, whether the consent was signed (with a small copy of the signature) and what was paid. The
// whole card is a button that opens the visit in a side panel with every detail (./VisitPanels.astro).
//
// What happened between visits — the record made, health answers, chart changes, a text, a payment on a
// day with no visit — stays as a small line under its day, with "Open" to the section it came from
// (loadTimeline in src/lib/record.ts). A line a visit already holds is not listed twice. Chips at the top
// show everything, only the visits, or only the rest; they work in the page, and with scripts off the
// whole list shows (the visit panels need scripts, like every panel in the workspace).
import Pane from '../../../../../components/ws/Pane.astro';
import Empty from '../../../../../components/ws/Empty.astro';
import Chip from '../../../../../components/ws/Chip.astro';
import Icon from '../../../../../components/ws/Icon.astro';
import Head from '../_ui/Head.astro';
import Glyph from '../_ui/Glyph.astro';
import Who from './Who.astro';
import Signature from './Signature.astro';
import type { GlyphName } from '../_ui/glyphs';
import type { TimelineEvent, TimelineKind } from '../../../../../lib/record';
import { canSign, type Visit } from '../../../../../lib/visit-record';

interface Props { events: TimelineEvent[]; sections: string[]; visits: Visit[]; money: boolean; canEdit: boolean; today: string }
const { events, sections, visits, money, canEdit, today } = Astro.props;

const ICON: Record<TimelineKind, GlyphName> = {
  visit: 'calendar', treatment: 'plan', note: 'pen', health: 'heart', chart: 'tooth', money: 'money', file: 'image', message: 'message', consent: 'shield', record: 'user',
};
const OPEN: Record<string, string> = { overview: 'Overview', visits: 'Visits', health: 'Health', chart: 'Chart', treatment: 'Treatment', notes: 'Notes', rx: 'Prescriptions', files: 'Files', money: 'Money', consent: 'Consent', texts: 'Texts' };
const tz = 'Asia/Manila';
const dayKey = (d: Date) => new Intl.DateTimeFormat('en-CA', { timeZone: tz, year: 'numeric', month: '2-digit', day: '2-digit' }).format(d);
const dayWords = (key: string) => new Intl.DateTimeFormat('en-PH', { timeZone: 'UTC', weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' }).format(new Date(`${key}T00:00:00Z`));
const timeWords = (d: Date) => new Intl.DateTimeFormat('en-PH', { timeZone: tz, hour: 'numeric', minute: '2-digit' }).format(new Date(d)).toLowerCase();
const yesterday = dayKey(new Date(Date.now() - 864e5));
const label = (key: string) => (key === today ? `Today · ${dayWords(key)}` : key === yesterday ? `Yesterday · ${dayWords(key)}` : key > today ? `Coming up · ${dayWords(key)}` : dayWords(key));

// The lines no visit holds.
const held = new Set(visits.flatMap((v) => v.refs));
const loose = events.filter((e) => !e.ref || !held.has(e.ref)).slice(0, 400);
const shownVisits = visits.slice(0, 300);
const truncated = visits.length > shownVisits.length || events.filter((e) => !e.ref || !held.has(e.ref)).length > loose.length;

const days = new Map<string, { visits: Visit[]; items: TimelineEvent[] }>();
const dayOf = (k: string) => { let g = days.get(k); if (!g) { g = { visits: [], items: [] }; days.set(k, g); } return g; };
for (const v of shownVisits) dayOf(v.day).visits.push(v);
for (const e of loose) dayOf(dayKey(new Date(e.at))).items.push(e);
const ordered = [...days.entries()].sort((a, b) => (a[0] < b[0] ? 1 : -1));

const going = (v: Visit) => v.status !== 'cancelled' && v.status !== 'no_show';
const nProcs = (v: Visit) => v.procs.length + v.adjustments.length;
const counts = { all: shownVisits.length + loose.length, visits: shownVisits.length, other: loose.length };
---

<Pane as="section" label="Timeline" id="timeline">
  <Head icon="history" title="Timeline" meta={shownVisits.length === 1 ? 'One visit' : `${shownVisits.length} visits`} />
  <p class="-mt-2 mb-4 text-[14.5px] text-ink-2">Every visit, newest first. Open a visit to see all of it: the dentist, the signed consent, what was done to which tooth, and what was paid.</p>
  {counts.all === 0 ? <Empty icon="clock" text="Nothing has happened on this record yet." /> : (
    <>
      <div class="tl-filters" role="group" aria-label="Show on the timeline" data-tl-filters>
        <button type="button" class="tl-filter" aria-pressed="true" data-tl-kind="all">Everything <span class="tl-n">{counts.all}</span></button>
        {counts.visits > 0 && <button type="button" class="tl-filter" aria-pressed="false" data-tl-kind="visit">Visits <span class="tl-n">{counts.visits}</span></button>}
        {counts.other > 0 && <button type="button" class="tl-filter" aria-pressed="false" data-tl-kind="other">Between visits <span class="tl-n">{counts.other}</span></button>}
      </div>
      <p class="sr-only" aria-live="polite" data-tl-live></p>
      <div class="mt-5">
        {ordered.map(([key, g]) => (
          <section class="tl-day" data-tl-day aria-label={label(key)}>
            <h3 class="tl-date">{label(key)}</h3>
            <ul class="tl-list">
              {g.visits.map((v) => {
                const signed = v.consents[0];
                const shownProcs = v.procs.slice(0, 3);
                const more = nProcs(v) - shownProcs.length;
                return (
                  <li data-tl-item data-tl-group="visit">
                    <button type="button" class="vx-card" data-ws-open={`rec-visit-${v.key}`} data-status={v.status ?? 'day'} aria-haspopup="dialog">
                      <span class="vx-card-top">
                        <span class="vx-card-icon" aria-hidden="true"><Icon name="calendar" size={20} /></span>
                        <span class="vx-card-title">
                          <span class="vx-card-name">{v.id ? (v.reason || 'Visit') : 'At the clinic'}</span>
                          <span class="vx-card-time">{v.dateOnly ? 'Day only, from old records' : timeWords(v.at)}{v.chair ? ` · chair ${v.chair}` : ''}</span>
                        </span>
                        {v.status ? <Chip status={v.status} /> : <span class="rp">No booking</span>}
                      </span>

                      <span class="vx-card-row">
                        {v.dentist && <Who name={v.dentist} />}
                        {shownProcs.map((d) => <span class="rp rp-hue-blue">{d.name}{d.fdi ? ` · ${d.fdi}${d.surface ? ` ${d.surface}` : ''}` : ''}</span>)}
                        {more > 0 && <span class="rp">+{more} more</span>}
                        {shownProcs.length === 0 && v.teeth.map((t) => <span class="rp rp-tooth"><Glyph name="tooth" size={14} />{t}</span>)}
                      </span>

                      <span class="vx-card-row">
                        {signed ? (
                          <span class="rp rp-ok vx-card-sig"><Icon name="check" size={14} />Consent signed<Signature strokes={signed.strokes} name={signed.signedBy} mini /></span>
                        ) : v.agreed.length ? (
                          <span class="rp rp-ok"><Icon name="check" size={14} />Agreed online</span>
                        ) : v.id && going(v) && !v.future ? (
                          <span class="rp">No signed consent</span>
                        ) : null}
                        {canEdit && !signed && canSign(v, today) && <span class="rp rp-warn"><Glyph name="pen" size={14} />Ready to sign</span>}
                        {money && v.money && v.money.paidCents > 0n && <span class="rp rp-money">Paid {v.money.paid}</span>}
                        {money && v.money && v.money.owedCents > 0n && <span class="rp rp-warn">Owes {v.money.owed}</span>}
                        {money && v.money && v.money.paidCents === 0n && v.money.owedCents === 0n && v.money.chargedCents > 0n && <span class="rp">Charged {v.money.charged}</span>}
                        {v.notes.length > 0 && <span class="rp">{v.notes.length === 1 ? 'Note' : `${v.notes.length} notes`}</span>}
                        {v.rx.length > 0 && <span class="rp">{v.rx.length === 1 ? 'Prescription' : `${v.rx.length} prescriptions`}</span>}
                        {v.files.length > 0 && <span class="rp">{v.files.length === 1 ? '1 file' : `${v.files.length} files`}</span>}
                        {v.vitals[0]?.sys && <span class="rp">BP {v.vitals[0].sys}/{v.vitals[0].dia}</span>}
                      </span>
                      <span class="vx-card-go">See the whole visit <Icon name="chevron-right" size={16} /></span>
                    </button>
                  </li>
                );
              })}
              {g.items.map((e) => (
                <li class="tl-item" data-kind={e.kind} data-tone={e.tone ?? 'neutral'} data-tl-item data-tl-group="other">
                  <span class="tl-icon" aria-hidden="true"><Glyph name={ICON[e.kind]} size={18} /></span>
                  <div class="min-w-0">
                    <p class="tl-title">{e.title}</p>
                    {e.detail && <p class="tl-detail">{e.detail}</p>}
                    {e.by && <p class="tl-by"><Who name={e.by} /></p>}
                  </div>
                  <span class="tl-time rp">{timeWords(new Date(e.at))}</span>
                  {e.section && sections.includes(e.section) && (
                    <button type="button" class="tl-go" data-rec-go={e.section}>Open {OPEN[e.section] ?? e.section}</button>
                  )}
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
      {truncated && <p class="mt-4 text-[13.5px] text-ink-2">The newest are shown.</p>}
    </>
  )}
</Pane>

<script>
  const bar = document.querySelector<HTMLElement>('[data-tl-filters]');
  const live = document.querySelector<HTMLElement>('[data-tl-live]');
  bar?.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>('[data-tl-kind]');
    if (!b) return;
    const kind = b.dataset.tlKind!;
    bar.querySelectorAll('[data-tl-kind]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    let n = 0;
    document.querySelectorAll<HTMLElement>('[data-tl-item]').forEach((it) => { it.hidden = kind !== 'all' && it.dataset.tlGroup !== kind; if (!it.hidden) n++; });
    document.querySelectorAll<HTMLElement>('[data-tl-day]').forEach((d) => { d.hidden = !d.querySelector('[data-tl-item]:not([hidden])'); });
    if (live) live.textContent = `${n} shown`;
  });
</script>
