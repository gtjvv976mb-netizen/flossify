---
// The head of a part of the record, as a paper chart heads its pages: the part's number and name over a rule, and on
// the right what can be added to it (./Plus.astro). No colour, no icon: the number and the name say where you are.
import Plus from './Plus.astro';

export interface Add { label: string; text: string; open?: string; href?: string; go?: string; data?: Record<string, string | undefined> }
interface Props { id: string; label: string; n?: number; class?: string; adds?: Add[] }
const { id, label, n, class: extra, adds = [] } = Astro.props;
---

<header class:list={['pp-head', extra]}>
  <h2 class="pp-title" id={`rec-${id}-title`}>{n !== undefined && <span class="pp-n">{n}</span>}{label}</h2>
  {(adds.length > 0 || Astro.slots.has('default')) && (
    <div class="pp-head-actions">
      {adds.map((a) => <Plus label={a.label} text={a.text} open={a.open} href={a.href} go={a.go} data={a.data} />)}
      <slot />
    </div>
  )}
</header>
