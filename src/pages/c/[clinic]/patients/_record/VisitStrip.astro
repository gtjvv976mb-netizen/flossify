---
// This visit (036): the card at the top of the record while the patient is in today — booked, arrived,
// waiting, in the chair or just done. It is the visit's checklist, in the order a visit runs: before we
// start (the health history checked, blood pressure, the consent signed on the tablet), during (what was
// done to which tooth, the dentist's note), before they leave (the next check-up, the charge). Only what is
// still missing is a line, each with the one thing to press; what is done is one row of pills; nothing
// missing says so. It stands above the sections, so it stays in view whichever one is open.
//
// Every write it starts carries the visit's id in a hidden `visit` field (the panels' forms take a
// visitId), so a reading, a note, a treatment, a prescription or a file taken now names this visit on the
// Treatment record instead of being matched to it by the day later. "No change" (intent health-checked) copies the
// health history under the person who asked, so "last checked" moves to today.
//
// What belongs to the visit: anything stamped with its id, or written today with no visit on it (the
// desk's old habit). The same rule the Treatment record uses (src/lib/visit-record.ts), for today only.
import Pane from '../../../../../components/ws/Pane.astro';
import Icon from '../../../../../components/ws/Icon.astro';
import Chip from '../../../../../components/ws/Chip.astro';
import Csrf from '../../../../../components/Csrf.astro';
import Callout from '../_ui/Callout.astro';
import Glyph from '../_ui/Glyph.astro';
import Who from './Who.astro';
import { answered, dateText, type HealthVersion } from '../../../../../lib/health';
import { bpWords, type Extra } from '../../../../../lib/record-extra';
import type { Clinical } from '../../../../../lib/record';
import type { VisitConsent } from '../../../../../lib/visit-consent';
import { VISIT_STATUS, canSign, type StripVisit } from '../../../../../lib/visit-record';
import { gapWords, OVERRIDE_CONTEXT, type RecordDoc, type ConsentGap } from '../../../../../lib/consent-docs';
import SidePanel from '../../../../../components/ws/SidePanel.astro';
import { fromDb, pesos } from '../../../../../lib/invoices';
import { AFTERCARE, kindForCatalog } from '../../../../../lib/aftercare';

interface Props {
  visit: StripVisit;
  c: Clinical;
  x: Extra;
  signed: VisitConsent[];
  /** The newest health history version on file, or null. */
  health: HealthVersion | null;
  /** The privacy notice: agreed and in force (or none in force), or the words for what is missing. */
  privacy: { ok: boolean; words: string };
  /** Under 18 by the birth date on file: a parent or guardian signs. */
  minor: boolean;
  /** A visit already booked after this one, or null. */
  laterVisitAt: Date | null;
  canEdit: boolean;
  money: boolean;
  today: string;
  firstName: string;
  /** The record's URL: the forms post here. */
  action: string;
  chargeHref: string;
  printBase: string;
  saved: string | null;
  problem: string | null;
  /** The consent forms of this visit (039, Visit.forms): signed ones as done, those not agreed as a line that asks why before going ahead (phase 4.4). */
  forms?: RecordDoc[];
  /** The record's consent pages: /c/<slug>/patients/<id>/consents/. */
  consentsBase?: string;
  /** A Go ahead anyway that was refused: the form's id, so its panel opens again with the sentence (`problem`). */
  aheadDoc?: string | null;
}
const { visit, c, x, signed, health, privacy, minor, laterVisitAt, canEdit, money, today, firstName, action, chargeHref, printBase, saved, problem, forms = [], consentsBase = '', aheadDoc = null } = Astro.props;

const tz = 'Asia/Manila';
const dayOf = (d: Date | string) => new Intl.DateTimeFormat('en-CA', { timeZone: tz, year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date(d));
const time = (d: Date | string) => new Intl.DateTimeFormat('en-PH', { timeZone: tz, hour: 'numeric', minute: '2-digit' }).format(new Date(d)).toLowerCase();
/** Belongs to this visit: stamped with it, or written today with no visit named. */
const ofVisit = (id: string | null, at: Date | string) => id === visit.id || (!id && dayOf(at) === today);

const done = c.done.filter((d) => ofVisit(d.visitId, d.at));
const notes = c.notes.filter((n) => !n.amends && (n.visitId === visit.id || (!n.visitId && n.visitOn === today)));
const rx = c.rx.filter((r) => ofVisit(r.visitId, r.at));
const files = c.files.filter((f) => f.visitId === visit.id || (!f.visitId && (f.takenAt ?? dayOf(f.at)) === today));
const bp = x.vitals.find((v) => v.sys && v.dia && ofVisit(v.visitId, v.at)) ?? null;
const bpW = bp ? bpWords(bp.sys!, bp.dia!) : null;
const consent = signed.find((k) => k.visitId === visit.id) ?? null;
const planOpen = c.plan.filter((i) => i.status === 'planned' || i.status === 'accepted').length;

const asked = !!health && answered(health);
const checkedDay = asked ? dayOf(health!.at) : null;
const stale = !!checkedDay && Date.now() - +new Date(health!.at) > 365 * 864e5;

const started = visit.status === 'in_chair' || visit.status === 'completed';
const finished = visit.status === 'completed';
const s = VISIT_STATUS[visit.status] ?? null;
const meta = [time(visit.startsAt), visit.dentist ?? 'Any dentist', visit.reason, visit.chair ? `Chair ${visit.chair}` : null].filter(Boolean).join(' · ');

type Tone = 'plain' | 'warn' | 'alert';
interface Act { label: string; href?: string; open?: string; show?: string; go?: string; form?: string; amends?: boolean }
interface Line { tone: Tone; words: string; acts: Act[] }
const lines: Line[] = [];
const ok: { words: string; href?: string; go?: string }[] = [];

// Before we start.
if (!asked) lines.push({ tone: 'warn', words: 'Health history: not asked yet', acts: canEdit ? [{ label: 'Ask now', go: 'health' }] : [] });
else if (checkedDay === today) ok.push({ words: 'Health history checked', go: 'health' });
else lines.push({ tone: stale ? 'warn' : 'plain', words: `Health history: last checked ${dateText(checkedDay)}${stale ? ', over a year ago' : ''}`, acts: canEdit ? [{ label: 'No change', form: 'health-checked' }, { label: 'Something changed', go: 'health' }] : [] });
if (bp && bpW) {
  if (bpW.tone === 'neutral') ok.push({ words: `BP ${bp.sys}/${bp.dia} · ${bpW.label.toLowerCase()}`, go: 'health' });
  else lines.push({ tone: bpW.tone === 'alert' ? 'alert' : 'warn', words: `Blood pressure ${bp.sys}/${bp.dia}: ${bpW.label.toLowerCase()}`, acts: canEdit ? [{ label: 'Take again', open: 'rec-vitals-add', show: 'health' }, { label: 'What to do', go: 'health' }] : [{ label: 'What to do', go: 'health' }] });
} else if (!finished) lines.push({ tone: 'plain', words: 'Blood pressure: not taken', acts: canEdit ? [{ label: 'Take it', open: 'rec-vitals-add', show: 'health' }] : [] });
// Signing on the tablet is for a visit today or later (canSign, the same rule as the signing page): a visit done today
// can still be signed while the patient is at the desk; a visit of an earlier day can only be said to be unsigned.
const signable = canEdit && canSign({ id: visit.id, status: visit.status, day: dayOf(visit.startsAt) }, today);
if (consent) ok.push({ words: `Consent signed by ${consent.signedBy}, ${time(consent.at)}`, go: 'consent' });
else lines.push({ tone: 'warn', words: `Consent to treatment: not signed${minor && signable ? ' (a parent or guardian signs)' : finished ? ' at this visit' : ''}`, acts: signable ? [{ label: 'Sign on this tablet', href: `${action}sign/${visit.id}/` }] : [{ label: 'Consent', go: 'consent' }] });
if (!privacy.ok) lines.push({ tone: 'warn', words: privacy.words, acts: canEdit ? [{ label: 'Record it', go: 'consent' }] : [] });
// The consent forms prepared from this visit (039): agreed ones are done; one not agreed is a line — Sign, or, with a reason,
// go ahead anyway (consent_override, context strip; the same rule as consentGaps: "No photos" is a decision, not a gap). A form
// already gone ahead without today is done, in words that say so.
const gaps: ConsentGap[] = forms
  .filter((d) => d.appointmentId === visit.id && d.state !== 'agreed' && d.state !== 'no_photos' && d.state !== 'cancelled')
  .map((d) => ({ docId: d.id, title: d.title, state: d.state, explained: !!d.attestation || !d.template?.attest }));
for (const d of forms) {
  if (d.appointmentId !== visit.id) continue;
  if (d.state === 'agreed') ok.push({ words: `${d.title}: signed${d.latest ? ` by ${d.latest.signedByName}` : ''}`, go: 'consent' });
  for (const o of d.overrides) {
    if (dayOf(o.at) !== today) continue;
    ok.push({ words: `${d.title}: went ahead anyway (${OVERRIDE_CONTEXT[o.context]}), ${o.staffName}, ${time(o.at)}`, go: 'consent' });
  }
}
for (const g of gaps) {
  const d = forms.find((f) => f.id === g.docId)!;
  const ahead = d.overrides.some((o) => dayOf(o.at) === today);
  if (ahead) continue;
  const acts: Act[] = [{ label: 'Open the form', href: `${consentsBase}${g.docId}/` }];
  if (canEdit && !finished) acts.push({ label: 'Go ahead anyway', open: `rec-ahead-${g.docId}` });
  lines.push({ tone: 'warn', words: `Consent form · ${gapWords(g)}`, acts });
}

// During the visit.
for (const d of done) ok.push({ words: `${d.name}${d.fdi ? ` · ${d.fdi}${d.surface ? ` ${d.surface}` : ''}` : ''}`, go: 'treatment' });
if (started && !done.length) lines.push({ tone: 'plain', words: `Treatment done: nothing recorded yet${planOpen ? ` · ${planOpen} on the plan` : ''}`, acts: canEdit ? [{ label: 'Record it', open: 'rec-done-add', show: 'treatment' }, ...(planOpen ? [{ label: 'The plan', go: 'treatment' }] : [])] : [] });
if (notes.length) ok.push({ words: `Note by ${notes[0].dentist ?? notes[0].by ?? 'the dentist'}, ${time(notes[0].at)}`, go: 'notes' });
else if (started) lines.push({ tone: 'plain', words: 'Clinical note: none yet', acts: canEdit ? [{ label: 'Write it', open: 'rec-note-add', show: 'notes', amends: true }] : [] });
for (const r of rx) ok.push({ words: `Prescription · Print`, href: `${printBase}${r.id}/` });
// The aftercare sheet for what was done (src/lib/aftercare.ts): printed for the patient to take home.
const sheet = done.map((d) => kindForCatalog(d.code, d.name, d.category)).find((k) => k) ?? null;
if (sheet) ok.push({ words: `Aftercare sheet: ${AFTERCARE[sheet].title} · Print`, href: `${action}aftercare/${sheet}/?visit=${visit.id}` });
if (files.length) ok.push({ words: files.length === 1 ? 'One file' : `${files.length} files`, go: 'files' });

// Before they leave.
if (finished || visit.status === 'in_chair') {
  if (laterVisitAt) ok.push({ words: `Next visit ${dateText(dayOf(laterVisitAt))}`, go: 'visits' });
  else if (c.recall) ok.push({ words: `Next check-up ${dateText(c.recall.dueOn)}`, href: '#recall' });
  else lines.push({ tone: finished ? 'warn' : 'plain', words: 'Next check-up: not set', acts: canEdit ? [{ label: 'Set it', href: '#recall' }] : [] });
}
if (finished && money) {
  if (visit.charged) ok.push({ words: `Charged ${pesos(fromDb(visit.charged))}`, go: 'money' });
  else lines.push({ tone: 'warn', words: 'Not charged yet', acts: [{ label: 'Charge this visit', href: chargeHref }] });
}

const SAVED: Record<string, string> = { checked: `Health history checked with ${firstName}: no change.`, 'checked-today': 'The health history was already checked today.', 'consent-ahead': 'Recorded: the visit goes ahead without that consent form, and why. It stays with the form.' };
const TONE_ICON: Record<Tone, 'info' | 'alert'> = { plain: 'info', warn: 'alert', alert: 'alert' };
---

<Pane as="section" title="This visit" icon="calendar" meta={meta} id="this-visit" class="vs hue-teal">
  <div slot="actions" class="vs-status">{s && <Chip status={visit.status} />}</div>
  {saved && SAVED[saved] && <Callout tone="success" class="mb-3" text={SAVED[saved]} />}
  {problem && <Callout tone="alert" class="mb-3" text={problem} />}
  {lines.length > 0 ? (
    <ul class="vs-list" aria-label="Still to do at this visit">
      {lines.map((l) => (
        <li class="vs-line" data-tone={l.tone}>
          <Icon name={TONE_ICON[l.tone]} size={18} />
          <span class="vs-words">{l.words}</span>
          {l.acts.length > 0 && (
            <div class="vs-acts">
              {l.acts.map((a) =>
                a.form ? (
                  <form method="post" action={action}><Csrf /><input type="hidden" name="intent" value={a.form} /><input type="hidden" name="visit" value={visit.id} /><button class="ws-btn ws-btn-quiet ws-btn-sm"><Icon name="check" />{a.label}</button></form>
                ) : a.href ? (
                  <a href={a.href} class="ws-btn ws-btn-quiet ws-btn-sm">{a.label}</a>
                ) : a.open ? (
                  <button type="button" class="ws-btn ws-btn-quiet ws-btn-sm" data-ws-open={a.open} data-amends={a.amends ? '' : undefined}>{a.label}</button>
                ) : (
                  <button type="button" class="ws-btn ws-btn-quiet ws-btn-sm" data-rec-go={a.go}>{a.label}</button>
                ))}
            </div>
          )}
        </li>
      ))}
    </ul>
  ) : (
    <p class="vs-all"><Icon name="check" size={18} />{finished ? 'All done for this visit.' : started ? 'Nothing missing so far.' : `Ready to start: nothing missing for ${firstName}.`}</p>
  )}
  <div class="vs-foot">
  {ok.length > 0 && (
    <p class="vs-done">
      <span class="rk">Done</span>
      {ok.map((o) => o.href ? <a href={o.href} class="rec-chip-go vs-go" target={o.href.startsWith('#') ? undefined : '_blank'} rel={o.href.startsWith('#') ? undefined : 'noopener'}><span class="rp rp-ok"><Icon name="check" size={14} />{o.words}</span></a>
        : <button type="button" class="rec-chip-go vs-go" data-rec-go={o.go}><span class="rp rp-ok"><Icon name="check" size={14} />{o.words}</span></button>)}
    </p>
  )}
  {canEdit && (
    <p class="vs-also">
      <span>Also:</span>
      <button type="button" class="ws-btn ws-btn-quiet ws-btn-sm" data-ws-open="rec-rx-add"><Glyph name="pill" size={16} />Prescription</button>
      <button type="button" class="ws-btn ws-btn-quiet ws-btn-sm" data-ws-open="rec-file-add"><Glyph name="image" size={16} />X-ray or photo</button>
      <button type="button" class="ws-btn ws-btn-quiet ws-btn-sm" data-rec-go="chart"><Glyph name="tooth" size={16} />Chart</button>
      {visit.dentist && <Who name={visit.dentist} class="vs-who" />}
    </p>
  )}
  </div>
</Pane>

{/* Going ahead without a consent form (phase 4.4): never blocked, the reason kept against the form (overrideConsent). */}
{canEdit && !finished && gaps.map((g) => (
  <SidePanel id={`rec-ahead-${g.docId}`} title="Go ahead without this consent?" meta={g.title} open={aheadDoc === g.docId}>
    <form method="post" action={action} class="grid gap-4">
      {aheadDoc === g.docId && problem && <Callout tone="alert" text={problem} />}
      <Csrf /><input type="hidden" name="intent" value="consent-override" /><input type="hidden" name="document" value={g.docId} /><input type="hidden" name="visit" value={visit.id} />
      <p class="text-[15px] text-ink-2">{gapWords(g)}. The visit is never blocked; say why it goes ahead, and that is kept with the form for anyone who reads it later.</p>
      <label class="field"><span class="meta">Why</span><input name="reason" maxlength="200" autocomplete="off" required placeholder="e.g. emergency: pain relief only, consent to follow" /></label>
      <div class="flex flex-wrap gap-2"><button type="submit" class="ws-btn ws-btn-primary">Go ahead anyway</button><button type="button" class="ws-btn ws-btn-quiet" data-ws-close>Not now</button></div>
    </form>
  </SidePanel>
))}
