---
// This visit (036): Today's first card while the patient is in today — booked, arrived, waiting, in the chair or just
// done. It is the visit's checklist, in the order a visit runs (./today.ts works the lines out; the page counts them on
// the Today tab): each line what is still missing, in words, with its own buttons, the first button of the first line
// the screen's one teal button (the next step); what is done is one line of ticked words, where only a prescription
// and the aftercare sheet stay links (Print); nothing missing says so. Once the patient is seated, "Also" offers a
// prescription and an X-ray or photo. The panels it opens (a reading, a treatment, a note, a prescription, a file, a
// letter, the next check-up) open over Today and save back to it.
//
// Every write it starts carries the visit's id in a hidden `visit` field (the panels' forms take a visitId), so a
// reading, a note, a treatment, a prescription or a file taken now names this visit on the Treatment record instead of
// being matched to it by the day later. "No change" (intent health-checked) copies the health history under the
// person who asked, so "last checked" moves to today.
//
// What belongs to the visit: anything stamped with its id, or written today with no visit on it (the desk's old
// habit). The same rule the Treatment record uses (src/lib/visit-record.ts), for today only.
import Pane from '../../../../../components/ws/Pane.astro';
import Icon from '../../../../../components/ws/Icon.astro';
import Chip from '../../../../../components/ws/Chip.astro';
import Csrf from '../../../../../components/Csrf.astro';
import Callout from '../_ui/Callout.astro';
import Glyph from '../_ui/Glyph.astro';
import { VISIT_STATUS, type StripVisit } from '../../../../../lib/visit-record';
import { timeOf, type VisitPlan, type LineTone } from './today';
import { shortName } from '../../../../../lib/schedule';

interface Props {
  visit: StripVisit;
  /** The lines and what is done (thisVisitPlan in ./today.ts). */
  plan: VisitPlan;
  canEdit: boolean;
  firstName: string;
  /** The record's URL: the forms post here. */
  action: string;
  saved: string | null;
  problem: string | null;
  /** What the patient wrote on their forms for this visit (under 30 days old), or null. */
  wrote?: { words: string; href: string } | null;
}
const { visit, plan, canEdit, firstName, action, saved, problem, wrote = null } = Astro.props;
const { lines, done, started, finished } = plan;
const s = VISIT_STATUS[visit.status] ?? null;
const meta = [timeOf(visit.startsAt), visit.reason, visit.chair ? `Chair ${visit.chair}` : null, visit.dentist ? shortName(visit.dentist) : 'Any dentist'].filter(Boolean).join(' · ');

const SAVED: Record<string, string> = { checked: `Health history checked with ${firstName}: no change.`, 'checked-today': 'The health history was already checked today.' };
const TONE_ICON: Record<LineTone, 'info' | 'alert'> = { plain: 'info', warn: 'alert', alert: 'alert' };
/** The next step: the first button of the first line that has one. */
const next = lines.findIndex((l) => l.acts.length > 0);
const btn = (li: number, ai: number) => `ws-btn ${li === next && ai === 0 ? 'ws-btn-primary' : 'ws-btn-quiet'} ws-btn-sm`;
---

<Pane as="section" title="This visit" icon="calendar" meta={meta} id="this-visit" class="vs hue-teal">
  <div slot="actions" class="vs-status">{s && <Chip status={visit.status} />}</div>
  {saved && SAVED[saved] && <Callout tone="success" class="mb-3" text={SAVED[saved]} />}
  {problem && <Callout tone="alert" class="mb-3" text={problem} />}
  {wrote && <p class="vs-wrote"><Icon name="note" size={16} /><span class="min-w-0"><span class="vs-wrote-k">The patient wrote:</span> {wrote.words} <a href={wrote.href} class="vs-wrote-a">All answers</a></span></p>}
  {lines.length > 0 ? (
    <ul class="vs-list" aria-label="Still to do at this visit">
      {lines.map((l, li) => (
        <li class="vs-line" data-tone={l.tone}>
          <Icon name={TONE_ICON[l.tone]} size={18} />
          <span class="vs-words">{l.words}</span>
          {l.acts.length > 0 && (
            <div class="vs-acts" data-n={l.acts.length}>
              {l.acts.map((a, ai) =>
                a.form ? (
                  <form method="post" action={action}><Csrf /><input type="hidden" name="intent" value={a.form} /><input type="hidden" name="visit" value={visit.id} /><button class={btn(li, ai)}>{a.icon && <Icon name={a.icon} />}{a.label}</button></form>
                ) : a.href ? (
                  <a href={a.href} class={btn(li, ai)}>{a.icon && <Icon name={a.icon} />}{a.label}</a>
                ) : a.open ? (
                  <button type="button" class={btn(li, ai)} data-ws-open={a.open} {...(a.data ?? {})}>{a.label}</button>
                ) : (
                  <button type="button" class={btn(li, ai)} data-rec-go={a.go}>{a.label}</button>
                ))}
            </div>
          )}
        </li>
      ))}
    </ul>
  ) : (
    <p class="vs-all"><Icon name="check" size={18} />{finished ? 'All done for this visit.' : started ? 'Nothing missing so far.' : `Ready to start: nothing missing for ${firstName}.`}</p>
  )}
  {done.length > 0 && (
    <p class="vs-done">
      <Icon name="check" size={16} />
      <span class="min-w-0"><span class="vs-done-k">Done:</span>{' '}
        {done.map((o, i) => <>{i > 0 && ' · '}{o.href ? <a href={o.href} target="_blank" rel="noopener" class="vs-done-a">{o.words}</a> : o.words}</>)}
      </span>
    </p>
  )}
  {canEdit && started && (
    <p class="vs-also">
      <span>Also:</span>
      <button type="button" class="ws-btn ws-btn-quiet ws-btn-sm" data-ws-open="rec-rx-add"><Glyph name="pill" size={16} />Prescription</button>
      <button type="button" class="ws-btn ws-btn-quiet ws-btn-sm" data-ws-open="rec-file-add"><Glyph name="image" size={16} />X-ray or photo</button>
    </p>
  )}
</Pane>
