---
// The branch's texts: what left, what came back, and what is still waiting on
// the sender. Both directions, newest first, the last hundred. Reached from
// the top bar's inbox (the Dashboard tab stays on). Every query runs inside
// withClinic(): row-level security keeps it to this branch.
//
// In the soft, very simple template (docs/workspace-redesign.md): the title
// is the shell's (heading), one small row of pills (All · Failed · Replies)
// and the one main action, Text a patient; each text is one friendly row —
// who (a round avatar), the words, when, a status pill — with its one action
// beside it. No codes on screen: the chart no. is left out (the name links to
// the record).
//
// ?show=failed — texts that failed in the last 7 days (the inbox's count),
// sign-in codes left out;
// ?show=replies — texts patients sent in. Opening the list with the replies
// in it (all, or replies) marks them seen for this browser: the inbox counts
// replies after that moment (fl_replies_seen, src/components/ws/inbox.ts).
//
// Three posts, each a form with the CSRF token: text a patient (in a side
// panel, so the list stays in view; a refused text comes back in the panel
// with its reason and the draft), send a failed text again, and cancel one
// that has not left yet. A post without a matching token changes nothing and
// comes back here with ?stale=1, which shows the sentence to try again.
//
// Text a patient is for anyone with a reason to hear from the clinic, each
// row saying why (RECIPIENTS): on the book within a week either way, seen in
// the last 30 days, a check-up due within 60 days, lab work back in the last
// 30 days, or a balance (only to someone who may see amounts). ?to=<patient>
// — the record's Text link — adds any active patient with a mobile. The
// server checks the same set before queueing, and refuses anyone without
// messages.send (the button is hidden for them). The templates
// (src/lib/text-templates.ts) fill the box from the chosen row's facts in the
// browser; with scripts off they are listed under the box to copy by hand.
//
// A sign-in code is for the phone it was texted to, never for a page: the
// body of every reset and invite row is blanked in the query itself, so it
// never reaches this page (CLAUDE.md, Backend). Nor is a failed code sent
// again from here: it expires (15 minutes; an invitation, a day) and asking
// again voids it, so the row says where a new one comes from instead, and
// the post refuses it too.
//
// No links in a text. Philippine telcos drop messages with a URL in them, so
// the desk's free text is refused when it looks like one, with the reason.
export const prerender = false;

import ClinicLayout from '../../../../layouts/Clinic.astro';
import Csrf from '../../../../components/Csrf.astro';
import Pane from '../../../../components/ws/Pane.astro';
import Tabs from '../../../../components/ws/Tabs.astro';
import Chip from '../../../../components/ws/Chip.astro';
import Empty from '../../../../components/ws/Empty.astro';
import SidePanel from '../../../../components/ws/SidePanel.astro';
import Icon from '../../../../components/ws/Icon.astro';
import Avatar from '../../../../components/ws/Avatar.astro';
import type { Tone } from '../../../../components/ws/status';
import { SEEN_COOKIE, WINDOW_DAYS } from '../../../../components/ws/inbox';
import { requireWorkspace } from '../../../../lib/workspace';
import { withClinic } from '../../../../lib/db';
import { csrfOk, CSRF_MESSAGE } from '../../../../lib/csrf';
import { queueText, prettyPhone } from '../../../../lib/messages';
import { can } from '../../../../lib/can';
import { shortName } from '../../../../lib/schedule';
import { TEXT_TEMPLATES, phpAmount } from '../../../../lib/text-templates';

const ws = await requireWorkspace(Astro);
if (ws instanceof Response) return ws;
const { clinic, session, branches } = ws;

const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
const LINK = /http|www\.|\.ph\b|\.com\b/i;
const BODY_MAX = 300;
const CODES = `coalesce(m.kind, '') not in ('reset', 'invite')`;
const canSetUp = can(ws, 'people.manage');
// The page hides Text a patient from someone without the key; the send post refuses them itself.
const canSend = can(ws, 'messages.send');
const canMoney = can(ws, 'finance.money');
const NO_SEND = 'Only members whose role may text patients can send one; ask the owner or an admin.';

const SHOWS = {
  all: { label: 'All', where: 'true' },
  failed: { label: 'Failed', where: `m.direction = 'out' and m.status = 'failed' and ${CODES} and m.created_at > now() - make_interval(days => ${WINDOW_DAYS})` },
  replies: { label: 'Replies', where: `m.direction = 'in'` },
} as const;
type Show = keyof typeof SHOWS;
const showParam = Astro.url.searchParams.get('show') ?? 'all';
const show: Show = Object.hasOwn(SHOWS, showParam) ? (showParam as Show) : 'all';
const here = Astro.url.pathname;
const back = show === 'all' ? here : `${here}?show=${show}`;
const withQ = (q: string) => `${back}${back.includes('?') ? '&' : '?'}${q}`;

const error = Astro.url.searchParams.get('stale') === '1' ? CSRF_MESSAGE : '';
// A refused text: said inside the panel, which comes back open with the draft.
let sendError = '';
const done = Astro.url.searchParams.get('done') || '';
const missed = Astro.url.searchParams.get('missed') ?? '';
// What they typed, kept on the form when the post is refused.
let draft = { patient: '', body: '' };

// The record's "Text <name>" link: ?to=<patient id> puts that patient in the list whatever the
// reason (any active patient of the branch with a mobile). A send carries it as a hidden field.
const toParam = Astro.url.searchParams.get('to') ?? '';
let to = UUID.test(toParam) ? toParam : '';

// Who can be texted: anyone with a reason to hear from the clinic, with a mobile on file, each row
// carrying the facts the templates say (the visit's time, day and dentist; the balance). $1 is the
// ?to= patient (or null), $2 whether the caller may see amounts: the balance is read only then.
// The number is the booker's when the visit is for someone else, as the reminder does. A patient
// with several reasons is one row; reasonOf() below picks the first for the list.
const RECIPIENTS = `
  with today as (select (now() at time zone 'Asia/Manila')::date as d),
  visit as (
    -- The visit the text is about: the nearest one ahead, else the latest one behind, within a week.
    -- A missed visit (no_show) counts: "we missed you today" is for them.
    select distinct on (a.patient_id) a.patient_id, a.starts_at, a.status,
           nullif(a.booked_by_phone, '') as booker_phone, s.full_name as dentist
    from appointment a left join staff s on s.id = a.dentist_id
    where a.status not in ('cancelled', 'completed')
      and a.starts_at between now() - interval '7 days' and now() + interval '7 days'
    order by a.patient_id, (a.starts_at < now()), abs(extract(epoch from a.starts_at - now()))
  ),
  seen as (
    select a.patient_id, max(a.starts_at) as seen_at from appointment a
    where a.status = 'completed' and a.starts_at > now() - interval '30 days' group by a.patient_id
  ),
  due as (
    select r.patient_id, min(r.due_on) as due_on from recall r, today
    where r.completed_at is null and r.due_on <= today.d + 60 group by r.patient_id
  ),
  lab as (
    select l.patient_id, max(coalesce(l.received_on, today.d)) as back_on from lab_order l, today
    where l.status = 'received' and coalesce(l.received_on, today.d) >= today.d - 30 group by l.patient_id
  ),
  owes as (
    -- Only a patient with a statement still open can owe, so only they go through the balance function.
    select i.patient_id, patient_balance(i.patient_id) as balance
    from (select distinct patient_id from invoice where status in ('issued', 'partly_paid')) i
  )
  select p.id, p.first_name, p.last_name, coalesce(v.booker_phone, p.phone) as phone,
         v.starts_at, v.status as visit_status, v.dentist, s.seen_at,
         d.due_on::text as due_on, l.back_on::text as back_on,
         case when $2::boolean then o.balance end as balance
  from patient p
  left join visit v on v.patient_id = p.id
  left join seen s on s.patient_id = p.id
  left join due d on d.patient_id = p.id
  left join lab l on l.patient_id = p.id
  left join owes o on o.patient_id = p.id and o.balance > 0
  where p.archived_at is null and coalesce(v.booker_phone, p.phone) is not null
    and (v.patient_id is not null or s.patient_id is not null or d.patient_id is not null or l.patient_id is not null
         or ($2::boolean and o.patient_id is not null) or p.id = $1::uuid)`;

if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  if (!csrfOk(Astro.cookies, f)) return Astro.redirect(withQ('stale=1'), 303);
  const act = String(f.get('act') ?? '');

  if (act === 'retry' || act === 'cancel') {
    const id = String(f.get('id') ?? '');
    if (UUID.test(id)) {
      const changed = await withClinic(clinic.id, async (tx): Promise<number | 'code'> => {
        const r = act === 'retry'
          ? await tx.query(`update message_log m set status = 'queued', next_attempt_at = now(), failed_reason = null
                             where m.id = $1 and m.status = 'failed' and m.direction = 'out' and ${CODES}`, [id])
          : await tx.query(`update message_log set status = 'cancelled' where id = $1 and status = 'queued' and direction = 'out'`, [id]);
        if (r.rowCount) {
          await tx.query(`insert into audit_log (clinic_id, staff_id, action, entity, entity_id) values ($1, $2, $3, 'message_log', $4)`,
            [clinic.id, session.staffId, act === 'retry' ? 'message.retry' : 'message.cancel', id]);
        }
        // A sign-in code is never sent again (the page offers no button for one); say so, not "nothing to send".
        if (!r.rowCount && act === 'retry'
          && (await tx.query(`select 1 from message_log m where m.id = $1 and not (${CODES})`, [id])).rowCount) return 'code';
        return r.rowCount ?? 0;
      });
      // Only say it happened when it did: the row may have moved on since the page was drawn.
      return Astro.redirect(withQ(changed === 'code' ? 'missed=code' : `${changed ? 'done' : 'missed'}=${act}`), 303);
    }
    return Astro.redirect(back, 303);
  }

  if (act === 'send') {
    const patient = String(f.get('patient') ?? '');
    const body = String(f.get('body') ?? '').replace(/\s+/g, ' ').trim();
    const toField = String(f.get('to') ?? '');
    to = UUID.test(toField) ? toField : '';
    draft = { patient, body };
    // The button is hidden from them; a post made anyway is refused here, whatever it carries.
    if (!canSend) return Astro.redirect(withQ('missed=send'), 303);
    if (!UUID.test(patient)) sendError = 'Pick who the text is for.';
    else if (!body) sendError = 'Write the text first.';
    else if (body.length > BODY_MAX) sendError = `Keep it under ${BODY_MAX} characters; that is about two texts.`;
    else if (LINK.test(body)) sendError = 'Take the link out. Philippine telcos drop texts that contain one, so it would never arrive. Say it in words instead.';
    else {
      const outcome = await withClinic(clinic.id, async (tx) => {
        // The same set the list was drawn from, read again now: a reason may have gone since.
        const p = (await tx.query(`select * from (${RECIPIENTS}) r where r.id = $3`, [to || null, canMoney, patient])).rows[0];
        if (!p) return 'That patient is not in the list. Pick one from it, or text them from their record.';
        let id: string | null;
        try {
          id = await queueText(tx, { clinicId: clinic.id, to: p.phone, body: `${clinic.name}: ${body}`, kind: 'manual', patientId: p.id });
        } catch {
          return `${prettyPhone(p.phone)} is not a mobile number, so a text cannot reach it. Check the number on their record.`;
        }
        await tx.query(`insert into audit_log (clinic_id, staff_id, action, entity, entity_id) values ($1, $2, 'message.manual', 'message_log', $3)`,
          [clinic.id, session.staffId, id]);
        return null;
      });
      if (outcome) sendError = outcome;
      else return Astro.redirect(withQ('done=sent'), 303);
    }
  }
}

const { area, clinicPhone, texts, recipients, failedCount } = await withClinic(clinic.id, async (tx) => ({
  area: (await tx.query('select area from clinic where id = $1', [clinic.id])).rows[0]?.area,
  // The number the templates tell the patient to call.
  clinicPhone: ((await tx.query('select phone from clinic where id = $1', [clinic.id])).rows[0]?.phone ?? null) as string | null,
  texts: (await tx.query(
    `select m.id, m.direction, m.kind, m.status, m.to_address,
            -- A live sign-in code is for the phone it was texted to, never for the page.
            case when m.kind in ('reset', 'invite') then null else m.body end as body,
            m.failed_reason, m.sent_at, m.created_at,
            p.id as patient_id, p.first_name, p.last_name, p.chart_no, s.full_name as staff_name
     from message_log m
     left join patient p on p.id = m.patient_id
     left join staff s on s.id = m.staff_id
     where m.channel = 'sms' and ${SHOWS[show].where}
     order by m.created_at desc limit 100`)).rows,
  recipients: canSend ? (await tx.query(RECIPIENTS, [to || null, canMoney])).rows : [],
  failedCount: (await tx.query(
    `select count(*)::int as n from message_log m where m.channel = 'sms' and ${SHOWS.failed.where}`)).rows[0].n as number,
}));

// The replies are on screen: the inbox stops counting them for this browser.
if (Astro.request.method === 'GET' && show !== 'failed') {
  Astro.cookies.set(SEEN_COOKIE, String(Date.now()), {
    path: `/c/${clinic.slug}/`, httpOnly: true, sameSite: 'lax', secure: import.meta.env.PROD, maxAge: 60 * 60 * 24 * 30,
  });
}

const KIND: Record<string, string> = {
  confirmation: 'Booking confirmation', reminder: 'Reminder', reset: 'Sign-in code', invite: 'Invitation', reply: 'Reply', manual: 'Note', recall: 'Check-up due', aftercare: 'Aftercare',
};

// "Thu 24 Sep, 9:12 am", composed from parts: the locale strings put the comma and the case elsewhere.
const parts = (d: Date, opts: Intl.DateTimeFormatOptions) =>
  Object.fromEntries(new Intl.DateTimeFormat('en-US', { ...opts, timeZone: 'Asia/Manila' }).formatToParts(d).map((p) => [p.type, p.value]));
const time = (d: Date) => { const p = parts(d, { hour: 'numeric', minute: '2-digit' }); return `${p.hour}:${p.minute} ${p.dayPeriod.toLowerCase()}`; };
const when = (d: Date) => { const p = parts(d, { weekday: 'short', day: 'numeric', month: 'short' }); return `${p.weekday} ${p.day} ${p.month}, ${time(d)}`; };

// failed_reason is written for the sender's log: the provider's own answer (its JSON, a network
// error, an HTTP status). The desk gets what it can act on — a number to correct, or a text to
// send again — and the raw reason stays in the database and the worker's log for Flossify.
function failedWords(reason: string | null): string {
  if (reason?.startsWith('Not a Philippine mobile number')) return 'Not a Philippine mobile number. Correct it on their record.';
  return 'The text service did not take it. Send it again; if it fails again, tell Flossify.';
}
const isCode = (m: { kind: string | null }) => m.kind === 'reset' || m.kind === 'invite';
const CODE_WHY = 'A code expires, so it is not sent again. A new one: “Forgot your password?” on the sign-in page, or Clinic settings → Team.';

// Status is never colour alone: every chip is a word, and a failure says why in a sentence.
function statusOf(m: (typeof texts)[number]): { label: string; tone: Tone; why?: string } {
  if (m.direction === 'in') return { label: 'Received', tone: 'accent' };
  switch (m.status) {
    case 'queued': return { label: 'Waiting to send', tone: 'neutral' };
    case 'sending': return { label: 'Sending', tone: 'neutral' };
    case 'sent': return { label: `Sent ${m.sent_at ? time(m.sent_at) : ''}`.trim(), tone: 'muted' };
    case 'delivered': return { label: 'Delivered', tone: 'accent' };
    case 'failed': return { label: 'Failed', tone: 'alert', why: isCode(m) ? CODE_WHY : failedWords(m.failed_reason) };
    case 'cancelled': return { label: 'Cancelled', tone: 'muted' };
    default: return { label: m.status, tone: 'neutral' };
  }
}

const manilaDay = (d: Date) => { const p = parts(d, { year: 'numeric', month: '2-digit', day: '2-digit' }); return `${p.year}-${p.month}-${p.day}`; };
const isToday = (d: Date) => manilaDay(d) === manilaDay(new Date());
const isTomorrow = (d: Date) => manilaDay(d) === manilaDay(new Date(Date.now() + 86_400_000));
const dayOf = (d: Date) => { const p = parts(d, { weekday: 'short', day: 'numeric', month: 'short' }); return `${p.weekday} ${p.day} ${p.month}`; };
// A date column comes back as text ("2026-10-15"); noon Manila keeps it on that day whatever the server's clock says.
const dateAt = (iso: string) => new Date(`${iso}T12:00:00+08:00`);
const dayWords = (d: Date) => (isToday(d) ? 'today' : isTomorrow(d) ? 'tomorrow' : dayOf(d));

// Each row's reason, in the order the list groups them: a patient with several is listed once,
// under the first. `soon` puts today's and tomorrow's at the top of their group.
const GROUPS = {
  chosen: 'From the record', book: 'On the book', seen: 'Seen recently', due: 'Due for a check-up', lab: 'Lab work back', owes: 'Owes',
} as const;
type Group = keyof typeof GROUPS;
type Recipient = (typeof recipients)[number];
const todayIso = manilaDay(new Date());
function reasonOf(r: Recipient): { group: Group; why: string; soon: boolean } {
  if (r.starts_at) {
    const soon = isToday(r.starts_at) || isTomorrow(r.starts_at);
    return { group: 'book', soon, why: r.visit_status === 'no_show' ? `missed ${dayWords(r.starts_at)}` : `${dayWords(r.starts_at)} ${time(r.starts_at)}` };
  }
  if (r.seen_at) return { group: 'seen', why: `seen ${dayWords(r.seen_at)}`, soon: isToday(r.seen_at) };
  if (r.due_on) return { group: 'due', why: `check-up ${r.due_on < todayIso ? 'was due' : 'due'} ${dayOf(dateAt(r.due_on))}`, soon: false };
  if (r.back_on) return { group: 'lab', why: `lab work back ${dayOf(dateAt(r.back_on))}`, soon: false };
  if (r.balance != null && Number(r.balance) > 0) return { group: 'owes', why: `owes ${phpAmount(r.balance)}`, soon: false };
  return { group: 'chosen', why: 'from the record', soon: false };
}
const byName = (a: Recipient, b: Recipient) => a.last_name.localeCompare(b.last_name) || a.first_name.localeCompare(b.first_name);
const reasoned = recipients.map((r) => ({ r, ...reasonOf(r) }));
const grouped = (Object.keys(GROUPS) as Group[])
  .map((g) => ({ label: GROUPS[g], rows: reasoned.filter((x) => x.group === g).sort((a, b) => Number(b.soon) - Number(a.soon) || byName(a.r, b.r)) }))
  .filter((g) => g.rows.length > 0);
// The option picked: the draft's after a refused post, else the record's patient.
const chosen = draft.patient || to;
const toMissing = Boolean(to) && !recipients.some((r) => r.id === to);
const clinicPhoneWords = clinicPhone ? prettyPhone(clinicPhone) : '';
// The facts a template fills in, on the option so the page's script can read them for the chosen patient.
const facts = (r: Recipient) => ({
  'data-first': r.first_name,
  'data-time': r.starts_at ? time(r.starts_at) : undefined,
  'data-day': r.starts_at ? dayOf(r.starts_at) : undefined,
  'data-dentist': r.dentist ? shortName(r.dentist) : undefined,
  'data-amount': r.balance != null && Number(r.balance) > 0 ? phpAmount(r.balance) : undefined,
  'data-visit': r.starts_at ? '1' : undefined,
  'data-lab': r.back_on ? '1' : undefined,
  'data-balance': r.balance != null && Number(r.balance) > 0 ? '1' : undefined,
});
const notice = done === 'sent' ? 'Queued. It leaves with the next pass of the sender.'
  : done === 'retry' ? 'Queued again. It leaves with the next pass of the sender.'
  : done === 'cancel' ? 'Cancelled. It will not be sent.'
  : missed === 'cancel' ? 'That text had already left the sender, so it could not be cancelled. Check its status in the list.'
  : missed === 'retry' ? 'That text is no longer marked failed, so there was nothing to send again.'
  : missed === 'code' ? CODE_WHY
  : missed === 'send' ? NO_SEND : '';

const listed = texts.length === 100 ? 'The last 100' : `${texts.length} ${texts.length === 1 ? 'text' : 'texts'}`;
const noticeTone = done ? 'success' : 'info';
const logTitle = show === 'failed' ? `Failed in the last ${WINDOW_DAYS} days` : show === 'replies' ? 'Replies from patients' : 'Sent and received';
const emptyText = show === 'failed' ? `No text has failed in the last ${WINDOW_DAYS} days.`
  : show === 'replies' ? 'No replies yet. A patient’s text back shows here.'
  : 'No texts yet. The first booking confirmation will show here.';
---
<ClinicLayout groupId={clinic.group_id} clinic={{ slug: clinic.slug, name: clinic.name, area }} title="Messages" section="messages" staff={{ name: session.name, role: session.role }} branches={branches} layout="panes" heading>
  <Pane as="div" label="Messages" pad="tight" class="msg-bar">
    <div class="msg-bar-row">
      <Tabs label="Show" current={show} items={[
        { id: 'all', label: 'All', href: here },
        { id: 'failed', label: 'Failed', href: `${here}?show=failed`, count: failedCount },
        { id: 'replies', label: 'Replies', href: `${here}?show=replies` },
      ]} />
      {canSend && <button type="button" class="ws-btn ws-btn-primary" data-ws-open="send"><Icon name="message" />Text a patient</button>}
    </div>
    <p class="msg-lede">Texts go out every ten seconds. Between 9 pm and 8 am, reminders and your own texts wait until morning.{!canSend && ` ${NO_SEND}`}</p>
  </Pane>

  {notice && !error && <p role="status" class="ws-callout" data-tone={noticeTone}><Icon name={done ? 'check' : 'info'} /><span>{notice}</span></p>}
  {error && <p role="alert" class="ws-callout" data-tone="alert"><Icon name="alert" /><span>{error}</span></p>}

  <Pane title={logTitle} meta={listed} icon="message" id="log" pad="none">
    {texts.length === 0 ? (
      <div class="msg-empty"><Empty icon="message" text={emptyText} /></div>
    ) : (
      <ul class="msg-list" aria-label={`${logTitle}, newest first`}>
        {texts.map((m) => {
          const s = statusOf(m);
          const kind = m.direction === 'in' ? 'Reply' : (KIND[m.kind ?? ''] ?? 'Text');
          const name = m.patient_id ? `${m.first_name} ${m.last_name}` : m.staff_name ?? null;
          return (
            <li class="msg-row" data-dir={m.direction}>
              {name ? <Avatar name={name} /> : <span class="msg-noname" aria-hidden="true"><Icon name="message" /></span>}
              <div class="msg-main">
                <p class="msg-who">
                  {m.patient_id ? (
                    <a href={`/c/${clinic.slug}/patients/${m.patient_id}/`} class="msg-name">{name}</a>
                  ) : (
                    <span class="msg-name">{name ?? prettyPhone(m.to_address)}</span>
                  )}
                  <span class="msg-kind">{kind}</span>
                </p>
                <p class="msg-text">{m.body ?? <span class="msg-hidden">A sign-in code, texted to the number on file. It is not shown here.</span>}</p>
                <p class="msg-when">{when(m.created_at)}{name && <> · <span class="whitespace-nowrap">{prettyPhone(m.to_address)}</span></>}</p>
                {s.why && <p class="msg-why"><Icon name="alert" size={16} />{s.why}</p>}
                {s.why && isCode(m) && canSetUp && <a href={`/c/${clinic.slug}/settings/team/`} class="ws-empty-go msg-go">Open Team to send a new code <Icon name="arrow-right" size={16} /></a>}
              </div>
              <div class="msg-side">
                <Chip tone={s.tone} label={s.label} dot={s.tone === 'alert'} />
                {m.direction === 'out' && m.status === 'failed' && !isCode(m) && (
                  <form method="post" action={back} id={`retry-${m.id}`}>
                    <Csrf />
                    <input type="hidden" name="act" value="retry" />
                    <input type="hidden" name="id" value={m.id} />
                    <button type="submit" class="ws-btn ws-btn-quiet">Send again</button>
                  </form>
                )}
                {m.direction === 'out' && m.status === 'queued' && (
                  <form method="post" action={back} id={`cancel-${m.id}`}>
                    <Csrf />
                    <input type="hidden" name="act" value="cancel" />
                    <input type="hidden" name="id" value={m.id} />
                    <button type="submit" class="ws-btn ws-btn-quiet">Cancel</button>
                  </form>
                )}
              </div>
            </li>
          );
        })}
      </ul>
    )}
  </Pane>

  <SidePanel id="send" title="Text a patient" meta="Anyone with a reason to hear from you" open={Boolean(sendError) || Boolean(to && canSend)}>
    {sendError && <p role="alert" class="ws-callout mb-5" data-tone="alert"><Icon name="alert" /><span>{sendError}</span></p>}
    {!canSend ? (
      <Empty icon="message" text={NO_SEND} />
    ) : recipients.length === 0 ? (
      <Empty icon="message" text="No one to text yet: nobody with a mobile on file is on the book this week, was seen in the last 30 days, is due for a check-up or has lab work back. Anyone else is texted from their record." />
    ) : (
      <form method="post" action={back} class="grid gap-5" data-send-form data-phone={clinicPhoneWords}>
        <Csrf />
        <input type="hidden" name="act" value="send" />
        {to && <input type="hidden" name="to" value={to} />}
        {toMissing && <p class="ws-callout" data-tone="info"><Icon name="info" /><span>That patient has no mobile number on file, so a text cannot reach them. Add one on their record.</span></p>}
        <label class="field">
          <span class="meta">Patient</span>
          {recipients.length > 40 && <input type="search" placeholder="Find by name" aria-label="Find a patient by name" autocomplete="off" data-send-filter hidden />}
          <select name="patient" required data-send-patient>
            <option value="" disabled selected={!chosen}>Choose a patient</option>
            {grouped.map((g) => (
              <optgroup label={g.label}>
                {g.rows.map(({ r, why }) => (
                  <option value={r.id} selected={chosen === r.id} {...facts(r)}>
                    {r.first_name} {r.last_name} · {why} · {prettyPhone(r.phone)}
                  </option>
                ))}
              </optgroup>
            ))}
          </select>
        </label>
        <div class="msg-templates" data-send-chips hidden>
          <p class="meta" id="send-templates-label">Use a template</p>
          <div class="msg-chips" role="group" aria-labelledby="send-templates-label">
            {TEXT_TEMPLATES.map((t) => <button type="button" class="ws-btn ws-btn-quiet ws-btn-sm" data-send-template={t.id}>{t.label}</button>)}
          </div>
        </div>
        <label class="field">
          <span class="meta">Message</span>
          <textarea name="body" rows="5" maxlength={BODY_MAX} required placeholder="Your 2 pm is moved to 3 pm. Call us if that does not work." data-send-body>{draft.body}</textarea>
          <span class="msg-hint">It starts with “{clinic.name}:” so they know who it is from. <span data-send-count>{draft.body.length}</span> of {BODY_MAX} letters, and no links.</span>
        </label>
        <p role="status" class="msg-note" data-send-note hidden></p>
        {!clinicPhone && <p class="msg-note">Your clinic has no phone number on file, so a template says “call the clinic”. Add the number in Clinic settings.</p>}
        <div class="msg-template-list" data-send-template-list>
          <p class="meta">Templates to copy</p>
          <ul>
            {TEXT_TEMPLATES.map((t) => <li><b>{t.label}.</b> {t.body}</li>)}
          </ul>
        </div>
        <button type="submit" class="ws-btn ws-btn-primary w-full"><Icon name="message" />Send text</button>
      </form>
    )}
  </SidePanel>
</ClinicLayout>

<style is:global>
  /* Messages' own few rules (the rest is the shell's), in the components layer so a utility in the markup still wins. */
  @layer components {
    .msg-bar-row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem 1rem; }
    .msg-lede { margin-top: 0.75rem; font-size: 14px; line-height: 1.5; color: var(--c-muted); }
    .msg-empty { padding: 0.5rem 1.5rem 0.75rem; }
    .msg-list { list-style: none; margin: 0; padding: 0; }
    .msg-row {
      display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 0.25rem 0.875rem; align-items: start;
      padding: 1rem 1.5rem; border-bottom: 1px solid var(--ws-hair);
    }
    .msg-row:last-child { border-bottom: 0; }
    .msg-noname {
      display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: var(--ws-r-pill);
      background: var(--ws-blue-tint); color: var(--ws-blue-ink);
    }
    .msg-main { display: grid; gap: 0.25rem; min-width: 0; }
    .msg-who { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.25rem 0.5rem; line-height: 1.35; }
    .msg-name { font-size: 15px; font-weight: 600; color: var(--c-ink); overflow-wrap: anywhere; }
    a.msg-name { text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 4px; transition: text-decoration-color 160ms ease, color 160ms ease; }
    a.msg-name:hover { color: var(--ws-teal-ink); text-decoration-color: currentColor; }
    .msg-kind { font-size: 13px; font-weight: 500; color: var(--c-muted); }
    .msg-text { max-width: 64ch; font-size: 15px; line-height: 1.55; color: var(--c-ink-2); white-space: pre-wrap; overflow-wrap: anywhere; }
    .msg-row[data-dir="in"] .msg-text { color: var(--c-ink); }
    .msg-hidden { color: var(--c-muted); }
    .msg-when { font-size: 13px; line-height: 1.4; color: var(--c-muted); font-variant-numeric: tabular-nums; }
    .msg-why { display: flex; align-items: flex-start; gap: 0.375rem; max-width: 60ch; margin-top: 0.25rem; font-size: 13.5px; line-height: 1.45; color: var(--ws-red-ink); }
    .msg-why > .ws-icon { flex: none; margin-top: 2px; }
    .msg-go { font-size: 14px; }
    .msg-side { display: flex; flex-direction: column; align-items: flex-end; gap: 0.625rem; }
    .msg-hint { font-size: 13.5px; line-height: 1.45; color: var(--c-muted); }
    /* Text a patient: the template chips above the box, the note under it, and the plain list for scripts off. */
    .msg-templates { display: grid; gap: 0.5rem; }
    .msg-chips { display: flex; flex-wrap: wrap; gap: 0.5rem; }
    .msg-chips .ws-btn { white-space: normal; text-align: center; }
    .msg-note { font-size: 14px; line-height: 1.5; color: var(--c-ink-2); }
    .msg-template-list { display: grid; gap: 0.5rem; }
    .msg-template-list ul { display: grid; gap: 0.5rem; margin: 0; padding: 0; list-style: none; font-size: 14px; line-height: 1.5; color: var(--c-ink-2); overflow-wrap: anywhere; }
    .msg-template-list b { font-weight: 600; color: var(--c-ink); }
    @media (max-width: 767px) {
      .msg-row { grid-template-columns: auto minmax(0, 1fr); padding: 0.875rem 1rem; }
      .msg-side { grid-column: 2; flex-direction: row; flex-wrap: wrap; align-items: center; justify-content: flex-start; margin-top: 0.375rem; }
      .msg-empty { padding: 0.25rem 1rem 0.5rem; }
      .msg-bar-row .ws-btn { flex: 1 1 auto; }
    }
  }
</style>

<script>
  import { TEXT_TEMPLATES, fillTemplate } from '../../../../lib/text-templates';
  // The template chips: pick one and the box fills in from the chosen patient's facts (the data-*
  // attributes on their option, and the clinic's number on the form). The words stay editable,
  // the count is live, and choosing another patient refills a box that still holds a template
  // exactly as it was filled. With scripts off the chips stay hidden and the templates are
  // listed under the box instead.
  const form = document.querySelector<HTMLFormElement>('[data-send-form]');
  const select = form?.querySelector<HTMLSelectElement>('[data-send-patient]');
  const body = form?.querySelector<HTMLTextAreaElement>('[data-send-body]');
  if (form && select && body) {
    const chips = form.querySelector<HTMLElement>('[data-send-chips]');
    const list = form.querySelector<HTMLElement>('[data-send-template-list]');
    const count = form.querySelector<HTMLElement>('[data-send-count]');
    const note = form.querySelector<HTMLElement>('[data-send-note]');
    const filter = form.querySelector<HTMLInputElement>('[data-send-filter]');
    const phone = form.dataset.phone || null;
    chips?.removeAttribute('hidden');
    list?.setAttribute('hidden', '');
    filter?.removeAttribute('hidden');

    const NEEDS = {
      visit: 'No visit on the book for them: check the time and day before sending.',
      lab: 'No lab work is marked back for them: check before sending.',
      balance: 'No balance shows for them here: check the amount before sending.',
    } as const;
    const say = () => { if (count) count.textContent = String(body.value.length); };
    let last = '';
    let lastId = '';
    const use = (id: string) => {
      const t = TEXT_TEMPLATES.find((x) => x.id === id);
      if (!t) return;
      const o = select.selectedOptions[0];
      const d: DOMStringMap = o?.value ? o.dataset : {};
      body.value = last = fillTemplate(t, { first: d.first ?? '', phone, time: d.time, day: d.day, dentist: d.dentist, amount: d.amount });
      lastId = id;
      say();
      const words = !o?.value ? 'Choose the patient and the text will say their name.'
        : t.needs && d[t.needs] !== '1' ? NEEDS[t.needs] : 'Change any words, then send.';
      if (note) { note.textContent = `${t.label} filled in. ${words}`; note.hidden = false; }
    };
    chips?.addEventListener('click', (e) => {
      const b = (e.target as Element).closest<HTMLElement>('[data-send-template]');
      if (b?.dataset.sendTemplate) use(b.dataset.sendTemplate);
    });
    select.addEventListener('change', () => { if (lastId && body.value === last) use(lastId); });
    body.addEventListener('input', say);

    // A long list: typing narrows it to matching names; the chosen one always stays.
    filter?.addEventListener('input', () => {
      const q = filter.value.trim().toLowerCase();
      for (const o of Array.from(select.options)) {
        if (!o.value) continue;
        const hide = q !== '' && !o.text.toLowerCase().includes(q) && !o.selected;
        o.hidden = hide;
        o.disabled = hide;
      }
      for (const g of Array.from(select.querySelectorAll('optgroup'))) {
        g.hidden = !Array.from(g.querySelectorAll('option')).some((o) => !o.hidden);
      }
    });
  }
</script>
