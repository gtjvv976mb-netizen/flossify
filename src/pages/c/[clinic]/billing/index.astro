---
// Billing, for one branch: today's charges, the unpaid balances oldest first,
// and every statement, filtered to one patient when the link says so. New
// charge starts a statement; a row opens it, where payments are recorded.
//
// For the desk, the owner, the admin and anyone the owner lets see finance
// here (canBill in src/lib/invoices.ts); everyone else gets one sentence.
// Every query runs inside withClinic(), so row-level security keeps it to
// this clinic. A balance is the statement's total less its payments that are
// not void; a void statement owes nothing and shows as void. What a patient
// owes leaves out the part an HMO or PhilHealth is still expected to send
// (DUE_SQL, patient_balance()): that part is said beside it, never added in.
export const prerender = false;

import ClinicLayout from '../../../../layouts/Clinic.astro';
import { requireWorkspace } from '../../../../lib/workspace';
import { withClinic } from '../../../../lib/db';
import { canBill, pesos, pesosWhole, fromDb, statementNo, day, stamp, STATUS, NOT_BIR, UUID, DUE_SQL } from '../../../../lib/invoices';

const ws = await requireWorkspace(Astro);
if (ws instanceof Response) return ws;
const { clinic, session, branches } = ws;
const may = canBill(session.role, clinic.can_view_finance);
const canSetUp = session.role === 'owner' || session.role === 'admin';
const base = `/c/${clinic.slug}/billing/`;
const q = Astro.url.searchParams;

const VIEWS = {
  today: { label: 'Today', where: `(i.issued_at at time zone 'Asia/Manila')::date = (now() at time zone 'Asia/Manila')::date`, order: 'i.issued_at desc, i.number desc' },
  unpaid: { label: 'Unpaid', where: `i.status in ('issued', 'partly_paid')`, order: 'i.issued_at asc, i.number asc' },
  all: { label: 'All', where: 'true', order: 'i.issued_at desc, i.number desc' },
  void: { label: 'Void', where: `i.status = 'void'`, order: 'i.issued_at desc, i.number desc' },
} as const;
type View = keyof typeof VIEWS;
const viewParam = q.get('view') ?? 'today';
const view: View = Object.hasOwn(VIEWS, viewParam) ? (viewParam as View) : 'today';
const patientParam = q.get('patient') ?? '';
const patientId = UUID.test(patientParam) ? patientParam : '';
const search = (q.get('q') ?? '').replace(/\s+/g, ' ').trim().slice(0, 80);

/** This page, with the filter kept and anything extra changed. */
const href = (v: View, extra: Record<string, string> = {}) => {
  const s = new URLSearchParams();
  if (v !== 'today') s.set('view', v);
  const p = 'patient' in extra ? extra.patient : patientId;
  if (p) s.set('patient', p);
  const t = 'q' in extra ? extra.q : search;
  if (t) s.set('q', t);
  const str = s.toString();
  return base + (str ? `?${str}` : '');
};

interface Row {
  id: string; series_prefix: string; number: string; issued_at: Date; status: string; total: string;
  payor_share: string; payor_name: string | null; paid: string; payor_paid: string;
  patient_id: string; first_name: string; last_name: string; chart_no: string; first_line: string | null; n_lines: number;
}

const like = (s: string) => '%' + s.replace(/[\\%_]/g, (c) => '\\' + c) + '%';
// "SOA-000012", "soa12", "12": a statement number, with its series when one is typed.
const numberM = /^(?:([a-z]{1,4})-?)?0*(\d{1,9})$/i.exec(search);
const numberQ = numberM?.[2] ?? null;
const prefixQ = numberM?.[1]?.toUpperCase() ?? null;

const data = may ? await withClinic(clinic.id, async (tx) => {
  const rows = (await tx.query(
    `select i.id, i.series_prefix, i.number, i.issued_at, i.status, i.total, i.payor_share, i.payor_name,
            coalesce(y.paid, 0) as paid, coalesce(y.payor_paid, 0) as payor_paid,
            p.id as patient_id, p.first_name, p.last_name, p.chart_no,
            (select l.description from invoice_line l where l.invoice_id = i.id order by l.line_no nulls last limit 1) as first_line,
            (select count(*)::int from invoice_line l where l.invoice_id = i.id) as n_lines
       from invoice i
       join patient p on p.id = i.patient_id
       left join lateral (
         select sum(amount) as paid, sum(amount) filter (where method in ('hmo', 'philhealth')) as payor_paid
           from payment where invoice_id = i.id and voided_at is null) y on true
      where i.status <> 'draft' and ${VIEWS[view].where}
        and ($1::uuid is null or i.patient_id = $1)
        and ($2::text is null or p.first_name ilike $2 or p.last_name ilike $2 or (p.first_name || ' ' || p.last_name) ilike $2
             or p.chart_no ilike $2 or ($3::bigint is not null and i.number = $3 and ($4::text is null or i.series_prefix = $4)))
      order by ${VIEWS[view].order}
      limit 300`,
    [patientId || null, search ? like(search) : null, numberQ, prefixQ])).rows as Row[];
  const tiles = (await tx.query(
    `with due as (${DUE_SQL}),
          today as (select total from invoice
                     where status in ('issued', 'partly_paid', 'paid')
                       and (issued_at at time zone 'Asia/Manila')::date = (now() at time zone 'Asia/Manila')::date)
     select (select coalesce(sum(total), 0) from today) as charged,
            (select count(*)::int from today) as charged_n,
            coalesce(sum(patient_due) filter (where patient_due > 0), 0) as owed,
            count(distinct patient_id) filter (where patient_due > 0)::int as owed_patients,
            coalesce(sum(payor_due), 0) as payor_owed,
            (select coalesce(sum(amount), 0) from payment where voided_at is null and paid_on = (now() at time zone 'Asia/Manila')::date) as collected,
            (select count(*)::int from payment where voided_at is null and paid_on = (now() at time zone 'Asia/Manila')::date) as collected_n
       from due`)).rows[0];
  const me = (await tx.query('select area, tin from clinic where id = $1', [clinic.id])).rows[0];
  const who = patientId
    ? (await tx.query(
        `select p.id, p.first_name, p.last_name, p.chart_no, patient_balance(p.id) as balance,
                (select coalesce(sum(d.payor_due), 0) from (${DUE_SQL}) d where d.patient_id = p.id) as payor_due,
                (select string_agg(distinct d.payor_name, ', ') from (${DUE_SQL}) d where d.patient_id = p.id and d.payor_due > 0) as payors
           from patient p where p.id = $1`, [patientId])).rows[0] ?? null
    : null;
  return { rows, tiles, me, who };
}) : { rows: [] as Row[], tiles: null, me: (await withClinic(clinic.id, async (tx) => (await tx.query('select area, tin from clinic where id = $1', [clinic.id])).rows[0])), who: null };

const n = (x: number, one: string, many = `${one}s`) => `${x} ${x === 1 ? one : many}`;
const tiles = data.tiles ? [
  { label: 'Charged today', value: pesosWhole(data.tiles.charged), note: n(data.tiles.charged_n, 'statement'), href: href('today', { patient: '', q: '' }) },
  { label: 'Collected today', value: pesosWhole(data.tiles.collected), note: n(data.tiles.collected_n, 'payment') },
  // The same figure as Today's tile: what patients themselves owe. The part HMOs or PhilHealth still owe is said, not added.
  { label: 'Patient balances', value: pesosWhole(data.tiles.owed), note: `${n(data.tiles.owed_patients, 'patient')} owing${fromDb(data.tiles.payor_owed) > 0n ? ` · ${pesosWhole(data.tiles.payor_owed)} more due from HMOs or PhilHealth` : ''}`, href: href('unpaid', { patient: '', q: '' }) },
] : [];

const EMPTY: Record<View, string> = {
  today: 'Nothing charged today yet. New charge starts one.',
  unpaid: 'No unpaid balances. Everyone is square.',
  all: 'No statements yet. The first one starts with New charge.',
  void: 'No void statements.',
};
const filtered = !!(patientId || search);
const empty = filtered ? `No ${view === 'all' ? '' : VIEWS[view].label.toLowerCase() + ' '}statements${data.who ? ` for ${data.who.first_name} ${data.who.last_name}` : search ? ` matching “${search}”` : ''}.` : EMPTY[view];
const chip = (on: boolean) => ['inline-flex min-h-11 items-center px-3.5 text-[14px] font-medium', on ? 'bg-ink text-bg' : 'text-ink-2 hover:bg-bg-soft hover:text-accent'];
const time = (d: Date) => stamp(d).split(', ').pop();
---

<ClinicLayout groupId={clinic.group_id} clinic={{ slug: clinic.slug, name: clinic.name, area: data.me?.area }} title="Billing" section="billing" staff={{ name: session.name, role: session.role }} branches={branches} finance={clinic.can_view_finance}>
  <div class="flex flex-wrap items-end justify-between gap-4">
    <h1 class="font-display text-[clamp(1.75rem,4vw,2.5rem)] font-semibold tracking-[-0.02em]">Billing</h1>
    {may && <a href={`${base}new/${patientId ? `?patient=${patientId}` : ''}`} class="btn btn-primary" data-bill-new>New charge</a>}
  </div>

  {!may ? (
    <p class="mt-6 max-w-[60ch] text-[15.5px] leading-relaxed text-ink-2">Charges and payments are kept by the desk, the owner, the admin and anyone the owner lets see finance at this branch. Ask the owner if you need them.</p>
  ) : (
    <>
      <p class="mt-3 max-w-[64ch] text-[15px] text-ink-2">Charge a patient, take their payment, print the statement or the acknowledgment. Unpaid lists what is still owed, oldest first.</p>

      {canSetUp && !data.me?.tin && (
        <p class="mt-6 max-w-[72ch] border border-crown/40 bg-crown/10 p-4 text-[14.5px]">
          The clinic’s TIN is not set, so statements print without it. <a href={`/c/${clinic.slug}/settings/#tax`} class="font-semibold underline underline-offset-4 hover:text-accent">Add it in Settings</a>.
        </p>
      )}

      <dl class="mt-6 grid gap-4 sm:grid-cols-3">
        {tiles.map((t) => (
          <div class="border border-line bg-surface p-5">
            <dt class="meta">{t.label}</dt>
            <dd class="mt-2 font-display text-[32px] leading-none font-bold tabular-nums">{t.href ? <a href={t.href} class="inline-flex min-h-11 items-center hover:text-accent">{t.value}</a> : t.value}</dd>
            <p class="mt-1.5 text-[13px] text-muted">{t.note}</p>
          </div>
        ))}
      </dl>

      <div class="mt-8 flex flex-wrap items-end justify-between gap-x-6 gap-y-4">
        <nav aria-label="Which statements">
          <ul class="flex flex-wrap gap-1">
            {(Object.keys(VIEWS) as View[]).map((v) => (
              <li><a href={href(v)} aria-current={v === view ? 'page' : undefined} class:list={chip(v === view)}>{VIEWS[v].label}</a></li>
            ))}
          </ul>
        </nav>
        <form method="get" action={base} class="flex w-full max-w-[28rem] gap-2" role="search">
          {view !== 'today' && <input type="hidden" name="view" value={view} />}
          <label class="field flex-1">
            <span class="sr-only">Find a patient or statement</span>
            <input type="search" name="q" value={search} placeholder="Patient name, chart no. or statement no." autocomplete="off" class="text-[16px]" />
          </label>
          <button type="submit" class="btn btn-quiet min-h-11 !px-4 !py-2">Find</button>
        </form>
      </div>

      {(data.who || search) && (
        <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-0 border border-line bg-surface px-4 py-1 text-[15px]" data-bill-filter>
          {data.who ? (
            <>
              <span>
                <a href={`/c/${clinic.slug}/patients/${data.who.id}/`} class="inline-flex min-h-11 items-center font-semibold hover:text-accent">{data.who.first_name} {data.who.last_name}</a>
                <span class="text-muted"> · {data.who.chart_no}</span>
              </span>
              <span class="tabular-nums" data-bill-who-balance>
                Owes <strong class="font-semibold">{fromDb(data.who.balance) === 0n ? '—' : pesos(data.who.balance)}</strong>
                {fromDb(data.who.payor_due) > 0n && <span class="text-muted"> · {pesos(data.who.payor_due)} more due from {data.who.payors}</span>}
              </span>
              <a href={`${base}new/?patient=${data.who.id}`} class="inline-flex min-h-11 items-center underline underline-offset-4 hover:text-accent">Charge this patient</a>
            </>
          ) : (
            <span>Matching “{search}”</span>
          )}
          <a href={href(view, { patient: '', q: '' })} class="meta ml-auto inline-flex min-h-11 items-center hover:text-ink">Show everyone</a>
        </div>
      )}

      <div class="mt-4 overflow-x-auto border border-line bg-surface">
        <table class="w-full border-collapse text-left sm:min-w-[860px]">
          <caption class="sr-only">{VIEWS[view].label} statements at {clinic.name}</caption>
          <thead>
            <tr class="border-b border-line bg-bg-soft">
              <th scope="col" class="meta px-3 py-3.5 font-normal sm:px-4">No.</th>
              <th scope="col" class="meta hidden px-4 py-3.5 font-normal sm:table-cell">{view === 'today' ? 'Time' : 'Date'}</th>
              <th scope="col" class="meta px-3 py-3.5 font-normal sm:px-4">Patient</th>
              <th scope="col" class="meta hidden px-4 py-3.5 font-normal sm:table-cell">For</th>
              <th scope="col" class="meta hidden px-4 py-3.5 text-right font-normal sm:table-cell">Total</th>
              <th scope="col" class="meta hidden px-4 py-3.5 text-right font-normal sm:table-cell">Paid</th>
              <th scope="col" class="meta px-3 py-3.5 text-right font-normal sm:px-4">Balance</th>
              <th scope="col" class="meta hidden px-4 py-3.5 font-normal sm:table-cell">Status</th>
            </tr>
          </thead>
          <tbody>
            {data.rows.length === 0 && <tr><td colspan="8" class="px-5 py-5 text-[15px] text-muted">{empty}</td></tr>}
            {data.rows.map((r, i) => {
              const st = STATUS[r.status] ?? STATUS.issued;
              const isVoid = r.status === 'void';
              const balance = isVoid ? 0n : fromDb(r.total) - fromDb(r.paid);
              const payorLeft = fromDb(r.payor_share) - fromDb(r.payor_paid);
              const fromPayor = !isVoid && balance > 0n && payorLeft > 0n ? (payorLeft < balance ? payorLeft : balance) : 0n;
              return (
                <tr class={i < data.rows.length - 1 ? 'border-b border-line-2' : ''} data-bill-row={r.id}>
                  <td class="px-3 py-2.5 align-middle sm:px-4 sm:py-3.5">
                    <a href={`${base}${r.id}/`} class="inline-flex min-h-11 items-center font-mono text-[13.5px] font-medium whitespace-nowrap tabular-nums hover:text-accent">{statementNo(r.series_prefix, r.number)}</a>
                    <p class="text-[13px] whitespace-nowrap tabular-nums text-muted sm:hidden">{view === 'today' ? time(r.issued_at) : day(r.issued_at)}</p>
                  </td>
                  <td class="hidden px-4 py-3.5 align-middle text-[15px] whitespace-nowrap tabular-nums text-ink-2 sm:table-cell"><span>{view === 'today' ? time(r.issued_at) : day(r.issued_at)}</span></td>
                  <th scope="row" class="px-3 py-2.5 align-middle font-normal sm:px-4 sm:py-3.5">
                    <a href={href(view, { patient: r.patient_id, q: '' })} class="inline-flex min-h-11 items-center text-[15.5px] font-semibold hover:text-accent" title="Only this patient’s statements">{r.last_name}, {r.first_name}</a>
                    <p class="text-[13px] tabular-nums text-muted">{r.chart_no}</p>
                  </th>
                  <td class="hidden max-w-[18rem] px-4 py-3.5 align-middle text-[14.5px] text-ink-2 sm:table-cell">{r.first_line ?? '—'}{r.n_lines > 1 && <span class="text-muted"> + {r.n_lines - 1} more</span>}</td>
                  <td class={`hidden px-4 py-3.5 text-right align-middle text-[15px] tabular-nums sm:table-cell ${isVoid ? 'text-muted line-through' : ''}`}>{pesos(r.total)}</td>
                  <td class="hidden px-4 py-3.5 text-right align-middle text-[15px] tabular-nums text-ink-2 sm:table-cell">{fromDb(r.paid) === 0n ? '—' : pesos(r.paid)}</td>
                  <td class="px-3 py-2.5 text-right align-middle text-[15px] font-semibold tabular-nums sm:px-4 sm:py-3.5">
                    {isVoid || balance === 0n ? <span class="font-normal text-muted">—</span> : <span class="whitespace-nowrap">{pesos(balance)}</span>}
                    {fromPayor > 0n && <span class="block text-[12.5px] font-normal text-muted">{pesos(fromPayor)} from {r.payor_name}</span>}
                    <span class={`mt-0.5 flex items-center justify-end gap-1.5 text-[13.5px] ${st.tone} sm:hidden`}><span class={`h-2 w-2 shrink-0 ${st.dot}`}></span>{st.label}</span>
                  </td>
                  <td class={`hidden px-4 py-3.5 align-middle text-[14.5px] font-semibold sm:table-cell ${st.tone}`}><span class="flex items-center gap-2"><span class={`h-2.5 w-2.5 shrink-0 ${st.dot}`}></span>{st.label}</span></td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
      {data.rows.length === 300 && <p class="mt-2 text-[13.5px] text-muted">Showing the first 300. Find a patient to narrow it.</p>}

      <p class="mt-10 max-w-[72ch] border-t border-line pt-4 text-[13.5px] text-muted">{NOT_BIR}</p>
    </>
  )}
</ClinicLayout>
