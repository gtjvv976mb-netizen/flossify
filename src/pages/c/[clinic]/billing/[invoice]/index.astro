---
// One statement of account: what was charged, what has been paid, what is
// left, and the form that records the next payment. Payments can come in
// parts, by any of the ways Philippine clinics are paid; each gets its own
// acknowledgment to print.
//
// The desk, the owner, the admin and anyone with finance access here may
// record payments (canBill). Voiding a payment or the statement is the
// owner's and the admin's, with a reason that stays on the row; the audit log
// says who and when. A statement with a payment still on it cannot be voided:
// void the payment first, so money is never left pointing at nothing. The
// BIR invoice or receipt number can be written onto a payment later by anyone
// who records payments (setBirRef), and corrected with a reason that keeps
// the old number (fixBirRef); nothing else on a payment changes.
//
// Every write locks the statement row (src/lib/invoices.ts), so two people
// paying or voiding at once take turns and the second sees the first. A post
// that finds things moved on comes back with ?missed=1 and a sentence.
export const prerender = false;

import ClinicLayout from '../../../../../layouts/Clinic.astro';
import Csrf from '../../../../../components/Csrf.astro';
import { requireWorkspace } from '../../../../../lib/workspace';
import { withClinic } from '../../../../../lib/db';
import { csrfOk, CSRF_MESSAGE } from '../../../../../lib/csrf';
import {
  canBill, canVoid, loadStatement, recordPayment, voidPayment, voidStatement, setBirRef, fixBirRef, audit,
  pesos, moneyField, fromDb, statementNo, methodLabel, day, stamp, isoDay,
  METHODS, REF_LABEL, STATUS, DISCOUNTS, NOT_BIR, UUID, REF_MAX, BIR_REF_MAX, REASON_MAX,
  type PaymentIn,
} from '../../../../../lib/invoices';

const ws = await requireWorkspace(Astro);
if (ws instanceof Response) return ws;
const { clinic, session, branches } = ws;
const may = canBill(session.role, clinic.can_view_finance);
const voider = canVoid(session.role);
const id = Astro.params.invoice ?? '';
const base = `/c/${clinic.slug}/billing/`;
const here = `${base}${id}/`;
const q = Astro.url.searchParams;

let error = q.get('stale') === '1' ? CSRF_MESSAGE : '';
let typed: PaymentIn | null = null;
let openVoid = '';
let openBir = '';
let typedBir = '';
let openFix = '';
let typedFix = { ref: '', reason: '' };

if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  if (!csrfOk(Astro.cookies, f)) return Astro.redirect(`${here}?stale=1`, 303);
  const s = (k: string) => String(f.get(k) ?? '').trim();
  const act = s('act');
  if (!may) {
    error = 'Charges and payments are kept by the desk, the owner, the admin and anyone the owner lets see finance at this branch.';
    Astro.response.status = 403;
  } else if (act === 'pay') {
    typed = { method: s('method'), amount: s('amount'), reference: s('reference'), paidOn: s('paid_on'), birRef: s('bir_ref'), formKey: s('form_key') };
    const out = await withClinic(clinic.id, (tx) => recordPayment(tx, clinic.id, session.staffId, id, typed!));
    if ('id' in out) return Astro.redirect(`${here}?done=${out.again ? 'paid_again' : 'paid'}&p=${out.id}`, 303);
    error = out.problems.join(' ');
  } else if (act === 'bir_ref') {
    typedBir = s('bir_ref');
    const outcome = await withClinic(clinic.id, (tx) => setBirRef(tx, clinic.id, session.staffId, id, s('payment'), typedBir));
    if (outcome === 'ok') return Astro.redirect(`${here}?done=bir_ref&p=${s('payment')}`, 303);
    if (outcome === 'missed') return Astro.redirect(`${here}?missed=1`, 303);
    error = outcome;
    openBir = s('payment');
  } else if (act === 'bir_ref_fix') {
    typedFix = { ref: s('bir_ref'), reason: s('reason') };
    const outcome = await withClinic(clinic.id, (tx) => fixBirRef(tx, clinic.id, session.staffId, id, s('payment'), s('was'), typedFix.ref, typedFix.reason));
    if (outcome === 'ok') return Astro.redirect(`${here}?done=bir_ref_fix&p=${s('payment')}`, 303);
    if (outcome === 'missed') return Astro.redirect(`${here}?missed=1`, 303);
    error = outcome;
    openFix = s('payment');
  } else if (act === 'void_payment' || act === 'void_statement') {
    if (!voider) {
      error = 'Only the owner or the admin can void. Ask them, and say why.';
      Astro.response.status = 403;
    } else {
      const outcome = await withClinic(clinic.id, (tx) =>
        act === 'void_payment'
          ? voidPayment(tx, clinic.id, session.staffId, id, s('payment'), s('reason'))
          : voidStatement(tx, clinic.id, session.staffId, id, s('reason')));
      if (outcome === 'ok') return Astro.redirect(`${here}?done=${act}`, 303);
      if (outcome === 'missed') return Astro.redirect(`${here}?missed=1`, 303);
      error = outcome;
      openVoid = act === 'void_payment' ? s('payment') : 'statement';
    }
  } else {
    return Astro.redirect(here, 303);
  }
}

const data = may
  ? await withClinic(clinic.id, async (tx) => {
      const st = await loadStatement(tx, id);
      if (st) await audit(tx, clinic.id, session.staffId, 'invoice.view', 'invoice', st.s.id);
      const me = (await tx.query('select area, tin from clinic where id = $1', [clinic.id])).rows[0];
      return { st, me };
    })
  : { st: null, me: (await withClinic(clinic.id, async (tx) => (await tx.query('select area, tin from clinic where id = $1', [clinic.id])).rows[0])) };
if (may && !data.st) return new Response('No such statement', { status: 404 });

const st = data.st;
const s = st?.s;
const no = s ? statementNo(s.series_prefix, s.number) : '';
const status = s ? STATUS[s.status] ?? STATUS.issued : STATUS.issued;
const sums = st?.sums;
const live = st ? st.payments.filter((p) => !p.voided_at) : [];
const isVoid = s?.status === 'void';
const canPay = may && s && !isVoid && sums!.balance > 0n;
const payorDue = sums?.payorDue ?? 0n;
const patientDue = sums?.patientDue ?? 0n;
const defaultAmount = patientDue > 0n ? patientDue : sums?.balance ?? 0n;

const done = q.get('done') ?? '';
const donePayment = q.get('p') ?? '';
const DONE: Record<string, string> = {
  new: `Saved as ${no}.${sums && sums.balance > 0n ? ' Record the payment below, or print the statement.' : ''}`,
  again: `That form was already saved as ${no}; nothing new was made.`,
  paid: 'Payment recorded.',
  paid_again: 'That payment was already recorded; it was not added twice.',
  bir_ref: 'BIR invoice or receipt number saved. It prints on the acknowledgment.',
  bir_ref_fix: 'BIR invoice or receipt number corrected. The old number and the reason stay on the record.',
  void_payment: 'Payment voided. Its amount is back on the balance.',
  void_statement: 'Statement voided. Its number stays used and shows as void.',
};
const notice = error ? '' : DONE[done] ?? '';
const missed = q.get('missed') === '1' && !error ? 'That had already changed since the page was drawn, so nothing changed. This is how it stands now.' : '';

const v: PaymentIn = typed ?? { method: 'cash', amount: moneyField(defaultAmount), reference: '', paidOn: isoDay(), birRef: '', formKey: crypto.randomUUID() };
if (typed && !UUID.test(v.formKey)) v.formKey = crypto.randomUUID();
const today = isoDay();

const help = 'text-[13px] leading-snug text-muted';
const sectionTitle = 'font-display text-[22px] font-semibold';
const small = 'btn btn-quiet min-h-11 !px-3.5 !py-2 text-[14px]';
// A summary drawn as a button: no disclosure triangle (Safari draws one even when it is not a list item).
const noMarker = 'list-none [&::-webkit-details-marker]:hidden';
---

<ClinicLayout groupId={clinic.group_id} clinic={{ slug: clinic.slug, name: clinic.name, area: data.me?.area }} title={s ? `Statement ${no}` : 'Billing'} section="billing" staff={{ name: session.name, role: session.role }} branches={branches} finance={clinic.can_view_finance}>
  <a href={base} class="inline-flex min-h-11 items-center text-[14.5px] font-medium text-accent">&larr; Billing</a>

  {!may || !s || !st || !sums ? (
    <>
      <h1 class="mt-4 font-display text-[clamp(1.75rem,4vw,2.5rem)] font-semibold tracking-[-0.02em]">Billing</h1>
      {error && <p role="alert" class="mt-6 border border-caries/40 bg-caries/10 p-4 text-[14.5px]">{error}</p>}
      <p class="mt-6 max-w-[60ch] text-[15.5px] leading-relaxed text-ink-2">Charges and payments are kept by the desk, the owner, the admin and anyone the owner lets see finance at this branch. Ask the owner if you need them.</p>
    </>
  ) : (
    <>
      <div class="mt-2 flex flex-wrap items-start justify-between gap-6">
        <div>
          <p class="meta">Statement of account</p>
          <h1 class="mt-1 font-display text-[clamp(1.75rem,4vw,2.5rem)] leading-tight font-semibold tracking-[-0.02em] tabular-nums">{no}</h1>
          <p class="mt-0.5 text-[15.5px]">
            <a href={`/c/${clinic.slug}/patients/${s.patient_id}/`} class="inline-flex min-h-11 items-center font-semibold hover:text-accent">{s.first_name} {s.last_name}</a>
            <span class="text-muted"> · {s.chart_no} · {day(s.issued_at)}{s.created_by_name && ` · by ${s.created_by_name}`}</span>
          </p>
          <p class={`mt-0.5 flex items-center gap-2 text-[15px] font-semibold ${status.tone}`}><span class={`h-2.5 w-2.5 shrink-0 ${status.dot}`}></span>{status.label}</p>
        </div>
        <div class="sm:text-right">
          <p class="meta">Balance</p>
          <p class="mt-1 font-display text-[34px] leading-none font-bold tabular-nums" data-bill-balance>{isVoid ? '—' : pesos(sums.balance)}</p>
          {!isVoid && sums.balance > 0n && payorDue > 0n && (
            <p class="mt-1.5 text-[13.5px] text-ink-2">{pesos(patientDue)} from the patient · {pesos(payorDue)} from {s.payor_name}</p>
          )}
        </div>
      </div>

      {notice && (
        <p role="status" class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-1 border border-accent/40 bg-accent/10 px-4 py-2.5 text-[14.5px]" data-bill-notice>
          <span>{notice}</span>
          {(done === 'paid' || done === 'paid_again' || done === 'bir_ref' || done === 'bir_ref_fix') && UUID.test(donePayment) && <a href={`${here}print/?ack=${donePayment}`} class="inline-flex min-h-11 items-center font-semibold underline underline-offset-4 hover:text-accent" data-bill-print-ack>Print the acknowledgment</a>}
          {done === 'new' && <a href={`${here}print/`} class="inline-flex min-h-11 items-center font-semibold underline underline-offset-4 hover:text-accent">Print the statement</a>}
        </p>
      )}
      {missed && <p role="status" class="mt-6 border border-crown/40 bg-crown/10 p-4 text-[14.5px]">{missed}</p>}
      {error && <p role="alert" class="mt-6 border border-caries/40 bg-caries/10 p-4 text-[14.5px]" data-bill-error>{error}</p>}
      {isVoid && (
        <p class="mt-6 border border-line bg-bg-soft p-4 text-[14.5px] text-ink-2">
          <strong class="font-semibold text-ink">Void</strong> since {s.voided_at ? stamp(s.voided_at) : '—'}{s.voided_by_name && `, by ${s.voided_by_name}`}. Reason: {s.void_reason}
        </p>
      )}

      <div class="mt-6 grid grid-cols-1 gap-8 lg:grid-cols-[minmax(0,1fr)_26rem]">
        <section class="min-w-0" aria-labelledby="lines-title">
          <h2 id="lines-title" class={sectionTitle}>Charges</h2>
          <div class="mt-4 border border-line bg-surface">
            <table class="w-full border-collapse text-left">
              <thead>
                <tr class="border-b border-line bg-bg-soft">
                  <th scope="col" class="meta px-4 py-3 font-normal">Item</th>
                  <th scope="col" class="meta hidden px-4 py-3 text-right font-normal sm:table-cell">Qty</th>
                  <th scope="col" class="meta hidden px-4 py-3 text-right font-normal sm:table-cell">Price each</th>
                  <th scope="col" class="meta px-4 py-3 text-right font-normal">Amount</th>
                </tr>
              </thead>
              <tbody>
                {st.lines.map((l) => {
                  const qty = l.quantity.replace(/\.0+$/, '');
                  return (
                    <tr class="border-b border-line-2 align-top">
                      <td class="px-4 py-3 text-[15.5px]">{l.description}<span class="block text-[14px] tabular-nums text-ink-2 sm:hidden">{qty} × {pesos(l.unit_price)}</span></td>
                      <td class="hidden px-4 py-3 text-right text-[15.5px] tabular-nums sm:table-cell">{qty}</td>
                      <td class="hidden px-4 py-3 text-right text-[15.5px] tabular-nums sm:table-cell">{pesos(l.unit_price)}</td>
                      <td class="px-4 py-3 text-right text-[15.5px] whitespace-nowrap tabular-nums">{pesos(l.amount)}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
            <dl class="grid grid-cols-[minmax(0,1fr)_auto] gap-x-6 gap-y-1.5 px-4 py-3 text-[15.5px] tabular-nums sm:[&>dt]:text-right">
              <dt class="text-ink-2">Charges</dt><dd class="text-right">{pesos(s.subtotal)}</dd>
              {fromDb(s.discount) > 0n && (
                <><dt class="text-ink-2">{DISCOUNTS[(s.discount_kind ?? 'none') as keyof typeof DISCOUNTS]?.line || 'Discount'}{s.discount_id_no && ` · ID ${s.discount_id_no}`}</dt><dd class="text-right whitespace-nowrap">&minus;{pesos(s.discount)}</dd></>
              )}
              <dt class="font-semibold">Total</dt><dd class="text-right font-semibold">{pesos(s.total)}</dd>
              {fromDb(s.payor_share) > 0n && (
                <><dt class="text-ink-2">{s.payor_name}’s part</dt><dd class="text-right">{pesos(s.payor_share)}</dd></>
              )}
              <dt class="text-ink-2">Paid</dt><dd class="text-right">{pesos(sums.paid)}</dd>
            </dl>
          </div>

          <h2 class={`mt-10 ${sectionTitle}`} id="payments-title">Payments</h2>
          {st.payments.length === 0 ? (
            <p class="mt-3 text-[15px] text-muted">None yet.</p>
          ) : (
            <ul class="mt-4 divide-y divide-line-2 border border-line bg-surface" aria-labelledby="payments-title" data-bill-payments>
              {st.payments.map((p) => (
                <li class="px-4 py-4 sm:px-5" data-payment={p.id}>
                  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                    <p class={`text-[16px] font-semibold tabular-nums ${p.voided_at ? 'text-muted line-through' : ''}`}>{pesos(p.amount)} <span class="font-normal text-ink-2 no-underline">· {methodLabel(p.method)}</span></p>
                    <p class="meta">Payment {p.seq ?? '—'} · {day(p.paid_on)}</p>
                  </div>
                  <p class="mt-1 text-[14px] text-ink-2">
                    {p.reference && <span>Ref {p.reference} · </span>}
                    {p.bir_ref ? <span>BIR invoice or receipt no. {p.bir_ref}{p.bir_ref_was && <span class="text-muted"> (corrected from {p.bir_ref_was}: {p.bir_ref_fix_reason})</span>} · </span> : <span class="text-muted">No BIR invoice or receipt no. written · </span>}
                    <span>recorded by {p.received_by_name ?? '—'}, {stamp(p.received_at)}</span>
                  </p>
                  {p.voided_at && <p class="mt-1 text-[14px] text-ink-2"><strong class="font-semibold text-ink">Void</strong>, {stamp(p.voided_at)}{p.voided_by_name && ` by ${p.voided_by_name}`}. Reason: {p.void_reason}</p>}
                  <div class="mt-3 flex flex-wrap items-start gap-3">
                    <a href={`${here}print/?ack=${p.id}`} class={small}>Print acknowledgment</a>
                    {!p.bir_ref && !p.voided_at && (
                      <details class="open:basis-full" open={openBir === p.id} data-bir-add>
                        <summary class={`${small} ${noMarker}`}>Add BIR invoice or receipt no.</summary>
                        <form method="post" class="mt-2 grid gap-2 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-end">
                          <Csrf />
                          <input type="hidden" name="act" value="bir_ref" />
                          <input type="hidden" name="payment" value={p.id} />
                          <label class="field"><span class="meta">BIR invoice or receipt no.</span><input name="bir_ref" value={openBir === p.id ? typedBir : ''} required maxlength={BIR_REF_MAX} autocomplete="off" class="text-[16px]" /></label>
                          <button type="submit" class="btn btn-quiet min-h-11">Save number</button>
                          <span class={`${help} sm:col-span-2`}>From the receipt you wrote in the clinic’s own booklet or system. It prints on the acknowledgment.</span>
                        </form>
                      </details>
                    )}
                    {p.bir_ref && !p.voided_at && (
                      <details class="open:basis-full" open={openFix === p.id} data-bir-fix>
                        <summary class={`${small} ${noMarker}`}>Correct BIR no.</summary>
                        <form method="post" class="mt-2 grid gap-2 sm:grid-cols-2 sm:items-end">
                          <Csrf />
                          <input type="hidden" name="act" value="bir_ref_fix" />
                          <input type="hidden" name="payment" value={p.id} />
                          <input type="hidden" name="was" value={p.bir_ref} />
                          <label class="field"><span class="meta">Right number</span><input name="bir_ref" value={openFix === p.id ? typedFix.ref : p.bir_ref} required maxlength={BIR_REF_MAX} autocomplete="off" class="text-[16px] tabular-nums" /></label>
                          <label class="field"><span class="meta">Why</span><input name="reason" value={openFix === p.id ? typedFix.reason : ''} required minlength="4" maxlength={REASON_MAX} autocomplete="off" class="text-[16px]" placeholder="Typed it wrong" /></label>
                          <button type="submit" class="btn btn-quiet min-h-11 sm:col-span-2 sm:justify-self-start">Save the right number</button>
                          <span class={`${help} sm:col-span-2`}>Now {p.bir_ref}. The old number and the reason stay on the record.</span>
                        </form>
                      </details>
                    )}
                    {voider && !p.voided_at && (
                      <details class="open:basis-full" open={openVoid === p.id}>
                        <summary class={`${small} ${noMarker}`}>Void this payment</summary>
                        <form method="post" class="mt-2 grid gap-2 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-end">
                          <Csrf />
                          <input type="hidden" name="act" value="void_payment" />
                          <input type="hidden" name="payment" value={p.id} />
                          <label class="field"><span class="meta">Why</span><input name="reason" required minlength="4" maxlength={REASON_MAX} class="text-[16px]" placeholder="Recorded twice, wrong amount, cheque bounced" /></label>
                          <button type="submit" class="btn btn-quiet min-h-11 text-caries">Void payment</button>
                        </form>
                      </details>
                    )}
                  </div>
                </li>
              ))}
            </ul>
          )}
        </section>

        <aside class="grid min-w-0 content-start gap-6">
          {canPay && (
            <section class="border border-line bg-surface p-5" aria-labelledby="pay-title">
              <h2 id="pay-title" class={sectionTitle}>Record a payment</h2>
              <form method="post" class="mt-3 grid gap-3" data-bill-pay data-patient-due={moneyField(patientDue)} data-payor-due={moneyField(payorDue)} data-balance={moneyField(sums.balance)} data-focus={done === 'new' && !error ? '1' : undefined}>
                <Csrf />
                <input type="hidden" name="act" value="pay" />
                <input type="hidden" name="form_key" value={v.formKey} />
                <fieldset>
                  <legend class="meta">Paid by</legend>
                  <div class="mt-2 flex flex-wrap gap-2">
                    {Object.entries(METHODS).map(([k, label]) => (
                      <label class="chip-radio"><input type="radio" name="method" value={k} checked={v.method === k} required data-pay-method /><span class="min-h-11 text-[15px]">{label}</span></label>
                    ))}
                  </div>
                </fieldset>
                <label class="field">
                  <span class="meta">Amount received</span>
                  <input name="amount" value={v.amount} inputmode="decimal" autocomplete="off" required class="text-[20px] font-semibold tabular-nums" data-pay-amount />
                  <span class={help}>Balance {pesos(sums.balance)}{payorDue > 0n ? `: ${pesos(patientDue)} from the patient, ${pesos(payorDue)} from ${s.payor_name}` : ''}. Part of it is fine.</span>
                </label>
                <label class="field">
                  <span class="meta" data-pay-ref-label>{REF_LABEL[v.method] ?? 'Reference'}</span>
                  <input name="reference" value={v.reference} maxlength={REF_MAX} autocomplete="off" class="text-[16px]" />
                  <span class={help}>Optional. The number on the GCash, Maya or bank screen.</span>
                </label>
                <div class="grid gap-x-3 gap-y-1.5 sm:grid-cols-2">
                  <label class="field">
                    <span class="meta">Date paid</span>
                    <input type="date" name="paid_on" value={v.paidOn} max={today} required class="text-[16px]" />
                  </label>
                  <label class="field">
                    <span class="meta">BIR receipt no.</span>
                    <input name="bir_ref" value={v.birRef} maxlength={BIR_REF_MAX} autocomplete="off" class="text-[16px]" aria-describedby="bir-help" />
                  </label>
                  <span id="bir-help" class={`${help} sm:col-span-2`}>Optional. From the clinic’s own BIR invoice or receipt booklet or system. Prints on the acknowledgment.</span>
                </div>
                <button type="submit" class="btn btn-primary" data-pay-save>Record payment</button>
              </form>
            </section>
          )}
          {!canPay && !isVoid && (
            <p class="border border-accent/40 bg-accent/10 p-4 text-[15px]">Paid in full.</p>
          )}

          <section class="border border-line bg-surface p-5" aria-labelledby="print-title">
            <h2 id="print-title" class="font-display text-[19px] font-semibold">Print</h2>
            <div class="mt-3 flex flex-wrap gap-2">
              <a href={`${here}print/`} class={small}>Statement, A5</a>
              <a href={`${here}print/?paper=receipt`} class={small}>Statement, 80 mm</a>
            </div>
            <p class={`mt-3 ${help}`}>Each payment has its own acknowledgment, under Payments.</p>
          </section>

          {voider && !isVoid && (
            <details class="border border-line bg-surface p-5" open={openVoid === 'statement'}>
              <summary class={`flex min-h-11 cursor-pointer items-center font-display text-[19px] font-semibold hover:text-accent ${noMarker}`}>Void this statement</summary>
              {live.length > 0 ? (
                <p class="mt-3 text-[14.5px] text-ink-2">{live.length === 1 ? 'A payment is' : `${live.length} payments are`} recorded on it. Void {live.length === 1 ? 'that payment' : 'those'} first, then the statement.</p>
              ) : (
                <form method="post" class="mt-3 grid gap-3">
                  <Csrf />
                  <input type="hidden" name="act" value="void_statement" />
                  <label class="field"><span class="meta">Why</span><input name="reason" required minlength="4" maxlength={REASON_MAX} class="text-[16px]" placeholder="Wrong patient, charged twice" /></label>
                  <button type="submit" class="btn btn-quiet min-h-11 text-caries">Void statement</button>
                  <span class={help}>Its number stays used and shows as void. Charge again if something is still owed.</span>
                </form>
              )}
            </details>
          )}
        </aside>
      </div>

      <p class="mt-12 max-w-[72ch] border-t border-line pt-4 text-[13.5px] text-muted">{NOT_BIR}</p>
    </>
  )}
</ClinicLayout>

<script>
  // Two conveniences: the reference's label follows how it was paid, and
  // choosing HMO or PhilHealth fills in what the payor still owes (or the
  // patient's part, back again) unless the amount was typed by hand.
  const form = document.querySelector<HTMLFormElement>('[data-bill-pay]');
  if (form) {
    const LABEL: Record<string, string> = {
      cash: 'Reference', gcash: 'GCash reference no.', maya: 'Maya reference no.', card: 'Approval no. on the card slip',
      bank_transfer: 'Bank reference', hmo: 'LOA or HMO reference', philhealth: 'PhilHealth reference',
    };
    const amount = form.querySelector<HTMLInputElement>('[data-pay-amount]')!;
    const label = form.querySelector<HTMLElement>('[data-pay-ref-label]')!;
    const payorDue = form.dataset.payorDue ?? '0', patientDue = form.dataset.patientDue ?? '0', balance = form.dataset.balance ?? '0';
    let typed = false;
    amount.addEventListener('input', () => { typed = true; });
    // Just saved: the cursor waits in the amount, selected, so the desk types a
    // part payment or presses Enter for the whole of it. The page scrolls only
    // as far as the Record payment button, keeping the "Saved as" line in view
    // when both fit. An Enter still held from the Save (a repeat, or one in
    // the first moment) does not record a payment.
    if (form.dataset.focus) {
      amount.focus({ preventScroll: true });
      amount.select();
      const btn = form.querySelector<HTMLElement>('[data-pay-save]')!;
      const notice = document.querySelector<HTMLElement>('[data-bill-notice]');
      const header = document.querySelector<HTMLElement>('body > header')?.getBoundingClientRect().height ?? 0;
      const below = btn.getBoundingClientRect().bottom + 12 - window.innerHeight;
      const room = notice ? notice.getBoundingClientRect().top - header - 8 : below;
      if (below > 0) window.scrollBy(0, Math.max(0, Math.min(below, room)));
      const armed = performance.now() + 700;
      amount.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && (e.repeat || (!typed && performance.now() < armed))) e.preventDefault();
      });
    }
    form.addEventListener('change', (e) => {
      const t = e.target as HTMLInputElement;
      if (!t.matches('[data-pay-method]')) return;
      label.textContent = LABEL[t.value] ?? 'Reference';
      if (typed) return;
      const payor = t.value === 'hmo' || t.value === 'philhealth';
      amount.value = payor ? (payorDue !== '0' ? payorDue : balance) : patientDue !== '0' ? patientDue : balance;
    });
    form.addEventListener('submit', () => {
      const btn = form.querySelector<HTMLButtonElement>('[data-pay-save]')!;
      window.setTimeout(() => { btn.disabled = true; btn.textContent = 'Saving…'; }, 0);
    });
  }
</script>
