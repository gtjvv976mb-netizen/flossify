---
// Settings › Photos. The pictures on the clinic's public page: add some, take
// one down, change the order. The bytes go to disk through savePhoto()
// (src/lib/uploads.ts), which re-encodes every upload and drops its
// metadata; the clinic row keeps only the keys, in order, in photo_keys,
// updated inside withClinic() like any other clinic field. The first two keys
// are what /find/<slug>/ shows.
export const prerender = false;

import ClinicLayout from '../../../../layouts/Clinic.astro';
import Csrf from '../../../../components/Csrf.astro';
import { requireWorkspace } from '../../../../lib/workspace';
import { withClinic, type Tx } from '../../../../lib/db';
import { csrfOk, CSRF_MESSAGE } from '../../../../lib/csrf';
import { savePhoto, removePhoto, photoUrl, isUploadKey, UploadRefused } from '../../../../lib/uploads';
import { PHOTO_ALT, photo } from '../../../../data/directory';

const ws = await requireWorkspace(Astro);
if (ws instanceof Response) return ws;
const { clinic, session, branches } = ws;
const canSetUp = session.role === 'owner' || session.role === 'admin';
const MAX_PHOTOS = 8;
const here = Astro.url.pathname;

let error = '';
let notice = '';

const keysNow = () => withClinic(clinic.id, async (tx) => ((await tx.query('select photo_keys from clinic where id = $1', [clinic.id])).rows[0]?.photo_keys ?? []) as string[]);
const audit = (tx: Tx) =>
  tx.query(`insert into audit_log (clinic_id, staff_id, action, entity, entity_id) values ($1, $2, 'clinic.photos', 'clinic', $1)`, [clinic.id, session.staffId]);

if (Astro.request.method === 'POST') {
  if (!canSetUp) return Astro.redirect(here, 303);
  const form = await Astro.request.formData();
  if (!csrfOk(Astro.cookies, form)) error = CSRF_MESSAGE;
  else {
    const action = String(form.get('action') ?? '');
    const key = String(form.get('key') ?? '');

    if (action === 'upload') {
      const files = form.getAll('photos').filter((f): f is File => f instanceof File && f.size > 0);
      const have = await keysNow();
      if (!files.length) error = 'Choose a photo first.';
      else if (have.length >= MAX_PHOTOS) error = `A clinic can have up to ${MAX_PHOTOS} photos. Remove one to add another.`;
      else if (have.length + files.length > MAX_PHOTOS) error = `A clinic can have up to ${MAX_PHOTOS} photos and this branch has ${have.length}, so choose up to ${MAX_PHOTOS - have.length} more.`;
      else {
        // Each file stands on its own: the ones that convert are kept, and each one that does not gets its sentence.
        const added: string[] = [];
        const refused: string[] = [];
        for (const f of files) {
          try { added.push((await savePhoto(clinic.id, f)).key); }
          catch (e) { if (e instanceof UploadRefused) refused.push(e.message); else throw e; }
        }
        if (added.length) {
          await withClinic(clinic.id, async (tx) => {
            await tx.query('update clinic set photo_keys = photo_keys || $2::text[] where id = $1', [clinic.id, added]);
            await audit(tx);
          });
        }
        if (!refused.length) return Astro.redirect(`${here}?added=${added.length}`, 303);
        error = refused.join(' ');
        if (added.length) notice = `Added ${added.length === 1 ? 'one photo' : `${added.length} photos`}.`;
      }
    } else if (action === 'remove' || action === 'up') {
      const have = await keysNow();
      const i = have.indexOf(key);
      if (!key || i < 0) error = 'That photo is already gone.';
      else if (action === 'remove') {
        await withClinic(clinic.id, async (tx) => {
          await tx.query('update clinic set photo_keys = array_remove(photo_keys, $2) where id = $1', [clinic.id, key]);
          await audit(tx);
        });
        // The row no longer points at the files, so they can go. A house still has no files of its own.
        if (isUploadKey(key)) await removePhoto(clinic.id, key);
        return Astro.redirect(`${here}?removed=1`, 303);
      } else {
        if (i > 0) {
          const next = [...have];
          [next[i - 1], next[i]] = [next[i], next[i - 1]];
          await withClinic(clinic.id, async (tx) => {
            await tx.query('update clinic set photo_keys = $2::text[] where id = $1', [clinic.id, next]);
            await audit(tx);
          });
        }
        return Astro.redirect(`${here}?moved=1`, 303);
      }
    }
  }
}

const { area, keys } = await withClinic(clinic.id, async (tx) => {
  const row = (await tx.query('select area, photo_keys from clinic where id = $1', [clinic.id])).rows[0];
  return { area: row?.area as string | null, keys: (row?.photo_keys ?? []) as string[] };
});

const q = Astro.url.searchParams;
if (!notice && !error) {
  const added = Number(q.get('added'));
  if (added > 0) notice = `Added ${added === 1 ? 'one photo' : `${added} photos`}. ${keys.length <= 2 ? 'It is on your public page now.' : 'Move it up to put it on your public page.'}`;
  else if (q.get('removed') === '1') notice = 'Removed.';
  else if (q.get('moved') === '1') notice = 'Moved.';
}

const altFor = (k: string, i: number) => (isUploadKey(k) ? `Photo ${i + 1} of ${clinic.name}` : PHOTO_ALT[photo(k).key]);
---

<ClinicLayout groupId={clinic.group_id} clinic={{ slug: clinic.slug, name: clinic.name, area }} title="Photos" section="settings" staff={{ name: session.name, role: session.role }} branches={branches}>
  <p class="meta"><a href={`/c/${clinic.slug}/settings/`} class="hover:text-ink">Settings</a> &rsaquo; Photos</p>
  <h1 class="mt-3 font-display text-[clamp(1.75rem,4vw,2.5rem)] font-semibold tracking-[-0.02em]">Photos</h1>

  {!canSetUp ? (
    <p class="mt-4 text-[15px] text-ink-2">Only the owner or an admin can change the clinic’s photos.</p>
  ) : (
    <>
      <p class="mt-3 max-w-[64ch] text-[15px] leading-relaxed text-ink-2">
        Photos of the rooms and the equipment, not of people — patients and staff have a right not to be on the internet.
      </p>
      <p class="mt-2 max-w-[64ch] text-[14.5px] text-muted">The first two appear on your public page, in this order. Move up changes the order.</p>

      {notice && <p role="status" class="mt-6 border border-accent/40 bg-accent/10 p-4 text-[14.5px]">{notice}</p>}
      {error && <p role="alert" class="mt-6 border border-caries/40 bg-caries/10 p-4 text-[14.5px]">{error}</p>}

      {keys.length === 0 ? (
        <p class="mt-8 border border-line bg-surface p-5 text-[15px] text-muted">No photos yet. Until you add some, your public page shows two of our own stills of a tray and instruments.</p>
      ) : (
        <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {keys.map((k, i) => (
            <li class="border border-line bg-surface">
              <img src={photoUrl(k, clinic.id, 640)} alt={altFor(k, i)} width="640" height="480" loading="lazy" class="block aspect-[4/3] w-full bg-bg-soft object-cover" />
              <div class="flex flex-wrap items-center justify-between gap-2 border-t border-line px-3 py-2">
                <span class="meta">{String(i + 1).padStart(2, '0')}{i < 2 && ' · Public page'}</span>
                <div class="flex gap-1.5">
                  {i > 0 && (
                    <form method="post">
                      <Csrf />
                      <input type="hidden" name="action" value="up" />
                      <input type="hidden" name="key" value={k} />
                      <button class="btn btn-quiet !px-3 !py-1.5 text-[13px]">Move up</button>
                    </form>
                  )}
                  <form method="post">
                    <Csrf />
                    <input type="hidden" name="action" value="remove" />
                    <input type="hidden" name="key" value={k} />
                    <button class="btn btn-quiet !px-3 !py-1.5 text-[13px]">Remove</button>
                  </form>
                </div>
              </div>
            </li>
          ))}
        </ul>
      )}

      {keys.length >= MAX_PHOTOS ? (
        <p class="mt-8 border-t border-line pt-6 text-[15px] text-ink-2">This branch has its {MAX_PHOTOS} photos. Remove one to add another.</p>
      ) : (
        <form method="post" enctype="multipart/form-data" class="mt-8 grid max-w-[560px] gap-4 border-t border-line pt-6">
          <Csrf />
          <input type="hidden" name="action" value="upload" />
          <label class="field">
            <span class="meta">Add photos</span>
            <input type="file" name="photos" accept="image/jpeg,image/png,image/webp" multiple required />
          </label>
          <p class="text-[13.5px] leading-relaxed text-muted">JPEG, PNG or WebP, up to 8 MB each, {MAX_PHOTOS - keys.length} more at most. We resize each one and drop the camera data, including where it was taken.</p>
          <button type="submit" class="btn btn-primary justify-self-start">Add photos</button>
        </form>
      )}
    </>
  )}
</ClinicLayout>
