---
// One person's page: /c/<slug>/settings/people/<id>/. Everything about one
// owner, dentist or staff member at this branch, in one place — who they are
// and how to reach them, their PRC licence and where its check stands, their
// PTR (the owner or an admin sets it in Edit details; the dentist can set it
// on My page too), the days they sit here and, for a dentist, their hours on those days (040), finance access, their sign-in (a new invitation or
// reset code, disable, enable), and, for someone who sees patients, their
// coming appointments here (read only; the calendar is where they change).
//
// Owner and admin only, as Settings → Team was; a person may always open their
// own page (read only unless they are the owner or an admin; their password is
// on My page). The id must have access to this branch (staff_access), so an id
// from another branch or group is "not on this branch". Every action is the
// Team page's, unchanged, in _lib/people.ts: the same rules (an owner's row by
// an owner only, nobody changes their own role, one email and one mobile per
// account across the service, a new PRC number or name goes back for a check),
// the same audit lines. Every form carries <Csrf />; a post without a matching
// token changes nothing and says so.
export const prerender = false;

import ClinicLayout from '../../../../../layouts/Clinic.astro';
import Pane from '../../../../../components/ws/Pane.astro';
import Chip from '../../../../../components/ws/Chip.astro';
import Icon from '../../../../../components/ws/Icon.astro';
import Avatar from '../../../../../components/ws/Avatar.astro';
import Empty from '../../../../../components/ws/Empty.astro';
import SidePanel from '../../../../../components/ws/SidePanel.astro';
import Csrf from '../../../../../components/Csrf.astro';
import Note from '../_ui/Note.astro';
import Upcoming from '../_ui/Upcoming.astro';
import Email from '../_ui/Email.astro';
import '../_ui/settings.css';
import { requireWorkspace } from '../../../../../lib/workspace';
import { csrfOk, CSRF_MESSAGE } from '../../../../../lib/csrf';
import { USERNAME_MAX } from '../../../../../lib/username';
import { DAYS, DAY_LONG, ago, clinician, dateText, daysText, prcState, signsPapers, spanShort, treats } from '../_lib/common';
import {
  member, scheduleOf, upcomingFor, personAction, personNotice, accountState, reachable, emailOn, prettyPhone,
  SPECIALTIES, EMAIL_MAX, BIO_MAX, bioOf, type ActionRefused, type EditValues, type DaysValues, type BioValues,
} from '../_lib/people';
import { can } from '../../../../../lib/can';
import { listRoles, giveable, mayManage } from '../../../../../lib/roles';
import { PASSWORD_MIN } from '../../../../../lib/auth';
import RoleField from '../_ui/RoleField.astro';
import { ptrChip, ptrDrawn, ptrLine, ptrState, ptrYearOptions, PTR_MAX } from '../../../../../lib/ptr';
import { manilaToday } from '../../../../../lib/health';

const ws = await requireWorkspace(Astro);
if (ws instanceof Response) return ws;
const { clinic, session, branches } = ws;
const canSetUp = can(ws, 'people.manage');
const isOwner = clinic.role_owner;
const id = Astro.params.id ?? '';
const base = `/c/${clinic.slug}/settings/`;
const here = `${base}people/${id}/`;

let t = await member(clinic.id, id);
const self = t?.id === session.staffId;
const allowed = !!t && (canSetUp || self);
if (!t) Astro.response.status = 404;
else if (!allowed) Astro.response.status = 403;

let refused: ActionRefused | null = null;
if (Astro.request.method === 'POST' && t) {
  if (!canSetUp) return Astro.redirect(here, 303);
  const form = await Astro.request.formData();
  if (!csrfOk(Astro.cookies, form)) refused = { error: CSRF_MESSAGE, action: String(form.get('action') ?? '') };
  else {
    const r = await personAction({ clinic, session, cookies: Astro.cookies, site: Astro.site, here }, t, form);
    if (r instanceof Response) return r;
    refused = r;
    t = await member(clinic.id, id);
  }
}

const q = Astro.url.searchParams;
const [sched, upcoming] = t && allowed
  ? await Promise.all([scheduleOf(clinic.id, t.id), treats(t.role) ? upcomingFor(clinic.id, t.id) : Promise.resolve(null)])
  : [[] as { dow: number; from_min: number | null; to_min: number | null }[], null];
const days = sched.map((r) => r.dow);
// Their own hours on a day here (040), for someone who treats: blank is the clinic's hours that day.
const hm = (m: number | null) => (m === null ? '' : `${String(Math.floor(m / 60)).padStart(2, '0')}:${String(m % 60).padStart(2, '0')}`);
const withHours = sched.filter((r) => r.from_min !== null && r.to_min !== null);
const dv: DaysValues = refused?.days ?? {
  dows: days,
  from: Object.fromEntries(sched.map((r) => [r.dow, hm(r.from_min)])),
  to: Object.fromEntries(sched.map((r) => [r.dow, hm(r.to_min)])),
};
const hoursOpen = withHours.length > 0 || !!refused?.days;
// "Tue, Thu · Tue 1–6 pm": the days, then each day that has hours of its own.
const daysMeta = withHours.length
  ? `${daysText(days)} · ${withHours.map((r) => `${DAYS.find(([n]) => n === r.dow)![1]} ${spanShort(r.from_min!, r.to_min!)}`).join(', ')}`
  : daysText(days);
const notice = t && allowed && !refused ? personNotice(q, t, session.staffId) : '';
const doneTo = q.get('done') === 'schedule' ? 'days' : q.get('done') === 'finance' ? 'finance' : ['bio', 'bio-same'].includes(q.get('done') ?? '') ? 'profile' : ['invite', 'reset', 'password', 'disable', 'enable'].includes(q.get('done') ?? '') ? 'signin' : 'head';
// Where a refused action's sentence goes: the pane it came from. A refused edit comes back in its panel.
const errorIn = refused?.edit ? 'edit' : refused?.action === 'finance' ? 'finance' : refused?.action === 'schedule' ? 'days' : refused?.action === 'bio' ? 'profile' : ['invite', 'reset', 'password', 'disable', 'enable'].includes(refused?.action ?? '') ? 'signin' : 'head';
// The public profile's own lines (PDA, practising since, about): what was typed when a save came back, else what is on file.
const bio: BioValues | null = t ? (refused?.bio ?? bioOf(t)) : null;

// What the edit form shows: what was typed when it came back with an error, else what is on file.
const today = manilaToday();
const v: EditValues | null = t ? (refused?.edit ?? { name: t.full_name, username: t.username, role: t.role, roleId: t.role_id, treats: clinician(t.role), phone: t.phone ? prettyPhone(t.phone) : '', email: t.email ?? '', prc: t.prc_licence ?? '', specialty: t.specialty ?? '', ...ptrDrawn({ number: t.ptr_number, year: t.ptr_year }, today) }) : null;
const roleLocked = !!t && (t.role_owner || self);
const showPrc = !!t && !!v && (roleLocked ? !!t.slug : v.treats);
// The PTR fields go with "Treats patients" (RoleField's script shows and hides them with the PRC's); never required.
const showPtr = !!t && !!v && (roleLocked ? signsPapers(t) : v.treats);
const ptrYears = t && v ? ptrYearOptions(today, t.ptr_year, Number(v.ptrYear) || null) : [];
// Their PTR, for the PRC pane: shown to anyone who signs papers, or with a PTR on file.
const ptrNow = t ? { number: t.ptr_number, year: t.ptr_year } : null;
const ptrShown = !!t && (signsPapers(t) || !!t.ptr_number);
const ptrChipNow = ptrNow ? ptrChip(ptrState(ptrNow, today), ptrNow) : null;
// Only people whose role is below yours (src/lib/roles.ts); your own details you may edit, not your role.
const manages = !!t && canSetUp && mayManage(clinic, t, self);
const mayEdit = !!t && canSetUp && (self || manages);
const mayDisable = manages;
// The roles this person may hand out, and the member's own if it is not one of them (so the list shows it).
const roles = t && mayEdit && !roleLocked ? await listRoles(clinic.group_id) : [];
const offered = t ? [...giveable(clinic, roles), ...roles.filter((r) => r.id === t!.role_id && !giveable(clinic, roles).some((g) => g.id === r.id))].sort((a, b) => a.rank - b.rank) : [];
const acct = t ? accountState(t) : null;
const prc = t ? prcState(t) : null;
const financeByRole = !!t && (t.role_owner || t.role_perms.includes('finance.money'));
// The desk has Finances by role (canBill in src/lib/invoices.ts); for them the branch's flag decides the
// claim amounts and claim moves only (canMoneyOf in ../../finances/_claims.ts).
const deskByRole = !!t && !financeByRole && t.role_perms.includes('finance.bill');
const canSend = !!t && reachable(t);
const first = t ? t.full_name.replace(/^Dra?\.?\s+/i, '').split(/\s+/)[0] : '';
// What they practise, for the pills under the name (someone who sees patients).
const practice = t ? (t.specialty ?? (t.practices?.length ? t.practices.join(', ') : 'General dentist')) : '';
---

<ClinicLayout groupId={clinic.group_id} clinic={{ slug: clinic.slug, name: clinic.name }} title={t && allowed ? t.full_name : 'People'} section={canSetUp ? 'people' : 'account'} staff={{ name: session.name, role: session.role }} branches={branches} finance={clinic.can_view_finance} layout="panes" heading>
  {!t || !allowed ? (
    <Pane as="div" label="People" class="max-w-[46rem]">
      <Empty icon="user" text={!t
        ? `No one with that link can open ${clinic.name}. They may have moved to another branch, or the link is cut short.`
        : 'Only the owner or an admin opens other people’s pages. Your own details and password are on My page.'} />
      <div class="set-btn-row mt-3">
        {canSetUp && <a href={`${base}#people`} class="ws-btn ws-btn-quiet"><Icon name="patients" />Everyone at {clinic.name}</a>}
        <a href={`/c/${clinic.slug}/account/`} class="ws-btn ws-btn-quiet"><Icon name="user" />My page</a>
      </div>
    </Pane>
  ) : (
    <div class="set grid gap-4" data-person-page>
      {/* Their name is the page's title, in the top bar (the layout's heading), as on Clinic settings:
          this card is who they are beside it — the avatar, their role and state, how to reach them. */}
      <Pane as="div" class="set-sec" id="head">
        {canSetUp && <a href={`${base}#people`} class="set-back"><Icon name="chevron-left" size={16} />People</a>}
        <div class="set-person">
          <div class="set-person-who set-person-bare">
            <Avatar name={t.full_name} size="lg" />
            <div class="min-w-0">
              <div class="set-person-chips">
                <span class="ws-pill ws-tint-slate">{t.role_name}</span>
                {treats(t.role) && <span class="ws-pill ws-tint-slate whitespace-normal">{practice}</span>}
                <Chip tone={acct!.tone} label={acct!.label} />
                {self && <span class="ws-pill ws-tint-blue">You</span>}
              </div>
              <p class="set-person-facts">
                <span><Icon name="user" size={16} /><span>Signs in as <strong class="font-semibold">{t.username}</strong></span></span>
                <span><Icon name="message" size={16} /><span class="tabular-nums">{t.phone ? prettyPhone(t.phone) : 'No mobile on file'}</span></span>
                <span class="min-w-0"><Icon name="inbox" size={16} />{t.email ? <Email address={t.email} /> : <span>No email on file</span>}</span>
                <span><Icon name="clock" size={16} />{t.disabled_at ? `Disabled ${dateText(t.disabled_at)}` : t.has_password && t.last_seen_at ? `Last seen ${ago(t.last_seen_at)}` : 'Has not signed in yet'}</span>
              </p>
            </div>
          </div>
          {mayEdit && <button type="button" class="ws-btn ws-btn-primary" data-ws-open="edit"><Icon name="user" />Edit details</button>}
          {!canSetUp && self && <a href={`/c/${clinic.slug}/account/`} class="ws-btn ws-btn-quiet"><Icon name="user" />My page</a>}
        </div>
        {notice && doneTo === 'head' && <Note tone="ok" text={notice} class="mt-5" />}
        {refused && errorIn === 'head' && <Note tone="alert" text={refused.error} class="mt-5" refused />}
      </Pane>

      <div class="set-two">
        <div class="set-col">
          {upcoming && (
            <Upcoming rows={upcoming.rows} total={upcoming.total} slug={clinic.slug} title="Coming appointments" emptyText={`Nothing booked for ${self ? 'you' : first} at ${clinic.name} yet.`} />
          )}

          <Pane id="days" icon="calendar" title="Days at this branch" meta={mayEdit ? daysText(days) : daysMeta} class="set-sec">
            <p class="set-intro mb-4">
              {treats(t.role) ? 'The days patients can book them here.' : 'The days they work here.'}
            </p>
            {notice && doneTo === 'days' && <Note tone="ok" text={notice} class="mb-4" />}
            {refused && errorIn === 'days' && <Note tone="alert" text={refused.error} class="mb-4" refused />}
            {mayEdit ? (
              <form method="post" action={here} class="grid gap-4">
                <Csrf />
                <input type="hidden" name="action" value="schedule" />
                <fieldset>
                  <legend class="sr-only">Days {t.full_name} is at {clinic.name}</legend>
                  <div class="set-days">
                    {DAYS.map(([n, label]) => (
                      <label class="set-day"><input type="checkbox" name="dow" value={n} checked={dv.dows.includes(n)} data-days-dow /><span>{label}</span></label>
                    ))}
                  </div>
                </fieldset>
                {treats(t.role) && (
                  <details class="set-more set-days-hours" data-days-hours open={hoursOpen}>
                    <summary>
                      <Icon name="clock" />
                      <span>Hours on those days <span class="set-more-hint">Blank means the clinic’s hours.</span></span>
                      <Icon name="chevron" />
                    </summary>
                    <div class="set-more-body set-dh">
                      {DAYS.map(([n]) => (
                        <div class="set-dh-row" data-days-hours-row={n} data-off={dv.dows.includes(n) ? undefined : ''}>
                          <span class="set-dh-day" aria-hidden="true">{DAY_LONG[n]}</span>
                          <label class="field"><span class="sr-only">{DAY_LONG[n]}: in from</span><input type="time" name={`from[${n}]`} value={dv.from[n] ?? ''} step="900" /></label>
                          <span class="set-dh-dash" aria-hidden="true">–</span>
                          <label class="field"><span class="sr-only">{DAY_LONG[n]}: in until</span><input type="time" name={`to[${n}]`} value={dv.to[n] ?? ''} step="900" /></label>
                        </div>
                      ))}
                      <p class="set-help set-dh-help">Only the days ticked above are saved.</p>
                    </div>
                  </details>
                )}
                <div><button type="submit" class="ws-btn ws-btn-quiet"><Icon name="check" />Save days</button></div>
              </form>
            ) : (
              <p class="set-days-ro" aria-label={`Days here: ${daysText(days)}`}>
                {DAYS.map(([n, label]) => <span class="set-day-ro" data-on={days.includes(n) ? '' : undefined} aria-hidden="true">{label}</span>)}
              </p>
            )}
            {t.slug && days.length === 0 && <p class="set-help mt-3">Not on the public page until they have days here.</p>}
          </Pane>
        </div>

        <div class="set-col">
          {(treats(t.role) || t.prc_licence) && (
            <Pane id="prc" icon="file" title={ptrShown ? 'PRC licence and PTR' : 'PRC licence'} class="set-sec">
              <div class="set-state">
                <Chip tone={prc!.tone} label={prc!.short} icon={prc!.tone === 'accent' ? 'check' : prc!.tone === 'muted' ? undefined : 'alert'} />
                {t.prc_licence && <span class="text-[15px] tabular-nums">Licence no. {t.prc_licence}</span>}
                <p class="text-[14.5px]">{prc!.long}</p>
              </div>
              {t.prc_status === 'mismatch' && t.prc_note && <p class="ws-callout mt-3" data-tone="alert"><Icon name="alert" /><span>Flossify’s note: {t.prc_note}</span></p>}
              {t.slug && (days.length > 0
                ? <a href={`/dentists/${t.slug}/`} target="_blank" rel="noopener" class="set-link mt-1">Public profile<span class="sr-only"> (opens in a new tab)</span><Icon name="arrow-right" size={16} class="set-arrow" /></a>
                : <p class="set-help mt-2">No public profile until they have days here.</p>)}
              {mayEdit && <p class="set-help mt-2">A new number or name goes back for a check. Change them in Edit details.</p>}
              {ptrShown && ptrChipNow && (
                <div class="set-state mt-4">
                  <Chip tone={ptrChipNow.tone} label={ptrChipNow.label} icon={ptrChipNow.tone === 'accent' ? 'check' : ptrChipNow.tone === 'muted' ? undefined : 'alert'} />
                  {ptrLine(ptrNow!) && <span class="text-[15px] tabular-nums">PTR no. {ptrLine(ptrNow!)}</span>}
                </div>
              )}
              {ptrShown && mayEdit && <p class="set-help mt-2">Change the PTR in Edit details. Flossify does not check it: it prints as it is written.</p>}
              {self && !canSetUp && signsPapers(t) && <p class="set-help mt-2"><a href={`/c/${clinic.slug}/account/#ptr`} class="inline-flex min-h-[44px] items-center font-semibold text-[var(--ws-teal-ink)] underline underline-offset-4">Add yours on My page</a></p>}
            </Pane>
          )}

          {/* The public profile's own lines: PDA membership, practising since, a few lines about them (/dentists/<slug>). */}
          {t.slug && bio && (
            <Pane id="profile" icon="user" title="Public profile" meta={t.pda_member ? 'PDA member' : undefined} class="set-sec">
              <p class="set-intro mb-4">What patients read about {self ? 'you' : first} on {self ? 'your' : 'their'} public page, beside the licence.</p>
              {notice && doneTo === 'profile' && <Note tone="ok" text={notice} class="mb-4" />}
              {refused && errorIn === 'profile' && <Note tone="alert" text={refused.error} class="mb-4" refused />}
              {mayEdit ? (
                <form method="post" action={here} class="grid gap-4" data-bio-form>
                  <Csrf />
                  <input type="hidden" name="action" value="bio" />
                  <label class="check"><input type="checkbox" name="pda" checked={bio.pda} /><span>Member of the Philippine Dental Association</span></label>
                  <label class="field sm:max-w-[12rem]">
                    <span class="meta">Practising since</span>
                    <input name="since" value={bio.since} inputmode="numeric" pattern="[0-9]{4}" maxlength="4" autocomplete="off" placeholder="e.g. 2012" />
                  </label>
                  <label class="field">
                    <span class="meta">About {self ? 'you' : first} <span class="font-normal">(optional)</span></span>
                    <textarea name="about" rows="4" maxlength={BIO_MAX}>{bio.about}</textarea>
                    <span class="set-help">A few plain lines: what {self ? 'you' : 'they'} do most, where {self ? 'you' : 'they'} trained, the languages {self ? 'you' : 'they'} speak. Up to {BIO_MAX} characters.</span>
                  </label>
                  <div><button type="submit" class="ws-btn ws-btn-quiet"><Icon name="check" />Save public profile</button></div>
                </form>
              ) : (
                <div class="set-state">
                  <span class:list={['ws-pill', t.pda_member ? 'ws-tint-teal' : 'ws-tint-slate']}>{t.pda_member ? 'PDA member' : 'PDA membership not on file'}</span>
                  <p>{t.practising_since ? `Practising since ${t.practising_since}.` : 'No year on file for when they started practising.'}</p>
                  <p>{t.about ?? 'Nothing written about them yet.'}</p>
                </div>
              )}
            </Pane>
          )}

          <Pane id="finance" icon="wallet" title="Finances" class="set-sec">
            {notice && doneTo === 'finance' && <Note tone="ok" text={notice} class="mb-4" />}
            {refused && errorIn === 'finance' && <Note tone="alert" text={refused.error} class="mb-4" refused />}
            {financeByRole ? (
              <div class="set-state">
                <span class="ws-pill ws-tint-green">Sees Finances, always</span>
                <p>Their role, {t.role_name}, sees balances, payments, the day’s takings and claim amounts at every branch they open.</p>
              </div>
            ) : (
              <>
                {deskByRole ? (
                  <div class="set-state" data-claim-amounts>
                    <span class="ws-pill ws-tint-green">Sees Finances</span>
                    <p>Their role, {t.role_name}, sees balances, payments and the day’s takings, and records payments.</p>
                    <span class:list={['ws-pill', t.can_view_finance ? 'ws-tint-green' : 'ws-tint-slate']}>Claim amounts: {t.can_view_finance ? 'shown' : 'hidden'}</span>
                    <p>{t.can_view_finance
                      ? `${self ? 'You see' : 'They see'} the amounts on HMO and PhilHealth claims, and move claims along.`
                      : `${self ? 'You see' : 'They see'} the claims list and leave notes, but not the amounts, and do not move claims along.`}</p>
                  </div>
                ) : (
                  <div class="set-state">
                    <span class:list={['ws-pill', t.can_view_finance ? 'ws-tint-green' : 'ws-tint-slate']}>{t.can_view_finance ? 'Sees Finances here' : 'No Finances here'}</span>
                    <p>Finances shows balances, payments, the day’s takings and claim amounts at this branch.</p>
                  </div>
                )}
                {isOwner && !self ? (
                  <form method="post" action={here} class="mt-4">
                    <Csrf />
                    <input type="hidden" name="action" value="finance" />
                    <button type="submit" name="sees" value={t.can_view_finance ? '0' : '1'} class="ws-btn ws-btn-quiet">
                      {deskByRole
                        ? (t.can_view_finance ? 'Hide claim amounts' : 'Show claim amounts')
                        : (t.can_view_finance ? 'Hide Finances' : 'Let them see Finances')}
                    </button>
                  </form>
                ) : canSetUp && !isOwner ? (
                  <p class="set-help mt-3">Only an owner changes {deskByRole ? 'who sees claim amounts' : 'who sees Finances'}.</p>
                ) : null}
              </>
            )}
          </Pane>

          <Pane id="signin" icon="logout" title="Sign-in" class="set-sec">
            {notice && doneTo === 'signin' && <Note tone="ok" text={notice} class="mb-4" />}
            {refused && errorIn === 'signin' && <Note tone="alert" text={refused.error} class="mb-4" refused />}
            <div class="set-state">
              {t.disabled_at
                ? <><span class="ws-pill ws-tint-slate">Disabled since {dateText(t.disabled_at)}</span><p>They cannot sign in at any branch.</p></>
                : t.has_password
                  ? <><span class="ws-pill ws-tint-green">Has a password</span><p>{t.password_set_at ? `Set ${dateText(t.password_set_at)}. ` : ''}{t.last_seen_at ? `Last seen ${ago(t.last_seen_at)}.` : 'Has not signed in yet.'}</p></>
                  : <><span class="ws-pill ws-tint-amber">Invited, no password yet</span><p>{t.invited_at ? `The last code went ${ago(t.invited_at)}. ` : ''}A code works for 24 hours.</p></>}
            </div>
            {manages && (
              <div class="set-btn-row mt-4">
                {!t.has_password && !t.disabled_at && canSend && (
                  <form method="post" action={here}><Csrf /><input type="hidden" name="action" value="invite" /><button type="submit" class="ws-btn ws-btn-quiet"><Icon name="message" />Send the invitation again</button></form>
                )}
                {t.has_password && !t.disabled_at && canSend && (
                  <form method="post" action={here}><Csrf /><input type="hidden" name="action" value="reset" /><button type="submit" class="ws-btn ws-btn-quiet"><Icon name="message" />{emailOn() ? 'Send a reset code' : 'Text a reset code'}</button></form>
                )}
                {!t.disabled_at && (
                  <button type="button" class="ws-btn ws-btn-quiet" data-ws-open="set-password"><Icon name="check" />Set a new password</button>
                )}
                {mayDisable && (
                  <form method="post" action={here}><Csrf /><input type="hidden" name="action" value={t.disabled_at ? 'enable' : 'disable'} /><button type="submit" class:list={['ws-btn', t.disabled_at ? 'ws-btn-quiet' : 'ws-btn-danger']}>{t.disabled_at ? 'Enable' : 'Disable'}</button></form>
                )}
              </div>
            )}
            {manages && !t.disabled_at && t.must_change_password && t.has_password && <p class="set-help mt-3">They choose their own password the next time they sign in.</p>}
            {manages && !t.disabled_at && !canSend && !t.has_password && <p class="ws-callout mt-3" data-tone="warn"><Icon name="alert" /><span>No mobile on file, so a code has nowhere to go. Set a password for them, or add a mobile in Edit details.</span></p>}
            {canSetUp && !manages && !self && <p class="set-help mt-3">Only someone whose role is above {t.role_name} changes {first}’s sign-in.</p>}
            {mayDisable && !t.disabled_at && <p class="set-help mt-3">Disable signs them out of every branch at once. Nothing they did is deleted.</p>}
            {self && <p class="set-help mt-3">Your own password is on <a href={`/c/${clinic.slug}/account/`} class="font-semibold text-[var(--ws-teal-ink)] underline underline-offset-4">My page</a>.</p>}
          </Pane>
        </div>
      </div>

      {mayEdit && v && (
        <SidePanel id="edit" title="Edit details" meta={t.full_name} open={!!refused?.edit}>
          {refused?.edit && <Note tone="alert" text={refused.error} class="mb-5" refused />}
          <form method="post" action={here} class="grid gap-4" data-team-form>
            <Csrf />
            <input type="hidden" name="action" value="edit" />
            <label class="field">
              <span class="meta">Full name</span>
              <input name="name" value={v.name} required minlength="2" maxlength="80" autocomplete="off" />
              {t.slug && t.prc_licence && <span class="set-help">As on their PRC ID. A new name goes back for a PRC check.</span>}
            </label>
            <label class="field">
              <span class="meta">Username</span>
              <input name="username" value={v.username} required minlength="3" maxlength={USERNAME_MAX} autocomplete="off" autocapitalize="none" spellcheck="false" />
              <span class="set-help">{self ? 'You sign' : 'They sign'} in with it at flossify.ph/{clinic.slug}. Letters, numbers, dots and dashes.</span>
            </label>
            {roleLocked ? (
              <div class="field">
                <span class="meta">Role</span>
                <p class="set-readonly">{t.role_name}</p>
                <span class="set-help">{t.role_owner ? 'An owner stays an owner.' : 'Ask the owner to change your own role.'}</span>
              </div>
            ) : (
              <RoleField roles={offered} value={v.roleId} treats={v.treats} />
            )}
            <label class="field"><span class="meta">Mobile</span><input name="phone" type="tel" inputmode="numeric" value={v.phone} required={!!t.phone} autocomplete="off" placeholder="0917 000 0000" class="tabular-nums" /><span class="set-help">Invitation and reset codes go here by text.</span></label>
            <label class="field">
              <span class="meta">Email</span>
              <input name="email" type="email" value={v.email} maxlength={EMAIL_MAX} autocomplete="off" autocapitalize="off" spellcheck="false" />
              <span class="set-help">Optional. A new email signs {self ? 'you out on your other devices' : 'them out everywhere'}.</span>
            </label>
            <label class="field" data-team-dentist hidden={!showPrc}>
              <span class="meta">PRC licence</span>
              <input name="prc" inputmode="numeric" value={v.prc} maxlength="10" autocomplete="off" placeholder="0043321" required={showPrc && !roleLocked} data-prc-required={roleLocked ? undefined : ''} class="tabular-nums" />
              <span class="set-help">{t.prc_status === 'mismatch' && t.slug
                ? 'PRC’s records did not match this number. Correct it, or save it as it is to have it checked again.'
                : 'A new number goes back for a check.'}</span>
            </label>
            <label class="field" data-team-dentist hidden={!showPrc}>
              <span class="meta">Specialty</span>
              <select name="specialty">
                <option value="">General dentist</option>
                {SPECIALTIES.map((s) => <option value={s} selected={v.specialty === s}>{s}</option>)}
              </select>
            </label>
            {/* The PTR: never required, so not data-prc-required. [hidden] beats the wrapper's grid (the preflight's !important). */}
            <div class="grid gap-4 sm:grid-cols-[minmax(0,1fr)_9rem]" data-team-dentist hidden={!showPtr}>
              <label class="field">
                <span class="meta">PTR number (optional)</span>
                <input name="ptr" value={v.ptr} inputmode="text" autocapitalize="characters" spellcheck="false" maxlength={PTR_MAX} autocomplete="off" placeholder="e.g. 8123456" class="tabular-nums" />
              </label>
              <label class="field">
                <span class="meta">For the year</span>
                <select name="ptr_year">
                  {v.ptrYear === '' && <option value="" selected>Choose the year…</option>}
                  {ptrYears.map((y) => <option value={y} selected={String(y) === v.ptrYear}>{y}</option>)}
                </select>
              </label>
              <input type="hidden" name="ptr_seen" value={v.ptrSeen} />
              <input type="hidden" name="ptr_year_seen" value={v.ptrYearSeen} />
              <span class="set-help sm:col-span-2">As printed on the receipt, letters included. Renewed by 31 January; one PTR covers the whole country.</span>
            </div>
            <div><button type="submit" class="ws-btn ws-btn-primary w-full"><Icon name="check" />Save changes</button></div>
          </form>
        </SidePanel>
      )}

      {manages && !t.disabled_at && (
        <SidePanel id="set-password" title="Set a new password" meta={t.full_name} open={refused?.action === 'password'}>
          {refused?.action === 'password' && <Note tone="alert" text={refused.error} class="mb-5" refused />}
          <p class="ws-callout mb-5" data-tone="info"><Icon name="info" /><span>Tell {first} the password yourself. Every device {first} is signed in on is signed out, and {first} chooses their own the next time they sign in at flossify.ph/{clinic.slug}.</span></p>
          <form method="post" action={here} class="grid gap-4">
            <Csrf />
            <input type="hidden" name="action" value="password" />
            <input type="text" name="username" value={t.username} autocomplete="off" hidden readonly />
            <div class="field">
              <label for="new-pw" class="meta">New password</label>
              <div class="set-pw">
                <input id="new-pw" type="password" name="password" autocomplete="new-password" minlength={PASSWORD_MIN} required aria-describedby="new-pw-rule" />
                <button type="button" aria-controls="new-pw" aria-pressed="false" data-show>Show</button>
              </div>
              <span id="new-pw-rule" class="set-help">At least {PASSWORD_MIN} characters. A short sentence is easy to pass on.</span>
            </div>
            <div><button type="submit" class="ws-btn ws-btn-primary w-full"><Icon name="check" />Set password</button></div>
          </form>
        </SidePanel>
      )}
    </div>
  )}
</ClinicLayout>

<script>
  // A refused action's sentence is brought into view (a refused edit comes back in its panel, which the
  // shell opens). The role field's own script (RoleField.astro) keeps the PRC fields to people who treat patients.
  // Show a password being typed (Set a new password).
  document.querySelectorAll<HTMLButtonElement>('[data-show]').forEach((btn) => btn.addEventListener('click', () => {
    const input = document.getElementById(btn.getAttribute('aria-controls') ?? '') as HTMLInputElement | null;
    if (!input) return;
    const on = input.type === 'password';
    input.type = on ? 'text' : 'password';
    btn.textContent = on ? 'Hide' : 'Show';
    btn.setAttribute('aria-pressed', String(on));
  }));
  const topBar = document.querySelector<HTMLElement>('[data-ws-top]');
  if (topBar) document.documentElement.style.setProperty('--set-top', `${Math.round(topBar.getBoundingClientRect().height)}px`);
  const refused = [...document.querySelectorAll<HTMLElement>('[data-set-refused]')].find((n) => !n.closest('dialog'));
  if (refused) { refused.closest<HTMLElement>('.set-sec')?.scrollIntoView({ block: 'start' }); refused.focus({ preventScroll: true }); }
  else if (location.hash) document.getElementById(location.hash.slice(1))?.scrollIntoView({ block: 'start' });
  // Hours on those days (040): a day not ticked above is muted (the save reads only the ticked days).
  for (const box of document.querySelectorAll<HTMLInputElement>('[data-days-dow]')) {
    box.addEventListener('change', () => {
      document.querySelector<HTMLElement>(`[data-days-hours-row="${box.value}"]`)?.toggleAttribute('data-off', !box.checked);
    });
  }
  // One-shot notices leave the address, so a reload does not say them again.
  const url = new URL(location.href);
  let changed = false;
  for (const k of ['done', 'via', 'email', 'role', 'prc', 'profile', 'resend', 'closed']) if (url.searchParams.has(k)) { url.searchParams.delete(k); changed = true; }
  if (changed) history.replaceState(history.state, '', url.pathname + url.search + url.hash);
</script>
