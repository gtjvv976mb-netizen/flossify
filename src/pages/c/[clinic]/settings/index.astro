---
// Clinic settings: one page, in the treatment room, in the soft template. A
// list of seven sections (beside the section once the page is wide enough;
// above it below that, with a slim bar under the top bar to change section
// from further down) and one section on screen at a time, each saved on its
// own, each with one teal main action:
//
//   Clinic profile      _lib/profile.ts   (the listing switch, the clinic, how it works, HMOs; TIN under More)
//   Opening hours       _lib/profile.ts
//   Services & prices   _lib/fees.ts      (Edit prices and Add service in side panels)
//   People              _lib/people.ts    (Add person in a side panel; each person has a page, people/<id>/)
//   Photos              _lib/photos.ts
//   Privacy             _lib/privacy.ts
//   Your Flossify plan  _lib/plan.ts      (was "Billing")
//
// Without the script every section shows, one under the other, and the list's
// links jump to them. The address's #section (or any id inside one: #hmos,
// #invoices) picks the section; a refused form's section wins over it.
//
// These were six pages (settings, fees, team, photos, privacy, billing); the
// old addresses redirect to their section, query and all (_lib/common.ts),
// so PayMongo's return to /settings/billing/?paid=<number> still lands.
//
// The owner's and the admin's; everyone else sees one sentence (the tab is
// not in their top bar either). Every form carries <Csrf /> and a `form`
// field naming its section; a post whose token does not match changes
// nothing and comes back to its section with the sentence. A refused form
// comes back drawn with what was typed and the reasons, in its section, or in
// its side panel, open. A saved one redirects to its section with one line.
// Every write goes through withClinic() (RLS) except the group's own rows
// (staff, staff_access, clinic_group), which are keyed on this branch's ids
// that requireWorkspace() has already checked.
export const prerender = false;

import ClinicLayout from '../../../../layouts/Clinic.astro';
import Pane from '../../../../components/ws/Pane.astro';
import Menu from '../../../../components/ws/Menu.astro';
import Icon from '../../../../components/ws/Icon.astro';
import Empty from '../../../../components/ws/Empty.astro';
import SidePanel from '../../../../components/ws/SidePanel.astro';
import ProfileSection from './_ui/ProfileSection.astro';
import HoursSection from './_ui/HoursSection.astro';
import FeesSection from './_ui/FeesSection.astro';
import PeopleSection from './_ui/PeopleSection.astro';
import PhotosSection from './_ui/PhotosSection.astro';
import PrivacySection from './_ui/PrivacySection.astro';
import PlanSection from './_ui/PlanSection.astro';
import './_ui/settings.css';
import { requireWorkspace } from '../../../../lib/workspace';
import { csrfOk, CSRF_MESSAGE } from '../../../../lib/csrf';
import { SECTIONS, isSection, daysText, type SectionId } from './_lib/common';
import { loadClinic, saveClinic, savedProfile, savedHours, heldText, type ClinicRefused } from './_lib/profile';
import { loadFees, saveFees, addFee, emptyAdd, type FeesRefused } from './_lib/fees';
import { listPeople, addPerson, addedText, emptyPerson, emailOn, type AddRefused } from './_lib/people';
import { photoKeys, photoAction, MAX_PHOTOS, type PhotosRefused } from './_lib/photos';
import { loadPrivacy, savePrivacy, savedPrivacy, type PrivacyRefused } from './_lib/privacy';
import { loadPlan } from './_lib/plan';
import { can } from '../../../../lib/can';
import { listRoles, giveable } from '../../../../lib/roles';

const ws = await requireWorkspace(Astro);
if (ws instanceof Response) return ws;
const { clinic, session, branches } = ws;
// Each section is for the people whose role may change it (src/lib/can.ts); the page is for anyone who
// may change at least one. By default that is the owner and the admin, who may change all of them.
const may: Record<SectionId, boolean> = {
  profile: can(ws, 'settings.edit'), hours: can(ws, 'settings.edit'), fees: can(ws, 'settings.edit'),
  people: can(ws, 'people.manage'), photos: can(ws, 'settings.edit'), privacy: can(ws, 'settings.edit'), plan: can(ws, 'plan.pay'),
};
const canSetUp = Object.values(may).some(Boolean);
const shown = SECTIONS.filter((s) => may[s.id]);
const base = `/c/${clinic.slug}/settings/`;
const q = Astro.url.searchParams;

// --- a post: which form, then its handler ---------------------------------------------
type Which = 'profile' | 'hours' | 'legacy' | 'fees' | 'fee-add' | 'person-add' | 'photos' | 'privacy';
const SECTION_OF: Record<Which, SectionId> = { profile: 'profile', hours: 'hours', legacy: 'profile', fees: 'fees', 'fee-add': 'fees', 'person-add': 'people', photos: 'photos', privacy: 'privacy' };
let clinicRefused: ClinicRefused | null = null;
let feesRefused: FeesRefused | null = null;
let addRefused: AddRefused | null = null;
let photosRefused: PhotosRefused | null = null;
let privacyRefused: PrivacyRefused | null = null;

if (Astro.request.method === 'POST') {
  if (!canSetUp) return Astro.redirect(base, 303);
  const form = await Astro.request.formData();
  // The section's own field; else a form drawn before Settings was one page, re-sent here by its
  // old address (?from=); else the old one-page form, which posted profile and hours together.
  const from = q.get('from') ?? '';
  const named = String(form.get('form') ?? '');
  const which: Which = (['profile', 'hours', 'fees', 'fee-add', 'person-add', 'photos', 'privacy'] as const).find((w) => w === named)
    ?? (from === 'fees' ? (form.get('do') === 'add' ? 'fee-add' : 'fees')
      : from === 'team' ? 'person-add'
      : from === 'photos' ? 'photos'
      : from === 'privacy' ? 'privacy'
      : form.has('open[1]') ? 'legacy' : 'profile');
  const section = SECTION_OF[which];
  if (!may[section]) return Astro.redirect(base, 303);
  if (!csrfOk(Astro.cookies, form)) return Astro.redirect(`${base}?stale=${section}#${section}`, 303);
  const who = { clinicId: clinic.id, staffId: session.staffId, base, form };
  let out: Response | object;
  if (which === 'profile' || which === 'hours' || which === 'legacy') {
    const r = await saveClinic({ ...who, data: await loadClinic(clinic.id), parts: { profile: which !== 'hours', hours: which !== 'profile' } });
    out = r; if (!(r instanceof Response)) clinicRefused = r;
  } else if (which === 'fees') {
    const r = await saveFees({ ...who, rows: await loadFees(clinic.id) });
    out = r; if (!(r instanceof Response)) feesRefused = r;
  } else if (which === 'fee-add') {
    const r = await addFee(who);
    out = r; if (!(r instanceof Response)) feesRefused = r;
  } else if (which === 'person-add') {
    const r = await addPerson({ clinic, session, cookies: Astro.cookies, site: Astro.site, base }, form);
    out = r; if (!(r instanceof Response)) addRefused = r;
  } else if (which === 'photos') {
    const r = await photoAction(who);
    out = r; if (!(r instanceof Response)) photosRefused = r;
  } else {
    const r = await savePrivacy({ ...who, groupId: clinic.group_id });
    out = r; if (!(r instanceof Response)) privacyRefused = r;
  }
  if (out instanceof Response) return out;
}

// --- what the page shows -------------------------------------------------------------------
const [data, fees, people, keys, privacy, plan, roles] = canSetUp
  ? await Promise.all([
      loadClinic(clinic.id), loadFees(clinic.id), listPeople(clinic.id), photoKeys(clinic.id),
      loadPrivacy(clinic.id, clinic.group_id), loadPlan({ groupId: clinic.group_id, q }), listRoles(clinic.group_id),
    ])
  : [null, null, null, null, null, null, null];
// The roles this person may hand out on Add member, and the one it starts on: a dentist, else the lowest.
const offered = roles ? giveable(clinic, roles) : [];
const startRole = (offered.find((r) => r.base === 'dentist') ?? offered[offered.length - 1])?.id ?? '';

type N = { tone: 'ok' | 'alert' | 'warn'; text: string };
const notes: Record<SectionId, N[]> = { profile: [], hours: [], fees: [], people: [], photos: [], privacy: [], plan: [] };
const stale = q.get('stale');
if (isSection(stale) && stale !== 'plan') notes[stale].push({ tone: 'alert', text: CSRF_MESSAGE });
if (data && Astro.request.method === 'GET') {
  const saved = q.get('saved');
  const held = q.get('held') === '1';
  // ?saved=1 is what the one-page form said before sections; it was the profile.
  if (saved === 'profile' || saved === 'hours' || saved === '1') notes[saved === 'hours' ? 'hours' : 'profile'].push(held ? { tone: 'warn', text: heldText(data) } : { tone: 'ok', text: 'Saved.' });
  if (saved === 'fees') notes.fees.push({ tone: 'ok', text: 'Saved.' });
  if (q.get('added') === 'fee') notes.fees.push({ tone: 'ok', text: 'Added. It is offered and on your page from now.' });
  if (saved === 'privacy') notes.privacy.push({ tone: 'ok', text: 'Saved.' });
  if (q.get('person') === 'added') {
    const p = people?.find((x) => x.id === q.get('id'));
    notes.people.push({ tone: 'ok', text: addedText(p?.full_name ?? 'them', q.get('via') ?? 'sms', p ? { slug: clinic.slug, username: p.username } : undefined) });
  }
  const ph = q.get('photos');
  const n = Number(q.get('n'));
  if (ph === 'added' && n > 0) notes.photos.push({ tone: 'ok', text: `Added ${n === 1 ? 'one photo' : `${n} photos`}. ${(keys?.length ?? 0) <= 2 ? 'It is on your public page now.' : 'Move it up to put it on your public page.'}` });
  if (ph === 'removed') notes.photos.push({ tone: 'ok', text: 'Removed.' });
  if (ph === 'moved') notes.photos.push({ tone: 'ok', text: 'Moved.' });
}
if (photosRefused?.notice) notes.photos.push({ tone: 'ok', text: photosRefused.notice });

// --- the index: one word per section on where it stands -----------------------------------------
const openDays = data ? data.hours.map((h) => h.dow) : [];
const active = people ? people.filter((p) => !p.disabled_at).length : 0;
const STATUS: Record<SectionId, { text: string; tone?: 'warn' | 'alert' }> = !data ? {} as never : {
  profile: data.c.listed ? { text: 'Listed on Find a clinic' } : { text: 'Not listed yet', tone: 'warn' },
  hours: openDays.length ? { text: daysText(openDays) } : { text: 'No hours yet', tone: 'warn' },
  fees: { text: `${fees!.filter((r) => r.active).length} offered` },
  people: { text: `${active} ${active === 1 ? 'person' : 'people'}` },
  photos: keys!.length ? { text: `${keys!.length} of ${MAX_PHOTOS}` } : { text: 'No photos yet', tone: 'warn' },
  privacy: privacy!.group.dpo_name ? { text: 'Officer named' } : { text: 'No officer named', tone: 'warn' },
  plan: plan ? { text: plan.short, tone: plan.short === 'Overdue' ? 'alert' : plan.short === 'Invoice due' ? 'warn' : undefined } : { text: 'Could not be read now' },
};
// The one section on screen when the page opens: a refused form's, else the one a notice is about
// (the address's #section says the same, and the page's first script follows it), else the profile.
const fromSection = (q.get('stale') ?? q.get('saved') ?? '') as string;
const noticeFor: SectionId | null = q.get('person') === 'added' ? 'people' : q.get('added') === 'fee' ? 'fees' : q.get('photos') ? 'photos'
  : (q.has('paid') || q.has('unpaid') || q.has('pay')) ? 'plan' : null;
const wanted: SectionId = clinicRefused ? clinicRefused.part : feesRefused ? 'fees' : addRefused ? 'people' : photosRefused ? 'photos' : privacyRefused ? 'privacy'
  : isSection(fromSection) ? fromSection : noticeFor ?? 'profile';
const firstOn: SectionId = may[wanted] ? wanted : (shown[0]?.id ?? 'profile');
---

<ClinicLayout groupId={clinic.group_id} clinic={{ slug: clinic.slug, name: clinic.name, area: data?.c.area }} title="Clinic settings" section="settings" staff={{ name: session.name, role: session.role }} branches={branches} finance={clinic.can_view_finance} layout="panes" heading>
  {!canSetUp || !data ? (
    <Pane as="div" label="Clinic settings" class="max-w-[46rem]">
      <Empty icon="settings" text="Clinic settings belong to the owner and the admin. If something here needs changing, ask them." />
      <div class="set-btn-row mt-3">
        <a href={`/c/${clinic.slug}/account/`} class="ws-btn ws-btn-quiet"><Icon name="user" />My page</a>
        <a href={`/c/${clinic.slug}/`} class="ws-btn ws-btn-quiet"><Icon name="dashboard" />Dashboard</a>
      </div>
    </Pane>
  ) : (
    <div class="set set-shell" data-set-page>
      <div class="set-layout">
        <aside class="set-side" aria-label="Clinic settings, sections">
          <Pane as="div" label="Sections" pad="tight">
            <nav class="set-toc" aria-label="Sections of Clinic settings" data-set-toc>
              {shown.map((s) => (
                <a href={`#${s.id}`} class="set-toc-item" data-set-toc-item={s.id} aria-current={s.id === firstOn ? 'location' : undefined}>
                  <span class="set-toc-icon"><Icon name={s.icon} /></span>
                  <span class="set-toc-label">{s.label}</span>
                  <span class="set-toc-note" data-tone={STATUS[s.id].tone}>{STATUS[s.id].text}</span>
                  <span class="set-toc-dirty">Not saved yet</span>
                </a>
              ))}
            </nav>
          </Pane>
        </aside>

        <div class="set-main">
          <div class="set-jump ws-glass" data-set-jump>
            <Menu id="set-jump-menu" align="left" buttonClass="set-jump-btn" label={undefined} wide>
              <Fragment slot="button">
                <Icon name="settings" />
                <span class="set-jump-now" data-set-jump-now>{SECTIONS.find((s) => s.id === firstOn)!.label}</span>
                <span class="text-[13px] font-medium text-muted">Change</span>
                <Icon name="chevron" />
              </Fragment>
              <p class="ws-menu-head">Clinic settings</p>
              {shown.map((s) => (
                <a class="ws-menu-item" href={`#${s.id}`} data-set-toc-item={s.id} aria-current={s.id === firstOn ? 'location' : undefined}>
                  <span class="ws-menu-icon"><Icon name={s.icon} /></span>
                  <span class="ws-menu-words">{s.label}<span class="ws-menu-hint">{STATUS[s.id].text}</span><span class="set-toc-dirty">Not saved yet</span></span>
                </a>
              ))}
            </Menu>
          </div>

          {may.profile && <ProfileSection
            base={base} data={data} welcome={q.get('welcome') === '1'} staffCount={active} on={firstOn === 'profile'}
            v={clinicRefused?.profile ?? savedProfile(data)}
            problems={clinicRefused?.part === 'profile' ? clinicRefused.problems : []}
            notes={notes.profile}
          />}
          {may.hours && <HoursSection
            base={base} on={firstOn === 'hours'}
            days={clinicRefused?.hours ?? savedHours(data)}
            problems={clinicRefused?.part === 'hours' ? clinicRefused.problems : []}
            notes={notes.hours}
          />}
          {may.fees && <FeesSection
            base={base} clinicName={clinic.name} rows={fees!} on={firstOn === 'fees'}
            keep={feesRefused?.kind === 'table' ? feesRefused.keep : null}
            problems={feesRefused?.kind === 'table' ? feesRefused.problems : []}
            add={feesRefused?.kind === 'add' ? feesRefused.add : emptyAdd()}
            addProblems={feesRefused?.kind === 'add' ? feesRefused.problems : []}
            notes={notes.fees}
          />}
          {may.people && <PeopleSection
            base={base} clinicName={clinic.name} slug={clinic.slug} roles={offered} people={people!} me={session.staffId} isOwner={clinic.role_owner} emailOn={emailOn()} on={firstOn === 'people'}
            add={addRefused?.add ?? { ...emptyPerson(startRole), treats: offered.find((r) => r.id === startRole)?.base === 'dentist' }} addError={addRefused?.error ?? ''}
            notes={notes.people} highlight={q.get('person') === 'added' ? (q.get('id') ?? '') : ''}
          />}
          {may.photos && <PhotosSection base={base} clinicId={clinic.id} clinicName={clinic.name} keys={keys!} error={photosRefused?.error ?? ''} notes={notes.photos} on={firstOn === 'photos'} />}
          {may.privacy && <PrivacySection base={base} data={privacy!} v={privacyRefused?.posted ?? savedPrivacy(privacy!)} problems={privacyRefused?.problems ?? []} notes={notes.privacy} on={firstOn === 'privacy'} />}
          {may.plan && <PlanSection v={plan} slug={clinic.slug} on={firstOn === 'plan'} />}
        </div>
      </div>

      {/* Asked when a form is sent while another section has changes not saved yet; the script fills the names. */}
      <SidePanel id="set-unsaved" title="Changes not saved yet" meta="Clinic settings">
        <p class="ws-callout" data-tone="warn"><Icon name="alert" /><span id="set-unsaved-what" data-unsaved-what>Another section has changes you have not saved. Each section saves on its own, so going on drops them.</span></p>
        <div class="mt-6 grid gap-3">
          <button type="button" class="ws-btn ws-btn-primary w-full" data-unsaved-back>Go back to them</button>
          <button type="button" class="ws-btn ws-btn-quiet w-full" data-unsaved-go>Go on without them</button>
        </div>
        <p class="set-help mt-4">Going back keeps everything you typed.</p>
      </SidePanel>

      {/* Before the first paint: one section at a time, the one the address names (#hours, #hmos …)
          unless the server brought back a refused form, which it has put on screen already. */}
      <script is:inline>
        (function () {
          var page = document.querySelector('[data-set-page]');
          if (!page) return;
          page.setAttribute('data-one', '');
          var refused = Array.prototype.some.call(page.querySelectorAll('[data-set-refused]'), function (n) { return !n.closest('dialog'); });
          var id = location.hash.slice(1);
          try { id = decodeURIComponent(id); } catch (e) {}
          var el = id && !refused ? document.getElementById(id) : null;
          var panel = el && el.closest('[data-set-panel]');
          if (!panel) return;
          page.querySelectorAll('[data-set-panel]').forEach(function (p) { if (p === panel) p.setAttribute('data-on', ''); else p.removeAttribute('data-on'); });
          page.querySelectorAll('[data-set-toc-item]').forEach(function (a) { if (a.getAttribute('data-set-toc-item') === panel.getAttribute('data-set-panel')) a.setAttribute('aria-current', 'location'); else a.removeAttribute('aria-current'); });
        })();
      </script>
    </div>
  )}
</ClinicLayout>

<script>
  // Conveniences the server does not need; without this script every section shows, one under the
  // other, and every form still posts and saves.
  //  - one section at a time: a link to any id on the page (the list, the slim bar, "Go" in the
  //    profile's checklist) shows the section that holds it, brings it into view and puts focus there
  //    (the title, or the field it names); so does a new #hash from outside (the sidebar's plan line);
  //  - below the wide layout the list folds into a slim bar under the top bar once it has scrolled away;
  //  - a section with changes not saved yet says so, in the section and in the list (a form the server
  //    refused counts: what it shows was typed, not saved); another section's Save asks first in the
  //    page's own panel, naming them, and the browser asks before leaving the page;
  //  - the about counter; time fields grey out while a day is ticked closed (the server treats a
  //    closed day as closed whatever the times say);
  //  - PRC and specialty show for dentists only in Add person (the server checks the same rule);
  //  - Edit prices opens at the service that was tapped;
  //  - a refused form is brought into view, and one-shot notices leave the address.
  const page = document.querySelector<HTMLElement>('[data-set-page]');
  const topBar = document.querySelector<HTMLElement>('[data-ws-top]');
  const root = document.documentElement;

  // The top bar's height, for the sticky list and the sections' scroll margin.
  const measure = () => { if (topBar) root.style.setProperty('--set-top', `${Math.round(topBar.getBoundingClientRect().height)}px`); };
  measure();
  if (topBar && 'ResizeObserver' in window) new ResizeObserver(measure).observe(topBar);

  if (page) {
    const panels = [...page.querySelectorAll<HTMLElement>('[data-set-panel]')];
    const items = [...page.querySelectorAll<HTMLElement>('[data-set-toc-item]')];
    const toc = page.querySelector<HTMLElement>('[data-set-toc]');
    const jump = page.querySelector<HTMLElement>('[data-set-jump]');
    const jumpNow = page.querySelector<HTMLElement>('[data-set-jump-now]');
    const label = (id: string) => page.querySelector<HTMLElement>(`.set-toc [data-set-toc-item="${id}"] .set-toc-label`)?.textContent ?? '';
    const current = () => panels.find((p) => p.hasAttribute('data-on'))?.dataset.setPanel ?? panels[0]?.dataset.setPanel ?? '';
    const show = (id: string) => {
      for (const p of panels) p.toggleAttribute('data-on', p.dataset.setPanel === id);
      for (const a of items) {
        if (a.dataset.setTocItem === id) a.setAttribute('aria-current', 'location');
        else a.removeAttribute('aria-current');
      }
      if (jumpNow) jumpNow.textContent = label(id);
    };
    show(current());

    // The slim bar: shown once the list has gone up under the top bar (it is display: none in the wide layout).
    const topOf = () => parseFloat(getComputedStyle(root).getPropertyValue('--set-top')) || 64;
    const spy = () => {
      if (!jump || !toc) return;
      jump.toggleAttribute('data-show', getComputedStyle(jump).display !== 'none' && toc.getBoundingClientRect().bottom < topOf());
    };
    let ticking = false;
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(() => { ticking = false; spy(); }); } }, { passive: true });
    addEventListener('resize', spy);

    // Show the section that holds this id, bring the id into view and put focus there: a section's
    // title, the field a link names (#about), or the id itself.
    const go = (id: string, smooth = true) => {
      const el = id ? document.getElementById(id) : null;
      const panel = el?.closest<HTMLElement>('[data-set-panel]');
      if (!el || !panel || !page.contains(panel)) return false;
      show(panel.dataset.setPanel!);
      el.scrollIntoView({ behavior: smooth ? 'smooth' : 'auto', block: 'start' });
      const to = el.matches('.ws-pane')
        ? el.querySelector<HTMLElement>('.ws-pane-title') ?? el
        : el.matches('input, select, textarea') ? el : el.querySelector<HTMLElement>('input:not([type="hidden"]):not(:disabled), select, textarea') ?? el;
      if (!to.matches('input, select, textarea, a, button') && !to.hasAttribute('tabindex')) to.setAttribute('tabindex', '-1');
      to.focus({ preventScroll: true });
      history.replaceState(history.state, '', `${location.pathname}${location.search}#${id}`);
      requestAnimationFrame(spy);
      return true;
    };
    page.addEventListener('click', (e) => {
      const a = (e.target as Element).closest<HTMLAnchorElement>('a[href^="#"]');
      if (!a || e.defaultPrevented || e.metaKey || e.ctrlKey || e.shiftKey) return;
      if (!go(a.getAttribute('href')!.slice(1))) return;
      e.preventDefault();
      // A link in the slim bar's list: close the list on the way.
      const menu = a.closest<HTMLElement>('[data-ws-menu]');
      if (menu) {
        const pop = menu.querySelector<HTMLElement>(':scope > .ws-menu-pop');
        if (pop) pop.hidden = true;
        menu.querySelector<HTMLButtonElement>(':scope > button')?.setAttribute('aria-expanded', 'false');
      }
    });
    // A #section link from outside the page (the sidebar's plan line) while the page is open.
    addEventListener('hashchange', () => { go(decodeURIComponent(location.hash.slice(1))); });

    // Changes not saved yet.
    const forms = [...page.querySelectorAll<HTMLFormElement>('form[data-set-form]')];
    const snap = (f: HTMLFormElement) => [...new FormData(f)].filter(([k]) => k !== '_csrf')
      .map(([k, v]) => `${k}=${v instanceof File ? `${v.name}:${v.size}` : v}`).join('&');
    const initial = new Map(forms.map((f) => [f, snap(f)]));
    const dirty = new Set<HTMLFormElement>();
    // A form the server refused came back drawn with what was typed, none of it saved: changed from the start.
    const refusedForms = new Set(forms.filter((f) => f.querySelector('[data-set-refused]')));
    const mark = (f: HTMLFormElement) => {
      const is = refusedForms.has(f) || snap(f) !== initial.get(f);
      if (is) dirty.add(f); else dirty.delete(f);
      const id = f.dataset.setForm!;
      f.querySelectorAll<HTMLElement>('[data-set-dirty-note]').forEach((n) => { n.hidden = !is; });
      page.querySelectorAll<HTMLElement>(`[data-set-dirty-for="${id}"]`).forEach((n) => { n.hidden = !is; });
      page.querySelectorAll<HTMLElement>(`[data-set-toc-item="${id}"]`).forEach((a) => { if (is) a.dataset.dirty = ''; else delete a.dataset.dirty; });
    };
    for (const f of forms) {
      f.addEventListener('input', () => mark(f));
      f.addEventListener('change', () => mark(f));
    }

    // A Save (or any form on this page) pressed while another section has changes not saved yet: the
    // page asks, in its own panel, naming those sections — go back to them, or go on and drop them.
    // The browser's own "Leave site?" is kept for leaving the page (a link, a tab, back, reload).
    let sending: HTMLFormElement | null = null;
    let dropping = false;
    let confirmed: HTMLFormElement | null = null;
    let pending: { form: HTMLFormElement; submitter: HTMLElement | null; back: string } | null = null;
    const ask = document.getElementById('set-unsaved') as HTMLDialogElement | null;
    const askWhat = ask?.querySelector<HTMLElement>('[data-unsaved-what]');
    const askBack = ask?.querySelector<HTMLButtonElement>('[data-unsaved-back]');
    const askGo = ask?.querySelector<HTMLButtonElement>('[data-unsaved-go]');
    document.addEventListener('submit', (e) => {
      const f = e.target as HTMLFormElement;
      if (f === confirmed) { confirmed = null; sending = f; dropping = true; return; }
      const others = forms.filter((d) => dirty.has(d) && d !== f);
      if (!others.length || !page.contains(f) || !ask || !window.ws) { sending = f; return; }
      e.preventDefault();
      const submitter = (e as SubmitEvent).submitter ?? null;
      const ids = others.map((d) => d.dataset.setForm!);
      const names = ids.map(label);
      const own = f.dataset.setForm;
      pending = { form: f, submitter, back: ids[0] };
      if (askWhat) {
        askWhat.replaceChildren();
        names.forEach((n, i) => {
          if (i) askWhat.append(i === names.length - 1 ? ' and ' : ', ');
          const b = document.createElement('strong'); b.textContent = n; askWhat.append(b);
        });
        askWhat.append(` ${names.length === 1 ? 'has' : 'have'} changes you have not saved. Each section saves on its own, so going on drops ${names.length === 1 ? 'them' : 'those changes'}.`);
      }
      if (askBack) askBack.textContent = `Go back to ${names[0]}`;
      // "Save Opening hours only" for a section's Save; otherwise the button's own words: "Remove anyway", "Add service anyway".
      const shown = (el: HTMLElement | null) => { if (!el) return ''; const c = el.cloneNode(true) as HTMLElement; c.querySelectorAll('.sr-only').forEach((n) => n.remove()); return (c.textContent ?? '').replace(/\s+/g, ' ').trim(); };
      if (askGo) askGo.textContent = own && own !== 'photos' ? `Save ${label(own)} only` : `${shown(submitter) || 'Go on'} anyway`;
      window.ws.openPanel('set-unsaved', submitter ?? f);
    }, true);
    askGo?.addEventListener('click', () => {
      if (!pending) return;
      const { form, submitter } = pending;
      pending = null;
      confirmed = form;
      if (submitter instanceof HTMLButtonElement || submitter instanceof HTMLInputElement) form.requestSubmit(submitter);
      else form.requestSubmit();
    });
    askBack?.addEventListener('click', () => {
      if (!pending || !ask || !window.ws) return;
      const { form, back } = pending;
      pending = null;
      // A form in a side panel (Add service, Add person, Edit prices) keeps what was typed; its panel closes too.
      const host = form.closest('dialog');
      const last = host instanceof HTMLDialogElement && host.open ? host : ask;
      last.addEventListener('ws:panel-close', () => {
        go(back);
        // The changes are in a side panel (Edit prices): open it again, as it was left.
        const where = forms.find((x) => x.dataset.setForm === back)?.closest('dialog');
        if (where instanceof HTMLDialogElement && !where.open) window.ws?.openPanel(where.id);
      }, { once: true });
      window.ws.closePanel(ask);
      if (last !== ask) window.ws.closePanel(last);
    });
    ask?.addEventListener('ws:panel-close', () => { pending = null; });
    // Back to this page from the history (the browser kept it): nothing is on its way out any more.
    addEventListener('pageshow', (e) => { if (e.persisted) { dropping = false; sending = null; confirmed = null; if (ask?.open) ask.close(); } });
    addEventListener('beforeunload', (e) => {
      if (dropping) return;
      const lost = [...dirty].filter((f) => f !== sending);
      sending = null;
      if (lost.length) { e.preventDefault(); e.returnValue = ''; }
    });

    // The about counter, and closed days.
    const about = page.querySelector<HTMLTextAreaElement>('[data-about-field]');
    const count = page.querySelector<HTMLElement>('[data-about-count]');
    about?.addEventListener('input', () => { if (count) count.textContent = String(about.value.length); });
    for (const row of page.querySelectorAll<HTMLElement>('[data-day-row]')) {
      const closed = row.querySelector<HTMLInputElement>('[data-day-closed]');
      const times = row.querySelectorAll<HTMLInputElement>('input[type="time"]');
      if (!closed) continue;
      const sync = () => { for (const t of times) t.disabled = closed.checked; if (closed.checked) row.dataset.closed = ''; else delete row.dataset.closed; };
      closed.addEventListener('change', sync);
      sync();
    }
    // The snapshot is taken after the closed days are synced, so a disabled time field is not a change.
    for (const f of forms) initial.set(f, snap(f));
    for (const f of refusedForms) mark(f);

    // Edit prices opens at the service that was tapped (the whole guide is one form, one Save).
    const prices = document.getElementById('fees-edit');
    prices?.addEventListener('ws:panel-open', (e) => {
      const opener = (e as CustomEvent<{ opener: Element | null }>).detail?.opener;
      const row = opener?.closest<HTMLElement>('[data-fee-row]')?.dataset.feeRow;
      prices.querySelectorAll('[data-focus]').forEach((n) => n.removeAttribute('data-focus'));
      const block = row ? prices.querySelector<HTMLElement>(`[data-fee-edit="${row}"]`) : null;
      requestAnimationFrame(() => {
        if (!block) { prices.querySelector('.ws-panel-inner')?.scrollTo({ top: 0 }); return; }
        block.dataset.focus = '';
        block.scrollIntoView({ block: 'start' });
        block.querySelector<HTMLInputElement>('input')?.focus({ preventScroll: true });
      });
    });

    // Where to start: a refused form (not one in a side panel: the shell opens that), else the address's #id.
    const refused = [...page.querySelectorAll<HTMLElement>('[data-set-refused]')].find((n) => !n.closest('dialog'));
    const target = refused ?? (location.hash ? document.getElementById(decodeURIComponent(location.hash.slice(1))) : null);
    if (target && page.contains(target)) {
      requestAnimationFrame(() => {
        target.scrollIntoView({ block: refused ? 'center' : 'start' });
        if (refused) refused.focus({ preventScroll: true });
        spy();
      });
    } else spy();

    // One-shot notices: the line stays on screen, the address loses it, so a reload does not say it again.
    const url = new URL(location.href);
    let changed = false;
    for (const k of ['saved', 'held', 'added', 'stale', 'person', 'via', 'id', 'photos', 'n', 'from']) if (url.searchParams.has(k)) { url.searchParams.delete(k); changed = true; }
    if (changed) history.replaceState(history.state, '', url.pathname + (url.search ? url.search : '') + url.hash);
  }
</script>
