---
// People: the owner, the dentists and the staff at this branch — an avatar,
// the name, their role and days, and one status — each a row that opens their
// own page. Add member opens in a side panel: a name, a username, a role and a
// first password the member changes at their first sign-in (or, with no
// password, an invitation code by text). A refused add comes back in it with
// the reason and what was typed — never the password.
import Pane from '../../../../../components/ws/Pane.astro';
import SidePanel from '../../../../../components/ws/SidePanel.astro';
import Chip from '../../../../../components/ws/Chip.astro';
import Icon from '../../../../../components/ws/Icon.astro';
import Avatar from '../../../../../components/ws/Avatar.astro';
import Csrf from '../../../../../components/Csrf.astro';
import Note from './Note.astro';
import RoleField from './RoleField.astro';
import { DAYS, daysText, prcState, treats } from '../_lib/common';
import { SPECIALTIES, EMAIL_MAX, accountState, type Person, type AddValues } from '../_lib/people';
import { USERNAME_MAX } from '../../../../../lib/username';
import { PASSWORD_MIN } from '../../../../../lib/auth';
import type { Role } from '../../../../../lib/roles';

interface Props {
  base: string;
  clinicName: string;
  slug: string;
  /** The roles the person acting may hand out (src/lib/roles.ts). */
  roles: Role[];
  people: (Person & { days: number[] })[];
  me: string;
  isOwner: boolean;
  emailOn: boolean;
  add: AddValues;
  addError: string;
  notes: { tone: 'ok' | 'alert' | 'warn'; text: string }[];
  highlight: string;
  on: boolean;
}
const { base, clinicName, slug, roles, people, me, isOwner, emailOn, add, addError, notes, highlight, on } = Astro.props;
const active = people.filter((p) => !p.disabled_at).length;

// One status per person: what needs doing first (disabled, invited, a PRC licence to sort out), else Active.
const statusOf = (p: Person) => {
  const acct = accountState(p);
  if (p.disabled_at || !p.has_password) return { tone: acct.tone, label: acct.label };
  if (treats(p.role)) {
    const prc = prcState(p);
    if (prc.tone === 'alert') return { tone: 'alert' as const, label: p.prc_licence ? 'PRC did not match' : 'No PRC licence' };
    if (prc.tone === 'warn') return { tone: 'warn' as const, label: 'PRC check pending' };
  }
  return { tone: acct.tone, label: acct.label };
};
---

<div class="set-panel" data-set-panel="people" data-on={on ? '' : undefined}>
<Pane id="people" icon="patients" title="People" pad="none" class="set-sec">
  <Fragment slot="actions">
    {roles.length > 0 && <button type="button" class="ws-btn ws-btn-primary" data-ws-open="add-person"><Icon name="plus" />Add member</button>}
  </Fragment>
  <div class="px-6 pt-4 max-md:px-4">
    <p class="set-intro mt-0">Everyone who can open {clinicName}: {active} active{people.length > active ? `, ${people.length - active} disabled` : ''}. Open a person to change their days, access or sign-in.</p>
    {notes.length > 0 && <div class="set-notes mt-4">{notes.map((n) => <Note tone={n.tone} text={n.text} />)}</div>}
  </div>
  <ul class="set-list mt-3 border-t border-[var(--ws-hair)]" aria-label={`People at ${clinicName}`}>
    {people.map((p) => {
      const st = statusOf(p);
      return (
        <li>
          <div class="set-row" data-person={p.id} data-new={highlight === p.id ? '' : undefined}>
            <Avatar name={p.full_name} />
            <span class="min-w-0">
              <a href={`${base}people/${p.id}/`} class="set-row-a set-row-name">{p.full_name}</a>
              {p.id === me && <span class="ws-pill ws-tint-slate set-you">You</span>}
              <span class="set-row-sub">{p.role_name} · {daysText(p.days)}</span>
            </span>
            <span class="set-row-end">
              <Chip tone={st.tone} label={st.label} />
              <Icon name="chevron-right" class="set-go" />
            </span>
          </div>
        </li>
      );
    })}
  </ul>
</Pane>
</div>

<SidePanel id="add-person" title="Add a member" meta="People" open={Boolean(addError)}>
  <p class="ws-callout mb-5" data-tone="info">
    <Icon name="user" />
    <span>They sign in at flossify.ph/{slug}/sign-in with the username and password you set here, and choose their own password the first time.</span>
  </p>
  {addError && <Note tone="alert" text={addError} class="mb-5" refused />}
  <form method="post" action={base} class="grid gap-4" data-team-form>
    <Csrf />
    <input type="hidden" name="form" value="person-add" />
    <input type="hidden" name="action" value="add" />
    <label class="field"><span class="meta">Full name</span><input name="name" value={add.name} required maxlength="80" autocomplete="off" placeholder="Dr. Ana Reyes" data-team-name /></label>
    <label class="field">
      <span class="meta">Username</span>
      <input name="username" value={add.username} required minlength="3" maxlength={USERNAME_MAX} autocomplete="off" autocapitalize="none" spellcheck="false" placeholder="ana.reyes" data-team-username />
      <span class="set-help">What they type to sign in. Letters, numbers, dots and dashes.</span>
    </label>
    <div class="field">
      <label for="add-pw" class="meta">First password</label>
      <div class="set-pw">
        <input id="add-pw" type="password" name="password" autocomplete="new-password" minlength={PASSWORD_MIN} aria-describedby="add-pw-help" />
        <button type="button" aria-controls="add-pw" aria-pressed="false" data-show>Show</button>
      </div>
      <span id="add-pw-help" class="set-help">At least {PASSWORD_MIN} characters; tell them yourself. {emailOn ? 'Or leave it empty and we send them a code by text and email to choose their own.' : 'Or leave it empty and we text them a code to choose their own.'}</span>
    </div>
    <RoleField roles={roles} value={add.roleId} treats={add.treats} />
    <label class="field" data-team-dentist hidden={!add.treats}>
      <span class="meta">PRC licence</span>
      <input name="prc" inputmode="numeric" value={add.prc} maxlength="10" autocomplete="off" placeholder="0043321" required={add.treats} data-prc-required class="tabular-nums" />
      <span class="set-help">Flossify checks it with PRC. Until then their public profile says “PRC check pending”.</span>
    </label>
    <label class="field" data-team-dentist hidden={!add.treats}>
      <span class="meta">Specialty</span>
      <select name="specialty">
        <option value="">General dentist</option>
        {SPECIALTIES.map((s) => <option value={s} selected={add.specialty === s}>{s}</option>)}
      </select>
    </label>
    <label class="field"><span class="meta">Mobile</span><input name="phone" type="tel" inputmode="numeric" value={add.phone} autocomplete="off" placeholder="0917 000 0000" class="tabular-nums" /><span class="set-help">Optional. Reset codes go here by text.</span></label>
    <label class="field"><span class="meta">Email</span><input name="email" type="email" value={add.email} maxlength={EMAIL_MAX} autocomplete="off" autocapitalize="off" spellcheck="false" /><span class="set-help">Optional. It works for signing in too.</span></label>
    <fieldset>
      <legend class="meta">Days at this branch</legend>
      <div class="set-days mt-2">
        {DAYS.map(([n, label]) => (
          <label class="set-day"><input type="checkbox" name="dow" value={n} checked={add.days.includes(n)} /><span>{label}</span></label>
        ))}
      </div>
    </fieldset>
    {isOwner && (
      <label class="check set-check items-start" data-team-finance>
        <input type="checkbox" name="finance" checked={add.finance} />
        <span data-finance-for="desk">Sees claim amounts (their role already has Finances)</span>
        <span data-finance-for="other">Sees money: balances, payments, the day’s takings and claim amounts</span>
      </label>
    )}
    <div><button type="submit" class="ws-btn ws-btn-primary w-full"><Icon name="plus" />Add member</button></div>
  </form>
</SidePanel>

<script>
  // Show a password being typed; and a username made from the name until someone types one.
  document.querySelectorAll<HTMLButtonElement>('#add-person [data-show]').forEach((btn) => btn.addEventListener('click', () => {
    const input = document.getElementById(btn.getAttribute('aria-controls') ?? '') as HTMLInputElement | null;
    if (!input) return;
    const on = input.type === 'password';
    input.type = on ? 'text' : 'password';
    btn.textContent = on ? 'Hide' : 'Show';
    btn.setAttribute('aria-pressed', String(on));
  }));
  const name = document.querySelector<HTMLInputElement>('[data-team-name]');
  const user = document.querySelector<HTMLInputElement>('[data-team-username]');
  if (name && user) {
    let typed = !!user.value;
    user.addEventListener('input', () => { typed = true; });
    name.addEventListener('input', () => {
      if (typed) return;
      user.value = name.value.normalize('NFKD').replace(/[\u0300-\u036f]/g, '').toLowerCase()
        .replace(/^dra?\.?\s+/, '').trim().split(/\s+/).filter(Boolean).slice(0, 2).join('.').replace(/[^a-z0-9._-]/g, '').slice(0, 32);
    });
  }
</script>
