---
// Photos: the pictures on the clinic's public page, in order (the first two
// are on the page), each with Move up and Remove, and the upload under them.
import Pane from '../../../../../components/ws/Pane.astro';
import Icon from '../../../../../components/ws/Icon.astro';
import Empty from '../../../../../components/ws/Empty.astro';
import Csrf from '../../../../../components/Csrf.astro';
import Note from './Note.astro';
import { photoUrl, isUploadKey } from '../../../../../lib/uploads';
import { PHOTO_ALT, photo } from '../../../../../data/directory';
import { MAX_PHOTOS } from '../_lib/photos';

interface Props {
  base: string;
  clinicId: string;
  clinicName: string;
  keys: string[];
  error: string;
  notes: { tone: 'ok' | 'alert' | 'warn'; text: string }[];
  on: boolean;
}
const { base, clinicId, clinicName, keys, error, notes, on } = Astro.props;
const altFor = (k: string, i: number) => (isUploadKey(k) ? `Photo ${i + 1} of ${clinicName}` : PHOTO_ALT[photo(k).key]);
---

<div class="set-panel" data-set-panel="photos" data-on={on ? '' : undefined}>
<Pane id="photos" icon="upload" title="Photos" class="set-sec">
  <p class="set-intro">Rooms and equipment only, never people. The first two show on your public page.</p>
  {(notes.length > 0 || error) && (
    <div class="set-notes mt-5">
      {notes.map((n) => <Note tone={n.tone} text={n.text} />)}
      {error && <Note tone="alert" text={error} refused />}
    </div>
  )}

  {keys.length === 0 ? (
    <Empty icon="upload" class="mt-3" text="No photos yet. Until you add some, your page shows two of our own pictures of a tray and instruments." />
  ) : (
    <ul class="set-photos mt-5">
      {keys.map((k, i) => (
        <li class="set-photo">
          <img src={photoUrl(k, clinicId, 640)} alt={altFor(k, i)} width="640" height="480" loading="lazy" />
          <div class="set-photo-foot">
            {i < 2 ? <span class="ws-pill ws-tint-teal"><Icon name="check" size={14} />On your page</span> : <span class="text-[13px] text-muted">Photo {i + 1}</span>}
            <div class="set-btn-row">
              {i > 0 && (
                <form method="post" action={base}>
                  <Csrf />
                  <input type="hidden" name="form" value="photos" />
                  <input type="hidden" name="action" value="up" />
                  <input type="hidden" name="key" value={k} />
                  <button class="ws-btn ws-btn-quiet ws-btn-sm px-3">Move up<span class="sr-only">: photo {i + 1}</span></button>
                </form>
              )}
              <form method="post" action={base}>
                <Csrf />
                <input type="hidden" name="form" value="photos" />
                <input type="hidden" name="action" value="remove" />
                <input type="hidden" name="key" value={k} />
                <button class="ws-btn ws-btn-danger ws-btn-sm px-3">Remove<span class="sr-only">: photo {i + 1}</span></button>
              </form>
            </div>
          </div>
        </li>
      ))}
    </ul>
  )}

  {keys.length >= MAX_PHOTOS ? (
    <p class="ws-callout mt-5" data-tone="info"><Icon name="info" /><span>You have all {MAX_PHOTOS} photos. Remove one to add another.</span></p>
  ) : (
    <form method="post" action={base} enctype="multipart/form-data" class="set-upload" data-set-form="photos">
      <Csrf />
      <input type="hidden" name="form" value="photos" />
      <input type="hidden" name="action" value="upload" />
      <label class="field">
        <span class="meta">Choose photos</span>
        <input type="file" name="photos" accept="image/jpeg,image/png,image/webp" multiple required />
      </label>
      <p class="set-help">JPEG, PNG or WebP, up to 8 MB each, {MAX_PHOTOS - keys.length} more at most. We make them smaller and remove where they were taken.</p>
      <div><button type="submit" class="ws-btn ws-btn-primary"><Icon name="upload" />Add photos</button></div>
    </form>
  )}
</Pane>
</div>
