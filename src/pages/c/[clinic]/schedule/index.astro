---
// The Schedule lives on the Dashboard now (docs/workspace-redesign.md,
// "Dashboard"): the same day and week, by chair or by dentist, the same drag
// to move and the same /api/schedule behind it. This address keeps working —
// bookmarks, links in old texts to the desk, search results written before the
// Dashboard landed — and carries its query along, whose names the Dashboard
// reads the same way: ?date=YYYY-MM-DD, ?view=day|week, ?by=chair|dentist,
// ?dentist=<id>. The Dashboard does the sign-in and branch checks.
//
// 302 and no-store, never 301: a browser keeps a permanent redirect for good,
// and this address may yet mean something else.
export const prerender = false;

const slug = Astro.params.clinic ?? '';
if (!/^[a-z0-9-]{1,80}$/i.test(slug)) return new Response(null, { status: 404 });
return new Response(null, { status: 302, headers: { location: `/c/${slug}/${Astro.url.search}`, 'cache-control': 'no-store' } });
---
