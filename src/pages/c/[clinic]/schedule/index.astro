---
// The schedule: one branch's day, a column per chair (or per dentist), a
// visit a block. The first paint comes from loadRange() on the server; every
// change after that is one small JSON call to /api/schedule — POST for a new
// visit, PATCH for a move or a status — with this browser's CSRF token in the
// X-CSRF header, and the block is redrawn from the Appt the server returns,
// so the page never guesses what was saved. A clash comes back as one
// sentence and is shown where the hand is: in the panel, or in a toast under
// the toolbar when a drag is refused and the block snaps back. Every read
// runs inside withClinic(); row-level security keeps it to this branch.
//
// Query: ?date=YYYY-MM-DD (Manila; default today), ?view=day|week,
// ?by=chair|dentist, ?dentist=<id> to see one dentist's visits.
export const prerender = false;

import ClinicLayout from '../../../../layouts/Clinic.astro';
import { requireWorkspace } from '../../../../lib/workspace';
import { withClinic } from '../../../../lib/db';
import { csrfToken } from '../../../../lib/csrf';
import { loadRange, type Appt } from '../../../../lib/schedule';

const ws = await requireWorkspace(Astro);
if (ws instanceof Response) return ws;
const { clinic, session, branches } = ws;

const TZ = 'Asia/Manila';
const YMD = /^\d{4}-\d{2}-\d{2}$/;
const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
const DAY = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];

// Calendar days in Manila. Manila keeps +08:00 all year, so the offset is exact.
const startOf = (ymd: string) => new Date(`${ymd}T00:00:00+08:00`);
const parts = (d: Date, opts: Intl.DateTimeFormatOptions) =>
  Object.fromEntries(new Intl.DateTimeFormat('en-US', { ...opts, timeZone: TZ }).formatToParts(d).map((p) => [p.type, p.value]));
const ymdOf = (d: Date) => { const p = parts(d, { year: 'numeric', month: '2-digit', day: '2-digit' }); return `${p.year}-${p.month}-${p.day}`; };
const addDays = (ymd: string, n: number) => ymdOf(new Date(startOf(ymd).getTime() + n * 86_400_000));
// Weekday and "Thu 24 Sep" come from the calendar date alone; noon UTC of that date is a safe anchor.
const anchor = (ymd: string) => new Date(`${ymd}T12:00:00Z`);
const dowOf = (ymd: string) => anchor(ymd).getUTCDay();
const dayLabel = (ymd: string, withMonth = true) => {
  const p = Object.fromEntries(new Intl.DateTimeFormat('en-US', { weekday: 'short', day: 'numeric', month: 'short', timeZone: 'UTC' }).formatToParts(anchor(ymd)).map((x) => [x.type, x.value]));
  return withMonth ? `${p.weekday} ${p.day} ${p.month}` : `${p.weekday} ${p.day}`;
};
// "9:00 am" from minutes since midnight; "9:00–9:45 am" for a span within one half of the day.
const hm = (min: number) => { const m = Math.round(min); const h = Math.floor(m / 60) % 24; return `${h % 12 || 12}:${String(m % 60).padStart(2, '0')} ${h >= 12 ? 'pm' : 'am'}`; };
const span = (s: number, e: number) => { const a = hm(s), b = hm(e); return a.slice(-2) === b.slice(-2) ? `${a.slice(0, -3)}–${b}` : `${a}–${b}`; };
const minsOf = (iso: string, dayStart: number) => (new Date(iso).getTime() - dayStart) / 60_000;
const whenOf = (iso: string) => { const p = parts(new Date(iso), { weekday: 'short', day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit' }); return `${p.weekday} ${p.day} ${p.month}, ${p.hour}:${p.minute} ${p.dayPeriod.toLowerCase()}`; };
const timeOf = (iso: string) => { const p = parts(new Date(iso), { hour: 'numeric', minute: '2-digit' }); return `${p.hour}:${p.minute} ${p.dayPeriod.toLowerCase()}`; };

// The query string, read once and checked. Anything odd falls back to today, by chair.
const qs = Astro.url.searchParams;
const today = ymdOf(new Date());
const asked = qs.get('date') ?? '';
const date = YMD.test(asked) && !Number.isNaN(startOf(asked).getTime()) ? ymdOf(startOf(asked)) : today;
const view: 'day' | 'week' = qs.get('view') === 'week' ? 'week' : 'day';
const by: 'chair' | 'dentist' = qs.get('by') === 'dentist' ? 'dentist' : 'chair';
const filter = UUID.test(qs.get('dentist') ?? '') ? (qs.get('dentist') as string) : '';
const base = `/c/${clinic.slug}/schedule/`;
const url = (o: Partial<{ date: string; view: string; by: string; dentist: string }> = {}) => {
  const v = { date, view, by, dentist: filter, ...o };
  const p = new URLSearchParams({ date: v.date });
  if (v.view !== 'day') p.set('view', v.view);
  if (v.by !== 'chair') p.set('by', v.by);
  if (v.dentist) p.set('dentist', v.dentist);
  return `${base}?${p}`;
};

const dow = dowOf(date);
const monday = addDays(date, -((dow + 6) % 7));
const from = startOf(view === 'week' ? monday : date);
const to = startOf(view === 'week' ? addDays(monday, 7) : addDays(date, 1));

const range = await loadRange(clinic.id, from.toISOString(), to.toISOString());
const area = await withClinic(clinic.id, async (tx) => (await tx.query('select area from clinic where id = $1', [clinic.id])).rows[0]?.area as string | null);
// The page's own script sends this in the X-CSRF header on every call.
const csrf = csrfToken(Astro.cookies);

const chairs = Math.max(1, Number(range.chairs) || 1);
const staff = range.staff;
const filterName = staff.find((s) => s.id === filter)?.name ?? (filter ? 'that dentist' : '');

// clinic_hours keeps minutes from midnight. A value of 24 or less can only be an hour, so it is read as one.
const hoursOf = (d: number): [number, number] | null => {
  const h = range.hours[d];
  if (!h) return null;
  const min = (v: number) => (v <= 24 ? v * 60 : v);
  return [min(h[0]), min(h[1])];
};

// The Today page's queue colours, reused so a status looks the same on both pages. Never colour alone: every block carries its word.
const QUEUE: Record<string, { label: string; cls: string }> = {
  in_chair: { label: 'In chair', cls: 'bg-accent text-surface' },
  in_lobby: { label: 'In lobby', cls: 'bg-crown/20 text-crown' },
  arrived: { label: 'Arrived', cls: 'bg-crown/20 text-crown' },
  confirmed: { label: 'Confirmed', cls: 'bg-bg-soft text-ink-2' },
  booked: { label: 'Booked', cls: 'bg-bg-soft text-ink-2' },
  completed: { label: 'Completed', cls: 'bg-bg-soft text-muted' },
  no_show: { label: 'No show', cls: 'bg-caries/15 text-caries' },
  cancelled: { label: 'Cancelled', cls: 'bg-bg-soft text-muted' },
};
const DONE = new Set(['completed', 'no_show', 'cancelled']);
const surname = (name: string | null) => (name ? (name.trim().split(/\s+/).pop() ?? '') : '');
// medical_history.allergies is text[]; the contract joins it, but a raw array still reads right here.
const allergyOf = (a: Appt): string => (Array.isArray(a.allergies) ? (a.allergies as string[]).filter(Boolean).join(', ') : (a.allergies ?? ''));

// Overlapping blocks in one column share its width, each in a lane, the way a paper day-book does it.
type Spanned = { s: number; e: number };
function lanes<T extends Spanned>(items: T[]): (T & { lane: number; lanes: number })[] {
  const sorted = [...items].sort((x, y) => x.s - y.s || x.e - y.e);
  const out: (T & { lane: number; lanes: number })[] = [];
  let cluster: (T & { lane: number; lanes: number })[] = [], ends: number[] = [], clusterEnd = -Infinity;
  const close = () => { for (const c of cluster) c.lanes = ends.length; cluster = []; ends = []; };
  for (const it of sorted) {
    if (it.s >= clusterEnd) close();
    let lane = ends.findIndex((e) => e <= it.s);
    if (lane === -1) { lane = ends.length; ends.push(it.e); } else ends[lane] = it.e;
    const placed = { ...it, lane, lanes: 1 };
    cluster.push(placed); out.push(placed);
    clusterEnd = Math.max(clusterEnd, it.e);
  }
  close();
  return out;
}

// The rows the grid draws: the clinic's hours that day, widened to whole hours and to any visit outside them.
// A closed day still gets nine to five, so a visit can be placed on it.
function bounds(spans: Spanned[], open: [number, number] | null): [number, number] {
  let s = open ? open[0] : 9 * 60, e = open ? open[1] : 17 * 60;
  for (const x of spans) { s = Math.min(s, x.s); e = Math.max(e, x.e); }
  s = Math.max(0, Math.floor(s / 60) * 60); e = Math.min(1440, Math.ceil(e / 60) * 60);
  if (e <= s) e = Math.min(1440, s + 60);
  return [s, e];
}
const spanOf = (a: Appt, dayStart: number): Spanned => ({ s: Math.max(0, minsOf(a.startsAt, dayStart)), e: Math.min(1440, Math.max(minsOf(a.startsAt, dayStart) + 5, minsOf(a.endsAt, dayStart))) });

// The first half hour a chair is free from now (or from opening, on another day), lowest chair first.
function nextFree(appts: Appt[], open: [number, number] | null, dayStart: number, isToday: boolean): { chair: number; min: number } | null {
  if (!open) return null;
  const nowMin = isToday ? Math.ceil((Date.now() - dayStart) / 60_000 / 15) * 15 : open[0];
  let best: { chair: number; min: number } | null = null;
  for (let c = 1; c <= chairs; c++) {
    const busy = appts.filter((a) => a.chair === c && !DONE.has(a.status)).map((a) => [minsOf(a.startsAt, dayStart), minsOf(a.endsAt, dayStart)] as const).sort((x, y) => x[0] - y[0]);
    let t = Math.max(open[0], nowMin);
    for (let i = 0; i < busy.length; i++) { const [s, e] = busy[i]; if (s < t + 30 && e > t) { t = Math.ceil(e / 15) * 15; i = -1; } }
    if (t + 30 <= open[1] && (!best || t < best.min)) best = { chair: c, min: t };
  }
  return best;
}
function countText(appts: Appt[], open: [number, number] | null, dayStart: number, isToday: boolean) {
  const n = appts.length, u = appts.filter((a) => a.chair === null).length;
  const bits = [n === 0 ? 'nothing booked' : `${n} booked`, `${u} unplaced`];
  if (open) { const f = nextFree(appts, open, dayStart, isToday); bits.push(f ? `next free 30 min: Chair ${f.chair} at ${hm(f.min)}` : isToday ? 'no free 30 min left today' : 'no free 30 min'); }
  return bits.join(' · ');
}

// --- the day ---------------------------------------------------------------
type Col = { key: string; label: string; sub: string | null };
type Placed = Spanned & { a: Appt; lane: number; lanes: number };
const dayStart = startOf(date).getTime();
const dayHours = hoursOf(dow);
const list = range.appointments;
const shown = filter ? list.filter((a) => a.dentistId === filter) : list;
const colOf = (a: Appt) => (by === 'chair' ? (a.chair === null ? '' : String(a.chair)) : (a.dentistId ?? ''));

// Chair 1…n, then Unplaced when something has no chair yet; or the dentists in that day, then anyone who has a
// visit that day anyway, then No dentist. A visit is never dropped for want of a column.
function columns(appts: Appt[]): Col[] {
  const cols: Col[] = [];
  if (by === 'chair') {
    for (let i = 1; i <= chairs; i++) cols.push({ key: String(i), label: `Chair ${i}`, sub: null });
    for (const a of appts) if (a.chair !== null && a.chair > chairs && !cols.some((c) => c.key === String(a.chair))) cols.push({ key: String(a.chair), label: `Chair ${a.chair}`, sub: 'not in settings' });
    if (appts.some((a) => a.chair === null)) cols.push({ key: '', label: 'Unplaced', sub: 'drag onto a chair' });
    return cols;
  }
  for (const s of staff) if (s.days.includes(dow)) cols.push({ key: s.id, label: s.name, sub: null });
  for (const a of appts) if (a.dentistId && !cols.some((c) => c.key === a.dentistId)) cols.push({ key: a.dentistId, label: a.dentistName ?? 'Dentist', sub: 'not in today' });
  if (cols.length === 0 || appts.some((a) => !a.dentistId)) cols.push({ key: '', label: 'No dentist', sub: null });
  return cols;
}

const [gridStart, gridEnd]: [number, number] = view === 'day' ? bounds(list.map((a) => spanOf(a, dayStart)), dayHours) : [0, 0];
const cols = view === 'day' ? columns(shown) : [];
const placedBy = new Map<string, Placed[]>();
for (const c of cols) placedBy.set(c.key, lanes(shown.filter((a) => colOf(a) === c.key).map((a) => ({ a, ...spanOf(a, dayStart) }))));
const rows: number[] = []; for (let m = gridStart; m < gridEnd; m += 15) rows.push(m);
const nowMin = date === today ? (Date.now() - dayStart) / 60_000 : null;
const showNow = view === 'day' && nowMin !== null && nowMin >= gridStart && nowMin <= gridEnd;

// --- the week --------------------------------------------------------------
type WeekDay = { ymd: string; dow: number; dayStart: number; hours: [number, number] | null; placed: (Spanned & { a: Appt })[]; count: number };
const week: WeekDay[] = view === 'week' ? Array.from({ length: 7 }, (_, i) => {
  const ymd = addDays(monday, i), d = dowOf(ymd), ds = startOf(ymd).getTime();
  const inDay = (a: Appt) => { const t = new Date(a.startsAt).getTime(); return t >= ds && t < ds + 86_400_000; };
  return { ymd, dow: d, dayStart: ds, hours: hoursOf(d), placed: shown.filter(inDay).map((a) => ({ a, ...spanOf(a, ds) })), count: list.filter(inDay).length };
}) : [];
const weekOpen = week.map((d) => d.hours).filter((h): h is [number, number] => !!h);
const [weekStart, weekEnd]: [number, number] = view === 'week'
  ? bounds(week.flatMap((d) => d.placed), weekOpen.length ? [Math.min(...weekOpen.map((h) => h[0])), Math.max(...weekOpen.map((h) => h[1]))] : null)
  : [0, 0];
const weekRows: number[] = []; for (let m = weekStart; m < weekEnd; m += 15) weekRows.push(m);

// The print list: what is on the grid, in time order.
const printRows = [...shown].sort((x, y) => x.startsAt.localeCompare(y.startsAt));

const title = view === 'week' ? `${dayLabel(monday)} – ${dayLabel(addDays(monday, 6))}` : dayLabel(date);
const step = view === 'week' ? 7 : 1;
const count = view === 'day' ? countText(list, dayHours, dayStart, date === today) : `${list.length} booked this week · ${list.filter((a) => a.chair === null).length} unplaced`;
const rangeJson = JSON.stringify(range).replace(/</g, '\\u003c');
---

<ClinicLayout groupId={clinic.group_id} clinic={{ slug: clinic.slug, name: clinic.name, area }} title="Schedule" section="schedule" staff={{ name: session.name, role: session.role }} branches={branches}>
  <div class="sched-root" data-schedule data-clinic={clinic.slug} data-clinic-name={clinic.name} data-csrf={csrf} data-base={base} data-date={date} data-today={today} data-view={view} data-by={by} data-dentist={filter} data-dow={dow} data-chairs={chairs}>
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h1 class="font-display text-[clamp(1.75rem,4vw,2.5rem)] font-semibold tracking-[-0.02em]">Schedule</h1>
      <p class="meta" data-count>{count}</p>
    </div>

    <div class="mt-5 flex flex-wrap items-center gap-3 border-y border-line py-3 print:hidden" data-toolbar>
      <nav class="flex items-center gap-1" aria-label="Move through the calendar">
        <a href={url({ date: addDays(date, -step) })} class="btn btn-quiet !px-3 !py-1.5 text-[13.5px]" aria-label={view === 'week' ? 'Previous week' : 'Previous day'} data-prev>&lsaquo;</a>
        <a href={url({ date: today })} class="btn btn-quiet !px-3 !py-1.5 text-[13.5px]" data-today-link>Today</a>
        <a href={url({ date: addDays(date, step) })} class="btn btn-quiet !px-3 !py-1.5 text-[13.5px]" aria-label={view === 'week' ? 'Next week' : 'Next day'} data-next>&rsaquo;</a>
      </nav>
      <p class="text-[17px] font-semibold tabular-nums" data-date-label>{title}{view === 'day' && date === today && <span class="meta ml-2">today</span>}</p>
      <label class="flex items-center gap-2 text-[13.5px] text-ink-2">
        <span class="sr-only">Go to a date</span>
        <input type="date" value={date} data-date-input class="border border-line bg-surface px-2 py-1.5 text-[13.5px] text-ink" />
      </label>
      <div class="flex" role="group" aria-label="View">
        {(['day', 'week'] as const).map((v) => (
          <a href={url({ view: v })} aria-current={view === v ? 'page' : undefined} data-view-link={v}
            class:list={['-ml-px border border-line px-3 py-1.5 text-[13.5px] font-medium first:ml-0', view === v ? 'border-ink bg-ink text-bg' : 'text-ink-2 hover:text-ink']}>{v === 'day' ? 'Day' : 'Week'}</a>
        ))}
      </div>
      {view === 'day' && (
        <div class="flex" role="group" aria-label="Columns">
          {(['chair', 'dentist'] as const).map((b) => (
            <a href={url({ by: b })} aria-current={by === b ? 'page' : undefined} data-by-link={b}
              class:list={['-ml-px border border-line px-3 py-1.5 text-[13.5px] font-medium first:ml-0', by === b ? 'border-ink bg-ink text-bg' : 'text-ink-2 hover:text-ink']}>{b === 'chair' ? 'By chair' : 'By dentist'}</a>
          ))}
        </div>
      )}
      <span class="flex-1"></span>
      <button type="button" class="btn btn-quiet !px-4 !py-2 text-[13.5px]" data-print>Print day list</button>
      {view === 'day' && <button type="button" class="btn btn-primary !px-4 !py-2 text-[13.5px]" data-new>New visit</button>}
    </div>

    {staff.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-2 print:hidden" data-dentists aria-label="Show one dentist">
        <a href={url({ dentist: '' })} aria-current={!filter ? 'true' : undefined} class:list={['chip !px-3 !py-1.5 text-[13.5px]', !filter && 'border-ink bg-ink text-bg']}>All dentists</a>
        {staff.map((s) => (
          <a href={url({ dentist: s.id })} aria-current={filter === s.id ? 'true' : undefined} data-dentist-chip={s.id} class:list={['chip !px-3 !py-1.5 text-[13.5px]', filter === s.id && 'border-ink bg-ink text-bg']}>{s.name}</a>
        ))}
      </div>
    )}

    <p role="alert" data-toast-error hidden class="mt-4 border border-caries/40 bg-caries/10 p-4 text-[14.5px] print:hidden"></p>
    <p role="status" data-toast-ok hidden class="mt-4 border border-accent/40 bg-accent/10 p-4 text-[14.5px] print:hidden"></p>

    {view === 'day' && !dayHours && <p class="mt-4 text-[15px] text-ink-2" data-closed>Closed on {DAY[dow]}s. A visit can still be placed here.</p>}
    {view === 'day' && <p class="mt-4 text-[15px] text-muted" data-empty hidden={list.length > 0}>No visits on this day. Click a free slot, or New visit, to add one.</p>}
    {view === 'day' && <p class="mt-4 text-[15px] text-muted" data-filtered hidden={!(list.length > 0 && shown.length === 0)}>No visits for {filterName} on this day. <a href={url({ dentist: '' })} class="underline underline-offset-4 hover:text-accent">Show every dentist</a></p>}
    {view === 'week' && list.length === 0 && <p class="mt-4 text-[15px] text-muted">No visits this week.</p>}
    {view === 'week' && list.length > 0 && shown.length === 0 && <p class="mt-4 text-[15px] text-muted">No visits for {filterName} this week. <a href={url({ dentist: '' })} class="underline underline-offset-4 hover:text-accent">Show every dentist</a></p>}

    {view === 'day' && (
      <div class="sched mt-4 border border-line bg-surface" data-grid data-start={gridStart} data-end={gridEnd} style={`--cols:${cols.length};--span:${gridEnd - gridStart}`}>
        <div class="sched-scroll">
          <div class="sched-head border-b border-line bg-bg-soft" data-head>
            <div class="px-2 py-2"></div>
            {cols.map((c) => (
              <div class="border-l border-line-2 px-3 py-2" data-lane-head={c.key}>
                <p class="text-[13.5px] font-semibold">{c.label}</p>
                {c.sub && <p class="meta">{c.sub}</p>}
              </div>
            ))}
          </div>
          <div class="sched-body" data-body>
            <div class="gutter">
              {rows.map((m) => (
                <>
                  {m % 60 === 0 && <span class="hour meta" style={`--s:${m - gridStart}`}>{hm(m)}</span>}
                  <span class:list={['tick', m % 60 === 0 ? 'tick-hour bg-line' : 'bg-line-2']} style={`--s:${m - gridStart}`}></span>
                </>
              ))}
            </div>
            {cols.map((c) => (
              <div class="lane border-l border-line-2" data-lane={c.key} data-lane-label={c.label}>
                {rows.map((m) => (
                  <button type="button" class:list={['cell', m % 60 === 0 && 'border-t border-line-2']} data-cell data-col={c.key} data-min={m} tabindex="-1" aria-label={`${c.label}, ${hm(m)}, add a visit`}></button>
                ))}
                {placedBy.get(c.key)!.map(({ a, s, e, lane, lanes: n }) => {
                  const st = QUEUE[a.status] ?? QUEUE.booked;
                  return (
                    <button type="button" class:list={['appt border border-line text-left text-[13px]', st.cls, e - s < 30 && 'appt-xs']} data-id={a.id} data-col={c.key} data-status={a.status}
                      style={`--s:${s - gridStart};--d:${e - s};--lane:${lane};--lanes:${n}`}
                      aria-label={`${span(s, e)}, ${a.patientName}, ${st.label}${a.reason ? ', ' + a.reason : ''}`}>
                      <span class="meta text-current">{span(s, e)}</span>
                      <span class="appt-name font-semibold">{a.patientName}</span>
                      <span class="appt-more">{[a.reason, surname(a.dentistName)].filter(Boolean).join(' · ')}</span>
                      {(allergyOf(a) || a.source !== 'staff') && (
                        <span class="appt-marks">
                          {allergyOf(a) && <span class="appt-mark bg-caries" title={`Allergy: ${allergyOf(a)}`}><span class="sr-only">Allergy: {allergyOf(a)}</span></span>}
                          {a.source !== 'staff' && <span class="meta text-current">web</span>}
                        </span>
                      )}
                    </button>
                  );
                })}
              </div>
            ))}
            <div class="now bg-caries" data-now style={`--s:${(nowMin ?? 0) - gridStart}`} hidden={!showNow}></div>
          </div>
        </div>
      </div>
    )}

    {view === 'week' && (
      <div class="sched sched-week mt-4 border border-line bg-surface" data-week data-start={weekStart} data-end={weekEnd} style={`--cols:7;--span:${weekEnd - weekStart}`}>
        <div class="sched-scroll">
          <div class="sched-head border-b border-line bg-bg-soft">
            <div class="px-2 py-2"></div>
            {week.map((d) => (
              <a href={url({ date: d.ymd, view: 'day' })} data-day={d.ymd} aria-current={d.ymd === today ? 'date' : undefined}
                class:list={['block border-l border-line-2 px-3 py-2 hover:bg-bg', d.ymd === today && 'text-accent']}>
                <p class="text-[13.5px] font-semibold">{dayLabel(d.ymd, false)}{d.ymd === today && <span class="meta ml-1.5 text-current">today</span>}</p>
                <p class="meta">{d.hours ? `${d.count === 0 ? 'no' : d.count} visit${d.count === 1 ? '' : 's'}` : 'closed'}</p>
              </a>
            ))}
          </div>
          <div class="sched-body">
            <div class="gutter">
              {weekRows.map((m) => (
                <>
                  {m % 60 === 0 && <span class="hour meta" style={`--s:${m - weekStart}`}>{hm(m)}</span>}
                  <span class:list={['tick', m % 60 === 0 ? 'tick-hour bg-line' : 'bg-line-2']} style={`--s:${m - weekStart}`}></span>
                </>
              ))}
            </div>
            {week.map((d) => (
              <div class:list={['lane border-l border-line-2', !d.hours && 'bg-bg']} data-lane={d.ymd}>
                {weekRows.map((m) => <span class:list={['cell', m % 60 === 0 && 'border-t border-line-2']} aria-hidden="true"></span>)}
                {lanes(d.placed).map(({ a, s, e, lane, lanes: n }) => {
                  const st = QUEUE[a.status] ?? QUEUE.booked;
                  return (
                    <a href={url({ date: d.ymd, view: 'day' })} class:list={['appt appt-compact border border-line text-[13px]', st.cls]} data-id={a.id}
                      style={`--s:${s - weekStart};--d:${e - s};--lane:${lane};--lanes:${n}`}
                      aria-label={`${dayLabel(d.ymd)}, ${span(s, e)}, ${a.patientName}, ${st.label}. Open that day.`}>
                      <span class="meta text-current">{hm(s)}</span>
                      <span class="appt-name font-semibold">{surname(a.patientName) || a.patientName}</span>
                    </a>
                  );
                })}
              </div>
            ))}
          </div>
        </div>
      </div>
    )}

    <table data-print-list class="mt-8 hidden w-full border-collapse text-left text-[12px] print:table">
      <caption class="meta mb-2 text-left">{clinic.name} · {title}</caption>
      <thead>
        <tr class="border-b border-line">
          {view === 'week' && <th scope="col" class="meta py-1.5 pr-3">Day</th>}
          <th scope="col" class="meta py-1.5 pr-3">Time</th>
          <th scope="col" class="meta py-1.5 pr-3">Patient</th>
          <th scope="col" class="meta py-1.5 pr-3">Chart</th>
          <th scope="col" class="meta py-1.5 pr-3">Reason</th>
          <th scope="col" class="meta py-1.5 pr-3">Dentist</th>
          <th scope="col" class="meta py-1.5 pr-3">Chair</th>
          <th scope="col" class="meta py-1.5">Status</th>
        </tr>
      </thead>
      <tbody data-print-rows>
        {printRows.length === 0 && <tr><td colspan={view === 'week' ? 8 : 7} class="py-2 text-muted">Nothing on the book.</td></tr>}
        {printRows.map((a) => (
          <tr class="border-b border-line-2">
            {view === 'week' && <td class="py-1.5 pr-3 whitespace-nowrap">{dayLabel(ymdOf(new Date(a.startsAt)), false)}</td>}
            <td class="py-1.5 pr-3 whitespace-nowrap tabular-nums">{timeOf(a.startsAt)}</td>
            <td class="py-1.5 pr-3 font-semibold">{a.patientName}{allergyOf(a) && <span class="text-caries"> · allergy: {allergyOf(a)}</span>}</td>
            <td class="py-1.5 pr-3 tabular-nums">{a.chartNo}</td>
            <td class="py-1.5 pr-3">{a.reason ?? ''}</td>
            <td class="py-1.5 pr-3">{a.dentistName ?? ''}</td>
            <td class="py-1.5 pr-3 tabular-nums">{a.chair ?? 'unplaced'}</td>
            <td class="py-1.5">{QUEUE[a.status]?.label ?? a.status}</td>
          </tr>
        ))}
      </tbody>
    </table>

    {view === 'day' && (
      <aside class="sched-panel border-t border-line bg-surface lg:border-t-0 lg:border-l print:hidden" data-panel role="dialog" aria-modal="false" aria-labelledby="sched-panel-title" tabindex="-1" hidden>
        <div class="flex items-start justify-between gap-4 border-b border-line p-5">
          <h2 id="sched-panel-title" class="font-display text-[22px] font-semibold" data-panel-title>New visit</h2>
          <button type="button" class="meta hover:text-ink" data-panel-close>Close</button>
        </div>

        <form data-new-form class="grid gap-4 p-5" novalidate hidden>
          <p role="alert" data-new-error hidden class="border border-caries/40 bg-caries/10 p-3 text-[14px]"></p>
          <div data-new-lookup>
            <label class="field">
              <span class="meta">Patient</span>
              <input type="search" data-new-search autocomplete="off" placeholder="Name, chart number or mobile" />
            </label>
            <ul data-new-results class="mt-1 divide-y divide-line-2 border border-line" hidden></ul>
            <p data-new-hint class="mt-1 text-[13px] text-muted">Type two letters of a name, a chart number or a mobile.</p>
            <label class="check mt-3"><input type="checkbox" data-new-toggle /><span>New patient</span></label>
          </div>
          <div data-new-chosen hidden class="flex items-center justify-between gap-3 border border-line p-3">
            <p class="text-[14.5px]"><strong class="font-semibold" data-new-chosen-name></strong> <span class="text-muted" data-new-chosen-more></span></p>
            <button type="button" class="meta hover:text-ink" data-new-change>Change</button>
          </div>
          <input type="hidden" name="patientId" data-new-patient-id />
          <div data-new-patient hidden class="grid gap-3">
            <label class="field"><span class="meta">Name</span><input name="newName" data-new-name maxlength="80" autocomplete="off" /></label>
            <label class="field"><span class="meta">Mobile</span><input type="tel" name="newPhone" data-new-phone placeholder="0917 000 0000" autocomplete="off" /></label>
          </div>
          <label class="field">
            <span class="meta">Service</span>
            <select data-new-service>
              <option value="">Choose</option>
              {range.catalog.map((c) => <option value={c.code} data-minutes={c.minutes} data-name={c.name}>{c.name} · {c.minutes} min</option>)}
            </select>
          </label>
          <label class="field"><span class="meta">Reason</span><input data-new-reason maxlength="120" placeholder="What the visit is for" /></label>
          <div class="grid grid-cols-2 gap-3">
            <label class="field"><span class="meta">Minutes</span><input type="number" data-new-minutes min="5" max="480" step="5" value="30" /></label>
            <label class="field">
              <span class="meta">Chair</span>
              <select data-new-chair>
                <option value="">Unplaced</option>
                {Array.from({ length: chairs }, (_, i) => <option value={i + 1}>Chair {i + 1}</option>)}
              </select>
            </label>
          </div>
          <label class="field">
            <span class="meta">Dentist</span>
            <select data-new-dentist><option value="">Any</option></select>
          </label>
          <div class="grid grid-cols-2 gap-3">
            <label class="field"><span class="meta">Date</span><input type="date" data-new-date value={date} /></label>
            <label class="field"><span class="meta">Time</span><input type="time" data-new-time step="900" /></label>
          </div>
          <label class="field"><span class="meta">Notes</span><textarea data-new-notes rows="2" maxlength="500"></textarea></label>
          <div class="flex gap-2">
            <button type="submit" class="btn btn-primary !px-4 !py-2 text-[13.5px]" data-new-save>Save</button>
            <button type="button" class="btn btn-quiet !px-4 !py-2 text-[13.5px]" data-panel-close>Cancel</button>
          </div>
        </form>

        <div data-visit class="grid gap-5 p-5" hidden>
          <p role="alert" data-visit-error hidden class="border border-caries/40 bg-caries/10 p-3 text-[14px]"></p>
          <div>
            <a data-visit-name href="#" class="text-[17px] font-semibold hover:text-accent"></a>
            <p class="text-[13.5px] tabular-nums text-muted" data-visit-chart></p>
            <p data-visit-allergy hidden class="mt-2 inline-block bg-caries/15 px-2.5 py-1 text-[12px] font-semibold text-caries"></p>
          </div>
          <dl class="grid grid-cols-[6rem_minmax(0,1fr)] gap-x-3 gap-y-1.5 text-[14.5px]">
            <dt class="meta">When</dt><dd data-visit-when></dd>
            <dt class="meta">Reason</dt><dd data-visit-reason></dd>
            <dt class="meta">Dentist</dt><dd data-visit-dentist></dd>
            <dt class="meta">Chair</dt><dd data-visit-chair></dd>
            <dt class="meta">Booked</dt><dd data-visit-source></dd>
            <dt class="meta">Notes</dt><dd data-visit-notes class="break-words"></dd>
          </dl>
          <div>
            <span class="inline-block px-3 py-1.5 text-xs font-semibold" data-visit-status></span>
            <div class="mt-3 flex flex-wrap gap-1.5" data-visit-actions></div>
            <p data-visit-cancel-ask hidden class="mt-3 flex flex-wrap items-center gap-2 text-[14.5px]">
              Cancel this visit?
              <button type="button" class="btn btn-quiet !px-3 !py-1.5 text-[13px]" data-visit-cancel-yes>Yes</button>
              <button type="button" class="btn btn-quiet !px-3 !py-1.5 text-[13px]" data-visit-cancel-keep>Keep</button>
            </p>
          </div>
          <form data-move-form class="grid gap-3 border-t border-line pt-5" novalidate>
            <h3 class="text-[15px] font-semibold">Move</h3>
            <div class="grid grid-cols-2 gap-3">
              <label class="field"><span class="meta">Date</span><input type="date" data-move-date /></label>
              <label class="field"><span class="meta">Time</span><input type="time" data-move-time step="900" /></label>
            </div>
            <div class="grid grid-cols-2 gap-3">
              <label class="field">
                <span class="meta">Chair</span>
                <select data-move-chair>
                  <option value="">Unplaced</option>
                  {Array.from({ length: chairs }, (_, i) => <option value={i + 1}>Chair {i + 1}</option>)}
                </select>
              </label>
              <label class="field"><span class="meta">Minutes</span><input type="number" data-move-minutes min="5" max="480" step="5" /></label>
            </div>
            <label class="field">
              <span class="meta">Dentist</span>
              <select data-move-dentist><option value="">Any</option></select>
            </label>
            <div><button type="submit" class="btn btn-quiet !px-4 !py-2 text-[13.5px]" data-move-save>Move the visit</button></div>
          </form>
          <a data-visit-text href={`/c/${clinic.slug}/messages/`} class="text-[14.5px] underline underline-offset-4 hover:text-accent">Text the patient</a>
        </div>
      </aside>
    )}

    <script is:inline type="application/json" data-range set:html={rangeJson}></script>
  </div>
</ClinicLayout>

<!-- Geometry only: where a row, a column and a block sit. Colours and controls are the global classes on the markup.
     Global on purpose: the script rebuilds the grid after every change, and a scoped style would miss the new elements.
     In @layer components, like global.css, so a utility on the markup (the drag target's bg-accent/10) always wins. -->
<style is:global>
@layer components {
  .sched { --mpx: 1.6px; --gutter: 4.5rem; --colw: 9.5rem; }
  .sched-scroll { position: relative; overflow-x: auto; overflow-y: hidden; }
  .sched-head, .sched-body {
    display: grid;
    grid-template-columns: var(--gutter) repeat(var(--cols), minmax(var(--colw), 1fr));
    width: max(100%, calc(var(--gutter) + var(--cols) * var(--colw)));
  }
  .sched-body { position: relative; height: calc(var(--span) * var(--mpx)); }
  .sched .gutter { position: relative; }
  .sched .hour { position: absolute; right: 0.5rem; top: calc(var(--s) * var(--mpx) + 2px); white-space: nowrap; }
  .sched .tick { position: absolute; right: 0; top: calc(var(--s) * var(--mpx)); width: 6px; height: 1px; }
  .sched .tick-hour { width: 12px; }
  .sched .lane { position: relative; }
  .sched .cell { display: block; width: 100%; height: calc(15 * var(--mpx)); margin: 0; padding: 0; border-width: 0; background: transparent; cursor: cell; border-radius: 0; }
  .sched .appt {
    --lane: 0; --lanes: 1;
    position: absolute;
    top: calc(var(--s) * var(--mpx));
    height: calc(var(--d) * var(--mpx) - 1px);
    left: calc(var(--lane) * (100% / var(--lanes)) + 2px);
    width: calc(100% / var(--lanes) - 4px);
    z-index: 2;
    display: flex; flex-direction: column; gap: 1px;
    padding: 2px 6px 3px;
    line-height: 1.25;
    overflow: hidden;
    border-radius: 0;
    cursor: grab;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
  }
  .sched .appt .meta { line-height: 1.3; }
  .sched .appt-name, .sched .appt-more { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .sched .appt-xs { flex-direction: row; align-items: baseline; gap: 0.4rem; padding-top: 1px; }
  .sched .appt-xs .appt-more, .sched .appt-xs .appt-marks { display: none; }
  .sched .appt-marks { position: absolute; top: 3px; right: 6px; display: flex; align-items: center; gap: 0.35rem; }
  .sched .appt-mark { display: block; width: 8px; height: 8px; }
  .sched .appt.is-dragging { opacity: 0.4; pointer-events: none; }
  .sched-week .appt { cursor: pointer; touch-action: auto; text-decoration: none; }
  .sched-week .cell { cursor: default; }
  .appt-ghost { position: fixed; z-index: 70; margin: 0; pointer-events: none; opacity: 0.85; cursor: grabbing; }
  .sched .now { position: absolute; left: var(--gutter); right: 0; top: calc(var(--s) * var(--mpx)); height: 1px; z-index: 3; pointer-events: none; }
  body.is-dragging, body.is-dragging * { cursor: grabbing !important; }

  /* The panel: a column from the right on a wide screen, a block under the grid on a narrow one. */
  .sched-panel[hidden] { display: none; }
  @media (min-width: 1024px) {
    .sched-panel {
      position: fixed; top: 0; right: 0; bottom: 0; z-index: 60;
      width: min(27rem, 100vw);
      overflow-y: auto;
      transform: translateX(100%);
      transition: transform 240ms cubic-bezier(0.22, 1, 0.36, 1);
    }
    .sched-panel.is-open { transform: none; }
  }
  @media (max-width: 1023px) {
    .sched-panel { margin-top: 1.5rem; }
  }

  /* Print: the grid and the list, without the frame around them. */
  @media print {
    body > :not(main) { display: none !important; }
    .sched-scroll { overflow: visible; }
    .sched-head, .sched-body { width: 100%; grid-template-columns: var(--gutter) repeat(var(--cols), minmax(0, 1fr)); }
    .sched .appt { break-inside: avoid; }
    .sched .now { display: none; }
  }
}
</style>

<script>
  // The desk's half of the contract: what the server gave the page, and what
  // it sends back. Types mirror src/lib/schedule.ts.
  type Appt = {
    id: string; patientId: string; patientName: string; chartNo: string; phone: string | null;
    dentistId: string | null; dentistName: string | null; chair: number | null;
    startsAt: string; endsAt: string; reason: string | null; status: string; source: string;
    publicRef: string | null; notes: string | null; allergies: string | null;
  };
  type Range = {
    appointments: Appt[]; chairs: number; hours: Record<number, [number, number] | null>;
    staff: { id: string; name: string; days: number[] }[]; catalog: { code: string; name: string; minutes: number }[];
  };
  type Col = { key: string; label: string; sub: string | null };
  type Spanned = { s: number; e: number };
  type Placed = Spanned & { a: Appt; lane: number; lanes: number };
  type Reply = { ok: true; appointment: Appt } | { ok: false; error: string };

  const QUEUE: Record<string, { label: string; cls: string }> = {
    in_chair: { label: 'In chair', cls: 'bg-accent text-surface' },
    in_lobby: { label: 'In lobby', cls: 'bg-crown/20 text-crown' },
    arrived: { label: 'Arrived', cls: 'bg-crown/20 text-crown' },
    confirmed: { label: 'Confirmed', cls: 'bg-bg-soft text-ink-2' },
    booked: { label: 'Booked', cls: 'bg-bg-soft text-ink-2' },
    completed: { label: 'Completed', cls: 'bg-bg-soft text-muted' },
    no_show: { label: 'No show', cls: 'bg-caries/15 text-caries' },
    cancelled: { label: 'Cancelled', cls: 'bg-bg-soft text-muted' },
  };
  // The Today page's state machine: what the desk can press next.
  const NEXT: Record<string, { label: string; to: string }[]> = {
    booked: [{ label: 'Confirm', to: 'confirmed' }, { label: 'Arrived', to: 'arrived' }],
    confirmed: [{ label: 'Arrived', to: 'arrived' }],
    arrived: [{ label: 'To lobby', to: 'in_lobby' }, { label: 'Seat', to: 'in_chair' }],
    in_lobby: [{ label: 'Seat', to: 'in_chair' }],
    in_chair: [{ label: 'Complete', to: 'completed' }],
  };
  const DONE = new Set(['completed', 'no_show', 'cancelled']);
  const SOURCE: Record<string, string> = { staff: 'At the desk', web: 'Booked online', request: 'Requested online' };
  const OFFLINE = 'Could not reach the clinic. Your change was not saved.';
  const DAYWORD = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
  const TZ = 'Asia/Manila';

  const root = document.querySelector<HTMLElement>('[data-schedule]');
  if (root) init(root);

  function init(root: HTMLElement) {
    const D = root.dataset;
    const slug = D.clinic ?? '', csrf = D.csrf ?? '', base = D.base ?? '', date = D.date ?? '', today = D.today ?? '';
    const view = D.view ?? 'day', by = (D.by === 'dentist' ? 'dentist' : 'chair') as 'chair' | 'dentist', filter = D.dentist ?? '';
    const dow = Number(D.dow), chairs = Math.max(1, Number(D.chairs) || 1);
    const rangeEl = root.querySelector<HTMLScriptElement>('[data-range]');
    let range: Range = { appointments: [], chairs, hours: {}, staff: [], catalog: [] };
    try { range = JSON.parse(rangeEl?.textContent || '{}'); } catch { /* the first paint stands; changes will reload */ }
    const staffById = new Map(range.staff.map((s) => [s.id, s]));
    const appts = new Map<string, Appt>(range.appointments.map((a) => [a.id, a]));
    const dayStart = Date.parse(`${date}T00:00:00+08:00`);

    const $ = <T extends HTMLElement = HTMLElement>(sel: string, from: ParentNode = root) => from.querySelector<T>(sel);
    const el = <K extends keyof HTMLElementTagNameMap>(tag: K, cls?: string, text?: string) => {
      const n = document.createElement(tag); if (cls) n.className = cls; if (text !== undefined) n.textContent = text; return n;
    };

    // --- time, the clinic's ------------------------------------------------
    const pad = (n: number) => String(n).padStart(2, '0');
    const hm = (min: number) => { const m = Math.round(min); const h = Math.floor(m / 60) % 24; return `${h % 12 || 12}:${pad(m % 60)} ${h >= 12 ? 'pm' : 'am'}`; };
    const span = (s: number, e: number) => { const a = hm(s), b = hm(e); return a.slice(-2) === b.slice(-2) ? `${a.slice(0, -3)}–${b}` : `${a}–${b}`; };
    const hhmm = (min: number) => `${pad(Math.floor(min / 60) % 24)}:${pad(Math.round(min) % 60)}`;
    const minOf = (iso: string) => (Date.parse(iso) - dayStart) / 60_000;
    const parts = (d: Date, opts: Intl.DateTimeFormatOptions) =>
      Object.fromEntries(new Intl.DateTimeFormat('en-US', { ...opts, timeZone: TZ }).formatToParts(d).map((p) => [p.type, p.value]));
    /** Manila calendar date and minutes into it, for any instant. */
    const manila = (iso: string) => {
      const p = parts(new Date(iso), { year: 'numeric', month: '2-digit', day: '2-digit', hour: 'numeric', minute: 'numeric', hourCycle: 'h23' });
      return { ymd: `${p.year}-${p.month}-${p.day}`, min: (Number(p.hour) % 24) * 60 + Number(p.minute) };
    };
    const whenOf = (iso: string) => { const p = parts(new Date(iso), { weekday: 'short', day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit' }); return `${p.weekday} ${p.day} ${p.month}, ${p.hour}:${p.minute} ${p.dayPeriod.toLowerCase()}`; };
    const timeOf = (iso: string) => { const p = parts(new Date(iso), { hour: 'numeric', minute: '2-digit' }); return `${p.hour}:${p.minute} ${p.dayPeriod.toLowerCase()}`; };
    const dowOfYmd = (ymd: string) => new Date(`${ymd}T12:00:00Z`).getUTCDay();
    const isoOf = (ymd: string, time: string) => new Date(`${ymd}T${time.slice(0, 5)}:00+08:00`).toISOString();
    const hoursOf = (d: number): [number, number] | null => {
      const h = range.hours[d]; if (!h) return null; const min = (v: number) => (v <= 24 ? v * 60 : v); return [min(h[0]), min(h[1])];
    };
    const surname = (name: string | null) => (name ? (name.trim().split(/\s+/).pop() ?? '') : '');
    const allergyOf = (a: Appt): string => (Array.isArray(a.allergies) ? (a.allergies as string[]).filter(Boolean).join(', ') : (a.allergies ?? ''));
    const urlFor = (o: Partial<{ date: string; view: string; by: string; dentist: string }>) => {
      const v = { date, view, by, dentist: filter, ...o };
      const p = new URLSearchParams({ date: v.date });
      if (v.view !== 'day') p.set('view', v.view);
      if (v.by !== 'chair') p.set('by', v.by);
      if (v.dentist) p.set('dentist', v.dentist);
      return `${base}?${p}`;
    };

    // --- the toolbar, both views ------------------------------------------
    $('[data-date-input]')?.addEventListener('change', (e) => {
      const v = (e.target as HTMLInputElement).value;
      if (/^\d{4}-\d{2}-\d{2}$/.test(v)) location.assign(urlFor({ date: v }));
    });
    $('[data-print]')?.addEventListener('click', () => window.print());

    const toastErr = $('[data-toast-error]'), toastOk = $('[data-toast-ok]');
    let okTimer = 0;
    function fail(text: string) { if (!toastErr) return; toastErr.textContent = text; toastErr.hidden = false; if (toastOk) toastOk.hidden = true; }
    function say(text: string, link?: { href: string; label: string }) {
      if (!toastOk) return;
      toastOk.replaceChildren(text);
      if (link) { const a = el('a', 'ml-1 underline underline-offset-4 hover:text-accent', link.label); a.href = link.href; toastOk.append(' ', a); }
      toastOk.hidden = false; if (toastErr) toastErr.hidden = true;
      window.clearTimeout(okTimer); okTimer = window.setTimeout(() => { if (!link) toastOk.hidden = true; }, 6000);
    }

    // --- the API ---------------------------------------------------------
    async function call(method: 'POST' | 'PATCH', body: Record<string, unknown>): Promise<Reply> {
      try {
        const res = await fetch('/api/schedule', {
          method, credentials: 'same-origin',
          headers: { 'content-type': 'application/json', 'X-CSRF': csrf },
          body: JSON.stringify({ clinic: slug, ...body }),
        });
        let data: any = null;
        try { data = await res.json(); } catch { /* no body */ }
        if (res.ok && data?.appointment) return { ok: true, appointment: data.appointment as Appt };
        if (res.status === 401) return { ok: false, error: 'Your sign-in has ended. Sign in again and try that once more.' };
        return { ok: false, error: typeof data?.error === 'string' && data.error ? data.error : OFFLINE };
      } catch {
        return { ok: false, error: OFFLINE };
      }
    }

    const grid = $('[data-grid]');
    if (view !== 'day' || !grid) return;

    // --- the day grid ------------------------------------------------------
    const head = $('[data-head]', grid)!, body = $('[data-body]', grid)!;
    let gridStart = Number(grid.dataset.start), gridEnd = Number(grid.dataset.end);
    const dayHours = hoursOf(dow);
    const isToday = date === today;
    const colOf = (a: Appt) => (by === 'chair' ? (a.chair === null ? '' : String(a.chair)) : (a.dentistId ?? ''));
    const spanOf = (a: Appt): Spanned => ({ s: Math.max(0, minOf(a.startsAt)), e: Math.min(1440, Math.max(minOf(a.startsAt) + 5, minOf(a.endsAt))) });
    const shownList = () => { const all = [...appts.values()]; return filter ? all.filter((a) => a.dentistId === filter) : all; };

    function lanes<T extends Spanned>(items: T[]): (T & { lane: number; lanes: number })[] {
      const sorted = [...items].sort((x, y) => x.s - y.s || x.e - y.e);
      const out: (T & { lane: number; lanes: number })[] = [];
      let cluster: (T & { lane: number; lanes: number })[] = [], ends: number[] = [], clusterEnd = -Infinity;
      const close = () => { for (const c of cluster) c.lanes = ends.length; cluster = []; ends = []; };
      for (const it of sorted) {
        if (it.s >= clusterEnd) close();
        let lane = ends.findIndex((e) => e <= it.s);
        if (lane === -1) { lane = ends.length; ends.push(it.e); } else ends[lane] = it.e;
        const placed = { ...it, lane, lanes: 1 };
        cluster.push(placed); out.push(placed);
        clusterEnd = Math.max(clusterEnd, it.e);
      }
      close();
      return out;
    }
    function bounds(spans: Spanned[], open: [number, number] | null): [number, number] {
      let s = open ? open[0] : 9 * 60, e = open ? open[1] : 17 * 60;
      for (const x of spans) { s = Math.min(s, x.s); e = Math.max(e, x.e); }
      s = Math.max(0, Math.floor(s / 60) * 60); e = Math.min(1440, Math.ceil(e / 60) * 60);
      if (e <= s) e = Math.min(1440, s + 60);
      return [s, e];
    }
    function columns(list: Appt[]): Col[] {
      const cols: Col[] = [];
      if (by === 'chair') {
        for (let i = 1; i <= chairs; i++) cols.push({ key: String(i), label: `Chair ${i}`, sub: null });
        for (const a of list) if (a.chair !== null && a.chair > chairs && !cols.some((c) => c.key === String(a.chair))) cols.push({ key: String(a.chair), label: `Chair ${a.chair}`, sub: 'not in settings' });
        if (list.some((a) => a.chair === null)) cols.push({ key: '', label: 'Unplaced', sub: 'drag onto a chair' });
        return cols;
      }
      for (const s of range.staff) if (s.days.includes(dow)) cols.push({ key: s.id, label: s.name, sub: null });
      for (const a of list) if (a.dentistId && !cols.some((c) => c.key === a.dentistId)) cols.push({ key: a.dentistId, label: a.dentistName ?? 'Dentist', sub: 'not in today' });
      if (cols.length === 0 || list.some((a) => !a.dentistId)) cols.push({ key: '', label: 'No dentist', sub: null });
      return cols;
    }
    function nextFree(list: Appt[]): { chair: number; min: number } | null {
      const open = dayHours; if (!open) return null;
      const nowMin = isToday ? Math.ceil((Date.now() - dayStart) / 60_000 / 15) * 15 : open[0];
      let best: { chair: number; min: number } | null = null;
      for (let c = 1; c <= chairs; c++) {
        const busy = list.filter((a) => a.chair === c && !DONE.has(a.status)).map((a) => [minOf(a.startsAt), minOf(a.endsAt)] as const).sort((x, y) => x[0] - y[0]);
        let t = Math.max(open[0], nowMin);
        for (let i = 0; i < busy.length; i++) { const [s, e] = busy[i]; if (s < t + 30 && e > t) { t = Math.ceil(e / 15) * 15; i = -1; } }
        if (t + 30 <= open[1] && (!best || t < best.min)) best = { chair: c, min: t };
      }
      return best;
    }

    // Rendering. The shape is the server's, element for element, so the first paint and every redraw match.
    function renderBlock(p: Placed, colKey: string): HTMLButtonElement {
      const { a, s, e } = p, st = QUEUE[a.status] ?? QUEUE.booked;
      const b = el('button', `appt border border-line text-left text-[13px] ${st.cls}${e - s < 30 ? ' appt-xs' : ''}`);
      b.type = 'button'; b.dataset.id = a.id; b.dataset.col = colKey; b.dataset.status = a.status;
      b.style.cssText = `--s:${s - gridStart};--d:${e - s};--lane:${p.lane};--lanes:${p.lanes}`;
      b.setAttribute('aria-label', `${span(s, e)}, ${a.patientName}, ${st.label}${a.reason ? ', ' + a.reason : ''}`);
      b.append(el('span', 'meta text-current', span(s, e)), el('span', 'appt-name font-semibold', a.patientName), el('span', 'appt-more', [a.reason, surname(a.dentistName)].filter(Boolean).join(' · ')));
      const allergy = allergyOf(a);
      if (allergy || a.source !== 'staff') {
        const marks = el('span', 'appt-marks');
        if (allergy) { const m = el('span', 'appt-mark bg-caries'); m.title = `Allergy: ${allergy}`; m.append(el('span', 'sr-only', `Allergy: ${allergy}`)); marks.append(m); }
        if (a.source !== 'staff') marks.append(el('span', 'meta text-current', 'web'));
        b.append(marks);
      }
      return b;
    }
    function renderHead(c: Col) {
      const d = el('div', 'border-l border-line-2 px-3 py-2'); d.dataset.laneHead = c.key;
      d.append(el('p', 'text-[13.5px] font-semibold', c.label)); if (c.sub) d.append(el('p', 'meta', c.sub));
      return d;
    }
    function renderGutter(rows: number[]) {
      const g = el('div', 'gutter');
      for (const m of rows) {
        if (m % 60 === 0) { const h = el('span', 'hour meta', hm(m)); h.style.setProperty('--s', String(m - gridStart)); g.append(h); }
        const t = el('span', `tick ${m % 60 === 0 ? 'tick-hour bg-line' : 'bg-line-2'}`); t.style.setProperty('--s', String(m - gridStart)); g.append(t);
      }
      return g;
    }
    function renderLane(c: Col, rows: number[], placed: Placed[]) {
      const lane = el('div', 'lane border-l border-line-2'); lane.dataset.lane = c.key; lane.dataset.laneLabel = c.label;
      for (const m of rows) {
        const cell = el('button', `cell${m % 60 === 0 ? ' border-t border-line-2' : ''}`);
        cell.type = 'button'; cell.tabIndex = -1; cell.dataset.cell = ''; cell.dataset.col = c.key; cell.dataset.min = String(m);
        cell.setAttribute('aria-label', `${c.label}, ${hm(m)}, add a visit`);
        lane.append(cell);
      }
      for (const p of placed) lane.append(renderBlock(p, c.key));
      return lane;
    }
    const nowLine = $('[data-now]', body) ?? el('div', 'now bg-caries');
    function tickNow() {
      const m = (Date.now() - dayStart) / 60_000;
      const show = isToday && m >= gridStart && m <= gridEnd;
      nowLine.hidden = !show;
      if (show) nowLine.style.setProperty('--s', String(m - gridStart));
    }
    window.setInterval(tickNow, 30_000);

    function updateCount() {
      const list = [...appts.values()];
      const n = list.length, u = list.filter((a) => a.chair === null).length;
      const bits = [n === 0 ? 'nothing booked' : `${n} booked`, `${u} unplaced`];
      if (dayHours) { const f = nextFree(list); bits.push(f ? `next free 30 min: Chair ${f.chair} at ${hm(f.min)}` : isToday ? 'no free 30 min left today' : 'no free 30 min'); }
      const c = $('[data-count]'); if (c) c.textContent = bits.join(' · ');
      const empty = $('[data-empty]'), filtered = $('[data-filtered]');
      if (empty) empty.hidden = n > 0;
      if (filtered) filtered.hidden = !(n > 0 && shownList().length === 0);
      const rowsEl = $('[data-print-rows]');
      if (rowsEl) {
        const shown = shownList().sort((x, y) => x.startsAt.localeCompare(y.startsAt));
        rowsEl.replaceChildren(...(shown.length === 0 ? [(() => { const tr = el('tr'); const td = el('td', 'py-2 text-muted', 'Nothing on the book.'); td.colSpan = 7; tr.append(td); return tr; })()] : shown.map((a) => {
          const tr = el('tr', 'border-b border-line-2');
          const name = el('td', 'py-1.5 pr-3 font-semibold', a.patientName);
          if (allergyOf(a)) name.append(el('span', 'text-caries', ` · allergy: ${allergyOf(a)}`));
          tr.append(el('td', 'py-1.5 pr-3 whitespace-nowrap tabular-nums', timeOf(a.startsAt)), name, el('td', 'py-1.5 pr-3 tabular-nums', a.chartNo), el('td', 'py-1.5 pr-3', a.reason ?? ''),
            el('td', 'py-1.5 pr-3', a.dentistName ?? ''), el('td', 'py-1.5 pr-3 tabular-nums', a.chair === null ? 'unplaced' : String(a.chair)), el('td', 'py-1.5', QUEUE[a.status]?.label ?? a.status));
          return tr;
        })));
      }
    }

    /** Rebuild the grid from what the page knows. Cheap, and it keeps one renderer honest. */
    function redraw() {
      const all = [...appts.values()], shown = shownList();
      [gridStart, gridEnd] = bounds(all.map(spanOf), dayHours);
      const cols = columns(shown);
      const rows: number[] = []; for (let m = gridStart; m < gridEnd; m += 15) rows.push(m);
      grid!.dataset.start = String(gridStart); grid!.dataset.end = String(gridEnd);
      grid!.style.setProperty('--cols', String(cols.length)); grid!.style.setProperty('--span', String(gridEnd - gridStart));
      head.replaceChildren(el('div', 'px-2 py-2'), ...cols.map(renderHead));
      body.replaceChildren(renderGutter(rows), ...cols.map((c) => renderLane(c, rows, lanes(shown.filter((a) => colOf(a) === c.key).map((a) => ({ a, ...spanOf(a) }))))), nowLine);
      nowLine.dataset.now = '';
      tickNow();
      updateCount();
    }

    /** Take the server's word for a visit: keep it, move it, or drop it from this day. */
    function absorb(a: Appt, verb: string) {
      const t = Date.parse(a.startsAt);
      const inDay = t >= dayStart && t < dayStart + 86_400_000;
      if (a.status === 'cancelled' || !inDay) appts.delete(a.id); else appts.set(a.id, a);
      redraw();
      if (a.status === 'cancelled') say(`${a.patientName}'s visit is cancelled.`);
      else if (!inDay) say(`${verb} ${a.patientName} ${verb === 'Saved' ? 'for' : 'to'} ${whenOf(a.startsAt)}.`, { href: urlFor({ date: manila(a.startsAt).ymd }), label: 'Open that day' });
    }

    // --- the panel -----------------------------------------------------------
    const panel = $('[data-panel]')!, panelTitle = $('[data-panel-title]', panel)!;
    const newForm = $<HTMLFormElement>('[data-new-form]', panel)!, visit = $('[data-visit]', panel)!;
    let opener: HTMLElement | null = null;
    let current: string | null = null;

    function openPanel(mode: 'new' | 'visit', from: HTMLElement | null) {
      opener = from;
      newForm.hidden = mode !== 'new'; visit.hidden = mode !== 'visit';
      panelTitle.textContent = mode === 'new' ? 'New visit' : 'Visit';
      panel.hidden = false;
      void panel.offsetWidth; // the panel has to exist before it can slide in
      panel.classList.add('is-open');
      const first = mode === 'new' ? $<HTMLElement>('[data-new-search]', panel) : panelTitle;
      (first ?? panel).focus({ preventScroll: window.innerWidth >= 1024 });
      if (window.innerWidth < 1024) panel.scrollIntoView({ block: 'start' });
    }
    function closePanel() {
      if (panel.hidden) return;
      panel.classList.remove('is-open');
      panel.hidden = true;
      current = null;
      // The block may have been redrawn since; find it again by id.
      const id = opener?.dataset.id;
      const back = id ? $<HTMLElement>(`.appt[data-id="${id}"]`, body) : opener;
      if (back && back.isConnected) back.focus(); else $('[data-new]')?.focus();
      opener = null;
    }
    panel.querySelectorAll('[data-panel-close]').forEach((b) => b.addEventListener('click', closePanel));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !panel.hidden) { e.preventDefault(); closePanel(); } });

    /** The dentists in on a given day, plus whoever is already chosen so a saved choice never vanishes. */
    function fillDentists(select: HTMLSelectElement, ymd: string, keep: string) {
      const d = dowOfYmd(ymd);
      const opts = [new Option('Any', '')];
      for (const s of range.staff) if (s.days.includes(d) || s.id === keep) opts.push(new Option(s.days.includes(d) ? s.name : `${s.name} · not in ${DAYWORD[d]}`, s.id));
      if (keep && !opts.some((o) => o.value === keep)) { const a = appts.get(current ?? ''); opts.push(new Option(a?.dentistName ?? 'Dentist', keep)); }
      select.replaceChildren(...opts);
      select.value = keep;
    }

    // --- new visit ---------------------------------------------------------
    const nf = {
      err: $('[data-new-error]', newForm)!, lookup: $('[data-new-lookup]', newForm)!, search: $<HTMLInputElement>('[data-new-search]', newForm)!,
      results: $<HTMLUListElement>('[data-new-results]', newForm)!, hint: $('[data-new-hint]', newForm)!, toggle: $<HTMLInputElement>('[data-new-toggle]', newForm)!,
      chosen: $('[data-new-chosen]', newForm)!, chosenName: $('[data-new-chosen-name]', newForm)!, chosenMore: $('[data-new-chosen-more]', newForm)!,
      patientId: $<HTMLInputElement>('[data-new-patient-id]', newForm)!, patientBox: $('[data-new-patient]', newForm)!,
      name: $<HTMLInputElement>('[data-new-name]', newForm)!, phone: $<HTMLInputElement>('[data-new-phone]', newForm)!,
      service: $<HTMLSelectElement>('[data-new-service]', newForm)!, reason: $<HTMLInputElement>('[data-new-reason]', newForm)!,
      minutes: $<HTMLInputElement>('[data-new-minutes]', newForm)!, chair: $<HTMLSelectElement>('[data-new-chair]', newForm)!,
      dentist: $<HTMLSelectElement>('[data-new-dentist]', newForm)!, date: $<HTMLInputElement>('[data-new-date]', newForm)!,
      time: $<HTMLInputElement>('[data-new-time]', newForm)!, notes: $<HTMLTextAreaElement>('[data-new-notes]', newForm)!, save: $<HTMLButtonElement>('[data-new-save]', newForm)!,
    };
    const showErr = (p: HTMLElement, text: string) => { p.textContent = text; p.hidden = false; };
    const hideErr = (p: HTMLElement) => { p.hidden = true; p.textContent = ''; };

    function openNew(prefill: { col?: string; min?: number }, from: HTMLElement | null) {
      newForm.reset();
      hideErr(nf.err);
      nf.search.disabled = false; delete nf.reason.dataset.auto;
      nf.patientId.value = ''; nf.chosen.hidden = true; nf.lookup.hidden = false; nf.patientBox.hidden = true;
      nf.results.hidden = true; nf.results.replaceChildren(); nf.hint.hidden = false;
      nf.minutes.value = '30';
      nf.date.value = date;
      const min = prefill.min ?? Math.max(gridStart, Math.ceil((isToday ? (Date.now() - dayStart) / 60_000 : gridStart) / 15) * 15);
      nf.time.value = hhmm(Math.min(min, gridEnd - 15));
      nf.chair.value = by === 'chair' ? (prefill.col ?? '') : '';
      fillDentists(nf.dentist, date, by === 'dentist' ? (prefill.col ?? '') : filter);
      openPanel('new', from);
    }
    $('[data-new]')?.addEventListener('click', (e) => openNew({}, e.currentTarget as HTMLElement));

    nf.toggle.addEventListener('change', () => {
      const on = nf.toggle.checked;
      nf.patientBox.hidden = !on; nf.search.disabled = on; nf.results.hidden = true; nf.hint.hidden = on;
      if (on) { nf.patientId.value = ''; nf.chosen.hidden = true; nf.name.focus(); }
    });
    nf.service.addEventListener('change', () => {
      const o = nf.service.selectedOptions[0];
      if (!o || !o.value) return;
      if (o.dataset.minutes) nf.minutes.value = o.dataset.minutes;
      if (!nf.reason.value.trim() || nf.reason.dataset.auto === '1') { nf.reason.value = o.dataset.name ?? o.text; nf.reason.dataset.auto = '1'; }
    });
    nf.reason.addEventListener('input', () => { delete nf.reason.dataset.auto; });
    nf.date.addEventListener('change', () => fillDentists(nf.dentist, nf.date.value || date, nf.dentist.value));
    $('[data-new-change]', newForm)?.addEventListener('click', () => { nf.patientId.value = ''; nf.chosen.hidden = true; nf.lookup.hidden = false; nf.search.value = ''; nf.search.focus(); });

    // Patient search: two characters in, eight names out. An older reply never overwrites a newer one.
    let searchTimer = 0, searchAbort: AbortController | null = null;
    nf.search.addEventListener('input', () => {
      window.clearTimeout(searchTimer);
      const q = nf.search.value.trim();
      if (q.length < 2) { nf.results.hidden = true; nf.results.replaceChildren(); nf.hint.hidden = false; nf.hint.textContent = 'Type two letters of a name, a chart number or a mobile.'; return; }
      searchTimer = window.setTimeout(async () => {
        searchAbort?.abort(); searchAbort = new AbortController();
        try {
          const res = await fetch(`/api/patients?clinic=${encodeURIComponent(slug)}&q=${encodeURIComponent(q)}`, { credentials: 'same-origin', signal: searchAbort.signal });
          const data = res.ok ? await res.json() : null;
          const found: { id: string; name: string; chartNo: string; phone: string | null; lastVisit: string | null }[] = Array.isArray(data?.patients) ? data.patients : [];
          nf.results.replaceChildren(...found.slice(0, 8).map((p) => {
            const li = el('li');
            const b = el('button', 'block w-full px-3 py-2 text-left text-[14px] hover:bg-bg-soft'); b.type = 'button'; b.dataset.pick = p.id;
            b.append(el('strong', 'font-semibold', p.name), el('span', 'text-muted', ` · ${p.chartNo}${p.phone ? ' · ' + p.phone : ''}`));
            b.addEventListener('click', () => {
              nf.patientId.value = p.id; nf.chosenName.textContent = p.name; nf.chosenMore.textContent = `· ${p.chartNo}${p.phone ? ' · ' + p.phone : ''}`;
              nf.chosen.hidden = false; nf.lookup.hidden = true; nf.results.hidden = true;
              (nf.service.value ? nf.time : nf.service).focus();
            });
            li.append(b); return li;
          }));
          nf.results.hidden = found.length === 0;
          nf.hint.hidden = found.length > 0;
          nf.hint.textContent = res.ok ? (found.length ? '' : 'No one on file matches. Tick New patient to add them.') : 'Could not reach the clinic to search. Tick New patient, or try again.';
        } catch (e) {
          if ((e as Error).name !== 'AbortError') { nf.hint.hidden = false; nf.hint.textContent = 'Could not reach the clinic to search. Tick New patient, or try again.'; }
        }
      }, 220);
    });

    newForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      hideErr(nf.err);
      const minutes = Number(nf.minutes.value);
      const body: Record<string, unknown> = {};
      if (nf.toggle.checked) {
        const name = nf.name.value.trim();
        if (!name) return showErr(nf.err, 'Give the new patient a name.');
        body.newPatient = { name, phone: nf.phone.value.trim() || undefined };
      } else if (nf.patientId.value) body.patientId = nf.patientId.value;
      else return showErr(nf.err, 'Pick a patient from the search, or tick New patient.');
      if (!Number.isInteger(minutes) || minutes < 5 || minutes > 480) return showErr(nf.err, 'Minutes is a whole number from 5 to 480.');
      if (!/^\d{4}-\d{2}-\d{2}$/.test(nf.date.value) || !/^\d{2}:\d{2}/.test(nf.time.value)) return showErr(nf.err, 'Pick a date and a time.');
      body.startsAt = isoOf(nf.date.value, nf.time.value);
      body.minutes = minutes;
      body.chair = nf.chair.value === '' ? null : Number(nf.chair.value);
      body.dentistId = nf.dentist.value || null;
      if (nf.reason.value.trim()) body.reason = nf.reason.value.trim();
      if (nf.service.value) body.catalogCode = nf.service.value;
      if (nf.notes.value.trim()) body.notes = nf.notes.value.trim();
      nf.save.disabled = true;
      const r = await call('POST', body);
      nf.save.disabled = false;
      if (!r.ok) return showErr(nf.err, r.error);
      closePanel();
      absorb(r.appointment, 'Saved');
      const t = Date.parse(r.appointment.startsAt);
      if (t >= dayStart && t < dayStart + 86_400_000) say(`Saved. ${r.appointment.patientName}, ${whenOf(r.appointment.startsAt)}.`);
    });

    // --- a visit -----------------------------------------------------------------
    const vf = {
      err: $('[data-visit-error]', visit)!, name: $<HTMLAnchorElement>('[data-visit-name]', visit)!, chart: $('[data-visit-chart]', visit)!,
      allergy: $('[data-visit-allergy]', visit)!, when: $('[data-visit-when]', visit)!, reason: $('[data-visit-reason]', visit)!,
      dentist: $('[data-visit-dentist]', visit)!, chair: $('[data-visit-chair]', visit)!, source: $('[data-visit-source]', visit)!,
      notes: $('[data-visit-notes]', visit)!, status: $('[data-visit-status]', visit)!, actions: $('[data-visit-actions]', visit)!,
      ask: $('[data-visit-cancel-ask]', visit)!, yes: $('[data-visit-cancel-yes]', visit)!, keep: $('[data-visit-cancel-keep]', visit)!,
      move: $<HTMLFormElement>('[data-move-form]', visit)!, mDate: $<HTMLInputElement>('[data-move-date]', visit)!, mTime: $<HTMLInputElement>('[data-move-time]', visit)!,
      mChair: $<HTMLSelectElement>('[data-move-chair]', visit)!, mMinutes: $<HTMLInputElement>('[data-move-minutes]', visit)!,
      mDentist: $<HTMLSelectElement>('[data-move-dentist]', visit)!, mSave: $<HTMLButtonElement>('[data-move-save]', visit)!,
    };

    function fillVisit(a: Appt) {
      const st = QUEUE[a.status] ?? QUEUE.booked;
      vf.name.textContent = a.patientName; vf.name.href = `/c/${slug}/patients/${a.patientId}/`;
      vf.chart.textContent = [a.chartNo, a.phone].filter(Boolean).join(' · ');
      vf.allergy.hidden = !allergyOf(a); vf.allergy.textContent = allergyOf(a) ? `Allergy: ${allergyOf(a)}` : '';
      vf.when.textContent = `${whenOf(a.startsAt)} – ${timeOf(a.endsAt)}`;
      vf.reason.textContent = a.reason ?? '—';
      vf.dentist.textContent = a.dentistName ?? 'Any dentist';
      vf.chair.textContent = a.chair === null ? 'Unplaced' : `Chair ${a.chair}`;
      vf.source.textContent = `${SOURCE[a.source] ?? a.source}${a.publicRef ? ` · Ref ${a.publicRef}` : ''}`;
      vf.notes.textContent = a.notes ?? '—';
      vf.status.className = `inline-block px-3 py-1.5 text-xs font-semibold ${st.cls}`; vf.status.textContent = st.label;
      vf.ask.hidden = true;
      vf.actions.replaceChildren();
      const btn = (label: string, to: string) => {
        const b = el('button', 'btn btn-quiet !px-3 !py-1.5 text-[13px]', label); b.type = 'button'; b.dataset.to = to;
        b.addEventListener('click', () => patch({ id: a.id, status: to }, vf.err, 'Updated'));
        return b;
      };
      for (const n of NEXT[a.status] ?? []) vf.actions.append(btn(n.label, n.to));
      if (!DONE.has(a.status)) vf.actions.append(btn('No show', 'no_show'));
      if (a.status !== 'cancelled' && a.status !== 'completed') {
        const c = el('button', 'btn btn-quiet !px-3 !py-1.5 text-[13px]', 'Cancel'); c.type = 'button'; c.dataset.visitCancel = '';
        c.addEventListener('click', () => { vf.ask.hidden = false; vf.yes.focus(); });
        vf.actions.append(c);
      }
      const m = manila(a.startsAt);
      vf.mDate.value = m.ymd; vf.mTime.value = hhmm(m.min);
      vf.mChair.value = a.chair === null ? '' : String(a.chair);
      vf.mMinutes.value = String(Math.max(5, Math.round((Date.parse(a.endsAt) - Date.parse(a.startsAt)) / 60_000)));
      fillDentists(vf.mDentist, m.ymd, a.dentistId ?? '');
      vf.move.hidden = DONE.has(a.status);
    }
    function openVisit(id: string, from: HTMLElement | null) {
      const a = appts.get(id); if (!a) return;
      current = id; hideErr(vf.err); fillVisit(a); openPanel('visit', from);
    }
    vf.yes.addEventListener('click', () => { if (current) patch({ id: current, status: 'cancelled' }, vf.err, 'Cancelled'); });
    vf.keep.addEventListener('click', () => { vf.ask.hidden = true; });
    vf.mDate.addEventListener('change', () => fillDentists(vf.mDentist, vf.mDate.value || date, vf.mDentist.value));
    vf.move.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!current) return;
      const minutes = Number(vf.mMinutes.value);
      if (!Number.isInteger(minutes) || minutes < 5 || minutes > 480) return showErr(vf.err, 'Minutes is a whole number from 5 to 480.');
      if (!/^\d{4}-\d{2}-\d{2}$/.test(vf.mDate.value) || !/^\d{2}:\d{2}/.test(vf.mTime.value)) return showErr(vf.err, 'Pick a date and a time.');
      patch({ id: current, startsAt: isoOf(vf.mDate.value, vf.mTime.value), minutes, chair: vf.mChair.value === '' ? null : Number(vf.mChair.value), dentistId: vf.mDentist.value || null }, vf.err, 'Moved');
    });

    /** One PATCH; the panel, if it is open on this visit, redraws from the answer. */
    async function patch(body: Record<string, unknown>, errAt: HTMLElement | null, verb: string): Promise<boolean> {
      const r = await call('PATCH', body);
      if (!r.ok) { if (errAt) showErr(errAt, r.error); else fail(r.error); return false; }
      if (errAt) hideErr(errAt);
      const a = r.appointment;
      absorb(a, verb);
      if (current === a.id) {
        if (appts.has(a.id)) fillVisit(a); else closePanel();
      }
      return true;
    }

    // --- clicks on the grid --------------------------------------------------
    let suppressClick = false;
    grid.addEventListener('click', (e) => {
      if (suppressClick) { suppressClick = false; e.preventDefault(); return; }
      const t = e.target as HTMLElement;
      const block = t.closest<HTMLButtonElement>('button.appt');
      if (block?.dataset.id) { openVisit(block.dataset.id, block); return; }
      const cell = t.closest<HTMLButtonElement>('[data-cell]');
      if (cell) openNew({ col: cell.dataset.col ?? '', min: Number(cell.dataset.min) }, cell);
    });

    // --- drag to move ---------------------------------------------------------
    // Pointer events, one finger or a mouse. Six pixels of travel start the drag so a
    // click still opens the visit; the ghost follows the hand and the cell under it lights.
    type Drag = { el: HTMLButtonElement; a: Appt; x0: number; y0: number; started: boolean; ghost: HTMLElement | null; target: HTMLElement | null; grabMin: number; width: number; height: number; dx: number; dy: number };
    let drag: Drag | null = null;
    const mpx = () => parseFloat(getComputedStyle(grid!).getPropertyValue('--mpx')) || 1.6;

    grid.addEventListener('pointerdown', (e) => {
      if (e.button !== 0 || drag) return;
      const block = (e.target as HTMLElement).closest<HTMLButtonElement>('button.appt');
      if (!block?.dataset.id) return;
      const a = appts.get(block.dataset.id); if (!a) return;
      const r = block.getBoundingClientRect();
      drag = { el: block, a, x0: e.clientX, y0: e.clientY, started: false, ghost: null, target: null, grabMin: Math.round((e.clientY - r.top) / mpx() / 15) * 15, width: r.width, height: r.height, dx: e.clientX - r.left, dy: e.clientY - r.top };
      block.setPointerCapture(e.pointerId);
    });
    grid.addEventListener('pointermove', (e) => {
      if (!drag) return;
      if (!drag.started) {
        if (Math.hypot(e.clientX - drag.x0, e.clientY - drag.y0) < 6) return;
        drag.started = true;
        const ghost = drag.el.cloneNode(true) as HTMLElement;
        ghost.classList.add('appt-ghost'); ghost.removeAttribute('data-id'); ghost.setAttribute('aria-hidden', 'true');
        ghost.style.width = `${drag.width}px`; ghost.style.height = `${drag.height}px`;
        document.body.append(ghost); document.body.classList.add('is-dragging');
        drag.ghost = ghost; drag.el.classList.add('is-dragging');
      }
      e.preventDefault();
      drag.ghost!.style.left = `${e.clientX - drag.dx}px`; drag.ghost!.style.top = `${e.clientY - drag.dy}px`;
      const under = document.elementFromPoint(e.clientX, e.clientY)?.closest<HTMLElement>('[data-cell]') ?? null;
      if (under !== drag.target) { drag.target?.classList.remove('bg-accent/10'); drag.target = under; under?.classList.add('bg-accent/10'); }
    });
    const endDrag = async (e: PointerEvent, drop: boolean) => {
      if (!drag) return;
      const d = drag; drag = null;
      if (!d.started) return;
      suppressClick = true; window.setTimeout(() => { suppressClick = false; }, 0);
      d.ghost?.remove(); document.body.classList.remove('is-dragging');
      d.el.classList.remove('is-dragging'); d.target?.classList.remove('bg-accent/10');
      const cell = drop ? d.target : null;
      if (!cell) return;
      const a = d.a, dur = Math.max(5, (Date.parse(a.endsAt) - Date.parse(a.startsAt)) / 60_000);
      const start = Math.min(gridEnd - dur, Math.max(gridStart, Number(cell.dataset.min) - d.grabMin));
      const key = cell.dataset.col ?? '';
      const sameTime = Math.abs(minOf(a.startsAt) - start) < 1, sameCol = colOf(a) === key;
      if (sameTime && sameCol) return;
      const startsAt = new Date(dayStart + start * 60_000).toISOString();
      const body: Record<string, unknown> = { id: a.id, startsAt };
      if (by === 'chair') body.chair = key === '' ? null : Number(key); else body.dentistId = key || null;
      // The block moves under the hand; a refusal snaps it back with the sentence under the toolbar.
      const guess: Appt = { ...a, startsAt, endsAt: new Date(dayStart + (start + dur) * 60_000).toISOString(), ...(by === 'chair' ? { chair: key === '' ? null : Number(key) } : { dentistId: key || null, dentistName: key ? (staffById.get(key)?.name ?? a.dentistName) : null }) };
      appts.set(a.id, guess); redraw();
      const r = await call('PATCH', body);
      if (!r.ok) { appts.set(a.id, a); redraw(); fail(r.error); return; }
      absorb(r.appointment, 'Moved');
      if (current === a.id) fillVisit(r.appointment);
      if (toastErr) toastErr.hidden = true;
    };
    grid.addEventListener('pointerup', (e) => { void endDrag(e, true); });
    grid.addEventListener('pointercancel', (e) => { void endDrag(e, false); });
    grid.addEventListener('lostpointercapture', (e) => { if (drag && !drag.started) drag = null; });

    tickNow();
  }
</script>
