---
// Staff sign-in. One form, one error message, and straight into the branch
// they came for. Patients never see this page: booking needs no account.
//
// Guarded three ways: the CSRF token on the form, a rate limit per email and
// per address (a desk mistyping eight times in fifteen minutes waits or
// resets; a script gets nowhere), and every attempt written to auth_event.
export const prerender = false;

import StaffEntrance from '../../components/StaffEntrance.astro';
import Icon from '../../components/ws/Icon.astro';
import Csrf from '../../components/Csrf.astro';
import { authenticate, setSession, readSession, authEvent, SESSION_HOURS, type Device } from '../../lib/auth';
import { csrfOk, CSRF_MESSAGE } from '../../lib/csrf';
import { hit, refund, clientIp, waitText, LIMITS } from '../../lib/throttle';

// Only a workspace path may be a destination; anything else is dropped, so a
// crafted link cannot bounce a signed-in person to another site.
const next = (Astro.url.searchParams.get('next') || '').match(/^\/(?:c\/[^/?#]+|admin)\/[^\s]*$/)?.[0] ?? '';
const denied = Astro.url.searchParams.get('denied') === '1';
const done = Astro.url.searchParams.get('done') || '';
let error = '';
// Which field the error is about, so the page can mark it and put the cursor there.
let errorOn: 'password' | 'email' | null = null;
// Echoed back after a miss, so nobody retypes an email they got right.
let email = '';
let device: Device = 'shared';

// Already signed in and allowed through? Go where they were going.
const existing = readSession(Astro.cookies);
if (existing && Astro.request.method === 'GET' && !denied && next) return Astro.redirect(next);

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  email = String(form.get('email') ?? '').trim().toLowerCase();
  const password = String(form.get('password') ?? '');
  // Own device: two weeks. Shared at the clinic: one shift. Anything else is shared.
  device = form.get('device') === 'own' ? 'own' : 'shared';
  const ip = clientIp(Astro), ua = Astro.request.headers.get('user-agent');
  if (!csrfOk(Astro.cookies, form)) error = CSRF_MESSAGE;
  else {
    // Counted first, atomically, then given back on success: the lock counts failures only,
    // and a burst of parallel guesses cannot slip past a check-then-count.
    const [byEmail, byIp] = await Promise.all([hit(`login:e:${email}`, ...LIMITS.login.email), hit(`login:ip:${ip}`, ...LIMITS.login.ip)]);
    if (!byEmail.allowed || !byIp.allowed) {
      error = `Too many sign-in attempts. ${waitText(Math.max(byEmail.retryAfter, byIp.retryAfter))} Or reset your password below.`;
      await authEvent('login.locked', { email, ip, ua });
    } else {
      const who = await authenticate(email, password);
      if (!who) { error = 'That email and password don’t match a staff account. Check the password, or reset it below.'; errorOn = 'password'; await authEvent('login.fail', { email, ip, ua }); }
      else if (!who.clinics.length && who.admin) {
        // Flossify's own people: no branch, the operations pages instead.
        setSession(Astro.cookies, { staffId: who.staffId, groupId: who.groupId, clinicId: '', name: who.name, role: who.role, tv: who.tv }, SESSION_HOURS[device]);
        await refund(`login:e:${email}`); await authEvent('login.ok', { email, staffId: who.staffId, ip, ua });
        return Astro.redirect(next.startsWith('/admin/') ? next : '/admin/');
      }
      else if (!who.clinics.length) { error = 'Your account has no branch to open yet. Ask your clinic owner to add you on Settings → Team.'; errorOn = 'email'; await authEvent('login.fail', { email, staffId: who.staffId, ip, ua }); }
      else {
        const wanted = next.match(/^\/c\/([^/]+)\//)?.[1];
        const clinic = who.clinics.find((c) => c.slug === wanted) ?? who.clinics[0];
        setSession(Astro.cookies, { staffId: who.staffId, groupId: who.groupId, clinicId: clinic.id, name: who.name, role: who.role, tv: who.tv }, SESSION_HOURS[device]);
        await refund(`login:e:${email}`); await authEvent('login.ok', { email, staffId: who.staffId, ip, ua });
        return Astro.redirect(next && wanted === clinic.slug ? next : `/c/${clinic.slug}/`);
      }
    }
  }
}

const notice = done === 'password' ? 'Your password is set. Sign in with it now.' : done === 'out' ? 'You are signed out. See you next shift.' : '';

// Said the way the front desk would say it, by the clock in Manila.
const hour = +new Intl.DateTimeFormat('en-PH', { timeZone: 'Asia/Manila', hour: 'numeric', hour12: false }).format(new Date());
const hello = hour >= 5 && hour < 12 ? 'Good morning.' : hour >= 12 && hour < 18 ? 'Good afternoon.' : hour >= 18 && hour < 22 ? 'Good evening.' : 'Working late.';

// The seeded test logins, on the owner's own machine only (SHOW_DEMO_LOGINS=1). Read from the
// server's environment on every request: import.meta.env is fixed at build time, and a build made
// where the flag is set must not carry a known password onto a real clinic's sign-in page. The
// import.meta.env half is for `astro dev` alone, which reads .env but not into process.env; a build
// turns import.meta.env.DEV into false, so that half compiles away and nothing is baked in.
const demoLogins = process.env.SHOW_DEMO_LOGINS === '1' || (import.meta.env.DEV && import.meta.env.SHOW_DEMO_LOGINS === '1');

// A key, for the one door the workspace's icon set has no picture for (drawn like ws/icons.ts: 24 units, 1.75 stroke).
const KEY = '<svg class="ws-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="8" cy="15" r="4.5" /><path d="M11.2 11.8L20 3M16.5 6.5l3 3M14 9l2.5 2.5" /></svg>';

const ways = [
  { href: '/auth/forgot/', icon: 'key', title: 'Forgot your password?', body: 'We send you a code.' },
  { href: '/auth/code/', icon: 'message', title: 'I have a code', body: 'From your clinic, or from a reset.' },
  { href: '/start/', icon: 'clinic', title: 'New clinic?', body: 'Set it up in minutes.' },
] as const;
---

<!-- The walk plays when you arrive; a form shown again after a miss opens at the desk, where you already are. -->
<StaffEntrance title="Staff sign-in — Flossify" description="Sign in to your clinic's workspace." walk={Astro.request.method === 'GET'}>
  <h1 class="entry-title">
    <span class="block" data-hello>{hello}</span>
    <span class="entry-sub">Sign in to your clinic.</span>
  </h1>

  {notice && !error && <p role="status" class="entry-note entry-note-ok mt-5"><Icon name="check" /><span>{notice}</span></p>}
  {denied && !error && <p role="alert" class="entry-note entry-note-warn mt-5"><Icon name="alert" /><span>You’re signed in, but not for that branch. Sign in as someone who is, or open one of yours.</span></p>}

  <form method="post" class="entry-form" data-signin>
    <Csrf />

    <div class="entry-field">
      <label for="email" class="entry-label">Email</label>
      <input id="email" type="email" name="email" value={email} autocomplete="username" inputmode="email" spellcheck="false"
        required autofocus={errorOn !== 'password'} aria-invalid={errorOn === 'email' ? 'true' : undefined}
        aria-describedby={error ? 'signin-error' : undefined} data-email />
      <button type="button" class="entry-link" hidden data-not-you>Not you? Use another email</button>
    </div>

    <div class="entry-field">
      <label for="password" class="entry-label">Password</label>
      <div class="entry-secret">
        <input id="password" type="password" name="password" autocomplete="current-password" required
          autofocus={errorOn === 'password'} aria-invalid={errorOn === 'password' ? 'true' : undefined}
          aria-describedby={['caps-note', error && 'signin-error'].filter(Boolean).join(' ')} data-password />
        <button type="button" class="entry-show" aria-controls="password" aria-pressed="false" data-show>Show</button>
      </div>
      <p id="caps-note" class="entry-caps" role="status" data-caps hidden><Icon name="alert" size={16} /><span>Caps Lock is on.</span></p>
    </div>

    <fieldset class="entry-devices" aria-describedby="device-hint">
      <legend class="entry-label">This device</legend>
      <div class="entry-seg">
        <label><input type="radio" name="device" value="shared" class="sr-only" checked={device === 'shared'} data-device />Shared at the clinic</label>
        <label><input type="radio" name="device" value="own" class="sr-only" checked={device === 'own'} data-device />My own</label>
      </div>
      <p id="device-hint" class="entry-hint" data-device-hint>{device === 'own' ? 'Stays signed in for 14 days and remembers your email here.' : 'Signs out after 12 hours. Nothing is remembered on this computer.'}</p>
    </fieldset>

    {error && <p id="signin-error" role="alert" class="entry-note entry-note-bad"><Icon name="alert" /><span>{error}</span></p>}
    <p class="entry-note entry-note-warn" role="status" data-offline-note hidden><Icon name="alert" /><span>This device is offline. Sign-in needs a signal; the button works again as soon as it’s back.</span></p>

    <button type="submit" class="entry-go" data-go><span data-go-label>Sign in</span><Icon name="arrow-right" /></button>
  </form>

  <ul class="entry-ways" aria-label="Other ways in">
    {ways.map((w) => (
      <li>
        <a href={w.href} class="entry-way">
          <span class="entry-way-icon">{w.icon === 'key' ? <Fragment set:html={KEY} /> : <Icon name={w.icon} />}</span>
          <span class="entry-way-words"><span class="entry-way-title">{w.title}</span> <span class="entry-way-hint">{w.body}</span></span>
          <Icon name="chevron-right" class="entry-way-go" />
        </a>
      </li>
    ))}
  </ul>

  {demoLogins && (
    <details class="entry-dev">
      <summary><Icon name="info" /><span>Development database</span><Icon name="chevron" class="entry-dev-chev" /></summary>
      <p>
        Every group owner is seeded with the password <code>flossify</code> — for example <code>liwayway.domingo@example.com</code>. Operations: <code>ops@flossify.example</code>. Shown because this server has <code>SHOW_DEMO_LOGINS=1</code>; never set it on a live one.
      </p>
    </details>
  )}
</StaffEntrance>

<script>
  /* Everything here makes the form kinder; none of it is needed to sign in.
     With scripts off it is a plain form that posts. */
  const form = document.querySelector<HTMLFormElement>('[data-signin]');
  const email = document.querySelector<HTMLInputElement>('[data-email]');
  const password = document.querySelector<HTMLInputElement>('[data-password]');
  const notYou = document.querySelector<HTMLButtonElement>('[data-not-you]');
  const show = document.querySelector<HTMLButtonElement>('[data-show]');
  const caps = document.querySelector<HTMLElement>('[data-caps]');
  const go = document.querySelector<HTMLButtonElement>('[data-go]');
  const offlineNote = document.querySelector<HTMLElement>('[data-offline-note]');
  const radios = Array.from(document.querySelectorAll<HTMLInputElement>('[data-device]'));
  const KEY = 'flossify:staff-email', DEVICE = 'flossify:device';

  // Storage can be blocked (private mode, a locked-down clinic PC); every use tolerates that.
  const read = (k: string) => { try { return localStorage.getItem(k); } catch { return null; } };
  const write = (k: string, v: string | null) => { try { v === null ? localStorage.removeItem(k) : localStorage.setItem(k, v); } catch { /* fine */ } };

  const chosen = () => radios.find((r) => r.checked)?.value === 'own' ? 'own' : 'shared';
  const hint = document.querySelector<HTMLElement>('[data-device-hint]');
  const paintDevice = () => {
    const own = chosen() === 'own';
    if (hint) hint.textContent = own ? 'Stays signed in for 14 days and remembers your email here.' : 'Signs out after 12 hours. Nothing is remembered on this computer.';
  };

  // This device's last choice, and — only on someone's own device — their email.
  const savedDevice = read(DEVICE);
  if (savedDevice === 'own' && !form?.querySelector('[role=alert]')) radios.forEach((r) => { r.checked = r.value === 'own'; });
  const saved = read(KEY);
  if (saved && chosen() === 'own' && email && !email.value) {
    email.value = saved;
    if (notYou) notYou.hidden = false;
    password?.focus();
  }
  paintDevice();
  radios.forEach((r) => r.addEventListener('change', paintDevice));

  notYou?.addEventListener('click', () => {
    write(KEY, null);
    if (email) { email.value = ''; email.focus(); }
    notYou.hidden = true;
  });

  // Show the password: typing on a tablet at the chair, with gloves just off.
  show?.addEventListener('click', () => {
    if (!password) return;
    const on = password.type === 'password';
    password.type = on ? 'text' : 'password';
    show.textContent = on ? 'Hide' : 'Show';
    show.setAttribute('aria-pressed', String(on));
    password.focus();
  });

  // Caps Lock: the commonest reason a right password is wrong.
  const capsCheck = (e: KeyboardEvent) => { if (caps && typeof e.getModifierState === 'function') caps.hidden = !e.getModifierState('CapsLock'); };
  password?.addEventListener('keydown', capsCheck);
  password?.addEventListener('keyup', capsCheck);
  password?.addEventListener('blur', () => { if (caps) caps.hidden = true; });

  // After a wrong password: keep the email, empty the password, cursor in it.
  if (form?.querySelector('[aria-invalid="true"][data-password]') && password) { password.value = ''; password.focus(); }

  // Offline: say so, and hold the button until the signal is back.
  document.addEventListener('entrance:net', (e) => {
    const off = (e as CustomEvent<{ offline: boolean }>).detail.offline;
    if (offlineNote) offlineNote.hidden = !off;
    if (go) go.disabled = off;
  });
  if (!navigator.onLine) { if (offlineNote) offlineNote.hidden = false; if (go) go.disabled = true; }

  // One press, one sign-in.
  const goLabel = go?.querySelector<HTMLElement>('[data-go-label]');
  form?.addEventListener('submit', () => {
    write(DEVICE, chosen());
    write(KEY, chosen() === 'own' && email?.value ? email.value.trim().toLowerCase() : null);
    if (go) { go.disabled = true; go.setAttribute('aria-busy', 'true'); }
    if (goLabel) goLabel.textContent = 'Signing in…';
  });
  // Back to this page from the browser's cache: the button is ready again (unless the line is still down).
  addEventListener('pageshow', (e) => {
    if (!e.persisted || !go) return;
    go.disabled = !navigator.onLine;
    go.removeAttribute('aria-busy');
    if (goLabel) goLabel.textContent = 'Sign in';
    if (offlineNote) offlineNote.hidden = navigator.onLine;
  });
</script>
