---
// Staff sign-in. One form, one error message, and straight into the branch
// they came for. Patients never see this page: booking needs no account.
export const prerender = false;

import Base from '../../layouts/Base.astro';
import { authenticate, setSession, readSession } from '../../lib/auth';

const next = Astro.url.searchParams.get('next') || '';
const denied = Astro.url.searchParams.get('denied') === '1';
let error = '';

// Already signed in and allowed through? Go where they were going.
const existing = readSession(Astro.cookies);
if (existing && Astro.request.method === 'GET' && !denied && next) return Astro.redirect(next);

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const email = String(form.get('email') ?? ''), password = String(form.get('password') ?? '');
  const who = await authenticate(email, password);
  if (!who) error = 'That email and password don’t match a staff account.';
  else if (!who.clinics.length) error = 'Your account has no branch to open yet. Ask the owner to add you.';
  else {
    const wanted = next.match(/^\/c\/([^/]+)\//)?.[1];
    const clinic = who.clinics.find((c) => c.slug === wanted) ?? who.clinics[0];
    setSession(Astro.cookies, { staffId: who.staffId, groupId: who.groupId, clinicId: clinic.id, name: who.name, role: who.role });
    return Astro.redirect(next && wanted === clinic.slug ? next : `/c/${clinic.slug}/`);
  }
}
---

<Base title="Staff sign-in — Flossify" description="Sign in to your clinic's workspace.">
  <main id="main" class="mx-auto max-w-[440px] px-5 py-20 sm:px-8">
    <a href="/" class="meta hover:text-ink">&larr; Flossify</a>
    <h1 class="mt-6 font-display text-[clamp(1.8rem,4vw,2.4rem)] leading-tight font-semibold tracking-[-0.02em]">Staff sign-in</h1>
    <p class="mt-3 text-[15px] text-ink-2">Your clinic’s workspace. Patients don’t need an account — <a href="/find/" class="underline underline-offset-4">booking is over here</a>.</p>

    {denied && !error && <p role="alert" class="mt-6 border border-crown/40 bg-crown/10 p-4 text-[14.5px]">You’re signed in, but not for that branch. Sign in as someone who is, or open one of yours.</p>}
    {error && <p role="alert" class="mt-6 border border-caries/40 bg-caries/10 p-4 text-[14.5px]">{error}</p>}

    <form method="post" class="mt-8 grid gap-4">
      <label class="field"><span class="meta">Email</span><input type="email" name="email" autocomplete="username" required autofocus /></label>
      <label class="field"><span class="meta">Password</span><input type="password" name="password" autocomplete="current-password" required /></label>
      <button type="submit" class="btn btn-primary mt-2">Sign in</button>
    </form>

    <p class="mt-8 text-[13.5px] leading-relaxed text-muted">
      Development database: every group owner is seeded with the password <code class="font-mono">flossify</code>, e.g. <code class="font-mono">liwayway.domingo@example.com</code>. Remove this note before anyone real signs in.
    </p>
  </main>
</Base>
