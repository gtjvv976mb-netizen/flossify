---
// Forgot your password. Give us the mobile on your staff account and we text
// a six-digit code; the next page takes the code and the new password. The
// answer is the same whether or not the number is on file, so the form cannot
// be used to find out which numbers belong to staff.
//
// Guarded like sign-in: the CSRF token, a rate limit per number and per
// address (three asks an hour for one number; a script gets nowhere), and
// every ask written to auth_event. Nothing is sent from here: the text is
// queued in message_log under the person's home branch and the worker sends it.
export const prerender = false;

import Base from '../../layouts/Base.astro';
import Csrf from '../../components/Csrf.astro';
import { staffByPhone, authEvent } from '../../lib/auth';
import { pool, withClinic } from '../../lib/db';
import { csrfOk, CSRF_MESSAGE } from '../../lib/csrf';
import { hit, clientIp, waitText, LIMITS } from '../../lib/throttle';
import { issueCode } from '../../lib/codes';
import { normalizePhone, PH_MOBILE, queueText, texts } from '../../lib/messages';

let typed = '';
let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  typed = String(form.get('phone') ?? '').trim();
  const phone = normalizePhone(typed);
  const ip = clientIp(Astro), ua = Astro.request.headers.get('user-agent');
  if (!csrfOk(Astro.cookies, form)) error = CSRF_MESSAGE;
  else if (!PH_MOBILE.test(phone)) error = 'A Philippine mobile number, like 0917 000 0000.';
  else {
    const [byPhone, byIp] = await Promise.all([hit(`forgot:p:${phone}`, ...LIMITS.forgot.phone), hit(`forgot:ip:${ip}`, ...LIMITS.forgot.ip)]);
    if (!byPhone.allowed || !byIp.allowed) {
      error = `Too many requests. ${waitText(Math.max(byPhone.retryAfter, byIp.retryAfter))}`;
      await authEvent('reset.locked', { ip, ua });
    } else {
      const staff = await staffByPhone(phone);
      if (staff) {
        const code = await issueCode(staff.id, 'reset');
        // A text is a clinic's row (RLS), so it needs a clinic: their home branch, else the first one they may open.
        const clinicId: string | null = staff.home_clinic_id
          ?? (await pool.query('select id from staff_branches($1)', [staff.id])).rows[0]?.id ?? null;
        if (clinicId) await withClinic(clinicId, (tx) => queueText(tx, { clinicId, to: phone, body: texts.reset(code), kind: 'reset', staffId: staff.id }));
        await authEvent('reset.request', { email: staff.email, staffId: staff.id, ip, ua });
      }
      // Found or not, the same answer: the code page, told a text may be coming.
      return Astro.redirect(`/auth/code/?phone=${phone}&sent=1`, 303);
    }
  }
}
---

<Base title="Reset your password — Flossify" description="We text a six-digit code to the mobile number on your staff account.">
  <main id="main" class="mx-auto max-w-[440px] px-5 py-20 sm:px-8">
    <a href="/auth/login/" class="meta hover:text-ink">&larr; Staff sign-in</a>
    <h1 class="mt-6 font-display text-[clamp(1.8rem,4vw,2.4rem)] leading-tight font-semibold tracking-[-0.02em]">Reset your password</h1>
    <p class="mt-3 text-[15px] text-ink-2">Tell us the mobile number on your staff account and we’ll text you a six-digit code. No number on file? Ask your clinic owner to reset it from Settings → Team.</p>

    {error && <p role="alert" class="mt-6 border border-caries/40 bg-caries/10 p-4 text-[14.5px]">{error}</p>}

    <form method="post" class="mt-8 grid gap-4">
      <Csrf />
      <label class="field"><span class="meta">Mobile number</span><input type="tel" name="phone" autocomplete="tel" placeholder="0917 000 0000" value={typed} required autofocus /></label>
      <button type="submit" class="btn btn-primary mt-2">Text me a code</button>
    </form>

    <div class="mt-8 grid gap-2 border-t border-line pt-6 text-[14px]">
      <a href="/auth/code/" class="underline underline-offset-4">Already have a code? Enter it here.</a>
      <a href="/auth/login/" class="text-ink-2 underline underline-offset-4">Remembered it? Back to sign-in.</a>
    </div>
  </main>
</Base>
