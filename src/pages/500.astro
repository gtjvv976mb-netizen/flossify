---
// The page for a fault on our side: a page that threw (src/middleware.ts answers 500 with no body, and Astro
// puts this page in it, keeping the status and the headers). Before this page a fault was a blank screen.
//
// Static on purpose, like the offline page: prerendered at build, so it never needs the database or a session,
// which may be the very thing that failed. No top bar for the same reason (its menu is a script and its links
// lead into pages that may fail the same way): the Flossify mark, one card, the words, and the way back.
//
// It says nothing about what broke (the stack is in the server's log, never here), and it does not offer to
// load the address again: when the fault answered a form that was sent, loading it again would send the form
// twice. Go back returns to the page the person came from, as they left it; they check before sending again.
import Base from '../layouts/Base.astro';
import Icon from '../components/ws/Icon.astro';
---

<Base
  title="Something went wrong — Flossify"
  description="Flossify could not show this page because of a fault on our side. Go back, or go to the home page."
>
  <meta slot="head" name="robots" content="noindex" />

  <main id="main" class="mx-auto flex min-h-[100dvh] max-w-[1280px] flex-col items-center justify-center px-5 py-12 sm:px-8">
    <div class="w-full max-w-[560px]">
      <a href="/" class="ws-mark" aria-label="Flossify, home">
        <svg class="ws-mark-sq" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="9" /><path d="M9 8h14v11c0 3-1.6 5-3.2 5S17 22.4 17 20.4v-2.2h-2v2.2c0 2-1.2 3.6-2.8 3.6S9 22 9 19z" /></svg>
        <span class="ws-mark-word">Flossify</span>
      </a>

      <section class="card rounded-pane mt-5 p-6 sm:p-9" aria-labelledby="fault-title">
        <span class="inline-flex size-12 items-center justify-center rounded-card bg-amber-tint text-amber-ink" aria-hidden="true"><Icon name="alert" size={24} /></span>
        <h1 id="fault-title" class="mt-5 text-[clamp(1.75rem,4vw,2.25rem)]">Something went wrong on our side</h1>
        <p class="mt-3 text-[16px] leading-relaxed text-ink-2">
          This page could not be shown just now. It is nothing you did. If you were saving something, check whether it was saved before you send it again.
        </p>
        <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <button type="button" class="btn btn-primary btn-lg" data-fault-back hidden><Icon name="chevron-left" /><span>Go back</span></button>
          <a href="/" class="btn btn-quiet btn-lg"><span>Go to the home page</span><Icon name="arrow-right" /></a>
        </div>
      </section>
    </div>
  </main>
</Base>

<script is:inline>
  // Inline, so the page has no script bundle to fetch from a server that is failing. Go back is offered only
  // when there is a page to go back to (a link opened in a new tab has none).
  (function () {
    var back = document.querySelector('[data-fault-back]');
    if (!back || history.length < 2) return;
    back.hidden = false;
    back.addEventListener('click', function () { history.back(); });
  })();
</script>
