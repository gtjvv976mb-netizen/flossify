---
// The page for an address that is not here: soft, friendly, and two ways on — the home page (the
// one teal button) and Find a clinic — with the other doors (My visits, Clinic sign-in) as quiet
// links. Prerendered (the site is static by default); the server sends it for any address it has no
// page for, with the 404 status.
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import Icon from '../components/ws/Icon.astro';
import type { IconName } from '../components/ws/icons';

const doors: { href: string; label: string; hint: string; icon: IconName }[] = [
  { href: '/me/', label: 'My visits', hint: 'Your visits at every clinic, by your mobile number.', icon: 'calendar' },
  { href: '/auth/login/', label: 'Clinic sign-in', hint: 'For clinic owners, dentists and the front desk.', icon: 'user' },
];
---

<Base title="Page not found — Flossify" description="There is no page at this address. Go to the Flossify home page, or find a clinic.">
  <SiteHeader cta="quiet" />

  <main id="main" class="mx-auto max-w-[1280px] px-5 pt-10 pb-16 sm:px-8 sm:pt-16">
    <section class="card rounded-pane mx-auto max-w-[640px] p-6 sm:p-10" aria-labelledby="nf-title">
      <span class="inline-flex size-12 items-center justify-center rounded-full bg-teal-tint text-teal-ink" aria-hidden="true"><Icon name="search" size={24} /></span>
      <h1 id="nf-title" class="mt-5 text-[clamp(1.75rem,4vw,2.4rem)]">We couldn’t find that page</h1>
      <p class="mt-3 text-[16px] leading-relaxed text-ink-2">The link may be old, or the address may have a small typo.</p>

      <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <a href="/" class="btn btn-primary btn-lg"><span>Go to the home page</span><Icon name="arrow-right" /></a>
        <a href="/find/" class="btn btn-quiet btn-lg"><Icon name="search" />Find a clinic</a>
      </div>

      <ul class="mt-8 grid gap-1 border-t border-hair pt-4" role="list">
        {doors.map((d) => (
          <li>
            <a href={d.href} class="group -mx-3 flex min-h-11 items-center gap-3 rounded-ctl px-3 py-2 transition-colors hover:bg-subtle">
              <span class="inline-flex size-9 flex-none items-center justify-center rounded-ctl bg-teal-tint text-teal-ink" aria-hidden="true"><Icon name={d.icon} /></span>
              <span class="min-w-0 flex-1">
                <span class="block text-[15px] font-semibold text-ink">{d.label}</span>
                <span class="block text-[13.5px] leading-snug text-ink-2">{d.hint}</span>
              </span>
              <Icon name="chevron-right" size={16} class="flex-none text-ink-2 transition-transform group-hover:translate-x-0.5" />
            </a>
          </li>
        ))}
      </ul>
    </section>
  </main>
</Base>
