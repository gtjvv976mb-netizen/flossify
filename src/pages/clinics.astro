---
export const prerender = false;

import Base from '../layouts/Base.astro';
import { loadDirectory } from '../lib/directory-db';
const clinics = (await loadDirectory()).filter((l) => l.workspace).map((l) => ({ slug: l.slug, name: l.name, group: l.area, city: l.address }));
---

<Base
  title="Clinic workspaces — Flossify"
  description="Every clinic gets its own workspace link. Staff sign in and go straight to today's chairs."
>
  <main id="main" class="mx-auto max-w-[1280px] px-5 py-16 sm:px-8">
    <a href="/" class="text-[14.5px] font-medium text-accent">&larr; Back to the site</a>

    <h1 class="mt-6 max-w-[760px] font-display text-[clamp(2rem,5vw,3rem)] leading-tight font-semibold tracking-[-0.025em]">
      Your clinic has its own front door.
    </h1>
    <p class="mt-4 max-w-[620px] text-[17px] leading-relaxed text-ink-2">
      One link per branch. Bookmark it, and it opens on today. If you run several, you see
      them all; if you work at one, you see that one.
    </p>

    <div
      role="note"
      class="mt-8 max-w-[720px] border border-crown/40 bg-crown/10 p-5 text-[14.5px] leading-relaxed"
    >
      <strong class="font-semibold">Every workspace is behind a staff sign-in.</strong>
      A workspace URL is an address, never a credential. Opening a branch you are not assigned to
      sends you back to the sign-in page, and every query inside runs under the database's
      row-level security for that one clinic.
    </div>

    <ul class="mt-10 grid gap-5 lg:grid-cols-2">
      {clinics.map((c) => (
        <li class="border border-line bg-surface p-8">
          <h2 class="font-display text-[26px] font-semibold tracking-tight">{c.name}</h2>
          <p class="mt-1.5 text-[15px] text-muted">{c.group} &middot; {c.city}</p>
          <a
            href={`/c/${c.slug}/`}
            class="mt-7 inline-block bg-accent px-7 py-3.5 text-[15px] font-semibold text-surface hover:bg-accent-deep"
          >
            Open this clinic
          </a>
        </li>
      ))}
    </ul>
  </main>
</Base>
