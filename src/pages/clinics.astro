---
export const prerender = false;

import Base from '../layouts/Base.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import Icon from '../components/ws/Icon.astro';
import ClinicBadge from './find/_ui/ClinicBadge.astro';
import { loadDirectory } from '../lib/directory-db';
const clinics = (await loadDirectory()).filter((l) => l.workspace).map((l) => ({ slug: l.slug, name: l.name, group: l.area, city: l.address }));
---

<Base
  title="Clinic workspaces — Flossify"
  description="Every clinic gets its own workspace link. Staff sign in and go straight to today's chairs."
>
  <SiteHeader />

  <main id="main" class="mx-auto max-w-[1280px] px-5 pt-10 pb-16 sm:px-8 sm:pt-14">
    <p class="ws-pill ws-tint-teal"><Icon name="dashboard" size={14} />Clinic workspaces</p>
    <h1 class="mt-4 max-w-[760px] text-[clamp(1.9rem,4.2vw,2.75rem)] leading-tight tracking-[-0.025em]">
      Your clinic has its own front door.
    </h1>
    <p class="mt-4 max-w-[620px] text-[17px] leading-relaxed text-ink-2">
      One link per branch. Bookmark it, and it opens on today. If you run several, you see
      them all; if you work at one, you see that one.
    </p>

    <div role="note" class="ws-callout mt-7 max-w-[760px]">
      <Icon name="info" />
      <p>
        <strong class="font-semibold">Every workspace is behind a staff sign-in.</strong>{" "}
        A workspace URL is an address, never a credential. Opening a branch you are not assigned to
        sends you back to the sign-in page, and every query inside runs under the database’s
        row-level security for that one clinic.
      </p>
    </div>

    {clinics.length > 0 ? (
      <ul class="mt-8 grid gap-4 lg:grid-cols-2">
        {clinics.map((c) => (
          <li class="card clinic-row flex flex-wrap items-center gap-x-4 gap-y-4 p-5 sm:p-6">
            <ClinicBadge name={c.name} />
            <div class="min-w-0 flex-1 basis-[12rem]">
              <h2 class="text-[19px] leading-snug tracking-[-0.01em]">{c.name}</h2>
              <p class="mt-0.5 text-[15px] leading-snug text-ink-2">{c.group} &middot; {c.city}</p>
            </div>
            <a href={`/c/${c.slug}/`} class="btn btn-quiet max-sm:w-full"><span>Open this clinic</span><Icon name="arrow-right" /></a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="ws-empty card mt-8 px-5 py-4">
        <Icon name="clinic" size={20} class="ws-empty-icon" />
        <span class="ws-empty-text">No clinic has a workspace yet.</span>
        <a href="/start/" class="ws-empty-go">Open your clinic <Icon name="arrow-right" size={16} /></a>
      </p>
    )}
  </main>

  <style>
    /* The clinic's badge, as on Find a clinic and in the workspace's sidebar (the first letters of
       its first two words, a rounded square; round initials are for people), 48px on these cards. */
    .clinic-row :global(.ws-branch-badge) { width: 48px; height: 48px; border-radius: var(--ws-r); font-size: 16px; }
  </style>
</Base>
