---
// How to reach a person at Flossify (the owner, 13 Nov 2026: support@flossify.ph). The App Store asks for a support
// address that reaches someone, and until this page the site had none. One card, one teal button (the email), and
// the two things people most often need instead: a patient's visit is the clinic's to change, and a question about
// someone's data goes the way the privacy notice says.
//
// Static, like the offline and fault pages: it must open when sign-in or the database is the thing that is broken.
// It promises nothing about how fast an answer comes (nobody has set that), and it asks people not to put a
// patient's details in an email, which is not a safe place for them.
import Base from '../layouts/Base.astro';
import Icon from '../components/ws/Icon.astro';

const SUPPORT = 'support@flossify.ph';
---

<Base
  title="Support — Flossify"
  description="Write to Flossify at support@flossify.ph. For a booked visit, see My visits or call your clinic."
>
  <main id="main" class="mx-auto flex min-h-[100dvh] max-w-[1280px] flex-col items-center justify-center px-5 py-12 sm:px-8">
    <div class="w-full max-w-[560px]">
      <a href="/" class="ws-mark" aria-label="Flossify, home">
        <svg class="ws-mark-sq" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="9" /><path d="M9 8h14v11c0 3-1.6 5-3.2 5S17 22.4 17 20.4v-2.2h-2v2.2c0 2-1.2 3.6-2.8 3.6S9 22 9 19z" /></svg>
        <span class="ws-mark-word">Flossify</span>
      </a>

      <section class="card rounded-pane mt-5 p-6 sm:p-9" aria-labelledby="support-title">
        <span class="inline-flex size-12 items-center justify-center rounded-card bg-teal-tint text-teal-ink" aria-hidden="true"><Icon name="message" size={24} /></span>
        <h1 id="support-title" class="mt-5 text-[clamp(1.75rem,4vw,2.25rem)]">Support</h1>
        <p class="mt-3 text-[16px] leading-relaxed text-ink-2">
          Something not working, or a question about Flossify? Write to us and a person reads it. Say which clinic you are with and what you were doing when it went wrong.
        </p>
        <div class="mt-6">
          <a href={`mailto:${SUPPORT}`} class="btn btn-primary btn-lg"><Icon name="message" /><span>{SUPPORT}</span></a>
        </div>
        <p class="mt-4 text-[14.5px] leading-relaxed text-ink-2">
          Please leave a patient’s details out of the email. A name and what happened is enough to start.
        </p>

        <ul class="mt-7 grid gap-4 border-t border-hair pt-6" role="list">
          <li class="flex gap-3">
            <span class="mt-0.5 flex-none text-teal-ink" aria-hidden="true"><Icon name="calendar" size={20} /></span>
            <p class="text-[15px] leading-relaxed text-ink-2">
              <span class="font-semibold text-ink">About a visit you booked.</span> Cancel it under <a href="/me/" class="support-link">My visits</a>, up to two hours before. To move it, or to cancel closer than that, call the clinic: it holds the schedule, and its number is on its page and under My visits.
            </p>
          </li>
          <li class="flex gap-3">
            <span class="mt-0.5 flex-none text-teal-ink" aria-hidden="true"><Icon name="shield" size={20} /></span>
            <p class="text-[15px] leading-relaxed text-ink-2">
              <span class="font-semibold text-ink">About your details.</span> The <a href="/privacy/" class="support-link">privacy notice</a> says what is kept and how to ask for it. A request about your own details comes to this same address; we will ask how to confirm it is you before anything about a record is sent.
            </p>
          </li>
          <li class="flex gap-3">
            <span class="mt-0.5 flex-none text-teal-ink" aria-hidden="true"><Icon name="user" size={20} /></span>
            <p class="text-[15px] leading-relaxed text-ink-2">
              <span class="font-semibold text-ink">Clinic staff who cannot sign in.</span> Start at <a href="/auth/forgot/" class="support-link">Forgot your password?</a> If that does not get you in, write to us.
            </p>
          </li>
        </ul>
      </section>
    </div>
  </main>
</Base>

<style>
  /* A link inside a sentence. The words stay an ordinary inline link (so the focus ring hugs them); the place to
     tap is 44px tall through a layer over the link that takes no room in the line. */
  .support-link { position: relative; white-space: nowrap; font-weight: 600; color: var(--ws-teal-ink); text-decoration: underline; text-underline-offset: 3px; }
  .support-link::after { content: ""; position: absolute; inset: -13px 0; }
</style>
