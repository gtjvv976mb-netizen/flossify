---
// Flossify control › Billing (/admin/billing/): what is due, what came in,
// the online payments a person must look at, and every group's terms. From
// admin_billing() (migration 011), a definer function that returns exactly
// these columns, because an admin has no tenant and must not read clinic
// tables directly. The soft, very simple template: four numbers, one main
// action (Mark paid, green: money in), everything else a quiet button or a
// side panel — Mark paid and a group's terms each open one.
//
// Every action is a form post with the CSRF token, carried out by
// billingAction() in src/lib/admin.ts, written through a definer function and
// recorded in auth_event as 'billing.<action>' with the operator's staff id
// and a detail line naming the invoice or group. Issuing is off while
// BILLING_FINAL (src/lib/billing-config.ts) is false: the pay-to details are
// placeholders. The page says so in words ("Billing is off"); the file and
// flag names stay here, for whoever switches it on — the prices and pay-to
// details live in src/lib/billing.ts. Money is shown at each group's own
// price (subscription.price_per_branch), never the list price. A miss (a
// stale token, an invoice already marked, a bad number) shows one plain
// sentence and changes nothing — a refused Mark paid or Save terms comes back
// in its own panel — and a success redirects with ?done=.
//
// Invoices a clinic paid online (PayMongo, src/lib/payments.ts, migration 024)
// mark themselves, with PayMongo's payment id as the reference. A payment
// PayMongo reported that no invoice could take is listed under "Online
// payments to look at" until a person presses Handled: money may have moved,
// and the fix (a refund, or marking an invoice by hand) is a person's. When an
// online payment was started for a due invoice, Mark paid says so and offers
// Ask PayMongo.
//
// Addresses: ?terms=<group> (the clinic panel's "Billing and terms") opens
// that group's terms; so does the older ?group=<group> when it is not a
// sentence's (a ?done= carries group= to name it).
export const prerender = false;

import AdminLayout from '../../../layouts/Admin.astro';
import Csrf from '../../../components/Csrf.astro';
import Pane from '../../../components/ws/Pane.astro';
import Tile from '../../../components/ws/Tile.astro';
import Chip from '../../../components/ws/Chip.astro';
import Empty from '../../../components/ws/Empty.astro';
import Icon from '../../../components/ws/Icon.astro';
import Avatar from '../../../components/ws/Avatar.astro';
import Menu from '../../../components/ws/Menu.astro';
import SidePanel from '../../../components/ws/SidePanel.astro';
import TermsForm from './_TermsForm.astro';
import { requireAdmin, billingAction, billingNotice, paidLately, ago, REF_MAX, type BillingResult } from '../../../lib/admin';
import { csrfOk, CSRF_MESSAGE } from '../../../lib/csrf';
import { clientIp } from '../../../lib/throttle';
import { peso } from '../../../data/demo';
import { prettyPhone } from '../../../lib/messages';
import {
  STATUS_WORDS, BILLING_FINAL,
  adminRows, allDue, notesByGroup, manilaToday, manilaDate, monthText, dayText, whenText, daysBetween, type AdminRow,
} from '../../../lib/billing';
import { onlineEvents, paymentsToLookAt, lastPaidOnline, checkoutsStarted, onlinePayReady, payConfig, OUTCOME_WORDS } from '../../../lib/payments';

const admin = await requireAdmin(Astro);
if (admin instanceof Response) return admin;
const here = '/admin/billing/';
const today = manilaToday();

let refused: Extract<BillingResult, { ok: false }> | null = null;
let staleNow = false;
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (!csrfOk(Astro.cookies, form)) staleNow = true;
  else {
    const r = await billingAction(form, { staffId: admin.session.staffId, ip: clientIp(Astro), ua: Astro.request.headers.get('user-agent') });
    // Back to the top, where the sentence is.
    if (r.ok) return Astro.redirect(`${here}?${new URLSearchParams(r.done)}`, 303);
    refused = r;
  }
}

// Online: what PayMongo paid (the newest PAID_SHOWN), every refused payment nobody has handled
// (no limit: one must never drop off behind newer ones), whose last payment was online, and
// which due invoices have a payment under way.
const PAID_SHOWN = 100;
const [rows, due, notes, paidOnlineList, toLook, onlineLast, paid] = await Promise.all([
  adminRows(), allDue(), notesByGroup(), onlineEvents({ limit: PAID_SHOWN, outcomes: ['paid'] }), paymentsToLookAt(), lastPaidOnline(), paidLately(8),
]);
const started = await checkoutsStarted(due.map((i) => i.id));
const onlineOn = onlinePayReady();
// PayMongo can be asked whenever this server has its keys, even with billing not final: a checkout opened earlier still needs an answer.
const canAsk = payConfig() !== null;
const anyOnline = onlineOn || paidOnlineList.length > 0 || toLook.length > 0;
const now = new Date();
const n = (x: number) => x.toLocaleString('en-PH');
const plural = (k: number, one: string, many = `${one}s`) => `${n(k)} ${k === 1 ? one : many}`;
const centavos = (x: number | null) => (x === null ? '—' : peso(x / 100));

const q = Astro.url.searchParams;
const groupName = new Map(rows.map((r) => [r.group_id, r.group_name]));
const stale = staleNow || q.get('stale') === 'billing' || q.get('stale') === '1';
const notice = refused || stale ? '' : billingNotice(q, (id) => groupName.get(id));

// A refused Mark paid comes back in its panel. The invoice and the reference are kept only while
// that invoice is still due (a reference too long, say). When it is gone — someone marked it a
// moment ago — nothing is kept: the list shows "Choose an invoice", so a second press cannot mark
// another group's invoice with this payment's reference.
const payRefused = refused?.action === 'paid' ? refused : null;
const payInvoice = payRefused?.invoice && due.some((i) => i.id === payRefused.invoice) ? payRefused.invoice : '';
const payRef = payInvoice ? (payRefused?.ref ?? '') : '';
// A refused Save terms comes back in the terms panel, on its group.
const setRefused = refused?.action === 'set' ? refused : null;
const otherRefused = refused && !payRefused && !setRefused ? refused : null;
const termsId = setRefused?.group || q.get('terms') || (q.has('done') ? '' : (q.get('group') ?? ''));
const termsRow = rows.find((r) => r.group_id === termsId) ?? null;

const owed = due.reduce((s, i) => s + i.amount, 0);
const overdueGroups = rows.filter((r) => r.status === 'past_due').length;
const lastOnline = (r: AdminRow) => !!r.last_paid && onlineLast.has(r.group_id);
const late = (dueAt: Date) => daysBetween(manilaDate(dueAt), today);

// Status is never colour alone: every state has its words.
const standing = (r: AdminRow) =>
  !r.status ? { label: 'Not started', tone: 'muted' as const }
  : r.status === 'past_due' ? { label: STATUS_WORDS.past_due, tone: 'alert' as const }
  : r.status === 'trial' ? { label: STATUS_WORDS.trial, tone: 'warn' as const }
  : r.status === 'cancelled' ? { label: STATUS_WORDS.cancelled, tone: 'muted' as const }
  : { label: STATUS_WORDS.active, tone: 'accent' as const };
const standingLine = (r: AdminRow) =>
  r.status === 'trial' && r.trial_ends_at ? `trial ends ${whenText(r.trial_ends_at)}`
  : r.status === 'past_due' && r.oldest_due ? `oldest due ${dayText(r.oldest_due)}`
  : r.price_per_branch !== null ? `${peso(r.price_per_branch)} a branch` : '';
---

<AdminLayout title="Billing" section="billing" admin={{ name: admin.name, email: admin.email }} wide>
  {!BILLING_FINAL && (
    <p role="note" class="ws-callout" data-tone="warn">
      <Icon name="alert" />
      <span>
        <strong class="font-semibold">Billing is off.</strong> No invoice goes out until the real prices and pay-to details are set and billing is switched on.
        {due.length > 0 && <> {due.length === 1 ? 'One invoice was' : `${due.length} invoices were`} made earlier ({peso(owed)}); clinics are told not to pay {due.length === 1 ? 'it' : 'them'}. {due.length === 1 ? 'It has' : 'They have'} to be voided in the database before billing is switched on.</>}
      </span>
    </p>
  )}
  {stale && <p role="alert" class="ws-callout" data-tone="alert"><Icon name="alert" /><span>{CSRF_MESSAGE}</span></p>}
  {otherRefused && <p role="alert" class="ws-callout" data-tone="alert"><Icon name="alert" /><span>{otherRefused.error}</span></p>}
  {notice && <p role="status" class="ws-callout" data-tone="success"><Icon name="check" /><span>{notice}</span></p>}

  <section aria-label="Billing in numbers" class="ws-tiles">
    <Tile label="Owed now" value={peso(owed)} icon="money" note={due.length ? `${plural(due.length, 'invoice')} due` : 'nothing due'} />
    <Tile label="Payment overdue" value={n(overdueGroups)} icon="clock" tone={overdueGroups ? 'alert' : 'default'} tint={overdueGroups > 0}
      note={overdueGroups ? `${overdueGroups === 1 ? 'group' : 'groups'} over 14 days late` : 'no group is late'} />
    <Tile label="Paid this month" value={peso(paid.monthTotal)} icon="check" tone={paid.monthTotal ? 'success' : 'default'} note={`${plural(paid.monthCount, 'invoice')} in ${monthText(today)}`} />
    <Tile label="To look at" value={n(toLook.length)} icon="alert" tone={toLook.length ? 'alert' : 'default'} tint={toLook.length > 0} href={toLook.length ? '#look' : undefined}
      note={toLook.length ? 'online payments no invoice took' : 'every online payment found its invoice'} />
  </section>

  <!-- Due --------------------------------------------------------------------------------------- -->
  <Pane id="due" title="Due" icon="money" meta={due.length ? 'Oldest first' : 'Nothing due'} pad="none">
    <Fragment slot="actions">
      {due.length > 0 && (
        <button type="button" class="ws-btn ws-btn-success" data-ws-open="pay" data-invoice={due[0].id}><Icon name="check" /> Mark paid</button>
      )}
      {BILLING_FINAL && (
        <Menu id="due-more" label="More billing actions" buttonClass="ws-btn ws-btn-quiet" wide>
          <Fragment slot="button">More <Icon name="chevron" size={16} class="ws-chev" /></Fragment>
          <form method="post" action={here}>
            <Csrf />
            <input type="hidden" name="action" value="issue" />
            <button type="submit" class="ws-menu-item">
              <span class="ws-menu-icon" data-tint="teal"><Icon name="file" /></span>
              <span class="ws-menu-words">Issue {monthText(today)} invoices<span class="ws-menu-hint">For every group past its trial that has none yet. Safe to press twice.</span></span>
            </button>
          </form>
        </Menu>
      )}
    </Fragment>
    {due.length === 0 ? (
      <div class="px-6 py-3 max-md:px-4"><Empty icon="check" text={BILLING_FINAL ? 'Nothing is due from any group. New invoices show here after the monthly run.' : 'Nothing is due from any group. Invoices show here once billing is switched on.'} /></div>
    ) : (
      <ul class="ops-rows">
        {due.map((i) => {
          const d = late(i.due_at);
          return (
            <li class="grid items-center gap-x-6 gap-y-2 md:grid-cols-[minmax(0,1fr)_minmax(0,9rem)_minmax(0,13rem)_auto]">
              <div class="min-w-0">
                <p class="text-[15.5px] font-semibold [overflow-wrap:anywhere]">{groupName.get(i.group_id) ?? 'A group'}</p>
                <p class="ops-ref">{i.number} · {monthText(i.period_start)}</p>
              </div>
              <p class="text-[16px] font-semibold tabular-nums">{peso(i.amount)}</p>
              <div class="flex flex-wrap items-center gap-2 text-[14px] text-ink-2">
                {d > 0
                  ? <span class:list={['ws-pill', d > 14 ? 'ws-tint-red' : 'ws-tint-amber']}>{d} {d === 1 ? 'day' : 'days'} late</span>
                  : <span>Due {dayText(manilaDate(i.due_at))}</span>}
                {started.has(i.id) && <span class="ws-pill ws-tint-blue">Paying online started</span>}
              </div>
              <button type="button" class="ws-btn ws-btn-quiet ws-btn-sm justify-self-start md:justify-self-end" data-ws-open="pay" data-invoice={i.id}>Mark paid<span class="sr-only">: {i.number}, {groupName.get(i.group_id) ?? 'a group'}</span></button>
            </li>
          );
        })}
      </ul>
    )}
  </Pane>

  <!-- Online payments to look at ------------------------------------------------------------------ -->
  {toLook.length > 0 && (
    <Pane id="look" title="Online payments to look at" icon="alert" meta={plural(toLook.length, 'payment')} pad="none">
      <div class="px-6 pt-4 max-md:px-4">
        <p class="ws-callout text-[14.5px]" data-tone="alert">
          <Icon name="alert" />
          <span>PayMongo reported these and no invoice took them, so nothing was marked. Find each one in the PayMongo dashboard by its payment id, then refund it or mark the right invoice paid by hand. Then press Handled. Until you do, the clinic’s page says it is being sorted out.</span>
        </p>
      </div>
      <ul class="ops-rows mt-2">
        {toLook.map((e, i) => (
          <li class="grid items-start gap-x-6 gap-y-3 md:grid-cols-[minmax(0,1fr)_auto]">
            <div class="min-w-0">
              <p id={`look-${i}`} class="text-[15px] font-semibold text-caries">
                {e.outcome === 'paid_twice' && e.paid_via === 'paymongo'
                  ? 'The invoice was already paid online with another PayMongo payment: the clinic paid twice. Return one payment, then press Handled.'
                  : (OUTCOME_WORDS[e.outcome] ?? e.outcome)}
              </p>
              <p class="mt-1 text-[14.5px] text-ink-2">
                {e.group_name ?? 'No group'} · paid <span class="font-semibold text-ink tabular-nums">{centavos(e.amount_centavos)}</span>{e.invoice_amount !== null && <> for an invoice of {peso(e.invoice_amount)}</>} · {whenText(e.received_at)}
              </p>
              <p class="ops-ref mt-0.5">{e.invoice_number ?? 'no invoice'} · {e.payment_id ?? e.session_id ?? '—'}{!e.payment_id && e.session_id && ' (checkout; no payment id could be read)'}</p>
              {e.invoice_status === 'paid' && (
                <p class="mt-1 text-[13.5px] text-ink-2">The invoice: {e.paid_via === 'paymongo' ? 'paid online' : 'marked paid by hand'}{e.paid_at && ` ${whenText(e.paid_at)}`}, reference <span class="ops-ref">{e.paid_ref ?? '—'}</span>.</p>
              )}
              {e.reports > 1 && <p class="mt-1 text-[13.5px] text-muted">Reported {e.reports} times; one Handled takes all of them off.</p>}
            </div>
            <form method="post" action={here}>
              <Csrf />
              <input type="hidden" name="action" value="reviewed" />
              <input type="hidden" name="event" value={e.event_id} />
              <button type="submit" class="ws-btn ws-btn-quiet ws-btn-sm" aria-describedby={`look-${i}`}><Icon name="check" /> Handled</button>
            </form>
          </li>
        ))}
      </ul>
    </Pane>
  )}

  <!-- Every group ------------------------------------------------------------------------------ -->
  <Pane id="groups" title="Every group" icon="clinic" meta={`${plural(rows.length, 'group')} · overdue first`} pad="none">
    {rows.length === 0 ? (
      <div class="px-6 py-3 max-md:px-4"><Empty text="No groups yet. A group shows here once a clinic signs up." /></div>
    ) : (
      <table class="ws-table">
        <caption class="sr-only">Every group’s plan, overdue first. Terms opens a group’s plan, status, trial and price.</caption>
        <thead>
          <tr>
            <th scope="col" class="meta">Group</th>
            <th scope="col" class="meta">Status</th>
            <th scope="col" class="meta">Owes</th>
            <th scope="col"><span class="sr-only">Terms</span></th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => {
            const st = standing(r);
            return (
              <tr id={`g-${r.group_id}`} class="max-lg:grid max-lg:grid-cols-2 max-lg:gap-x-4">
                <td class="max-lg:col-span-2 lg:min-w-[13rem]">
                  <p class="text-[15.5px] font-semibold [overflow-wrap:anywhere]">{r.group_name}</p>
                  {r.owner_name ? (
                    <div class="ops-who mt-1.5">
                      <Avatar name={r.owner_name} size="sm" />
                      <span class="ops-who-text text-[13.5px] text-ink-2">
                        <span class="[overflow-wrap:anywhere]">{r.owner_name} · {plural(r.branches, 'branch', 'branches')}</span>
                        {r.owner_phone && <span class="tabular-nums">{prettyPhone(r.owner_phone)}</span>}
                      </span>
                    </div>
                  ) : <p class="mt-0.5 text-[13.5px] text-muted">No owner on file · {plural(r.branches, 'branch', 'branches')}</p>}
                </td>
                <td>
                  <span class="meta ws-cell-label">Status</span>
                  <Chip tone={st.tone} label={st.label} dot />
                  {standingLine(r) && <span class="mt-1 block text-[13.5px] text-muted">{standingLine(r)}</span>}
                </td>
                <td class="text-[15px] tabular-nums max-lg:col-span-2">
                  <span class="meta ws-cell-label">Owes</span>
                  {r.due_count > 0
                    ? <><span class="font-semibold">{peso(r.due_amount)}</span> <span class="text-[13.5px] text-muted">· {plural(r.due_count, 'invoice')}</span></>
                    : <span class="text-ink-2">Nothing</span>}
                  <span class="block text-[13.5px] text-muted">{r.last_paid ? `Last paid ${whenText(r.last_paid)}${lastOnline(r) ? ', online' : ''}` : 'Never paid yet'}</span>
                </td>
                <td class="text-right max-lg:col-span-2 max-lg:mt-2 max-lg:text-left">
                  <button type="button" class="ws-btn ws-btn-quiet ws-btn-sm" data-ws-open="terms" data-group={r.group_id}><Icon name="settings" /> Terms<span class="sr-only"> for {r.group_name}</span></button>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    )}
    <p class="flex items-start gap-2 border-t border-[var(--ws-hair)] px-6 py-3.5 text-[13.5px] leading-snug text-ink-2 max-md:px-4">
      <Icon name="info" class="mt-px flex-none text-muted" />
      <span>Nothing here switches a clinic off. {BILLING_FINAL ? 'A late payment changes the status and the sentence the owner sees on their plan page; every' : 'Every'} action is recorded under your name in the operations log.</span>
    </p>
  </Pane>

  <!-- Paid ----------------------------------------------------------------------------------------- -->
  <Pane id="paid" title="Paid lately" icon="check" meta={`Paid by GCash, Maya, bank${anyOnline ? ' or online' : ''}`} pad="none">
    {paid.recent.length === 0 ? (
      <div class="px-6 py-3 max-md:px-4"><Empty text="No invoice has been paid yet. Payments show here as they are marked, by you or by PayMongo." /></div>
    ) : (
      <ul class="ops-rows">
        {paid.recent.map((p) => (
          <li class="flex items-center justify-between gap-4">
            <span class="min-w-0">
              <span class="block text-[15px] font-semibold [overflow-wrap:anywhere]">{p.group_name}</span>
              <span class="ops-ref block">{p.number} · {p.paid_via === 'paymongo' ? `online ${p.paid_ref ?? ''}` : `ref ${p.paid_ref ?? '—'}`}</span>
            </span>
            <span class="flex-none text-right">
              <span class="ws-text-green block text-[15px] font-semibold tabular-nums">{peso(p.amount)}</span>
              <span class="block text-[13.5px] whitespace-nowrap text-muted">{ago(p.paid_at, now)}</span>
            </span>
          </li>
        ))}
      </ul>
    )}
    {(paidOnlineList.length > 0 || onlineOn) && (
      <details id="online" class="ops-more border-t border-[var(--ws-hair)] px-6 max-md:px-4">
        <summary>
          <span class="ops-more-word text-[15px] font-semibold">Every payment made online <span class="ml-1 text-[14px] font-normal text-muted">{paidOnlineList.length >= PAID_SHOWN ? `the latest ${PAID_SHOWN}` : n(paidOnlineList.length)}</span></span>
          <Icon name="chevron" class="ws-chev" />
        </summary>
        <p class="pb-3 text-[14px] leading-relaxed text-ink-2">Invoices PayMongo confirmed, newest first. The reference is PayMongo’s payment id; search for it in the PayMongo dashboard.</p>
        {paidOnlineList.length === 0 ? (
          <Empty text="None yet. An invoice a clinic pays online shows here." />
        ) : (
          <ul class="pb-3">
            {paidOnlineList.map((e) => (
              <li class="flex items-center justify-between gap-4 border-t border-[var(--ws-hair)] py-3">
                <span class="min-w-0">
                  <span class="block text-[14.5px] font-medium [overflow-wrap:anywhere]">{e.group_name ?? '—'}</span>
                  <span class="ops-ref block">{e.invoice_number ?? '—'} · {e.payment_id}</span>
                </span>
                <span class="flex-none text-right">
                  <span class="block text-[14.5px] font-semibold tabular-nums">{centavos(e.amount_centavos)}</span>
                  <span class="block text-[13.5px] whitespace-nowrap text-muted">{whenText(e.paid_at ?? e.received_at)}</span>
                </span>
              </li>
            ))}
          </ul>
        )}
      </details>
    )}
  </Pane>

  <!-- Mark an invoice paid: the Due list's buttons open it on their invoice. -->
  <SidePanel id="pay" title="Mark an invoice paid" meta="Money in" open={!!payRefused}>
    {payRefused && <p role="alert" class="ws-callout mb-5" data-tone="alert" data-pay-said><Icon name="alert" /><span>{payRefused.error}</span></p>}
    {due.length === 0 ? (
      <Empty icon="check" text="Nothing is due from any group." />
    ) : (
      <form method="post" action={here} class="grid gap-5">
        <Csrf />
        <input type="hidden" name="action" value="paid" />
        <label class="field">
          <span class="meta">Invoice</span>
          <select name="invoice" required data-pay-invoice data-keep={payRefused ? '' : undefined}>
            <option value="" disabled selected={!!payRefused && !payInvoice}>Choose an invoice</option>
            {due.map((i) => <option value={i.id} selected={i.id === payInvoice}>{groupName.get(i.group_id) ?? 'A group'} · {peso(i.amount)} · {i.number}</option>)}
          </select>
        </label>
        <label class="field">
          <span class="meta">Reference</span>
          <input name="ref" required maxlength={REF_MAX} autocomplete="off" value={payRef} placeholder="GCash ref no., or the bank reference" data-pay-ref />
          <span class="text-[13.5px] text-ink-2">As it appears in the account. The clinic sees it on its plan page.</span>
        </label>
        {due.filter((i) => started.has(i.id)).map((i) => (
          <div class="ws-callout text-[14px]" data-for-invoice={i.id} hidden={i.id !== (payRefused ? payInvoice : due[0].id)}>
            <Icon name="info" />
            <span class="grid gap-2">
              <span>The clinic started paying {i.number} online {whenText(started.get(i.id)!)}. Ask PayMongo first{canAsk ? ': if it has the payment, the invoice is marked paid for you' : ''}. If you still mark it by hand for a PayMongo payment, type PayMongo’s payment id (pay_…) as the reference.</span>
              {canAsk && <span><button type="submit" form={`check-${i.id}`} class="ws-btn ws-btn-quiet ws-btn-sm">Ask PayMongo about {i.number}</button></span>}
            </span>
          </div>
        ))}
        <button type="submit" class="ws-btn ws-btn-success w-full"><Icon name="check" /> Mark paid</button>
        <p class="text-[13.5px] leading-snug text-ink-2">Recorded under your name. Marking by hand closes any online checkout still open for this invoice.</p>
      </form>
    )}
    {canAsk && due.filter((i) => started.has(i.id)).map((i) => (
      <form id={`check-${i.id}`} method="post" action={here} hidden>
        <Csrf />
        <input type="hidden" name="action" value="check" />
        <input type="hidden" name="invoice" value={i.id} />
      </form>
    ))}
  </SidePanel>

  <!-- A group's terms: drawn from its template when Terms is pressed (or by the server, for ?terms= and a refused save). -->
  <SidePanel id="terms" title={termsRow ? `Terms for ${termsRow.group_name}` : 'Terms'} meta="Plan and price" open={!!termsRow}>
    <div data-terms-body data-keep={termsRow ? '' : undefined}>
      {setRefused && <p role="alert" class="ws-callout mb-5" data-tone="alert"><Icon name="alert" /><span>{setRefused.error}</span></p>}
      {termsRow && <TermsForm r={termsRow} note={notes[termsRow.group_id] ?? ''} />}
    </div>
  </SidePanel>
  <div hidden>
    {rows.map((r) => (
      <template id={`terms-${r.group_id}`} data-title={`Terms for ${r.group_name}`}>
        <TermsForm r={r} note={notes[r.group_id] ?? ''} />
      </template>
    ))}
  </div>

  <script>
    // Mark paid: the panel opens on the invoice whose button opened it, and shows that invoice's PayMongo note.
    // A reference typed for one invoice never rides along to another: opening on a different invoice clears it.
    const pay = document.getElementById('pay');
    const select = pay?.querySelector<HTMLSelectElement>('[data-pay-invoice]');
    const ref = pay?.querySelector<HTMLInputElement>('[data-pay-ref]');
    const notes = () => { for (const d of pay?.querySelectorAll<HTMLElement>('[data-for-invoice]') ?? []) d.hidden = d.dataset.forInvoice !== select?.value; };
    pay?.addEventListener('ws:panel-open', (e) => {
      if (!select) return;
      // A refused form, drawn open by the server: keep what it chose (the invoice, or "Choose an invoice").
      if (select.dataset.keep !== undefined) { delete select.dataset.keep; notes(); return; }
      pay?.querySelector('[data-pay-said]')?.remove(); // its sentence was about the refused try
      const id = ((e as CustomEvent).detail?.opener as HTMLElement | null)?.dataset?.invoice;
      if (id && id !== select.value) {
        select.value = id;
        if (ref) ref.value = '';
      }
      notes();
    });
    select?.addEventListener('change', notes);

    // Terms: the group's form, drawn into the panel as it opens — unless the server drew it (a refused save, ?terms=).
    const terms = document.getElementById('terms');
    const body = terms?.querySelector<HTMLElement>('[data-terms-body]');
    terms?.addEventListener('ws:panel-open', (e) => {
      if (!body || !terms) return;
      if (body.dataset.keep !== undefined) { delete body.dataset.keep; return; }
      const id = ((e as CustomEvent).detail?.opener as HTMLElement | null)?.dataset?.group;
      const tpl = id ? (document.getElementById(`terms-${id}`) as HTMLTemplateElement | null) : null;
      if (!tpl) return;
      body.replaceChildren(tpl.content.cloneNode(true));
      const title = terms.querySelector<HTMLElement>('[data-ws-title]');
      if (title) title.textContent = tpl.dataset.title ?? 'Terms';
    });
  </script>
</AdminLayout>

