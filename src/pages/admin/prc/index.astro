---
// Flossify control › PRC checks (/admin/prc/): every dentist with a public
// profile, the ones waiting first. A person looks each licence up on the
// PRC's verification site (the page's one teal button) and marks it here:
// Matches, or Doesn't match (which texts the clinic's owner, once a day per
// dentist). Until then the public profile says "PRC check pending". Decided
// ones sit below; Change opens a side panel with the same choices and the
// note.
//
// Every mark is a form post with the CSRF token, carried out by markPrc()
// (src/lib/admin.ts), written in the dentist's clinic with its audit entry,
// and back here with one sentence (?prc=…). Old addresses still answer: the
// old page's ?done= / ?missed=1 / ?stale=1 sentences, and a form posted to
// /admin/ from a page opened before (handed on here with a 307).
export const prerender = false;

import AdminLayout from '../../../layouts/Admin.astro';
import Csrf from '../../../components/Csrf.astro';
import Pane from '../../../components/ws/Pane.astro';
import Chip from '../../../components/ws/Chip.astro';
import Empty from '../../../components/ws/Empty.astro';
import Icon from '../../../components/ws/Icon.astro';
import Avatar from '../../../components/ws/Avatar.astro';
import SidePanel from '../../../components/ws/SidePanel.astro';
import { requireAdmin, markPrc, prcQueue, prcNotice, clinicRows, dateText, PRC_NOTE_MAX, type PrcRow } from '../../../lib/admin';
import { csrfOk, CSRF_MESSAGE } from '../../../lib/csrf';
import { clientIp } from '../../../lib/throttle';
import { prettyPhone } from '../../../lib/messages';

const admin = await requireAdmin(Astro);
if (admin instanceof Response) return admin;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (!csrfOk(Astro.cookies, form)) return Astro.redirect('/admin/prc/?stale=1', 303);
  const r = await markPrc(form, { staffId: admin.session.staffId, ip: clientIp(Astro), ua: Astro.request.headers.get('user-agent') });
  if (r === 'bad') return Astro.redirect('/admin/prc/', 303);
  if (r === 'missed') return Astro.redirect('/admin/prc/?prc=missed', 303);
  return Astro.redirect(`/admin/prc/?prc=${r.status}${r.status === 'mismatch' ? `&texted=${r.texted}` : ''}`, 303);
}

// The sentence: ?prc=… (and the old page's ?done=… / ?missed=1), or a stale form.
const q = Astro.url.searchParams;
const said = new URLSearchParams();
const done = q.get('prc') ?? q.get('done') ?? '';
if (['checked', 'mismatch', 'pending', 'missed'].includes(done)) said.set('prc', done);
else if (q.get('missed') === '1') said.set('prc', 'missed');
const texted = q.get('texted') ?? '';
if (/^[a-z]{1,10}$/.test(texted)) said.set('texted', texted);
const notice = prcNotice(said);
const stale = q.get('stale') === '1' || q.get('stale') === 'prc';

const [prc, clinics] = await Promise.all([prcQueue(), clinicRows()]);
const waiting = prc.filter((r) => r.prc_status === 'pending');
const decided = prc.filter((r) => r.prc_status !== 'pending');
const clinicIdBySlug = new Map(clinics.map((r) => [r.slug, r.id]));
const digits = (s: string | null) => (s ?? '').replace(/\D/g, '');
const ROLE: Record<string, string> = { owner: 'Owner', admin: 'Admin', dentist: 'Dentist', associate: 'Associate dentist', secretary: 'Secretary', assistant: 'Assistant' };
const STATE: Record<PrcRow['prc_status'], { label: string; tone: 'neutral' | 'accent' | 'alert' }> = {
  pending: { label: 'Waiting', tone: 'neutral' },
  checked: { label: 'Matches', tone: 'accent' },
  mismatch: { label: 'Doesn’t match', tone: 'alert' },
};
const PRC_SITE = 'https://verification.prc.gov.ph/';
---

<AdminLayout title="PRC checks" section="prc" admin={{ name: admin.name, email: admin.email }}>
  {stale && <p role="alert" class="ws-callout" data-tone="alert"><Icon name="alert" /><span>{CSRF_MESSAGE}</span></p>}
  {notice && !stale && <p role="status" class="ws-callout" data-tone={done === 'mismatch' || done === 'missed' ? 'info' : 'success'}><Icon name={done === 'checked' ? 'check' : 'info'} /><span>{notice}</span></p>}

  <Pane id="waiting" title="Waiting for a check" icon="check" meta={waiting.length === 0 ? 'Nobody waiting' : `${waiting.length === 1 ? '1 dentist' : `${waiting.length} dentists`}`} pad="none">
    <a slot="actions" href={PRC_SITE} rel="noopener noreferrer" target="_blank" class="ws-btn ws-btn-primary max-sm:w-full">
      <Icon name="search" /> Open the PRC site<span class="sr-only"> (opens in a new tab)</span>
    </a>
    <div class="px-6 pt-4 max-md:px-4">
      <p class="ws-callout text-[14.5px]"><Icon name="info" /><span>Look up each PRC number on the PRC site, then mark it here. Until then the dentist’s public profile says “PRC check pending”. <strong class="font-semibold">Doesn’t match</strong> texts the clinic’s owner.</span></p>
    </div>
    {waiting.length === 0 ? (
      <div class="px-6 pt-2 pb-3 max-md:px-4">
        <Empty icon="check" text="Nobody is waiting. A dentist shows here when a clinic adds one with a public profile." />
      </div>
    ) : (
      <ul class="ops-rows mt-2">
        {waiting.map((r) => (
          <li class="grid gap-4 md:grid-cols-[minmax(0,1fr)_minmax(0,20rem)]">
            <div class="ops-who">
              <Avatar name={r.full_name} size="lg" />
              <div class="ops-who-text gap-0.5">
                <p class="flex flex-wrap items-center gap-x-2 gap-y-1"><span class="text-[16px] font-semibold [overflow-wrap:anywhere]">{r.full_name}</span><span class="ws-pill ws-tint-slate">{ROLE[r.role] ?? r.role}</span></p>
                <p class="text-[15px]"><span class="text-ink-2">PRC number</span> <span class="font-mono text-[14.5px] font-medium tabular-nums">{r.prc_licence ?? 'not on file'}</span></p>
                <p class="text-[14px] [overflow-wrap:anywhere] text-ink-2">
                  {r.clinic_slug && clinicIdBySlug.has(r.clinic_slug)
                    ? <a href={`/admin/clinics/?clinic=${clinicIdBySlug.get(r.clinic_slug)}`} class="-my-3 inline-flex min-h-11 items-center underline decoration-[color:var(--ws-hair-strong)] underline-offset-4 hover:text-[var(--ws-teal-ink)] hover:decoration-current">{r.clinic_name}</a>
                    : (r.clinic_name ?? 'No home clinic on file')}
                  {r.clinic_slug && <> · {r.clinic_listed ? 'listed' : 'not listed'}</>}
                </p>
                <p class="text-[14px] text-ink-2">
                  Owner: {r.owner_name ? <>{r.owner_name}{r.owner_phone && <> · <a href={`tel:${digits(r.owner_phone)}`} class="ops-call -my-3">{prettyPhone(r.owner_phone)}<span class="sr-only">: call {r.owner_name}</span></a></>}</> : 'none on file'}
                </p>
                <p class="text-[13.5px] text-muted">Added {dateText(r.added_at)}</p>
              </div>
            </div>
            <form method="post" action="/admin/prc/" class="grid content-start gap-3">
              <Csrf />
              <input type="hidden" name="staff_id" value={r.staff_id} />
              <label class="field"><span class="meta">Note (optional)</span><input name="note" maxlength={PRC_NOTE_MAX} placeholder="What the PRC site showed" /></label>
              <div class="grid grid-cols-2 gap-2">
                <button name="status" value="checked" class="ws-btn ws-btn-quiet"><Icon name="check" class="text-[var(--ws-green-ink)]" /> Matches</button>
                <button name="status" value="mismatch" class="ws-btn ws-btn-danger"><Icon name="close" /> Doesn’t match</button>
              </div>
              {!r.owner_phone && <p class="text-[13.5px] leading-snug text-muted">No owner’s mobile on file, so “Doesn’t match” texts nobody.</p>}
            </form>
          </li>
        ))}
      </ul>
    )}
  </Pane>

  <Pane id="decided" title="Already decided" icon="file" meta={decided.length === 0 ? 'None yet' : `${decided.length} ${decided.length === 1 ? 'dentist' : 'dentists'}`} pad="none">
    {decided.length === 0 ? (
      <div class="px-6 py-3 max-md:px-4"><Empty text="Nothing decided yet. A dentist moves here once you mark their licence." /></div>
    ) : (
      <ul class="ops-rows">
        {decided.map((r) => (
          <li class="flex flex-wrap items-center gap-x-4 gap-y-3">
            <div class="ops-who min-w-0 flex-[1_1_18rem]">
              <Avatar name={r.full_name} />
              <div class="ops-who-text gap-0.5">
                <p class="flex flex-wrap items-center gap-x-2 gap-y-1">
                  <span class="text-[15.5px] font-semibold [overflow-wrap:anywhere]">{r.full_name}</span>
                  <Chip tone={STATE[r.prc_status].tone} label={STATE[r.prc_status].label} icon={r.prc_status === 'checked' ? 'check' : 'alert'} />
                </p>
                <p class="text-[14px] [overflow-wrap:anywhere] text-ink-2">
                  <span class="font-mono text-[13.5px] tabular-nums">{r.prc_licence ?? 'no number'}</span> · {r.clinic_name ?? 'No home clinic on file'}
                </p>
                <p class="text-[13.5px] text-muted">{r.prc_checked_on ? `On ${dateText(r.prc_checked_on)}` : 'Marked'}{r.prc_checked_by_name && ` by ${r.prc_checked_by_name}`}{r.prc_note && <> · “{r.prc_note}”</>}</p>
              </div>
            </div>
            <button type="button" class="ws-btn ws-btn-quiet ws-btn-sm" data-ws-open="prc-change" data-prc={r.staff_id}>Change<span class="sr-only">: {r.full_name}</span></button>
          </li>
        ))}
      </ul>
    )}
  </Pane>

  <!-- Change a decided check: the dentist's form, drawn from its template when Change is pressed. -->
  <SidePanel id="prc-change" title="Change a check" meta="PRC check">
    <div data-prc-body></div>
  </SidePanel>
  <div hidden>
    {decided.map((r) => (
      <template id={`prc-${r.staff_id}`} data-title={r.full_name} data-meta={`PRC number ${r.prc_licence ?? 'not on file'}`}>
        <p class="flex flex-wrap items-center gap-2 text-[15px]">
          Now: <Chip tone={STATE[r.prc_status].tone} label={STATE[r.prc_status].label} icon={r.prc_status === 'checked' ? 'check' : 'alert'} />
          {r.prc_checked_on && <span class="text-ink-2">since {dateText(r.prc_checked_on)}</span>}
        </p>
        <p class="mt-2 text-[14.5px] text-ink-2">{r.clinic_name ?? 'No home clinic on file'}{r.owner_name && ` · owner ${r.owner_name}`}</p>
        <form method="post" action="/admin/prc/" class="mt-5 grid gap-4">
          <Csrf />
          <input type="hidden" name="staff_id" value={r.staff_id} />
          <label class="field"><span class="meta">Note (optional)</span><input name="note" maxlength={PRC_NOTE_MAX} value={r.prc_note ?? ''} placeholder="What the PRC site showed" /></label>
          <div class="grid gap-2">
            {r.prc_status !== 'checked' && <button name="status" value="checked" class="ws-btn ws-btn-quiet"><Icon name="check" class="text-[var(--ws-green-ink)]" /> Matches</button>}
            {r.prc_status !== 'mismatch' && <button name="status" value="mismatch" class="ws-btn ws-btn-danger"><Icon name="close" /> Doesn’t match</button>}
            <button name="status" value="pending" class="ws-btn ws-btn-quiet"><Icon name="clock" /> Back to waiting</button>
          </div>
          <p class="text-[13.5px] leading-snug text-muted">Doesn’t match texts the clinic’s owner (once a day for each dentist). Back to waiting shows “PRC check pending” on the public profile again.</p>
        </form>
      </template>
    ))}
  </div>

  <script>
    // Change: the dentist's form, drawn into the panel as it opens.
    const panel = document.getElementById('prc-change');
    const body = panel?.querySelector<HTMLElement>('[data-prc-body]');
    panel?.addEventListener('ws:panel-open', (e) => {
      const id = ((e as CustomEvent).detail?.opener as HTMLElement | null)?.dataset?.prc;
      const tpl = id ? (document.getElementById(`prc-${id}`) as HTMLTemplateElement | null) : null;
      if (!tpl || !body || !panel) return;
      body.replaceChildren(tpl.content.cloneNode(true));
      const title = panel.querySelector<HTMLElement>('[data-ws-title]');
      const meta = panel.querySelector<HTMLElement>('[data-ws-meta]');
      if (title) title.textContent = tpl.dataset.title ?? 'Change a check';
      if (meta) { meta.textContent = tpl.dataset.meta ?? ''; meta.hidden = !tpl.dataset.meta; }
    });
  </script>
</AdminLayout>
