---
import Base from '../layouts/Base.astro';

// What every clinic site ships with. The sample under /samples/swiftcare/ is
// the reference build; keep this list honest to what is actually in it.
const included = [
  { title: 'Booking, one tap away', body: 'Every screen ends in the clinic’s booking flow. Returning patients rebook in about fifteen seconds; new patients in about two minutes.' },
  { title: 'Live clinic hours', body: 'Open, closing soon or closed, worked out in Manila time and shown at the top of every screen. Sunday reads “by appointment”.' },
  { title: 'Services and prices', body: 'Every service with a range or a starting price, filterable by kind, plus a running estimate a patient can copy and bring to the desk.' },
  { title: 'Smile Finder', body: 'Pick what hurts. It shows which services usually help, what they cost, how urgent it is, and what to do tonight.' },
  { title: 'Patient care hub', body: 'Emergency first aid, aftercare after each treatment, a two-minute brushing timer and a check-up reminder that writes to the calendar.' },
  { title: 'Phone-first', body: 'A pinned Call · Directions · Message · Book bar on phones, which is where most patients arrive from.' },
];
---

<Base
  title="Clinic websites — Flossify"
  description="A patient-facing website for your clinic, built alongside the workspace so a booking on the site is a booking at the desk. See the sample."
>
  <main id="main" class="mx-auto max-w-[1280px] px-5 py-16 sm:px-8">
    <a href="/" class="meta hover:text-ink">&larr; Back to the site</a>

    <p class="meta mt-10">Service &middot; Clinic websites</p>
    <h1 class="mt-6 max-w-[760px] font-display text-[clamp(2rem,5vw,3rem)] leading-tight font-semibold tracking-[-0.025em]">
      The front door your patients see first.
    </h1>
    <p class="mt-4 max-w-[640px] text-[17px] leading-relaxed text-ink-2">
      The workspace runs the clinic. The website is what a patient finds at eleven at night
      with a toothache. We build both, so a booking on the site is a booking in the
      workspace and the price list online is the one the desk quotes.
    </p>

    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/samples/swiftcare/" class="btn btn-primary">Open the sample site</a>
      <a href="https://swiftcaredental.com" class="btn btn-quiet" rel="noopener">The clinic’s live site &nearr;</a>
    </div>

    <figure class="mt-12 border border-line bg-surface">
      <div class="flex items-center gap-3 border-b border-line px-4 py-2.5">
        <span class="meta meta-ink">swiftcaredental.com &middot; concept</span>
        <span class="meta ml-auto">Sample &middot; Tarlac City</span>
      </div>
      <iframe
        src="/samples/swiftcare/"
        title="Sample clinic website: a concept redesign for SwiftCare Dental Clinic"
        loading="lazy"
        class="block aspect-[16/10] w-full bg-bg"
      ></iframe>
      <figcaption class="border-t border-line px-4 py-3 text-[14px] leading-relaxed text-ink-2">
        A concept redesign of SwiftCare Dental Clinic’s website in Tarlac City, built by Flossify
        with the clinic’s public branding, photographs and price list. It is not the clinic’s live
        site; the booking and staff links open the real ones.
      </figcaption>
    </figure>

    <h2 class="mt-16 font-display text-[26px] font-semibold tracking-tight">What a clinic site includes</h2>
    <div class="rule mt-6"></div>
    <ul class="grid gap-x-10 md:grid-cols-2">
      {included.map((f, i) => (
        <li class="border-b border-line py-6">
          <p class="sec-no">{String(i + 1).padStart(2, '0')}</p>
          <h3 class="mt-2 font-display text-[19px] font-semibold">{f.title}</h3>
          <p class="mt-2 max-w-[46ch] text-[15.5px] leading-relaxed text-ink-2">{f.body}</p>
        </li>
      ))}
    </ul>

    <div role="note" class="mt-12 max-w-[760px] border border-line bg-bg-soft p-5 text-[14.5px] leading-relaxed">
      <strong class="font-semibold">Each clinic site carries the clinic’s own look.</strong>
      The sample is gold and espresso because that is SwiftCare’s logo and lobby; Flossify’s
      own pages stay flat and Swiss. What crosses over is the rule that matters on a page a
      patient reads: no third-party fonts or scripts. Health guidance on the site is general
      first aid and aftercare, labelled as such, and the clinic’s dentist signs off on the copy
      before it goes live.
    </div>
  </main>
</Base>
