---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import Icon from '../components/ws/Icon.astro';
import type { IconName } from '../components/ws/icons';

// What every clinic site ships with. The sample under /samples/swiftcare/ is
// the reference build; keep this list honest to what is actually in it.
const included: { title: string; body: string; icon: IconName }[] = [
  { icon: 'calendar', title: 'Booking, one tap away', body: 'Every screen ends in the clinic’s booking flow: for a Flossify clinic, the five-step booking with no account. The sample keeps SwiftCare’s own.' },
  { icon: 'clock', title: 'Live clinic hours', body: 'Open, closing soon or closed, worked out in Manila time and shown at the top of every screen. Sunday reads “by appointment”.' },
  { icon: 'money', title: 'Services and prices', body: 'Every service with a range or a starting price, filterable by kind, plus a running estimate a patient can copy and bring to the desk.' },
  { icon: 'search', title: 'Smile Finder', body: 'Pick what hurts. It shows which services usually help, what they cost, how urgent it is, and what to do tonight.' },
  { icon: 'info', title: 'Patient care hub', body: 'Emergency first aid, aftercare after each treatment, a two-minute brushing timer, a check-up reminder that writes to the calendar, and a plain-language guide to PhilHealth’s ₱1,000 dental benefit and HMO cards.' },
  { icon: 'message', title: 'Phone-first', body: 'A pinned Call · Directions · Message · Book bar on phones, which is where most patients arrive from.' },
];
---

<Base
  title="Clinic websites — Flossify"
  description="A patient-facing website for your clinic, built alongside the workspace so a booking on the site is a booking at the desk. See the sample."
>
  <!-- Open your clinic is quiet here: the page's own teal button is the sample. -->
  <SiteHeader current="websites" cta="quiet" />

  <!-- The clinic's front door behind the page (a clinic's website is its front door on the web),
       fixed to the screen under the glass cards, as on Find a clinic and Coverage. Decorative. -->
  <div class="wb-room" aria-hidden="true">
    <picture>
      <source media="(max-width: 639px)" srcset="/img/signin-door-960.webp" />
      <img src="/img/signin-door-1440.webp" srcset="/img/signin-door-960.webp 960w, /img/signin-door-1440.webp 1440w" sizes="100vw" alt="" width="1440" height="810" decoding="async" fetchpriority="high" />
    </picture>
  </div>

  <main id="main" class="wb-glass">
    <header class="wb-pane wb-intro">
      <div class="wb-intro-text">
        <p class="wb-eyebrow"><Icon name="clinic" size={14} />Clinic websites</p>
        <h1 class="wb-title">The front door your patients see first.</h1>
        <p class="wb-lede">
          The workspace runs the clinic. The website is what a patient finds at eleven at night
          with a toothache. We build both, so a booking on the site is a booking in the
          workspace, and the price list online is copied from the fee guide the desk uses.
        </p>
      </div>
      <div class="wb-actions">
        <a href="/samples/swiftcare/" class="btn btn-primary btn-lg"><span>Open the sample site</span><Icon name="arrow-right" /></a>
        <a href="https://swiftcaredental.com" class="btn btn-quiet btn-lg" rel="noopener">The clinic’s live site <span aria-hidden="true">&nearr;</span></a>
      </div>
    </header>

    <!-- The sample, framed in a soft glass window; the page inside stays the sample's own. -->
    <figure class="frame wb-pane wb-frame">
      <div class="frame-bar">
        <span class="inline-flex gap-[5px]" aria-hidden="true"><i class="wb-dot h-[9px] w-[9px] rounded-full"></i><i class="wb-dot h-[9px] w-[9px] rounded-full"></i><i class="wb-dot h-[9px] w-[9px] rounded-full"></i></span>
        <span class="text-ink-2">swiftcaredental.com &middot; concept</span>
        <span class="ml-auto hidden sm:inline">Sample &middot; Tarlac City</span>
      </div>
      <iframe
        src="/samples/swiftcare/"
        title="Sample clinic website: a concept redesign for SwiftCare Dental Clinic"
        loading="lazy"
        class="wb-sample bg-bg"
      ></iframe>
      <figcaption class="wb-caption">
        <Icon name="info" class="wb-caption-icon" />
        <span>
          A concept redesign of SwiftCare Dental Clinic’s website in Tarlac City, built by Flossify
          with the clinic’s public branding, photographs and price list. It is not the clinic’s live
          site; the booking and staff links open the real ones.
        </span>
      </figcaption>
    </figure>

    <section class="wb-pane wb-includes" aria-labelledby="includes-title">
      <div class="wb-head">
        <span class="wb-head-mark" aria-hidden="true"><Icon name="check" size={18} /></span>
        <h2 id="includes-title">What a clinic site includes</h2>
      </div>
      <ul class="wb-list" role="list">
        {included.map((f) => (
          <li class="wb-item">
            <div class="wb-item-head">
              <span class="wb-item-mark" aria-hidden="true"><Icon name={f.icon} size={16} /></span>
              <h3>{f.title}</h3>
            </div>
            <p>{f.body}</p>
          </li>
        ))}
      </ul>
    </section>

    <div role="note" class="wb-pane wb-note">
      <Icon name="info" class="wb-note-icon" />
      <p>
        <strong>Each clinic site carries the clinic’s own look.</strong>{" "}
        The sample is gold and espresso because that is SwiftCare’s logo and lobby; Flossify’s
        own pages keep Flossify’s look. What crosses over is the rule that matters on a page a
        patient reads: no third-party fonts or scripts; the one embed is a map that loads when a
        patient reaches it. Health guidance on the site is general first aid and aftercare,
        labelled as such, and the clinic’s dentist signs off on the copy before it goes live.
      </p>
    </div>
  </main>
</Base>

<style is:global>
  /* Clinic websites on frosted glass (the owner, 26 Sep: "also implement it to the clinic website
     page"): the recipe of the sign-up, Find a clinic and Coverage — a photo fixed behind the page,
     compact translucent cards over it, a column narrow enough that the photo shows on both sides.
     Here the photo is the clinic's front door, since a clinic's website is its front door on the
     web. Every rule starts with .wb-room or .wb-glass, classes only this page has, so nothing else
     on the site changes. The sample in the window is the sample's own opaque page, untouched.

     The photo: a fixed layer rather than background-attachment: fixed (which iOS ignores), under
     everything in the page's flow (z-index -1), so the top bar stands above it. A phone always
     takes the 960 copy, framed on the open door and the corridor behind it; a wider screen gets the
     whole entrance, the two potted trees on either side of the column. In the dark the photo is
     dimmed, so light words on the dark glass hold up over its white walls. The door is only a 1440
     file (no larger source exists; it is not upscaled): checked at 1920 it is a touch soft in the
     shrubs, but only its edges show sharp and the rest sits blurred under the glass, and it was kept
     over ws/corridor-1920 because the shrubs and the door frames read as an entrance, the corridor
     as just another hallway. */
  .wb-room {
    position: fixed;
    top: 0;
    left: 0;
    z-index: -1;
    width: 100%;
    height: 100vh;
    height: 100lvh;
    pointer-events: none;
    overflow: hidden;
  }
  .wb-room picture { display: block; width: 100%; height: 100%; }
  .wb-room img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 44% 50%;
  }
  @media (min-width: 640px) {
    .wb-room img { object-position: 50% 55%; }
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .wb-room img { filter: brightness(0.62) saturate(0.9); }
  }
  :root[data-theme="dark"] .wb-room img { filter: brightness(0.62) saturate(0.9); }
  /* Not on paper, and not under the system's own high-contrast colours. */
  @media print, (forced-colors: active) {
    .wb-room { display: none; }
  }

  /* The page's glass numbers, the other glass pages' (the shared tokens stay as they are). The
     site's own names are redrawn for the glass here, so the buttons and the window keep their
     shapes and only change face: secondary words and small labels darker than --c-ink-2 (the
     muted grey is too light on glass); the quiet button on the near-solid field glass with a
     visible line; hairlines a translucent ink; the eyebrow and the keyboard ring in the deep teal. */
  .wb-glass {
    --glass-blur: blur(14px) saturate(1.4);
    --wb-link: #094f4d;
    --wb-hair: rgb(16 24 40 / 0.07);
    --wb-rule: rgb(16 24 40 / 0.1);
    --wb-inner: rgb(255 255 255 / 0.45);
    --wb-inner-edge: rgb(255 255 255 / 0.7);
    --wb-solid: rgb(255 255 255 / 0.86);
    --c-ink-2: #2f3a4a;
    --c-muted: #2f3a4a;
    --c-surface: var(--glass-field);
    --ws-subtle: rgb(255 255 255 / 0.62);
    --ws-field-line: #bcc3cd;
    --ws-field-line-hover: #98a2b3;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .wb-glass {
      --glass-pane: rgb(22 27 33 / 0.58);
      --wb-link: var(--ws-teal-ink);
      --wb-hair: rgb(0 0 0 / 0.35);
      --wb-rule: rgb(255 255 255 / 0.12);
      --wb-inner: rgb(12 16 20 / 0.22);
      --wb-inner-edge: rgb(255 255 255 / 0.08);
      --wb-solid: rgb(22 27 33 / 0.85);
      --c-ink-2: #c3cad4;
      --c-muted: #c3cad4;
      --ws-subtle: rgb(12 16 20 / 0.3);
      --ws-field-line: #4a5563;
      --ws-field-line-hover: #64707e;
    }
  }
  :root[data-theme="dark"] .wb-glass {
    --glass-pane: rgb(22 27 33 / 0.58);
    --wb-link: var(--ws-teal-ink);
    --wb-hair: rgb(0 0 0 / 0.35);
    --wb-rule: rgb(255 255 255 / 0.12);
    --wb-inner: rgb(12 16 20 / 0.22);
    --wb-inner-edge: rgb(255 255 255 / 0.08);
    --wb-solid: rgb(22 27 33 / 0.85);
    --c-ink-2: #c3cad4;
    --c-muted: #c3cad4;
    --ws-subtle: rgb(12 16 20 / 0.3);
    --ws-field-line: #4a5563;
    --ws-field-line-hover: #64707e;
  }

  /* The keyboard ring in the deep teal: the site's #14908f is under 3:1 on the light glass. */
  .wb-glass :focus-visible { outline-color: var(--wb-link); }

  /* A column about 1080px wide, so the door shows on both sides; the cards one even gap apart. On a
     phone narrow gutters and a wider gap, so the door shows between the cards too. */
  .wb-glass {
    display: grid;
    gap: 1rem;
    max-width: 70rem;
    margin-inline: auto;
    padding: 0.75rem 0.875rem 1.25rem;
  }
  @media (min-width: 640px) {
    .wb-glass { gap: 0.75rem; padding: 1rem 1.25rem 2rem; }
  }

  /* Frosted glass: the door shows through, blurred. */
  .wb-glass .wb-pane {
    min-width: 0;
    background: var(--glass-pane);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    border: 1px solid var(--glass-edge);
    border-radius: var(--ws-r-lg);
    box-shadow: 0 0 0 1px var(--wb-hair), var(--glass-shadow);
    padding: 0.875rem;
  }
  @media (min-width: 640px) {
    .wb-glass .wb-pane { padding: 0.875rem 1.125rem 1rem; }
  }
  /* Where a browser draws no frost, the door would sit sharp behind the words: a near-solid pane. */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .wb-glass .wb-pane { background: var(--wb-solid); }
  }
  .wb-glass strong { font-weight: 600; color: var(--c-ink); }

  /* The heading and the two buttons, in their own small card: the buttons under the words on a
     phone (each the card's width), beside them from 860px, one over the other. */
  .wb-glass .wb-intro { display: grid; gap: 0.875rem; }
  @media (min-width: 860px) {
    .wb-glass .wb-intro { grid-template-columns: minmax(0, 1fr) auto; align-items: center; column-gap: 2rem; }
  }
  .wb-glass .wb-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.4;
    color: var(--wb-link);
  }
  .wb-glass .wb-title {
    margin-top: 0.125rem;
    font-size: clamp(1.5rem, 3.2vw, 1.9rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--c-ink);
  }
  .wb-glass .wb-lede { max-width: 66ch; margin-top: 0.375rem; font-size: 15px; line-height: 1.5; color: var(--c-ink-2); text-wrap: pretty; }
  .wb-glass .wb-actions { display: grid; gap: 0.5rem; }
  @media (min-width: 480px) and (max-width: 859px) {
    .wb-glass .wb-actions { display: flex; flex-wrap: wrap; gap: 0.625rem; }
  }
  .wb-glass .wb-actions .btn-lg { min-height: 48px; padding: 0.625rem 1.25rem; font-size: 15.5px; }

  /* The window: the bar and the caption on the glass, the sample between them its own opaque page,
     16:10 with room (4:5 on a phone). The whole window, caption included, fits the screen under
     the top bar, down to a 320x568 phone and a phone turned sideways: the height given back to the
     bar, the caption and the gaps (12.5rem, and 16rem on a phone, where the caption wraps longer),
     and a small floor so the sample never shrinks to a strip. */
  .wb-glass .wb-pane.wb-frame { overflow: hidden; padding: 0; }
  .wb-glass .wb-frame .frame-bar {
    min-height: 36px;
    padding: 0.375rem 0.875rem;
    border-bottom: 1px solid var(--wb-rule);
    background: transparent;
    color: var(--c-muted);
    --wb-dot: rgb(16 24 40 / 0.18);
  }
  @media (min-width: 640px) {
    .wb-glass .wb-frame .frame-bar { padding-inline: 1.125rem; }
  }
  /* The three window dots: a translucent ink, so they read as dots on the glass bar in both modes. */
  .wb-glass .wb-frame .frame-bar .wb-dot { background: var(--wb-dot); }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .wb-glass .wb-frame .frame-bar { --wb-dot: rgb(255 255 255 / 0.22); }
  }
  :root[data-theme="dark"] .wb-glass .wb-frame .frame-bar { --wb-dot: rgb(255 255 255 / 0.22); }
  .wb-glass .wb-sample {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    max-height: max(14rem, calc(100svh - 16rem));
    border: 0;
  }
  @media (min-width: 640px) {
    .wb-glass .wb-sample { aspect-ratio: 16 / 10; max-height: max(13rem, calc(100svh - 12.5rem)); }
  }
  .wb-glass .wb-caption {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    padding: 0.625rem 0.875rem;
    border-top: 1px solid var(--wb-rule);
    font-size: 13.5px;
    line-height: 1.45;
    color: var(--c-ink-2);
  }
  @media (min-width: 640px) {
    .wb-glass .wb-caption { padding-inline: 1.125rem; }
  }
  .wb-glass .wb-caption-icon { flex: none; margin-top: 1px; color: var(--wb-link); }
  /* The caption and the note run the column's width; their words stop at a readable measure. */
  .wb-glass .wb-caption > span,
  .wb-glass .wb-note p { max-width: 88ch; }

  /* What a clinic site includes: a small head, then the six as compact rows on a lighter inner
     glass — one column on a phone, two from 640px, three from 960px. */
  .wb-glass .wb-head { display: flex; align-items: center; gap: 0.625rem; }
  .wb-glass .wb-head-mark,
  .wb-glass .wb-item-mark {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    background: var(--ws-teal-tint);
    color: var(--ws-teal-ink);
  }
  .wb-glass .wb-head-mark { width: 32px; height: 32px; border-radius: var(--ws-r-ctl); }
  .wb-glass .wb-head h2 { font-size: 16px; line-height: 1.3; letter-spacing: -0.01em; color: var(--c-ink); }
  .wb-glass .wb-list { display: grid; gap: 0.5rem; margin-top: 0.75rem; }
  @media (min-width: 640px) {
    .wb-glass .wb-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 960px) {
    .wb-glass .wb-list { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  .wb-glass .wb-item {
    min-width: 0;
    padding: 0.625rem 0.75rem 0.6875rem;
    border: 1px solid var(--wb-inner-edge);
    border-radius: var(--ws-r);
    background: var(--wb-inner);
  }
  .wb-glass .wb-item-head { display: flex; align-items: center; gap: 0.5rem; }
  .wb-glass .wb-item-mark { width: 28px; height: 28px; border-radius: 8px; }
  .wb-glass .wb-item h3 { font-size: 14.5px; font-weight: 600; line-height: 1.3; color: var(--c-ink); }
  .wb-glass .wb-item p { margin-top: 0.375rem; font-size: 13.5px; line-height: 1.45; color: var(--c-ink-2); text-wrap: pretty; }

  /* The note on the sample's colours, a glass card of its own. */
  .wb-glass .wb-note {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    font-size: 14px;
    line-height: 1.5;
    color: var(--c-ink-2);
  }
  .wb-glass .wb-pane.wb-note { padding-block: 0.75rem; }
  .wb-glass .wb-note-icon { flex: none; margin-top: 2px; color: var(--wb-link); }
</style>
