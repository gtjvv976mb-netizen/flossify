---
export const prerender = false;
// A clinic tablet between patients (the intake, 039; the spec §1.7(a)):
// "Ready for the next patient", the clinic's own room behind, its name and
// nothing else. It asks /f/t/poll/ every 4 seconds; when the desk sends forms
// to it, it opens them. It holds no staff session — only its own secret
// (fl_ctab, set by Clinic settings → Clinic tablets). A device that is not a
// clinic tablet (or was removed) says so, and how one is made.
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/ws/Icon.astro';
import ClinicBadge from '../../find/_ui/ClinicBadge.astro';
import ClinicRoom from '../../find/_ui/ClinicRoom.astro';
import '../../find/_ui/patient.css';
import '../../find/_ui/clinic-glass.css';
import '../_forms.css';
import { hit, LIMITS } from '../../../lib/throttle';
import { pollTablet, tabletProof } from '../../../lib/intake-public';

Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
Astro.response.headers.set('Referrer-Policy', 'same-origin');

const proof = tabletProof(Astro.cookies);
let p: Awaited<ReturnType<typeof pollTablet>> = { status: 'unknown', token: null, tablet: null, clinic: null };
if (proof && (await hit(`intake:t:${proof}`, ...LIMITS.intake.tablet)).allowed) p = await pollTablet(proof);
if (p.status === 'link' && p.token) return Astro.redirect(`/f/i/${p.token}/`, 303);
if (p.status === 'unknown') Astro.response.status = 404;
const made = Astro.url.searchParams.get('new') === '1';
---

<Base title={p.clinic ? `${p.clinic.name} — Flossify` : 'Clinic tablet — Flossify'} description="A clinic’s tablet for patient forms.">
  <ClinicRoom keys={p.clinic?.photoKeys ?? []} clinicId={p.clinic?.id ?? ''} narrow />
  <main id="main" class="pt-main cl-glass cl-book pf" data-ft={p.status === 'ready' ? '' : undefined}>
    {p.status === 'ready' && p.clinic ? (
      <section class="ws-pane ws-glass pt-card cl-pane pf-done" aria-labelledby="ft-title">
        <div class="cl-id">
          <ClinicBadge name={p.clinic.name} size="lg" />
          <p class="cl-sub">{p.clinic.name}</p>
        </div>
        <h1 class="pt-done-title pf-done-title" id="ft-title">Ready for the next patient</h1>
        <p class="pf-done-lead">The desk sends your forms to this tablet. They open here by themselves.</p>
        {made && <p class="ws-callout cl-callout mt-3" role="status"><Icon name="check" /><span>This device is a clinic tablet now ({p.tablet}). It is signed out of Flossify.</span></p>}
        <p class="sr-only" aria-live="polite" data-ft-live></p>
      </section>
    ) : (
      <section class="ws-pane ws-glass pt-card cl-pane pf-done" aria-labelledby="ft-title">
        <span class="pt-done-mark pf-done-mark" data-tone="info"><Icon name="info" size={24} /></span>
        <h1 class="pt-done-title pf-done-title" id="ft-title">This device is not a clinic tablet</h1>
        <p class="pf-done-lead">A clinic’s owner or admin makes one in Clinic settings → Clinic tablets, on the tablet itself.</p>
        <div class="pf-done-actions"><a href="/auth/login/" class="btn btn-quiet"><Icon name="user" />Staff sign-in</a></div>
      </section>
    )}
  </main>

  <script>
    // Ask for work every 4 seconds; when the desk has sent forms, open them. Three misses in a row say so.
    const main = document.querySelector<HTMLElement>('main[data-ft]');
    const live = document.querySelector<HTMLElement>('[data-ft-live]');
    let misses = 0;
    const ask = async () => {
      try {
        const r = await fetch('/f/t/poll/', { credentials: 'same-origin', cache: 'no-store' });
        const b = await r.json();
        misses = 0;
        if (b.status === 'link' && typeof b.to === 'string' && b.to.startsWith('/f/i/')) { location.replace(b.to); return; }
        if (b.status === 'unknown') { location.reload(); return; }
      } catch {
        misses++;
        if (misses === 3 && live) live.textContent = 'The connection is lost. The forms open when it is back.';
      }
      setTimeout(ask, 4000);
    };
    if (main) setTimeout(ask, 4000);
  </script>
</Base>
