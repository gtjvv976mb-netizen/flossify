# Copy to .env (gitignored). The app must connect as a plain role, not a superuser,
# or row-level security is bypassed; db.ts refuses to start if it is.
DATABASE_URL=postgres://flossify_app:flossify_dev@localhost:5432/flossify_dev
# At least 32 characters. Rotating it signs everyone out.
SESSION_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Texts. `console` prints instead of sending (development). `semaphore` sends
# through semaphore.co and needs SMS_API_KEY and a registered sender name.
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER=Flossify
# Replies arrive at POST /api/sms/inbound and must carry this in X-Inbound-Secret.
SMS_INBOUND_SECRET=change-me-to-something-long

# Uploaded clinic photos live here, served at /uploads/…
UPLOAD_DIR=./uploads

# Behind a proxy that sets X-Forwarded-For, set to 1 so rate limits key on the
# real client. Leave 0 when the app is reached directly.
TRUST_PROXY=0
