# Flossify configuration. Copy to .env for this machine (.env is gitignored).
# On a server, set these in the host's environment instead. A production server checks
# them on its first request and serves no page until all are safe (src/lib/env.ts).
# The values here are for local development.

# --- Server (Astro's node adapter: npm start) -----------------------------------
# production on every process of a live server (web, SMS worker, db:migrate); never on this machine.
# Without it the worker and db:migrate skip their production checks. npm start (the built server)
# checks anyway unless NODE_ENV=development; astro dev/preview on this machine only warn.
# NODE_ENV=production
# Address to listen on: 127.0.0.1 behind a proxy on the same machine, 0.0.0.0 in a container. Default localhost.
# HOST=127.0.0.1
# Port to listen on. Default 4321.
# PORT=4321
# 1 when a proxy in front sets X-Forwarded-For, so rate limits key on the real client; 0 when reached directly.
TRUST_PROXY=0
# Read when building, not when running. Extra host names the server answers form posts on behind an HTTPS
# proxy, comma-separated, besides flossify.ph and www.flossify.ph (astro.config.mjs): the platform's own
# address, to try a deploy before DNS points the domain at it. Example: EXTRA_HOSTS=flossify.onrender.com
# EXTRA_HOSTS=

# --- Database ------------------------------------------------------------------
# The app's connection, always as the plain role flossify_app (never a superuser: RLS would not apply).
DATABASE_URL=postgres://flossify_app:flossify_dev@localhost:5432/flossify_dev
# 1 for TLS to a managed Postgres, for the web server, the SMS worker, db:migrate and db:backup alike
# (encrypted, certificate not verified); to verify, add sslmode=verify-full&sslrootcert=<ca.pem> to the URLs instead.
DATABASE_SSL=
# The owner/admin connection, used only by npm run db:migrate and npm run db:backup. Empty here: the local database as your own user.
DATABASE_ADMIN_URL=
# flossify_app's password; db:migrate sets it. Required with NODE_ENV=production, and whenever DATABASE_ADMIN_URL points
# at another machine. Letters, digits . _ ~ - only: openssl rand -hex 24
APP_DB_PASSWORD=

# --- Sign-in -------------------------------------------------------------------
# Signs every session cookie. At least 32 characters: openssl rand -base64 48. Rotating it signs everyone out.
SESSION_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# --- Texts (the SMS worker: npm run sms:worker) --------------------------------
# console prints texts instead of sending them (this machine only); semaphore sends through semaphore.co.
SMS_PROVIDER=console
# The API key from semaphore.co (Account > API). Required with semaphore.
SMS_API_KEY=
# The sender name Semaphore approved for your account (11 characters at most). Required with semaphore.
SMS_SENDER=Flossify
# Replies arrive at POST /api/sms/inbound as JSON and must carry this in X-Inbound-Secret. 24+ characters: openssl rand -hex 24
SMS_INBOUND_SECRET=change-me-to-something-long
# 1 lets a production server run with SMS_PROVIDER=console, for a deliberate dry run: nothing is sent, nobody can reset a password.
# ALLOW_CONSOLE_SMS=1

# --- Files and backups ---------------------------------------------------------
# Uploaded clinic photos, served at /uploads/. In production an absolute path on a persistent volume.
UPLOAD_DIR=./uploads
# Where npm run db:backup writes, and how many of each kind it keeps. Defaults ./backups and 14.
# BACKUP_DIR=/var/backups/flossify
# BACKUP_KEEP=14

# --- This machine only: never set these on a server ----------------------------
# 1 lists the seeded test logins on the sign-in page and marks the seeded data as test data
# (a banner on workspace and patient pages). Read from this file when the server runs (src/lib/dotenv.ts).
# A production server refuses to run with it set.
SHOW_DEMO_LOGINS=1
# The local database npm run db:setup rebuilds (it DROPS it first) and db:migrate uses without DATABASE_ADMIN_URL.
# DB=flossify_dev
